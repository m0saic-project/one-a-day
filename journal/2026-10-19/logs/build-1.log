{"type":"tool_use","timestamp":1792416104482,"sessionID":"ses_eabad0e61ffeMfJmuPCNFqL7sc","part":{"type":"tool","tool":"read","callID":"call-b374034a-f357-440b-a7ce-c1b0097bf5d3-11","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\golf-round-scorecard\\v1\\golf-round-scorecard.ts","limit":200},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\src\\sports\\golf-round-scorecard\\v1\\golf-round-scorecard.ts</path>\n<type>file</type>\n<content>\n1: import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\n2: import { asTemplateId } from \"@m0saic/types\";\n3: import { toM0String } from \"@m0saic/dsl-stdlib\";\n4: import { bindProp, bindPropPath, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\n5: import type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\n6: import { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n7: import { budget, textCell, widthOf } from \"../../../_shared/text\";\n8: import { whyTutorial } from \"../../../_shared/why\";\n9: import type { WhySpec } from \"../../../_shared/why\";\n10: \n11: /**\n12:  * `@one-a-day/sports/golf-round-scorecard/v1` - one golf round as the card\n13:  * golfers already know: two nine-hole strips of hole / par / score rows with\n14:  * OUT and IN columns, a totals band, and the paper scorecard's own marks\n15:  * drawn around each score - a ring one under par, a square one over, doubles\n16:  * for two or more either way, a filled ring for an ace.\n17:  *\n18:  * ONE CONCEPT: the notation is the community's own. Nobody teaches a golfer\n19:  * circles and squares; the card draws what their pencil would, so the\n20:  * numbers stay the star and the marks carry the story. Shape alone carries\n21:  * the meaning - no traffic-light colours - and the card reads exactly like\n22:  * the paper it replaces.\n23:  *\n24:  * The rule that bites: the mark must enclose its number at every canvas. A\n25:  * two-digit score needs its ring around BOTH digits, and a double mark needs\n26:  * a second one outside it, so the score size is fitted to the ring's budget\n27:  * (the smaller of column and row, times 0.96, times 0.94 less 2px inside\n28:  * that) - never to the cell alone - and the fit refuses below the floor\n29:  * instead of clipping a digit. The hole columns are equal by construction\n30:  * and promised equal by relation; the two strips are one height; and every\n31:  * total on the card (OUT, IN, TOTAL, the to-par line, the marks themselves)\n32:  * is computed from pars and scores, so the card cannot disagree with itself.\n33:  */\n34: \n35: export type GolfMark = \"none\" | \"ring\" | \"ring2\" | \"square\" | \"square2\" | \"ace\";\n36: export type GolfRoundScorecardProps = {\n37:   /** The course name, the header's first line. \"\" removes nothing - it is required copy; use a space to blank it. */\n38:   course?: string;\n39:   /** The tees and rating/slope line under the course. \"\" removes the line. */\n40:   tees?: string;\n41:   /** The golfer, bottom-left of the header. \"\" removes it. */\n42:   golfer?: string;\n43:   /** A free line bottom-right of the header: the date, a season, a thread. \"\" removes it. */\n44:   date?: string;\n45:   /** The hole pars off the card: 9 or 18 integers, 3 to 6 each. */\n46:   pars?: number[];\n47:   /** The strokes per hole: 9 or 18 integers, 1 to 99, the same count as pars. */\n48:   scores?: number[];\n49:   /** The round total, an under-par total and the ace mark, as #rrggbb. */\n50:   accent?: string;\n51:   /** Page and ink. */\n52:   preset?: \"dark\" | \"light\";\n53:   /** Dev-only: check the layout contract and draw it over the card. */\n54:   debugLayout?: boolean;\n55: };\n56: \n57: const ID = \"@one-a-day/sports/golf-round-scorecard/v1\";\n58: const DEFAULT_ACCENT = \"#ff8a1f\";\n59: const THEMES = {\n60:   dark: { bg: \"#0e1613\", ink: \"#eaf0ea\", dim: \"#8d9c92\" },\n61:   light: { bg: \"#f4f1e8\", ink: \"#1c231d\", dim: \"#5d6a5f\" },\n62: } as const;\n63: \n64: // An invented golfer's invented \"finally broke 90\" round: 89, par 72, one\n65: // birdie (hole 7), one double (hole 8), a triple to finish - OUT 42, IN 47.\n66: const DEFAULTS = {\n67:   course: \"Juniper Links\",\n68:   tees: \"White - 69.6/128\",\n69:   golfer: \"dana_h\",\n70:   date: \"Oct 10, 2026\",\n71:   pars: [4, 4, 5, 3, 4, 5, 4, 4, 3, 5, 4, 4, 3, 4, 4, 4, 3, 5],\n72:   scores: [5, 4, 6, 3, 5, 6, 3, 6, 4, 7, 4, 5, 3, 5, 4, 6, 5, 8],\n73:   accent: DEFAULT_ACCENT,\n74:   preset: \"dark\" as \"dark\" | \"light\",\n75:   debugLayout: false,\n76: };\n77: \n78: const propsSchema = definePropsSchema<GolfRoundScorecardProps>({\n79:   pars: {\n80:     type: \"json\",\n81:     required: false,\n82:     description:\n83:       \"The hole pars off the card: 9 integers (one strip) or 18 (two), each 3 to 6 - a par 6 is allowed, Lake Chabot has one. Sets the par row, the OUT/IN par totals and the marks: a score one under par gets a ring, one over a square.\",\n84:     meta: {\n85:       constraints: { jsonSchema: { type: \"array\", minItems: 9, maxItems: 18, items: { type: \"integer\", minimum: 3, maximum: 6 } } },\n86:       ui: { label: \"Pars\", order: 1, primary: true },\n87:     },\n88:   },\n89:   scores: {\n90:     type: \"json\",\n91:     required: false,\n92:     description:\n93:       \"The strokes per hole, the same count as pars, each an integer 1 to 99. An ace (1) draws a filled ring whatever the par; a picked-up hole has to be written as the number you would take, and the card works out every mark, the nines and the totals.\",\n94:     meta: {\n95:       constraints: { jsonSchema: { type: \"array\", minItems: 9, maxItems: 18, items: { type: \"integer\", minimum: 1, maximum: 99 } } },\n96:       ui: { label: \"Scores\", order: 2, primary: true },\n97:     },\n98:   },\n99:   course: {\n100:     type: \"string\",\n101:     required: false,\n102:     description: \"The course name, the header's first line. Up to 40 characters; the sample course is invented.\",\n103:     meta: { control: { placeholder: DEFAULTS.course }, ui: { label: \"Course\", order: 3 } },\n104:   },\n105:   tees: {\n106:     type: \"string\",\n107:     required: false,\n108:     description: 'The tees line under the course, e.g. \"White - 69.6/128\". Up to 28 characters; empty removes the line.',\n109:     meta: { control: { placeholder: DEFAULTS.tees }, ui: { label: \"Tees\", order: 4 } },\n110:   },\n111:   golfer: {\n112:     type: \"string\",\n113:     required: false,\n114:     description: \"The golfer, bottom-left of the header. Up to 32 characters; empty removes it. The sample handle is invented.\",\n115:     meta: { control: { placeholder: DEFAULTS.golfer }, ui: { label: \"Golfer\", order: 5 } },\n116:   },\n117:   date: {\n118:     type: \"string\",\n119:     required: false,\n120:     description: \"A free line bottom-right of the header: the date, a season, a thread. Up to 32 characters; empty removes it.\",\n121:     meta: { control: { placeholder: DEFAULTS.date }, ui: { label: \"Date\", order: 6 } },\n122:   },\n123:   accent: {\n124:     type: \"string\",\n125:     required: false,\n126:     description: \"The round total, an under-par total and the ace mark, as #rrggbb.\",\n127:     meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 7 } },\n128:   },\n129:   preset: {\n130:     type: \"string\",\n131:     required: false,\n132:     description: 'Page and ink: \"dark\" (default) or \"light\" - the paper card.',\n133:     meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 8 } },\n134:   },\n135:   debugLayout: {\n136:     type: \"boolean\",\n137:     required: false,\n138:     description: \"Dev-only: check the layout contract (every text fits its box, the hole columns are equal, the strips are one height, every mark is there) and draw it over the card.\",\n139:     meta: { ui: { label: \"Debug layout\", order: 99 } },\n140:   },\n141: });\n142: \n143: /* ── the arithmetic: pure, exported, and what the test asserts ── */\n144: \n145: function fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n146: \n147: /** Printable ASCII plus the accented Latin letters the bundled font draws; anything else is refused by name. */\n148: const DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\n149: function text(value: unknown, field: string, max: number): string {\n150:   if (typeof value !== \"string\") fail(field, \"must be a string.\");\n151:   if (!DRAWN.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII and accented Latin letters (U+00C0-U+017F).`);\n152:   const s = value.trim();\n153:   if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n154:   return s;\n155: }\n156: \n157: /** The paper scorecard's mark for one hole: a ring under par, a square over, doubles for two or more, a filled ring for an ace. */\n158: export function golfMarkOf(par: number, score: number): GolfMark {\n159:   if (score === 1) return \"ace\";\n160:   const d = score - par;\n161:   if (d <= -2) return \"ring2\";\n162:   if (d === -1) return \"ring\";\n163:   if (d === 0) return \"none\";\n164:   if (d === 1) return \"square\";\n165:   return \"square2\";\n166: }\n167: \n168: export type GolfHole = { hole: number; par: number; score: number; mark: GolfMark };\n169: export type GolfNine = { name: \"OUT\" | \"IN\"; par: number; score: number; toPar: number; holes: GolfHole[] };\n170: \n171: /** +6 / E / -3, the way a scorecard prints a to-par. ASCII hyphen-minus. */\n172: export function golfSigned(n: number): string {\n173:   return n > 0 ? `+${n}` : n < 0 ? `-${-n}` : \"E\";\n174: }\n175: \n176: export type GolfCard = ReturnType<typeof normalizeGolfCard>;\n177: \n178: /** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n179: export function normalizeGolfCard(props: GolfRoundScorecardProps) {\n180:   const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n181:   const course = text(p.course, \"course\", 40);\n182:   const tees = text(p.tees, \"tees\", 28);\n183:   const golfer = text(p.golfer, \"golfer\", 32);\n184:   const date = text(p.date, \"date\", 32);\n185:   if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n186:   if (typeof p.accent !== \"string\" || !/^#[0-9a-fA-F]{6}$/.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n187:   if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n188: \n189:   const readList = (name: \"pars\" | \"scores\", min: number, max: number): number[] => {\n190:     const v = p[name];\n191:     if (!Array.isArray(v)) fail(name, `must be a list of 9 or 18 integers (the card's own ${name}).`);\n192:     if (v.length !== 9 && v.length !== 18) fail(name, `has ${v.length} ${v.length === 1 ? \"entry\" : \"entries\"}; a round is 9 holes (one strip) or 18 (two).`);\n193:     return v.map((x, i) => {\n194:       if (typeof x !== \"number\" || !Number.isInteger(x)) fail(`${name}[${i}]`, `${JSON.stringify(x)} is not an integer.`);\n195:       if (x < min || x > max) fail(`${name}[${i}]`, `${x} is outside ${min} to ${max}.`);\n196:       return x;\n197:     });\n198:   };\n199:   const pars = readList(\"pars\", 3, 6);\n200:   const scores = readList(\"scores\", 1, 99);\n\n(Showing lines 1-200 of 624. Use offset=201 to continue.)\n</content>","metadata":{"preview":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport {