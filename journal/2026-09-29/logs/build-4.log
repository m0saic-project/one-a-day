d\" }"]}],"created":true},{"filePath":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-09-29\\review\\brief\\max-title.props.json","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":1,"lines":["+{ \"title\": \"A Title Long Enough To Need Two Lines Ok\" }"]}],"created":true},{"filePath":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-09-29\\review\\brief\\notheme.props.json","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":1,"lines":["+{\"themeEntries\": \"\"}"]}],"created":true},{"filePath":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-09-29\\review\\brief\\probe1.cjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":30,"lines":["+const path = require(\"path\");","+const root = \"C:/src/m0saic-production/one-a-day\";","+const T = require(path.join(root, \"dist/gaming/crossword-grid-card/v1/crossword-grid-card.js\"));","+const { CONTRACT_CANVASES } = require(path.join(root, \"dist/_shared/layout.js\"));","+const { widthOf, budget } = require(path.join(root, \"dist/_shared/text.js\"));","+const canv = [[1080,1080], ...CONTRACT_CANVASES];","+function synthetic(cols, rows) {","+  const out = [];","+  for (let r = 0; r < rows; r++) { let line = \"\";","+    for (let c = 0; c < cols; c++) { const rr = Math.min(r, rows-1-r), cc = Math.min(c, cols-1-c);","+      const block = (rr*5+cc*3)%7===3 && rr>0 && cc>0; line += block ? \"#\" : String.fromCharCode(65+((r*7+c*3)%26)); }","+    out.push(line); }","+  return out.join(\"/\");","+}","+const summarize = (name, props) => {","+  const p = T.normalizeCrossword(props);","+  for (const [w,h] of canv) {","+    const L = T.layoutCrosswordCard(p, w, h);","+    const B = L.board;","+    const title = L.texts.find(t => t.label === \"title\");","+    const minPx = Math.min(...L.texts.map(t => t.px));","+    const minLbl = L.texts.filter(t=>t.px===minPx).map(t=>t.label).join(\",\");","+    const S = Math.min(w,h);","+    const hole = B.hole(0);","+    console.log(`${name} @${w}x${h} mod