{"type":"tool_use","timestamp":1792528614284,"sessionID":"ses_ea4f89b40ffeJA5Vf8sjCWqpcq","part":{"type":"tool","tool":"read","callID":"call_00_m3B3BdLABJLP7W75GUwE7061","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\community\\weekly-run-report\\v1\\weekly-run-report.test.ts"},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\src\\community\\weekly-run-report\\v1\\weekly-run-report.test.ts</path>\n<type>file</type>\n<content>\n1: import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\n2: import { resolvePropBindings } from \"@m0saic/template-utils\";\n3: import type { MosaicDocument } from \"@m0saic/types\";\n4: \n5: import { asDocument, targetCtx } from \"../../../__testutils__/render\";\n6: import { CONTRACT_CANVASES, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\n7: import {\n8:   WeeklyRunReportV1,\n9:   formatCount,\n10:   formatRunDate,\n11:   layoutWeeklyRunReport,\n12:   parseMilestones,\n13:   settleLayout,\n14: } from \"./weekly-run-report\";\n15: import type { WeeklyRunReportProps } from \"./weekly-run-report\";\n16: \n17: const ID = \"@one-a-day/community/weekly-run-report/v1\";\n18: const render = (props: WeeklyRunReportProps = {}, w = 1080, h = 1080) =>\n19:   WeeklyRunReportV1.render({ ...WeeklyRunReportV1.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n20: \n21: /** Every drawn string with its label: the parent's and those inside each child document (a tile, a badge). */\n22: function texts(doc: MosaicDocument): Array<{ label: string; text: string; px: number }> {\n23:   const own = (d: MosaicDocument) => (d.sources ?? [])\n24:     .filter((s) => (s as { type?: string }).type === \"text\")\n25:     .map((s) => {\n26:       const src = s as unknown as { editor?: { label?: string }; layers: Array<{ content: { text: string }; style: { fontSize: number } }> };\n27:       return { label: src.editor?.label ?? \"\", text: src.layers[0].content.text, px: src.layers[0].style.fontSize };\n28:     });\n29:   return [...own(doc), ...Object.values(doc.children ?? {}).flatMap((c) => own(c as MosaicDocument))];\n30: }\n31: const textOf = (doc: MosaicDocument, label: string) => texts(doc).find((t) => t.label === label)?.text;\n32: \n33: const TEN = \"6xR25, 4xR50, 3xR100, 2xR250, 1xR500, 1xR1000, 5xV25, 3xV50, 2xV100, 1xV250\";\n34: const SIX = \"6xR25, 4xR50, 3xR100, 2xR250, 1xR500, 5xV25\";\n35: const MAXED = { finishers: 9999, newPbs: 9999, firstTimers: 9999, visitors: 9999, volunteers: 9999, firstTimeVolunteers: 9999 };\n36: \n37: describe(ID, () => {\n38:   it(\"draws the default week the brief promised, every string as typed\", async () => {\n39:     const doc = await render();\n40:     expect(textOf(doc, \"event-name\")).toBe(\"WILLOWMERE PARK 5K\");\n41:     expect(textOf(doc, \"run-number\")).toBe(\"#312\");\n42:     expect(textOf(doc, \"run-date\")).toBe(\"SAT 03 OCT 2026\");\n43:     expect(textOf(doc, \"value-finishers\")).toBe(\"214\");\n44:     expect(textOf(doc, \"value-volunteers\")).toBe(\"31\");\n45:     expect(textOf(doc, \"value-newPbs\")).toBe(\"38\");\n46:     expect(textOf(doc, \"value-firstTimers\")).toBe(\"27\");\n47:     expect(textOf(doc, \"value-visitors\")).toBe(\"19\");\n48:     expect(textOf(doc, \"value-firstTimeVolunteers\")).toBe(\"4\");\n49:     expect(textOf(doc, \"band-title\")).toBe(\"MILESTONE CLUBS\");\n50:     expect([1, 2, 3, 4].map((i) => `${textOf(doc, `badge-club-${i}`)} ${textOf(doc, `badge-caption-${i}`)}`)).toEqual([\n51:       \"25 4 runners\", \"50 3 runners\", \"100 1 runner\", \"25 2 volunteers\",\n52:     ]);\n53:     expect(textOf(doc, \"footer\")).toBe(\"Sample week: event and numbers are invented\");\n54:     // Every string on the card is ASCII.\n55:     for (const t of texts(doc)) expect(t.text).toMatch(/^[\\x20-\\x7e]+$/);\n56:   });\n57: \n58:   it(\"binds what it shows: the header props, each count to its own key, the footer, the accent and the band\", async () => {\n59:     const doc = await render();\n60:     const { byProp, rejected } = resolvePropBindings(doc, 1080, 1080, { propsSchema: WeeklyRunReportV1.propsSchema });\n61:     expect(rejected).toEqual([]);\n62:     for (const k of [\"eventName\", \"runNumber\", \"date\", \"footer\", \"accent\", \"milestones\"]) expect(byProp[k]).toHaveLength(1);\n63:     expect(byProp.counts).toHaveLength(6);\n64:   });\n65: \n66:   it(\"clears its safe minimum at its own hint\", async () => {\n67:     const ev = evaluateM0(String((await render()).m0), { width: 1080, height: 1080 });\n68:     expect(ev.feasible && ev.meetsPrecision).toBe(true);\n69:   });\n70: \n71:   it(\"draws each tile and badge as a child document on the lattice: no recovery inset on a child, 5-smooth child canvases\", async () => {\n72:     const smooth = (n: number) => { let k = n; for (const f of [2, 3, 5]) while (k % f === 0) k /= f; return k === 1; };\n73:     for (const over of [{}, { milestones: TEN }, { milestones: \"\" }, { eventName: \"Great Salterns Nature Reserve 5k Juniors\", counts: MAXED }] as WeeklyRunReportProps[]) {\n74:       for (const [w, h] of CONTRACT_CANVASES) {\n75:         if (over.milestones === TEN && w <= 480) continue;\n76:         const doc = await render(over, w, h);\n77:         const refs = (doc.sources ?? []).filter((s) => (s as { type?: string }).type === \"mosaic\");\n78:         expect(refs.length).toBe(Object.keys(doc.children ?? {}).length);\n79:         for (const r of refs) expect((r as { placement?: { inset?: unknown } }).placement?.inset).toBeUndefined();\n80:         for (const c of Object.values(doc.children ?? {})) {\n81:           const size = (c as MosaicDocument).size!;\n82:           expect(smooth(size.width) && smooth(size.height)).toBe(true);\n83:         }\n84:       }\n85:     }\n86:   });\n87: \n88:   it(\"keeps its layout contract at the seven contract canvases for the copy that stresses it\", async () => {\n89:     expect(layoutIntentOf(await render())).not.toBeNull();\n90:     const sweep = (over: WeeklyRunReportProps, canvases = CONTRACT_CANVASES) =>\n91:       sweepLayout((p, ctx) => WeeklyRunReportV1.render(p, ctx).then(asDocument), ID, { ...WeeklyRunReportV1.defaultProps, ...over }, (w, h) => targetCtx(w, h), canvases);\n92:     for (const over of [\n93:       {},\n94:       { eventName: \"Great Salterns Nature Reserve 5k\" },\n95:       { eventName: \"Great Salterns Nature Reserve 5k Juniors\" },\n96:       { eventName: \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" },\n97:       { counts: MAXED, runNumber: 9999 },\n98:       { milestones: \"\" },\n99:       { milestones: \"1xR100\" },\n100:       { milestones: SIX },\n101:       { footer: \"\" },\n102:       { footer: \"Thanks to all 31 volunteers - see you next Saturday at 9am by the cafe\" },\n103:       { date: \"\" },\n104:       { accent: \"#ffd23f\" },\n105:     ] as WeeklyRunReportProps[]) await sweep(over);\n106:     // Ten clubs: every canvas from 640x360 up; the 480x270 thumbnail refuses them (below).\n107:     await sweep({ milestones: TEN, counts: MAXED }, CONTRACT_CANVASES.filter(([w]) => w > 480));\n108:     expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n109:   });\n110: \n111:   it(\"keeps the hierarchy: the headline numbers are at least 1.5x the stat numbers and all tile labels share one size, at every canvas\", async () => {\n112:     for (const over of [{}, { counts: MAXED }, { milestones: TEN }] as WeeklyRunReportProps[]) {\n113:       for (const [w, h] of CONTRACT_CANVASES) {\n114:         if (over.milestones === TEN && w < 1080) continue;\n115:         const doc = await render(over, w, h);\n116:         const t = texts(doc);\n117:         const px = (prefix: string) => t.filter((x) => x.label.startsWith(prefix)).map((x) => x.px);\n118:         const hero = px(\"value-finishers\").concat(px(\"value-volunteers\"));\n119:         const stat = [\"newPbs\", \"firstTimers\", \"visitors\", \"firstTimeVolunteers\"].flatMap((k) => px(`value-${k}`));\n120:         expect(hero).toHaveLength(2);\n121:         expect(stat).toHaveLength(4);\n122:         expect(Math.min(...hero)).toBeGreaterThanOrEqual(1.5 * Math.max(...stat));\n123:         // ...and no club number outranks a stat number.\n124:         for (const b of px(\"badge-club-\")) expect(b).toBeLessThanOrEqual(Math.min(...stat));\n125:         expect(new Set(px(\"label-\")).size).toBe(1);\n126:       }\n127:     }\n128:   });\n129: \n130:   it(\"reflows by aspect: 4x1 stats on the square, 2x2 in portrait and in the wide right column, no slab tiles\", () => {\n131:     const sq = layoutWeeklyRunReport({}, 1080, 1080);\n132:     expect(sq.shape).toBe(\"square\");\n133:     expect(new Set(sq.statRects.map((r) => r.y)).size).toBe(1);\n134:     const tall = layoutWeeklyRunReport({}, 1080, 1920);\n135:     expect(tall.shape).toBe(\"tall\");\n136:     expect(new Set(tall.statRects.map((r) => r.y)).size).toBe(2);\n137:     const wide = layoutWeeklyRunReport({}, 1920, 1080);\n138:     expect(wide.shape).toBe(\"wide\");\n139:     expect(wide.heroRects[0].x).toBe(wide.heroRects[1].x);\n140:     expect(new Set(wide.statRects.map((r) => r.x)).size).toBe(2);\n141:     for (const [w, h] of CONTRACT_CANVASES) {\n142:       const L = layoutWeeklyRunReport({}, w, h);\n143:       for (const r of [...L.heroRects, ...L.statRects]) expect(r.h).toBeLessThanOrEqual(Math.ceil(r.w * 1.3));\n144:     }\n145:   });\n146: \n147:   it(\"keeps the milestone band every week: the empty week says so, six clubs wrap to 3 + 3, ten to 5 + 5\", async () => {\n148:     const empty = await render({ milestones: \"\" });\n149:     expect(textOf(empty, \"milestone-empty\")).toBe(\"No milestone clubs this week\");\n150:     expect(texts(empty).some((t) => t.label.startsWith(\"badge-\"))).toBe(false);\n151:     expect(layoutWeeklyRunReport({ milestones: \"\" }, 1080, 1080).band).toEqual(layoutWeeklyRunReport({}, 1080, 1080).band);\n152:     const rows = (s: string, w: number, h: number) => {\n153:       const ys = layoutWeeklyRunReport({ milestones: s }, w, h).badges.map((b) => b.rect.y);\n154:       return [...new Set(ys)].map((y) => ys.filter((v) => v === y).length);\n155:     };\n156:     expect(rows(SIX, 1080, 1080)).toEqual([3, 3]);\n157:     expect(rows(TEN, 1080, 1080)).toEqual([5, 5]);\n158:     expect(rows(TEN, 1080, 1920)).toEqual([5, 5]);\n159:     expect(rows(TEN, 1920, 1080)).toEqual([5, 5]);\n160:     // Mid-size canvases whose lattice snap trims the badges still take every club count.\n161:     for (const [w, h] of [[1000, 800], [1200, 900], [1290, 1000], [1440, 900], [1024, 768], [1600, 900]] as const) {\n162:       for (let n = 6; n <= 10; n++) expect(() => settleLayout({ milestones: TEN.split(\", \").slice(0, n).join(\", \") }, w, h)).not.toThrow();\n163:     }\n164:     expect(rows(SIX, 1920, 1080)).toEqual([3, 3]);\n165:     expect(rows(SIX, 1080, 1920)).toEqual([3, 3]);\n166:     // Only a band whose two rows would fall below the floor (here a wide thumbnail) takes one long row.\n167:     expect(settleLayout({ milestones: SIX }, 480, 270).L.badges.map((b) => b.rect.y).every((y, _, a) => y === a[0])).toBe(true);\n168:     const wide = layoutWeeklyRunReport({ milestones: TEN }, 1920, 1080).badges;\n169:     expect(new Set(wide.map((b) => `${b.rect.w}x${b.rect.h}`)).size).toBe(1);\n170:     expect(() => settleLayout({ milestones: TEN }, 480, 270)).toThrow(/milestones cannot be fitted on 480x270/);\n171:     expect(settleLayout({ milestones: TEN }, 640, 360).L.badges).toHaveLength(10);\n172:     expect(settleLayout({ milestones: SIX }, 480, 270).L.badges).toHaveLength(6);\n173:   });\n174: \n175:   it(\"parses the runstats milestones line: run clubs then volunteer clubs, ascending, and names a bad entry\", () => {\n176:     const show = (s: string) => parseMilestones(s).map((b) => `${b.kind}${b.club} ${b.caption}`);\n177:     expect(show(\"4xR25, 3xR50, 1xR100, 2xV25\")).toEqual([\"R25 4 runners\", \"R50 3 runners\", \"R100 1 runner\", \"V25 2 volunteers\"]);\n178:     expect(show(\"1xr100,4xR25\")).toEqual([\"R25 4 runners\", \"R100 1 runner\"]);\n179:     expect(show(\" 1 x V50 , 2xr25 \")).toEqual([\"R25 2 runners\", \"V50 1 volunteer\"]);\n180:     expect(show(\"\")).toEqual([]);\n181:     expect(() => parseMilestones(\"4xR30\")).toThrow(/'R30' is not a club \\(25, 50, 100, 250, 500, 1000\\)/);\n182:     expect(() => parseMilestones(\"4xR25, 2xR25\")).toThrow(/R25 appears twice/);\n183:     expect(() => parseMilestones(`${TEN}, 1xV500`)).toThrow(/11 entries; at most 10/);\n184:     expect(() => parseMilestones(\"R25\")).toThrow(/\"R25\" is not <count>x<R\\|V><club>/);\n185:   });\n186: \n187:   it(\"prints numbers and dates exactly: a thousands comma, the weekday from the date\", () => {\n188:     expect(formatCount(1204)).toBe(\"1,204\");\n189:     expect(formatCount(9999)).toBe(\"9,999\");\n190:     expect(formatCount(999)).toBe(\"999\");\n191:     expect(formatCount(0)).toBe(\"0\");\n192:     expect(formatRunDate(\"2026-10-03\")).toBe(\"SAT 03 OCT 2026\");\n193:     expect(formatRunDate(\"2004-10-02\")).toBe(\"SAT 02 OCT 2004\");\n194:     expect(formatRunDate(\"2026-12-25\")).toBe(\"FRI 25 DEC 2026\");\n195:     expect(formatRunDate(\"2024-02-29\")).toBe(\"THU 29 FEB 2024\");\n196:     expect(formatRunDate(\"2026-02-30\")).toBeNull();\n197:     expect(formatRunDate(\"03/10/2026\")).toBeNull();\n198:   });\n199: \n200:   it(\"refuses every bad input with a message that names the field and the value\", async () => {\n201:     const counts = { ...WeeklyRunReportV1.defaultProps.counts! };\n202:     await expect(render({ counts: { ...counts, pb: 3 } as never })).rejects.toThrow(/counts has an unknown key 'pb'; use finishers, volunteers/);\n203:     const { newPbs: _drop, ...missing } = counts;\n204:     await expect(render({ counts: missing as never })).rejects.toThrow(/counts is missing 'newPbs'/);\n205:     await expect(render({ counts: { ...counts, newPbs: 300 } })).rejects.toThrow(/counts.newPbs is 300, more than the 214 finishers/);\n206:     await expect(render({ counts: { ...counts, firstTimeVolunteers: 40 } })).rejects.toThrow(/counts.firstTimeVolunteers is 40, more than the 31 volunteers/);\n207:     await expect(render({ counts: { ...counts, finishers: 0 } })).rejects.toThrow(/counts.finishers must be at least 1/);\n208:     await expect(render({ counts: { ...counts, visitors: 2.5 } })).rejects.toThrow(/counts.visitors must be a whole number/);\n209:     await expect(render({ counts: { ...counts, finishers: 10000 } })).rejects.toThrow(/counts.finishers must be a whole number from 0 to 9999/);\n210:     await expect(render({ milestones: \"4xR30\" })).rejects.toThrow(/milestones 'R30' is not a club/);\n211:     await expect(render({ milestones: \"4xR25, 2xR25\" })).rejects.toThrow(/R25 appears twice/);\n212:     await expect(render({ date: \"2026-02-30\" })).rejects.toThrow(/date \"2026-02-30\" is not a date/);\n213:     await expect(render({ runNumber: 0 })).rejects.toThrow(/runNumber must be a whole number from 1 to 9999/);\n214:     await expect(render({ eventName: \"\" })).rejects.toThrow(/eventName must not be empty/);\n215:     await expect(render({ eventName: \"Park → 5k\" })).rejects.toThrow(/eventName .* has the character .* \\(U\\+2192\\)/);\n216:     await expect(render({ eventName: \"A\".repeat(41) })).rejects.toThrow(/eventName .* is 41 characters; the card fits at most 40/);\n217:     // The footer has no length cap: it shrinks to the floor and only then is refused.\n218:     expect(textOf(await render({ footer: \"Thanks to all 58 volunteers - see you next Saturday at 9am by the cafe!\" }), \"footer\")).toMatch(/cafe!$/);\n219:     await expect(render({ footer: \"word \".repeat(60).trim() })).rejects.toThrow(/footer cannot be fitted on 1080x1080 above the 18px readability floor/);\n220:     await expect(render({ accent: \"green\" })).rejects.toThrow(/accent \"green\" must be #rrggbb/);\n221:     // A misspelled prop is refused by name, so a typo never leaves the sample week on a real card.\n222:     // counts may arrive as the raw JSON string a json prop's editor holds.\n223:     expect(textOf(await render({ counts: JSON.stringify({ ...counts, finishers: 1204 }) } as never), \"value-finishers\")).toBe(\"1,204\");\n224:     await expect(render({ counts: \"{finishers: 214\" } as never)).rejects.toThrow(/counts is not valid JSON/);\n225:     await expect(render({ count: counts } as never)).rejects.toThrow(/unknown prop 'count'; did you mean 'counts'\\?/);\n226:     await expect(render({ milestone: \"1xR50\" } as never)).rejects.toThrow(/unknown prop 'milestone'; did you mean 'milestones'\\?/);\n227:     await expect(render({ colour: \"#000000\" } as never)).rejects.toThrow(/unknown prop 'colour'\\. The props are eventName/);\n228:     // Club counts cannot exceed the people who ran or volunteered.\n229:     const small = { finishers: 40, newPbs: 5, firstTimers: 3, visitors: 2, volunteers: 8, firstTimeVolunteers: 1 };\n230:     await expect(render({ counts: small, milestones: \"30xR25, 20xR50\" })).rejects.toThrow(/milestones count 50 runners reaching a club, more than the 40 finishers/);\n231:     await expect(render({ counts: small, milestones: \"9xV25\" })).rejects.toThrow(/milestones count 9 volunteers reaching a club, more than the 8 volunteers/);\n232:     expect(await render({ counts: small, milestones: \"40xR25, 8xV25\" })).toBeDefined();\n233:   });\n234: \n235:   it(\"takes accented Latin names, an empty date and footer, and a pale accent without losing the numbers\", async () => {\n236:     const doc = await render({ eventName: \"Llyn Padarn Pàrc 5k\", date: \"\", footer: \"\" });\n237:     expect(textOf(doc, \"event-name\")).toBe(\"LLYN PADARN PÀRC 5K\");\n238:     expect(textOf(doc, \"run-date\")).toBeUndefined();\n239:     expect(textOf(doc, \"footer\")).toBeUndefined();\n240:     // \"\" falls back to the default accent.\n241:     expect(layoutWeeklyRunReport({ accent: \"\" }, 1080, 1080).p.accent).toBe(\"#1f7a4d\");\n242:     // A pale accent keeps the fills and the numbers go to ink.\n243:     const pale = layoutWeeklyRunReport({ accent: \"#ffd23f\" }, 1080, 1080);\n244:     expect(pale.p.heroInk).toBe(\"#1b1f1c\");\n245:     expect(layoutWeeklyRunReport({}, 1080, 1080).p.heroInk).toBe(\"#1f7a4d\");\n246:   });\n247: \n248:   it(\"is the event's card, not ours: no parkrun word in the defaults or the fixed copy, no template credit\", async () => {\n249:     const doc = await render();\n250:     const all = JSON.stringify(WeeklyRunReportV1.defaultProps) + texts(doc).map((t) => t.text).join(\" \");\n251:     expect(all.toLowerCase()).not.toContain(\"parkrun\");\n252:     const noFooter = await render({ footer: \"\" });\n253:     // Without the footer, nothing on the card is copy the run director did not type, except the fixed labels.\n254:     expect(texts(noFooter).map((t) => t.label).filter((l) => !/^(event-name|run-|value-|label-|band-title|badge-)/.test(l))).toEqual([]);\n255:   });\n256: \n257:   it(\"is deterministic\", async () => {\n258:     expect(await render()).toEqual(await render());\n259:     expect(await render({ milestones: TEN }, 1920, 1080)).toEqual(await render({ milestones: TEN }, 1920, 1080));\n260:   });\n261: });\n\n(End of file - total 261 lines)\n</content>","metadata":{"preview":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { resolvePropBindings } from \"@m0saic/template-utils\";\nimport type { MosaicDocument } from \"@m0saic/types\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { CONTRACT_CANVASES, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport {\n  WeeklyRunReportV1,\n  formatCount,\n  formatRunDate,\n  layoutWeeklyRunReport,\n  parseMilestones,\n  settleLayout,\n} from \"./weekly-run-report\";\nimport type { WeeklyRunReportProps } from \"./weekly-run-report\";\n\nconst ID = \"@one-a-day/community/weekly-run-report/v1\";\nconst render = (props: WeeklyRunReportProps = {}, w = 1080, h = 1080) =>\n  WeeklyRunReportV1.render({ ...WeeklyRunReportV1.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\src\\community\\weekly-run-report\\v1\\weekly-run-report.test.ts","text":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { resolvePropBindings } from \"@m0saic/template-utils\";\nimport type { MosaicDocument } from \"@m0saic/types\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { CONTRACT_CANVASES, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport {\n  WeeklyRunReportV1,\n  formatCount,\n  formatRunDate,\n  layoutWeeklyRunReport,\n  parseMilestones,\n  settleLayout,\n} from \"./weekly-run-report\";\nimport type { WeeklyRunReportProps } from \"./weekly-run-report\";\n\nconst ID = \"@one-a-day/community/weekly-run-report/v1\";\nconst render = (props: WeeklyRunReportProps = {}, w = 1080, h = 1080) =>\n  WeeklyRunReportV1.render({ ...WeeklyRunReportV1.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n\n/** Every drawn string with its label: the parent's and those inside each child document (a tile, a badge). */\nfunction texts(doc: MosaicDocument): Array<{ label: string; text: string; px: number }> {\n  const own = (d: MosaicDocument) => (d.sources ?? [])\n    .filter((s) => (s as { type?: string }).type === \"text\")\n    .map((s) => {\n      const src = s as unknown as { editor?: { label?: string }; layers: Array<{ content: { text: string }; style: { fontSize: number } }> };\n      return { label: src.editor?.label ?? \"\", text: src.layers[0].content.text, px: src.layers[0].style.fontSize };\n    });\n  return [...own(doc), ...Object.values(doc.children ?? {}).flatMap((c) => own(c as MosaicDocument))];\n}\nconst textOf = (doc: MosaicDocument, label: string) => texts(doc).find((t) => t.label === label)?.text;\n\nconst TEN = \"6xR25, 4xR50, 3xR100, 2xR250, 1xR500, 1xR1000, 5xV25, 3xV50, 2xV100, 1xV250\";\nconst SIX = \"6xR25, 4xR50, 3xR100, 2xR250, 1xR500, 5xV25\";\nconst MAXED = { finishers: 9999, newPbs: 9999, firstTimers: 9999, visitors: 9999, volunteers: 9999, firstTimeVolunteers: 9999 };\n\ndescribe(ID, () => {\n  it(\"draws the default week the brief promised, every string as typed\", async () => {\n    const doc = await render();\n    expect(textOf(doc, \"event-name\")).toBe(\"WILLOWMERE PARK 5K\");\n    expect(textOf(doc, \"run-number\")).toBe(\"#312\");\n    expect(textOf(doc, \"run-date\")).toBe(\"SAT 03 OCT 2026\");\n    expect(textOf(doc, \"value-finishers\")).toBe(\"214\");\n    expect(textOf(doc, \"value-volunteers\")).toBe(\"31\");\n    expect(textOf(doc, \"value-newPbs\")).toBe(\"38\");\n    expect(textOf(doc, \"value-firstTimers\")).toBe(\"27\");\n    expect(textOf(doc, \"value-visitors\")).toBe(\"19\");\n    expect(textOf(doc, \"value-firstTimeVolunteers\")).toBe(\"4\");\n    expect(textOf(doc, \"band-title\")).toBe(\"MILESTONE CLUBS\");\n    expect([1, 2, 3, 4].map((i) => `${textOf(doc, `badge-club-${i}`)} ${textOf(doc, `badge-caption-${i}`)}`)).toEqual([\n      \"25 4 runners\", \"50 3 runners\", \"100 1 runner\", \"25 2 volunteers\",\n    ]);\n    expect(textOf(doc, \"footer\")).toBe(\"Sample week: event and numbers are invented\");\n    // Every string on the card is ASCII.\n    for (const t of texts(doc)) expect(t.text).toMatch(/^[\\x20-\\x7e]+$/);\n  });\n\n  it(\"binds what it shows: the header props, each count to its own key, the footer, the accent and the band\", async () => {\n    const doc = await render();\n    const { byProp, rejected } = resolvePropBindings(doc, 1080, 1080, { propsSchema: WeeklyRunReportV1.propsSchema });\n    expect(rejected).toEqual([]);\n    for (const k of [\"eventName\", \"runNumber\", \"date\", \"footer\", \"accent\", \"milestones\"]) expect(byProp[k]).toHaveLength(1);\n    expect(byProp.counts).toHaveLength(6);\n  });\n\n  it(\"clears its safe minimum at its own hint\", async () => {\n    const ev = evaluateM0(String((await render()).m0), { width: 1080, height: 1080 });\n    expect(ev.feasible && ev.meetsPrecision).toBe(true);\n  });\n\n  it(\"draws each tile and badge as a child document on the lattice: no recovery inset on a child, 5-smooth child canvases\", async () => {\n    const smooth = (n: number) => { let k = n; for (const f of [2, 3, 5]) while (k % f === 0) k /= f; return k === 1; };\n    for (const over of [{}, { milestones: TEN }, { milestones: \"\" }, { eventName: \"Great Salterns Nature Reserve 5k Juniors\", counts: MAXED }] as WeeklyRunReportProps[]) {\n      for (const [w, h] of CONTRACT_CANVASES) {\n        if (over.milestones === TEN && w <= 480) continue;\n        const doc = await render(over, w, h);\n        const refs = (doc.sources ?? []).filter((s) => (s as { type?: string }).type === \"mosaic\");\n        expect(refs.length).toBe(Object.keys(doc.children ?? {}).length);\n        for (const r of refs) expect((r as { placement?: { inset?: unknown } }).placement?.inset).toBeUndefined();\n        for (const c of Object.values(doc.children ?? {})) {\n          const size = (c as MosaicDocument).size!;\n          expect(smooth(size.width) && smooth(size.height)).toBe(true);\n        }\n      }\n    }\n  });\n\n  it(\"keeps its layout contract at the seven contract canvases for the copy that stresses it\", async () => {\n    expect(layoutIntentOf(await render())).not.toBeNull();\n    const sweep = (over: WeeklyRunReportProps, canvases = CONTRACT_CANVASES) =>\n      sweepLayout((p, ctx) => WeeklyRunReportV1.render(p, ctx).then(asDocument), ID, { ...WeeklyRunReportV1.defaultProps, ...over }, (w, h) => targetCtx(w, h), canvases);\n    for (const over of [\n      {},\n      { eventName: \"Great Salterns Nature Reserve 5k\" },\n      { eventName: \"Great Salterns Nature Reserve 5k Juniors\" },\n      { eventName: \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" },\n      { counts: MAXED, runNumber: 9999 },\n      { milestones: \"\" },\n      { milestones: \"1xR100\" },\n      { milestones: SIX },\n      { footer: \"\" },\n      { footer: \"Thanks to all 31 volunteers - see you next Saturday at 9am by the cafe\" },\n      { date: \"\" },\n      { accent: \"#ffd23f\" },\n    ] as WeeklyRunReportProps[]) await sweep(over);\n    // Ten clubs: every canvas from 640x360 up; the 480x270 thumbnail refuses them (below).\n    await sweep({ milestones: TEN, counts: MAXED }, CONTRACT_CANVASES.filter(([w]) => w > 480));\n    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n  });\n\n  it(\"keeps the hierarchy: the headline numbers are at least 1.5x the stat numbers and all tile labels share one size, at every canvas\", async () => {\n    for (const over of [{}, { counts: MAXED }, { milestones: TEN }] as WeeklyRunReportProps[]) {\n      for (const [w, h] of CONTRACT_CANVASES) {\n        if (over.milestones === TEN && w < 1080) continue;\n        const doc = await render(over, w, h);\n        const t = texts(doc);\n        const px = (prefix: string) => t.filter((x) => x.label.startsWith(prefix)).map((x) => x.px);\n        const hero = px(\"value-finishers\").concat(px(\"value-volunteers\"));\n        const stat = [\"newPbs\", \"firstTimers\", \"visitors\", \"firstTimeVolunteers\"].flatMap((k) => px(`value-${k}`));\n        expect(hero).toHaveLength(2);\n        expect(stat).toHaveLength(4);\n        expect(Math.min(...hero)).toBeGreaterThanOrEqual(1.5 * Math.max(...stat));\n        // ...and no club number outranks a stat number.\n        for (const b of px(\"badge-club-\")) expect(b).toBeLessThanOrEqual(Math.min(...stat));\n        expect(new Set(px(\"label-\")).size).toBe(1);\n      }\n    }\n  });\n\n  it(\"reflows by aspect: 4x1 stats on the square, 2x2 in portrait and in the wide right column, no slab tiles\", () => {\n    const sq = layoutWeeklyRunReport({}, 1080, 1080);\n    expect(sq.shape).toBe(\"square\");\n    expect(new Set(sq.statRects.map((r) => r.y)).size).toBe(1);\n    const tall = layoutWeeklyRunReport({}, 1080, 1920);\n    expect(tall.shape).toBe(\"tall\");\n    expect(new Set(tall.statRects.map((r) => r.y)).size).toBe(2);\n    const wide = layoutWeeklyRunReport({}, 1920, 1080);\n    expect(wide.shape).toBe(\"wide\");\n    expect(wide.heroRects[0].x).toBe(wide.heroRects[1].x);\n    expect(new Set(wide.statRects.map((r) => r.x)).size).toBe(2);\n    for (const [w, h] of CONTRACT_CANVASES) {\n      const L = layoutWeeklyRunReport({}, w, h);\n      for (const r of [...L.heroRects, ...L.statRects]) expect(r.h).toBeLessThanOrEqual(Math.ceil(r.w * 1.3));\n    }\n  });\n\n  it(\"keeps the milestone band every week: the empty week says so, six clubs wrap to 3 + 3, ten to 5 + 5\", async () => {\n    const empty = await render({ milestones: \"\" });\n    expect(textOf(empty, \"milestone-empty\")).toBe(\"No milestone clubs this week\");\n    expect(texts(empty).some((t) => t.label.startsWith(\"badge-\"))).toBe(false);\n    expect(layoutWeeklyRunReport({ milestones: \"\" }, 1080, 1080).band).toEqual(layoutWeeklyRunReport({}, 1080, 1080).band);\n    const rows = (s: string, w: number, h: number) => {\n      const ys = layoutWeeklyRunReport({ milestones: s }, w, h).badges.map((b) => b.rect.y);\n      return [...new Set(ys)].map((y) => ys.filter((v) => v === y).length);\n    };\n    expect(rows(SIX, 1080, 1080)).toEqual([3, 3]);\n    expect(rows(TEN, 1080, 1080)).toEqual([5, 5]);\n    expect(rows(TEN, 1080, 1920)).toEqual([5, 5]);\n    expect(rows(TEN, 1920, 1080)).toEqual([5, 5]);\n    // Mid-size canvases whose lattice snap trims the badges still take every club count.\n    for (const [w, h] of [[1000, 800], [1200, 900], [1290, 1000], [1440, 900], [1024, 768], [1600, 900]] as const) {\n      for (let n = 6; n <= 10; n++) expect(() => settleLayout({ milestones: TEN.split(\", \").slice(0, n).join(\", \") }, w, h)).not.toThrow();\n    }\n    expect(rows(SIX, 1920, 1080)).toEqual([3, 3]);\n    expect(rows(SIX, 1080, 1920)).toEqual([3, 3]);\n    // Only a band whose two rows would fall below the floor (here a wide thumbnail) takes one long row.\n    expect(settleLayout({ milestones: SIX }, 480, 270).L.badges.map((b) => b.rect.y).every((y, _, a) => y === a[0])).toBe(true);\n    const wide = layoutWeeklyRunReport({ milestones: TEN }, 1920, 1080).badges;\n    expect(new Set(wide.map((b) => `${b.rect.w}x${b.rect.h}`)).size).toBe(1);\n    expect(() => settleLayout({ milestones: TEN }, 480, 270)).toThrow(/milestones cannot be fitted on 480x270/);\n    expect(settleLayout({ milestones: TEN }, 640, 360).L.badges).toHaveLength(10);\n    expect(settleLayout({ milestones: SIX }, 480, 270).L.badges).toHaveLength(6);\n  });\n\n  it(\"parses the runstats milestones line: run clubs then volunteer clubs, ascending, and names a bad entry\", () => {\n    const show = (s: string) => parseMilestones(s).map((b) => `${b.kind}${b.club} ${b.caption}`);\n    expect(show(\"4xR25, 3xR50, 1xR100, 2xV25\")).toEqual([\"R25 4 runners\", \"R50 3 runners\", \"R100 1 runner\", \"V25 2 volunteers\"]);\n    expect(show(\"1xr100,4xR25\")).toEqual([\"R25 4 runners\", \"R100 1 runner\"]);\n    expect(show(\" 1 x V50 , 2xr25 \")).toEqual([\"R25 2 runners\", \"V50 1 volunteer\"]);\n    expect(show(\"\")).toEqual([]);\n    expect(() => parseMilestones(\"4xR30\")).toThrow(/'R30' is not a club \\(25, 50, 100, 250, 500, 1000\\)/);\n    expect(() => parseMilestones(\"4xR25, 2xR25\")).toThrow(/R25 appears twice/);\n    expect(() => parseMilestones(`${TEN}, 1xV500`)).toThrow(/11 entries; at most 10/);\n    expect(() => parseMilestones(\"R25\")).toThrow(/\"R25\" is not <count>x<R\\|V><club>/);\n  });\n\n  it(\"prints numbers and dates exactly: a thousands comma, the weekday from the date\", () => {\n    expect(formatCount(1204)).toBe(\"1,204\");\n    expect(formatCount(9999)).toBe(\"9,999\");\n    expect(formatCount(999)).toBe(\"999\");\n    expect(formatCount(0)).toBe(\"0\");\n    expect(formatRunDate(\"2026-10-03\")).toBe(\"SAT 03 OCT 2026\");\n    expect(formatRunDate(\"2004-10-02\")).toBe(\"SAT 02 OCT 2004\");\n    expect(formatRunDate(\"2026-12-25\")).toBe(\"FRI 25 DEC 2026\");\n    expect(formatRunDate(\"2024-02-29\")).toBe(\"THU 29 FEB 2024\");\n    expect(formatRunDate(\"2026-02-30\")).toBeNull();\n    expect(formatRunDate(\"03/10/2026\")).toBeNull();\n  });\n\n  it(\"refuses every bad input with a message that names the field and the value\", async () => {\n    const counts = { ...WeeklyRunReportV1.defaultProps.counts! };\n    await expect(render({ counts: { ...counts, pb: 3 } as never })).rejects.toThrow(/counts has an unknown key 'pb'; use finishers, volunteers/);\n    const { newPbs: _drop, ...missing } = counts;\n    await expect(render({ counts: missing as never })).rejects.toThrow(/counts is missing 'newPbs'/);\n    await expect(render({ counts: { ...counts, newPbs: 300 } })).rejects.toThrow(/counts.newPbs is 300, more than the 214 finishers/);\n    await expect(render({ counts: { ...counts, firstTimeVolunteers: 40 } })).rejects.toThrow(/counts.firstTimeVolunteers is 40, more than the 31 volunteers/);\n    await expect(render({ counts: { ...counts, finishers: 0 } })).rejects.toThrow(/counts.finishers must be at least 1/);\n    await expect(render({ counts: { ...counts, visitors: 2.5 } })).rejects.toThrow(/counts.visitors must be a whole number/);\n    await expect(render({ counts: { ...counts, finishers: 10000 } })).rejects.toThrow(/counts.finishers must be a whole number from 0 to 9999/);\n    await expect(render({ milestones: \"4xR30\" })).rejects.toThrow(/milestones 'R30' is not a club/);\n    await expect(render({ milestones: \"4xR25, 2xR25\" })).rejects.toThrow(/R25 appears twice/);\n    await expect(render({ date: \"2026-02-30\" })).rejects.toThrow(/date \"2026-02-30\" is not a date/);\n    await expect(render({ runNumber: 0 })).rejects.toThrow(/runNumber must be a whole number from 1 to 9999/);\n    await expect(render({ eventName: \"\" })).rejects.toThrow(/eventName must not be empty/);\n    await expect(render({ eventName: \"Park → 5k\" })).rejects.toThrow(/eventName .* has the character .* \\(U\\+2192\\)/);\n    await expect(render({ eventName: \"A\".repeat(41) })).rejects.toThrow(/eventName .* is 41 characters; the card fits at most 40/);\n    // The footer has no length cap: it shrinks to the floor and only then is refused.\n    expect(textOf(await render({ footer: \"Thanks to all 58 volunteers - see you next Saturday at 9am by the cafe!\" }), \"footer\")).toMatch(/cafe!$/);\n    await expect(render({ footer: \"word \".repeat(60).trim() })).rejects.toThrow(/footer cannot be fitted on 1080x1080 above the 18px readability floor/);\n    await expect(render({ accent: \"green\" })).rejects.toThrow(/accent \"green\" must be #rrggbb/);\n    // A misspelled prop is refused by name, so a typo never leaves the sample week on a real card.\n    // counts may arrive as the raw JSON string a json prop's editor holds.\n    expect(textOf(await render({ counts: JSON.stringify({ ...counts, finishers: 1204 }) } as never), \"value-finishers\")).toBe(\"1,204\");\n    await expect(render({ counts: \"{finishers: 214\" } as never)).rejects.toThrow(/counts is not valid JSON/);\n    await expect(render({ count: counts } as never)).rejects.toThrow(/unknown prop 'count'; did you mean 'counts'\\?/);\n    await expect(render({ milestone: \"1xR50\" } as never)).rejects.toThrow(/unknown prop 'milestone'; did you mean 'milestones'\\?/);\n    await expect(render({ colour: \"#000000\" } as never)).rejects.toThrow(/unknown prop 'colour'\\. The props are eventName/);\n    // Club counts cannot exceed the people who ran or volunteered.\n    const small = { finishers: 40, newPbs: 5, firstTimers: 3, visitors: 2, volunteers: 8, firstTimeVolunteers: 1 };\n    await expect(render({ counts: small, milestones: \"30xR25, 20xR50\" })).rejects.toThrow(/milestones count 50 runners reaching a club, more than the 40 finishers/);\n    await expect(render({ counts: small, milestones: \"9xV25\" })).rejects.toThrow(/milestones count 9 volunteers reaching a club, more than the 8 volunteers/);\n    expect(await render({ counts: small, milestones: \"40xR25, 8xV25\" })).toBeDefined();\n  });\n\n  it(\"takes accented Latin names, an empty date and footer, and a pale accent without losing the numbers\", async () => {\n    const doc = await render({ eventName: \"Llyn Padarn Pàrc 5k\", date: \"\", footer: \"\" });\n    expect(textOf(doc, \"event-name\")).toBe(\"LLYN PADARN PÀRC 5K\");\n    expect(textOf(doc, \"run-date\")).toBeUndefined();\n    expect(textOf(doc, \"footer\")).toBeUndefined();\n    // \"\" falls back to the default accent.\n    expect(layoutWeeklyRunReport({ accent: \"\" }, 1080, 1080).p.accent).toBe(\"#1f7a4d\");\n    // A pale accent keeps the fills and the numbers go to ink.\n    const pale = layoutWeeklyRunReport({ accent: \"#ffd23f\" }, 1080, 1080);\n    expect(pale.p.heroInk).toBe(\"#1b1f1c\");\n    expect(layoutWeeklyRunReport({}, 1080, 1080).p.heroInk).toBe(\"#1f7a4d\");\n  });\n\n  it(\"is the event's card, not ours: no parkrun word in the defaults or the fixed copy, no template credit\", async () => {\n    const doc = await render();\n    const all = JSON.stringify(WeeklyRunReportV1.defaultProps) + texts(doc).map((t) => t.text).join(\" \");\n    expect(all.toLowerCase()).not.toContain(\"parkrun\");\n    const noFooter = await render({ footer: \"\" });\n    // Without the footer, nothing on the card is copy the run director did not type, except the fixed labels.\n    expect(texts(noFooter).map((t) => t.label).filter((l) => !/^(event-name|run-|value-|label-|band-title|badge-)/.test(l))).toEqual([]);\n  });\n\n  it(\"is deterministic\", async () => {\n    expect(await render()).toEqual(await render());\n    expect(await render({ milestones: TEN }, 1920, 1080)).toEqual(await render({ milestones: TEN }, 1920, 1080));\n  });\n});","lineStart":1,"lineEnd":261,"totalLines":261,"truncated":false}},"title":"src\\community\\weekly-run-report\\v1\\weekly-run-report.test.ts","time":{"start":1792528614237,"end":1792528614282}},"id":"prt_15b08027b001nImXN7P98YTpD8","sessionID":"ses_ea4f89b40ffeJA5Vf8sjCWqpcq","messageID":"msg_15b07f67c001yZ0HnO5nDfXTww"}}
