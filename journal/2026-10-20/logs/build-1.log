logy\", \"gedcom\", \"pedigree\", \"ancestry\", \"birthplace\", \"family-tree\", \"video\"],\n  },\n  {\n    slug: \"geocache-milestone-card\",\n    templateId: \"@one-a-day/community/geocache-milestone-card/v1\",\n    exportName: \"GeocacheMilestoneCardV1\",\n    title: \"2026-10-20 · Geocache Milestone Card\",\n    description:\n      \"Geocache Milestone Card: describe the ONE concept this template teaches, in one line, for the Templates page.\",\n    tags: [\"community\",\"2026-10-20\",\"day-031\"],\n  },\n];","lineStart":1,"lineEnd":43,"totalLines":43,"truncated":false}},"title":"src\\community\\registry.ts","time":{"start":1792528783611,"end":1792528783657}},"id":"prt_15b0a985e001B57l6rXctLQzUH","sessionID":"ses_ea4f89b40ffeJA5Vf8sjCWqpcq","messageID":"msg_15b0a87a6001oDSBgRQ7hMo4NR"}}
