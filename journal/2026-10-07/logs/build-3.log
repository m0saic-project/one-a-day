{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018TbeKw9k5zsrtdpCovV4RC","type":"tool_result","content":"1\timport { evaluateM0 } from \"@m0saic/dsl-stdlib\";\n2\timport { resolvePropBindings } from \"@m0saic/template-utils\";\n3\t\n4\timport { asDocument, targetCtx } from \"../../../__testutils__/render\";\n5\timport { layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\n6\timport { ChessGameRecapV1 } from \"./chess-game-recap\";\n7\t\n8\tconst render = (\n9\t  props: Parameters<typeof ChessGameRecapV1.render>[0] = {},\n10\t  w = 1280,\n11\t  h = 720,\n12\t) => ChessGameRecapV1.render({ ...ChessGameRecapV1.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n13\t\n14\tdescribe(\"@one-a-day/sports/chess-game-recap/v1\", () => {\n15\t  it(\"binds the opening prop\", async () => {\n16\t    const doc = await render();\n17\t    const { byProp, rejected } = resolvePropBindings(doc, 1280, 720, { propsSchema: ChessGameRecapV1.propsSchema });\n18\t    expect(rejected).toEqual([]);\n19\t    expect(byProp.opening).toHaveLength(1);\n20\t  });\n21\t\n22\t  it(\"renders all required elements at defaults\", async () => {\n23\t    const doc = await render();\n24\t    // Check that all required sources are present\n25\t    const sourceLabels = doc.sources.map((s: any) => s.editor?.label).filter(Boolean);\n26\t    expect(sourceLabels).toContain(\"opening\");\n27\t    expect(sourceLabels).toContain(\"result\");\n28\t    expect(sourceLabels).toContain(\"time\");\n29\t    expect(sourceLabels).toContain(\"rating\");\n30\t    expect(sourceLabels).toContain(\"date\");\n31\t    expect(sourceLabels).toContain(\"opponent\");\n32\t  });\n33\t\n34\t  it(\"clears its safe minimum at its own hint\", async () => {\n35\t    const ev = evaluateM0(String((await render()).m0), { width: 1280, height: 720 });\n36\t    expect(ev.feasible && ev.meetsPrecision).toBe(true);\n37\t  });\n38\t\n39\t  it(\"keeps its layout contract at the seven contract canvases - defaults, long opening, empty opponent\", async () => {\n40\t    expect(layoutIntentOf(await render())).not.toBeNull();\n41\t    for (const over of [{}, { opening: \"A very long opening name that should shrink before it fits the band on a narrow canvas\" }, { opponentName: \"\" }]) {\n42\t      await sweepLayout((p, ctx) => ChessGameRecapV1.render(p, ctx).then(asDocument), \"@one-a-day/sports/chess-game-recap/v1\", { ...ChessGameRecapV1.defaultProps, ...over }, (w, h) => targetCtx(w, h));\n43\t    }\n44\t    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n45\t  });\n46\t\n47\t  it(\"renders all result types with correct colors\", async () => {\n48\t    const win = await render({ result: \"win\" });\n49\t    const loss = await render({ result: \"loss\" });\n50\t    const draw = await render({ result: \"draw\" });\n51\t    // Verify they render without error with colored result labels\n52\t    expect(win.sources).toHaveLength(6); // 6 sources: opening, result, time, rating, date, opponent\n53\t    expect(loss.sources).toHaveLength(6);\n54\t    expect(draw.sources).toHaveLength(6);\n55\t  });\n56\t\n57\t  it(\"is deterministic and validates prop types\", async () => {\n58\t    expect(await render()).toEqual(await render());\n59\t    await expect(render({ opening: 42 as never })).rejects.toThrow(/must be a string/);\n60\t    await expect(render({ result: \"invalid\" as never })).rejects.toThrow(/must be/);\n61\t    await expect(render({ ratingChange: \"not a number\" as never })).rejects.toThrow();\n62\t  });\n63\t});\n64\t"}]},"parent_tool_use_id":null,"session_id":"25441022-bd78-4c0c-94da-dd6d254f9c20","uuid":"44f2cde3-cb4b-4f75-876f-29afe70de107","timestamp":"2026-10-07T13:34:19.060Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\chess-game-recap\\v1\\chess-game-recap.test.ts","content":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { resolvePropBindings } from \"@m0saic/template-utils\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport { ChessGameRecapV1 } from \"./chess-game-recap\";\n\nconst render = (\n  props: Parameters<typeof ChessGameRecapV1.render>[0] = {},\n  w = 1280,\n  h = 720,\n) => ChessGameRecapV1.render({ ...ChessGameRecapV1.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n\ndescribe(\"@one-a-day/sports/chess-game-recap/v1\", () => {\n  it(\"binds the opening prop\", async () => {\n    const doc = await render();\n    const { byProp, rejected } = resolvePropBindings(doc, 1280, 720, { propsSchema: ChessGameRecapV1.propsSchema });\n    expect(rejected).toEqual([]);\n    expect(byProp.opening).toHaveLength(1);\n  });\n\n  it(\"renders all required elements at defaults\", async () => {\n    const doc = await render();\n    // Check that all required sources are present\n    const sourceLabels = doc.sources.map((s: any) => s.editor?.label).filter(Boolean);\n    expect(sourceLabels).toContain(\"opening\");\n    expect(sourceLabels).toContain(\"result\");\n    expect(sourceLabels).toContain(\"time\");\n    expect(sourceLabels).toContain(\"rating\");\n    expect(sourceLabels).toContain(\"date\");\n    expect(sourceLabels).toContain(\"opponent\");\n  });\n\n  it(\"clears its safe minimum at its own hint\", async () => {\n    const ev = evaluateM0(String((await render()).m0), { width: 1280, height: 720 });\n    expect(ev.feasible && ev.meetsPrecision).toBe(true);\n  });\n\n  it(\"keeps its layout contract at the seven contract canvases - defaults, long opening, empty opponent\", async () => {\n    expect(layoutIntentOf(await render())).not.toBeNull();\n    for (const over of [{}, { opening: \"A very long opening name that should shrink before it fits the band on a narrow canvas\" }, { opponentName: \"\" }]) {\n      await sweepLayout((p, ctx) => ChessGameRecapV1.render(p, ctx).then(asDocument), \"@one-a-day/sports/chess-game-recap/v1\", { ...ChessGameRecapV1.defaultProps, ...over }, (w, h) => targetCtx(w, h));\n    }\n    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n  });\n\n  it(\"renders all result types with correct colors\", async () => {\n    const win = await render({ result: \"win\" });\n    const loss = await render({ result: \"loss\" });\n    const draw = await render({ result: \"draw\" });\n    // Verify they render without error with colored result labels\n    expect(win.sources).toHaveLength(6); // 6 sources: opening, result, time, rating, date, opponent\n    expect(loss.sources).toHaveLength(6);\n    expect(draw.sources).toHaveLength(6);\n  });\n\n  it(\"is deterministic and validates prop types\", async () => {\n    expect(await render()).toEqual(await render());\n    await expect(render({ opening: 42 as never })).rejects.toThrow(/must be a string/);\n    await expect(render({ result: \"invalid\" as never })).rejects.toThrow(/must be/);\n    await expect(render({ ratingChange: \"not a number\" as never })).rejects.toThrow();\n  });\n});\n","numLines":64,"startLine":1,"totalLines":64}}}
