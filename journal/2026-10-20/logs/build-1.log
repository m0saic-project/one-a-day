er shows.\n882:       backgroundColor: (g.label === \"badge\" ? TILE : PAPER) as MosaicColor,\n883:       sources: placedChild.sources,\n884:       editor: { label: g.key },\n885:     };\n886:     pieces.push({ rect: { ...cell, importance: 2 }, source: tag({ type: \"mosaic\", ref: g.key, placement: { fit: \"contain\" } } as MosaicSource, g.key) });\n887:   }\n888: \n889:   // What the geometry promises: every text fits (above); the header on top;\n890:   // two equal headline tiles and four equal stat tiles; the milestone band\n891:   // across the lower card every week, its badges equal and inside it; the\n892:   // footer at the bottom when there is one.\n893:   const nameLabel = L.nameLines.length === 1 ? \"event-name\" : \"event-name-1\";\n894:   constraints.push({ label: nameLabel, within: { yFrac: [0, 0.25] } });\n895:   constraints.push({ label: \"header-rule\", minWidthFrac: 0.85 });\n896:   constraints.push({ label: \"hero-tile\", within: { yFrac: [0.1, 0.8] } });\n897:   constraints.push({ label: \"stat-tile\", minWidthFrac: 0.15 });\n898:   for (const k of COUNT_KEYS) constraints.push({ label: `value-${k}` });\n899:   constraints.push({ label: \"milestone-band\", within: { yFrac: [0.55, 1] }, minWidthFrac: 0.85 });\n900:   if (L.badges.length > 0) constraints.push({ label: \"badge\", within: { yFrac: [L.band.y / H, (L.band.y + L.band.h) / H] } });\n901:   else constraints.push({ label: \"milestone-empty\" });\n902:   if (L.cells.some((c) => c.label === \"footer\")) constraints.push({ label: \"footer\", within: { yFrac: [0.9, 1] } });\n903: \n904:   const relations: RelationalConstraint[] = [\n905:     { label: \"hero-tile\", equal: \"size\", tolerancePx: 2 },\n906:     { label: \"stat-tile\", equal: \"size\", tolerancePx: 2 },\n907:   ];\n908:   if (L.badges.length >= 2) relations.push({ label: \"badge\", equal: \"size\", tolerancePx: 2 });\n909: \n910:   const placed = placeInsetPieces({ rootW: W, rootH: H, pieces, basis: PARENT_BASIS });\n911:   const doc: MosaicDocument = {\n912:     kind: \"mosaic_document\",\n913:     version: 1,\n914:     m0: toM0String(placed.m0, ID),\n915:     assets: {},\n916:     backgroundColor: PAPER as MosaicColor,\n917:     sources: placed.sources,\n918:     children,\n919:   };\n920:   return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: props.debugLayout === true });\n921: }\n\n(End of file - total 921 lines)\n</content>","metadata":{"preview":"    // The header rule shows `accent`; the band is the rect that shows `milestones`.\n    push(t.group, t.rect, 1, t.bind ? bindProp(tile, t.bind) : tile);\n  }\n  for (const c of L.cells) {\n    let cell: MosaicSource = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n    // A text rect is BOUND to the prop it shows; each count to its own key of `counts`. Fixed copy is not.\n    if (c.bind?.prop === \"counts\") cell = bindPropPath(cell, \"counts\", [c.bind.key], \"number\");\n    else if (c.bind) cell = bindProp(cell, c.bind.prop);\n    push(c.group, c.rect, c.over ? 3 : 2, cell);\n    constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n  }\n  const children: NonNullable<MosaicDocument[\"children\"]> = {};\n  for (const { g, cell, pieces: own } of groupOf.values()) {\n    const placedChild = placeInsetPieces({ rootW: cell.w, rootH: cell.h, pieces: own });\n    children[g.key] = {\n      kind: \"mosaic_document\",\n      version: 1,\n      m0: toM0String(placedChild.m0, ID),\n      assets: {},\n      size: { width: cell.w, height: cell.h },","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\src\\community\\weekly-run-report\\v1\\weekly-run-report.ts","text":"    // The header rule shows `accent`; the band is the rect that shows `milestones`.\n    push(t.group, t.rect, 1, t.bind ? bindProp(tile, t.bind) : tile);\n  }\n  for (const c of L.cells) {\n    let cell: MosaicSource = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n    // A text rect is BOUND to the prop it shows; each count to its own key of `counts`. Fixed copy is not.\n    if (c.bind?.prop === \"counts\") cell = bindPropPath(cell, \"counts\", [c.bind.key], \"number\");\n    else if (c.bind) cell = bindProp(cell, c.bind.prop);\n    push(c.group, c.rect, c.over ? 3 : 2, cell);\n    constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n  }\n  const children: NonNullable<MosaicDocument[\"children\"]> = {};\n  for (const { g, cell, pieces: own } of groupOf.values()) {\n    const placedChild = placeInsetPieces({ rootW: cell.w, rootH: cell.h, pieces: own });\n    children[g.key] = {\n      kind: \"mosaic_document\",\n      version: 1,\n      m0: toM0String(placedChild.m0, ID),\n      assets: {},\n      size: { width: cell.w, height: cell.h },\n      fps: ctx.target.fps,\n      durationMs: 2000,\n      // A still's child has no alpha: its own canvas shows behind a rounded corner. Badges sit on\n      // the band's white, so theirs is white; tiles fill their whole canvas, so theirs never shows.\n      backgroundColor: (g.label === \"badge\" ? TILE : PAPER) as MosaicColor,\n      sources: placedChild.sources,\n      editor: { label: g.key },\n    };\n    pieces.push({ rect: { ...cell, importance: 2 }, source: tag({ type: \"mosaic\", ref: g.key, placement: { fit: \"contain\" } } as MosaicSource, g.key) });\n  }\n\n  // What the geometry promises: every text fits (above); the header on top;\n  // two equal headline tiles and four equal stat tiles; the milestone band\n  // across the lower card every week, its badges equal and inside it; the\n  // footer at the bottom when there is one.\n  const nameLabel = L.nameLines.length === 1 ? \"event-name\" : \"event-name-1\";\n  constraints.push({ label: nameLabel, within: { yFrac: [0, 0.25] } });\n  constraints.push({ label: \"header-rule\", minWidthFrac: 0.85 });\n  constraints.push({ label: \"hero-tile\", within: { yFrac: [0.1, 0.8] } });\n  constraints.push({ label: \"stat-tile\", minWidthFrac: 0.15 });\n  for (const k of COUNT_KEYS) constraints.push({ label: `value-${k}` });\n  constraints.push({ label: \"milestone-band\", within: { yFrac: [0.55, 1] }, minWidthFrac: 0.85 });\n  if (L.badges.length > 0) constraints.push({ label: \"badge\", within: { yFrac: [L.band.y / H, (L.band.y + L.band.h) / H] } });\n  else constraints.push({ label: \"milestone-empty\" });\n  if (L.cells.some((c) => c.label === \"footer\")) constraints.push({ label: \"footer\", within: { yFrac: [0.9, 1] } });\n\n  const relations: RelationalConstraint[] = [\n    { label: \"hero-tile\", equal: \"size\", tolerancePx: 2 },\n    { label: \"stat-tile\", equal: \"size\", tolerancePx: 2 },\n  ];\n  if (L.badges.length >= 2) relations.push({ label: \"badge\", equal: \"size\", tolerancePx: 2 });\n\n  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces, basis: PARENT_BASIS });\n  const doc: MosaicDocument = {\n    kind: \"mosaic_document\",\n    version: 1,\n    m0: toM0String(placed.m0, ID),\n    assets: {},\n    backgroundColor: PAPER as MosaicColor,\n    sources: placed.sources,\n    children,\n  };\n  return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: props.debugLayout === true });\n}","lineStart":858,"lineEnd":921,"totalLines":921,"truncated":false}},"title":"src\\community\\weekly-run-report\\v1\\weekly-run-report.ts","time":{"start":1792528610081,"end":1792528610088}},"id":"prt_15b07f22d001umVgAQocgmeQke","sessionID":"ses_ea4f89b40ffeJA5Vf8sjCWqpcq","messageID":"msg_15b07e4d3001F0QhYSQAJcP7FN"}}
