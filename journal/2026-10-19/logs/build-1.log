{"type":"tool_use","timestamp":1792416148773,"sessionID":"ses_eabad0e61ffeMfJmuPCNFqL7sc","part":{"type":"tool","tool":"read","callID":"call-f4a62779-39aa-48e6-8685-fa791d80bfb6-31","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\erg-pb-card\\v1\\erg-pb-card.test.ts","limit":180},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\src\\sports\\erg-pb-card\\v1\\erg-pb-card.test.ts</path>\n<type>file</type>\n<content>\n1: import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\n2: import { getOpentype, bundledFontPath, resolveFontFile, resolvePropBindings } from \"@m0saic/template-utils\";\n3: \n4: import { asDocument, targetCtx } from \"../../../__testutils__/render\";\n5: import { CONTRACT_CANVASES, checkLayoutIntent, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\n6: import {\n7:   ErgPbCardV1 as T,\n8:   PACE_TICKS,\n9:   ergMarkerFrac,\n10:   ergOrdinal,\n11:   layoutErgCard,\n12:   normalizeErgCard,\n13:   parseErgSplit,\n14: } from \"./erg-pb-card\";\n15: import type { ErgPbCardProps } from \"./erg-pb-card\";\n16: \n17: const ID = \"@one-a-day/sports/erg-pb-card/v1\";\n18: const render = (p: ErgPbCardProps = {}, w = 1080, h = 1080) => T.render(p, targetCtx(w, h)).then(asDocument);\n19: const textOf = (p: ErgPbCardProps, w = 1080, h = 1080) => Object.fromEntries(layoutErgCard(p, w, h).cells.map((c) => [c.label, c.text.replace(/\\n/g, \" \")]));\n20: \n21: // The copy that stresses the card: a 40-character name, a 45-character note, a\n22: // 39-character cohort beside the chip, a marathon time as the result, and the\n23: // slowest split the format allows (the marker clamps to the 3:00 end).\n24: const LONG: ErgPbCardProps = {\n25:   rower: \"Maximiliana Wolfeschlegelstein\",\n26:   note: \"the fastest 2k of the 2026 autumn head season\",\n27:   split: \"9:59.9\",\n28:   result: \"3:36:47\",\n29:   piece: \"marathon\",\n30:   percentileCohort: \"2026 rower ranking, heavyweight, 40-49\",\n31:   spm: 60,\n32:   watts: 600,\n33:   drag: 250,\n34: };\n35: const CASES: ErgPbCardProps[] = [\n36:   {},\n37:   { preset: \"light\" },\n38:   { split: \"1:00.0\" },\n39:   { split: \"3:00.0\" },\n40:   { split: \"2:00.0\" },\n41:   { percentile: 0 },\n42:   { percentile: 0, percentileCohort: \"\" },\n43:   { percentile: 1 },\n44:   { percentile: 21 },\n45:   { percentileCohort: \"\" },\n46:   { result: \"\" },\n47:   { result: \"\", piece: \"\" },\n48:   { piece: \"1 hour\", result: \"13,578 m\" },\n49:   { spm: 0 },\n50:   { watts: 0 },\n51:   { drag: 0 },\n52:   { spm: 0, watts: 0, drag: 0 },\n53:   { note: \"\" },\n54:   { spm: 10, watts: 20, drag: 50 },\n55:   LONG,\n56:   { ...LONG, preset: \"light\", accent: \"#e4572e\" },\n57:   { rower: \"Zoë Åström-Niño\" },\n58: ];\n59: \n60: describe(ID, () => {\n61:   it(\"shows the use case at its defaults: the 2026 ranking's own median 2k rower\", () => {\n62:     const t = textOf({});\n63:     expect(t).toMatchObject({\n64:       rower: \"Marcus Alder\", note: \"the 2026 season's median 2k\",\n65:       split: \"1:58.8\", \"split-unit\": \"/500m\",\n66:       result: \"7:55.0\", piece: \"2,000 m\",\n67:       percentile: \"50TH PERCENTILE\", \"percentile-cohort\": \"2026 rower ranking\",\n68:       \"stat-spm\": \"26\", \"stat-label-spm\": \"SPM\",\n69:       \"stat-watts\": \"209\", \"stat-label-watts\": \"WATTS\",\n70:       \"stat-drag\": \"110\", \"stat-label-drag\": \"DRAG\",\n71:       \"pace-tick-label-0\": \"1:00\", \"pace-tick-label-1\": \"1:30\", \"pace-tick-label-2\": \"2:00\",\n72:       \"pace-tick-label-3\": \"2:30\", \"pace-tick-label-4\": \"3:00\",\n73:       footnote: \"Split, watts and percentile as entered. The ranking moves with season, age and weight class.\",\n74:     });\n75:     // 1:58.8 -> 0.49 of the way from the 1:00 end to the 3:00 end.\n76:     expect(ergMarkerFrac(parseErgSplit(\"1:58.8\")!)).toBeCloseTo(0.49, 12);\n77:     expect(T.outputHints).toMatchObject({ width: 1080, height: 1080, format: { kind: \"image\" } });\n78:   });\n79: \n80:   it(\"parses splits in integer tenths and clamps the marker, never the printed split\", () => {\n81:     expect(parseErgSplit(\"1:58.8\")).toBe(1188);\n82:     expect(parseErgSplit(\"9:59.9\")).toBe(5999);\n83:     expect(parseErgSplit(\"1:00.0\")).toBe(600);\n84:     for (const bad of [\"\", \"0:59.5\", \"10:15.0\", \"1:58\", \"1:58.85\", \"1:60.0\", \"1:5.8\", \"1,58.8\", \"1:58,8\", \" 1:58.8\", \"1:58.8 \", \"abc\"]) expect(parseErgSplit(bad)).toBeNull();\n85:     expect([600, 601, 1188, 1200, 1800, 1805, 5999].map(ergMarkerFrac)).toEqual([0, 1 / 1200, 0.49, 0.5, 1, 1, 1]);\n86:     expect([1, 2, 3, 4, 11, 12, 13, 21, 22, 23, 50, 99].map(ergOrdinal)).toEqual([\n87:       \"1ST\", \"2ND\", \"3RD\", \"4TH\", \"11TH\", \"12TH\", \"13TH\", \"21ST\", \"22ND\", \"23RD\", \"50TH\", \"99TH\",\n88:     ]);\n89:     const n = normalizeErgCard({});\n90:     expect([n.splitText, n.splitTenths, n.markerFrac, n.clamped]).toEqual([\"1:58.8\", 1188, 0.49, false]);\n91:     // Outside the track: the marker clamps, the figure does not.\n92:     const slow = normalizeErgCard({ split: \"9:59.9\" });\n93:     expect([slow.splitText, slow.markerFrac, slow.clamped]).toEqual([\"9:59.9\", 1, true]);\n94:     const fast = normalizeErgCard({ split: \"1:00.0\" });\n95:     expect([fast.splitText, fast.markerFrac, fast.clamped]).toEqual([\"1:00.0\", 0, true]);\n96:     // Every percentile the chip can show, in the chip's own words.\n97:     expect(textOf({ percentile: 1 }).percentile).toBe(\"1ST PERCENTILE\");\n98:     expect(textOf({ percentile: 11 }).percentile).toBe(\"11TH PERCENTILE\");\n99:     expect(textOf({ percentile: 21 }).percentile).toBe(\"21ST PERCENTILE\");\n100:     // The footnote names what is entered and what the ranking depends on.\n101:     expect(textOf({ percentile: 0 }).footnote).toBe(\"Split and watts as entered.\");\n102:   });\n103: \n104:   it(\"draws the marker at (split - 60) / 120 of the track, just left of 2:00 by default\", async () => {\n105:     for (const [w, h] of CONTRACT_CANVASES) {\n106:       for (const split of [\"1:58.8\", \"1:00.0\", \"2:00.0\", \"2:30.0\", \"3:00.0\", \"9:59.9\"]) {\n107:         const resolved = checkLayoutIntent(await render({ split }, w, h), w, h)!.resolved;\n108:         const track = resolved[\"pace-track\"][0].rect;\n109:         const marker = resolved[\"pace-marker\"][0].rect;\n110:         const frac = ergMarkerFrac(parseErgSplit(split)!);\n111:         // The marker's center lands on the split's place on the scale - a clamped\n112:         // marker straddles the track's end rather than hiding inside it.\n113:         expect(Math.abs(marker.x + marker.w / 2 - (track.x + frac * track.w))).toBeLessThanOrEqual(2);\n114:         expect(marker.x + marker.w / 2).toBeGreaterThanOrEqual(track.x - 1);\n115:         expect(marker.x + marker.w / 2).toBeLessThanOrEqual(track.x + track.w + 1);\n116:         // A distinct mark: bigger than a tick, riding the track's line.\n117:         const tick = resolved[\"pace-tick-2\"][0].rect;\n118:         expect(marker.w).toBeGreaterThan(tick.w);\n119:         expect(marker.y).toBeLessThanOrEqual(track.y);\n120:         expect(marker.y + marker.h).toBeGreaterThanOrEqual(track.y + track.h);\n121:         // Five ticks: the interior ones centered on the quarters, the end ones flush with the track.\n122:         const ticks = PACE_TICKS.map((_, i) => resolved[`pace-tick-${i}`][0].rect);\n123:         for (const i of [1, 2, 3]) expect(Math.abs(ticks[i].x + ticks[i].w / 2 - (track.x + (i * track.w) / 4))).toBeLessThanOrEqual(2);\n124:         expect(Math.abs(ticks[0].x - track.x)).toBeLessThanOrEqual(1);\n125:         expect(Math.abs(ticks[4].x + ticks[4].w - (track.x + track.w))).toBeLessThanOrEqual(1);\n126:         // The labels: interior ones under their ticks, the end ones flush with the margins.\n127:         const labels = PACE_TICKS.map((_, i) => resolved[`pace-tick-label-${i}`][0].rect);\n128:         for (const i of [1, 2, 3]) expect(Math.abs(labels[i].x + labels[i].w / 2 - (track.x + (i * track.w) / 4))).toBeLessThanOrEqual(2);\n129:         const m = layoutErgCard({ split }, w, h).m;\n130:         expect(Math.abs(labels[0].x - m)).toBeLessThanOrEqual(2);\n131:         expect(Math.abs(labels[4].x + labels[4].w - (w - m))).toBeLessThanOrEqual(2);\n132:         // No tick label sits on the marker's overhang.\n133:         for (const l of labels) expect(l.y).toBeGreaterThanOrEqual(marker.y + marker.h);\n134:       }\n135:       // The default split reads just left of the 2:00 tick, 49% of the way.\n136:       const resolved = checkLayoutIntent(await render({}, w, h), w, h)!.resolved;\n137:       const track = resolved[\"pace-track\"][0].rect;\n138:       const center = resolved[\"pace-marker\"][0].rect.x + resolved[\"pace-marker\"][0].rect.w / 2 - track.x;\n139:       expect(center).toBeGreaterThan(track.w * 0.45);\n140:       expect(center).toBeLessThan(track.w * 0.5);\n141:     }\n142:   });\n143: \n144:   it(\"makes the split the hero: the tallest cell on the card, more than twice the result\", () => {\n145:     for (const [w, h] of CONTRACT_CANVASES) {\n146:       const L = layoutErgCard({}, w, h);\n147:       const split = L.cells.find((c) => c.label === \"split\")!;\n148:       const result = L.cells.find((c) => c.label === \"result\")!;\n149:       const rower = L.cells.find((c) => c.label === \"rower\")!;\n150:       expect(split.px).toBeGreaterThan(2 * result.px);\n151:       expect(split.px).toBeGreaterThan(rower.px);\n152:       expect(split.rect.h).toBeGreaterThan(result.rect.h);\n153:       for (const c of L.cells) if (c !== split) expect(c.rect.h).toBeLessThan(split.rect.h);\n154:       // /500m sits immediately under the split, centered on the same line.\n155:       const unit = L.cells.find((c) => c.label === \"split-unit\")!;\n156:       expect(unit.rect.y).toBe(split.rect.y + split.rect.h + Math.max(2, Math.round(Math.min(h, 0.75 * w) * 0.014)));\n157:       expect(unit.rect.x + unit.rect.w / 2).toBe(split.rect.x + split.rect.w / 2);\n158:     }\n159:   });\n160: \n161:   it(\"hides what is zero and rebalances: the chip's space, the stat band, the result\", async () => {\n162:     // No chip: no chip text, no cohort, and the name takes the header's full width.\n163:     const noChip = layoutErgCard({ percentile: 0 }, 1080, 1080);\n164:     expect(noChip.tiles.some((t) => t.label === \"percentile-chip\")).toBe(false);\n165:     expect(noChip.cells.some((c) => c.label === \"percentile\" || c.label === \"percentile-cohort\")).toBe(false);\n166:     expect(noChip.cells.find((c) => c.label === \"rower\")!.rect.w).toBe(1080 - 2 * noChip.m);\n167:     // A chip without its cohort line still shows the pill.\n168:     const noCohort = layoutErgCard({ percentileCohort: \"\" }, 1080, 1080);\n169:     expect(noCohort.tiles.some((t) => t.label === \"percentile-chip\")).toBe(true);\n170:     expect(noCohort.cells.some((c) => c.label === \"percentile-cohort\")).toBe(false);\n171:     // Two stat cells when one is 0; none when all are; the survivors share the band.\n172:     const two = layoutErgCard({ spm: 0 }, 1080, 1080);\n173:     expect(two.cells.filter((c) => /^stat-(spm|watts|drag)$/.test(c.label)).map((c) => c.label)).toEqual([\"stat-watts\", \"stat-drag\"]);\n174:     expect(two.tiles.filter((t) => t.label.startsWith(\"stat-divider-\"))).toHaveLength(1);\n175:     const none = layoutErgCard({ spm: 0, watts: 0, drag: 0 }, 1080, 1080);\n176:     expect(none.cells.some((c) => c.label.startsWith(\"stat-\"))).toBe(false);\n177:     // No result: no figure, no caption, and the freed band went to the hero and the stats.\n178:     const noResult = layoutErgCard({ result: \"\" }, 1080, 1080);\n179:     expect(noResult.cells.some((c) => c.label === \"result\" || c.label === \"piece\")).toBe(false);\n180:     const full = layoutErgCard({}, 1080, 1080);\n\n(Showing lines 1-180 of 323. Use offset=181 to continue.)\n</content>","metadata":{"preview":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { getOpentype, bundledFontPath, resolveFontFile, resolvePropBindings } from \"@m0saic/template-utils\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { CONTRACT_CANVASES, checkLayoutIntent, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport {\n  ErgPbCardV1 as T,\n  PACE_TICKS,\n  ergMarkerFrac,\n  ergOrdinal,\n  layoutErgCard,\n  normalizeErgCard,\n  parseErgSplit,\n} from \"./erg-pb-card\";\nimport type { ErgPbCardProps } from \"./erg-pb-card\";\n\nconst ID = \"@one-a-day/sports/erg-pb-card/v1\";\nconst render = (p: ErgPbCardProps = {}, w = 1080, h = 1080) => T.render(p, targetCtx(w, h)).then(asDocument);\nconst textOf = (p: ErgPbCardProps, w = 1080, h = 1080) => Object.fromEntries(layoutErgCard(p, w, h).cells.map((c) => [c.label, c.text.replace(/\\n/g, \" \")]));\n","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\erg-pb-card\\v1\\erg-pb-card.test.ts","text":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { getOpentype, bundledFontPath, resolveFontFile, resolvePropBindings } from \"@m0saic/template-utils\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { CONTRACT_CANVASES, checkLayoutIntent, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport {\n  ErgPbCardV1 as T,\n  PACE_TICKS,\n  ergMarkerFrac,\n  ergOrdinal,\n  layoutErgCard,\n  normalizeErgCard,\n  parseErgSplit,\n} from \"./erg-pb-card\";\nimport type { ErgPbCardProps } from \"./erg-pb-card\";\n\nconst ID = \"@one-a-day/sports/erg-pb-card/v1\";\nconst render = (p: ErgPbCardProps = {}, w = 1080, h = 1080) => T.render(p, targetCtx(w, h)).then(asDocument);\nconst textOf = (p: ErgPbCardProps, w = 1080, h = 1080) => Object.fromEntries(layoutErgCard(p, w, h).cells.map((c) => [c.label, c.text.replace(/\\n/g, \" \")]));\n\n// The copy that stresses the card: a 40-character name, a 45-character note, a\n// 39-character cohort beside the chip, a marathon time as the result, and the\n// slowest split the format allows (the marker clamps to the 3:00 end).\nconst LONG: ErgPbCardProps = {\n  rower: \"Maximiliana Wolfeschlegelstein\",\n  note: \"the fastest 2k of the 2026 autumn head season\",\n  split: \"9:59.9\",\n  result: \"3:36:47\",\n  piece: \"marathon\",\n  percentileCohort: \"2026 rower ranking, heavyweight, 40-49\",\n  spm: 60,\n  watts: 600,\n  drag: 250,\n};\nconst CASES: ErgPbCardProps[] = [\n  {},\n  { preset: \"light\" },\n  { split: \"1:00.0\" },\n  { split: \"3:00.0\" },\n  { split: \"2:00.0\" },\n  { percentile: 0 },\n  { percentile: 0, percentileCohort: \"\" },\n  { percentile: 1 },\n  { percentile: 21 },\n  { percentileCohort: \"\" },\n  { result: \"\" },\n  { result: \"\", piece: \"\" },\n  { piece: \"1 hour\", result: \"13,578 m\" },\n  { spm: 0 },\n  { watts: 0 },\n  { drag: 0 },\n  { spm: 0, watts: 0, drag: 0 },\n  { note: \"\" },\n  { spm: 10, watts: 20, drag: 50 },\n  LONG,\n  { ...LONG, preset: \"light\", accent: \"#e4572e\" },\n  { rower: \"Zoë Åström-Niño\" },\n];\n\ndescribe(ID, () => {\n  it(\"shows the use case at its defaults: the 2026 ranking's own median 2k rower\", () => {\n    const t = textOf({});\n    expect(t).toMatchObject({\n      rower: \"Marcus Alder\", note: \"the 2026 season's median 2k\",\n      split: \"1:58.8\", \"split-unit\": \"/500m\",\n      result: \"7:55.0\", piece: \"2,000 m\",\n      percentile: \"50TH PERCENTILE\", \"percentile-cohort\": \"2026 rower ranking\",\n      \"stat-spm\": \"26\", \"stat-label-spm\": \"SPM\",\n      \"stat-watts\": \"209\", \"stat-label-watts\": \"WATTS\",\n      \"stat-drag\": \"110\", \"stat-label-drag\": \"DRAG\",\n      \"pace-tick-label-0\": \"1:00\", \"pace-tick-label-1\": \"1:30\", \"pace-tick-label-2\": \"2:00\",\n      \"pace-tick-label-3\": \"2:30\", \"pace-tick-label-4\": \"3:00\",\n      footnote: \"Split, watts and percentile as entered. The ranking moves with season, age and weight class.\",\n    });\n    // 1:58.8 -> 0.49 of the way from the 1:00 end to the 3:00 end.\n    expect(ergMarkerFrac(parseErgSplit(\"1:58.8\")!)).toBeCloseTo(0.49, 12);\n    expect(T.outputHints).toMatchObject({ width: 1080, height: 1080, format: { kind: \"image\" } });\n  });\n\n  it(\"parses splits in integer tenths and clamps the marker, never the printed split\", () => {\n    expect(parseErgSplit(\"1:58.8\")).toBe(1188);\n    expect(parseErgSplit(\"9:59.9\")).toBe(5999);\n    expect(parseErgSplit(\"1:00.0\")).toBe(600);\n    for (const bad of [\"\", \"0:59.5\", \"10:15.0\", \"1:58\", \"1:58.85\", \"1:60.0\", \"1:5.8\", \"1,58.8\", \"1:58,8\", \" 1:58.8\", \"1:58.8 \", \"abc\"]) expect(parseErgSplit(bad)).toBeNull();\n    expect([600, 601, 1188, 1200, 1800, 1805, 5999].map(ergMarkerFrac)).toEqual([0, 1 / 1200, 0.49, 0.5, 1, 1, 1]);\n    expect([1, 2, 3, 4, 11, 12, 13, 21, 22, 23, 50, 99].map(ergOrdinal)).toEqual([\n      \"1ST\", \"2ND\", \"3RD\", \"4TH\", \"11TH\", \"12TH\", \"13TH\", \"21ST\", \"22ND\", \"23RD\", \"50TH\", \"99TH\",\n    ]);\n    const n = normalizeErgCard({});\n    expect([n.splitText, n.splitTenths, n.markerFrac, n.clamped]).toEqual([\"1:58.8\", 1188, 0.49, false]);\n    // Outside the track: the marker clamps, the figure does not.\n    const slow = normalizeErgCard({ split: \"9:59.9\" });\n    expect([slow.splitText, slow.markerFrac, slow.clamped]).toEqual([\"9:59.9\", 1, true]);\n    const fast = normalizeErgCard({ split: \"1:00.0\" });\n    expect([fast.splitText, fast.markerFrac, fast.clamped]).toEqual([\"1:00.0\", 0, true]);\n    // Every percentile the chip can show, in the chip's own words.\n    expect(textOf({ percentile: 1 }).percentile).toBe(\"1ST PERCENTILE\");\n    expect(textOf({ percentile: 11 }).percentile).toBe(\"11TH PERCENTILE\");\n    expect(textOf({ percentile: 21 }).percentile).toBe(\"21ST PERCENTILE\");\n    // The footnote names what is entered and what the ranking depends on.\n    expect(textOf({ percentile: 0 }).footnote).toBe(\"Split and watts as entered.\");\n  });\n\n  it(\"draws the marker at (split - 60) / 120 of the track, just left of 2:00 by default\", async () => {\n    for (const [w, h] of CONTRACT_CANVASES) {\n      for (const split of [\"1:58.8\", \"1:00.0\", \"2:00.0\", \"2:30.0\", \"3:00.0\", \"9:59.9\"]) {\n        const resolved = checkLayoutIntent(await render({ split }, w, h), w, h)!.resolved;\n        const track = resolved[\"pace-track\"][0].rect;\n        const marker = resolved[\"pace-marker\"][0].rect;\n        const frac = ergMarkerFrac(parseErgSplit(split)!);\n        // The marker's center lands on the split's place on the scale - a clamped\n        // marker straddles the track's end rather than hiding inside it.\n        expect(Math.abs(marker.x + marker.w / 2 - (track.x + frac * track.w))).toBeLessThanOrEqual(2);\n        expect(marker.x + marker.w / 2).toBeGreaterThanOrEqual(track.x - 1);\n        expect(marker.x + marker.w / 2).toBeLessThanOrEqual(track.x + track.w + 1);\n        // A distinct mark: bigger than a tick, riding the track's line.\n        const tick = resolved[\"pace-tick-2\"][0].rect;\n        expect(marker.w).toBeGreaterThan(tick.w);\n        expect(marker.y).toBeLessThanOrEqual(track.y);\n        expect(marker.y + marker.h).toBeGreaterThanOrEqual(track.y + track.h);\n        // Five ticks: the interior ones centered on the quarters, the end ones flush with the track.\n        const ticks = PACE_TICKS.map((_, i) => resolved[`pace-tick-${i}`][0].rect);\n        for (const i of [1, 2, 3]) expect(Math.abs(ticks[i].x + ticks[i].w / 2 - (track.x + (i * track.w) / 4))).toBeLessThanOrEqual(2);\n        expect(Math.abs(ticks[0].x - track.x)).toBeLessThanOrEqual(1);\n        expect(Math.abs(ticks[4].x + ticks[4].w - (track.x + track.w))).toBeLessThanOrEqual(1);\n        // The labels: interior ones under their ticks, the end ones flush with the margins.\n        const labels = PACE_TICKS.map((_, i) => resolved[`pace-tick-label-${i}`][0].rect);\n        for (const i of [1, 2, 3]) expect(Math.abs(labels[i].x + labels[i].w / 2 - (track.x + (i * track.w) / 4))).toBeLessThanOrEqual(2);\n        const m = layoutErgCard({ split }, w, h).m;\n        expect(Math.abs(labels[0].x - m)).toBeLessThanOrEqual(2);\n        expect(Math.abs(labels[4].x + labels[4].w - (w - m))).toBeLessThanOrEqual(2);\n        // No tick label sits on the marker's overhang.\n        for (const l of labels) expect(l.y).toBeGreaterThanOrEqual(marker.y + marker.h);\n      }\n      // The default split reads just left of the 2:00 tick, 49% of the way.\n      const resolved = checkLayoutIntent(await render({}, w, h), w, h)!.resolved;\n      const track = resolved[\"pace-track\"][0].rect;\n      const center = resolved[\"pace-marker\"][0].rect.x + resolved[\"pace-marker\"][0].rect.w / 2 - track.x;\n      expect(center).toBeGreaterThan(track.w * 0.45);\n      expect(center).toBeLessThan(track.w * 0.5);\n    }\n  });\n\n  it(\"makes the split the hero: the tallest cell on the card, more than twice the result\", () => {\n    for (const [w, h] of CONTRACT_CANVASES) {\n      const L = layoutErgCard({}, w, h);\n      const split = L.cells.find((c) => c.label === \"split\")!;\n      const result = L.cells.find((c) => c.label === \"result\")!;\n      const rower = L.cells.find((c) => c.label === \"rower\")!;\n      expect(split.px).toBeGreaterThan(2 * result.px);\n      expect(split.px).toBeGreaterThan(rower.px);\n      expect(split.rect.h).toBeGreaterThan(result.rect.h);\n      for (const c of L.cells) if (c !== split) expect(c.rect.h).toBeLessThan(split.rect.h);\n      // /500m sits immediately under the split, centered on the same line.\n      const unit = L.cells.find((c) => c.label === \"split-unit\")!;\n      expect(unit.rect.y).toBe(split.rect.y + split.rect.h + Math.max(2, Math.round(Math.min(h, 0.75 * w) * 0.014)));\n      expect(unit.rect.x + unit.rect.w / 2).toBe(split.rect.x + split.rect.w / 2);\n    }\n  });\n\n  it(\"hides what is zero and rebalances: the chip's space, the stat band, the result\", async () => {\n    // No chip: no chip text, no cohort, and the name takes the header's full width.\n    const noChip = layoutErgCard({ percentile: 0 }, 1080, 1080);\n    expect(noChip.tiles.some((t) => t.label === \"percentile-chip\")).toBe(false);\n    expect(noChip.cells.some((c) => c.label === \"percentile\" || c.label === \"percentile-cohort\")).toBe(false);\n    expect(noChip.cells.find((c) => c.label === \"rower\")!.rect.w).toBe(1080 - 2 * noChip.m);\n    // A chip without its cohort line still shows the pill.\n    const noCohort = layoutErgCard({ percentileCohort: \"\" }, 1080, 1080);\n    expect(noCohort.tiles.some((t) => t.label === \"percentile-chip\")).toBe(true);\n    expect(noCohort.cells.some((c) => c.label === \"percentile-cohort\")).toBe(false);\n    // Two stat cells when one is 0; none when all are; the survivors share the band.\n    const two = layoutErgCard({ spm: 0 }, 1080, 1080);\n    expect(two.cells.filter((c) => /^stat-(spm|watts|drag)$/.test(c.label)).map((c) => c.label)).toEqual([\"stat-watts\", \"stat-drag\"]);\n    expect(two.tiles.filter((t) => t.label.startsWith(\"stat-divider-\"))).toHaveLength(1);\n    const none = layoutErgCard({ spm: 0, watts: 0, drag: 0 }, 1080, 1080);\n    expect(none.cells.some((c) => c.label.startsWith(\"stat-\"))).toBe(false);\n    // No result: no figure, no caption, and the freed band went to the hero and the stats.\n    const noResult = layoutErgCard({ result: \"\" }, 1080, 1080);\n    expect(noResult.cells.some((c) => c.label === \"result\" || c.label === \"piece\")).toBe(false);\n    const full = layoutErgCard({}, 1080, 1080);","lineStart":1,"lineEnd":180,"totalLines":323,"truncated":true}},"title":"src\\sports\\erg-pb-card\\v1\\erg-pb-card.test.ts","time":{"start":1792416148678,"end":1792416148770}},"metadata":{"openai":{"itemId":"fc_cd66af76-ae33-919a-ae64-4ebf8b5a1adc