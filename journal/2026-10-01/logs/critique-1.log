{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G9rENgWsqBSAeCiHGXjNu9","type":"tool_result","content":"1\timport { evaluateM0 } from \"@m0saic/dsl-stdlib\";\n2\timport { getOpentype, bundledFontPath, resolveFontFile, resolvePropBindings } from \"@m0saic/template-utils\";\n3\t\n4\timport { asDocument, targetCtx } from \"../../../__testutils__/render\";\n5\timport { CONTRACT_CANVASES, checkLayoutIntent, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\n6\timport {\n7\t  SwimTimeDropCardV1 as T,\n8\t  formatSwimDrop,\n9\t  formatSwimShare,\n10\t  formatSwimTime,\n11\t  layoutSwimCard,\n12\t  normalizeSwimCard,\n13\t  parseSwimTime,\n14\t} from \"./swim-time-drop-card\";\n15\timport type { SwimRow, SwimTimeDropCardProps } from \"./swim-time-drop-card\";\n16\t\n17\tconst ID = \"@one-a-day/sports/swim-time-drop-card/v1\";\n18\tconst render = (p: SwimTimeDropCardProps = {}, w = 1080, h = 1080) => T.render(p, targetCtx(w, h)).then(asDocument);\n19\tconst textOf = (p: SwimTimeDropCardProps, w = 1080, h = 1080) => Object.fromEntries(layoutSwimCard(p, w, h).cells.map((c) => [c.label, c.text.replace(/\\n/g, \" \")]));\n20\tconst SWIMS = T.defaultProps!.swims as SwimRow[];\n21\t\n22\t// The copy that stresses the card: eight rows, a 30-character name, the longest\n23\t// event name a club writes, a distance swim with a drop over a minute, a chip\n24\t// of four wide letters on every row.\n25\tconst LONG: SwimTimeDropCardProps = {\n26\t  swimmer: \"Maximiliana Wolfeschlegelstein\",\n27\t  club: \"Greater Larkmoor Aquatic Association\",\n28\t  meet: \"Autumn Long Course Championship Invitational\",\n29\t  details: \"Oct 3-4, 2026 - Girls 11-12 - Session 3\",\n30\t  swims: [\n31\t    { event: \"100 Breaststroke\", entry: \"1:32.40\", final: \"1:29.95\", standard: \"AAAA\" },\n32\t    { event: \"1650 Freestyle\", entry: \"19:58.44\", final: \"18:56.11\", standard: \"AAAA\" },\n33\t    { event: \"200 Breaststroke\", entry: \"3:18.02\", final: \"3:20.77\", standard: \"AAAA\" },\n34\t    { event: \"100 Butterfly\", entry: \"1:25.10\", final: \"1:25.10\", standard: \"AAAA\" },\n35\t    { event: \"400 Individual Medley\", entry: \"NT\", final: \"6:02.18\", standard: \"AAAA\" },\n36\t    { event: \"200 Backstroke\", entry: \"2:51.36\", final: \"DQ\" },\n37\t    { event: \"500 Freestyle\", entry: \"6:41.90\", final: \"6:33.05\", standard: \"AAAA\" },\n38\t    { event: \"50 Freestyle\", entry: \"33.20\", final: \"33.19\", standard: \"AAAA\" },\n39\t  ],\n40\t};\n41\tconst CASES: SwimTimeDropCardProps[] = [\n42\t  {},\n43\t  { bar: \"seconds\" },\n44\t  LONG,\n45\t  { ...LONG, bar: \"seconds\", preset: \"light\", course: \"LCM\" },\n46\t  { club: \"\", meet: \"\", details: \"\" },\n47\t  { club: \"\", details: \"\" },\n48\t  { meet: \"\", course: \"SCM\" },\n49\t  { swims: SWIMS.slice(0, 1) },\n50\t  { swims: SWIMS.slice(0, 2), details: \"\" },\n51\t  { swims: [{ event: \"50 Free\", entry: \"NT\", final: \"30.97\" }, { event: \"100 Free\", entry: \"1:10.52\", final: \"DQ\" }] },\n52\t  { swims: [{ event: \"100 Back\", entry: \"1:19.77\", final: \"1:20.19\" }] },\n53\t  { swimmer: \"Zoë Åström-Niño\", club: \"Łódź Swim Club\", accent: \"#f2c14e\" },\n54\t];\n55\t\n56\tdescribe(ID, () => {\n57\t  it(\"shows the use case at its defaults: one invented swimmer, six swims, five drops, an honest slower swim\", () => {\n58\t    const t = textOf({});\n59\t    expect(t).toMatchObject({\n60\t      swimmer: \"Tessa Marlow\", club: \"Larkmoor Swim Club\", meet: \"October Kickoff Invitational\", details: \"Oct 3-4, 2026\", course: \"SCY\",\n61\t      \"head-event\": \"EVENT\", \"head-entry\": \"ENTRY\", \"head-final\": \"FINAL\", \"head-drop\": \"DROP\",\n62\t      \"event-0\": \"50 Free\", \"entry-0\": \"31.84\", \"final-0\": \"30.97\", \"drop-0\": \"-0.87\", \"standard-0\": \"BB\",\n63\t      \"event-2\": \"200 Free\", \"entry-2\": \"2:36.40\", \"final-2\": \"2:29.85\", \"drop-2\": \"-6.55\", \"standard-2\": \"B\",\n64\t      \"drop-3\": \"+0.42\",\n65\t      \"summary-count\": \"5 of 6 swims faster\", \"summary-total\": \"14.82 s dropped\",\n66\t      footnote: \"vs entry time. Bars and their percentages: share of the entry time dropped.\",\n67\t      // Each percent bar prints its own number; the slower swim has neither a bar nor a number.\n68\t      \"share-0\": \"2.7%\", \"share-1\": \"3.1%\", \"share-2\": \"4.2%\", \"share-4\": \"3.3%\", \"share-5\": \"2.3%\",\n69\t    });\n70\t    expect(t[\"share-3\"]).toBeUndefined();\n71\t    expect([\"drop-0\", \"drop-1\", \"drop-2\", \"drop-3\", \"drop-4\", \"drop-5\"].map((k) => t[k])).toEqual([\"-0.87\", \"-2.21\", \"-6.55\", \"+0.42\", \"-1.18\", \"-4.01\"]);\n72\t    // Four chips, and the rows without a standard have none.\n73\t    expect(Object.keys(t).filter((k) => k.startsWith(\"standard-\"))).toEqual([\"standard-0\", \"standard-1\", \"standard-2\", \"standard-4\"]);\n74\t    expect(T.outputHints).toMatchObject({ width: 1080, height: 1080, format: { kind: \"image\" } });\n75\t  });\n76\t\n77\t  it(\"does its arithmetic in integer hundredths and prints times the way a results sheet does\", () => {\n78\t    expect(parseSwimTime(\"31.84\")).toBe(3184);\n79\t    expect(parseSwimTime(\"1:10.52\")).toBe(7052);\n80\t    expect(parseSwimTime(\"19:58.44\")).toBe(119844);\n81\t    expect(parseSwimTime(\"0:31.84\")).toBe(3184);\n82\t    expect(parseSwimTime(\"65.20\")).toBe(6520);\n83\t    for (const bad of [\"\", \"31.8\", \"31\", \"1:75.00\", \"1:5.20\", \"31,84\", \"1:10:52\", \"-31.84\", \"31.840\", \"0.00\", \"abc\", \" 31.84\"]) expect(parseSwimTime(bad)).toBeNull();\n84\t    expect([3184, 7052, 119844, 6520, 5, 6000].map(formatSwimTime)).toEqual([\"31.84\", \"1:10.52\", \"19:58.44\", \"1:05.20\", \"0.05\", \"1:00.00\"]);\n85\t    expect([87, -42, 0, 6233, -6001].map(formatSwimDrop)).toEqual([\"-0.87\", \"+0.42\", \"0.00\", \"-1:02.33\", \"+1:00.01\"]);\n86\t    expect(formatSwimShare(655, 15640)).toBe(\"4.2%\");\n87\t    expect(formatSwimShare(87, 3184)).toBe(\"2.7%\");\n88\t    // A real drop too small to round to a tenth of a percent says so instead of reading as no drop.\n89\t    expect(formatSwimShare(1, 119844)).toBe(\"<0.1%\");\n90\t    expect(formatSwimShare(60, 119844)).toBe(\"0.1%\");\n91\t    // 0.1 + 0.2 territory: the float sum of these drops is 14.819999..., the integer sum is 1482.\n92\t    const n = normalizeSwimCard({});\n93\t    expect([n.faster, n.compared, n.totalCs]).toEqual([5, 6, 1482]);\n94\t    expect(n.lines.map((l) => l.dropCs)).toEqual([87, 221, 655, -42, 118, 401]);\n95\t  });\n96\t\n97\t  it(\"prints a slower swim without drawing it, and makes no claim for an NT or a DQ\", () => {\n98\t    const p: SwimTimeDropCardProps = { swims: [\n99\t      { event: \"100 Back\", entry: \"1:19.77\", final: \"1:20.19\", standard: \"B\" },\n100\t      { event: \"50 Fly\", entry: \"36.10\", final: \"36.10\" },\n101\t      { event: \"200 IM\", entry: \"NT\", final: \"2:54.02\", standard: \"BB\" },\n102\t      { event: \"100 Free\", entry: \"\", final: \"1:08.31\" },\n103\t      { event: \"50 Free\", entry: \"31.84\", final: \"dq\" },\n104\t      { event: \"200 Free\", entry: \"2:36.40\", final: \"2:29.85\" },\n105\t    ] };\n106\t    for (const [w, h] of CONTRACT_CANVASES) {\n107\t      const L = layoutSwimCard(p, w, h);\n108\t      expect(L.rows.map((r) => r.bar !== null)).toEqual([false, false, false, false, false, true]);\n109\t      expect(L.tiles.filter((t) => t.label.startsWith(\"bar-\")).map((t) => t.label)).toEqual([\"bar-5\"]);\n110\t      // Every row keeps its track, and no ink on the card is a warning colour:\n111\t      // text is the ink, the dim ink, or the on-chip ink.\n112\t      expect(L.tiles.filter((t) => t.label.startsWith(\"track-\"))).toHaveLength(6);\n113\t      const inks = new Set(L.cells.filter((c) => !/^(standard|share)-/.test(c.label) && c.label !== \"course\").map((c) => c.color));\n114\t      expect([...inks].sort()).toEqual([L.theme.dim, L.theme.ink].sort());\n115\t      expect(L.cells.find((c) => c.label === \"drop-0\")!.color).toBe(L.cells.find((c) => c.label === \"drop-5\")!.color);\n116\t    }\n117\t    const t = textOf(p);\n118\t    expect([t[\"drop-0\"], t[\"drop-1\"], t[\"drop-2\"], t[\"drop-3\"], t[\"drop-4\"], t[\"drop-5\"]]).toEqual([\"+0.42\", \"0.00\", \"first swim\", \"first swim\", undefined, \"-6.55\"]);\n119\t    expect([t[\"entry-2\"], t[\"entry-3\"], t[\"final-4\"]]).toEqual([\"NT\", \"NT\", \"DQ\"]);\n120\t    // Counted: the three swims with both times. Not netted: the slower swim does not reduce the total.\n121\t    expect(t[\"summary-count\"]).toBe(\"1 of 3 swims faster\");\n122\t    expect(t[\"summary-total\"]).toBe(\"6.55 s dropped\");\n123\t\n124\t    const none = textOf({ swims: [{ event: \"100 Back\", entry: \"1:19.77\", final: \"1:20.19\" }] });\n125\t    expect(none[\"summary-count\"]).toBe(\"0 of 1 swim faster\");\n126\t    expect(none[\"summary-total\"]).toBeUndefined();\n127\t    expect(none.footnote).toBe(\"vs entry time. No swim was faster, so no bar is drawn.\");\n128\t    const first = textOf({ swims: [{ event: \"50 Free\", entry: \"NT\", final: \"30.97\" }, { event: \"100 Free\", entry: \"1:10.52\", final: \"DQ\" }] });\n129\t    expect(first[\"summary-count\"]).toBe(\"No times to compare\");\n130\t    expect(first[\"summary-total\"]).toBeUndefined();\n131\t    expect(first.footnote).not.toMatch(/Bars/);\n132\t    // A total over a minute is printed as a time.\n133\t    expect(textOf(LONG)[\"summary-total\"]).toBe(\"1:13.64 dropped\");\n134\t  });\n135\t\n136\t  it(\"says vs entry time on every card and never calls a swim a best\", async () => {\n137\t    for (const p of CASES) {\n138\t      const drawn = JSON.stringify((await render(p)).sources);\n139\t      expect(drawn).toContain(\"vs entry time\");\n140\t      expect(drawn).not.toMatch(/\\bPB\\b|best time|personal best/i);\n141\t    }\n142\t  });\n143\t\n144\t  it(\"draws bars proportional to what the footnote names, the longest filling its track\", async () => {\n145\t    const shares = (bar: \"percent\" | \"seconds\") => normalizeSwimCard({ bar }).lines.map((l) => l.share);\n146\t    // percent: drop / entry against the largest share (200 Free, 655 / 15640).\n147\t    const pct = [87 / 3184, 221 / 7052, 655 / 15640, 0, 118 / 3610, 401 / 17803].map((s) => s / (655 / 15640));\n148\t    const sec = [87, 221, 655, 0, 118, 401].map((d) => d / 655);\n149\t    shares(\"percent\").forEach((s, i) => expect(s).toBeCloseTo(pct[i], 12));\n150\t    shares(\"seconds\").forEach((s, i) => expect(s).toBeCloseTo(sec[i], 12));\n151\t    // The two variants disagree visibly: the 50 Free outranks the 200 IM in percent, not in seconds.\n152\t    expect(shares(\"percent\")[0]).toBeGreaterThan(shares(\"percent\")[5]);\n153\t    expect(shares(\"seconds\")[5]).toBeGreaterThan(shares(\"seconds\")[0] * 4);\n154\t    expect(textOf({ bar: \"seconds\" }).footnote).toBe(\"vs entry time. Bars: seconds dropped; the longest is 6.55 s.\");\n155\t    expect(textOf({ ...LONG, bar: \"seconds\" }).footnote).toBe(\"vs entry time. Bars: seconds dropped; the longest is 1:02.33.\");\n156\t\n157\t    for (const bar of [\"percent\", \"seconds\"] as const) for (const [w, h] of CONTRACT_CANVASES) {\n158\t      const want = shares(bar);\n159\t      const resolved = checkLayoutIntent(await render({ bar }, w, h), w, h)!.resolved;\n160\t      const tracks = want.map((_, i) => resolved[`track-${i}`][0].rect);\n161\t      // One size, one left edge - from the rects the engine realizes.\n162\t      for (const t of tracks) {\n163\t        expect(Math.abs(t.x - tracks[0].x)).toBeLessThanOrEqual(1);\n164\t        expect(Math.abs(t.w - tracks[0].w)).toBeLessThanOrEqual(2);\n165\t        expect(Math.abs(t.h - tracks[0].h)).toBeLessThanOrEqual(2);\n166\t        expect(t.w).toBeGreaterThanOrEqual(w * 0.2);\n167\t      }\n168\t      want.forEach((share, i) => {\n169\t        if (share === 0) { expect(resolved[`bar-${i}`]).toBeUndefined(); return; }\n170\t        const b = resolved[`bar-${i}`][0].rect;\n171\t        expect(Math.abs(b.x - tracks[i].x)).toBeLessThanOrEqual(1);\n172\t        // Proportional within the pixel or two quantization takes (and the 1% floor of a tiny bar).\n173\t        expect(Math.abs(b.w - share * tracks[i].w)).toBeLessThanOrEqual(Math.max(3, tracks[i].w * 0.011));\n174\t        if (share === 1) expect(Math.abs(b.w - tracks[i].w)).toBeLessThanOrEqual(2);\n175\t      });\n176\t    }\n177\t  });\n178\t\n179\t  it(\"keeps its contract from 1 to 8 rows at the seven contract canvases, with nothing colliding\", async () => {\n180\t    const rowCounts = Array.from({ length: 8 }, (_, i) => ({ ...LONG, swims: LONG.swims!.slice(0, i + 1) }));\n181\t    for (const p of [...CASES, ...rowCounts]) {\n182\t      await sweepLayout((q, ctx) => T.render(q, ctx).then(asDocument), ID, p, targetCtx);\n183\t      for (const [w, h] of CONTRACT_CANVASES) {\n184\t        const L = layoutSwimCard(p, w, h);\n185\t        // The document itself, for the stress copy (the row-count walk is swept above and laid out here, not rendered twice).\n186\t        if (CASES.includes(p)) {\n187\t          const doc = await render(p, w, h);\n188\t          const ev = evaluateM0(String(doc.m0), { width: w, height: h });\n189\t          expect(ev.feasible && ev.meetsPrecision).toBe(true);\n190\t          // Every source is labelled and promised something; every text promises that it fits.\n191\t          const intent = layoutIntentOf(doc)!;\n192\t          for (const s of doc.sources ?? []) {\n193\t            expect(s.editor?.label).toBeTruthy();\n194\t            expect(intent.constraints.some((c) => c.label === s.editor?.label)).toBe(true);\n195\t            if (s.type === \"text\") expect(intent.constraints.some((c) => c.label === s.editor?.label && c.textFits)).toBe(true);\n196\t          }\n197\t        }\n198\t\n199\t        // Inside the margins, never below the floor, never cut.\n200\t        for (const c of L.cells) {\n201\t          expect(c.px).toBeGreaterThanOrEqual(L.small);\n202\t          expect(c.text).not.toContain(\"...\");\n203\t          expect(c.rect.x).toBeGreaterThanOrEqual(L.m);\n204\t          expect(c.rect.y).toBeGreaterThanOrEqual(L.m);\n205\t          expect(c.rect.x + c.rect.w).toBeLessThanOrEqual(w - L.m);\n206\t          expect(c.rect.y + c.rect.h).toBeLessThanOrEqual(h - L.m);\n207\t        }\n208\t        // No two texts overlap, and no text sits on a tile it does not belong to.\n209\t        const texts = L.cells.map((c) => ({ label: c.label, rect: c.rect }));\n210\t        const hit = (a: { x: number; y: number; w: number; h: number }, b: { x: number; y: number; w: number; h: number }) => a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;\n211\t        for (let i = 0; i < texts.length; i++) for (let j = i + 1; j < texts.length; j++) {\n212\t          if (hit(texts[i].rect, texts[j].rect)) throw new Error(`${texts[i].label} overlaps ${texts[j].label} at ${w}x${h}`);\n213\t        }\n214\t        for (const t of L.tiles) for (const c of L.cells) {\n215\t          const own = (t.label === \"course-chip\" && c.label === \"course\") || (t.label.startsWith(\"chip-\") && c.label === `standard-${t.label.slice(5)}`)\n216\t            || (/^(track|bar)-/.test(t.label) && c.label === `share-${t.label.split(\"-\")[1]}`);\n217\t          if (!own && hit(t.rect, c.rect)) throw new Error(`${c.label} overlaps ${t.label} at ${w}x${h}`);\n218\t        }\n219\t        // The rows keep to their band, in order, and one or two swims do not become slabs.\n220\t        expect(L.rowH).toBeLessThanOrEqual(L.cap);\n221\t        expect(L.rows[0].top).toBeGreaterThan(L.bandTop);\n222\t        L.rows.forEach((r, i) => expect(r.top).toBe(L.rows[0].top + i * L.rowH));\n223\t        expect(L.rows[L.rows.length - 1].top + L.rowH).toBeLessThanOrEqual(L.bandBottom);\n224\t        // The name is the largest text; the summary is second.\n225\t        const px = Object.fromEntries(L.cells.map((c) => [c.label, c.px]));\n226\t        if (p === CASES[0]) {\n227\t          expect(px.swimmer).toBeGreaterThan(px[\"summary-count\"]);\n228\t          expect(px[\"summary-count\"]).toBeGreaterThan(px[\"event-0\"]);\n229\t        }\n230\t      }\n231\t    }\n232\t  });\n233\t\n234\t  it(\"prints a percent bar's own number at its end, and none in seconds\", () => {\n235\t    for (const [w, h] of CONTRACT_CANVASES) for (const p of [{}, LONG]) {\n236\t      const L = layoutSwimCard(p, w, h);\n237\t      for (const [i, r] of L.rows.entries()) {\n238\t        const label = L.cells.find((c) => c.label === `share-${i}`);\n239\t        // A label exactly where there is a bar: a slower, equal, NT or DQ row has neither.\n240\t        expect(label !== undefined).toBe(r.bar !== null);\n241\t        if (!label || !r.bar) continue;\n242\t        expect(label.text).toBe(formatSwimShare(r.line.dropCs!, r.line.entryCs!));\n243\t        // On the track, on the bar's own line: just past the bar's end, or inside a bar too long to leave room.\n244\t        expect(label.rect.y).toBe(r.track.y);\n245\t        expect(label.rect.h).toBe(r.track.h);\n246\t        expect(label.rect.x).toBeGreaterThanOrEqual(r.track.x);\n247\t        expect(label.rect.x + label.rect.w).toBeLessThanOrEqual(r.track.x + r.track.w);\n248\t        const end = r.bar.x + r.bar.w;\n249\t        const after = label.rect.x >= end;\n250\t        if (!after) expect(label.rect.x + label.rect.w).toBeLessThanOrEqual(end);\n251\t        expect(label.color).toBe(after ? L.theme.ink : L.cells.find((c) => c.label === \"course\")!.color);\n252\t        expect(label.px).toBeGreaterThanOrEqual(L.small);\n253\t      }\n254\t      // In seconds the row already prints the bar's number as the drop: no labels, on the same\n255\t      // track column. (The footnote's length can move the band a line, so heights are not compared.)\n256\t      const S = layoutSwimCard({ ...p, bar: \"seconds\" }, w, h);\n257\t      expect(S.cells.some((c) => c.label.startsWith(\"share-\"))).toBe(false);\n258\t      expect(S.rows.map((r) => [r.track.x, r.track.w])).toEqual(L.rows.map((r) => [r.track.x, r.track.w]));\n259\t    }\n260\t    expect(textOf(LONG)[\"share-1\"]).toBe(\"5.2%\");\n261\t    expect(textOf(LONG)[\"share-7\"]).toBe(\"<0.1%\");\n262\t  });\n263\t\n264\t  it(\"puts the bar in a column on a wide canvas and under the row's text line otherwise\", () => {\n265\t    const wide = layoutSwimCard({}, 1920, 1080), square = layoutSwimCard({}, 1080, 1080), tall = layoutSwimCard({}, 1080, 1920);\n266\t    expect([wide.wide, square.wide, tall.wide]).toEqual([true, false, false]);\n267\t    const cell = (L: typeof wide, label: string) => L.cells.find((c) => c.label === label)!.rect;\n268\t    // Wide: the track sits between FINAL and DROP on the text line.\n269\t    expect(wide.rows[0].track.x).toBeGreaterThan(cell(wide, \"final-0\").x + cell(wide, \"final-0\").w);\n270\t    expect(wide.rows[0].track.x + wide.rows[0].track.w).toBeLessThan(cell(wide, \"drop-0\").x);\n271\t    // Square and portrait: the full content width, under the text line.\n272\t    for (const L of [square, tall]) {\n273\t      expect(L.rows[0].track.w).toBe(L.cells.find((c) => c.label === \"footnote\")!.rect.w);\n274\t      expect(L.rows[0].track.y).toBeGreaterThanOrEqual(cell(L, \"event-0\").y + cell(L, \"event-0\").h);\n275\t    }\n276\t    // A row without a standard keeps the space: the columns do not shift between rows.\n277\t    for (const L of [wide, square, tall]) {\n278\t      expect(new Set(L.rows.map((_, i) => cell(L, `drop-${i}`).x)).size).toBe(1);\n279\t      expect(new Set(L.rows.filter((r) => r.chip).map((r) => r.chip!.x)).size).toBe(1);\n280\t    }\n281\t  });\n282\t\n283\t  it(\"binds each text rect to the prop it shows; derived text and the enums stay unbound\", async () => {\n284\t    const doc = await render();\n285\t    const { byProp, rejected } = resolvePropBindings(doc, 1080, 1080, { propsSchema: T.propsSchema });\n286\t    expect(rejected).toEqual([]);\n287\t    // 6 events + 6 entries + 6 finals + 4 standards on `swims`; the accent on the course chip.\n288\t    expect(Object.fromEntries(Object.entries(byProp).map(([key, v]) => [key, v.length]))).toEqual({ swimmer: 1, club: 1, meet: 1, details: 1, accent: 1, swims: 22 });\n289\t    const bound = (await render({ club: \"\", meet: \"\", details: \"\" })).sources!.filter((s) => s.editor?.binding).length;\n290\t    expect(bound).toBe(24);\n291\t  });\n292\t\n293\t  it(\"follows the accent and the preset, with the page as the document background\", async () => {\n294\t    const dark = await render(), light = await render({ preset: \"light\", accent: \"#E4572E\" });\n295\t    expect([dark.backgroundColor, light.backgroundColor]).toEqual([\"#0e1b25\", \"#f5f9fa\"]);\n296\t    const L = layoutSwimCard({ preset: \"light\", accent: \"#E4572E\" }, 1080, 1080);\n297\t    expect(new Set(L.tiles.filter((t) => /^(bar|chip)-|course-chip/.test(t.label)).map((t) => t.color))).toEqual(new Set([\"#e4572e\"]));\n298\t  });\n299\t\n300\t  it(\"draws accented Latin names: every character it accepts has a glyph in both weights\", () => {\n301\t    const opentype = getOpentype() as { loadSync(path: string): { charToGlyph(ch: string): { index: number } } };\n302\t    for (const path of [bundledFontPath(), resolveFontFile({ weight: \"bold\" })!.path]) {\n303\t      const font = opentype.loadSync(path);\n304\t      for (let code = 0xc0; code <= 0x17f; code++) {\n305\t        if (code === 0xd7 || code === 0xf7) continue;\n306\t        expect(font.charToGlyph(String.fromCodePoint(code)).index).not.toBe(0);\n307\t      }\n308\t    }\n309\t    expect(textOf({ swimmer: \"Zoë Åström\" }).swimmer).toBe(\"Zoë Åström\");\n310\t    // What it cannot promise to draw is refused by name, never drawn as tofu.\n311\t    expect(() => normalizeSwimCard({ swimmer: \"游泳\" })).toThrow(/swimmer .*not known to draw/);\n312\t    expect(() => normalizeSwimCard({ club: \"Wave → Aquatics\" })).toThrow(/club .*not known to draw/);\n313\t  });\n314\t\n315\t  it(\"is deterministic, follows ctx.target when nested, and passes its own contract with the overlay on\", async () => {\n316\t    expect(await render()).toEqual(await render());\n317\t    const ctx = targetCtx(480, 270);\n318\t    ctx.output.width = 3840;\n319\t    ctx.output.height = 2160;\n320\t    expect(await T.render({}, ctx).then(asDocument)).toEqual(await render({}, 480, 270));\n321\t    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n322\t    expect((await render({ ...LONG, debugLayout: true }, 1920, 1080)).editor).toMatchObject({ layoutContract: { ok: true } });\n323\t  });\n324\t\n325\t  it.each<[string, SwimTimeDropCardProps, RegExp]>([\n326\t    [\"a time that does not parse\", { swims: [{ event: \"50 Free\", entry: \"31.8\", final: \"30.97\" }] }, /swims\\[0\\]\\.entry \"31\\.8\" is not a time/],\n327\t    [\"a final that does not parse\", { swims: [SWIMS[0], { event: \"100 Free\", entry: \"1:10.52\", final: \"1:75.00\" }] }, /swims\\[1\\]\\.final \"1:75\\.00\" is not a time/],\n328\t    [\"a missing final\", { swims: [{ event: \"50 Free\", entry: \"31.84\" } as SwimRow] }, /swims\\[0\\]\\.final is missing/],\n329\t    [\"a blank final\", { swims: [{ event: \"50 Free\", entry: \"31.84\", final: \" \" }] }, /swims\\[0\\]\\.final must not be blank/],\n330\t    [\"a blank event\", { swims: [{ event: \"\", entry: \"31.84\", final: \"30.97\" }] }, /swims\\[0\\]\\.event must not be blank/],\n331\t    [\"zero rows\", { swims: [] }, /swims must hold at least one/],\n332\t    [\"nine rows\", { swims: Array.from({ length: 9 }, () => SWIMS[0]) }, /swims has 9 rows; one card holds at most 8 - split the meet across two cards/],\n333\t    [\"a long standard\", { swims: [{ ...SWIMS[0], standard: \"AAAAA\" }] }, /swims\\[0\\]\\.standard \"AAAAA\" is longer than 4 characters/],\n334\t    [\"a standard on a DQ\", { swims: [{ event: \"50 Free\", entry: \"31.84\", final: \"DQ\", standard: \"B\" }] }, /swims\\[0\\]\\.standard \"B\" is set on a DQ/],\n335\t    [\"a row that is not an object\", { swims: [\"50 Free\" as unknown as SwimRow] }, /swims\\[0\\] must be an object/],\n336\t    [\"swims that is not a list\", { swims: \"50 Free\" as unknown as SwimRow[] }, /swims must hold at least one/],\n337\t    [\"a blank swimmer\", { swimmer: \"  \" }, /swimmer must not be blank/],\n338\t    [\"a 41-character swimmer\", { swimmer: \"W\".repeat(41) }, /swimmer .* is 41 characters; the card fits at most 40/],\n339\t    [\"a two-line club\", { club: \"Larkmoor\\nSwim Club\" }, /club .*not known to draw/],\n340\t    [\"a swimmer that is not a string\", { swimmer: 42 as unknown as string }, /swimmer must be a string/],\n341\t    [\"an unknown course\", { course: \"SCX\" as never }, /course \"SCX\" must be \"SCY\", \"SCM\" or \"LCM\"/],\n342\t    [\"an unknown bar\", { bar: \"ratio\" as never }, /bar \"ratio\" must be \"percent\" or \"seconds\"/],\n343\t    [\"an unknown preset\", { preset: \"sepia\" as never }, /preset \"sepia\" must be \"dark\" or \"light\"/],\n344\t    [\"a bad accent\", { accent: \"teal\" }, /accent \"teal\" must be #rrggbb/],\n345\t    [\"a debugLayout that is not a boolean\", { debugLayout: \"yes\" as never }, /debugLayout must be a boolean/],\n346\t  ])(\"rejects %s by name, without falling back to the sample\", (_name, props, message) => {\n347\t    expect(() => normalizeSwimCard(props)).toThrow(message);\n348\t    expect(() => normalizeSwimCard(props)).toThrow(new RegExp(`^${ID.replace(/[/]/g, \"\\\\/\")}: `));\n349\t  });\n350\t\n351\t  it(\"refuses copy it cannot fit instead of clipping it\", () => {\n352\t    expect(() => layoutSwimCard({ swimmer: \"W\".repeat(40) }, 160, 90)).toThrow(/cannot be fitted on 160x90/);\n353\t  });\n354\t});\n355\t"}]},"parent_tool_use_id":null,"session_id":"3b5f6571-be25-4e81-bc62-381b682f29bf","uuid":"67638429-15bc-4cde-a488-1cab0a9c8e79","timestamp":"2026-10-01T14:09:27.700Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-01\\variants\\c\\src\\swim-time-drop-card.test.ts","content":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { getOpentype, bundledFontPath, resolveFontFile, resolvePropBindings } from \"@m0saic/template-utils\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { CONTRACT_CANVASES, checkLayoutIntent, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport {\n  SwimTimeDropCardV1 as T,\n  formatSwimDrop,\n  formatSwimShare,\n  formatSwimTime,\n  layoutSwimCard,\n  normalizeSwimCard,\n  parseSwimTime,\n} from \"./swim-time-drop-card\";\nimport type { SwimRow, SwimTimeDropCardProps } from \"./swim-time-drop-card\";\n\nconst ID = \"@one-a-day/sports/swim-time-drop-card/v1\";\nconst render = (p: SwimTimeDropCardProps = {}, w = 1080, h = 1080) => T.render(p, targetCtx(w, h)).then(asDocument);\nconst textOf = (p: SwimTimeDropCardProps, w = 1080, h = 1080) => Object.fromEntries(layoutSwimCard(p, w, h).cells.map((c) => [c.label, c.text.replace(/\\n/g, \" \")]));\nconst SWIMS = T.defaultProps!.swims as SwimRow[];\n\n// The copy that stresses the card: eight rows, a 30-character name, the longest\n// event name a club writes, a distance swim with a drop over a minute, a chip\n// of four wide letters on every row.\nconst LONG: SwimTimeDropCardProps = {\n  swimmer: \"Maximiliana Wolfeschlegelstein\",\n  club: \"Greater Larkmoor Aquatic Association\",\n  meet: \"Autumn Long Course Championship Invitational\",\n  details: \"Oct 3-4, 2026 - Girls 11-12 - Session 3\",\n  swims: [\n    { event: \"100 Breaststroke\", entry: \"1:32.40\", final: \"1:29.95\", standard: \"AAAA\" },\n    { event: \"1650 Freestyle\", entry: \"19:58.44\", final: \"18:56.11\", standard: \"AAAA\" },\n    { event: \"200 Breaststroke\", entry: \"3:18.02\", final: \"3:20.77\", standard: \"AAAA\" },\n    { event: \"100 Butterfly\", entry: \"1:25.10\", final: \"1:25.10\", standard: \"AAAA\" },\n    { event: \"400 Individual Medley\", entry: \"NT\", final: \"6:02.18\", standard: \"AAAA\" },\n    { event: \"200 Backstroke\", entry: \"2:51.36\", final: \"DQ\" },\n    { event: \"500 Freestyle\", entry: \"6:41.90\", final: \"6:33.05\", standard: \"AAAA\" },\n    { event: \"50 Freestyle\", entry: \"33.20\", final: \"33.19\", standard: \"AAAA\" },\n  ],\n};\nconst CASES: SwimTimeDropCardProps[] = [\n  {},\n  { bar: \"seconds\" },\n  LONG,\n  { ...LONG, bar: \"seconds\", preset: \"light\", course: \"LCM\" },\n  { club: \"\", meet: \"\", details: \"\" },\n  { club: \"\", details: \"\" },\n  { meet: \"\", course: \"SCM\" },\n  { swims: SWIMS.slice(0, 1) },\n  { swims: SWIMS.slice(0, 2), details: \"\" },\n  { swims: [{ event: \"50 Free\", entry: \"NT\", final: \"30.97\" }, { event: \"100 Free\", entry: \"1:10.52\", final: \"DQ\" }] },\n  { swims: [{ event: \"100 Back\", entry: \"1:19.77\", final: \"1:20.19\" }] },\n  { swimmer: \"Zoë Åström-Niño\", club: \"Łódź Swim Club\", accent: \"#f2c14e\" },\n];\n\ndescribe(ID, () => {\n  it(\"shows the use case at its defaults: one invented swimmer, six swims, five drops, an honest slower swim\", () => {\n    const t = textOf({});\n    expect(t).toMatchObject({\n      swimmer: \"Tessa Marlow\", club: \"Larkmoor Swim Club\", meet: \"October Kickoff Invitational\", details: \"Oct 3-4, 2026\", course: \"SCY\",\n      \"head-event\": \"EVENT\", \"head-entry\": \"ENTRY\", \"head-final\": \"FINAL\", \"head-drop\": \"DROP\",\n      \"event-0\": \"50 Free\", \"entry-0\": \"31.84\", \"final-0\": \"30.97\", \"drop-0\": \"-0.87\", \"standard-0\": \"BB\",\n      \"event-2\": \"200 Free\", \"entry-2\": \"2:36.40\", \"final-2\": \"2:29.85\", \"drop-2\": \"-6.55\", \"standard-2\": \"B\",\n      \"drop-3\": \"+0.42\",\n      \"summary-count\": \"5 of 6 swims faster\", \"summary-total\": \"14.82 s dropped\",\n      footnote: \"vs entry time. Bars and their percentages: share of the entry time dropped.\",\n      // Each percent bar prints its own number; the slower swim has neither a bar nor a number.\n      \"share-0\": \"2.7%\", \"share-1\": \"3.1%\", \"share-2\": \"4.2%\", \"share-4\": \"3.3%\", \"share-5\": \"2.3%\",\n    });\n    expect(t[\"share-3\"]).toBeUndefined();\n    expect([\"drop-0\", \"drop-1\", \"drop-2\", \"drop-3\", \"drop-4\", \"drop-5\"].map((k) => t[k])).toEqual([\"-0.87\", \"-2.21\", \"-6.55\", \"+0.42\", \"-1.18\", \"-4.01\"]);\n    // Four chips, and the rows without a standard have none.\n    expect(Object.keys(t).filter((k) => k.startsWith(\"standard-\"))).toEqual([\"standard-0\", \"standard-1\", \"standard-2\", \"standard-4\"]);\n    expect(T.outputHints).toMatchObject({ width: 1080, height: 1080, format: { kind: \"image\" } });\n  });\n\n  it(\"does its arithmetic in integer hundredths and prints times the way a results sheet does\", () => {\n    expect(parseSwimTime(\"31.84\")).toBe(3184);\n    expect(parseSwimTime(\"1:10.52\")).toBe(7052);\n    expect(parseSwimTime(\"19:58.44\")).toBe(119844);\n    expect(parseSwimTime(\"0:31.84\")).toBe(3184);\n    expect(parseSwimTime(\"65.20\")).toBe(6520);\n    for (const bad of [\"\", \"31.8\", \"31\", \"1:75.00\", \"1:5.20\", \"31,84\", \"1:10:52\", \"-31.84\", \"31.840\", \"0.00\", \"abc\", \" 31.84\"]) expect(parseSwimTime(bad)).toBeNull();\n    expect([3184, 7052, 119844, 6520, 5, 6000].map(formatSwimTime)).toEqual([\"31.84\", \"1:10.52\", \"19:58.44\", \"1:05.20\", \"0.05\", \"1:00.00\"]);\n    expect([87, -42, 0, 6233, -6001].map(formatSwimDrop)).toEqual([\"-0.87\", \"+0.42\", \"0.00\", \"-1:02.33\", \"+1:00.01\"]);\n    expect(formatSwimShare(655, 15640)).toBe(\"4.2%\");\n    expect(formatSwimShare(87, 3184)).toBe(\"2.7%\");\n    // A real drop too small to round to a tenth of a percent says so instead of reading as no drop.\n    expect(formatSwimShare(1, 119844)).toBe(\"<0.1%\");\n    expect(formatSwimShare(60, 119844)).toBe(\"0.1%\");\n    // 0.1 + 0.2 territory: the float sum of these drops is 14.819999..., the integer sum is 1482.\n    const n = normalizeSwimCard({});\n    expect([n.faster, n.compared, n.totalCs]).toEqual([5, 6, 1482]);\n    expect(n.lines.map((l) => l.dropCs)).toEqual([87, 221, 655, -42, 118, 401]);\n  });\n\n  it(\"prints a slower swim without drawing it, and makes no claim for an NT or a DQ\", () => {\n    const p: SwimTimeDropCardProps = { swims: [\n      { event: \"100 Back\", entry: \"1:19.77\", final: \"1:20.19\", standard: \"B\" },\n      { event: \"50 Fly\", entry: \"36.10\", final: \"36.10\" },\n      { event: \"200 IM\", entry: \"NT\", final: \"2:54.02\", standard: \"BB\" },\n      { event: \"100 Free\", entry: \"\", final: \"1:08.31\" },\n      { event: \"50 Free\", entry: \"31.84\", final: \"dq\" },\n      { event: \"200 Free\", entry: \"2:36.40\", final: \"2:29.85\" },\n    ] };\n    for (const [w, h] of CONTRACT_CANVASES) {\n      const L = layoutSwimCard(p, w, h);\n      expect(L.rows.map((r) => r.bar !== null)).toEqual([false, false, false, false, false, true]);\n      expect(L.tiles.filter((t) => t.label.startsWith(\"bar-\")).map((t) => t.label)).toEqual([\"bar-5\"]);\n      // Every row keeps its track, and no ink on the card is a warning colour:\n      // text is the ink, the dim ink, or the on-chip ink.\n      expect(L.tiles.filter((t) => t.label.startsWith(\"track-\"))).toHaveLength(6);\n      const inks = new Set(L.cells.filter((c) => !/^(standard|share)-/.test(c.label) && c.label !== \"course\").map((c) => c.color));\n      expect([...inks].sort()).toEqual([L.theme.dim, L.theme.ink].sort());\n      expect(L.cells.find((c) => c.label === \"drop-0\")!.color).toBe(L.cells.find((c) => c.label === \"drop-5\")!.color);\n    }\n    const t = textOf(p);\n    expect([t[\"drop-0\"], t[\"drop-1\"], t[\"drop-2\"], t[\"drop-3\"], t[\"drop-4\"], t[\"drop-5\"]]).toEqual([\"+0.42\", \"0.00\", \"first swim\", \"first swim\", undefined, \"-6.55\"]);\n    expect([t[\"entry-2\"], t[\"entry-3\"], t[\"final-4\"]]).toEqual([\"NT\", \"NT\", \"DQ\"]);\n    // Counted: the three swims with both times. Not netted: the slower swim does not reduce the total.\n    expect(t[\"summary-count\"]).toBe(\"1 of 3 swims faster\");\n    expect(t[\"summary-total\"]).toBe(\"6.55 s dropped\");\n\n    const none = textOf({ swims: [{ event: \"100 Back\", entry: \"1:19.77\", final: \"1:20.19\" }] });\n    expect(none[\"summary-count\"]).toBe(\"0 of 1 swim faster\");\n    expect(none[\"summary-total\"]).toBeUndefined();\n    expect(none.footnote).toBe(\"vs entry time. No swim was faster, so no bar is drawn.\");\n    const first = textOf({ swims: [{ event: \"50 Free\", entry: \"NT\", final: \"30.97\" }, { event: \"100 Free\", entry: \"1:10.52\", final: \"DQ\" }] });\n    expect(first[\"summary-count\"]).toBe(\"No times to compare\");\n    expect(first[\"summary-total\"]).toBeUndefined();\n    expect(first.footnote).not.toMatch(/Bars/);\n    // A total over a minute is printed as a time.\n    expect(textOf(LONG)[\"summary-total\"]).toBe(\"1:13.64 dropped\");\n  });\n\n  it(\"says vs entry time on every card and never calls a swim a best\", async () => {\n    for (const p of CASES) {\n      const drawn = JSON.stringify((await render(p)).sources);\n      expect(drawn).toContain(\"vs entry time\");\n      expect(drawn).not.toMatch(/\\bPB\\b|best time|personal best/i);\n    }\n  });\n\n  it(\"draws bars proportional to what the footnote names, the longest filling its track\", async () => {\n    const shares = (bar: \"percent\" | \"seconds\") => normalizeSwimCard({ bar }).lines.map((l) => l.share);\n    // percent: drop / entry against the largest share (200 Free, 655 / 15640).\n    const pct = [87 / 3184, 221 / 7052, 655 / 15640, 0, 118 / 3610, 401 / 17803].map((s) => s / (655 / 15640));\n    const sec = [87, 221, 655, 0, 118, 401].map((d) => d / 655);\n    shares(\"percent\").forEach((s, i) => expect(s).toBeCloseTo(pct[i], 12));\n    shares(\"seconds\").forEach((s, i) => expect(s).toBeCloseTo(sec[i], 12));\n    // The two variants disagree visibly: the 50 Free outranks the 200 IM in percent, not in seconds.\n    expect(shares(\"percent\")[0]).toBeGreaterThan(shares(\"percent\")[5]);\n    expect(shares(\"seconds\")[5]).toBeGreaterThan(shares(\"seconds\")[0] * 4);\n    expect(textOf({ bar: \"seconds\" }).footnote).toBe(\"vs entry time. Bars: seconds dropped; the longest is 6.55 s.\");\n    expect(textOf({ ...LONG, bar: \"seconds\" }).footnote).toBe(\"vs entry time. Bars: seconds dropped; the longest is 1:02.33.\");\n\n    for (const bar of [\"percent\", \"seconds\"] as const) for (const [w, h] of CONTRACT_CANVASES) {\n      const want = shares(bar);\n      const resolved = checkLayoutIntent(await render({ bar }, w, h), w, h)!.resolved;\n      const tracks = want.map((_, i) => resolved[`track-${i}`][0].rect);\n      // One size, one left edge - from the rects the engine realizes.\n      for (const t of tracks) {\n        expect(Math.abs(t.x - tracks[0].x)).toBeLessThanOrEqual(1);\n        expect(Math.abs(t.w - tracks[0].w)).toBeLessThanOrEqual(2);\n        expect(Math.abs(t.h - tracks[0].h)).toBeLessThanOrEqual(2);\n        expect(t.w).toBeGreaterThanOrEqual(w * 0.2);\n      }\n      want.forEach((share, i) => {\n        if (share === 0) { expect(resolved[`bar-${i}`]).toBeUndefined(); return; }\n        const b = resolved[`bar-${i}`][0].rect;\n        expect(Math.abs(b.x - tracks[i].x)).toBeLessThanOrEqual(1);\n        // Proportional within the pixel or two quantization takes (and the 1% floor of a tiny bar).\n        expect(Math.abs(b.w - share * tracks[i].w)).toBeLessThanOrEqual(Math.max(3, tracks[i].w * 0.011));\n        if (share === 1) expect(Math.abs(b.w - tracks[i].w)).toBeLessThanOrEqual(2);\n      });\n    }\n  });\n\n  it(\"keeps its contract from 1 to 8 rows at the seven contract canvases, with nothing colliding\", async () => {\n    const rowCounts = Array.from({ length: 8 }, (_, i) => ({ ...LONG, swims: LONG.swims!.slice(0, i + 1) }));\n    for (const p of [...CASES, ...rowCounts]) {\n      await sweepLayout((q, ctx) => T.render(q, ctx).then(asDocument), ID, p, targetCtx);\n      for (const [w, h] of CONTRACT_CANVASES) {\n        const L = layoutSwimCard(p, w, h);\n        // The document itself, for the stress copy (the row-count walk is swept above and laid out here, not rendered twice).\n        if (CASES.includes(p)) {\n          const doc = await render(p, w, h);\n          const ev = evaluateM0(String(doc.m0), { width: w, height: h });\n          expect(ev.feasible && ev.meetsPrecision).toBe(true);\n          // Every source is labelled and promised something; every text promises that it fits.\n          const intent = layoutIntentOf(doc)!;\n          for (const s of doc.sources ?? []) {\n            expect(s.editor?.label).toBeTruthy();\n            expect(intent.constraints.some((c) => c.label === s.editor?.label)).toBe(true);\n            if (s.type === \"text\") expect(intent.constraints.some((c) => c.label === s.editor?.label && c.textFits)).toBe(true);\n          }\n        }\n\n        // Inside the margins, never below the floor, never cut.\n        for (const c of L.cells) {\n          expect(c.px).toBeGreaterThanOrEqual(L.small);\n          expect(c.text).not.toContain(\"...\");\n          expect(c.rect.x).toBeGreaterThanOrEqual(L.m);\n          expect(c.rect.y).toBeGreaterThanOrEqual(L.m);\n          expect(c.rect.x + c.rect.w).toBeLessThanOrEqual(w - L.m);\n          expect(c.rect.y + c.rect.h).toBeLessThanOrEqual(h - L.m);\n        }\n        // No two texts overlap, and no text sits on a tile it does not belong to.\n        const texts = L.cells.map((c) => ({ label: c.label, rect: c.rect }));\n        const hit = (a: { x: number; y: number; w: number; h: number }, b: { x: number; y: number; w: number; h: number }) => a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;\n        for (let i = 0; i < texts.length; i++) for (let j = i + 1; j < texts.length; j++) {\n          if (hit(texts[i].rect, texts[j].rect)) throw new Error(`${texts[i].label} overlaps ${texts[j].label} at ${w}x${h}`);\n        }\n        for (const t of L.tiles) for (const c of L.cells) {\n          const own = (t.label === \"course-chip\" && c.label === \"course\") || (t.label.startsWith(\"chip-\") && c.label === `standard-${t.label.slice(5)}`)\n            || (/^(track|bar)-/.test(t.label) && c.label === `share-${t.label.split(\"-\")[1]}`);\n          if (!own && hit(t.rect, c.rect)) throw new Error(`${c.label} overlaps ${t.label} at ${w}x${h}`);\n        }\n        // The rows keep to their band, in order, and one or two swims do not become slabs.\n        expect(L.rowH).toBeLessThanOrEqual(L.cap);\n        expect(L.rows[0].top).toBeGreaterThan(L.bandTop);\n        L.rows.forEach((r, i) => expect(r.top).toBe(L.rows[0].top + i * L.rowH));\n        expect(L.rows[L.rows.length - 1].top + L.rowH).toBeLessThanOrEqual(L.bandBottom);\n        // The name is the largest text; the summary is second.\n        const px = Object.fromEntries(L.cells.map((c) => [c.label, c.px]));\n        if (p === CASES[0]) {\n          expect(px.swimmer).toBeGreaterThan(px[\"summary-count\"]);\n          expect(px[\"summary-count\"]).toBeGreaterThan(px[\"event-0\"]);\n        }\n      }\n    }\n  });\n\n  it(\"prints a percent bar's own number at its end, and none in seconds\", () => {\n    for (const [w, h] of CONTRACT_CANVASES) for (const p of [{}, LONG]) {\n      const L = layoutSwimCard(p, w, h);\n      for (const [i, r] of L.rows.entries()) {\n        const label = L.cells.find((c) => c.label === `share-${i}`);\n        // A label exactly where there is a bar: a slower, equal, NT or DQ row has neither.\n        expect(label !== undefined).toBe(r.bar !== null);\n        if (!label || !r.bar) continue;\n        expect(label.text).toBe(formatSwimShare(r.line.dropCs!, r.line.entryCs!));\n        // On the track, on the bar's own line: just past the bar's end, or inside a bar too long to leave room.\n        expect(label.rect.y).toBe(r.track.y);\n        expect(label.rect.h).toBe(r.track.h);\n        expect(label.rect.x).toBeGreaterThanOrEqual(r.track.x);\n        expect(label.rect.x + label.rect.w).toBeLessThanOrEqual(r.track.x + r.track.w);\n        const end = r.bar.x + r.bar.w;\n        const after = label.rect.x >= end;\n        if (!after) expect(label.rect.x + label.rect.w).toBeLessThanOrEqual(end);\n        expect(label.color).toBe(after ? L.theme.ink : L.cells.find((c) => c.label === \"course\")!.color);\n        expect(label.px).toBeGreaterThanOrEqual(L.small);\n      }\n      // In seconds the row already prints the bar's number as the drop: no labels, on the same\n      // track column. (The footnote's length can move the band a line, so heights are not compared.)\n      const S = layoutSwimCard({ ...p, bar: \"seconds\" }, w, h);\n      expect(S.cells.some((c) => c.label.startsWith(\"share-\"))).toBe(false);\n      expect(S.rows.map((r) => [r.track.x, r.track.w])).toEqual(L.rows.map((r) => [r.track.x, r.track.w]));\n    }\n    expect(textOf(LONG)[\"share-1\"]).toBe(\"5.2%\");\n    expect(textOf(LONG)[\"share-7\"]).toBe(\"<0.1%\");\n  });\n\n  it(\"puts the bar in a column on a wide canvas and under the row's text line otherwise\", () => {\n    const wide = layoutSwimCard({}, 1920, 1080), square = layoutSwimCard({}, 1080, 1080), tall = layoutSwimCard({}, 1080, 1920);\n    expect([wide.wide, square.wide, tall.wide]).toEqual([true, false, false]);\n    const cell = (L: typeof wide, label: string) => L.cells.find((c) => c.label === label)!.rect;\n    // Wide: the track sits between FINAL and DROP on the text line.\n    expect(wide.rows[0].track.x).toBeGreaterThan(cell(wide, \"final-0\").x + cell(wide, \"final-0\").w);\n    expect(wide.rows[0].track.x + wide.rows[0].track.w).toBeLessThan(cell(wide, \"drop-0\").x);\n    // Square and portrait: the full content width, under the text line.\n    for (const L of [square, tall]) {\n      expect(L.rows[0].track.w).toBe(L.cells.find((c) => c.label === \"footnote\")!.rect.w);\n      expect(L.rows[0].track.y).toBeGreaterThanOrEqual(cell(L, \"event-0\").y + cell(L, \"event-0\").h);\n    }\n    // A row without a standard keeps the space: the columns do not shift between rows.\n    for (const L of [wide, square, tall]) {\n      expect(new Set(L.rows.map((_, i) => cell(L, `drop-${i}`).x)).size).toBe(1);\n      expect(new Set(L.rows.filter((r) => r.chip).map((r) => r.chip!.x)).size).toBe(1);\n    }\n  });\n\n  it(\"binds each text rect to the prop it shows; derived text and the enums stay unbound\", async () => {\n    const doc = await render();\n    const { byProp, rejected } = resolvePropBindings(doc, 1080, 1080, { propsSchema: T.propsSchema });\n    expect(rejected).toEqual([]);\n    // 6 events + 6 entries + 6 finals + 4 standards on `swims`; the accent on the course chip.\n    expect(Object.fromEntries(Object.entries(byProp).map(([key, v]) => [key, v.length]))).toEqual({ swimmer: 1, club: 1, meet: 1, details: 1, accent: 1, swims: 22 });\n    const bound = (await render({ club: \"\", meet: \"\", details: \"\" })).sources!.filter((s) => s.editor?.binding).length;\n    expect(bound).toBe(24);\n  });\n\n  it(\"follows the accent and the preset, with the page as the document background\", async () => {\n    const dark = await render(), light = await render({ preset: \"light\", accent: \"#E4572E\" });\n    expect([dark.backgroundColor, light.backgroundColor]).toEqual([\"#0e1b25\", \"#f5f9fa\"]);\n    const L = layoutSwimCard({ preset: \"light\", accent: \"#E4572E\" }, 1080, 1080);\n    expect(new Set(L.tiles.filter((t) => /^(bar|chip)-|course-chip/.test(t.label)).map((t) => t.color))).toEqual(new Set([\"#e4572e\"]));\n  });\n\n  it(\"draws accented Latin names: every character it accepts has a glyph in both weights\", () => {\n    const opentype = getOpentype() as { loadSync(path: string): { charToGlyph(ch: string): { index: number } } };\n    for (const path of [bundledFontPath(), resolveFontFile({ weight: \"bold\" })!.path]) {\n      const font = opentype.loadSync(path);\n      for (let code = 0xc0; code <= 0x17f; code++) {\n        if (code === 0xd7 || code === 0xf7) continue;\n        expect(font.charToGlyph(String.fromCodePoint(code)).index).not.toBe(0);\n      }\n    }\n    expect(textOf({ swimmer: \"Zoë Åström\" }).swimmer).toBe(\"Zoë Åström\");\n    // What it cannot promise to draw is refused by name, never drawn as tofu.\n    expect(() => normalizeSwimCard({ swimmer: \"游泳\" })).toThrow(/swimmer .*not known to draw/);\n    expect(() => normalizeSwimCard({ club: \"Wave → Aquatics\" })).toThrow(/club .*not known to draw/);\n  });\n\n  it(\"is deterministic, follows ctx.target when nested, and passes its own contract with the overlay on\", async () => {\n    expect(await render()).toEqual(await render());\n    const ctx = targetCtx(480, 270);\n    ctx.output.width = 3840;\n    ctx.output.height = 2160;\n    expect(await T.render({}, ctx).then(asDocument)).toEqual(await render({}, 480, 270));\n    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n    expect((await render({ ...LONG, debugLayout: true }, 1920, 1080)).editor).toMatchObject({ layoutContract: { ok: true } });\n  });\n\n  it.each<[string, SwimTimeDropCardProps, RegExp]>([\n    [\"a time that does not parse\", { swims: [{ event: \"50 Free\", entry: \"31.8\", final: \"30.97\" }] }, /swims\\[0\\]\\.entry \"31\\.8\" is not a time/],\n    [\"a final that does not parse\", { swims: [SWIMS[0], { event: \"100 Free\", entry: \"1:10.52\", final: \"1:75.00\" }] }, /swims\\[1\\]\\.final \"1:75\\.00\" is not a time/],\n    [\"a missing final\", { swims: [{ event: \"50 Free\", entry: \"31.84\" } as SwimRow] }, /swims\\[0\\]\\.final is missing/],\n    [\"a blank final\", { swims: [{ event: \"50 Free\", entry: \"31.84\", final: \" \" }] }, /swims\\[0\\]\\.final must not be blank/],\n    [\"a blank event\", { swims: [{ event: \"\", entry: \"31.84\", final: \"30.97\" }] }, /swims\\[0\\]\\.event must not be blank/],\n    [\"zero rows\", { swims: [] }, /swims must hold at least one/],\n    [\"nine rows\", { swims: Array.from({ length: 9 }, () => SWIMS[0]) }, /swims has 9 rows; one card holds at most 8 - split the meet across two cards/],\n    [\"a long standard\", { swims: [{ ...SWIMS[0], standard: \"AAAAA\" }] }, /swims\\[0\\]\\.standard \"AAAAA\" is longer than 4 characters/],\n    [\"a standard on a DQ\", { swims: [{ event: \"50 Free\", entry: \"31.84\", final: \"DQ\", standard: \"B\" }] }, /swims\\[0\\]\\.standard \"B\" is set on a DQ/],\n    [\"a row that is not an object\", { swims: [\"50 Free\" as unknown as SwimRow] }, /swims\\[0\\] must be an object/],\n    [\"swims that is not a list\", { swims: \"50 Free\" as unknown as SwimRow[] }, /swims must hold at least one/],\n    [\"a blank swimmer\", { swimmer: \"  \" }, /swimmer must not be blank/],\n    [\"a 41-character swimmer\", { swimmer: \"W\".repeat(41) }, /swimmer .* is 41 characters; the card fits at most 40/],\n    [\"a two-line club\", { club: \"Larkmoor\\nSwim Club\" }, /club .*not known to draw/],\n    [\"a swimmer that is not a string\", { swimmer: 42 as unknown as string }, /swimmer must be a string/],\n    [\"an unknown course\", { course: \"SCX\" as never }, /course \"SCX\" must be \"SCY\", \"SCM\" or \"LCM\"/],\n    [\"an unknown bar\", { bar: \"ratio\" as never }, /bar \"ratio\" must be \"percent\" or \"seconds\"/],\n    [\"an unknown preset\", { preset: \"sepia\" as never }, /preset \"sepia\" must be \"dark\" or \"light\"/],\n    [\"a bad accent\", { accent: \"teal\" }, /accent \"teal\" must be #rrggbb/],\n    [\"a debugLayout that is not a boolean\", { debugLayout: \"yes\" as never }, /debugLayout must be a boolean/],\n  ])(\"rejects %s by name, without falling back to the sample\", (_name, props, message) => {\n    expect(() => normalizeSwimCard(props)).toThrow(message);\n    expect(() => normalizeSwimCard(props)).toThrow(new RegExp(`^${ID.replace(/[/]/g, \"\\\\/\")}: `));\n  });\n\n  it(\"refuses copy it cannot fit instead of clipping it\", () => {\n    expect(() => layoutSwimCard({ swimmer: \"W\".repeat(40) }, 160, 90)).toThrow(/cannot be fitted on 160x90/);\n  });\n});\n","numLines":355,"startLine":1,"totalLines":355}}}
