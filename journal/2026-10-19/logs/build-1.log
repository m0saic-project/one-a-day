ourse\", courseChip, p.course, fitPx(p.course, courseChip.w, courseChip.h * 0.5, true), { bold: true, align: \"center\", color: onColor(p.accent), over: true, floor: small });\n416: \n417:   // ── summary band, built from the bottom up: count and total, then the footnote that carries the honesty ──\n418:   const footTop = Math.round(S * 0.025 * k);\n419:   const oneLine = fitPx(p.footnote, CW, footTop, false);\n420:   let footPx = oneLine, footLines = [p.footnote];\n421:   if (oneLine < footTop * 0.9) {\n422:     // Two lines at the target size beat one shrunken line; shrink only when two do not hold it.\n423:     footPx = footTop;\n424:     footLines = wrapMeasured(p.footnote, footPx, budget(CW));\n425:     while (footLines.length > 2 && footPx > 1) { footPx--; footLines = wrapMeasured(p.footnote, footPx, budget(CW)); }\n426:   }\n427:   if (footPx < small) unfit(\"footnote\");\n428:   const footLineH = Math.round(footPx * 1.4), footH = footLines.length * footLineH + 2;\n429:   const footRect: SwimRect = { x: m, y: H - m - footH, w: CW, h: footH };\n430:   cells.push({ label: \"footnote\", rect: footRect, text: footLines.join(\"\\n\"), px: footPx, width: Math.max(...footLines.map((l) => widthOf(l, footPx))), bold: false, align: \"left\", color: dim, bind: null, over: false });\n431: \n432:   const sumTop = Math.round(S * 0.05 * k);\n433:   const countW = Math.round(CW * 0.58), totalW = CW - countW - gap;\n434:   const sidePx = Math.min(fitPx(p.countText, p.totalText === \"\" ? CW : countW, sumTop, true), p.totalText === \"\" ? Infinity : fitPx(p.totalText, totalW, sumTop, true));\n435:   // Side by side while that keeps the size; stacked when the pair would have to shrink (portrait).\n436:   const stacked = p.totalText !== \"\" && sidePx < sumTop * 0.85;\n437:   const sumPx = stacked ? Math.min(fitPx(p.countText, CW, sumTop, true), fitPx(p.totalText, CW, sumTop, true)) : sidePx;\n438:   const sumRowH = Math.round(sumPx * 1.45);\n439:   const sumY = footRect.y - Math.round(S * 0.008) - (stacked ? 2 : 1) * sumRowH;\n440:   if (stacked) {\n441:     line(\"summary-count\", { x: m, y: sumY, w: CW, h: sumRowH }, p.countText, sumPx, { bold: true, field: \"the summary\" });\n442:     line(\"summary-total\", { x: m, y: sumY + sumRowH, w: CW, h: sumRowH }, p.totalText, sumPx, { bold: true, field: \"the summary\" });\n443:   } else {\n444:     line(\"summary-count\", { x: m, y: sumY, w: p.totalText === \"\" ? CW : countW, h: sumRowH }, p.countText, sumPx, { bold: true, field: \"the summary\" });\n445:     if (p.totalText !== \"\") line(\"summary-total\", { x: W - m - totalW, y: sumY, w: totalW, h: sumRowH }, p.totalText, sumPx, { bold: true, align: \"right\", field: \"the summary\" });\n446:   }\n447:   const line2 = mix(theme.bg, theme.ink, 0.22);\n448:   const ruleBottomY = sumY - Math.round(gap * 0.6) - rule;\n449:   tiles.push({ label: \"rule-top\", rect: { x: m, y: headerBottom + Math.round(gap * 0.5), w: CW, h: rule }, color: line2, radius: 0, layer: 1 });\n450:   tiles.push({ label: \"rule-bottom\", rect: { x: m, y: ruleBottomY, w: CW, h: rule }, color: line2, radius: 0, layer: 1 });\n451: \n452:   // ── the rows: a column-head line, then one row per swim in meet order ──\n453:   const n = p.lines.length;\n454:   const bandTop = headerBottom + gap + rule, bandBottom = ruleBottomY - Math.round(gap * 0.5);\n455:   const headH = Math.round(S * 0.04 * k);\n456:   const rowsTop = bandTop + headH;\n457:   // The cap keeps one or two swims from turning into slabs; the group sits at the top of its band.\n458:   const cap = Math.round(S * (wide ? 0.105 : 0.135 * k));\n459:   const rowH = Math.min(cap, Math.floor((bandBottom - rowsTop) / n));\n460:   // Column widths are fractions of the content width, the same in every row,\n461:   // so a row without a chip keeps the space and the decimal points stack.\n462:   const g = Math.round(CW * (wide ? 0.012 : 0.01));\n463:   const frac = wide ? { event: 0.22, entry: 0.12, final: 0.12, track: 0.28, drop: 0.13 } : { event: 0.27, entry: 0.19, final: 0.19, track: 0, drop: 0.19 };\n464:   const col = (x: number, f: number) => ({ x, w: Math.round(CW * f) });\n465:   const cEvent = col(m, frac.event);\n466:   const cEntry = col(cEvent.x + cEvent.w + g, frac.entry);\n467:   const cFinal = col(cEntry.x + cEntry.w + g, frac.final);\n468:   const cTrack = wide ? col(cFinal.x + cFinal.w + g, frac.track) : { x: m, w: CW };\n469:   const cDrop = col(wide ? cTrack.x + cTrack.w + g : cFinal.x + cFinal.w + g, frac.drop);\n470:   const cChip = { x: cDrop.x + cDrop.w + g, w: W - m - (cDrop.x + cDrop.w + g) };\n471: \n472:   // One size for every time on the card and one for every event name: a long\n473:   // event name shrinks the event column, never the numbers beside it.\n474:   // The times are fitted to 88% of their column, so two neighbouring\n475:   // times always keep a gutter; the row text never outgrows the summary.\n476:   const rowTop = Math.min(Math.round(rowH * (wide ? 0.46 : 0.4)), Math.round(S * 0.04 * k));\n477:   const tight = (w: number) => Math.round(w * 0.88);\n478:   let rowPx = rowTop, eventPx = rowTop;\n479:   for (const l of p.lines) {\n480:     eventPx = Math.min(eventPx, fitPx(l.event, cEvent.w, eventPx, true));\n481:     rowPx = Math.min(rowPx, fitPx(l.entryText, tight(cEntry.w), rowPx, false), fitPx(l.finalText, tight(cFinal.w), rowPx, false));\n482:     if (l.dropText !== \"\") rowPx = Math.min(rowPx, fitPx(l.dropText, tight(cDrop.w), rowPx, l.dropCs !== null));\n483:   }\n484:   // The event name is never larger than the times beside it.\n485:   eventPx = Math.min(eventPx, rowPx);\n486:   if (rowPx < floor) unfit(`swims (${n} rows)`);\n487:   const chipPx = p.lines.reduce((px, l) => (l.standard === \"\" ? px : Math.min(px, fitPx(l.standard, cChip.w, px, true))), Math.max(1, Math.round(rowPx * 0.78)));\n488:   const headPx = [\"EVENT\", \"ENTRY\", \"FINAL\", \"DROP\"].reduce((px, t, i) => Math.min(px, fitPx(t, [cEvent, cEntry, cFinal, cDrop][i].w, px, false)), Math.max(1, Math.min(Math.round(headH * 0.5), rowPx)));\n489:   const headRect = (c: { x: number; w: number }): SwimRect => ({ x: c.x, y: bandTop, w: c.w, h: headH });\n490:   line(\"head-event\", headRect(cEvent), \"EVENT\", headPx, { color: dim, floor: small });\n491:   line(\"head-entry\", headRect(cEntry), \"ENTRY\", headPx, { color: dim, align: \"right\", floor: small });\n492:   line(\"head-final\", headRect(cFinal), \"FINAL\", headPx, { color: dim, align: \"right\", floor: small });\n493:   line(\"head-drop\", headRect(cDrop), \"DROP\", headPx, { color: dim, align: \"right\", floor: small });\n494: \n495:   const trackColor = mix(theme.bg, theme.ink, 0.13);\n496:   // A bar in percent beside a drop in seconds asks the reader to hold two\n497:   // units, so each percent bar carries its own number at its end.\n498:   // The track is tall enough to hold a bar's own number, in both bar modes:\n499:   // `bar` changes the lengths, the labels and the footnote, not the row's\n500:   // proportions. Only a percent bar is labelled - in seconds the number is\n501:   // already on the row, as the drop.\n502:   const labelled = p.bar === \"percent\";\n503:   // Never taller than the row's own text: on a card of one or two swims the bar stays a bar, not a slab.\n504:   const trackH = Math.max(3, Math.min(Math.round(rowH * (wide ? 0.4 : 0.32)), Math.round(rowPx * 0.9)));\n505:   const sharePx = Math.max(1, Math.min(Math.round(trackH * 0.78), rowPx));\n506:   const shareW = labelled ? Math.max(0, ...p.lines.map((l) => (l.share > 0 ? Math.ceil((widthOf(l.shareText, sharePx, true) + 2) / 0.94) + 1 : 0))) : 0;\n507:   const sharePad = Math.round(trackH * 0.3);\n508:   const minBar = Math.max(2, Math.round(cTrack.w * 0.01));\n509:   const chipH = Math.min(Math.round(rowPx * 1.45), Math.round(rowH * 0.46));\n510:   const rows = p.lines.map((l, i) => {\n511:     const top = rowsTop + i * rowH;\n512:     // Square and portrait: the text line ends where the track begins, to the pixel.\n513:     const trackOff = Math.round(rowH * 0.6), textOff = Math.round(rowH * 0.06);\n514:     const textRect = wide ? { y: top + Math.round(rowH * 0.12), h: rowH - 2 * Math.round(rowH * 0.12) } : { y: top + textOff, h: Math.min(Math.round(rowH * 0.56), trackOff - textOff) };\n515:     const cell = (c: { x: number; w: number }): SwimRect => ({ x: c.x, w: c.w, ...textRect });\n516:     const track: SwimRect = { x: cTrack.x, w: cTrack.w, y: wide ? top + Math.round((rowH - trackH) / 2) : top + trackOff, h: trackH };\n517:     tiles.push({ label: `track-${i}`, rect: track, color: trackColor, radius: 0.5, layer: 1 });\n518:     // A bar is drawn for a faster swim only, from the track's left edge. The\n519:     // floor keeps a real but tiny drop visible; it never invents one.\n520:     const bar: SwimRect | null = l.share > 0 ? { ...track, w: Math.min(track.w, Math.max(minBar, Math.round(track.w * l.share))) } : null;\n521:     if (bar) tiles.push({ label: `bar-${i}`, rect: bar, color: p.accent, radius: 0.5, layer: 2 });\n522:     if (bar && labelled) {\n523:       // At the bar's end: on the empty track just past it, or inside a bar too long to leave room.\n524:       const after = bar.w + sharePad + shareW <= track.w;\n525:       const rect: SwimRect = { x: after ? bar.x + bar.w + sharePad : bar.x + bar.w - sharePad - shareW, y: track.y, w: shareW, h: track.h };\n526:       line(`share-${i}`, rect, l.shareText, sharePx, { bold: true, align: after ? \"left\" : \"right\", color: after ? ink : onColor(p.accent), over: true, floor: small, field: \"the bar labels\" });\n527:     }\n528:     line(`event-${i}`, cell(cEvent), l.event, eventPx, { bold: true, bind: { row: i, field: \"event\" }, field: `swims[${i}].event` });\n529:     line(`entry-${i}`, cell(cEntry), l.entryText, rowPx, { color: dim, align: \"right\", bind: { row: i, field: \"entry\" } });\n530:     line(`final-${i}`, cell(cFinal), l.finalText, rowPx, { align: \"right\", bind: { row: i, field: \"final\" } });\n531:     // The drop is derived (entry - final), so it is not bound. A slower swim's\n532:     // plus sign is in the same ink as a faster swim's minus: printed, not shouted.\n533:     if (l.dropText !== \"\") line(`drop-${i}`, cell(cDrop), l.dropText, rowPx, l.dropCs !== null ? { bold: true, align: \"right\" } : { color: dim, align: \"right\" });\n534:     let chip: SwimRect | null = null;\n535:     if (l.standard !== \"\") {\n536:       chip = { x: cChip.x, w: cChip.w, y: textRect.y + Math.round((textRect.h - chipH) / 2), h: chipH };\n537:       tiles.push({ label: `chip-${i}`, rect: chip, color: p.accent, radius: 0.5, layer: 1 });\n538:       line(`standard-${i}`, chip, l.standard, chipPx, { bold: true, align: \"center\", color: onColor(p.accent), bind: { row: i, field: \"standard\" }, over: true, floor: small, field: `swims[${i}].standard` });\n539:     }\n540:     return { top, track, bar, chip, line: l, labelled: bar !== null && labelled };\n541:   });\n542: \n543:   return { p, theme, wide, cells, tiles, rows, m, floor, small, rowH, rowPx, eventPx, cap, headerBottom, bandTop, bandBottom, footLines: footLines.length, stacked };\n544: }\n545: \n546: /**\n547:  * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n548:  * convention, src/_shared/why.ts): the run, the problem with the sources the\n549:  * agent opened, the solution, how to use it, then the template itself.\n550:  */\n551: const WHY: WhySpec = {\n552:   \"day\": 12,\n553:   \"date\": \"2026-10-01\",\n554:   \"agent\": \"claude\",\n555:   \"model\": \"claude-fable-5.1\",\n556:   \"id\": \"@one-a-day/sports/swim-time-drop-card/v1\",\n557:   \"title\": \"Swim Time Drop Card\",\n558:   \"who\": \"Age-group swim club coaches and parent volunteers who type a recap of time drops and new cuts onto the club GoMotion/TeamUnify site after every meet.\",\n559:   \"problem\": [\n560:     \"After every meet the recap is typed by hand. Wave Aquatics lists dozens of lines like \\\"[swimmer] A time 200 Fly, AA time 200 IM\\\", then \\\"Top time drops of the meet: [swimmer] dropped 40 seconds in the 200 Free!\\\". CATCC does the same: \\\"New Nat BB Cuts\\\", then \\\"dropping thirty-three seconds in his 1000 Free\\\".\",\n561:     \"Maverick Swim Club defines it in writing: \\\"When a swimmer improves upon that baseline time, it is called a time drop\\\", with an award per five drops. The numbers already sit in the file the meet host exports: Hy-Tek Meet Manager writes \\\"both the old CL2 file format and the new HY3 format\\\", and flipturn parses them.\"\n562:   ],\n563:   \"sources\": [\n564:     \"https://www.gomotionapp.com/team/wave/page/news/507024/fall-divisional-meet-recap\",\n565:     \"https://www.gomotionapp.com/team/catcc/page/news/570837/hvda-scy-bbbc-meet-recap\",\n566:     \"https://www.mavswim.org/page/celebrations/time-drops\",\n567:     \"https://hytek.active.com/user_guides_html/swmm6/exportresultstotm.htm\",\n568:     \"https://github.com/enagon-athletics/flipturn\",\n569:     \"https://github.com/anedav68/MediaHub\"\n570:   ],\n571:   \"solution\": [\n572:     \"One card per swimmer per meet from the rows a results file holds: event, entry time, final time, plus a standard you supply. Times become integer hundredths; each row prints the drop in seconds with its sign, and the summary counts the faster swims and adds up their drops.\",\n573:     \"The one decision: a bar says what it measures. Seconds favour long events, so a bar is the share of the entry time dropped, with that percent printed at its end; the longest fills the track. bar \\\"seconds\\\" is one prop away. A slower swim gets a plus sign in the same ink and an empty track - no red.\"\n574:   ],\n575:   \"usage\": {\n576:     \"command\": \"m0saic make @one-a-day/sports/swim-time-drop-card/v1 --template-repo . -w 1080 -h 1080 -o journal/2026-10-01/swim-time-drop-card.png\",\n577:     \"try\": [\n578:       \"swims: [{ event, entry, final, standard }] - 1 to 8 rows, times as \\\"31.84\\\" or \\\"1:10.52\\\"\",\n579:       \"bar \\\"seconds\\\": bars in seconds dropped, the recaps' own unit; the labels go, the footnote changes\",\n580:       \"entry \\\"NT\\\" (a first swim) or final \\\"DQ\\\": the row is printed, claims nothing and is not counted\",\n581:       \"accent \\\"#e4572e\\\", preset \\\"light\\\", -w 1920 -h 1080: the club colour, a light page, bars in a column\"\n582:     ]\n583:   },\n584:   \"timeline\": {\n585:     \"source\": \"runner\",\n586:     \"phases\": [\n587:       {\n588:         \"name\": \"scout\",\n589:         \"startMs\": 0,\n590:         \"durMs\": 250040,\n591:         \"calls\": 26,\n592:         \"tokens\": 2071821,\n593:         \"costUsd\": 2.98,\n594:         \"tools\": \"Bash 9, WebSearch 9, Read 5\"\n595:       },\n596:       {\n597:         \"name\": \"plan\",\n598:         \"startMs\": 250059,\n599:         \"durMs\": 240329,\n600:         \"calls\": 16,\n601:         \"tokens\": 1600003,\n602:         \"costUsd\": 2.93,\n603:         \"tools\": \"Bash 11, Read 4, Write 1\"\n604:       },\n605:       {\n606:         \"name\": \"build\",\n607:         \"startMs\": 490467,\n608:         \"durMs\": 3368919,\n609:         \"calls\": 98,\n610:         \"tokens\": 31230990,\n611:         \"costUsd\": 14.59,\n612:         \"tools\": \"Bash 53, Read 38, Edit 4\",\n613:         \"status\": \"error\"\n614:       },\n615:       {\n616:         \"name\": \"critique\",\n617:         \"startMs\": 3859430,\n618:         \"durMs\": 166584,\n619:         \"calls\": 36,\n620:         \"tokens\": 4073668,\n621:         \"costUsd\": 3.48,\n622:         \"tools\": \"Read 27, Bash 8, Write 1\"\n623:       }\n624:     ],\n625:     \"costBasis\": \"reported\"\n626:   },\n627:   \"caveats\": [\n628:     \"It does not read .hy3 or .cl2 files: parse the results yourself (flipturn does) and pass the rows. Standards are not computed either; the default chips are illustrative.\",\n629:     \"The entry time is the seed, not always the swimmer's fastest earlier swim, so the card says \\\"vs entry time\\\" and claims nothing more.\",\n630:     \"Eight rows at most (split a long meet across two cards) and no relays: a relay result has no entry time per swimmer.\"\n631:   ]\n632: };\n633: \n634: export const SwimTimeDropCardV1 = defineMosaicTemplate<SwimTimeDropCardProps>({\n635:   id: asTemplateId(ID),\n636:   label: \"2026-10-01 · Swim Time Drop Card\",\n637:   version: 1,\n638:   description: \"A swim meet time-drop card for one swimmer: entry time against the time swum per event, the drop in seconds, a bar that prints the percent of the entry time it stands for, and the standard reached.\",\n639:   capabilities: { tier: \"core\" },\n640:   tags: [\"sports\", \"2026-10-01\", \"day-012\", \"swimming\", \"time-drop\", \"meet-recap\", \"club\"],\n641: \n642:   outputHints: {\n643:     width: 1080,\n644:     height: 1080,\n645:     fps: 30,\n646:     durationMs: 2000,\n647:     format: { kind: \"image\", container: \"png\" },\n648:     note: \"Still PNG. Square and portrait draw each bar under its row; canvases 4:3 and wider put the bars in a column. Minimum tested canvas 480x270.\",\n649:   },\n650: \n651:   propsSchema,\n652:   defaultProps: DEFAULTS,\n653: \n654:   render,\n655:   renderTutorial: whyTutorial(WHY, render),\n656: });\n657: \n658: export default SwimTimeDropCardV1;\n659: \n660: async function render(props: SwimTimeDropCardProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n661:   const { width: W, height: H } = ctx.target;\n662:   const L = layoutSwimCard(props, W, H);\n663:   const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n664:   const constraints: LayoutConstraint[] = [];\n665: \n666:   // Emitted kind by kind, not row by row: placeInsetPieces puts a rect on the\n667:   // first overlay layer it does not collide with, so tiles of one kind share\n668:   // a layer and the chain stays a few layers deep at eight rows.\n669:   for (const t of [...L.tiles].sort((a, b) => a.layer - b.layer)) {\n670:     const tile = tag({ ...makeColorTile(t.color, t.radius > 0 ? { effects: { rounding: { cornerStyle: \"rounded\", borderRadius: t.radius } } } : {}) } as MosaicSource, t.label);\n671:     // `accent` paints the course chip, so that is the rect that shows it.\n672:     pieces.push({ rect: { ...t.rect, importance: t.layer }, source: t.accent ? bindProp(tile, \"accent\") : tile });\n673:   }\n674:   for (const c of L.cells) {\n675:     const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n676:     // A text rect is BOUND to the prop it shows; derived text (drops, the summary, the footnote) is not.\n677:     const source = c.bind === null ? cell : \"prop\" in c.bind ? bindProp(cell, c.bind.prop) : bindPropPath(cell, \"swims\", [c.bind.row, c.bind.field], \"string\");\n678:     pieces.push({ rect: { ...c.rect, importance: c.over ? 3 : 2 }, source });\n679:     constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n\n(Showing lines 400-679 of 709. Use offset=680 to continue.)\n</content>","metadata":{"preview":"    // split by what each needs, while both fit there at the full size; a long\n    // pair takes a line each rather than shrinking to share one.\n    const subTop = Math.round(lineH * 0.62);\n    const meetNeed = widthOf(p.meet, subTop), detailsNeed = widthOf(p.details, subTop);\n    const both = p.meet !== \"\" && p.details !== \"\";\n    const shared = both && Math.ceil((meetNeed + 2) / 0.94) + Math.ceil((detailsNeed + 2) / 0.94) + 2 * gap <= CW;\n    const detailsW = !both || !shared ? CW : Math.ceil((detailsNeed + 2) / 0.94) + 1, meetW = !both || !shared ? CW : CW - detailsW - 2 * gap;\n    const subPx = Math.min(...[[p.club, CW], [p.meet, meetW], [p.details, detailsW]].map(([t, w]) => (t === \"\" ? Infinity : fitPx(t as string, w as number, subTop, false))), subTop);\n    let y = m +