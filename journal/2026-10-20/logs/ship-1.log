{"type":"tool_use","timestamp":1792531097650,"sessionID":"ses_ea4d262f1ffeH3oB1ZEnAed0SK","part":{"type":"tool","tool":"read","callID":"call_00_m36ECob3vwYE7mZH2hXp8115","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\community\\geocache-milestone-card\\v1\\geocache-milestone-card.ts"},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\src\\community\\geocache-milestone-card\\v1\\geocache-milestone-card.ts</path>\n<type>file</type>\n<content>\n1: import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\n2: import { asTemplateId } from \"@m0saic/types\";\n3: import { toM0String } from \"@m0saic/dsl-stdlib\";\n4: import { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\n5: import type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\n6: import { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n7: import { budget, textCell, widthOf } from \"../../../_shared/text\";\n8: import { whyTutorial } from \"../../../_shared/why\";\n9: import type { WhySpec } from \"../../../_shared/why\";\n10: \n11: /**\n12:  * `@one-a-day/community/geocache-milestone-card/v1` - the \"I hit N finds\" card\n13:  * a geocacher posts on a milestone or a year-in-review, built from the numbers\n14:  * their own My Finds pocket-query GPX already contains (find count, the\n15:  * cache-type mix, FTFs, difficulty/terrain). One render per count, from numbers\n16:  * typed in, never fetched.\n17:  *\n18:  * ONE CONCEPT: the milestone is computed, never typed. The big number is the\n19:  * find count; the card derives the ordinal (\"1,000th\", \"1,042nd\") and whether\n20:  * that count is a Project-GC milestone, and shows the MILESTONE badge only\n21:  * when it is. Nobody hand-writes the thing the whole post is about, so the\n22:  * card cannot disagree with itself.\n23:  *\n24:  * The rule that bites: the card prints what was typed and the count it derives,\n25:  * nothing else. A misspelled cache type is refused by name (with a \"did you\n26:  * mean\" hint), a type-mix that sums to more finds than findCount is refused,\n27:  * and copy that cannot fit above the readability floor is refused naming the\n28:  * field - because a silently wrong number on a public card is worse than no\n29:  * card.\n30:  */\n31: \n32: export type TypeMixEntry = { type: string; count: number };\n33: \n34: export type GeocacheMilestoneCardProps = {\n35:   /** The cacher's handle, drawn in capitals in the header. */\n36:   cacherName?: string;\n37:   /** The find count, the hero number. Drives the derived ordinal and the milestone badge. */\n38:   findCount?: number;\n39:   /** First-to-find count, the FTF tile. */\n40:   ftfCount?: number;\n41:   /** Average difficulty, 1.0-5.0, printed to one decimal. */\n42:   avgD?: number;\n43:   /** Average terrain, 1.0-5.0, printed to one decimal. */\n44:   avgT?: number;\n45:   /** The \"caching since\" year, 2000-2026. */\n46:   sinceYear?: number;\n47:   /** The cache-type breakdown as a list of { type, count }; top 5 render, remainder is \"Other\". */\n48:   typeMix?: TypeMixEntry[];\n49:   /** The one accent, as #rrggbb: hero number, badge fill, header rule. */\n50:   accent?: string;\n51:   /** The bottom line; \"\" removes it and the space returns to the card. */\n52:   footer?: string;\n53:   /** Dev-only: check the layout contract and draw it over the card. */\n54:   debugLayout?: boolean;\n55: };\n56: \n57: const ID = \"@one-a-day/community/geocache-milestone-card/v1\";\n58: /** The page: document.backgroundColor, never a full-canvas rect (doctor: canvasFill). */\n59: const PAPER = \"#f6f4ee\";\n60: const INK = \"#1b1f1c\";\n61: /** Labels and captions: 7:1 on the light paper. */\n62: const DIM = \"#4f5651\";\n63: /** The stat tiles' neutral fill; neutral so it survives the 4:2:0 intermediate flat. */\n64: const TILE = \"#fbfbfb\";\n65: /** The mix bar's track - the \"Other\" grey that shows through where segments do not cover. */\n66: const TRACK = \"#d8d4ca\";\n67: const DEFAULT_ACCENT = \"#4a8f3c\";\n68: \n69: /** The fixed cache-type palette (bar segments use this, never the accent). */\n70: const TYPE_PALETTE: Record<string, string> = {\n71:   Traditional: \"#2e7d32\",\n72:   Multi: \"#1565c0\",\n73:   Mystery: \"#6a1b9a\",\n74:   Letterbox: \"#c62828\",\n75:   Earthcache: \"#ef6c00\",\n76:   Virtual: \"#00838f\",\n77:   Webcam: \"#5e35b1\",\n78:   Event: \"#f9a825\",\n79:   CITO: \"#558b2f\",\n80:   Wherigo: \"#ad1457\",\n81:   \"Adventure Lab\": \"#5d4037\",\n82: };\n83: /** Short legend names, so the one-line legend fits a narrow canvas. */\n84: const TYPE_SHORT: Record<string, string> = {\n85:   Traditional: \"Trad\",\n86:   Multi: \"Multi\",\n87:   Mystery: \"Mystery\",\n88:   Letterbox: \"Letterbox\",\n89:   Earthcache: \"Earthcache\",\n90:   Virtual: \"Virtual\",\n91:   Webcam: \"Webcam\",\n92:   Event: \"Event\",\n93:   CITO: \"CITO\",\n94:   Wherigo: \"Wherigo\",\n95:   \"Adventure Lab\": \"Adventure Lab\",\n96: };\n97: const TYPE_NAMES = Object.keys(TYPE_PALETTE);\n98: \n99: // The invented sample: geohiker55 is the handle a local club congratulated on\n100: // 1000 finds; the footer says the card is invented, like the neighbours.\n101: const DEFAULT_TYPE_MIX: TypeMixEntry[] = [\n102:   { type: \"Traditional\", count: 812 },\n103:   { type: \"Mystery\", count: 121 },\n104:   { type: \"Multi\", count: 38 },\n105:   { type: \"Letterbox\", count: 9 },\n106:   { type: \"Event\", count: 20 },\n107: ];\n108: const DEFAULTS = {\n109:   cacherName: \"geohiker55\",\n110:   findCount: 1000,\n111:   ftfCount: 24,\n112:   avgD: 2.3,\n113:   avgT: 1.8,\n114:   sinceYear: 2015,\n115:   typeMix: DEFAULT_TYPE_MIX,\n116:   accent: DEFAULT_ACCENT,\n117:   footer: \"Sample card: the geocacher and the numbers are invented\",\n118:   debugLayout: false,\n119: };\n120: \n121: const propsSchema = definePropsSchema<GeocacheMilestoneCardProps>({\n122:   cacherName: {\n123:     type: \"string\",\n124:     required: false,\n125:     description: \"The cacher's handle, drawn in capitals in the header. 1-40 characters of printable ASCII or accented Latin letters. A long name shrinks to fit; one that cannot fit above the readability floor is refused.\",\n126:     meta: { control: { placeholder: DEFAULTS.cacherName }, ui: { label: \"Cacher name\", order: 1, primary: true } },\n127:   },\n128:   findCount: {\n129:     type: \"number\",\n130:     required: false,\n131:     description: \"The find count, the hero number. A whole number 1-9999999. It drives the derived ordinal (1,000th, 1,042nd) and whether the MILESTONE badge shows (Project-GC milestones: 1, 10, 50, 100, then every hundred to 1000, every five hundred to 5000, then every thousand).\",\n132:     meta: { constraints: { min: 1, max: 9999999 }, control: { placeholder: String(DEFAULTS.findCount) }, ui: { label: \"Find count\", order: 2, primary: true } },\n133:   },\n134:   ftfCount: {\n135:     type: \"number\",\n136:     required: false,\n137:     description: \"The first-to-find count, the FTF tile. A whole number 0 to findCount.\",\n138:     meta: { constraints: { min: 0, max: 9999999 }, control: { placeholder: String(DEFAULTS.ftfCount) }, ui: { label: \"FTF count\", order: 3 } },\n139:   },\n140:   avgD: {\n141:     type: \"number\",\n142:     required: false,\n143:     description: \"The average difficulty, 1.0 to 5.0, printed to one decimal (2.3).\",\n144:     meta: { constraints: { min: 1, max: 5 }, control: { placeholder: String(DEFAULTS.avgD) }, ui: { label: \"Avg difficulty\", order: 4 } },\n145:   },\n146:   avgT: {\n147:     type: \"number\",\n148:     required: false,\n149:     description: \"The average terrain, 1.0 to 5.0, printed to one decimal (1.8).\",\n150:     meta: { constraints: { min: 1, max: 5 }, control: { placeholder: String(DEFAULTS.avgT) }, ui: { label: \"Avg terrain\", order: 5 } },\n151:   },\n152:   sinceYear: {\n153:     type: \"number\",\n154:     required: false,\n155:     description: 'The \"caching since\" year, 2000-2026, printed as \"caching since 2015\".',\n156:     meta: { constraints: { min: 2000, max: 2026 }, control: { placeholder: String(DEFAULTS.sinceYear) }, ui: { label: \"Caching since\", order: 6 } },\n157:   },\n158:   typeMix: {\n159:     type: \"json\",\n160:     required: false,\n161:     description: 'The cache-type breakdown as a list of {\"type\":\"<name>\",\"count\":<int>}. Recognized types: Traditional, Multi, Mystery, Letterbox, Earthcache, Virtual, Webcam, Event, CITO, Wherigo, Adventure Lab. An unknown type is refused by name (with a did-you-mean hint); counts are whole numbers >= 0. Only the top 5 by count render as bar segments; the remainder (findCount minus the shown) draws as a grey Other, so the bar always spans full width.',\n162:     meta: {\n163:       constraints: {\n164:         jsonSchema: {\n165:           type: \"array\",\n166:           maxItems: 11,\n167:           items: {\n168:             type: \"object\",\n169:             required: [\"type\", \"count\"],\n170:             additionalProperties: false,\n171:             properties: { type: { type: \"string\" }, count: { type: \"integer\", minimum: 0 } },\n172:           },\n173:         },\n174:       },\n175:       ui: { label: \"Cache-type mix\", order: 7, primary: true },\n176:     },\n177:   },\n178:   accent: {\n179:     type: \"string\",\n180:     required: false,\n181:     description: \"The one accent, as #rrggbb: the hero number, the MILESTONE badge fill and the header rule. An accent with less than 3:1 contrast on the paper (the large-text bar) keeps the badge but leaves the hero number in ink. Empty falls back to the default green.\",\n182:     meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 8 } },\n183:   },\n184:   footer: {\n185:     type: \"string\",\n186:     required: false,\n187:     description: \"The bottom line. One line of printable ASCII or accented Latin letters; a long one shrinks, and only a line that cannot fit above the floor is refused. Empty removes it and the space returns to the card.\",\n188:     meta: { control: { placeholder: \"none\" }, ui: { label: \"Footer\", order: 9 } },\n189:   },\n190:   debugLayout: {\n191:     type: \"boolean\",\n192:     required: false,\n193:     description: \"Dev-only: check the layout contract (every text fits its box, the name in the header band, the hero number and derived ordinal, the full-width mix bar, three equal stat tiles, the footer at the bottom) and draw it over the card.\",\n194:     meta: { ui: { label: \"Debug layout\", order: 99 } },\n195:   },\n196: });\n197: \n198: /* ── the count: pure, exported, and what the test asserts ── */\n199: \n200: function fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n201: \n202: /** Printable ASCII plus Latin-1 and Latin Extended-A letters: what the bundled font draws. */\n203: const DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\n204: \n205: /** 1204 -> \"1,204\": ASCII digits and a thousands comma, never \"1.2k\". Internal: the pack already exports a formatCount. */\n206: function formatCount(n: number): string {\n207:   return String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n208: }\n209: \n210: /** 1,000th / 1,042nd / 11th / 21st: thousands separators plus the English ordinal suffix. */\n211: export function ordinal(n: number): string {\n212:   const s = formatCount(n);\n213:   const mod100 = n % 100;\n214:   let suffix = \"th\";\n215:   if (mod100 < 11 || mod100 > 13) {\n216:     const d = n % 10;\n217:     if (d === 1) suffix = \"st\";\n218:     else if (d === 2) suffix = \"nd\";\n219:     else if (d === 3) suffix = \"rd\";\n220:   }\n221:   return `${s}${suffix}`;\n222: }\n223: \n224: /** Project-GC's milestone ladder: 1, 10, 50, 100; then every hundred to 1000, every five hundred to 5000, then every thousand. */\n225: export function isMilestone(n: number): boolean {\n226:   if (!Number.isInteger(n) || n < 1) return false;\n227:   if (n <= 100) return n === 1 || n === 10 || n === 50 || n === 100;\n228:   if (n <= 1000) return n % 100 === 0;\n229:   if (n <= 5000) return n % 500 === 0;\n230:   return n % 1000 === 0;\n231: }\n232: \n233: /** Edit distance, for \"did you mean\" on a misspelled type or prop. */\n234: function distance(a: string, b: string): number {\n235:   const d = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array<number>(b.length).fill(0)]);\n236:   for (let j = 1; j <= b.length; j++) d[0][j] = j;\n237:   for (let i = 1; i <= a.length; i++) for (let j = 1; j <= b.length; j++) d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));\n238:   return d[a.length][b.length];\n239: }\n240: \n241: function str(value: unknown, field: string): string {\n242:   if (typeof value !== \"string\") fail(field, \"must be a string.\");\n243:   return value.trim();\n244: }\n245: \n246: function drawn(value: unknown, field: string, max: number, allowEmpty: boolean): string {\n247:   const s = str(value, field);\n248:   if (!allowEmpty && s === \"\") fail(field, \"must not be empty.\");\n249:   const bad = [...s].find((ch) => !DRAWN.test(ch));\n250:   if (bad !== undefined) fail(field, `${JSON.stringify(s)} has the character ${JSON.stringify(bad)} (U+${bad.codePointAt(0)!.toString(16).toUpperCase().padStart(4, \"0\")}), which the card's font is not known to draw: use printable ASCII and accented Latin letters.`);\n251:   if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n252:   return s;\n253: }\n254: \n255: function luminance(hex: string): number {\n256:   const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n257:   return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n258: }\n259: function contrast(a: string, b: string): number {\n260:   const la = luminance(a), lb = luminance(b);\n261:   return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);\n262: }\n263: /** The readable ink on a filled badge: white or ink, whichever contrasts more. */\n264: function onColor(fill: string): MosaicColor {\n265:   return (contrast(fill, \"#ffffff\") >= contrast(fill, INK) ? \"#ffffff\" : INK) as MosaicColor;\n266: }\n267: \n268: export type MixBarEntry = { type: string; count: number; color: string };\n269: export type NormalizedMix = { top: MixBarEntry[]; other: number; legend: string };\n270: \n271: /** The typeMix list: recognized types only, whole counts, top 5 kept, remainder as Other. Throws naming the bad entry. */\n272: export function parseTypeMix(value: unknown, findCount: number): NormalizedMix {\n273:   // A json prop may arrive as the raw string its editor holds.\n274:   if (typeof value === \"string\") {\n275:     const raw = value;\n276:     try { value = JSON.parse(raw); } catch { fail(\"typeMix\", `is not valid JSON: ${JSON.stringify(raw.slice(0, 60))}.`); }\n277:   }\n278:   if (!Array.isArray(value)) fail(\"typeMix\", \"must be an array of { type, count } objects.\");\n279:   if (value.length > TYPE_NAMES.length) fail(\"typeMix\", `has ${value.length} entries; at most ${TYPE_NAMES.length} (one per recognized type).`);\n280:   const seen = new Set<string>();\n281:   const entries = value.map((e, i) => {\n282:     if (typeof e !== \"object\" || e === null || Array.isArray(e)) fail(\"typeMix\", `entry ${i} must be an object { type, count }.`);\n283:     const obj = e as Record<string, unknown>;\n284:     const type = typeof obj.type === \"string\" ? obj.type.trim() : \"\";\n285:     if (!TYPE_NAMES.includes(type)) {\n286:       const near = TYPE_NAMES.find((n) => distance(n.toLowerCase(), type.toLowerCase()) <= 2);\n287:       fail(\"typeMix\", `entry ${i} has an unknown type ${JSON.stringify(type)}${near ? `; did you mean '${near}'?` : `. Recognized types: ${TYPE_NAMES.join(\", \")}.`}`);\n288:     }\n289:     if (seen.has(type)) fail(\"typeMix\", `'${type}' appears twice; give each type one entry.`);\n290:     seen.add(type);\n291:     const count = obj.count;\n292:     if (typeof count !== \"number\" || !Number.isInteger(count) || count < 0) fail(\"typeMix\", `entry ${i} ('${type}') count must be a whole number >= 0, got ${JSON.stringify(count)}.`);\n293:     return { type, count };\n294:   });\n295:   // Top 5 by count, ties keep input order (stable, deterministic).\n296:   const top = entries\n297:     .map((e, i) => ({ ...e, i }))\n298:     .sort((a, b) => b.count - a.count || a.i - b.i)\n299:     .slice(0, 5)\n300:     .map(({ type, count }) => ({ type, count, color: TYPE_PALETTE[type] }));\n301:   const sum = top.reduce((a, b) => a + b.count, 0);\n302:   if (sum > findCount) fail(\"typeMix\", `the shown types count ${sum} finds, more than findCount ${findCount}.`);\n303:   const other = findCount - sum;\n304:   const legendParts = top.map((e) => `${TYPE_SHORT[e.type]} ${formatCount(e.count)}`);\n305:   if (other > 0) legendParts.push(`Other ${formatCount(other)}`);\n306:   return { top, other, legend: legendParts.join(\" / \") };\n307: }\n308: \n309: /** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n310: export function normalizeGeocacheMilestoneCard(props: GeocacheMilestoneCardProps) {\n311:   const known = Object.keys(DEFAULTS);\n312:   for (const k of Object.keys(props ?? {})) {\n313:     if (known.includes(k)) continue;\n314:     const near = known.find((n) => distance(n.toLowerCase(), k.toLowerCase()) <= 2);\n315:     fail(\"props\", `has an unknown prop '${k}'${near ? `; did you mean '${near}'?` : \".\"} The props are ${known.join(\", \")}.`);\n316:   }\n317:   const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) } as typeof DEFAULTS;\n318: \n319:   const nameRaw = drawn(p.cacherName, \"cacherName\", 40, false);\n320:   const name = nameRaw.toUpperCase();\n321:   if (!DRAWN.test(name)) fail(\"cacherName\", `${JSON.stringify(nameRaw)} has a letter whose capital the card's font is not known to draw.`);\n322: \n323:   if (typeof p.findCount !== \"number\" || !Number.isInteger(p.findCount) || p.findCount < 1 || p.findCount > 9999999) {\n324:     fail(\"findCount\", `must be a whole number from 1 to 9999999, got ${JSON.stringify(p.findCount)}.`);\n325:   }\n326:   if (typeof p.ftfCount !== \"number\" || !Number.isInteger(p.ftfCount) || p.ftfCount < 0 || p.ftfCount > p.findCount) {\n327:     fail(\"ftfCount\", `must be a whole number from 0 to findCount (${p.findCount}), got ${JSON.stringify(p.ftfCount)}.`);\n328:   }\n329:   const avg = (v: unknown, field: string) => {\n330:     if (typeof v !== \"number\" || !Number.isFinite(v) || v < 1 || v > 5) fail(field, `must be a number from 1.0 to 5.0, got ${JSON.stringify(v)}.`);\n331:     return v;\n332:   };\n333:   const avgD = avg(p.avgD, \"avgD\");\n334:   const avgT = avg(p.avgT, \"avgT\");\n335:   if (typeof p.sinceYear !== \"number\" || !Number.isInteger(p.sinceYear) || p.sinceYear < 2000 || p.sinceYear > 2026) {\n336:     fail(\"sinceYear\", `must be a whole year from 2000 to 2026, got ${JSON.stringify(p.sinceYear)}.`);\n337:   }\n338:   const mix = parseTypeMix(p.typeMix, p.findCount);\n339:   if (typeof p.accent !== \"string\") fail(\"accent\", \"must be a string.\");\n340:   const accentText = p.accent.trim() === \"\" ? DEFAULT_ACCENT : p.accent.trim();\n341:   if (!/^#[0-9a-fA-F]{6}$/.test(accentText)) fail(\"accent\", `${JSON.stringify(accentText)} must be #rrggbb.`);\n342:   const footer = drawn(p.footer, \"footer\", 120, true);\n343:   if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n344: \n345:   const accent = accentText.toLowerCase() as MosaicColor;\n346:   const milestone = isMilestone(p.findCount);\n347:   const ordinalText = ordinal(p.findCount);\n348:   return {\n349:     name,\n350:     findCount: p.findCount,\n351:     findText: formatCount(p.findCount),\n352:     ordinalText,\n353:     milestoneLine: `${ordinalText} find`,\n354:     milestone,\n355:     ftfText: formatCount(p.ftfCount),\n356:     avgDText: avgD.toFixed(1),\n357:     avgTText: avgT.toFixed(1),\n358:     sinceLine: `caching since ${p.sinceYear}`,\n359:     mix,\n360:     accent,\n361:     // The hero number is large bold text, so 3:1 (WCAG large-text) is the bar.\n362:     heroInk: (contrast(accent, PAPER) >= 3 ? accent : INK) as MosaicColor,\n363:     footer,\n364:     debugLayout: p.debugLayout,\n365:   };\n366: }\n367: \n368: /* ── geometry ── */\n369: \n370: export type GmcRect = { x: number; y: number; w: number; h: number };\n371: type Bind = \"cacherName\" | \"findCount\" | \"ftfCount\" | \"avgD\" | \"avgT\" | \"sinceYear\" | \"typeMix\" | \"accent\" | \"footer\" | null;\n372: type Cell = { label: string; rect: GmcRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\n373: type Tile = { label: string; rect: GmcRect; color: MosaicColor; radius: number; bind?: \"accent\" };\n374: \n375: /** The cell width a line needs at `px` under the fit rule (`cell * 0.94 - 2px`). */\n376: function need(text: string, px: number, bold: boolean): number {\n377:   return Math.ceil((widthOf(text, px, bold) + 2) / 0.94) + 1;\n378: }\n379: /** One line in a cell: the largest whole size up to `maxPx` that fits the cell's budget. */\n380: function fitPx(line: string, cellW: number, maxPx: number, bold: boolean): number {\n381:   const top = Math.max(1, Math.round(maxPx)), room = budget(cellW), w = widthOf(line, top, bold);\n382:   let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n383:   while (px > 1 && widthOf(line, px, bold) > room) px--;\n384:   return px;\n385: }\n386: /** The line box a size needs (the font's ascent + descent with a little air). */\n387: const lineH = (px: number) => Math.ceil(px * 1.22);\n388: \n389: const GEOCACHE_LABEL = \"GEOCACHING\";\n390: const MILESTONE_WORD = \"MILESTONE\";\n391: const TILE_DEFS = [\n392:   { key: \"ftf\", label: \"FTF\", value: (p: ReturnType<typeof normalizeGeocacheMilestoneCard>) => p.ftfText, bind: \"ftfCount\" as Bind },\n393:   { key: \"d\", label: \"AVG D\", value: (p: ReturnType<typeof normalizeGeocacheMilestoneCard>) => p.avgDText, bind: \"avgD\" as Bind },\n394:   { key: \"t\", label: \"AVG T\", value: (p: ReturnType<typeof normalizeGeocacheMilestoneCard>) => p.avgTText, bind: \"avgT\" as Bind },\n395: ];\n396: \n397: /** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\n398: export function layoutGeocacheMilestoneCard(props: GeocacheMilestoneCardProps, W: number, H: number) {\n399:   const p = normalizeGeocacheMilestoneCard(props);\n400:   const S = Math.min(W, H), aspect = W / H;\n401:   const shape: \"wide\" | \"square\" | \"tall\" = aspect >= 1.25 ? \"wide\" : aspect >= 0.8 ? \"square\" : \"tall\";\n402:   const floor = Math.max(6, Math.round(S * 0.022));\n403:   const small = Math.max(6, Math.round(S * 0.014));\n404:   const unfit = (field: string, min = floor): never => fail(field, `cannot be fitted on ${W}x${H} above the ${min}px readability floor: shorten it or render a larger canvas.`);\n405: \n406:   const m = Math.round(S * 0.045), CW = W - 2 * m;\n407:   const top = m, bottom = H - m, CH = H - 2 * m;\n408:   const gap = Math.max(2, Math.round(S * 0.022));\n409: \n410:   const cells: Cell[] = [];\n411:   const tiles: Tile[] = [];\n412:   let segmentCount = 0;\n413:   const line = (label: string, rect: GmcRect, text: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string; min?: number } = {}) => {\n414:     if (px < (o.min ?? floor)) unfit(o.field ?? label, o.min ?? floor);\n415:     cells.push({ label, rect, text, px, width: widthOf(text, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? (INK as MosaicColor), bind: o.bind ?? null, over: o.over === true });\n416:   };\n417: \n418:   // ── bands: footer sized by its line, the rest shared by weight ──\n419:   const footerDesign = Math.max(floor, Math.round(S * 0.026));\n420:   const footerPx = p.footer === \"\" ? 0 : Math.min(footerDesign, fitPx(p.footer, CW, footerDesign, false));\n421:   if (p.footer !== \"\" && footerPx < floor) unfit(\"footer\");\n422:   const footerH = p.footer === \"\" ? 0 : lineH(footerPx);\n423:   const weights = shape === \"wide\" ? [0.58, 0.22, 0.2] : [0.16, 0.42, 0.2, 0.22];\n424:   const bandCount = weights.length;\n425:   const footerGap = p.footer === \"\" ? 0 : gap;\n426:   const avail = CH - footerH - footerGap - (bandCount - 1) * gap;\n427:   const sumW = weights.reduce((a, b) => a + b, 0);\n428:   const hs = weights.map((w) => Math.floor((avail * w) / sumW));\n429:   hs[hs.length - 1] += avail - hs.reduce((a, b) => a + b, 0);\n430: \n431:   let y = top;\n432:   // Wide: header and hero side by side in the first band; square/tall: header then hero stacked.\n433:   const leftW = shape === \"wide\" ? Math.round(CW * 0.34) : CW;\n434:   const headRect: GmcRect = { x: m, y, w: leftW, h: hs[0] };\n435:   const heroRect: GmcRect = shape === \"wide\"\n436:     ? { x: m + leftW + gap, y, w: CW - leftW - gap, h: hs[0] }\n437:     : { x: m, y: top + hs[0] + gap, w: CW, h: hs[1] };\n438:   const mixY = shape === \"wide\" ? top + hs[0] + gap : top + hs[0] + gap + hs[1] + gap;\n439:   const mixRect: GmcRect = { x: m, y: mixY, w: CW, h: hs[shape === \"wide\" ? 1 : 2] };\n440:   const tilesRect: GmcRect = { x: m, y: mixRect.y + mixRect.h + gap, w: CW, h: hs[shape === \"wide\" ? 2 : 3] };\n441: \n442:   // ── header: the sport label, the name in capitals, the since line, the accent rule ──\n443:   const ruleH = Math.max(2, Math.round(S * 0.006));\n444:   const gapSm = Math.max(1, Math.round(headRect.h * 0.04));\n445:   const labelPx = Math.max(floor, Math.min(Math.round(headRect.h * 0.15), Math.round(S * 0.028)));\n446:   const sincePx = Math.max(floor, Math.min(Math.round(headRect.h * 0.13), Math.round(S * 0.024)));\n447:   const nameRoom = headRect.h - ruleH - lineH(labelPx) - lineH(sincePx) - 2 * gapSm;\n448:   const namePx = fitPx(p.name, headRect.w, nameRoom / 1.22, true);\n449:   if (namePx < floor) unfit(\"cacherName\");\n450:   {\n451:     const lx = headRect.x, ly = headRect.y;\n452:     line(\"geocache-label\", { x: lx, y: ly, w: need(GEOCACHE_LABEL, labelPx, true), h: lineH(labelPx) }, GEOCACHE_LABEL, labelPx, { bold: true, color: DIM as MosaicColor, field: \"the sport label\" });\n453:     line(\"cacher-name\", { x: lx, y: ly + lineH(labelPx) + gapSm, w: need(p.name, namePx, true), h: lineH(namePx) }, p.name, namePx, { bold: true, bind: \"cacherName\", field: \"cacherName\" });\n454:     line(\"caching-since\", { x: lx, y: ly + lineH(labelPx) + gapSm + lineH(namePx) + gapSm, w: need(p.sinceLine, sincePx, false), h: lineH(sincePx) }, p.sinceLine, sincePx, { color: DIM as MosaicColor, bind: \"sinceYear\", field: \"sinceYear\" });\n455:     tiles.push({ label: \"header-rule\", rect: { x: lx, y: headRect.y + headRect.h - ruleH, w: headRect.w, h: ruleH }, color: p.accent, radius: 0, bind: \"accent\" });\n456:   }\n457: \n458:   // ── hero: the find count, the derived ordinal line, the MILESTONE badge when it is one ──\n459:   let findPx = 0;\n460:   {\n461:     const heroGap = Math.max(2, Math.round(S * 0.012));\n462:     const linePx = Math.max(floor, Math.min(Math.round(heroRect.h * 0.16), Math.round(S * 0.03)));\n463:     const badgePx = Math.max(small, Math.min(Math.round(S * 0.016), Math.round(linePx * 0.7)));\n464:     const badgeSide = need(MILESTONE_WORD, badgePx, true);\n465:     const rowH = p.milestone ? Math.max(lineH(linePx), badgeSide) : lineH(linePx);\n466:     const findRoom = heroRect.h - rowH - heroGap;\n467:     findPx = Math.min(Math.round(S * 0.3), Math.floor(findRoom / 1.22), fitPx(p.findText, heroRect.w, Math.round(S * 0.3), true));\n468:     if (findPx < floor) unfit(\"findCount\");\n469:     line(\"find-count\", { x: heroRect.x, y: heroRect.y, w: need(p.findText, findPx, true), h: lineH(findPx) }, p.findText, findPx, { bold: true, color: p.heroInk, bind: \"findCount\", field: \"findCount\" });\n470:     const rowY = heroRect.y + lineH(findPx) + heroGap;\n471:     line(\"milestone-line\", { x: heroRect.x, y: rowY + Math.round((rowH - lineH(linePx)) / 2), w: need(p.milestoneLine, linePx, false), h: lineH(linePx) }, p.milestoneLine, linePx, { color: DIM as MosaicColor, field: \"the ordinal line\" });\n472:     if (p.milestone) {\n473:       const badge: GmcRect = { x: heroRect.x + need(p.milestoneLine, linePx, false) + gap, y: rowY, w: badgeSide, h: badgeSide };\n474:       tiles.push({ label: \"milestone-badge\", rect: badge, color: p.accent, radius: 0.16, bind: \"accent\" });\n475:       line(\"milestone-badge-text\", badge, MILESTONE_WORD, badgePx, { bold: true, align: \"center\", color: onColor(p.accent), over: true, field: \"the milestone badge\", min: small });\n476:     }\n477:   }\n478: \n479:   // ── mix: the full-width track, the top-5 segments over it, the legend line under ──\n480:   {\n481:     const barH = Math.max(2, Math.round(S * 0.02));\n482:     const barY = mixRect.y;\n483:     const track: GmcRect = { x: mixRect.x, y: barY, w: mixRect.w, h: barH };\n484:     // typeMix is a json list - it renders as a structured form, so the bar is not prop-bound.\n485:     tiles.push({ label: \"type-mix-bar\", rect: track, color: TRACK as MosaicColor, radius: 0 });\n486:     let segX = mixRect.x;\n487:     p.mix.top.forEach((e, i) => {\n488:       const isLast = i === p.mix.top.length - 1 && p.mix.other === 0;\n489:       const segW = isLast ? mixRect.x + mixRect.w - segX : Math.round((mixRect.w * e.count) / p.findCount);\n490:       if (segW > 0) {\n491:         tiles.push({ label: \"type-mix-segment\", rect: { x: segX, y: barY, w: segW, h: barH }, color: e.color as MosaicColor, radius: 0 });\n492:         segmentCount++;\n493:       }\n494:       segX += segW;\n495:     });\n496:     const legendPx = Math.max(floor, Math.min(Math.round(S * 0.024), fitPx(p.mix.legend, CW, Math.round(S * 0.024), false)));\n497:     if (legendPx < floor) unfit(\"the mix legend\");\n498:     line(\"mix-legend\", { x: mixRect.x, y: barY + barH + Math.max(2, Math.round(S * 0.006)), w: need(p.mix.legend, legendPx, false), h: lineH(legendPx) }, p.mix.legend, legendPx, { color: DIM as MosaicColor, field: \"the mix legend\" });\n499:   }\n500: \n501:   // ── tiles: three equal stat tiles (FTF, avg D, avg T) ──\n502:   {\n503:     const tileW = Math.floor((CW - 2 * gap) / 3);\n504:     const tileH = tilesRect.h;\n505:     const tilePad = Math.max(2, Math.round(Math.min(tileW, tileH) * 0.1));\n506:     const innerW = tileW - 2 * tilePad, innerH = tileH - 2 * tilePad;\n507:     const labelCap = Math.round(S * 0.03);\n508:     const labels = TILE_DEFS.map((d) => d.label);\n509:     const tileLabelPx = Math.min(labelCap, Math.floor((innerH * 0.3) / 1.22), ...labels.map((l) => fitPx(l, innerW, labelCap, false)));\n510:     if (tileLabelPx < floor) unfit(\"the tile labels\");\n511:     const gapT = Math.max(1, Math.round(tileLabelPx * 0.25));\n512:     const valueCap = Math.round(S * 0.14);\n513:     const tileValuePx = Math.min(valueCap, Math.floor((innerH - lineH(tileLabelPx) - gapT) / 1.22), ...TILE_DEFS.map((d) => fitPx(d.value(p), innerW, valueCap, true)));\n514:     if (tileValuePx < floor) unfit(\"the tile values\");\n515:     TILE_DEFS.forEach((d, i) => {\n516:       const tx = tilesRect.x + i * (tileW + gap);\n517:       const tile: GmcRect = { x: tx, y: tilesRect.y, w: tileW, h: tileH };\n518:       tiles.push({ label: \"stat-tile\", rect: tile, color: TILE as MosaicColor, radius: 0 });\n519:       const blockH = lineH(tileValuePx) + gapT + lineH(tileLabelPx);\n520:       const y0 = tile.y + Math.round((tile.h - blockH) / 2);\n521:       line(`tile-${d.key}-value`, { x: tile.x + tilePad, y: y0, w: innerW, h: lineH(tileValuePx) }, d.value(p), tileValuePx, { bold: true, align: \"center\", bind: d.bind, over: true, field: `the ${d.label} tile` });\n522:       line(`tile-${d.key}-label`, { x: tile.x + tilePad, y: y0 + lineH(tileValuePx) + gapT, w: innerW, h: lineH(tileLabelPx) }, d.label, tileLabelPx, { align: \"center\", color: DIM as MosaicColor, over: true, field: \"the tile labels\" });\n523:     });\n524:   }\n525: \n526:   // ── footer: one line at the bottom, shrunk alone to the floor ──\n527:   if (p.footer !== \"\") {\n528:     const fy = bottom - footerH;\n529:     line(\"footer\", { x: m, y: fy + Math.round((footerH - lineH(footerPx)) / 2), w: need(p.footer, footerPx, false), h: lineH(footerPx) }, p.footer, footerPx, { color: DIM as MosaicColor, bind: \"footer\", field: \"footer\" });\n530:   }\n531: \n532:   return { p, shape, floor, cells, tiles, headRect, heroRect, mixRect, tilesRect, findPx, namePx, badgeShown: p.milestone, segmentCount };\n533: }\n534: \n535: /**\n536:  * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n537:  * convention, src/_shared/why.ts): the run, the problem with the sources the\n538:  * agent opened, the solution, how to use it, then the template itself.\n539:  */\n540: const WHY: WhySpec = {\n541:   \"day\": 31,\n542:   \"date\": \"2026-10-20\",\n543:   \"agent\": \"opencode\",\n544:   \"model\": \"deepseek-v4-pro\",\n545:   \"id\": \"@one-a-day/community/geocache-milestone-card/v1\",\n546:   \"title\": \"Geocache Milestone Card\",\n547:   \"who\": \"Geocachers hitting a milestone or building a stats card, gathered on the Geocaching forums, Project-GC, and their local clubs\",\n548:   \"problem\": [\n549:     \"Every Premium member can download their My Finds pocket query: a zipped GPX of every cache they logged. Project-GC's Milestones tab gives the ladder: 'the first milestones are 1, 10, 50 and 100 caches, after that and up to 1000 caches every hundredth cache is considered a milestone'.\",\n550:     \"CacheSleuth reads the same GPX into a profile banner ('Upload your My Finds pocket query and see your geocaching statistics'), but the shareable 'I hit N finds' card is still hand-built; a local club just posts 'geohiker55 found his 1000th find yesterday'.\"\n551:   ],\n552:   \"sources\": [\n553:     \"https://www.cachesleuth.com/tools/profilestats\",\n554:     \"https://project-gc.com/w/Milestones_tab\",\n555:     \"https://www.geocaching.com/blog/2025/05/celebrating-25-years-of-geocaching-milestones\",\n556:     \"https://www.geocaching.com/help/index.php?id=118&pg=kb.page\",\n557:     \"https://www.yogosc.org/announcements/congratulations-to-geohiker55-on-1000-finds\"\n558:   ],\n559:   \"solution\": [\n560:     \"One card per count, from numbers typed in, never fetched. The props mirror the My Finds GPX fields: findCount, the cache-type mix, ftfCount, avgD, avgT, sinceYear. It draws the count as the hero, the type mix as a full-width bar, and three FTF / difficulty / terrain tiles.\",\n561:     \"The decision that matters: the milestone is computed, never typed. The card derives the ordinal (1,000th) and whether the count is a Project-GC milestone, and shows the MILESTONE badge only when it is. Nobody hand-writes the thing the whole post is about.\"\n562:   ],\n563:   \"usage\": {\n564:     \"command\": \"m0saic make @one-a-day/community/geocache-milestone-card/v1 --template-repo . -w 1080 -h 1080 --props @card.json -o card.png\",\n565:     \"try\": [\n566:       \"card.json: {\\\"cacherName\\\":\\\"GeoHiker\\\",\\\"findCount\\\":1042,\\\"typeMix\\\":[{\\\"type\\\":\\\"Traditional\\\",\\\"count\\\":900}]}\",\n567:       \"findCount 1042 prints 1,042nd with no badge; 1500 and 2000 print it (Project-GC milestones)\",\n568:       \"-w 1920 -h 1080 puts the header beside the hero; -h 1920 stacks the bands\",\n569:       \"footer \\\"\\\" removes the sample line; accent \\\"#b3261e\\\" recolours the hero and badge\"\n570:     ]\n571:   },\n572:   \"timeline\": {\n573:     \"source\": \"runner\",\n574:     \"phases\": [\n575:       {\n576:         \"name\": \"scout\",\n577:         \"startMs\": 0,\n578:         \"durMs\": 77498,\n579:         \"status\": \"error\"\n580:       },\n581:       {\n582:         \"name\": \"scout (2)\",\n583:         \"startMs\": 77532,\n584:         \"durMs\": 74463,\n585:         \"status\": \"error\"\n586:       },\n587:       {\n588:         \"name\": \"scout (3)\",\n589:         \"startMs\": 26271235,\n590:         \"durMs\": 147914,\n591:         \"calls\": 18,\n592:         \"tokens\": 576781,\n593:         \"costUsd\": 0.07,\n594:         \"tools\": \"bash 6, websearch 6, read 3\"\n595:       },\n596:       {\n597:         \"name\": \"plan\",\n598:         \"startMs\": 26419174,\n599:         \"durMs\": 121509,\n600:         \"calls\": 14,\n601:         \"tokens\": 480173,\n602:         \"costUsd\": 0.1,\n603:         \"tools\": \"read 12, write 2\"\n604:       }\n605:     ],\n606:     \"costBasis\": \"reported\"\n607:   },\n608:   \"caveats\": [\n609:     \"No importer: the numbers are retyped from the My Finds GPX (or a Project-GC screenshot); typeMix is JSON, not the GPX file.\",\n610:     \"Only the top five cache types render as segments; the rest and any unlisted finds fold into a grey Other remainder.\",\n611:     \"The Project-GC milestone ladder is hard-coded (1, 10, 50, 100, then hundreds to 1000, five-hundreds to 5000, thousands after).\"\n612:   ]\n613: };\n614: \n615: export const GeocacheMilestoneCardV1 = defineMosaicTemplate<GeocacheMilestoneCardProps>({\n616:   id: asTemplateId(ID),\n617:   label: \"2026-10-20 · Geocache Milestone Card\",\n618:   version: 1,\n619:   description: \"A geocaching milestone card for one find count: the count as the hero, the Project-GC milestone and ordinal derived from it (never typed), the cache-type mix as a full-width bar, and FTF / difficulty / terrain tiles. Numbers typed in, never fetched.\",\n620:   capabilities: { tier: \"core\" },\n621:   tags: [\"community\", \"2026-10-20\", \"day-031\", \"geocaching\", \"milestone\", \"gpx\", \"stats\", \"ftf\", \"share-card\"],\n622: \n623:   outputHints: {\n624:     width: 1080,\n625:     height: 1080,\n626:     fps: 30,\n627:     durationMs: 2000,\n628:     format: { kind: \"image\", container: \"png\" },\n629:     note: \"Still PNG, one card per count. 1080x1080 for the feed; 1920x1080 puts the header beside the hero, 1080x1920 stacks the four bands. Minimum tested canvas 480x270.\",\n630:   },\n631: \n632:   propsSchema,\n633:   defaultProps: DEFAULTS,\n634: \n635:   render,\n636:   renderTutorial: whyTutorial(WHY, render),\n637: });\n638: \n639: export default GeocacheMilestoneCardV1;\n640: \n641: async function render(props: GeocacheMilestoneCardProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n642:   const { width: W, height: H } = ctx.target;\n643:   const L = layoutGeocacheMilestoneCard(props, W, H);\n644:   const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n645:   const constraints: LayoutConstraint[] = [];\n646: \n647:   for (const t of L.tiles) {\n648:     const tile = tag({ ...makeColorTile(t.color, t.radius > 0 ? { effects: { rounding: { cornerStyle: \"rounded\", borderRadius: t.radius } } } : {}) } as MosaicSource, t.label);\n649:     // The mix track shows typeMix; the header rule and badge show accent.\n650:     pieces.push({ rect: { ...t.rect, importance: 1 }, source: t.bind ? bindProp(tile, t.bind) : tile });\n651:   }\n652:   for (const c of L.cells) {\n653:     const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n654:     // A text rect is BOUND to the prop it shows; derived copy (the ordinal, the labels, the legend) is not.\n655:     pieces.push({ rect: { ...c.rect, importance: c.over ? 3 : 2 }, source: c.bind === null ? cell : bindProp(cell, c.bind) });\n656:     constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n657:   }\n658: \n659:   // What the geometry promises: every text fits (above); the name in the top\n660:   // band; the hero number present; the derived ordinal under it; the mix bar\n661:   // full-width; three equal stat tiles; the footer at the bottom; a square\n662:   // badge when the count is a milestone.\n663:   constraints.push({ label: \"cacher-name\", within: { yFrac: [0, 0.24] } });\n664:   constraints.push({ label: \"find-count\" });\n665:   constraints.push({ label: \"milestone-line\", within: { yFrac: [0.15, 0.6] } });\n666:   constraints.push({ label: \"type-mix-bar\", minWidthFrac: 0.9, within: { yFrac: [0.3, 0.78] } });\n667:   if (L.segmentCount > 0) constraints.push({ label: \"type-mix-segment\" });\n668:   if (L.cells.some((c) => c.label === \"footer\")) constraints.push({ label: \"footer\", within: { yFrac: [0.86, 1] } });\n669:   if (L.badgeShown) constraints.push({ label: \"milestone-badge\", aspect: 1, aspectTolerance: 0.08 });\n670: \n671:   const relations: RelationalConstraint[] = [{ label: \"stat-tile\", equal: \"size\", tolerancePx: 2 }];\n672: \n673:   const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n674:   const doc: MosaicDocument = {\n675:     kind: \"mosaic_document\",\n676:     version: 1,\n677:     m0: toM0String(placed.m0, ID),\n678:     assets: {},\n679:     backgroundColor: PAPER as MosaicColor,\n680:     sources: placed.sources,\n681:   };\n682:   return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: props.debugLayout === true });\n683: }\n\n(End of file - total 683 lines)\n</content>","metadata":{"preview":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/community/geocache-milestone-card/v1` - the \"I hit N finds\" card\n * a geocacher posts on a milestone or a year-in-review, built from the numbers\n * their own My Finds pocket-query GPX already contains (find count, the\n * cache-type mix, FTFs, difficulty/terrain). One render per count, from numbers\n * typed in, never fetched.\n *\n * ONE CONCEPT: the milestone is computed, never typed. The big number is the\n * find count; the card derives the ordinal (\"1,000th\", \"1,042nd\") and whether\n * that count is a Project-GC milestone, and shows the MILESTONE badge only","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\src\\community\\geocache-milestone-card\\v1\\geocache-milestone-card.ts","text":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/community/geocache-milestone-card/v1` - the \"I hit N finds\" card\n * a geocacher posts on a milestone or a year-in-review, built from the numbers\n * their own My Finds pocket-query GPX already contains (find count, the\n * cache-type mix, FTFs, difficulty/terrain). One render per count, from numbers\n * typed in, never fetched.\n *\n * ONE CONCEPT: the milestone is computed, never typed. The big number is the\n * find count; the card derives the ordinal (\"1,000th\", \"1,042nd\") and whether\n * that count is a Project-GC milestone, and shows the MILESTONE badge only\n * when it is. Nobody hand-writes the thing the whole post is about, so the\n * card cannot disagree with itself.\n *\n * The rule that bites: the card prints what was typed and the count it derives,\n * nothing else. A misspelled cache type is refused by name (with a \"did you\n * mean\" hint), a type-mix that sums to more finds than findCount is refused,\n * and copy that cannot fit above the readability floor is refused naming the\n * field - because a silently wrong number on a public card is worse than no\n * card.\n */\n\nexport type TypeMixEntry = { type: string; count: number };\n\nexport type GeocacheMilestoneCardProps = {\n  /** The cacher's handle, drawn in capitals in the header. */\n  cacherName?: string;\n  /** The find count, the hero number. Drives the derived ordinal and the milestone badge. */\n  findCount?: number;\n  /** First-to-find count, the FTF tile. */\n  ftfCount?: number;\n  /** Average difficulty, 1.0-5.0, printed to one decimal. */\n  avgD?: number;\n  /** Average terrain, 1.0-5.0, printed to one decimal. */\n  avgT?: number;\n  /** The \"caching since\" year, 2000-2026. */\n  sinceYear?: number;\n  /** The cache-type breakdown as a list of { type, count }; top 5 render, remainder is \"Other\". */\n  typeMix?: TypeMixEntry[];\n  /** The one accent, as #rrggbb: hero number, badge fill, header rule. */\n  accent?: string;\n  /** The bottom line; \"\" removes it and the space returns to the card. */\n  footer?: string;\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/community/geocache-milestone-card/v1\";\n/** The page: document.backgroundColor, never a full-canvas rect (doctor: canvasFill). */\nconst PAPER = \"#f6f4ee\";\nconst INK = \"#1b1f1c\";\n/** Labels and captions: 7:1 on the light paper. */\nconst DIM = \"#4f5651\";\n/** The stat tiles' neutral fill; neutral so it survives the 4:2:0 intermediate flat. */\nconst TILE = \"#fbfbfb\";\n/** The mix bar's track - the \"Other\" grey that shows through where segments do not cover. */\nconst TRACK = \"#d8d4ca\";\nconst DEFAULT_ACCENT = \"#4a8f3c\";\n\n/** The fixed cache-type palette (bar segments use this, never the accent). */\nconst TYPE_PALETTE: Record<string, string> = {\n  Traditional: \"#2e7d32\",\n  Multi: \"#1565c0\",\n  Mystery: \"#6a1b9a\",\n  Letterbox: \"#c62828\",\n  Earthcache: \"#ef6c00\",\n  Virtual: \"#00838f\",\n  Webcam: \"#5e35b1\",\n  Event: \"#f9a825\",\n  CITO: \"#558b2f\",\n  Wherigo: \"#ad1457\",\n  \"Adventure Lab\": \"#5d4037\",\n};\n/** Short legend names, so the one-line legend fits a narrow canvas. */\nconst TYPE_SHORT: Record<string, string> = {\n  Traditional: \"Trad\",\n  Multi: \"Multi\",\n  Mystery: \"Mystery\",\n  Letterbox: \"Letterbox\",\n  Earthcache: \"Earthcache\",\n  Virtual: \"Virtual\",\n  Webcam: \"Webcam\",\n  Event: \"Event\",\n  CITO: \"CITO\",\n  Wherigo: \"Wherigo\",\n  \"Adventure Lab\": \"Adventure Lab\",\n};\nconst TYPE_NAMES = Object.keys(TYPE_PALETTE);\n\n// The invented sample: geohiker55 is the handle a local club congratulated on\n// 1000 finds; the footer says the card is invented, like the neighbours.\nconst DEFAULT_TYPE_MIX: TypeMixEntry[] = [\n  { type: \"Traditional\", count: 812 },\n  { type: \"Mystery\", count: 121 },\n  { type: \"Multi\", count: 38 },\n  { type: \"Letterbox\", count: 9 },\n  { type: \"Event\", count: 20 },\n];\nconst DEFAULTS = {\n  cacherName: \"geohiker55\",\n  findCount: 1000,\n  ftfCount: 24,\n  avgD: 2.3,\n  avgT: 1.8,\n  sinceYear: 2015,\n  typeMix: DEFAULT_TYPE_MIX,\n  accent: DEFAULT_ACCENT,\n  footer: \"Sample card: the geocacher and the numbers are invented\",\n  debugLayout: false,\n};\n\nconst propsSchema = definePropsSchema<GeocacheMilestoneCardProps>({\n  cacherName: {\n    type: \"string\",\n    required: false,\n    description: \"The cacher's handle, drawn in capitals in the header. 1-40 characters of printable ASCII or accented Latin letters. A long name shrinks to fit; one that cannot fit above the readability floor is refused.\",\n    meta: { control: { placeholder: DEFAULTS.cacherName }, ui: { label: \"Cacher name\", order: 1, primary: true } },\n  },\n  findCount: {\n    type: \"number\",\n    required: false,\n    description: \"The find count, the hero number. A whole number 1-9999999. It drives the derived ordinal (1,000th, 1,042nd) and whether the MILESTONE badge shows (Project-GC milestones: 1, 10, 50, 100, then every hundred to 1000, every five hundred to 5000, then every thousand).\",\n    meta: { constraints: { min: 1, max: 9999999 }, control: { placeholder: String(DEFAULTS.findCount) }, ui: { label: \"Find count\", order: 2, primary: true } },\n  },\n  ftfCount: {\n    type: \"number\",\n    required: false,\n    description: \"The first-to-find count, the FTF tile. A whole number 0 to findCount.\",\n    meta: { constraints: { min: 0, max: 9999999 }, control: { placeholder: String(DEFAULTS.ftfCount) }, ui: { label: \"FTF count\", order: 3 } },\n  },\n  avgD: {\n    type: \"number\",\n    required: false,\n    description: \"The average difficulty, 1.0 to 5.0, printed to one decimal (2.3).\",\n    meta: { constraints: { min: 1, max: 5 }, control: { placeholder: String(DEFAULTS.avgD) }, ui: { label: \"Avg difficulty\", order: 4 } },\n  },\n  avgT: {\n    type: \"number\",\n    required: false,\n    description: \"The average terrain, 1.0 to 5.0, printed to one decimal (1.8).\",\n    meta: { constraints: { min: 1, max: 5 }, control: { placeholder: String(DEFAULTS.avgT) }, ui: { label: \"Avg terrain\", order: 5 } },\n  },\n  sinceYear: {\n    type: \"number\",\n    required: false,\n    description: 'The \"caching since\" year, 2000-2026, printed as \"caching since 2015\".',\n    meta: { constraints: { min: 2000, max: 2026 }, control: { placeholder: String(DEFAULTS.sinceYear) }, ui: { label: \"Caching since\", order: 6 } },\n  },\n  typeMix: {\n    type: \"json\",\n    required: false,\n    description: 'The cache-type breakdown as a list of {\"type\":\"<name>\",\"count\":<int>}. Recognized types: Traditional, Multi, Mystery, Letterbox, Earthcache, Virtual, Webcam, Event, CITO, Wherigo, Adventure Lab. An unknown type is refused by name (with a did-you-mean hint); counts are whole numbers >= 0. Only the top 5 by count render as bar segments; the remainder (findCount minus the shown) draws as a grey Other, so the bar always spans full width.',\n    meta: {\n      constraints: {\n        jsonSchema: {\n          type: \"array\",\n          maxItems: 11,\n          items: {\n            type: \"object\",\n            required: [\"type\", \"count\"],\n            additionalProperties: false,\n            properties: { type: { type: \"string\" }, count: { type: \"integer\", minimum: 0 } },\n          },\n        },\n      },\n      ui: { label: \"Cache-type mix\", order: 7, primary: true },\n    },\n  },\n  accent: {\n    type: \"string\",\n    required: false,\n    description: \"The one accent, as #rrggbb: the hero number, the MILESTONE badge fill and the header rule. An accent with less than 3:1 contrast on the paper (the large-text bar) keeps the badge but leaves the hero number in ink. Empty falls back to the default green.\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 8 } },\n  },\n  footer: {\n    type: \"string\",\n    required: false,\n    description: \"The bottom line. One line of printable ASCII or accented Latin letters; a long one shrinks, and only a line that cannot fit above the floor is refused. Empty removes it and the space returns to the card.\",\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"Footer\", order: 9 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits its box, the name in the header band, the hero number and derived ordinal, the full-width mix bar, three equal stat tiles, the footer at the bottom) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n/* ── the count: pure, exported, and what the test asserts ── */\n\nfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n\n/** Printable ASCII plus Latin-1 and Latin Extended-A letters: what the bundled font draws. */\nconst DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\n\n/** 1204 -> \"1,204\": ASCII digits and a thousands comma, never \"1.2k\". Internal: the pack already exports a formatCount. */\nfunction formatCount(n: number): string {\n  return String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n}\n\n/** 1,000th / 1,042nd / 11th / 21st: thousands separators plus the English ordinal suffix. */\nexport function ordinal(n: number): string {\n  const s = formatCount(n);\n  const mod100 = n % 100;\n  let suffix = \"th\";\n  if (mod100 < 11 || mod100 > 13) {\n    const d = n % 10;\n    if (d === 1) suffix = \"st\";\n    else if (d === 2) suffix = \"nd\";\n    else if (d === 3) suffix = \"rd\";\n  }\n  return `${s}${suffix}`;\n}\n\n/** Project-GC's milestone ladder: 1, 10, 50, 100; then every hundred to 1000, every five hundred to 5000, then every thousand. */\nexport function isMilestone(n: number): boolean {\n  if (!Number.isInteger(n) || n < 1) return false;\n  if (n <= 100) return n === 1 || n === 10 || n === 50 || n === 100;\n  if (n <= 1000) return n % 100 === 0;\n  if (n <= 5000) return n % 500 === 0;\n  return n % 1000 === 0;\n}\n\n/** Edit distance, for \"did you mean\" on a misspelled type or prop. */\nfunction distance(a: string, b: string): number {\n  const d = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array<number>(b.length).fill(0)]);\n  for (let j = 1; j <= b.length; j++) d[0][j] = j;\n  for (let i = 1; i <= a.length; i++) for (let j = 1; j <= b.length; j++) d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));\n  return d[a.length][b.length];\n}\n\nfunction str(value: unknown, field: string): string {\n  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n  return value.trim();\n}\n\nfunction drawn(value: unknown, field: string, max: number, allowEmpty: boolean): string {\n  const s = str(value, field);\n  if (!allowEmpty && s === \"\") fail(field, \"must not be empty.\");\n  const bad = [...s].find((ch) => !DRAWN.test(ch));\n  if (bad !== undefined) fail(field, `${JSON.stringify(s)} has the character ${JSON.stringify(bad)} (U+${bad.codePointAt(0)!.toString(16).toUpperCase().padStart(4, \"0\")}), which the card's font is not known to draw: use printable ASCII and accented Latin letters.`);\n  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n  return s;\n}\n\nfunction luminance(hex: string): number {\n  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n}\nfunction contrast(a: string, b: string): number {\n  const la = luminance(a), lb = luminance(b);\n  return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);\n}\n/** The readable ink on a filled badge: white or ink, whichever contrasts more. */\nfunction onColor(fill: string): MosaicColor {\n  return (contrast(fill, \"#ffffff\") >= contrast(fill, INK) ? \"#ffffff\" : INK) as MosaicColor;\n}\n\nexport type MixBarEntry = { type: string; count: number; color: string };\nexport type NormalizedMix = { top: MixBarEntry[]; other: number; legend: string };\n\n/** The typeMix list: recognized types only, whole counts, top 5 kept, remainder as Other. Throws naming the bad entry. */\nexport function parseTypeMix(value: unknown, findCount: number): NormalizedMix {\n  // A json prop may arrive as the raw string its editor holds.\n  if (typeof value === \"string\") {\n    const raw = value;\n    try { value = JSON.parse(raw); } catch { fail(\"typeMix\", `is not valid JSON: ${JSON.stringify(raw.slice(0, 60))}.`); }\n  }\n  if (!Array.isArray(value)) fail(\"typeMix\", \"must be an array of { type, count } objects.\");\n  if (value.length > TYPE_NAMES.length) fail(\"typeMix\", `has ${value.length} entries; at most ${TYPE_NAMES.length} (one per recognized type).`);\n  const seen = new Set<string>();\n  const entries = value.map((e, i) => {\n    if (typeof e !== \"object\" || e === null || Array.isArray(e)) fail(\"typeMix\", `entry ${i} must be an object { type, count }.`);\n    const obj = e as Record<string, unknown>;\n    const type = typeof obj.type === \"string\" ? obj.type.trim() : \"\";\n    if (!TYPE_NAMES.includes(type)) {\n      const near = TYPE_NAMES.find((n) => distance(n.toLowerCase(), type.toLowerCase()) <= 2);\n      fail(\"typeMix\", `entry ${i} has an unknown type ${JSON.stringify(type)}${near ? `; did you mean '${near}'?` : `. Recognized types: ${TYPE_NAMES.join(\", \")}.`}`);\n    }\n    if (seen.has(type)) fail(\"typeMix\", `'${type}' appears twice; give each type one entry.`);\n    seen.add(type);\n    const count = obj.count;\n    if (typeof count !== \"number\" || !Number.isInteger(count) || count < 0) fail(\"typeMix\", `entry ${i} ('${type}') count must be a whole number >= 0, got ${JSON.stringify(count)}.`);\n    return { type, count };\n  });\n  // Top 5 by count, ties keep input order (stable, deterministic).\n  const top = entries\n    .map((e, i) => ({ ...e, i }))\n    .sort((a, b) => b.count - a.count || a.i - b.i)\n    .slice(0, 5)\n    .map(({ type, count }) => ({ type, count, color: TYPE_PALETTE[type] }));\n  const sum = top.reduce((a, b) => a + b.count, 0);\n  if (sum > findCount) fail(\"typeMix\", `the shown types count ${sum} finds, more than findCount ${findCount}.`);\n  const other = findCount - sum;\n  const legendParts = top.map((e) => `${TYPE_SHORT[e.type]} ${formatCount(e.count)}`);\n  if (other > 0) legendParts.push(`Other ${formatCount(other)}`);\n  return { top, other, legend: legendParts.join(\" / \") };\n}\n\n/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\nexport function normalizeGeocacheMilestoneCard(props: GeocacheMilestoneCardProps) {\n  const known = Object.keys(DEFAULTS);\n  for (const k of Object.keys(props ?? {})) {\n    if (known.includes(k)) continue;\n    const near = known.find((n) => distance(n.toLowerCase(), k.toLowerCase()) <= 2);\n    fail(\"props\", `has an unknown prop '${k}'${near ? `; did you mean '${near}'?` : \".\"} The props are ${known.join(\", \")}.`);\n  }\n  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) } as typeof DEFAULTS;\n\n  const nameRaw = drawn(p.cacherName, \"cacherName\", 40, false);\n  const name = nameRaw.toUpperCase();\n  if (!DRAWN.test(name)) fail(\"cacherName\", `${JSON.stringify(nameRaw)} has a letter whose capital the card's font is not known to draw.`);\n\n  if (typeof p.findCount !== \"number\" || !Number.isInteger(p.findCount) || p.findCount < 1 || p.findCount > 9999999) {\n    fail(\"findCount\", `must be a whole number from 1 to 9999999, got ${JSON.stringify(p.findCount)}.`);\n  }\n  if (typeof p.ftfCount !== \"number\" || !Number.isInteger(p.ftfCount) || p.ftfCount < 0 || p.ftfCount > p.findCoun