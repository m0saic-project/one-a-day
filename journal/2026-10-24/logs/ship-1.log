.behind !== \"\") {\n539:     line(\"behind\", hd.behindRect, p.behind, hd.behindPx, { color: dim, align: \"right\", bind: { kind: \"prop\", key: \"behind\" }, field: \"behind\", floorAt: small });\n540:   }\n541: \n542:   // ---- body: one row per leg, tape length = split / slowest ----\n543:   const rowH = Math.floor((bodyBottom - bodyTop) / p.legs.length);\n544:   if (rowH < 8) unfit(\"the leg rows\");\n545:   const rowsEnd = bodyTop + rowH * p.legs.length;\n546: \n547:   const idxW = Math.max(Math.round(CW * 0.05), Math.round(S * 0.035));\n548:   const tapeW = Math.round(CW * 0.36);\n549:   if (tapeW / W < 0.32) unfit(\"the tape\");\n550:   const remaining = CW - idxW - tapeW - 3 * gap;\n551:   if (remaining < Math.round(CW * 0.14)) unfit(\"the split and loss columns\");\n552:   const splitColW = Math.round(remaining * 0.5);\n553:   const lossColW = remaining - splitColW;\n554:   let cx = m;\n555:   const take = (w: number) => { const r = { x: cx, w }; cx += w + gap; return r; };\n556:   const cCtrl = take(idxW);\n557:   const cTape = take(tapeW);\n558:   const cSplit = take(splitColW);\n559:   const cLoss = take(lossColW);\n560: \n561:   const rowCap = hd.heroPx - 1;\n562:   const rowHeightCap = Math.floor((rowH - 2) / 1.25);\n563:   const longestControl = p.legs.reduce((s, l) => (l.control.length >= s.length ? l.control : s), \"100\");\n564:   const longestSplit = p.legs.reduce((s, l) => (l.split.length >= s.length ? l.split : s), \"4:08\");\n565:   const mistakeLosses = p.legs.filter((l) => l.isMistake).map((l) => `+${l.loss}`);\n566:   let rowPx = Math.min(rowCap, rowHeightCap);\n567:   rowPx = Math.min(\n568:     rowPx,\n569:     fitPx(longestControl, cCtrl.w, rowPx),\n570:     fitPx(longestSplit, cSplit.w, rowPx, true),\n571:     ...(mistakeLosses.length > 0 ? [fitPx(mistakeLosses.reduce((s, t) => (t.length >= s.length ? t : s), \"+0:00\"), cLoss.w, rowPx)] : []),\n572:   );\n573:   if (rowPx < floor) unfit(\"the leg rows\");\n574: \n575:   const barH = Math.max(4, Math.min(rowH - 4, Math.round(Math.min(rowH * 0.42, S * 0.04))));\n576:   const railColor = mix(theme.bg, theme.ink, 0.14);\n577:   const barColor = mix(theme.bg, theme.ink, p.preset === \"dark\" ? 0.5 : 0.45);\n578:   const textH = Math.round(rowPx * 1.25);\n579:   const textYOff = Math.round((rowH - textH) / 2);\n580: \n581:   const bands: SplitRect[] = [];\n582:   p.legs.forEach((leg, i) => {\n583:     const band: SplitRect = { x: m, y: bodyTop + i * rowH, w: CW, h: rowH };\n584:     bands.push(band);\n585:     const wash = mix(theme.bg, theme.ink, i % 2 === 0 ? 0.035 : 0.07);\n586:     tiles.push({ label: `band-${i}`, rect: band, color: wash, radius: 0, layer: 0 });\n587:     const rail: SplitRect = { x: cTape.x, y: band.y + Math.round((rowH - barH) / 2), w: cTape.w, h: barH };\n588:     tiles.push({ label: `rail-${i}`, rect: rail, color: railColor, radius: 0, layer: 2 });\n589:     const barW = Math.max(1, Math.round(rail.w * leg.splitSec / p.slowestSec));\n590:     const bar: SplitRect = { x: rail.x, y: rail.y, w: barW, h: rail.h };\n591:     tiles.push({ label: `bar-${i}`, rect: bar, color: leg.isMistake ? p.accent : barColor, radius: 0, layer: 3, accent: leg.isMistake });\n592:     const ty = band.y + textYOff;\n593:     line(`ctrl-${i}`, { x: cCtrl.x, y: ty, w: cCtrl.w, h: textH }, leg.control, rowPx, { color: dim, align: \"right\", bind: { kind: \"path\", path: [i, \"control\"], valueKind: \"string\" }, floorAt: small });\n594:     line(`split-${i}`, { x: cSplit.x, y: ty, w: cSplit.w, h: textH }, leg.split, rowPx, { bold: true, align: \"right\", bind: { kind: \"path\", path: [i, \"split\"], valueKind: \"string\" } });\n595:     if (leg.isMistake) {\n596:       line(`loss-${i}`, { x: cLoss.x, y: ty, w: cLoss.w, h: textH }, `+${leg.loss}`, rowPx, { color: p.accent, align: \"right\", bind: { kind: \"path\", path: [i, \"loss\"], valueKind: \"string\" } });\n597:     }\n598:   });\n599: \n600:   // ---- footer: three computed cells ----\n601:   const footLabelPx0 = Math.min(hd.heroPx - 2, Math.round(S * 0.02));\n602:   const footValuePx0 = Math.min(hd.heroPx - 1, Math.round(S * 0.042));\n603:   const cellW = Math.floor(CW / 3);\n604:   const footLabels = [\"TIME W/O MISTAKES\", \"TOTAL LOSS\", \"BEST LEG\"] as const;\n605:   const footValues = [p.timeWoText, p.totalLossText, p.bestText];\n606:   let footLabelPx = footLabels.reduce((px, t) => Math.min(px, fitPx(t, cellW, footLabelPx0)), footLabelPx0);\n607:   let footValuePx = footValues.reduce((px, t) => Math.min(px, fitPx(t, cellW, footValuePx0, true)), footValuePx0);\n608:   if (footLabelPx < small) unfit(\"the footer labels\");\n609:   if (footValuePx < floor) unfit(\"the footer values\");\n610:   if (footValuePx >= hd.heroPx) footValuePx = hd.heroPx - 1;\n611:   if (footLabelPx >= hd.heroPx) footLabelPx = Math.max(small, hd.heroPx - 2);\n612:   const footLabelH = Math.round(footLabelPx * 1.3);\n613:   const footValueH = Math.round(footValuePx * 1.2);\n614:   const footGap = Math.max(2, Math.round(gap * 0.45));\n615:   const footBlock = footLabelH + footGap + footValueH;\n616:   let footTop = Math.max(footerTop, rowsEnd + gap);\n617:   if (footTop + footBlock > H - m) {\n618:     footTop = Math.max(footerTop, H - m - footBlock);\n619:   }\n620:   if (footTop + footBlock > H - Math.max(4, Math.round(m * 0.4))) unfit(\"the footer\");\n621: \n622:   const footKeys = [\"time-wo\", \"total-loss\", \"best-leg\"] as const;\n623:   for (let i = 0; i < 3; i++) {\n624:     const x = m + i * cellW;\n625:     const cell: SplitRect = { x, y: footTop, w: cellW, h: footBlock };\n626:     tiles.push({ label: `foot-${i}`, rect: cell, color: mix(theme.bg, theme.ink, 0.04), radius: 0, layer: 0 });\n627:     line(`foot-label-${i}`, { x, y: footTop, w: cellW, h: footLabelH }, footLabels[i], footLabelPx, { color: dim, align: \"center\", floorAt: small });\n628:     line(footKeys[i], { x, y: footTop + footLabelH + footGap, w: cellW, h: footValueH }, footValues[i], footValuePx, { bold: true, align: \"center\" });\n629:   }\n630:   tiles.push({ label: \"rule-foot\", rect: { x: m, y: Math.max(rowsEnd, footTop - gap) + Math.max(0, Math.round((Math.min(gap, footTop - rowsEnd) - 2) / 2)), w: CW, h: 2 }, color: railColor, radius: 0, layer: 1 });\n631: \n632:   return {\n633:     p, theme, cells, tiles, bands, m, floor, small, heroPx: hd.heroPx, rowPx, barH,\n634:     tape: cTape, rowH, rowsTop: bodyTop, rowsEnd, footTop, headerBottom, bodyTop, bodyBottom, footerTop,\n635:   };\n636: }\n637: \n638: const WHY: WhySpec = {\n639:   \"day\": 35,\n640:   \"date\": \"2026-10-24\",\n641:   \"agent\": \"opencode\",\n642:   \"model\": \"deepseek-v4-pro\",\n643:   \"id\": ID,\n644:   \"title\": TITLE,\n645:   \"who\": \"Orienteers who post and analyze their control split times after every race, on Attackpoint and club/WinSplits result pages\",\n646:   \"problem\": [\n647:     \"WinSplits already computes the answer everyone asks after a race - \\\"where did I lose time?\\\" - as a per-leg time loss with mistake legs pink: \\\"Some split times have pink background colour... a mistake has probably been made.\\\"\",\n648:     \"But that analysis lives in a results-table web page nobody can post. Orienteers upload raw splits to Attackpoint and hand-make the graphical split-time analysis World of O News draws for every championship, because the shareable card does not exist.\",\n649:     \"Every club worldwide runs events weekly, so the moment recurs weekly: one racer, one finish time, and a row of control splits that say where the minutes went.\",\n650:   ],\n651:   \"sources\": [\n652:     \"https://attackpoint.org/\",\n653:     \"http://obasen.orientering.se/winsplits/online/en/help_table.asp?databaseId=101857&categoryId=0\",\n654:     \"https://orienteering.sport/iof/it/data-standard-3-0\",\n655:     \"https://news.worldofo.com/2026/07/11/woc-2026-knock-out-sprint-maps-and-results\",\n656:     \"https://orienteeringusa.org/2026/04/junior-nationals-and-flying-pig-xxviii-event-recap/\"\n657:   ],\n658:   \"solution\": [\n659:     \"One deterministic still of one racer's IOF XML 3.0 result row. The finish time is the hero with the course and place beside it; each leg is a tape whose length is the split over the slowest leg, and any leg with time loss is pink in bar and signed loss text.\",\n660:     \"The one design decision: time loss is a prop, never re-derived. WinSplits computes it class-relative, so the card takes it per leg and only sums it (TOTAL LOSS), subtracts it from the finish (TIME W/O MISTAKES) and takes the min split (BEST LEG).\",\n661:     \"Bar length = split, pink = mistake, so the \\\"where did I lose time?\\\" answer reads from the picture without a legend. Emma Lindqvist and her club are invented; the field names mirror the IOF schema (control, split, loss).\",\n662:   ],\n663:   \"usage\": {\n664:     \"command\": \"m0saic make @one-a-day/sports/orienteering-split-analysis/v1 --template-repo . -w 1280 -h 720 -o journal/2026-10-24/split-analysis.png\",\n665:     \"try\": [\n666:       \"preset light, accent #2f6f62: a light page, the mistakes in the new colour\",\n667:       \"place 0: the chip goes; the finish stays the largest figure\",\n668:       \"a mistake on the last leg: the F row turns pink and the loss reads +0:47\",\n669:       \"4 legs for a sprint, 18 for a long course: the tape re-scales, the bands hold\",\n670:     ],\n671:   },\n672:   \"caveats\": [\n673:     \"Time loss is not re-derived: feed the WinSplits per-leg number, or the card sums zeros and every bar reads neutral.\",\n674:     \"Bar length is the split over the slowest leg, not an absolute scale, so it shows relative leg effort and not leg length in minutes.\",\n675:     \"The finish is printed as entered and not checked against the split sum; a finish shorter than the total loss fails fast rather than print a negative time-without-mistakes.\",\n676:   ],\n677:   \"timeline\": {\n678:     \"source\": \"runner\",\n679:     \"phases\": [\n680:       {\n681:         \"name\": \"scout\",\n682:         \"startMs\": 0,\n683:         \"durMs\": 2168,\n684:         \"status\": \"error\"\n685:       },\n686:       {\n687:         \"name\": \"scout (2)\",\n688:         \"startMs\": 2185,\n689:         \"durMs\": 1688,\n690:         \"status\": \"error\"\n691:       },\n692:       {\n693:         \"name\": \"scout (3)\",\n694:         \"startMs\": 8454353,\n695:         \"durMs\": 132981,\n696:         \"calls\": 20,\n697:         \"tokens\": 593418,\n698:         \"costUsd\": 0.07,\n699:         \"tools\": \"websearch 7, bash 5, read 5\"\n700:       },\n701:       {\n702:         \"name\": \"plan\",\n703:         \"startMs\": 8587355,\n704:         \"durMs\": 133083,\n705:         \"calls\": 16,\n706:         \"tokens\": 524097,\n707:         \"costUsd\": 0.08,\n708:         \"tools\": \"read 8, bash 7, write 1\"\n709:       }\n710:     ],\n711:     \"costBasis\": \"reported\"\n712:   }\n713: };\n714: \n715: export const OrienteeringSplitAnalysisV1 = defineMosaicTemplate<OrienteeringSplitAnalysisProps>({\n716:   id: asTemplateId(ID),\n717:   label: \"2026-10-24 · Orienteering Split Analysis\",\n718:   version: 1,\n719:   description:\n720:     \"An orienteering race split-analysis card from one IOF XML 3.0 result row: control-by-control splits as a tape whose length is the leg, mistake legs pink with their time loss signed, finish time as the hero, and time-without-mistakes, total loss and best leg computed from the entered numbers.\",\n721:   capabilities: { tier: \"core\" },\n722:   tags: [\"sports\", \"2026-10-24\", \"day-035\", \"orienteering\", \"splits\", \"time-loss\", \"iof-xml\", \"attackpoint\", \"race-analysis\"],\n723: \n724:   outputHints: {\n725:     width: 1280,\n726:     height: 720,\n727:     fps: 30,\n728:     durationMs: 2000,\n729:     format: { kind: \"image\", container: \"png\" },\n730:     note: \"Static PNG. The finish is the hero at every aspect; the leg tape re-scales with the course length. Minimum tested canvas 480x270.\",\n731:   },\n732: \n733:   propsSchema,\n734:   defaultProps: DEFAULTS,\n735:   render,\n736:   renderTutorial: whyTutorial(WHY, render),\n737: });\n738: \n739: export default OrienteeringSplitAnalysisV1;\n740: \n741: async function render(props: OrienteeringSplitAnalysisProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n742:   const { width: W, height: H } = ctx.target;\n743:   const L = layoutSplitCard(props, W, H);\n744:   const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n745:   const constraints: LayoutConstraint[] = [];\n746:   const relations: RelationalConstraint[] = [];\n747: \n748:   for (const t of [...L.tiles].sort((a, b) => a.layer - b.layer)) {\n749:     const tile = tag({ ...makeColorTile(t.color, t.radius > 0 ? { effects: { rounding: { cornerStyle: \"pill\" } } } : {}) } as MosaicSource, t.label);\n750:     pieces.push({ rect: { ...t.rect, importance: t.layer }, source: t.accent ? bindProp(tile, \"accent\") : tile });\n751:   }\n752:   for (const c of L.cells) {\n753:     const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n754:     const source = c.bind === null\n755:       ? cell\n756:       : c.bind.kind === \"prop\"\n757:         ? bindProp(cell, c.bind.key)\n758:         : bindPropPath(cell, \"splits\", c.bind.path, c.bind.valueKind);\n759:     pieces.push({ rect: { ...c.rect, importance: c.over ? 6 : 5 }, source });\n760:     constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n761:   }\n762: \n763:   const has = (label: string) => L.cells.some((c) => c.label === label);\n764:   for (const label of [\"name\", \"club\", \"class\", \"course\", \"finish\", \"finish-label\", \"place\", \"place-label\", \"behind\"]) {\n765:     if (has(label)) constraints.push({ label, within: { yFrac: [0, 0.26] } });\n766:   }\n767:   if (L.tiles.some((t) => t.label === \"place-chip\")) {\n768:     constraints.push({ label: \"place-chip\", within: { yFrac: [0, 0.26] } });\n769:     constraints.push({ label: \"place-chip\" });\n770:   }\n771: \n772:   for (let i = 0; i < L.p.legs.length; i++) {\n773:     const band = L.bands[i];\n774:     const y0 = Math.max(0, band.y / H - 1 / H);\n775:     const y1 = Math.min(1, (band.y + band.h) / H + 1 / H);\n776:     constraints.push({ label: `band-${i}`, within: { yFrac: [0.26, 0.8] } });\n777:     constraints.push({ label: `rail-${i}`, minWidthFrac: 0.32, within: { yFrac: [y0, y1] } });\n778:     constraints.push({ label: `bar-${i}`, within: { yFrac: [y0, y1] } });\n779:     for (const label of [`ctrl-${i}`, `split-${i}`]) {\n780:       constraints.push({ label, within: { yFrac: [0.26, 0.8] } });\n781:     }\n782:     if (has(`loss-${i}`)) constraints.push({ label: `loss-${i}`, within: { yFrac: [0.26, 0.8] } });\n783:   }\n784:   relations.push({ label: L.p.legs.map((_, i) => `band-${i}`), equal: \"size\", tolerancePx: 2 });\n785: \n786:   for (let i = 0; i < 3; i++) {\n787:     constraints.push({ label: `foot-${i}`, within: { yFrac: [0.8, 1] } });\n788:     constraints.push({ label: `foot-label-${i}`, within: { yFrac: [0.8, 1] } });\n789:   }\n790:   for (const label of [\"time-wo\", \"total-loss\", \"best-leg\"]) constraints.push({ label, within: { yFrac: [0.8, 1] } });\n791:   relations.push({ label: [\"foot-0\", \"foot-1\", \"foot-2\"], equal: \"size\", tolerancePx: 2 });\n792: \n793:   const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n794:   const doc: MosaicDocument = {\n795:     kind: \"mosaic_document\",\n796:     version: 1,\n797:     m0: toM0String(placed.m0, ID),\n798:     assets: {},\n799:     backgroundColor: L.theme.bg as MosaicColor,\n800:     sources: placed.sources,\n801:   };\n802:   return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: props.debugLayout === true });\n803: }\n\n(End of file - total 803 lines)\n</content>","metadata":{"preview":"import type {\n  MosaicColor,\n  MosaicDocument,\n  MosaicEngineContext,\n  MosaicSource,\n} from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport {\n  bindProp,\n  bindPropPath,\n  defineMosaicTemplate,\n  definePropsSchema,\n  makeColorTile,\n  placeInsetPieces,\n  tag,\n} from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\orienteering-split-analysis\\v1\\orienteering-split-analysis.ts","text":"import type {\n  MosaicColor,\n  MosaicDocument,\n  MosaicEngineContext,\n  MosaicSource,\n} from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport {\n  bindProp,\n  bindPropPath,\n  defineMosaicTemplate,\n  definePropsSchema,\n  makeColorTile,\n  placeInsetPieces,\n  tag,\n} from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/sports/orienteering-split-analysis/v1` - one racer's IOF XML 3.0\n * result row as a shareable split-analysis card: finish time as the hero, the\n * course and the place, then control-by-control legs as a tape whose length is\n * the split, and a footer that answers the one question everyone asks -\n * \"where did I lose time?\" - as TIME W/O MISTAKES, TOTAL LOSS and BEST LEG.\n *\n * ONE CONCEPT: the mistake is the picture. A leg's bar length is its split\n * over the slowest leg, so the eye reads the race; a leg with time loss\n * (`loss > 0`, the WinSplits per-leg number) is drawn in the accent - pink\n * bar, signed pink loss - and a clean leg is neutral with an empty loss cell.\n * No legend: pink = mistake, bar length = split.\n *\n * The rule that bites: time loss is NOT re-derived. WinSplits computes it\n * class-relative from the whole field, so it comes in as a prop per leg; the\n * card only sums the entered losses (TOTAL LOSS), subtracts them from the\n * entered finish (TIME W/O MISTAKES) and takes the min split (BEST LEG) - and\n * it never checks the finish against the split sum. A decimal time, an\n * h:mm:ss loss, a leg count outside 4-18, or a leg that will not fit the\n * canvas fails fast with a named field.\n */\n\nexport type OrienteeringLeg = { control: string; split: string; loss: string };\n\nexport type OrienteeringSplitAnalysisProps = {\n  /** The racer, the header's bold line. Up to 40 ASCII; \"\" hides it. */\n  name?: string;\n  /** The club, first half of the second line. Up to 40 ASCII; \"\" hides it. */\n  club?: string;\n  /** The class, joined after the club with \" · \". Up to 20 ASCII. */\n  className?: string;\n  /** The course, the third header line. Up to 48 ASCII; \"\" hides it. */\n  course?: string;\n  /** The finish time, the hero figure. \"m:ss\" or \"h:mm:ss\", whole seconds. */\n  finish?: string;\n  /** The place, drawn as the accent \"#12\" chip. 0 hides the chip. */\n  place?: number;\n  /** Time behind the winner, printed as entered. Up to 16 ASCII; \"\" hides it. */\n  behind?: string;\n  /** The legs in course order, 4-18, each { control, split, loss }. */\n  splits?: OrienteeringLeg[] | string;\n  /** The mistake-leg pink - bars, loss text, place chip - as #rrggbb. */\n  accent?: string;\n  /** Page and ink: \"dark\" share card or \"light\" print. */\n  preset?: \"dark\" | \"light\";\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/sports/orienteering-split-analysis/v1\";\nconst TITLE = \"Orienteering Split Analysis\";\nconst DEFAULT_ACCENT = \"#d94f8c\";\nconst ASCII = /^[\\x20-\\x7e]*$/;\nconst HEX = /^#[0-9a-fA-F]{6}$/;\n\nconst THEMES = {\n  dark: { bg: \"#14111d\", ink: \"#efe9f2\", dim: \"#9b92a4\" },\n  light: { bg: \"#f6f2ef\", ink: \"#241d28\", dim: \"#6f6574\" },\n} as const;\n\n/** A 12-control middle course: 13 legs in course order, the last the finish. */\nexport const DEFAULT_LEGS: OrienteeringLeg[] = [\n  { control: \"1\", split: \"4:08\", loss: \"0:47\" },\n  { control: \"2\", split: \"2:41\", loss: \"0:00\" },\n  { control: \"3\", split: \"3:15\", loss: \"0:00\" },\n  { control: \"4\", split: \"2:58\", loss: \"0:00\" },\n  { control: \"5\", split: \"5:22\", loss: \"1:20\" },\n  { control: \"6\", split: \"3:40\", loss: \"0:00\" },\n  { control: \"7\", split: \"1:32\", loss: \"0:00\" },\n  { control: \"8\", split: \"4:05\", loss: \"0:00\" },\n  { control: \"9\", split: \"3:51\", loss: \"0:51\" },\n  { control: \"10\", split: \"2:44\", loss: \"0:00\" },\n  { control: \"11\", split: \"3:33\", loss: \"0:00\" },\n  { control: \"12\", split: \"4:11\", loss: \"0:00\" },\n  { control: \"F\", split: \"1:55\", loss: \"0:00\" },\n];\n\nconst DEFAULTS = {\n  name: \"Emma Lindqvist\",\n  club: \"OK Klyftamo\",\n  className: \"W21E\",\n  course: \"Middle, 4.2 km\",\n  finish: \"45:02\",\n  place: 12,\n  behind: \"+1:23\",\n  splits: DEFAULT_LEGS,\n  accent: DEFAULT_ACCENT,\n  preset: \"dark\" as \"dark\" | \"light\",\n  debugLayout: false,\n};\n\nconst propsSchema = definePropsSchema<OrienteeringSplitAnalysisProps>({\n  name: {\n    type: \"string\",\n    required: false,\n    description: \"The racer, the header's bold line. Up to 40 ASCII characters; empty hides the line. The sample is invented.\",\n    meta: { control: { placeholder: DEFAULTS.name }, ui: { label: \"Name\", order: 1, primary: true } },\n  },\n  club: {\n    type: \"string\",\n    required: false,\n    description: 'The club, first half of the second header line. Up to 40 ASCII; empty hides it. Joined to the class with \" · \".',\n    meta: { control: { placeholder: DEFAULTS.club }, ui: { label: \"Club\", order: 2 } },\n  },\n  className: {\n    type: \"string\",\n    required: false,\n    description: 'The class, joined after the club with \" · \". Up to 20 ASCII; empty shows the club alone.',\n    meta: { control: { placeholder: DEFAULTS.className }, ui: { label: \"Class\", order: 3 } },\n  },\n  course: {\n    type: \"string\",\n    required: false,\n    description: \"The course, the third header line, e.g. \\\"Middle, 4.2 km\\\". Up to 48 ASCII; empty hides it.\",\n    meta: { control: { placeholder: DEFAULTS.course }, ui: { label: \"Course\", order: 4 } },\n  },\n  finish: {\n    type: \"string\",\n    required: false,\n    description: 'The finish time, the hero figure. \"m:ss\" (minutes may pass 59, so \"71:40\" is legal) or \"h:mm:ss\", whole seconds. A decimal fails fast.',\n    meta: { control: { placeholder: DEFAULTS.finish }, ui: { label: \"Finish\", order: 5, primary: true } },\n  },\n  place: {\n    type: \"number\",\n    required: false,\n    description: \"The place, drawn as the accent chip #12. Whole number 0-9999; 0 hides the chip.\",\n    meta: { constraints: { min: 0, max: 9999 }, control: { placeholder: String(DEFAULTS.place) }, ui: { label: \"Place\", order: 6 } },\n  },\n  behind: {\n    type: \"string\",\n    required: false,\n    description: 'Time behind the winner, printed as entered, e.g. \"+1:23\". Up to 16 ASCII; empty hides it.',\n    meta: { control: { placeholder: DEFAULTS.behind }, ui: { label: \"Behind\", order: 7 } },\n  },\n  splits: {\n    type: \"json\",\n    required: false,\n    description:\n      'The legs in course order, 4-18. Each object is { control, split, loss } - the IOF field names. control is the code, split is \"m:ss\" or \"h:mm:ss\" (whole seconds), loss is the WinSplits per-leg time loss as \"m:ss\" (\"0:00\" = clean, anything more = a mistake leg drawn pink). Example: [{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}].',\n    meta: {\n      constraints: {\n        jsonSchema: {\n          type: \"array\",\n          minItems: 4,\n          maxItems: 18,\n          items: {\n            type: \"object\",\n            required: [\"control\", \"split\", \"loss\"],\n            properties: {\n              control: { type: \"string\", minLength: 1, maxLength: 8 },\n              split: { type: \"string\" },\n              loss: { type: \"string\" },\n            },\n          },\n        },\n      },\n      control: { mono: true, placeholder: '[{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}]' },\n      ui: { label: \"Splits\", order: 8, primary: true },\n    },\n  },\n  accent: {\n    type: \"string\",\n    required: false,\n    description: \"The mistake-leg pink - bars, loss text and the place chip - as #rrggbb.\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 9 } },\n  },\n  preset: {\n    type: \"string\",\n    required: false,\n    description: 'Page and ink: \"dark\" (default) or \"light\".',\n    meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 10 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits its box, header/body/footer hold their bands, rows equal, tape at least 32% wide) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\nfunction fail(field: string, rule: string): never {\n  throw new Error(`${ID}: ${field} ${rule}`);\n}\n\n/**\n * \"m:ss\" or \"h:mm:ss\" to whole seconds. Minutes may pass 59 in the one-colon\n * form. Seconds (and minutes in the two-colon form) are 0-59. A decimal is\n * refused, not rounded. null when the string is not that grammar.\n */\nexport function parseSplitTime(text: string): number | null {\n  const s = text.trim();\n  if (s.length === 0 || /[.]/.test(s)) return null;\n  const hms = /^(\\d+):([0-5]\\d):([0-5]\\d)$/.exec(s);\n  if (hms) return Number(hms[1]) * 3600 + Number(hms[2]) * 60 + Number(hms[3]);\n  const ms = /^(\\d+):([0-5]\\d)$/.exec(s);\n  if (ms) return Number(ms[1]) * 60 + Number(ms[2]);\n  return null;\n}\n\n/** Compact, no leading zeros. Hours only when the value is at least one hour. */\nexport function formatSplitTime(sec: number): string {\n  const h = Math.floor(sec / 3600);\n  const m = Math.floor((sec % 3600) / 60);\n  const ss = String(sec % 60).padStart(2, \"0\");\n  if (h >= 1) return `${h}:${String(m).padStart(2, \"0\")}:${ss}`;\n  return `${m}:${ss}`;\n}\n\nfunction text(value: unknown, field: string, max: number): string {\n  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n  if (!ASCII.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII.`);\n  const s = value.trim();\n  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n  return s;\n}\n\n/** m:ss or h:mm:ss, whole seconds, at least one second, at most 99:59:59. */\nfunction timeField(value: unknown, field: string): { sec: number; printed: string } {\n  if (typeof value !== \"string\") fail(field, 'must be a string, \"m:ss\" or \"h:mm:ss\".');\n  const sec = parseSplitTime(value);\n  if (sec === null) fail(field, `${JSON.stringify(value)} is not a time: write m:ss or h:mm:ss, whole seconds, no decimal (e.g. \"4:08\" or \"1:11:40\").`);\n  if (sec < 1) fail(field, `${JSON.stringify(value)} must be at least one second.`);\n  if (sec > 359999) fail(field, `${JSON.stringify(value)} is longer than 99:59:59; the card cannot fit it.`);\n  return { sec, printed: formatSplitTime(sec) };\n}\n\n/** The WinSplits per-leg loss: m:ss only (never hours), zero allowed (clean). */\nfunction lossField(value: unknown, field: string): { sec: number; printed: string } {\n  if (typeof value !== \"string\") fail(field, 'must be a string, \"m:ss\".');\n  const t = value.trim();\n  if (!/^\\d+:[0-5]\\d$/.test(t)) fail(field, `${JSON.stringify(value)} is not m:ss: write m:ss, whole seconds (e.g. \"0:47\"); a loss is a per-leg time, never hours.`);\n  const sec = parseSplitTime(t)!;\n  if (sec > 359999) fail(field, `${JSON.stringify(value)} is longer than 99:59:59.`);\n  return { sec, printed: formatSplitTime(sec) };\n}\n\nexport type Leg = {\n  index: number;\n  control: string;\n  split: string;\n  splitSec: number;\n  loss: string;\n  lossSec: number;\n  isMistake: boolean;\n};\n\nexport type NormalizedSplitCard = {\n  name: string;\n  club: string;\n  className: string;\n  course: string;\n  clubLine: string;\n  finish: string;\n  finishSec: number;\n  place: number;\n  placeText: string;\n  behind: string;\n  legs: Leg[];\n  slowestSec: number;\n  bestSec: number;\n  totalLossSec: number;\n  totalLossText: string;\n  timeWoText: string;\n  bestText: string;\n  accent: MosaicColor;\n  preset: \"dark\" | \"light\";\n  debugLayout: boolean;\n};\n\n/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\nexport function normalizeSplitCard(props: OrienteeringSplitAnalysisProps): NormalizedSplitCard {\n  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n  const name = text(p.name, \"name\", 40);\n  const club = text(p.club, \"club\", 40);\n  const className = text(p.className, \"className\", 20);\n  const course = text(p.course, \"course\", 48);\n  const behind = text(p.behind, \"behind\", 16);\n  if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n  if (typeof p.accent !== \"string\" || !HEX.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n  const finish = timeField(p.finish, \"finish\");\n  if (typeof p.place !== \"number\" || !Number.isFinite(p.place)) fail(\"place\", \"must be a number.\");\n  if (!Number.isInteger(p.place)) fail(\"place\", \"must be a whole number.\");\n  if (p.place < 0 || p.place > 9999) fail(\"place\", `${p.place} is outside 0-9999; 0 hides the chip.`);\n\n  let splits = p.splits;\n  if (typeof splits === \"string\") {\n    try {\n      splits = JSON.parse(splits);\n    } catch {\n      fail(\"splits\", `is not valid JSON: ${JSON.stringify(splits.slice(0, 60))}. Pass a list of {control, split, loss}.`);\n    }\n  }\n  if (!Array.isArray(splits)) fail(\"splits\", 'must be a list of legs, e.g. [{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}].');\n  if (splits.length < 4 || splits.length > 18) fail(\"splits\", `has ${splits.length} legs; a course is 4 to 18 legs (the finish leg counts).`);\n  const legs: Leg[] = splits.map((raw, i) => {\n    if (raw === null || typeof raw !== \"object\" || Array.isArray(raw)) fail(`splits[${i}]`, \"must be an object with control, split and loss.\");\n    const o = raw as OrienteeringLeg;\n    const control = text(o.control, `splits[${i}].control`, 8);\n    if (control === \"\") fail(`splits[${i}].control`, \"is empty; give the control code.\");\n    const split = timeField(o.split, `splits[${i}].split`);\n    const loss = lossField(o.loss, `splits[${i}].loss`);\n    return { index: i, control, split: split.printed, splitSec: split.sec, loss: loss.printed, lossSec: loss.sec, isMistake: loss.sec > 0 };\n  });\n\n  const slowestSec = Math.max(...legs.map((l) => l.splitSec));\n  const bestSec = Math.min(...legs.map((l) => l.splitSec));\n  const totalLossSec = legs.reduce((a, l) => a + l.lossSec, 0);\n  if (totalLossSec > finish.sec) {\n    fail(\"splits\", `the per-leg losses sum to ${formatSplitTime(totalLossSec)}, more than the finish ${finish.printed}; time-without-mistakes would be negative.`);\n  }\n  const clubLine = [club, className].filter((s) => s !== \"\").join(\" \\u00b7 \");\n  return {\n    name, club, className, course, clubLine,\n    finish: finish.printed, finishSec: finish.sec,\n    place: p.place, placeText: p.place > 0 ? `#${p.place}` : \"\",\n    behind,\n    legs, slowestSec, bestSec, totalLossSec,\n    totalLossText: totalLossSec > 0 ? `+${formatSplitTime(totalLossSec)}` : \"0:00\",\n    timeWoText: formatSplitTime(finish.sec - totalLossSec),\n    bestText: formatSplitTime(bestSec),\n    accent: p.accent.trim().toLowerCase() as MosaicColor,\n    preset: p.preset, debugLayout: p.debugLayout,\n  };\n}\n\nfunction mix(a: string, b: string, t: number): MosaicColor {\n  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n}\nfunction luminance(hex: string): number {\n  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n}\nfunction onColor(fill: string): MosaicColor {\n  const ratio = (other: string) => { const a = luminance(fill), b = luminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n  return (ratio(\"#14111d\") >= ratio(\"#ffffff\") ? \"#14111d\" : \"#ffffff\") as MosaicColor;\n}\n\nexport type SplitRect = { x: number; y: number; w: number; h: number };\ntype Bind =\n  | { kind: \"prop\"; key: string }\n  | { kind: \"path\"; path: (string | number)[]; valueKind: \"string\" | \"number\" }\n  | null;\ntype Cell = { label: string; rect: SplitRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\ntype Tile = { label: string; rect: SplitRect; color: MosaicColor; radius: number; layer: number; accent?: boolean };\n\nfunction fitPx(line: string, cellW: number, maxPx: number, bold = false): number {\n  const top = Math.max(1, Math.round(maxPx));\n  const room = budget(cellW);\n  const w = widthOf(line, top, bold);\n  let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n  while (px > 1 && widthOf(line, px, bold) > room) px--;\n  return px;\n}\n\n/** The whole card as rects and measured fits - pure in (props, canvas). */\nexport function layoutSplitCard(props: OrienteeringSplitAnalysisProps, W: number, H: number) {\n  const p = normalizeSplitCard(props);\n  const theme = THEMES[p.preset];\n  const ink = theme.ink as MosaicColor;\n  const dim = theme.dim as MosaicColor;\n  const S = Math.min(H, 0.75 * W);\n  const m = Math.max(8, Math.round(S * 0.04));\n  const CW = W - 2 * m;\n  const floor = Math.max(6, Math.round(Math.min(W, H) * 0.012));\n  const small = Math.max(5, Math.round(Math.min(W, H) * 0.009));\n  const gap = Math.max(3, Math.round(CW * 0.01));\n  const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n\n  // The three pinned bands: header [0, 0.26], body [0.26, 0.80], footer [0.80, 1].\n  const headerBottom = Math.floor(0.26 * H) - 1;\n  const bodyTop = Math.ceil(0.26 * H) + 2;\n  const [12:29:06] ship-1 🔧 read: C:\src\m0saic-production\one-a-day\src\sports\orienteering-split-analysis\v1\orienteering-split-analysis.ts
