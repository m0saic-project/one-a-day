, leftParts.length - 1) * leftGap;\n\n    const blockH = Math.max(rightH, leftH, finishH);\n    const avail = headerBottom - m;\n    if (blockH > avail) return null;\n    const blockTop = m + Math.max(0, Math.round((avail - blockH) / 2));\n    const rightTop = blockTop;\n    const leftTop = blockTop;\n\n    const finishRect: SplitRect = { x: W - m - finishW, y: rightTop + Math.round((row1H - finishH) / 2), w: finishW, h: finishH };\n    const finishLabelRect: SplitRect = { x: W - m - row1W, y: rightTop + Math.round((row1H - finishLabelH) / 2), w: finishLabelW, h: finishLabelH };\n    let placeLabelRect: SplitRect | null = null;\n    let chipRect: SplitRect | null = null;\n    let behindRect: SplitRect | null = null;\n    if (hasRow2) {\n      const row2Y = rightTop + row1H + gap;\n      let rx = W - m;\n      if (p.behind !== \"\") {\n        behindRect = { x: rx - behindW, y: row2Y + Math.round((row2H - behindH) / 2), w: behindW, h: behindH };\n        rx = behindRect.x - gap;\n      }\n      if (p.place > 0) {\n        chipRect = { x: rx - chipW, y: row2Y + Math.round((row2H - chipH) / 2), w: chipW, h: chipH };\n        rx = chipRect.x - gap;\n        placeLabelRect = { x: rx - placeLabelW, y: row2Y + Math.round((row2H - placeLabelH) / 2), w: placeLabelW, h: placeLabelH };\n      }\n    }\n\n    return { heroPx, blockTop, blockH, rightW, leftW, finishRect, labelPx, chipPx, chipRect, behindPx, namePx, clubPx, coursePx, leftTop, rightTop, row1H, row2H, finishLabelRect, placeLabelRect, behindRect };\n  };\n\n  let heroPx = Math.min(heroCap, Math.max(floor + 8, Math.round((headerBottom - m) * 0.5)));\n  let header: Header | null = null;\n  while (heroPx > floor + 1) {\n    header = headerAt(heroPx);\n    if (header) break;\n    heroPx -= 1;\n  }\n  const hd = header ?? fail(\"finish\", `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n\n  // ---- header left block (top-aligned) ----\n  let ly = hd.leftTop;\n  const leftX = m;\n  if (p.name !== \"\") {\n    const h = Math.round(hd.namePx * 1.2);\n    line(\"name\", { x: leftX, y: ly, w: hd.leftW, h }, p.name, hd.namePx, { bold: true, bind: { kind: \"prop\", key: \"name\" }, field: \"name\" });\n    ly += h + Math.max(2, Math.round(gap * 0.45));\n  }\n  if (p.clubLine !== \"\") {\n    const h = Math.round(hd.clubPx * 1.3);\n    let cx2 = leftX;\n    if (p.club !== \"\") {\n      const w = Math.ceil((widthOf(p.club, hd.clubPx) + 2) / 0.94) + 2;\n      line(\"club\", { x: cx2, y: ly, w, h }, p.club, hd.clubPx, { color: dim, bind: { kind: \"prop\", key: \"club\" }, field: \"club\", floorAt: small });\n      cx2 += w;\n    }\n    if (p.className !== \"\") {\n      const t = p.club !== \"\" ? \" \\u00b7 \" + p.className : p.className;\n      const w = Math.ceil((widthOf(t, hd.clubPx) + 2) / 0.94) + 2;\n      line(\"class\", { x: cx2, y: ly, w, h }, t, hd.clubPx, { color: dim, bind: { kind: \"prop\", key: \"className\" }, field: \"className\", floorAt: small });\n    }\n    ly += h + Math.max(2, Math.round(gap * 0.45));\n  }\n  if (p.course !== \"\") {\n    const h = Math.round(hd.coursePx * 1.3);\n    line(\"course\", { x: leftX, y: ly, w: hd.leftW, h }, p.course, hd.coursePx, { color: dim, bind: { kind: \"prop\", key: \"course\" }, field: \"course\", floorAt: small });\n  }\n\n  // ---- header right block ----\n  line(\"finish\", hd.finishRect, p.finish, hd.heroPx, { bold: true, align: \"right\", bind: { kind: \"prop\", key: \"finish\" }, field: \"finish\" });\n  line(\"finish-label\", hd.finishLabelRect, \"FINISH\", hd.labelPx, { color: dim, align: \"right\", floorAt: small });\n  if (hd.placeLabelRect) {\n    line(\"place-label\", hd.placeLabelRect, \"PLACE\", hd.labelPx, { color: dim, align: \"right\", floorAt: small });\n  }\n  if (hd.chipRect && p.place > 0) {\n    tiles.push({ label: \"place-chip\", rect: hd.chipRect, color: p.accent, radius: 1, layer: 5, accent: true });\n    line(\"place\", hd.chipRect, p.placeText, hd.chipPx, { bold: true, align: \"center\", color: onColor(p.accent), bind: { kind: \"prop\", key: \"place\" }, over: true, floorAt: small, field: \"place\" });\n  }\n  if (hd.behindRect && p.behind !== \"\") {\n    line(\"behind\", hd.behindRect, p.behind, hd.behindPx, { color: dim, align: \"right\", bind: { kind: \"prop\", key: \"behind\" }, field: \"behind\", floorAt: small });\n  }\n\n  // ---- body: one row per leg, tape length = split / slowest ----\n  const rowH = Math.floor((bodyBottom - bodyTop) / p.legs.length);\n  if (rowH < 8) unfit(\"the leg rows\");\n  const rowsEnd = bodyTop + rowH * p.legs.length;\n\n  const idxW = Math.max(Math.round(CW * 0.05), Math.round(S * 0.035));\n  const tapeW = Math.round(CW * 0.36);\n  if (tapeW / W < 0.32) unfit(\"the tape\");\n  const remaining = CW - idxW - tapeW - 3 * gap;\n  if (remaining < Math.round(CW * 0.14)) unfit(\"the split and loss columns\");\n  const splitColW = Math.round(remaining * 0.5);\n  const lossColW = remaining - splitColW;\n  let cx = m;\n  const take = (w: number) => { const r = { x: cx, w }; cx += w + gap; return r; };\n  const cCtrl = take(idxW);\n  const cTape = take(tapeW);\n  const cSplit = take(splitColW);\n  const cLoss = take(lossColW);\n\n  const rowCap = hd.heroPx - 1;\n  const rowHeightCap = Math.floor((rowH - 2) / 1.25);\n  const longestControl = p.legs.reduce((s, l) => (l.control.length >= s.length ? l.control : s), \"100\");\n  const longestSplit = p.legs.reduce((s, l) => (l.split.length >= s.length ? l.split : s), \"4:08\");\n  const mistakeLosses = p.legs.filter((l) => l.isMistake).map((l) => `+${l.loss}`);\n  let rowPx = Math.min(rowCap, rowHeightCap);\n  rowPx = Math.min(\n    rowPx,\n    fitPx(longestControl, cCtrl.w, rowPx),\n    fitPx(longestSplit, cSplit.w, rowPx, true),\n    ...(mistakeLosses.length > 0 ? [fitPx(mistakeLosses.reduce((s, t) => (t.length >= s.length ? t : s), \"+0:00\"), cLoss.w, rowPx)] : []),\n  );\n  if (rowPx < floor) unfit(\"the leg rows\");\n\n  const barH = Math.max(4, Math.min(rowH - 4, Math.round(Math.min(rowH * 0.42, S * 0.04))));\n  const railColor = mix(theme.bg, theme.ink, 0.14);\n  const barColor = mix(theme.bg, theme.ink, p.preset === \"dark\" ? 0.5 : 0.45);\n  const textH = Math.round(rowPx * 1.25);\n  const textYOff = Math.round((rowH - textH) / 2);\n\n  const bands: SplitRect[] = [];\n  p.legs.forEach((leg, i) => {\n    const band: SplitRect = { x: m, y: bodyTop + i * rowH, w: CW, h: rowH };\n    bands.push(band);\n    const wash = mix(theme.bg, theme.ink, i % 2 === 0 ? 0.035 : 0.07);\n    tiles.push({ label: `band-${i}`, rect: band, color: wash, radius: 0, layer: 0 });\n    const rail: SplitRect = { x: cTape.x, y: band.y + Math.round((rowH - barH) / 2), w: cTape.w, h: barH };\n    tiles.push({ label: `rail-${i}`, rect: rail, color: railColor, radius: 0, layer: 2 });\n    const barW = Math.max(1, Math.round(rail.w * leg.splitSec / p.slowestSec));\n    const bar: SplitRect = { x: rail.x, y: rail.y, w: barW, h: rail.h };\n    tiles.push({ label: `bar-${i}`, rect: bar, color: leg.isMistake ? p.accent : barColor, radius: 0, layer: 3, accent: leg.isMistake });\n    const ty = band.y + textYOff;\n    line(`ctrl-${i}`, { x: cCtrl.x, y: ty, w: cCtrl.w, h: textH }, leg.control, rowPx, { color: dim, align: \"right\", bind: { kind: \"path\", path: [i, \"control\"], valueKind: \"string\" }, floorAt: small });\n    line(`split-${i}`, { x: cSplit.x, y: ty, w: cSplit.w, h: textH }, leg.split, rowPx, { bold: true, align: \"right\", bind: { kind: \"path\", path: [i, \"split\"], valueKind: \"string\" } });\n    if (leg.isMistake) {\n      line(`loss-${i}`, { x: cLoss.x, y: ty, w: cLoss.w, h: textH }, `+${leg.loss}`, rowPx, { color: p.accent, align: \"right\", bind: { kind: \"path\", path: [i, \"loss\"], valueKind: \"string\" } });\n    }\n  });\n\n  // ---- footer: three computed cells ----\n  const footLabelPx0 = Math.min(hd.heroPx - 2, Math.round(S * 0.02));\n  const footValuePx0 = Math.min(hd.heroPx - 1, Math.round(S * 0.042));\n  const cellW = Math.floor(CW / 3);\n  const footLabels = [\"TIME W/O MISTAKES\", \"TOTAL LOSS\", \"BEST LEG\"] as const;\n  const footValues = [p.timeWoText, p.totalLossText, p.bestText];\n  let footLabelPx = footLabels.reduce((px, t) => Math.min(px, fitPx(t, cellW, footLabelPx0)), footLabelPx0);\n  let footValuePx = footValues.reduce((px, t) => Math.min(px, fitPx(t, cellW, footValuePx0, true)), footValuePx0);\n  if (footLabelPx < small) unfit(\"the footer labels\");\n  if (footValuePx < floor) unfit(\"the footer values\");\n  if (footValuePx >= hd.heroPx) footValuePx = hd.heroPx - 1;\n  if (footLabelPx >= hd.heroPx) footLabelPx = Math.max(small, hd.heroPx - 2);\n  const footLabelH = Math.round(footLabelPx * 1.3);\n  const footValueH = Math.round(footValuePx * 1.2);\n  const footGap = Math.max(2, Math.round(gap * 0.45));\n  const footBlock = footLabelH + footGap + footValueH;\n  let footTop = Math.max(footerTop, rowsEnd + gap);\n  if (footTop + footBlock > H - m) {\n    footTop = Math.max(footerTop, H - m - footBlock);\n  }\n  if (footTop + footBlock > H - Math.max(4, Math.round(m * 0.4))) unfit(\"the footer\");\n\n  const footKeys = [\"time-wo\", \"total-loss\", \"best-leg\"] as const;\n  for (let i = 0; i < 3; i++) {\n    const x = m + i * cellW;\n    const cell: SplitRect = { x, y: footTop, w: cellW, h: footBlock };\n    tiles.push({ label: `foot-${i}`, rect: cell, color: mix(theme.bg, theme.ink, 0.04), radius: 0, layer: 0 });\n    line(`foot-label-${i}`, { x, y: footTop, w: cellW, h: footLabelH }, footLabels[i], footLabelPx, { color: dim, align: \"center\", floorAt: small });\n    line(footKeys[i], { x, y: footTop + footLabelH + footGap, w: cellW, h: footValueH }, footValues[i], footValuePx, { bold: true, align: \"center\" });\n  }\n  tiles.push({ label: \"rule-foot\", rect: { x: m, y: Math.max(rowsEnd, footTop - gap) + Math.max(0, Math.round((Math.min(gap, footTop - rowsEnd) - 2) / 2)), w: CW, h: 2 }, color: railColor, radius: 0, layer: 1 });\n\n  return {\n    p, theme, cells, tiles, bands, m, floor, small, heroPx: hd.heroPx, rowPx, barH,\n    tape: cTape, rowH, rowsTop: bodyTop, rowsEnd, footTop, headerBottom, bodyTop, bodyBottom, footerTop,\n  };\n}\n\nconst WHY: WhySpec = {\n  \"day\": 35,\n  \"date\": \"2026-10-24\",\n  \"agent\": \"opencode\",\n  \"model\": \"deepseek-v4-pro\",\n  \"id\": ID,\n  \"title\": TITLE,\n  \"who\": \"Orienteers who post and analyze their control split times after every race, on Attackpoint and club/WinSplits result pages\",\n  \"problem\": [\n    \"WinSplits already computes the answer everyone asks after a race - \\\"where did I lose time?\\\" - as a per-leg time loss with mistake legs pink: \\\"Some split times have pink background colour... a mistake has probably been made.\\\"\",\n    \"But that analysis lives in a results-table web page nobody can post. Orienteers upload raw splits to Attackpoint and hand-make the graphical split-time analysis World of O News draws for every championship, because the shareable card does not exist.\",\n    \"Every club worldwide runs events weekly, so the moment recurs weekly: one racer, one finish time, and a row of control splits that say where the minutes went.\",\n  ],\n  \"sources\": [\n    \"https://attackpoint.org/\",\n    \"http://obasen.orientering.se/winsplits/online/en/help_table.asp?databaseId=101857&categoryId=0\",\n    \"https://orienteering.sport/iof/it/data-standard-3-0\",\n    \"https://news.worldofo.com/2026/07/11/woc-2026-knock-out-sprint-maps-and-results\",\n    \"https://orienteeringusa.org/2026/04/junior-nationals-and-flying-pig-xxviii-event-recap/\"\n  ],\n  \"solution\": [\n    \"One deterministic still of one racer's IOF XML 3.0 result row. The finish time is the hero with the course and place beside it; each leg is a tape whose length is the split over the slowest leg, and any leg with time loss is pink in bar and signed loss text.\",\n    \"The one design decision: time loss is a prop, never re-derived. WinSplits computes it class-relative, so the card takes it per leg and only sums it (TOTAL LOSS), subtracts it from the finish (TIME W/O MISTAKES) and takes the min split (BEST LEG).\",\n    \"Bar length = split, pink = mistake, so the \\\"where did I lose time?\\\" answer reads from the picture without a legend. Emma Lindqvist and her club are invented; the field names mirror the IOF schema (control, split, loss).\",\n  ],\n  \"usage\": {\n    \"command\": \"m0saic make @one-a-day/sports/orienteering-split-analysis/v1 --template-repo . -w 1280 -h 720 -o journal/2026-10-24/split-analysis.png\",\n    \"try\": [\n      \"preset light, accent #2f6f62: a light page, the mistakes in the new colour\",\n      \"place 0: the chip goes; the finish stays the largest figure\",\n      \"a mistake on the last leg: the F row turns pink and the loss reads +0:47\",\n      \"4 legs for a sprint, 18 for a long course: the tape re-scales, the bands hold\",\n    ],\n  },\n  \"caveats\": [\n    \"Time loss is not re-derived: feed the WinSplits per-leg number, or the card sums zeros and every bar reads neutral.\",\n    \"Bar length is the split over the slowest leg, not an absolute scale, so it shows relative leg effort and not leg length in minutes.\",\n    \"The finish is printed as entered and not checked against the split sum; a finish shorter than the total loss fails fast rather than print a negative time-without-mistakes.\",\n  ],\n  \"timeline\": {\n    \"source\": \"runner\",\n    \"phases\": [\n      {\n        \"name\": \"scout\",\n        \"startMs\": 0,\n        \"durMs\": 2168,\n        \"status\": \"error\"\n      },\n      {\n        \"name\": \"scout (2)\",\n        \"startMs\": 2185,\n        \"durMs\": 1688,\n        \"status\": \"error\"\n      },\n      {\n        \"name\": \"scout (3)\",\n        \"startMs\": 8454353,\n        \"durMs\": 132981,\n        \"calls\": 20,\n        \"tokens\": 593418,\n        \"costUsd\": 0.07,\n        \"tools\": \"websearch 7, bash 5, read 5\"\n      },\n      {\n        \"name\": \"plan\",\n        \"startMs\": 8587355,\n        \"durMs\": 133083,\n        \"calls\": 16,\n        \"tokens\": 524097,\n        \"costUsd\": 0.08,\n        \"tools\": \"read 8, bash 7, write 1\"\n      }\n    ],\n    \"costBasis\": \"reported\"\n  }\n};\n\nexport const OrienteeringSplitAnalysisV1 = defineMosaicTemplate<OrienteeringSplitAnalysisProps>({\n  id: asTemplateId(ID),\n  label: \"2026-10-24 · Orienteering Split Analysis\",\n  version: 1,\n  description:\n    \"An orienteering race split-analysis card from one IOF XML 3.0 result row: control-by-control splits as a tape whose length is the leg, mistake legs pink with their time loss signed, finish time as the hero, and time-without-mistakes, total loss and best leg computed from the entered numbers.\",\n  capabilities: { tier: \"core\" },\n  tags: [\"sports\", \"2026-10-24\", \"day-035\", \"orienteering\", \"splits\", \"time-loss\", \"iof-xml\", \"attackpoint\", \"race-analysis\"],\n\n  outputHints: {\n    width: 1280,\n    height: 720,\n    fps: 30,\n    durationMs: 2000,\n    format: { kind: \"image\", container: \"png\" },\n    note: \"Static PNG. The finish is the hero at every aspect; the leg tape re-scales with the course length. Minimum tested canvas 480x270.\",\n  },\n\n  propsSchema,\n  defaultProps: DEFAULTS,\n  render,\n  renderTutorial: whyTutorial(WHY, render),\n});\n\nexport default OrienteeringSplitAnalysisV1;\n\nasync function render(props: OrienteeringSplitAnalysisProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n  const { width: W, height: H } = ctx.target;\n  const L = layoutSplitCard(props, W, H);\n  const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n  const constraints: LayoutConstraint[] = [];\n  const relations: RelationalConstraint[] = [];\n\n  for (const t of [...L.tiles].sort((a, b) => a.layer - b.layer)) {\n    const tile = tag({ ...makeColorTile(t.color, t.radius > 0 ? { effects: { rounding: { cornerStyle: \"pill\" } } } : {}) } as MosaicSource, t.label);\n    pieces.push({ rect: { ...t.rect, importance: t.layer }, source: t.accent ? bindProp(tile, \"accent\") : tile });\n  }\n  for (const c of L.cells) {\n    const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n    const source = c.bind === null\n      ? cell\n      : c.bind.kind === \"prop\"\n        ? bindProp(cell, c.bind.key)\n        : bindPropPath(cell, \"splits\", c.bind.path, c.bind.valueKind);\n    pieces.push({ rect: { ...c.rect, importance: c.over ? 6 : 5 }, source });\n    constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n  }\n\n  const has = (label: string) => L.cells.some((c) => c.label === label);\n  for (const label of [\"name\", \"club\", \"class\", \"course\", \"finish\", \"finish-label\", \"place\", \"place-label\", \"behind\"]) {\n    if (has(label)) constraints.push({ label, within: { yFrac: [0, 0.26] } });\n  }\n  if (L.tiles.some((t) => t.label === \"place-chip\")) {\n    constraints.push({ label: \"place-chip\", within: { yFrac: [0, 0.26] } });\n    constraints.push({ label: \"place-chip\" });\n  }\n\n  for (let i = 0; i < L.p.legs.length; i++) {\n    const band = L.bands[i];\n    const y0 = Math.max(0, band.y / H - 1 / H);\n    const y1 = Math.min(1, (band.y + band.h) / H + 1 / H);\n    constraints.push({ label: `band-${i}`, within: { yFrac: [0.26, 0.8] } });\n    constraints.push({ label: `rail-${i}`, minWidthFrac: 0.32, within: { yFrac: [y0, y1] } });\n    constraints.push({ label: `bar-${i}`, within: { yFrac: [y0, y1] } });\n    for (const label of [`ctrl-${i}`, `split-${i}`]) {\n      constraints.push({ label, within: { yFrac: [0.26, 0.8] } });\n    }\n    if (has(`loss-${i}`)) constraints.push({ label: `loss-${i}`, within: { yFrac: [0.26, 0.8] } });\n  }\n  relations.push({ label: L.p.legs.map((_, i) => `band-${i}`), equal: \"size\", tolerancePx: 2 });\n\n  for (let i = 0; i < 3; i++) {\n    constraints.push({ label: `foot-${i}`, within: { yFrac: [0.8, 1] } });\n    constraints.push({ label: `foot-label-${i}`, within: { yFrac: [0.8, 1] } });\n  }\n  for (const label of [\"time-wo\", \"total-loss\", \"best-leg\"]) constraints.push({ label, within: { yFrac: [0.8, 1] } });\n  relations.push({ label: [\"foot-0\", \"foot-1\", \"foot-2\"], equal: \"size\", tolerancePx: 2 });\n\n  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n  const doc: MosaicDocument = {\n    kind: \"mosaic_document\",\n    version: 1,\n    m0: toM0String(placed.m0, ID),\n    assets: {},\n    backgroundColor: L.theme.bg as MosaicColor,\n    sources: placed.sources,\n  };\n  return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: props.debugLayout === true });\n}","lineStart":1,"lineEnd":803,"totalLines":803,"truncated":false}},"title":"journal\\2026-10-24\\variants\\a\\src\\orienteering-split-analysis.ts","time":{"start":1792858842847,"end":1792858842863}},"id":"prt_16eb6e586001GYOOBTFxm9vEiS","sessionID":"ses_e914a8a92ffed6Ny0syywiP6Oa","messageID":"msg_16eb6d34c001h81hnjOS7uNn7L"}}
{"type":"tool_use","timestamp":1792858843178,"sessionID":"ses_e914a8a92ffed6Ny0syywiP6Oa","part":{"type":"tool","tool":"read","callID":"call_01_TWBG3YOG0GFRaBe6H5uG8579","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-24\\variants\\a\\src\\orienteering-split-analysis.test.ts"},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-24\\variants\\a\\src\\orienteering-split-analysis.test.ts</path>\n<type>file</type>\n<content>\n1: import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\n2: import { resolvePropBindings } from \"@m0saic/template-utils\";\n3: \n4: import { asDocument, targetCtx } from \"../../../__testutils__/render\";\n5: import { CONTRACT_CANVASES, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\n6: import {\n7:   DEFAULT_LEGS,\n8:   OrienteeringSplitAnalysisV1 as T,\n9:   formatSplitTime,\n10:   layoutSplitCard,\n11:   normalizeSplitCard,\n12:   parseSplitTime,\n13: } from \"./orienteering-split-analysis\";\n14: import type { OrienteeringLeg, OrienteeringSplitAnalysisProps } from \"./orienteering-split-analysis\";\n15: \n16: const ID = \"@one-a-day/sports/orienteering-split-analysis/v1\";\n17: const render = (p: OrienteeringSplitAnalysisProps = {}, w = 1280, h = 720) => T.render(p, targetCtx(w, h)).then(asDocument);\n18: const textOf = (p: OrienteeringSplitAnalysisProps, w = 1280, h = 720) =>\n19:   Object.fromEntries(layoutSplitCard(p, w, h).cells.map((c) => [c.label, c.text]));\n20: \n21: /** An 18-leg long-course stress list. */\n22: const eighteen: OrienteeringLeg[] = [\n23:   { control: \"1\", split: \"4:08\", loss: \"0:47\" },\n24:   { control: \"2\", split: \"2:41\", loss: \"0:00\" },\n25:   { control: \"3\", split: \"3:15\", loss: \"0:00\" },\n26:   { control: \"4\", split: \"2:58\", loss: \"0:00\" },\n27:   { control: \"5\", split: \"5:22\", loss: \"1:20\" },\n28:   { control: \"6\", split: \"3:40\", loss: \"0:00\" },\n29:   { control: \"7\", split: \"1:32\", loss: \"0:00\" },\n30:   { control: \"8\", split: \"4:05\", loss: \"0:00\" },\n31:   { control: \"9\", split: \"3:51\", loss: \"0:51\" },\n32:   { control: \"10\", split: \"2:44\", loss: \"0:00\" },\n33:   { control: \"11\", split: \"3:33\", loss: \"0:00\" },\n34:   { control: \"12\", split: \"4:11\", loss: \"0:00\" },\n35:   { control: \"13\", split: \"2:55\", loss: \"0:00\" },\n36:   { control: \"14\", split: \"3:02\", loss: \"0:00\" },\n37:   { control: \"15\", split: \"4:30\", loss: \"0:00\" },\n38:   { control: \"16\", split: \"2:20\", loss: \"0:00\" },\n39:   { control: \"17\", split: \"3:48\", loss: \"0:00\" },\n40:   { control: \"F\", split: \"1:55\", loss: \"0:00\" },\n41: ];\n42: \n43: const fourLegs: OrienteeringLeg[] = [\n44:   { control: \"1\", split: \"3:10\", loss: \"0:00\" },\n45:   { control: \"2\", split: \"2:50\", loss: \"0:00\" },\n46:   { control: \"3\", split: \"3:40\", loss: \"0:25\" },\n47:   { control: \"F\", split: \"1:10\", loss: \"0:00\" },\n48: ];\n49: \n50: const longClub: OrienteeringSplitAnalysisProps = {\n51:   name: \"Maximiliana Wolfeschlegelstein\",\n52:   club: \"Ytterhogdals IK Orientering\",\n53:   className: \"D21E\",\n54:   course: \"Long distance, 9.8 km, 24 controls\",\n55: };\n56: \n57: const lastLegMistake: OrienteeringSplitAnalysisProps = {\n58:   splits: DEFAULT_LEGS.map((s, i) => (i === DEFAULT_LEGS.length - 1 ? { ...s, loss: \"0:47\" } : s)),\n59: };\n60: \n61: describe(ID, () => {\n62:   it(\"shows the sample card at defaults: finish hero, place chip, pink mistakes, computed footer\", () => {\n63:     const t = textOf({});\n64:     expect(t.name).toBe(\"Emma Lindqvist\");\n65:     expect(t.club).toBe(\"OK Klyftamo\");\n66:     expect(t.class).toBe(\" \\u00b7 W21E\");\n67:     expect(t.course).toBe(\"Middle, 4.2 km\");\n68:     expect(t.finish).toBe(\"45:02\");\n69:     expect(t[\"finish-label\"]).toBe(\"FINISH\");\n70:     expect(t[\"place-label\"]).toBe(\"PLACE\");\n71:     expect(t.place).toBe(\"#12\");\n72:     expect(t.behind).toBe(\"+1:23\");\n73:     for (const ctrl of [\"1\", \"2\", \"5\", \"9\", \"F\"]) {\n74:       const i = DEFAULT_LEGS.findIndex((s) => s.control === ctrl);\n75:       expect(t[`ctrl-${i}`]).toBe(ctrl);\n76:     }\n77:     expect(t[\"split-0\"]).toBe(\"4:08\");\n78:     expect(t[\"split-6\"]).toBe(\"1:32\");\n79:     expect(t[\"loss-0\"]).toBe(\"+0:47\");\n80:     expect(t[\"loss-4\"]).toBe(\"+1:20\");\n81:     expect(t[\"loss-8\"]).toBe(\"+0:51\");\n82:     expect(t[\"split-1\"]).toBe(\"2:41\");\n83:     expect(t[\"time-wo\"]).toBe(\"42:04\");\n84:     expect(t[\"total-loss\"]).toBe(\"+2:58\");\n85:     expect(t[\"best-leg\"]).toBe(\"1:32\");\n86:     expect(t[\"split-4\"]).toBe(\"5:22\");\n87:   });\n88: \n89:   it(\"computes the footer from the entered numbers and never from the split sum\", () => {\n90:     const n = normalizeSplitCard({});\n91:     expect(n.totalLossSec).toBe(178);\n92:     expect(n.totalLossText).toBe(\"+2:58\");\n93:     expect(n.timeWoText).toBe(\"42:04\");\n94:     expect(n.bestText).toBe(\"1:32\");\n95:     expect(n.slowestSec).toBe(322);\n96:     // finish is printed as entered, not checked against the split sum\n97:     expect(n.finish).toBe(\"45:02\");\n98:     expect(n.legs.filter((l) => l.isMistake).length).toBe(3);\n99:     expect(formatSplitTime(n.finishSec - n.totalLossSec)).toBe(\"42:04\");\n100:   });\n101: \n102:   it(\"draws a shared tape: bar length = split / slowest, mistake legs pink, clean legs neutral and blank\", () => {\n103:     const L = layoutSplitCard({}, 1280, 720);\n104:     const rail = L.tiles.find((t) => t.label === \"rail-0\")!;\n105:     expect(rail.rect.w / 1280).toBeGreaterThanOrEqual(0.32);\n106:     const bars = L.p.legs.map((_, i) => L.tiles.find((t) => t.label === `bar-${i}`)!);\n107:     for (const b of bars) expect(b.rect.w).toBeGreaterThanOrEqual(1);\n108:     // slowest leg (index 4, 5:22) fills the track\n109:     expect(bars[4].rect.w).toBeGreaterThanOrEqual(bars[0].rect.w);\n110:     expect(bars[4].rect.w).toBeGreaterThanOrEqual(bars[6].rect.w);\n111:     for (const leg of L.p.legs) {\n112:       const b = L.tiles.find((t) => t.label === `bar-${leg.index}`)!;\n113:       if (leg.isMistake) expect(b.color).toBe(L.p.accent);\n114:       else expect(b.color).not.toBe(L.p.accent);\n115:     }\n116:     // clean legs leave the loss cell blank\n117:     expect(L.cells.some((c) => c.label === \"loss-1\")).toBe(false);\n118:     expect(L.cells.some((c) => c.label === \"loss-0\")).toBe(true);\n119:     const finish = L.cells.find((c) => c.label === \"finish\")!;\n120:     for (const c of L.cells) if (c.label !== \"finish\") expect(c.px).toBeLessThan(finish.px);\n121:   });\n122: \n123:   it(\"parses compact times and refuses decimals, hours in a loss, and over-long times\", () => {\n124:     expect(parseSplitTime(\"4:08\")).toBe(248);\n125:     expect(parseSplitTime(\"45:02\")).toBe(2702);\n126:     expect(parseSplitTime(\"1:11:40\")).toBe(4300);\n127:     expect(formatSplitTime(248)).toBe(\"4:08\");\n128:     expect(formatSplitTime(178)).toBe(\"2:58\");\n129:     expect(formatSplitTime(2524)).toBe(\"42:04\");\n130:     for (const bad of [\"\", \"4:8\", \"4:60\", \"45:02.5\", \"abc\", \"4.20\"]) expect(parseSplitTime(bad)).toBeNull();\n131:   });\n132: \n133:   it(\"keeps the finish the hero and the contract at the seven canvases, including the stress copy\", async () => {\n134:     expect(layoutIntentOf(await render())).not.toBeNull();\n135:     for (const over of [\n136:       {},\n137:       { preset: \"light\" },\n138:       { place: 0 },\n139:       { name: \"\", club: \"\", className: \"\", course: \"\" },\n140:       { behind: \"\" },\n141:       longClub,\n142:       { ...longClub, preset: \"light\", accent: \"#2f6f62\" },\n143:       { splits: fourLegs },\n144:       lastLegMistake,\n145:       { splits: DEFAULT_LEGS.map((s, i) => (i === 4 ? { ...s, loss: \"0:00\" } : s)) },\n146:     ] as OrienteeringSplitAnalysisProps[]) {\n147:       await sweepLayout((p, ctx) => T.render(p, ctx).then(asDocument), ID, over, (w, h) => targetCtx(w, h));\n148:     }\n149:     // an 18-leg course fits everywhere but the 480x270 floor\n150:     await sweepLayout(\n151:       (p, ctx) => T.render(p, ctx).then(asDocument),\n152:       ID,\n153:       { splits: eighteen },\n154:       (w, h) => targetCtx(w, h),\n155:       CONTRACT_CANVASES.filter(([w, h]) => !(w === 480 && h === 270)),\n156:     );\n157:     await expect(render({ splits: eighteen }, 480, 270)).rejects.toThrow(/leg rows|floor/);\n158:     expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n159:     const ev = evaluateM0(String((await render()).m0), { width: 1280, height: 720 });\n160:     expect(ev.feasible && ev.meetsPrecision).toBe(true);\n161:   });\n162: \n163:   it(\"binds every prop-driven string and keeps the page colour off the canvas rect\", async () => {\n164:     const doc = await render();\n165:     const { byProp, rejected } = resolvePropBindings(doc, 1280, 720, { propsSchema: T.propsSchema });\n166:     expect(rejected).toEqual([]);\n167:     expect(byProp.name).toHaveLength(1);\n168:     expect(byProp.club).toHaveLength(1);\n169:     expect(byProp.className).toHaveLength(1);\n170:     expect(byProp.course).toHaveLength(1);\n171:     expect(byProp.finish).toHaveLength(1);\n172:     expect(byProp.place).toHaveLength(1);\n173:     expect(byProp.behind).toHaveLength(1);\n174:     expect(byProp.accent.length).toBeGreaterThanOrEqual(1);\n175:     // 13 legs: control + split on every leg, loss only on the three mistakes\n176:     expect(byProp.splits.length).toBe(13 + 13 + 3);\n177:     expect(doc.backgroundColor).toBe(\"#14111d\");\n178:     expect((await render({ preset: \"light\" })).backgroundColor).toBe(\"#f6f2ef\");\n179:     const noChip = await render({ place: 0, behind: \"\", name: \"\", club: \"\", className: \"\", course: \"\" });\n180:     const kept = resolvePropBindings(noChip, 1280, 720, { propsSchema: T.propsSchema });\n181:     expect(kept.rejected).toEqual([]);\n182:     expect(kept.byProp.place).toBeUndefined();\n183:     expect(kept.byProp.behind).toBeUndefined();\n184:     expect(kept.byProp.finish).toHaveLength(1);\n185:   });\n186: \n187:   it(\"is deterministic and fails fast, naming the field\", async () => {\n188:     expect(await render()).toEqual(await render());\n189:     const bad = async (p: OrienteeringSplitAnalysisProps, field: string) => {\n190:       await expect(render(p)).rejects.toThrow(new RegExp(field.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\")));\n191:     };\n192:     await bad({ finish: \"45:02.5\" }, \"finish\");\n193:     await bad({ finish: \"abc\" }, \"finish\");\n194:     await bad({ finish: \"100:00:00\" }, \"finish\");\n195:     await bad({ splits: DEFAULT_LEGS.slice(0, 3) }, \"splits\");\n196:     await bad({ splits: [...DEFAULT_LEGS, ...DEFAULT_LEGS.slice(0, 6)] }, \"splits\");\n197:     await bad({ splits: DEFAULT_LEGS.map((s, i) => (i === 0 ? { ...s, loss: \"1:00:00\" } : s)) }, \"splits[0].loss\");\n198:     await bad({ splits: DEFAULT_LEGS.map((s, i) => (i === 3 ? { ...s, split: \"0:00\" } : s)) }, \"splits[3].split\");\n199:     await bad({ splits: DEFAULT_LEGS.map((s, i) => (i === 0 ? { ...s, control: \"\" } : s)) }, \"splits[0].control\");\n200:     await bad({ place: 10000 }, \"place\");\n201:     await bad({ place: 1.5 }, \"place\");\n202:     await bad({ name: \"Emma \\u2192 Lindqvist\" }, \"name\");\n203:     await bad({ name: \"X\".repeat(41) }, \"name\");\n204:     await bad({ preset: \"sepia\" as \"dark\" }, \"preset\");\n205:     await bad({ accent: \"pink\" }, \"accent\");\n206:     await bad({ splits: \"not json\" }, \"splits\");\n207:   });\n208: \n209:   it(\"refuses losses that sum past the finish\", async () => {\n210:     const big = DEFAULT_LEGS.map((s) => ({ ...s, loss: \"4:00\" }));\n211:     await expect(render({ splits: big })).rejects.toThrow(/more than the finish/);\n212:   });\n213: });\n\n(End of file - total 213 lines)\n</content>","metadata":{"preview":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { resolvePropBindings } from \"@m0saic/template-utils\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { CONTRACT_CANVASES, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport {\n  DEFAULT_LEGS,\n  OrienteeringSplitAnalysisV1 as T,\n  formatSplitTime,\n  layoutSplitCard,\n  normalizeSplitCard,\n  parseSplitTime,\n} from \"./orienteering-split-analysis\";\nimport type { OrienteeringLeg, OrienteeringSplitAnalysisProps } from \"./orienteering-split-analysis\";\n\nconst ID = \"@one-a-day/sports/orienteering-split-analysis/v1\";\nconst render = (p: OrienteeringSplitAnalysisProps = {}, w = 1280, h = 720) => T.render(p, targetCtx(w, h)).then(asDocument);\nconst textOf = (p: OrienteeringSplitAnalysisProps, w = 1280, h = 720) =>\n  Object.fromEntries(layoutSplitCard(p, w, h).cells.map((c) => [c.label, c.text]));\n","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-24\\variants\\a\\src\\orienteering-split-analysis.test.ts","text":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { resolvePropBindings } from \"@m0saic/template-utils\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { CONTRACT_CANVASES, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport {\n  DEFAULT_LEGS,\n  OrienteeringSplitAnalysisV1 as T,\n  formatSplitTime,\n  layoutSplitCard,\n  normalizeSplitCard,\n  parseSplitTime,\n} from \"./orienteering-split-analysis\";\nimport type { OrienteeringLeg, OrienteeringSplitAnalysisProps } from \"./orienteering-split-analysis\";\n\nconst ID = \"@one-a-day/sports/orienteering-split-analysis/v1\";\nconst render = (p: OrienteeringSplitAnalysisProps = {}, w = 1280, h = 720) => T.render(p, targetCtx(w, h)).then(asDocument);\nconst textOf = (p: OrienteeringSplitAnalysisProps, w = 1280, h = 720) =>\n  Object.fromEntries(layoutSplitCard(p, w, h).cells.map((c) => [c.label, c.text]));\n\n/** An 18-leg long-course stress list. */\nconst eighteen: OrienteeringLeg[] = [\n  { control: \"1\", split: \"4:08\", loss: \"0:47\" },\n  { control: \"2\", split: \"2:41\", loss: \"0:00\" },\n  { control: \"3\", split: \"3:15\", loss: \"0:00\" },\n  { control: \"4\", split: \"2:58\", loss: \"0:00\" },\n  { control: \"5\", split: \"5:22\", loss: \"1:20\" },\n  { control: \"6\", split: \"3:40\", loss: \"0:00\" },\n  { control: \"7\", split: \"1:32\", loss: \"0:00\" },\n  { control: \"8\", split: \"4:05\", loss: \"0:00\" },\n  { control: \"9\", split: \"3:51\", loss: \"0:51\" },\n  { control: \"10\", split: \"2:44\", loss: \"0:00\" },\n  { control: \"11\", split: \"3:33\", loss: \"0:00\" },\n  { control: \"12\", split: \"4:11\", loss: \"0:00\" },\n  { control: \"13\", split: \"2:55\", loss: \"0:00\" },\n  { control: \"14\", split: \"3:02\", loss: \"0:00\" },\n  { control: \"15\", split: \"4:30\", loss: \"0:00\" },\n  { control: \"16\", split: \"2:20\", loss: \"0:00\" },\n  { control: \"17\", split: \"3:48\", loss: \"0:00\" },\n  { control: \"F\", split: \"1:55\", loss: \"0:00\" },\n];\n\nconst fourLegs: OrienteeringLeg[] = [\n  { control: \"1\", split: \"3:10\", loss: \"0:00\" },\n  { control: \"2\", split: \"2:50\", loss: \"0:00\" },\n  { control: \"3\", split: \"3:40\", loss: \"0:25\" },\n  { control: \"F\", split: \"1:10\", loss: \"0:00\" },\n];\n\nconst longClub: OrienteeringSplitAnalysisProps = {\n  name: \"Maximiliana Wolfeschlegelstein\",\n  club: \"Ytterhogdals IK Orientering\",\n  className: \"D21E\",\n  course: \"Long distance, 9.8 km, 24 controls\",\n};\n\nconst lastLegMistake: OrienteeringSplitAnalysisProps = {\n  splits: DEFAULT_LEGS.map((s, i) => (i === DEFAULT_LEGS.length - 1 ? { ...s, loss: \"0:47\" } : s)),\n};\n\ndescribe(ID, () => {\n  it(\"shows the sample card at defaults: finish hero, place chip, pink mistakes, computed footer\", () => {\n    const t = textOf({});\n    expect(t.name).toBe(\"Emma Lindqvist\");\n    expect(t.club).toBe(\"OK Klyftamo\");\n    expect(t.class).toBe(\" \\u00b7 W21E\");\n    expect(t.course).toBe(\"Middle, 4.2 km\");\n    expect(t.finish).toBe(\"45:02\");\n    expect(t[\"finish-label\"]).toBe(\"FINISH\");\n    expect(t[\"place-label\"]).toBe(\"PLACE\");\n    expect(t.place).toBe(\"#12\");\n    expect(t.behind).toBe(\"+1:23\");\n    for (const ctrl of [\"1\", \"2\", \"5\", \"9\", \"F\"]) {\n      const i = DEFAULT_LEGS.findIndex((s) => s.control === ctrl);\n      expect(t[`ctrl-${i}`]).toBe(ctrl);\n    }\n    expect(t[\"split-0\"]).toBe(\"4:08\");\n    expect(t[\"split-6\"]).toBe(\"1:32\");\n    expect(t[\"loss-0\"]).toBe(\"+0:47\");\n    expect(t[\"loss-4\"]).toBe(\"+1:20\");\n    expect(t[\"loss-8\"]).toBe(\"+0:51\");\n    expect(t[\"split-1\"]).toBe(\"2:41\");\n    expect(t[\"time-wo\"]).toBe(\"42:04\");\n    expect(t[\"total-loss\"]).toBe(\"+2:58\");\n    expect(t[\"best-leg\"]).toBe(\"1:32\");\n    expect(t[\"split-4\"]).toBe(\"5:22\");\n  });\n\n  it(\"computes the footer from the entered numbers and never from the split sum\", () => {\n    const n = normalizeSplitCard({});\n    expect(n.totalLossSec).toBe(178);\n    expect(n.totalLossText).toBe(\"+2:58\");\n    expect(n.timeWoText).toBe(\"42:04\");\n    expect(n.bestText).toBe(\"1:32\");\n    expect(n.slowestSec).toBe(322);\n    // finish is printed as entered, not checked against the split sum\n    expect(n.finish).toBe(\"45:02\");\n    expect(n.legs.filter((l) => l.isMistake).length).toBe(3);\n    expect(formatSplitTime(n.finishSec - n.totalLossSec)).toBe(\"42:04\");\n  });\n\n  it(\"draws a shared tape: bar length = split / slowest, mistake legs pink, clean legs neutral and blank\", () => {\n    const L = layoutSplitCard({}, 1280, 720);\n    const rail = L.tiles.find((t) => t.label === \"rail-0\")!;\n    expect(rail.rect.w / 1280).toBeGreaterThanOrEqual(0.32);\n    const bars = L.p.legs.map((_, i) => L.tiles.find((t) => t.label === `bar-${i}`)!);\n    for (const b of bars) expect(b.rect.w).toBeGreaterThanOrEqual(1);\n    // slowest leg (index 4, 5:22) fills the track\n    expect(bars[4].rect.w).toBeGreaterThanOrEqual(bars[0].rect.w);\n    expect(bars[4].rect.w).toBeGreaterThanOrEqual(bars[6].rect.w);\n    for (const leg of L.p.legs) {\n      const b = L.tiles.find((t) => t.label === `bar-${leg.index}`)!;\n      if (leg.isMistake) expect(b.color).toBe(L.p.accent);\n      else expect(b.color).not.toBe(L.p.accent);\n    }\n    // clean legs leave the loss cell blank\n    expect(L.cells.some((c) => c.label === \"loss-1\")).toBe(false);\n    expect(L.cells.some((c) => c.label === \"loss-0\")).toBe(true);\n    const finish = L.cells.find((c) => c.label === \"finish\")!;\n    for (const c of L.cells) if (c.label !== \"finish\") expect(c.px).toBeLessThan(finish.px);\n  });\n\n  it(\"parses compact times and refuses decimals, hours in a loss, and over-long times\", () => {\n    expect(parseSplitTime(\"4:08\")).toBe(248);\n    expect(parseSplitTime(\"45:02\")).toBe(2702);\n    expect(parseSplitTime(\"1:11:40\")).toBe(4300);\n    expect(formatSplitTime(248)).toBe(\"4:08\");\n    expect(formatSplitTime(178)).toBe(\"2:58\");\n    expect(formatSplitTime(2524)).toBe(\"42:04\");\n    for (const bad of [\"\", \"4:8\", \"4:60\", \"45:02.5\", \"abc\", \"4.20\"]) expect(parseSplitTime(bad)).toBeNull();\n  });\n\n  it(\"keeps the finish the hero and the contract at the seven canvases, including the stress copy\", async () => {\n    expect(layoutIntentOf(await render())).not.toBeNull();\n    for (const over of [\n      {},\n      { preset: \"light\" },\n      { place: 0 },\n      { name: \"\", club: \"\", className: \"\", course: \"\" },\n      { behind: \"\" },\n      longClub,\n      { ...longClub, preset: \"light\", accent: \"#2f6f62\" },\n      { splits: fourLegs },\n      lastLegMistake,\n      { splits: DEFAULT_LEGS.map((s, i) => (i === 4 ? { ...s, loss: \"0:00\" } : s)) },\n    ] as OrienteeringSplitAnalysisProps[]) {\n      await sweepLayout((p, ctx) => T.render(p, ctx).then(asDocument), ID, over, (w, h) => targetCtx(w, h));\n    }\n    // an 18-leg course fits everywhere but the 480x270 floor\n    await sweepLayout(\n      (p, ctx) => T.render(p, ctx).then(asDocument),\n      ID,\n      { splits: eighteen },\n      (w, h) => targetCtx(w, h),\n      CONTRACT_CANVASES.filter(([w, h]) => !(w === 480 && h === 270)),\n    );\n    await expect(render({ splits: eighteen }, 480, 270)).rejects.toThrow(/leg rows|floor/);\n    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n    const ev = evaluateM0(String((await render()).m0), { width: 1280, height: 720 });\n    expect(ev.feasible && ev.meetsPrecision).toBe(true);\n  });\n\n  it(\"binds every prop-driven string and keeps the page colour off the canvas rect\", async () => {\n    const doc = await render();\n    const { byProp, rejected } = resolvePropBindings(doc, 1280, 720, { propsSchema: T.propsSchema });\n    expect(rejected).toEqual([]);\n    expect(byProp.name).toHaveLength(1);\n    expect(byProp.club).toHaveLength(1);\n    expect(byProp.className).toHaveLength(1);\n    expect(byProp.course).toHaveLength(1);\n    expect(byProp.finish).toHaveLength(1);\n    expect(byProp.place).toHaveLength(1);\n    expect(byProp.behind).toHaveLength(1);\n    expect(byProp.accent.length).toBeGreaterThanOrEqual(1);\n    // 13 legs: control + split on every leg, loss only on the three mistakes\n    expect(byProp.splits.length).toBe(13 + 13 + 3);\n    expect(doc.backgroundColor).toBe(\"#14111d\");\n    expect((await render({ preset: \"light\" })).backgroundColor).toBe(\"#f6f2ef\");\n    const noChip = await render({ place: 0, behind: \"\", name: \"\", club: \"\", className: \"\", course: \"\" });\n    const kept = resolvePropBindings(noChip, 1280, 720, { propsSchema: T.propsSchema });\n    expect(kept.rejected).toEqual([]);\n    expect(kept.byProp.place).toBeUndefined();\n    expect(kept.byProp.behind).toBeUndefined();\n    expect(kept.byProp.finish).toHaveLength(1);\n  });\n\n  it(\"is deterministic and fails fast, naming the field\", async () => {\n    expect(await render()).toEqual(await render());\n    const bad = async (p: OrienteeringSplitAnalysisProps, field: string) => {\n      await expect(render(p)).rejects.toThrow(new RegExp(field.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\")));\n    };\n    await bad({ finish: \"45:02.5\" }, \"finish\");\n    await bad({ finish: \"abc\" }, \"finish\");\n    await bad({ finish: \"100:00:00\" }, \"finish\");\n    await bad({ splits: DEFAULT_LEGS.slice(0, 3) }, \"splits\");\n    await bad({ splits: [...DEFAULT_LEGS, ...DEFAULT_LEGS.slice(0, 6)] }, \"splits\");\n    await bad({ splits: DEFAULT_LEGS.map((s, i) => (i === 0 ? { ...s, loss: \"1:00:00\" } : s)) }, \"splits[0].loss\");\n    await bad({ splits: DEFAULT_LEGS.map((s, i) => (i === 3 ? { ...s, split: \"0:00\" } : s)) }, \"splits[3].split\");\n    await bad({ splits: DEFAULT_LEGS.map((s, i) => (i === 0 ? { ...s, control: \"\" } : s)) }, \"splits[0].control\");\n    await bad({ place: 10000 }, \"place\");\n    await bad({ place: 1.5 }, \"place\");\n    await bad({ name: \"Emma \\u2192 Lindqvist\" }, \"name\");\n    await bad({ name: \"X\".repeat(41) }, \"name\");\n    await bad({ preset: \"sepia\" as \"dark\" }, \"preset\");\n    await bad({ accent: \"pink\" }, \"accent\");\n    await bad({ splits: \"not json\" }, \"splits\");\n  });\n\n  it(\"refuses losses that sum past the finish\", async () => {\n    const big = DEFAULT_LEGS.map((s) => ({ ...s, loss: \"4:00\" }));\n    await expect(render({ splits: big })).rejects.toThrow(/more than the finish/);\n  });\n});","lineStart":1,"lineEnd":213,"totalLines":213,"truncated":false}},"title":"journal\\2026-10-24\\variants\\a\\src\\orienteering-split-analysis.test.ts","time":{"start":1792858843168,"end":1792858843176}},"id":"prt_16eb6e707001SHmeXUfDqs5Z5Q","sessionID":"ses_e914a8a92ffed6Ny0syywiP6Oa","messageID":"msg_16eb6d34c001h81hnjOS7uNn7L"}}
