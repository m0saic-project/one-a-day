"calls\": 1,\n      \"lastExitCode\": 0,\n      \"timedOut\": false,\n      \"ms\": 2426157,\n      \"done\": true\n    }\n  },\n  \"result\": {\n    \"status\": \"no-ship\",\n    \"templateId\": null,\n    \"reason\": \"scout phase did not complete\"\n  },\n  \"gate\": {\n    \"reasons\": [],\n    \"at\": \"2026-10-24T13:13:22.716Z\"\n  }\n}","lineStart":1,"lineEnd":61,"totalLines":61,"truncated":false}},"title":"journal\\2026-10-24\\run.json","time":{"start":1792858832443,"end":1792858832460}},"id":"prt_16eb6bd41001FWVfuq7q8MD8Dn","sessionID":"ses_e914a8a92ffed6Ny0syywiP6Oa","messageID":"msg_16eb5777e001LOM2ZMSl5DHkbN"}}
