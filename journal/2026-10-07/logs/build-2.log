Layout?: boolean;\n47\t};\n48\t\n49\tconst ID = \"@one-a-day/sports/chess-game-recap/v1\";\n50\tconst INK = \"#eaeef2\" as MosaicColor;\n51\tconst DIM = \"#9aa7b4\" as MosaicColor;\n52\tconst PAGE = \"#1c2833\" as MosaicColor;\n53\tconst WIN_COLOR = \"#2caf45\" as MosaicColor;\n54\tconst LOSS_COLOR = \"#d84849\" as MosaicColor;\n55\tconst DRAW_COLOR = \"#8b92a1\" as MosaicColor;\n56\tconst DEFAULT_OPENING = \"King's Indian Defense\";\n57\tconst DEFAULT_RESULT = \"win\" as const;\n58\tconst DEFAULT_RATING = 25;\n59\tconst DEFAULT_TIME = \"10+5\";\n60\tconst DEFAULT_DATE = \"2026-10-07\";\n61\tconst DEFAULT_OPPONENT = \"Opponent\";\n62\t\n63\tconst propsSchema = definePropsSchema<ChessGameRecapProps>({\n64\t  opening: {\n65\t    type: \"string\",\n66\t    required: false,\n67\t    description: \"The chess opening name.\",\n68\t    meta: { control: { placeholder: DEFAULT_OPENING }, ui: { label: \"Opening\", order: 1 } },\n69\t  },\n70\t  result: {\n71\t    type: \"string\",\n72\t    required: false,\n73\t    description: \"Game result: win, loss, or draw.\",\n74\t    meta: { ui: { label: \"Result\", order: 2 } },\n75\t  },\n76\t  ratingChange: {\n77\t    type: \"number\",\n78\t    required: false,\n79\t    description: \"Rating delta.\",\n80\t    meta: { ui: { label: \"Rating Change\", order: 3 } },\n81\t  },\n82\t  timeControl: {\n83\t    type: \"string\",\n84\t    required: false,\n85\t    description: \"Time control format (e.g., 10+5, 5+3).\",\n86\t    meta: { control: { placeholder: DEFAULT_TIME }, ui: { label: \"Time Control\", order: 4 } },\n87\t  },\n88\t  date: {\n89\t    type: \"string\",\n90\t    required: false,\n91\t    description: \"Game date in YYYY-MM-DD format.\",\n92\t    meta: { control: { placeholder: DEFAULT_DATE }, ui: { label: \"Date\", order: 5 } },\n93\t  },\n94\t  opponentName: {\n95\t    type: \"string\",\n96\t    required: false,\n97\t    description: \"Opponent name.\",\n98\t    meta: { control: { placeholder: DEFAULT_OPPONENT }, ui: { label: \"Opponent\", order: 6 } },\n99\t  },\n100\t  debugLayout: {\n101\t    type: \"boolean\",\n102\t    required: false,\n103\t    description: \"Dev-only: check the layout contract and draw it over the card.\",\n104\t    meta: { ui: { label: \"Debug layout\", order: 99 } },\n105\t  },\n106\t});\n107\t\n108\t/**\n109\t * What the geometry promises: opening name fits the header (top 18%), result\n110\t * and stats fit their columns, footer text fits the bottom band (22%).\n111\t */\n112\tfunction layoutContract(): LayoutConstraint[] {\n113\t  return [\n114\t    ...textFitsAll([\"opening\", \"result\", \"time\", \"rating\", \"date\", \"opponent\"], { charWidthEm: TEXT_EM.prose }),\n115\t    { label: \"opening\", within: { yFrac: [0, 0.18] }, minWidthFrac: 0.85 },\n116\t    { label: \"result\", within: { yFrac: [0.18, 0.78] } },\n117\t    { label: \"time\", within: { yFrac: [0.18, 0.78] } },\n118\t    { label: \"rating\", within: { yFrac: [0.18, 0.78] } },\n119\t    { label: \"date\", within: { yFrac: [0.78, 1] } },\n120\t    { label: \"opponent\", within: { yFrac: [0.78, 1] } },\n121\t  ];\n122\t}\n123\t\n124\t/**\n125\t * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n126\t * convention, src/_shared/why.ts): the run, the problem with the sources the\n127\t * agent opened, the solution, how to use it, then the template itself.\n128\t * Pre-filled from journal/2026-10-07/ - replace every \"[fill me]\" and say it\n129\t * in the evidence's own words. The build refuses a placeholder.\n130\t */\n131\tconst WHY: WhySpec = {\n132\t  \"day\": 18,\n133\t  \"date\": \"2026-10-07\",\n134\t  \"agent\": \"claude\",\n135\t  \"model\": \"claude-haiku-4-5-20251001\",\n136\t  \"id\": \"@one-a-day/sports/chess-game-recap/v1\",\n137\t  \"title\": \"Chess Game Recap\",\n138\t  \"who\": \"Chess players on Lichess and Chess.com, streamers analyzing games, and players sharing rating milestones in online communities.\",\n139\t  \"problem\": [\n140\t    \"Players 