kup.\n */\n\nexport type HyroxSplit = { run: string; station: string; place?: number };\n\nexport type HyroxSplitCardProps = {\n  /** Header name. Up to 32 characters; accented Latin letters are drawn. \"\" hides it. */\n  athlete?: string;\n  /** Second header line. Up to 40 characters. \"\" hides it. */\n  race?: string;\n  /** Third header line; the age group lives here. Up to 32 characters. \"\" hides it. */\n  division?: string;\n  /** The hero figure, compact time: \"1:11:40\" or \"71:40\". A decimal fails fast. */\n  finish?: string;\n  /** Division rank. Integer 0-99999; 0 hides the chip. */","lineStart":1,"lineEnd":40,"totalLines":770,"truncated":true}},"title":"src\\sports\\hyrox-split-card\\v1\\hyrox-split-card.ts","time":{"start":1792418767539,"end":1792418767719}},"metadata":{"openai":{"itemId":"fc_529c98e7-9821-994d-ae2c-78e59b363870_1"}},"id":"prt_1547be2a8001g769t6z70jX5wS","sessionID":"ses_eab9286adffefIgH30nghYVaCI","messageID":"msg_1547bd37c001BKdCHeta3jQJnN"}}
