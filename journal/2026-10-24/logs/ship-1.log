{"type":"tool_use","timestamp":1792859351334,"sessionID":"ses_e9141cfbdffenLAFgwFuHpfkdd","part":{"type":"tool","tool":"read","callID":"call_01_Wx8ZhEcaLLoUuUT4TFfq0701","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\tools\\check-why.mjs"},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\tools\\check-why.mjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: /**\n3:  * The why-tutorial gate — every template in this repo explains itself.\n4:  *\n5:  * Runs at the end of `npm run build` (after check-registry, so dist/ is\n6:  * fresh and every template already passed the platform conventions) and in\n7:  * the daily gate. For every template except the repo's front door\n8:  * (`repo.helloWorld`, the one human-placed template) and the `harness` pack\n9:  * (internal fixtures, human-maintained, never a day's work) it checks:\n10:  *\n11:  *   1. `renderTutorial` exists and was built by `whyTutorial(WHY, render)`\n12:  *      from src/_shared/why.ts — the spec is in the helper's registry.\n13:  *   2. The spec agrees with the journal: `journal/<date>/` exists, `day` is\n14:  *      that date's day number, and when `journal/<date>/run.json` is there,\n15:  *      `agent` / `model` match what the runner and the agent recorded. These\n16:  *      are ERRORS for a template that is not frozen yet (today's work - the\n17:  *      journal must agree before it ships) and WARNINGS for a frozen one (it\n18:  *      cannot change any more; a pruned journal must not break the build).\n19:  *   3. It renders (1280x720 and 1080x1920, design mode, no media) as a\n20:  *      pipeline of at least six steps: the four chrome pages in order\n21:  *      (cover, problem, solution, use it), the template itself (its m0\n22:  *      equals the template's own default render), then \"how it was made\"\n23:  *      (the harness timeline) last — and every step's m0 validates and\n24:  *      keeps its page's layout contract.\n25:  *      A founder-directed follow-up (vN, N >= 2, with its own\n26:  *      journal/<date>/vN/run.json - tools/record-dir.mjs) is held to ITS\n27:  *      run.json and trace.json; the day number and date stay the day's.\n28:  *   4. `WHY.timeline` agrees with `journal/<date>/trace.json` when the runner\n29:  *      wrote one: every phase named is in the trace and its duration is\n30:  *      within 25% (the ship phase is exempt - it is still running when the\n31:  *      agent writes the spec). A `self-reported` timeline with a trace on\n32:  *      disk is an error while unfrozen.\n33:  *\n34:  * The spec's content rules (budget, ASCII, real URLs, no scaffold\n35:  * placeholder) throw at import inside `whyTutorial`, so a bad spec already\n36:  * failed at `require(\"../dist/index.js\")` above; this file is about presence,\n37:  * honesty against the journal, and the rendered shape.\n38:  *\n39:  *   node tools/check-why.mjs          human log lines, exit 1 on any error\n40:  *   node tools/check-why.mjs --json   one report on stdout, same exit code\n41:  */\n42: import fs from \"node:fs\";\n43: import path from \"node:path\";\n44: import { createRequire } from \"node:module\";\n45: import { fileURLToPath } from \"node:url\";\n46: import { recordDirFor } from \"./record-dir.mjs\";\n47: \n48: const require = createRequire(import.meta.url);\n49: const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n50: process.env.M0SAIC_CLI ??= \"/usr/bin/false\";\n51: const JSON_OUT = process.argv.includes(\"--json\");\n52: \n53: const report = { ok: true, templates: 0, checked: 0, errors: [], warnings: [], notes: [] };\n54: const say = (...a) => { if (!JSON_OUT) console.log(...a); };\n55: const fail = (...a) => { if (!JSON_OUT) console.error(...a); };\n56: const finish = (code) => {\n57:   if (JSON_OUT) { report.ok = code === 0; process.stdout.write(JSON.stringify(report, null, 2) + \"\\n\"); }\n58:   process.exit(code);\n59: };\n60: const error = (templateId, key, detail) => report.errors.push({ templateId, convention: \"whyTutorial\", severity: \"error\", key, detail, fix: FIX });\n61: const warn = (templateId, key, detail) => report.warnings.push({ templateId, convention: \"whyTutorial\", severity: \"warning\", key, detail, fix: FIX });\n62: const FIX =\n63:   \"every template explains why it exists: `renderTutorial: whyTutorial(WHY, render)` from src/_shared/why.ts, with WHY filled from the day's journal \" +\n64:   \"(day, date, agent, model as run.json declares them; who; the observed problem; the sources actually opened; the solution; the render one-liner). \" +\n65:   \"The scaffold writes the skeleton; replace every \" + \"[fill me]\" + \"; copy timeline from journal/<date>/trace.json in the ship phase. It renders as six steps: cover, problem, solution, use it, the template, how it was made.\";\n66: \n67: let entry, why, layout, dsl;\n68: try {\n69:   entry = require(\"../dist/index.js\");\n70:   why = require(\"../dist/_shared/why.js\");\n71:   layout = require(\"../dist/_shared/layout.js\");\n72:   dsl = require(\"@m0saic/dsl\");\n73: } catch (err) {\n74:   fail(`\\n[check-why] ✗ could not load dist/ (run the build first): ${err && err.message ? err.message : err}\\n`);\n75:   finish(1);\n76: }\n77: \n78: const templates = Array.isArray(entry.templates) ? entry.templates : [];\n79: const repo = entry.repo ?? entry.TEMPLATE_REPO ?? {};\n80: const frontDoor = repo.helloWorld ? String(repo.helloWorld) : null;\n81: report.templates = templates.length;\n82: \n83: const ctxFor = (width, height) => {\n84:   const target = { width, height, fps: 30, durationMs: 2000 };\n85:   return { mode: \"design\", target, output: { ...target, workspaceDir: path.join(ROOT, \"test-output\", \"why\") }, media: {} };\n86: };\n87: \n88: const readJson = (file, fallback = null) => { try { return JSON.parse(fs.readFileSync(file, \"utf8\")); } catch { return fallback; } };\n89: const indexRows = (() => { const v = readJson(path.join(ROOT, \"journal\", \"index.json\"), []); return Array.isArray(v) ? v : []; })();\n90: const frozenFiles = Object.keys(readJson(path.join(ROOT, \"frozen.manifest.json\"), {})?.files ?? {});\n91: const srcDirOf = (id) => { const m = /^@[^/]+\\/([^/]+)\\/([^/]+)\\/(v\\d+)$/.exec(id); return m ? `src/${m[1]}/${m[2]}/${m[3]}/` : null; };\n92: const dayNumberFor = (date) => {\n93:   const existing = indexRows.find((r) => r.date === date);\n94:   if (existing && existing.day) return existing.day;\n95:   return indexRows.filter((r) => r.date < date).length + 1;\n96: };\n97: \n98: for (const t of templates) {\n99:   const id = String(t.id);\n100:   if (frontDoor && id === frontDoor) { report.notes.push(`${id}: the front door is exempt (human-placed, not a day's work)`); continue; }\n101:   if (id.startsWith(`${repo.repoId ?? \"@one-a-day\"}/harness/`)) { report.notes.push(`${id}: harness fixtures are exempt (internal, human-maintained)`); continue; }\n102:   report.checked += 1;\n103: \n104:   // ── 1. presence, via the helper ──\n105:   if (typeof t.renderTutorial !== \"function\") { error(id, \"missing\", \"no renderTutorial - the template does not explain why it exists\"); continue; }\n106:   const spec = typeof why.whySpecFor === \"function\" ? why.whySpecFor(id) : undefined;\n107:   if (!spec) { error(id, \"not-why\", \"renderTutorial is not built by whyTutorial() from src/_shared/why.ts (no spec registered for this id)\"); continue; }\n108: \n109:   // ── 2. honesty against the journal (hard while unfrozen, soft once shipped) ──\n110:   const dir = srcDirOf(id);\n111:   const shipped = dir ? frozenFiles.some((f) => f.startsWith(dir)) : false;\n112:   const journalIssue = shipped ? warn : error;\n113:   const dayDir = path.join(ROOT, \"journal\", spec.date);\n114:   if (!fs.existsSync(dayDir)) journalIssue(id, \"journal\", `WHY.date ${spec.date} has no journal/${spec.date}/ folder${shipped ? \" (frozen template; journal pruned?)\" : \"\"}`);\n115:   else {\n116:     const expectedDay = dayNumberFor(spec.date);\n117:     if (spec.day !== expectedDay) journalIssue(id, \"day\", `WHY.day is ${spec.day}; journal/index.json makes ${spec.date} day ${expectedDay}`);\n118:     const record = recordDirFor(ROOT, id, spec.date);\n119:     const run = readJson(path.join(record.dir, \"run.json\"), null);\n120:     if (!run) warn(id, \"run\", `${record.rel}/run.json is missing - agent / model could not be cross-checked`);\n121:     else {\n122:       const adapter = run.runner && run.runner.adapter ? String(run.runner.adapter) : null;\n123:       const model = run.model && run.model.selfDeclared ? String(run.model.selfDeclared) : null;\n124:       if (adapter && spec.agent !== adapter) journalIssue(id, \"agent\", `WHY.agent is ${JSON.stringify(spec.agent)}; run.json says the adapter was ${JSON.stringify(adapter)}`);\n125:       if (model && spec.model !== model) journalIssue(id, \"model\", `WHY.model is ${JSON.stringify(spec.model)}; run.json model.selfDeclared is ${JSON.stringify(model)}`);\n126:       if (!model) warn(id, \"model\", `run.json has no model.selfDeclared yet; WHY.model ${JSON.stringify(spec.model)} is unverified`);\n127:     }\n128:     // ── the timeline against the runner's trace ──\n129:     const trace = readJson(path.join(record.dir, \"trace.json\"), null);\n130:     const tl = spec.timeline;\n131:     if (trace && Array.isArray(trace.phases) && tl) {\n132:       if (tl.source !== \"runner\") journalIssue(id, \"timeline-source\", `WHY.timeline.source is ${JSON.stringify(tl.source)} but ${record.rel}/trace.json exists - copy the runner's numbers`);\n133:       const byName = new Map(trace.phases.map((ph) => [String(ph.name), ph]));\n134:       for (const ph of tl.phases) {\n135:         const rec = byName.get(String(ph.name));\n136:         if (!rec) { journalIssue(id, \"timeline-phase\", `WHY.timeline names phase ${JSON.stringify(ph.name)}, which is not in trace.json`); continue; }\n137:         if (String(ph.name).startsWith(\"ship\")) continue;\n138:         const ref = Number(rec.durMs ?? 0);\n139:         if (ref > 0 && Math.abs(ph.durMs - ref) > 0.25 * ref) journalIssue(id, \"timeline-duration\", `WHY.timeline ${ph.name} lasts ${ph.durMs} ms; trace.json says ${ref} ms`);\n140:       }\n141:     } else if (tl && tl.source === \"runner\") {\n142:       warn(id, \"timeline-source\", `WHY.timeline.source is \"runner\" but ${record.rel}/trace.json is missing - unverified`);\n143:     }\n144:     // A follow-up may carry its own evidence; it cites the day's scout as well.\n145:     const scouts = [path.join(record.dir, \"10-scout.md\"), path.join(dayDir, \"10-scout.md\")].filter((f) => fs.existsSync(f));\n146:     const scout = scouts[0];\n147:     if (scout) {\n148:       const text = scouts.map((f) => fs.readFileSync(f, \"utf8\")).join(\"\\n\");\n149:       const uncited = spec.sources.filter((u) => !text.includes(u));\n150:       if (uncited.length) warn(id, \"sources\", `${uncited.length} WHY source(s) do not appear in ${scouts.map((f) => path.relative(ROOT, f).split(path.sep).join(\"/\")).join(\" or \")}: ${uncited.slice(0, 3).join(\", \")}${uncited.length > 3 ? \", ...\" : \"\"}`);\n151:     }\n152:   }\n153:   if (spec.id !== id) error(id, \"id\", `WHY.id is ${JSON.stringify(spec.id)}`);\n154:   // the display title and the tags carry the day: \"<date> · <Title>\", tags <date> + day-NNN\n155:   const label = String(t.label ?? \"\");\n156:   if (!label.startsWith(`${spec.date} · `)) journalIssue(id, \"title\", `label ${JSON.stringify(label)} does not start with WHY.date \"${spec.date} · \" (the day is the ordinal)`);\n157:   if (label !== `${spec.date} · ${spec.title}`) warn(id, \"title\", `label ${JSON.stringify(label)} is not \"${spec.date} · ${spec.title}\" (WHY.title is the human title)`);\n158:   const tags = Array.isArray(t.tags) ? t.tags.map(String) : [];\n159:   const dayTag = `day-${String(spec.day).padStart(3, \"0\")}`;\n160:   if (!tags.includes(spec.date) || !tags.includes(dayTag)) journalIssue(id, \"tags\", `tags must carry \"${spec.date}\" and \"${dayTag}\" - got [${tags.join(\", \")}]`);\n161: \n162:   // ── 3. the rendered shape ──\n163:   for (const [w, h] of [[1280, 720], [1080, 1920]]) {\n164:     let pipeline;\n165:     try { pipeline = await t.renderTutorial(t.defaultProps ?? {}, ctxFor(w, h)); }\n166:     catch (err) { error(id, \"render\", `renderTutorial threw at ${w}x${h}: ${err && err.message ? err.message.split(\"\\n\")[0] : err}`); continue; }\n167:     if (!pipeline || pipeline.kind !== \"mosaic_pipeline\" || !Array.isArray(pipeline.steps)) { error(id, \"shape\", `renderTutorial at ${w}x${h} did not return a mosaic_pipeline`); continue; }\n168:     const labels = why.WHY_PAGE_LABELS ?? [];\n169:     const madeLabel = why.WHY_MADE_LABEL ?? \"why: how it was made\";\n170:     if (pipeline.steps.length < labels.length + 2) error(id, \"steps\", `tutorial at ${w}x${h} has ${pipeline.steps.length} step(s); the convention is ${labels.length} pages, the template, then how it was made`);\n171:     const lastDoc = pipeline.steps[pipeline.steps.length - 1]?.file;\n172:     if (!lastDoc || String(lastDoc.editor?.label ?? \"\") !== madeLabel) error(id, \"made\", `the last step at ${w}x${h} is not the \"how it was made\" page (${JSON.stringify(madeLabel)})`);\n173:     pipeline.steps.forEach((step, i) => {\n174:       if (!(step.durationMs > 0)) error(id, \"duration\", `step ${i} at ${w}x${h} has no positive durationMs`);\n175:       const doc = step.file;\n176:       if (!doc || doc.kind !== \"mosaic_document\") { if (!step.ref) error(id, \"step\", `step ${i} at ${w}x${h} carries neither an inline document nor a ref`); return; }\n177:       const v = typeof dsl.validateM0String === \"function\" ? dsl.validateM0String(String(doc.m0)) : { ok: true };\n178:       const ok = v === true || (v && (v.ok === true || v.valid === true));\n179:       if (!ok) error(id, \"m0\", `step ${i} at ${w}x${h}: m0 does not validate`);\n180:       if (i < labels.length) {\n181:         const label = doc.editor && doc.editor.label ? String(doc.editor.label) : \"\";\n182:         if (!label.startsWith(labels[i])) error(id, \"page\", `step ${i} at ${w}x${h} is labelled ${JSON.stringify(label)}, expected ${JSON.stringify(labels[i])}...`);\n183:       }\n184:       // every chrome page carries a layout contract that holds (the template's own step is check-layout's job)\n185:       const isTemplateStep = i >= labels.length && i < pipeline.steps.length - 1;\n186:       if (!isTemplateStep && typeof layout.checkLayoutIntent === \"function\") {\n187:         const check = layout.checkLayoutIntent(doc, w, h);\n188:         if (!check) error(id, \"page-contract\", `step ${i} at ${w}x${h} carries no layout contract`);\n189:         else for (const v of check.violations) error(id, \"page-contract\", `step ${i} at ${w}x${h}: ${v.detail}`);\n190:       }\n191:     });\n192:     // the step(s) before the last ARE the template at its defaults\n193:     try {\n194:       const own = await t.render(t.defaultProps ?? {}, ctxFor(w, h));\n195:       const body = pipeline.steps.slice(0, -1);\n196:       const last = body[body.length - 1];\n197:       if (own && own.kind === \"mosaic_document\") {\n198:         if (!last || !last.file || String(last.file.m0) !== String(own.m0)) error(id, \"template-step\", `the step before \"how it was made\" at ${w}x${h} is not the template's own default render`);\n199:       } else if (own && own.kind === \"mosaic_pipeline\") {\n200:         const tail = body.slice(-own.steps.length);\n201:         if (tail.length !== own.steps.length || tail.some((s, i) => String(s.file?.m0 ?? s.ref) !== String(own.steps[i].file?.m0 ?? own.steps[i].ref))) error(id, \"template-step\", `the steps before \"how it was made\" at ${w}x${h} are not the template's own default pipeline`);\n202:       }\n203:     } catch (err) {\n204:       report.notes.push(`${id}: own render threw at ${w}x${h} (${err && err.message ? err.message.split(\"\\n\")[0] : err}) - the tutorial's last page must say so`);\n205:     }\n206:   }\n207: }\n208: \n209: if (report.errors.length) {\n210:   fail(`[check-why] ✗ ${report.errors.length} why-tutorial error(s) across ${report.checked} template(s):`);\n211:   for (const e of report.errors) fail(`  ✗ ${e.templateId} — ${e.key}: ${e.detail}`);\n212:   fail(`[check-why] ${FIX}`);\n213:   finish(1);\n214: }\n215: for (const w of report.warnings) say(`  ⚠ ${w.templateId} — ${w.key}: ${w.detail}`);\n216: say(`[check-why] ✓ ${report.checked} template(s) explain why they exist (${report.warnings.length} warning(s)${frontDoor ? \"; front door exempt\" : \"\"}).`);\n217: finish(0);\n\n(End of file - total 217 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n/**\n * The why-tutorial gate — every template in this repo explains itself.\n *\n * Runs at the end of `npm run build` (after check-registry, so dist/ is\n * fresh and every template already passed the platform conventions) and in\n * the daily gate. For every template except the repo's front door\n * (`repo.helloWorld`, the one human-placed template) and the `harness` pack\n * (internal fixtures, human-maintained, never a day's work) it checks:\n *\n *   1. `renderTutorial` exists and was built by `whyTutorial(WHY, render)`\n *      from src/_shared/why.ts — the spec is in the helper's registry.\n *   2. The spec agrees with the journal: `journal/<date>/` exists, `day` is\n *      that date's day number, and when `journal/<date>/run.json` is there,\n *      `agent` / `model` match what the runner and the agent recorded. These\n *      are ERRORS for a template that is not frozen yet (today's work - the\n *      journal must agree before it ships) and WARNINGS for a frozen one (it\n *      cannot change any more; a pruned journal must not break the build).\n *   3. It renders (1280x720 and 1080x1920, design mode, no media) as a\n *      pipeline of at least six steps: the four chrome pages in order","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\tools\\check-why.mjs","text":"#!/usr/bin/env node\n/**\n * The why-tutorial gate — every template in this repo explains itself.\n *\n * Runs at the end of `npm run build` (after check-registry, so dist/ is\n * fresh and every template already passed the platform conventions) and in\n * the daily gate. For every template except the repo's front door\n * (`repo.helloWorld`, the one human-placed template) and the `harness` pack\n * (internal fixtures, human-maintained, never a day's work) it checks:\n *\n *   1. `renderTutorial` exists and was built by `whyTutorial(WHY, render)`\n *      from src/_shared/why.ts — the spec is in the helper's registry.\n *   2. The spec agrees with the journal: `journal/<date>/` exists, `day` is\n *      that date's day number, and when `journal/<date>/run.json` is there,\n *      `agent` / `model` match what the runner and the agent recorded. These\n *      are ERRORS for a template that is not frozen yet (today's work - the\n *      journal must agree before it ships) and WARNINGS for a frozen one (it\n *      cannot change any more; a pruned journal must not break the build).\n *   3. It renders (1280x720 and 1080x1920, design mode, no media) as a\n *      pipeline of at least six steps: the four chrome pages in order\n *      (cover, problem, solution, use it), the template itself (its m0\n *      equals the template's own default render), then \"how it was made\"\n *      (the harness timeline) last — and every step's m0 validates and\n *      keeps its page's layout contract.\n *      A founder-directed follow-up (vN, N >= 2, with its own\n *      journal/<date>/vN/run.json - tools/record-dir.mjs) is held to ITS\n *      run.json and trace.json; the day number and date stay the day's.\n *   4. `WHY.timeline` agrees with `journal/<date>/trace.json` when the runner\n *      wrote one: every phase named is in the trace and its duration is\n *      within 25% (the ship phase is exempt - it is still running when the\n *      agent writes the spec). A `self-reported` timeline with a trace on\n *      disk is an error while unfrozen.\n *\n * The spec's content rules (budget, ASCII, real URLs, no scaffold\n * placeholder) throw at import inside `whyTutorial`, so a bad spec already\n * failed at `require(\"../dist/index.js\")` above; this file is about presence,\n * honesty against the journal, and the rendered shape.\n *\n *   node tools/check-why.mjs          human log lines, exit 1 on any error\n *   node tools/check-why.mjs --json   one report on stdout, same exit code\n */\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { createRequire } from \"node:module\";\nimport { fileURLToPath } from \"node:url\";\nimport { recordDirFor } from \"./record-dir.mjs\";\n\nconst require = createRequire(import.meta.url);\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nprocess.env.M0SAIC_CLI ??= \"/usr/bin/false\";\nconst JSON_OUT = process.argv.includes(\"--json\");\n\nconst report = { ok: true, templates: 0, checked: 0, errors: [], warnings: [], notes: [] };\nconst say = (...a) => { if (!JSON_OUT) console.log(...a); };\nconst fail = (...a) => { if (!JSON_OUT) console.error(...a); };\nconst finish = (code) => {\n  if (JSON_OUT) { report.ok = code === 0; process.stdout.write(JSON.stringify(report, null, 2) + \"\\n\"); }\n  process.exit(code);\n};\nconst error = (templateId, key, detail) => report.errors.push({ templateId, convention: \"whyTutorial\", severity: \"error\", key, detail, fix: FIX });\nconst warn = (templateId, key, detail) => report.warnings.push({ templateId, convention: \"whyTutorial\", severity: \"warning\", key, detail, fix: FIX });\nconst FIX =\n  \"every template explains why it exists: `renderTutorial: whyTutorial(WHY, render)` from src/_shared/why.ts, with WHY filled from the day's journal \" +\n  \"(day, date, agent, model as run.json declares them; who; the observed problem; the sources actually opened; the solution; the render one-liner). \" +\n  \"The scaffold writes the skeleton; replace every \" + \"[fill me]\" + \"; copy timeline from journal/<date>/trace.json in the ship phase. It renders as six steps: cover, problem, solution, use it, the template, how it was made.\";\n\nlet entry, why, layout, dsl;\ntry {\n  entry = require(\"../dist/index.js\");\n  why = require(\"../dist/_shared/why.js\");\n  layout = require(\"../dist/_shared/layout.js\");\n  dsl = require(\"@m0saic/dsl\");\n} catch (err) {\n  fail(`\\n[check-why] ✗ could not load dist/ (run the build first): ${err && err.message ? err.message : err}\\n`);\n  finish(1);\n}\n\nconst templates = Array.isArray(entry.templates) ? entry.templates : [];\nconst repo = entry.repo ?? entry.TEMPLATE_REPO ?? {};\nconst frontDoor = repo.helloWorld ? String(repo.helloWorld) : null;\nreport.templates = templates.length;\n\nconst ctxFor = (width, height) => {\n  const target = { width, height, fps: 30, durationMs: 2000 };\n  return { mode: \"design\", target, output: { ...target, workspaceDir: path.join(ROOT, \"test-output\", \"why\") }, media: {} };\n};\n\nconst readJson = (file, fallback = null) => { try { return JSON.parse(fs.readFileSync(file, \"utf8\")); } catch { return fallback; } };\nconst indexRows = (() => { const v = readJson(path.join(ROOT, \"journal\", \"index.json\"), []); return Array.isArray(v) ? v : []; })();\nconst frozenFiles = Object.keys(readJson(path.join(ROOT, \"frozen.manifest.json\"), {})?.files ?? {});\nconst srcDirOf = (id) => { const m = /^@[^/]+\\/([^/]+)\\/([^/]+)\\/(v\\d+)$/.exec(id); return m ? `src/${m[1]}/${m[2]}/${m[3]}/` : null; };\nconst dayNumberFor = (date) => {\n  const existing = indexRows.find((r) => r.date === date);\n  if (existing && existing.day) return existing.day;\n  return indexRows.filter((r) => r.date < date).length + 1;\n};\n\nfor (const t of templates) {\n  const id = String(t.id);\n  if (frontDoor && id === frontDoor) { report.notes.push(`${id}: the front door is exempt (human-placed, not a day's work)`); continue; }\n  if (id.startsWith(`${repo.repoId ?? \"@one-a-day\"}/harness/`)) { report.notes.push(`${id}: harness fixtures are exempt (internal, human-maintained)`); continue; }\n  report.checked += 1;\n\n  // ── 1. presence, via the helper ──\n  if (typeof t.renderTutorial !== \"function\") { error(id, \"missing\", \"no renderTutorial - the template does not explain why it exists\"); continue; }\n  const spec = typeof why.whySpecFor === \"function\" ? why.whySpecFor(id) : undefined;\n  if (!spec) { error(id, \"not-why\", \"renderTutorial is not built by whyTutorial() from src/_shared/why.ts (no spec registered for this id)\"); continue; }\n\n  // ── 2. honesty against the journal (hard while unfrozen, soft once shipped) ──\n  const dir = srcDirOf(id);\n  const shipped = dir ? frozenFiles.some((f) => f.startsWith(dir)) : false;\n  const journalIssue = shipped ? warn : error;\n  const dayDir = path.join(ROOT, \"journal\", spec.date);\n  if (!fs.existsSync(dayDir)) journalIssue(id, \"journal\", `WHY.date ${spec.date} has no journal/${spec.date}/ folder${shipped ? \" (frozen template; journal pruned?)\" : \"\"}`);\n  else {\n    const expectedDay = dayNumberFor(spec.date);\n    if (spec.day !== expectedDay) journalIssue(id, \"day\", `WHY.day is ${spec.day}; journal/index.json makes ${spec.date} day ${expectedDay}`);\n    const record = recordDirFor(ROOT, id, spec.date);\n    const run = readJson(path.join(record.dir, \"run.json\"), null);\n    if (!run) warn(id, \"run\", `${record.rel}/run.json is missing - agent / model could not be cross-checked`);\n    else {\n      const adapter = run.runner && run.runner.adapter ? String(run.runner.adapter) : null;\n      const model = run.model && run.model.selfDeclared ? String(run.model.selfDeclared) : null;\n      if (adapter && spec.agent !== adapter) journalIssue(id, \"agent\", `WHY.agent is ${JSON.stringify(spec.agent)}; run.json says the adapter was ${JSON.stringify(adapter)}`);\n      if (model && spec.model !== model) journalIssue(id, \"model\", `WHY.model is ${JSON.stringify(spec.model)}; run.json model.selfDeclared is ${JSON.stringify(model)}`);\n      if (!model) warn(id, \"model\", `run.json has no model.selfDeclared yet; WHY.model ${JSON.stringify(spec.model)} is unverified`);\n    }\n    // ── the timeline against the runner's trace ──\n    const trace = readJson(path.join(record.dir, \"trace.json\"), null);\n    const tl = spec.timeline;\n    if (trace && Array.isArray(trace.phases) && tl) {\n      if (tl.source !== \"runner\") journalIssue(id, \"timeline-source\", `WHY.timeline.source is ${JSON.stringify(tl.source)} but ${record.rel}/trace.json exists - copy the runner's numbers`);\n      const byName = new Map(trace.phases.map((ph) => [String(ph.name), ph]));\n      for (const ph of tl.phases) {\n        const rec = byName.get(String(ph.name));\n        if (!rec) { journalIssue(id, \"timeline-phase\", `WHY.timeline names phase ${JSON.stringify(ph.name)}, which is not in trace.json`); continue; }\n        if (String(ph.name).startsWith(\"ship\")) continue;\n        const ref = Number(rec.durMs ?? 0);\n        if (ref > 0 && Math.abs(ph.durMs - ref) > 0.25 * ref) journalIssue(id, \"timeline-duration\", `WHY.timeline ${ph.name} lasts ${ph.durMs} ms; trace.json says ${ref} ms`);\n      }\n    } else if (tl && tl.source === \"runner\") {\n      warn(id, \"timeline-source\", `WHY.timeline.source is \"runner\" but ${record.rel}/trace.json is missing - unverified`);\n    }\n    // A follow-up may carry its own evidence; it cites the day's scout as well.\n    const scouts = [path.join(record.dir, \"10-scout.md\"), path.join(dayDir, \"10-scout.md\")].filter((f) => fs.existsSync(f));\n    const scout = scouts[0];\n    if (scout) {\n      const text = scouts.map((f) => fs.readFileSync(f, \"utf8\")).join(\"\\n\");\n      const uncited = spec.sources.filter((u) => !text.includes(u));\n      if (uncited.length) warn(id, \"sources\", `${uncited.length} WHY source(s) do not appear in ${scouts.map((f) => path.relative(ROOT, f).split(path.sep).join(\"/\")).join(\" or \")}: ${uncited.slice(0, 3).join(\", \")}${uncited.length > 3 ? \", ...\" : \"\"}`);\n    }\n  }\n  if (spec.id !== id) error(id, \"id\", `WHY.id is ${JSON.stringify(spec.id)}`);\n  // the display title and the tags carry the day: \"<date> · <Title>\", tags <date> + day-NNN\n  const label = String(t.label ?? \"\");\n  if (!label.startsWith(`${spec.date} · `)) journalIssue(id, \"title\", `label ${JSON.stringify(label)} does not start with WHY.date \"${spec.date} · \" (the day is the ordinal)`);\n  if (label !== `${spec.date} · ${spec.title}`) warn(id, \"title\", `label ${JSON.stringify(label)} is not \"${spec.date} · ${spec.title}\" (WHY.title is the human title)`);\n  const tags = Array.isArray(t.tags) ? t.tags.map(String) : [];\n  const dayTag = `day-${String(spec.day).padStart(3, \"0\")}`;\n  if (!tags.includes(spec.date) || !tags.includes(dayTag)) journalIssue(id, \"tags\", `tags must carry \"${spec.date}\" and \"${dayTag}\" - got [${tags.join(\", \")}]`);\n\n  // ── 3. the rendered shape ──\n  for (const [w, h] of [[1280, 720], [1080, 1920]]) {\n    let pipeline;\n    try { pipeline = await t.renderTutorial(t.defaultProps ?? {}, ctxFor(w, h)); }\n    catch (err) { error(id, \"render\", `renderTutorial threw at ${w}x${h}: ${err && err.message ? err.message.split(\"\\n\")[0] : err}`); continue; }\n    if (!pipeline || pipeline.kind !== \"mosaic_pipeline\" || !Array.isArray(pipeline.steps)) { error(id, \"shape\", `renderTutorial at ${w}x${h} did not return a mosaic_pipeline`); continue; }\n    const labels = why.WHY_PAGE_LABELS ?? [];\n    const madeLabel = why.WHY_MADE_LABEL ?? \"why: how it was made\";\n    if (pipeline.steps.length < labels.length + 2) error(id, \"steps\", `tutorial at ${w}x${h} has ${pipeline.steps.length} step(s); the convention is ${labels.length} pages, the template, then how it was made`);\n    const lastDoc = pipeline.steps[pipeline.steps.length - 1]?.file;\n    if (!lastDoc || String(lastDoc.editor?.label ?? \"\") !== madeLabel) error(id, \"made\", `the last step at ${w}x${h} is not the \"how it was made\" page (${JSON.stringify(madeLabel)})`);\n    pipeline.steps.forEach((step, i) => {\n      if (!(step.durationMs > 0)) error(id, \"duration\", `step ${i} at ${w}x${h} has no positive durationMs`);\n      const doc = step.file;\n      if (!doc || doc.kind !== \"mosaic_document\") { if (!step.ref) error(id, \"step\", `step ${i} at ${w}x${h} carries neither an inline document nor a ref`); return; }\n      const v = typeof dsl.validateM0String === \"function\" ? dsl.validateM0String(String(doc.m0)) : { ok: true };\n      const ok = v === true || (v && (v.ok === true || v.valid === true));\n      if (!ok) error(id, \"m0\", `step ${i} at ${w}x${h}: m0 does not validate`);\n      if (i < labels.length) {\n        const label = doc.editor && doc.editor.label ? String(doc.editor.label) : \"\";\n        if (!label.startsWith(labels[i])) error(id, \"page\", `step ${i} at ${w}x${h} is labelled ${JSON.stringify(label)}, expected ${JSON.stringify(labels[i])}...`);\n      }\n      // every chrome page carries a layout contract that holds (the template's own step is check-layout's job)\n      const isTemplateStep = i >= labels.length && i < pipeline.steps.length - 1;\n      if (!isTemplateStep && typeof layout.checkLayoutIntent === \"function\") {\n        const check = layout.checkLayoutIntent(doc, w, h);\n        if (!check) error(id, \"page-contract\", `step ${i} at ${w}x${h} carries no layout contract`);\n        else for (const v of check.violations) error(id, \"page-contract\", `step ${i} at ${w}x${h}: ${v.detail}`);\n      }\n    });\n    // the step(s) before the last ARE the template at its defaults\n    try {\n      const own = await t.render(t.defaultProps ?? {}, ctxFor(w, h));\n      const body = pipeline.steps.slice(0, -1);\n      const last = body[body.length - 1];\n      if (own && own.kind === \"mosaic_document\") {\n        if (!last || !last.file || String(last.file.m0) !== String(own.m0)) error(id, \"template-step\", `the step before \"how it was made\" at ${w}x${h} is not the template's own default render`);\n      } else if (own && own.kind === \"mosaic_pipeline\") {\n        const tail = body.slice(-own.steps.length);\n        if (tail.length !== own.steps.length || tail.some((s, i) => String(s.file?.m0 ?? s.ref) !== String(own.steps[i].file?.m0 ?? own.steps[i].ref))) error(id, \"template-step\", `the steps before \"how it was made\" at ${w}x${h} are not the template's own default pipeline`);\n      }\n    } catch (err) {\n      report.notes.push(`${id}: own render threw at ${w}x${h} (${err && err.message ? err.message.split(\"\\n\")[0] : err}) - the tutorial's last page must say so`);\n    }\n  }\n}\n\nif (report.errors.length) {\n  fail(`[check-why] ✗ ${report.errors.length} why-tutorial error(s) across ${report.checked} template(s):`);\n  for (const e of report.errors) fail(`  ✗ ${e.templateId} — ${e.key}: ${e.detail}`);\n  fail(`[check-why] ${FIX}`);\n  finish(1);\n}\nfor (const w of report.warnings) say(`  ⚠ ${w.templateId} — ${w.key}: ${w.detail}`);\nsay(`[check-why] ✓ ${report.checked} template(s) explain why they exist (${report.warnings.length} warning(s)${frontDoor ? \"; front door exempt\" : \"\"}).`);\nfinish(0);","lineStart":1,"lineEnd":217,"totalLines":217,"truncated":false}},"title":"tools\\check-why.mjs","time":{"start":1792859351265,"end":1792859351331}},"id":"prt_16ebea7b0001haUIeFO22D4DW6","sessionID":"ses_e9141cfbdffenLAFgwFuHpfkdd","messageID":"msg_16ebe983d001aCYCVmIziXdqip"}}
