{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01514EjNrPQjtKB2rsm7n4kF","type":"tool_result","content":"1\timport { evaluateM0 } from \"@m0saic/dsl-stdlib\";\n2\timport { resolvePropBindings } from \"@m0saic/template-utils\";\n3\t\n4\timport { asDocument, targetCtx } from \"../../../__testutils__/render\";\n5\timport { layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\n6\timport { LapTelemetryCardV1 } from \"./lap-telemetry-card\";\n7\t\n8\tconst render = (\n9\t  props: Parameters<typeof LapTelemetryCardV1.render>[0] = {},\n10\t  w = 1280,\n11\t  h = 720,\n12\t) => LapTelemetryCardV1.render({ ...LapTelemetryCardV1.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n13\t\n14\tdescribe(\"@one-a-day/sports/lap-telemetry-card/v1\", () => {\n15\t  it(\"renders the default lap with proper sources for track, lap time, and driver\", async () => {\n16\t    const doc = await render();\n17\t    expect(doc.sources).toHaveLength(13);\n18\t    expect(layoutIntentOf(doc)).not.toBeNull();\n19\t  });\n20\t\n21\t  it(\"clears its safe minimum at its own hint\", async () => {\n22\t    const ev = evaluateM0(String((await render()).m0), { width: 1280, height: 720 });\n23\t    expect(ev.feasible && ev.meetsPrecision).toBe(true);\n24\t  });\n25\t\n26\t  it(\"keeps its layout contract at the seven contract canvases - defaults, long track names, mixed deltas\", async () => {\n27\t    expect(layoutIntentOf(await render())).not.toBeNull();\n28\t    for (const over of [\n29\t      {},\n30\t      { trackName: \"Autodromo Internazionale di Monza\" },\n31\t      { sector1Time: \"2:29.123\", sector2Time: \"2:44.000\", sector3Time: \"2:30.500\" }\n32\t    ]) {\n33\t      await sweepLayout((p, ctx) => LapTelemetryCardV1.render(p, ctx).then(asDocument), \"@one-a-day/sports/lap-telemetry-card/v1\", { ...LapTelemetryCardV1.defaultProps, ...over }, (w, h) => targetCtx(w, h));\n34\t    }\n35\t    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n36\t  });\n37\t\n38\t  it(\"is deterministic\", async () => {\n39\t    expect(await render()).toEqual(await render());\n40\t  });\n41\t\n42\t  it(\"rejects non-string values for required fields\", async () => {\n43\t    await expect(render({ trackName: 42 as never })).rejects.toThrow(/must be a string/);\n44\t    await expect(render({ driverId: 42 as never })).rejects.toThrow(/must be a string/);\n45\t  });\n46\t\n47\t  it(\"renders with custom sector times and maintains layout\", async () => {\n48\t    const doc = await render({\n49\t      sector1Time: \"2:29.200\",\n50\t      sector2Time: \"2:43.900\",\n51\t      sector3Time: \"2:30.000\",\n52\t    });\n53\t    expect(doc.sources).toHaveLength(13);\n54\t    expect(layoutIntentOf(doc)).not.toBeNull();\n55\t  });\n56\t});\n57\t"}]},"parent_tool_use_id":null,"session_id":"2874c0be-f0d7-4b02-a69f-0d005372cc5c","uuid":"068b4170-1b80-4aee-ab32-a29beb3f108e","timestamp":"2026-10-02T13:20:38.348Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\lap-telemetry-card\\v1\\lap-telemetry-card.test.ts","content":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { resolvePropBindings } from \"@m0saic/template-utils\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport { LapTelemetryCardV1 } from \"./lap-telemetry-card\";\n\nconst render = (\n  props: Parameters<typeof LapTelemetryCardV1.render>[0] = {},\n  w = 1280,\n  h = 720,\n) => LapTelemetryCardV1.render({ ...LapTelemetryCardV1.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n\ndescribe(\"@one-a-day/sports/lap-telemetry-card/v1\", () => {\n  it(\"renders the default lap with proper sources for track, lap time, and driver\", async () => {\n    const doc = await render();\n    expect(doc.sources).toHaveLength(13);\n    expect(layoutIntentOf(doc)).not.toBeNull();\n  });\n\n  it(\"clears its safe minimum at its own hint\", async () => {\n    const ev = evaluateM0(String((await render()).m0), { width: 1280, height: 720 });\n    expect(ev.feasible && ev.meetsPrecision).toBe(true);\n  });\n\n  it(\"keeps its layout contract at the seven contract canvases - defaults, long track names, mixed deltas\", async () => {\n    expect(layoutIntentOf(await render())).not.toBeNull();\n    for (const over of [\n      {},\n      { trackName: \"Autodromo Internazionale di Monza\" },\n      { sector1Time: \"2:29.123\", sector2Time: \"2:44.000\", sector3Time: \"2:30.500\" }\n    ]) {\n      await sweepLayout((p, ctx) => LapTelemetryCardV1.render(p, ctx).then(asDocument), \"@one-a-day/sports/lap-telemetry-card/v1\", { ...LapTelemetryCardV1.defaultProps, ...over }, (w, h) => targetCtx(w, h));\n    }\n    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n  });\n\n  it(\"is deterministic\", async () => {\n    expect(await render()).toEqual(await render());\n  });\n\n  it(\"rejects non-string values for required fields\", async () => {\n    await expect(render({ trackName: 42 as never })).rejects.toThrow(/must be a string/);\n    await expect(render({ driverId: 42 as never })).rejects.toThrow(/must be a string/);\n  });\n\n  it(\"renders with custom sector times and maintains layout\", async () => {\n    const doc = await render({\n      sector1Time: \"2:29.200\",\n      sector2Time: \"2:43.900\",\n      sector3Time: \"2:30.000\",\n    });\n    expect(doc.sources).toHaveLength(13);\n    expect(layoutIntentOf(doc)).not.toBeNull();\n  });\n});\n","numLines":57,"startLine":1,"totalLines":57}}}
