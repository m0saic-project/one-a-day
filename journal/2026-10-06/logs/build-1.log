very inset on a child, 5-smooth child canvases\", async () => {\n    const smooth = (n: number) => { let k = n; for (const f of [2, 3, 5]) while (k % f === 0) k /= f; return k === 1; };\n    for (const over of [{}, { milestones: TEN }, { milestones: \"\" }, { eventName: \"Great Salterns Nature Reserve 5k Juniors\", counts: MAXED }] as WeeklyRunReportProps[]) {\n      for (const [w, h] of CONTRACT_CANVASES) {\n        if (over.milestones === TEN && w < 1080) continue;\n        const doc = await render(over, w, h);\n        const refs = (doc.sources ?? []).filter((s) => (s as { type?: string }).type === \"mosaic\");\n        expect(refs.length).toBe(Object.keys(doc.children ?? {}).length);\n        for (const r of refs) expect((r as { placement?: { inset?: unknown } }).placement?.inset).toBeUndefined();\n        for (const c of Object.values(doc.children ?? {})) {\n          const size = (c as MosaicDocument).size!;\n          expect(smooth(size.width) && smooth(size.height)).toBe(true);\n        }\n      }\n    }\n  });`);\nrep(`  layoutWeeklyRunReport,\n  parseMilestones,`, `  layoutWeeklyRunReport,\n  parseMilestones,\n  settleLayout,`);\nfs.writeFileSync(t,s);\nconst p=\"src/community/weekly-run-report/v1/weekly-run-report.ts\";\nlet m=fs.readFileSync(p,\"utf8\");\nconst a=`\"From six clubs the badges get smaller (two rows, or one long row on a wide card); ten clubs are refused at 480x270 rather than drawn unreadably small.\",`;\nif(!m.includes(a)) throw new Error(\"caveat\");\nm=m.replace(a,`\"From six clubs the badges get smaller (two rows, or one long row on a wide card); ten clubs need 1280x720 or larger and are refused on the 640x360 and 480x270 thumbnails.\",`);\nconst b=`Ten milestone clubs are refused at 480x270.\",`;\nif(!m.includes(b)) throw new Error(\"note\");\nm=m.replace(b,`Ten milestone clubs need 1280x720 or larger.\",`);\nfs.writeFileSync(p,m);\nconsole.log(\"ok\");\nEOF\nnpx jest src/community/weekly-run-report 2>&1 | grep -E \"Tests:|●|•\" | hea