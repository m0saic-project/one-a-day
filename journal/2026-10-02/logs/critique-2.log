{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X6jDxB6pyoFyCb9YzonRAC","type":"tool_result","content":"1\timport type {\n2\t  MosaicColor,\n3\t  MosaicDocument,\n4\t  MosaicEngineContext,\n5\t  MosaicSource,\n6\t} from \"@m0saic/types\";\n7\timport { asTemplateId } from \"@m0saic/types\";\n8\timport { toM0String } from \"@m0saic/dsl-stdlib\";\n9\timport {\n10\t  bindProp,\n11\t  defineMosaicTemplate,\n12\t  definePropsSchema,\n13\t  makeColorTile,\n14\t  placeInsetPieces,\n15\t  svgLabel,\n16\t  tag,\n17\t} from \"@m0saic/template-utils\";\n18\timport type { LayoutConstraint } from \"@m0saic/template-utils\";\n19\timport { TEXT_EM, textFitsAll, withLayoutIntent } from \"../../../_shared/layout\";\n20\timport { whyTutorial } from \"../../../_shared/why\";\n21\timport type { WhySpec } from \"../../../_shared/why\";\n22\t\n23\t/**\n24\t * `@one-a-day/sports/lap-telemetry-card/v1` — a sim racing lap achievement card:\n25\t * track name, lap time, personal best, sector breakdown with times and deltas,\n26\t * and proportional delta bars (green for faster, red for slower), driver name,\n27\t * and top speed from telemetry or race results.\n28\t *\n29\t * ONE CONCEPT: the delta bar shows at a glance which sector was the bottleneck —\n30\t * bar length is proportional to |delta|, green means faster than PB, red means\n31\t * slower. The three sector bars scale relative to the largest |delta| on the card\n32\t * so the longest bar fills its track and the others visibly rank by magnitude.\n33\t *\n34\t * The rule that bites: time formatting must match the parser exactly (M:SS.sss\n35\t * or SS.sss), validation throws on bad format, delta sign is explicit (- for faster,\n36\t * + for slower), and every time prop is validated before render.\n37\t */\n38\t\n39\texport type LapTelemetryCardProps = {\n40\t  /** The track or circuit name. */\n41\t  trackName?: string;\n42\t  /** Lap time in M:SS.sss or SS.sss format. */\n43\t  lapTime?: string;\n44\t  /** Personal best lap time in M:SS.sss or SS.sss format. */\n45\t  pbTime?: string;\n46\t  /** Sector 1 lap time. */\n47\t  sector1Time?: string;\n48\t  /** Sector 2 lap time. */\n49\t  sector2Time?: string;\n50\t  /** Sector 3 lap time. */\n51\t  sector3Time?: string;\n52\t  /** Sector 1 personal best time. */\n53\t  sector1Pb?: string;\n54\t  /** Sector 2 personal best time. */\n55\t  sector2Pb?: string;\n56\t  /** Sector 3 personal best time. */\n57\t  sector3Pb?: string;\n58\t  /** Driver name or callsign. */\n59\t  driverId?: string;\n60\t  /** Top speed in km/h. */\n61\t  topSpeed?: string;\n62\t  /** Dev-only: check the layout contract and draw it over the card. */\n63\t  debugLayout?: boolean;\n64\t};\n65\t\n66\tconst ID = \"@one-a-day/sports/lap-telemetry-card/v1\";\n67\tconst INK = \"#eaeef2\" as MosaicColor;\n68\tconst DIM = \"#9aa7b4\" as MosaicColor;\n69\tconst GREEN = \"#2ecc71\" as MosaicColor;\n70\tconst RED = \"#e74c3c\" as MosaicColor;\n71\tconst PAGE = \"#1c2833\" as MosaicColor;\n72\t\n73\tconst DEFAULTS = {\n74\t  trackName: \"Nurburgring GP\",\n75\t  lapTime: \"1:54.812\",\n76\t  pbTime: \"1:55.420\",\n77\t  sector1Time: \"35.104\",\n78\t  sector2Time: \"41.236\",\n79\t  sector3Time: \"38.472\",\n80\t  sector1Pb: \"35.512\",\n81\t  sector2Pb: \"41.561\",\n82\t  sector3Pb: \"38.347\",\n83\t  driverId: \"Driver\",\n84\t  topSpeed: \"285\",\n85\t};\n86\t\n87\tconst propsSchema = definePropsSchema<LapTelemetryCardProps>({\n88\t  trackName: {\n89\t    type: \"string\",\n90\t    required: false,\n91\t    description: \"The track or circuit name, up to 40 characters.\",\n92\t    meta: { control: { placeholder: DEFAULTS.trackName }, ui: { label: \"Track\", order: 1 } },\n93\t  },\n94\t  lapTime: {\n95\t    type: \"string\",\n96\t    required: false,\n97\t    description: \"Lap time in M:SS.sss or SS.sss format.\",\n98\t    meta: { control: { placeholder: DEFAULTS.lapTime }, ui: { label: \"Lap time\", order: 2 } },\n99\t  },\n100\t  pbTime: {\n101\t    type: \"string\",\n102\t    required: false,\n103\t    description: \"Personal best lap time.\",\n104\t    meta: { control: { placeholder: DEFAULTS.pbTime }, ui: { label: \"PB time\", order: 3 } },\n105\t  },\n106\t  sector1Time: {\n107\t    type: \"string\",\n108\t    required: false,\n109\t    description: \"Sector 1 lap time.\",\n110\t    meta: { control: { placeholder: DEFAULTS.sector1Time }, ui: { label: \"Sector 1 time\", order: 4 } },\n111\t  },\n112\t  sector2Time: {\n113\t    type: \"string\",\n114\t    required: false,\n115\t    description: \"Sector 2 lap time.\",\n116\t    meta: { control: { placeholder: DEFAULTS.sector2Time }, ui: { label: \"Sector 2 time\", order: 5 } },\n117\t  },\n118\t  sector3Time: {\n119\t    type: \"string\",\n120\t    required: false,\n121\t    description: \"Sector 3 lap time.\",\n122\t    meta: { control: { placeholder: DEFAULTS.sector3Time }, ui: { label: \"Sector 3 time\", order: 6 } },\n123\t  },\n124\t  sector1Pb: {\n125\t    type: \"string\",\n126\t    required: false,\n127\t    description: \"Sector 1 personal best time.\",\n128\t    meta: { control: { placeholder: DEFAULTS.sector1Pb }, ui: { label: \"Sector 1 PB\", order: 7 } },\n129\t  },\n130\t  sector2Pb: {\n131\t    type: \"string\",\n132\t    required: false,\n133\t    description: \"Sector 2 personal best time.\",\n134\t    meta: { control: { placeholder: DEFAULTS.sector2Pb }, ui: { label: \"Sector 2 PB\", order: 8 } },\n135\t  },\n136\t  sector3Pb: {\n137\t    type: \"string\",\n138\t    required: false,\n139\t    description: \"Sector 3 personal best time.\",\n140\t    meta: { control: { placeholder: DEFAULTS.sector3Pb }, ui: { label: \"Sector 3 PB\", order: 9 } },\n141\t  },\n142\t  driverId: {\n143\t    type: \"string\",\n144\t    required: false,\n145\t    description: \"Driver name or callsign, up to 30 characters.\",\n146\t    meta: { control: { placeholder: DEFAULTS.driverId }, ui: { label: \"Driver\", order: 10 } },\n147\t  },\n148\t  topSpeed: {\n149\t    type: \"string\",\n150\t    required: false,\n151\t    description: \"Top speed in km/h.\",\n152\t    meta: { control: { placeholder: DEFAULTS.topSpeed }, ui: { label: \"Top speed\", order: 11 } },\n153\t  },\n154\t  debugLayout: {\n155\t    type: \"boolean\",\n156\t    required: false,\n157\t    description: \"Dev-only: check the layout contract and draw it over the card.\",\n158\t    meta: { ui: { label: \"Debug layout\", order: 99 } },\n159\t  },\n160\t});\n161\t\n162\tfunction layoutContract(): LayoutConstraint[] {\n163\t  return [\n164\t    ...textFitsAll([\n165\t      \"trackName\", \"lapTime\",\n166\t      \"sector1\", \"sector1-pb\", \"sector1-delta\",\n167\t      \"sector2\", \"sector2-pb\", \"sector2-delta\",\n168\t      \"sector3\", \"sector3-pb\", \"sector3-delta\",\n169\t      \"driverId\", \"topSpeed\"\n170\t    ], { charWidthEm: TEXT_EM.prose }),\n171\t    { label: \"trackName\", within: { yFrac: [0, 0.15] } },\n172\t    { label: \"lapTime\", within: { yFrac: [0.1, 0.2] } },\n173\t    { label: \"sector1\", within: { yFrac: [0.2, 0.4] } },\n174\t    { label: \"sector1-pb\", within: { yFrac: [0.2, 0.4] } },\n175\t    { label: \"sector1-delta\", within: { yFrac: [0.2, 0.4] } },\n176\t    { label: \"sector1-bar\", within: { yFrac: [0.2, 0.4] } },\n177\t    { label: \"sector2\", within: { yFrac: [0.4, 0.6] } },\n178\t    { label: \"sector2-pb\", within: { yFrac: [0.4, 0.6] } },\n179\t    { label: \"sector2-delta\", within: { yFrac: [0.4, 0.6] } },\n180\t    { label: \"sector2-bar\", within: { yFrac: [0.4, 0.6] } },\n181\t    { label: \"sector3\", within: { yFrac: [0.6, 0.8] } },\n182\t    { label: \"sector3-pb\", within: { yFrac: [0.6, 0.8] } },\n183\t    { label: \"sector3-delta\", within: { yFrac: [0.6, 0.8] } },\n184\t    { label: \"sector3-bar\", within: { yFrac: [0.6, 0.8] } },\n185\t    { label: \"driverId\", within: { yFrac: [0.8, 1] } },\n186\t    { label: \"topSpeed\", within: { yFrac: [0.8, 1] } },\n187\t  ];\n188\t}\n189\t\n190\tconst WHY: WhySpec = {\n191\t  \"day\": 13,\n192\t  \"date\": \"2026-10-02\",\n193\t  \"agent\": \"claude\",\n194\t  \"model\": \"claude-haiku-4-5-20251001\",\n195\t  \"id\": \"@one-a-day/sports/lap-telemetry-card/v1\",\n196\t  \"title\": \"Sim Racing Lap Card\",\n197\t  \"who\": \"Competitive sim racers in iRacing, Assetto Corsa, Le Mans Ultimate communities; platforms like SimTelemetry.site, YouTube channels, competitive leagues.\",\n198\t  \"problem\": [\n199\t    \"Sim racers want to share lap achievements - sector times, deltas vs PB, apex speeds - as shareable cards. SimTelemetry.site records telemetry at 60Hz. Drivers currently screenshot lap times or manually create graphics; a deterministic lap card lets them share standardized achievements.\"\n200\t  ],\n201\t  \"sources\": [\n202\t    \"https://simtelemetry.site\",\n203\t    \"https://news.ycombinator.com/item?id=49045861\"\n204\t  ],\n205\t  \"solution\": [\n206\t    \"A deterministic lap card: each sector shows its time and delta (negative = faster, positive = slower) with a proportional bar that is green when faster or red when slower than PB. Driver name and top speed complete the context. The delta bar makes it obvious at a glance which sector was the bottleneck on this run.\"\n207\t  ],\n208\t  \"usage\": {\n209\t    \"command\": \"m0saic make @one-a-day/sports/lap-telemetry-card/v1 --template-repo . -w 1280 -h 720 -o lap.png\",\n210\t    \"try\": [\n211\t      \"Add --topSpeed 310 to show higher speeds\",\n212\t      \"Try portrait: -w 1080 -h 1920\",\n213\t      \"Square crop: -w 1080 -h 1080\"\n214\t    ]\n215\t  },\n216\t  \"timeline\": {\n217\t    \"source\": \"runner\",\n218\t    \"phases\": [\n219\t      {\n220\t        \"name\": \"scout\",\n221\t        \"startMs\": 0,\n222\t        \"durMs\": 217259,\n223\t        \"calls\": 100,\n224\t        \"tokens\": 8356979,\n225\t        \"costUsd\": 0.44,\n226\t        \"tools\": \"Bash 93, Read 4, Write 2\"\n227\t      },\n228\t      {\n229\t        \"name\": \"plan\",\n230\t        \"startMs\": 217273,\n231\t        \"durMs\": 63094,\n232\t        \"calls\": 11,\n233\t        \"tokens\": 923341,\n234\t        \"costUsd\": 0.11,\n235\t        \"tools\": \"Read 7, Glob 2, Bash 1\"\n236\t      }\n237\t    ],\n238\t    \"costBasis\": \"reported\"\n239\t  }\n240\t};\n241\t\n242\texport const LapTelemetryCardV1 = defineMosaicTemplate<LapTelemetryCardProps>({\n243\t  id: asTemplateId(ID),\n244\t  label: \"2026-10-02 · Sim Racing Lap Card\",\n245\t  version: 1,\n246\t  description: \"A sim racing lap card: track, lap time and delta vs PB, three sectors with times, PBs, and proportional delta bars (green for faster, red for slower), driver name, and top speed.\",\n247\t  capabilities: { tier: \"core\" },\n248\t  tags: [\"sports\",\"2026-10-02\",\"day-013\",\"racing\",\"telemetry\",\"sector\",\"delta\"],\n249\t\n250\t  outputHints: {\n251\t    width: 1280,\n252\t    height: 720,\n253\t    fps: 30,\n254\t    durationMs: 2000,\n255\t    format: { kind: \"image\", container: \"png\" },\n256\t    note: \"Static card - renders cleanly at any canvas size and duration.\",\n257\t  },\n258\t\n259\t  propsSchema,\n260\t  defaultProps: {\n261\t    trackName: DEFAULTS.trackName,\n262\t    lapTime: DEFAULTS.lapTime,\n263\t    pbTime: DEFAULTS.pbTime,\n264\t    sector1Time: DEFAULTS.sector1Time,\n265\t    sector2Time: DEFAULTS.sector2Time,\n266\t    sector3Time: DEFAULTS.sector3Time,\n267\t    sector1Pb: DEFAULTS.sector1Pb,\n268\t    sector2Pb: DEFAULTS.sector2Pb,\n269\t    sector3Pb: DEFAULTS.sector3Pb,\n270\t    driverId: DEFAULTS.driverId,\n271\t    topSpeed: DEFAULTS.topSpeed,\n272\t    debugLayout: false,\n273\t  },\n274\t\n275\t  render,\n276\t  renderTutorial: whyTutorial(WHY, render),\n277\t});\n278\t\n279\texport default LapTelemetryCardV1;\n280\t\n281\tfunction parseTimeToMs(timeStr: string): number {\n282\t  const parts = timeStr.trim().split(\":\");\n283\t  if (parts.length === 1) {\n284\t    const secs = parseFloat(parts[0]);\n285\t    if (isNaN(secs) || secs < 0 || secs >= 60) {\n286\t      throw new Error(`Invalid time format: \"${timeStr}\" (SS.sss must be seconds < 60)`);\n287\t    }\n288\t    return Math.round(secs * 1000);\n289\t  } else if (parts.length === 2) {\n290\t    const mins = parseInt(parts[0], 10);\n291\t    const secs = parseFloat(parts[1]);\n292\t    if (isNaN(mins) || isNaN(secs) || secs < 0 || secs >= 60) {\n293\t      throw new Error(`Invalid time format: \"${timeStr}\" (M:SS.sss format expected)`);\n294\t    }\n295\t    return Math.round((mins * 60 + secs) * 1000);\n296\t  }\n297\t  throw new Error(`Invalid time format: \"${timeStr}\" (M:SS.sss or SS.sss format expected)`);\n298\t}\n299\t\n300\tfunction formatTime(ms: number): string {\n301\t  const totalSecs = ms / 1000;\n302\t  const mins = Math.floor(totalSecs / 60);\n303\t  const secs = totalSecs - mins * 60;\n304\t  if (mins > 0) {\n305\t    return `${mins}:${secs.toFixed(3).padStart(6, \"0\")}`;\n306\t  }\n307\t  return secs.toFixed(3);\n308\t}\n309\t\n310\tfunction formatDelta(ms: number): string {\n311\t  const sign = ms > 0 ? \"+\" : ms < 0 ? \"-\" : \"\";\n312\t  const secs = Math.abs(ms / 1000);\n313\t  return `${sign}${secs.toFixed(3)}s`;\n314\t}\n315\t\n316\tasync function render(\n317\t  props: LapTelemetryCardProps,\n318\t  ctx: MosaicEngineContext,\n319\t): Promise<MosaicDocument> {\n320\t    const { width: W, height: H } = ctx.target;\n321\t\n322\t    const trackName = props.trackName ?? DEFAULTS.trackName;\n323\t    const lapTime = props.lapTime ?? DEFAULTS.lapTime;\n324\t    const pbTime = props.pbTime ?? DEFAULTS.pbTime;\n325\t    const sector1Time = props.sector1Time ?? DEFAULTS.sector1Time;\n326\t    const sector2Time = props.sector2Time ?? DEFAULTS.sector2Time;\n327\t    const sector3Time = props.sector3Time ?? DEFAULTS.sector3Time;\n328\t    const sector1Pb = props.sector1Pb ?? DEFAULTS.sector1Pb;\n329\t    const sector2Pb = props.sector2Pb ?? DEFAULTS.sector2Pb;\n330\t    const sector3Pb = props.sector3Pb ?? DEFAULTS.sector3Pb;\n331\t    const driverId = props.driverId ?? DEFAULTS.driverId;\n332\t    const topSpeed = props.topSpeed ?? DEFAULTS.topSpeed;\n333\t\n334\t    if (typeof trackName !== \"string\") throw new Error(`${ID}: trackName must be a string.`);\n335\t    if (typeof lapTime !== \"string\") throw new Error(`${ID}: lapTime must be a string.`);\n336\t    if (typeof pbTime !== \"string\") throw new Error(`${ID}: pbTime must be a string.`);\n337\t    if (typeof driverId !== \"string\") throw new Error(`${ID}: driverId must be a string.`);\n338\t\n339\t    const px = (fx: number, fy: number, fw: number, fh: number) => ({\n340\t      x: Math.round(fx * W),\n341\t      y: Math.round(fy * H),\n342\t      w: Math.round(fw * W),\n343\t      h: Math.round(fh * H),\n344\t    });\n345\t\n346\t    const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n347\t    const piece = (rect: { x: number; y: number; w: number; h: number }, importance: number, source: MosaicSource) =>\n348\t      pieces.push({ rect: { ...rect, importance }, source });\n349\t\n350\t    const lapTimeMs = parseTimeToMs(lapTime);\n351\t    const pbTimeMs = parseTimeToMs(pbTime);\n352\t    const lapDeltaMs = lapTimeMs - pbTimeMs;\n353\t\n354\t    // Header - track name\n355\t    const trackRect = px(0.06, 0.02, 0.88, 0.08);\n356\t    piece(trackRect, 2, bindProp(tag(svgLabel(trackName, trackRect.w, trackRect.h, { maxPx: Math.round(H * 0.06), maxLines: 1, color: INK }), \"trackName\"), \"trackName\"));\n357\t\n358\t    // Lap time and delta\n359\t    const lapTimeRect = px(0.06, 0.11, 0.88, 0.065);\n360\t    const lapTimeText = `${formatTime(lapTimeMs)} (${formatDelta(lapDeltaMs)})`;\n361\t    piece(lapTimeRect, 2, bindProp(tag(svgLabel(lapTimeText, lapTimeRect.w, lapTimeRect.h, { maxPx: Math.round(H * 0.05), maxLines: 1, color: DIM }), \"lapTime\"), \"lapTime\"));\n362\t\n363\t    // Sectors - first pass to collect deltas for normalization\n364\t    const sectorData = [\n365\t      { name: \"sector1\", label: \"S1\", time: sector1Time, pb: sector1Pb, yStart: 0.2 },\n366\t      { name: \"sector2\", label: \"S2\", time: sector2Time, pb: sector2Pb, yStart: 0.4 },\n367\t      { name: \"sector3\", label: \"S3\", time: sector3Time, pb: sector3Pb, yStart: 0.6 },\n368\t    ];\n369\t\n370\t    const sectorDeltas = sectorData.map(sec => {\n371\t      const sectorMs = parseTimeToMs(sec.time);\n372\t      const pbMs = parseTimeToMs(sec.pb);\n373\t      return sectorMs - pbMs;\n374\t    });\n375\t\n376\t    const maxAbsDelta = Math.max(...sectorDeltas.map(d => Math.abs(d)));\n377\t    const barTrackWidth = 0.25;\n378\t    const barMinHeightPx = 3;\n379\t\n380\t    for (let i = 0; i < sectorData.length; i++) {\n381\t      const sec = sectorData[i];\n382\t      const sectorMs = parseTimeToMs(sec.time);\n383\t      const pbMs = parseTimeToMs(sec.pb);\n384\t      const deltaMs = sectorDeltas[i];\n385\t      const isGreen = deltaMs < 0;\n386\t\n387\t      // Sector label and time\n388\t      const labelRect = px(0.06, sec.yStart, 0.3, 0.065);\n389\t      const timeStr = `${sec.label}: ${formatTime(sectorMs)}`;\n390\t      const sectorPropName = sec.name.replace(\"sector\", \"sector\") + \"Time\";\n391\t      piece(labelRect, 2, bindProp(tag(svgLabel(timeStr, labelRect.w, labelRect.h, { maxPx: Math.round(H * 0.045), maxLines: 1, color: INK }), sec.name), sectorPropName as never));\n392\t\n393\t      // PB time\n394\t      const pbRect = px(0.38, sec.yStart, 0.25, 0.065);\n395\t      const pbPropName = sec.name.replace(\"sector\", \"sector\") + \"Pb\";\n396\t      piece(pbRect, 2, bindProp(tag(svgLabel(`PB ${formatTime(pbMs)}`, pbRect.w, pbRect.h, { maxPx: Math.round(H * 0.04), maxLines: 1, color: DIM }), `${sec.name}-pb`), pbPropName as never));\n397\t\n398\t      // Delta text\n399\t      const deltaRect = px(0.65, sec.yStart, 0.29, 0.065);\n400\t      const deltaColor = isGreen ? GREEN : RED;\n401\t      piece(deltaRect, 2, tag(svgLabel(formatDelta(deltaMs), deltaRect.w, deltaRect.h, { maxPx: Math.round(H * 0.04), maxLines: 1, color: deltaColor }), `${sec.name}-delta`));\n402\t\n403\t      // Delta bar - below the text\n404\t      if (maxAbsDelta > 0) {\n405\t        const barWidth = (Math.abs(deltaMs) / maxAbsDelta) * barTrackWidth * W;\n406\t        const barHeight = Math.max(barMinHeightPx, Math.round(H * 0.015));\n407\t        const barX = Math.round(0.65 * W);\n408\t        const barY = Math.round((sec.yStart + 0.05) * H);\n409\t        const barRect = { x: barX, y: barY, w: Math.round(barWidth), h: barHeight };\n410\t        piece(barRect, 1, tag(makeColorTile(isGreen ? GREEN : RED), `${sec.name}-bar`));\n411\t      }\n412\t    }\n413\t\n414\t    // Footer - driver left-aligned, speed right-aligned\n415\t    const driverRect = px(0.06, 0.85, 0.4, 0.08);\n416\t    piece(driverRect, 2, bindProp(tag(svgLabel(driverId, driverRect.w, driverRect.h, { maxPx: Math.round(H * 0.06), maxLines: 1, color: INK }), \"driverId\"), \"driverId\"));\n417\t\n418\t    const speedRect = px(0.54, 0.85, 0.4, 0.08);\n419\t    const speedText = `${topSpeed} km/h`;\n420\t    piece(speedRect, 2, bindProp(tag(svgLabel(speedText, speedRect.w, speedRect.h, { maxPx: Math.round(H * 0.06), maxLines: 1, color: DIM }), \"topSpeed\"), \"topSpeed\"));\n421\t\n422\t    const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n423\t    const doc: MosaicDocument = {\n424\t      kind: \"mosaic_document\",\n425\t      version: 1,\n426\t      m0: toM0String(placed.m0, ID),\n427\t      assets: {},\n428\t      backgroundColor: PAGE,\n429\t      sources: placed.sources,\n430\t    };\n431\t    return withLayoutIntent(doc, ctx, { templateId: ID, constraints: layoutContract(), debug: props.debugLayout === true });\n432\t}\n433\t"}]},"parent_tool_use_id":null,"session_id":"c0bab7cd-97d3-4a06-9b2a-9048a42d853b","uuid":"39fea167-b8d0-4905-8986-f5a3a7036725","timestamp":"2026-10-02T17:35:47.490Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\lap-telemetry-card\\v1\\lap-telemetry-card.ts","content":"import type {\n  MosaicColor,\n  MosaicDocument,\n  MosaicEngineContext,\n  MosaicSource,\n} from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport {\n  bindProp,\n  defineMosaicTemplate,\n  definePropsSchema,\n  makeColorTile,\n  placeInsetPieces,\n  svgLabel,\n  tag,\n} from \"@m0saic/template-utils\";\nimport type { LayoutConstraint } from \"@m0saic/template-utils\";\nimport { TEXT_EM, textFitsAll, withLayoutIntent } from \"../../../_shared/layout\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/sports/lap-telemetry-card/v1` — a sim racing lap achievement card:\n * track name, lap time, personal best, sector breakdown with times and deltas,\n * and proportional delta bars (green for faster, red for slower), driver name,\n * and top speed from telemetry or race results.\n *\n * ONE CONCEPT: the delta bar shows at a glance which sector was the bottleneck —\n * bar length is proportional to |delta|, green means faster than PB, red means\n * slower. The three sector bars scale relative to the largest |delta| on the card\n * so the longest bar fills its track and the others visibly rank by magnitude.\n *\n * The rule that bites: time formatting must match the parser exactly (M:SS.sss\n * or SS.sss), validation throws on bad format, delta sign is explicit (- for faster,\n * + for slower), and every time prop is validated before render.\n */\n\nexport type LapTelemetryCardProps = {\n  /** The track or circuit name. */\n  trackName?: string;\n  /** Lap time in M:SS.sss or SS.sss format. */\n  lapTime?: string;\n  /** Personal best lap time in M:SS.sss or SS.sss format. */\n  pbTime?: string;\n  /** Sector 1 lap time. */\n  sector1Time?: string;\n  /** Sector 2 lap time. */\n  sector2Time?: string;\n  /** Sector 3 lap time. */\n  sector3Time?: string;\n  /** Sector 1 personal best time. */\n  sector1Pb?: string;\n  /** Sector 2 personal best time. */\n  sector2Pb?: string;\n  /** Sector 3 personal best time. */\n  sector3Pb?: string;\n  /** Driver name or callsign. */\n  driverId?: string;\n  /** Top speed in km/h. */\n  topSpeed?: string;\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/sports/lap-telemetry-card/v1\";\nconst INK = \"#eaeef2\" as MosaicColor;\nconst DIM = \"#9aa7b4\" as MosaicColor;\nconst GREEN = \"#2ecc71\" as MosaicColor;\nconst RED = \"#e74c3c\" as MosaicColor;\nconst PAGE = \"#1c2833\" as MosaicColor;\n\nconst DEFAULTS = {\n  trackName: \"Nurburgring GP\",\n  lapTime: \"1:54.812\",\n  pbTime: \"1:55.420\",\n  sector1Time: \"35.104\",\n  sector2Time: \"41.236\",\n  sector3Time: \"38.472\",\n  sector1Pb: \"35.512\",\n  sector2Pb: \"41.561\",\n  sector3Pb: \"38.347\",\n  driverId: \"Driver\",\n  topSpeed: \"285\",\n};\n\nconst propsSchema = definePropsSchema<LapTelemetryCardProps>({\n  trackName: {\n    type: \"string\",\n    required: false,\n    description: \"The track or circuit name, up to 40 characters.\",\n    meta: { control: { placeholder: DEFAULTS.trackName }, ui: { label: \"Track\", order: 1 } },\n  },\n  lapTime: {\n    type: \"string\",\n    required: false,\n    description: \"Lap time in M:SS.sss or SS.sss format.\",\n    meta: { control: { placeholder: DEFAULTS.lapTime }, ui: { label: \"Lap time\", order: 2 } },\n  },\n  pbTime: {\n    type: \"string\",\n    required: false,\n    description: \"Personal best lap time.\",\n    meta: { control: { placeholder: DEFAULTS.pbTime }, ui: { label: \"PB time\", order: 3 } },\n  },\n  sector1Time: {\n    type: \"string\",\n    required: false,\n    description: \"Sector 1 lap time.\",\n    meta: { control: { placeholder: DEFAULTS.sector1Time }, ui: { label: \"Sector 1 time\", order: 4 } },\n  },\n  sector2Time: {\n    type: \"string\",\n    required: false,\n    description: \"Sector 2 lap time.\",\n    meta: { control: { placeholder: DEFAULTS.sector2Time }, ui: { label: \"Sector 2 time\", order: 5 } },\n  },\n  sector3Time: {\n    type: \"string\",\n    required: false,\n    description: \"Sector 3 lap time.\",\n    meta: { control: { placeholder: DEFAULTS.sector3Time }, ui: { label: \"Sector 3 time\", order: 6 } },\n  },\n  sector1Pb: {\n    type: \"string\",\n    required: false,\n    description: \"Sector 1 personal best time.\",\n    meta: { control: { placeholder: DEFAULTS.sector1Pb }, ui: { label: \"Sector 1 PB\", order: 7 } },\n  },\n  sector2Pb: {\n    type: \"string\",\n    required: false,\n    description: \"Sector 2 personal best time.\",\n    meta: { control: { placeholder: DEFAULTS.sector2Pb }, ui: { label: \"Sector 2 PB\", order: 8 } },\n  },\n  sector3Pb: {\n    type: \"string\",\n    required: false,\n    description: \"Sector 3 personal best time.\",\n    meta: { control: { placeholder: DEFAULTS.sector3Pb }, ui: { label: \"Sector 3 PB\", order: 9 } },\n  },\n  driverId: {\n    type: \"string\",\n    required: false,\n    description: \"Driver name or callsign, up to 30 characters.\",\n    meta: { control: { placeholder: DEFAULTS.driverId }, ui: { label: \"Driver\", order: 10 } },\n  },\n  topSpeed: {\n    type: \"string\",\n    required: false,\n    description: \"Top speed in km/h.\",\n    meta: { control: { placeholder: DEFAULTS.topSpeed }, ui: { label: \"Top speed\", order: 11 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\nfunction layoutContract(): LayoutConstraint[] {\n  return [\n    ...textFitsAll([\n      \"trackName\", \"lapTime\",\n      \"sector1\", \"sector1-pb\", \"sector1-delta\",\n      \"sector2\", \"sector2-pb\", \"sector2-delta\",\n      \"sector3\", \"sector3-pb\", \"sector3-delta\",\n      \"driverId\", \"topSpeed\"\n    ], { charWidthEm: TEXT_EM.prose }),\n    { label: \"trackName\", within: { yFrac: [0, 0.15] } },\n    { label: \"lapTime\", within: { yFrac: [0.1, 0.2] } },\n    { label: \"sector1\", within: { yFrac: [0.2, 0.4] } },\n    { label: \"sector1-pb\", within: { yFrac: [0.2, 0.4] } },\n    { label: \"sector1-delta\", within: { yFrac: [0.2, 0.4] } },\n    { label: \"sector1-bar\", within: { yFrac: [0.2, 0.4] } },\n    { label: \"sector2\", within: { yFrac: [0.4, 0.6] } },\n    { label: \"sector2-pb\", within: { yFrac: [0.4, 0.6] } },\n    { label: \"sector2-delta\", within: { yFrac: [0.4, 0.6] } },\n    { label: \"sector2-bar\", within: { yFrac: [0.4, 0.6] } },\n    { label: \"sector3\", within: { yFrac: [0.6, 0.8] } },\n    { label: \"sector3-pb\", within: { yFrac: [0.6, 0.8] } },\n    { label: \"sector3-delta\", within: { yFrac: [0.6, 0.8] } },\n    { label: \"sector3-bar\", within: { yFrac: [0.6, 0.8] } },\n    { label: \"driverId\", within: { yFrac: [0.8, 1] } },\n    { label: \"topSpeed\", within: { yFrac: [0.8, 1] } },\n  ];\n}\n\nconst WHY: WhySpec = {\n  \"day\": 13,\n  \"date\": \"2026-10-02\",\n  \"agent\": \"claude\",\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"id\": \"@one-a-day/sports/lap-telemetry-card/v1\",\n  \"title\": \"Sim Racing Lap Card\",\n  \"who\": \"Competitive sim racers in iRacing, Assetto Corsa, Le Mans Ultimate communities; platforms like SimTelemetry.site, YouTube channels, competitive leagues.\",\n  \"problem\": [\n    \"Sim racers want to share lap achievements - sector times, deltas vs PB, apex speeds - as shareable cards. SimTelemetry.site records telemetry at 60Hz. Drivers currently screenshot lap times or manually create graphics; a deterministic lap card lets them share standardized achievements.\"\n  ],\n  \"sources\": [\n    \"https://simtelemetry.site\",\n    \"https://news.ycombinator.com/item?id=49045861\"\n  ],\n  \"solution\": [\n    \"A deterministic lap