{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LP6Xdg9KuX82DPer9LGDeS","type":"tool_result","content":"1\timport { evaluateM0 } from \"@m0saic/dsl-stdlib\";\n2\timport { resolvePropBindings } from \"@m0saic/template-utils\";\n3\timport type { MosaicDocument } from \"@m0saic/types\";\n4\t\n5\timport { asDocument, targetCtx } from \"../../../__testutils__/render\";\n6\timport { CONTRACT_CANVASES, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\n7\timport {\n8\t  WeeklyRunReportV1,\n9\t  formatCount,\n10\t  formatRunDate,\n11\t  layoutWeeklyRunReport,\n12\t  parseMilestones,\n13\t  settleLayout,\n14\t} from \"./weekly-run-report\";\n15\timport type { WeeklyRunReportProps } from \"./weekly-run-report\";\n16\t\n17\tconst ID = \"@one-a-day/community/weekly-run-report/v1\";\n18\tconst render = (props: WeeklyRunReportProps = {}, w = 1080, h = 1080) =>\n19\t  WeeklyRunReportV1.render({ ...WeeklyRunReportV1.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n20\t\n21\t/** Every drawn string with its label: the parent's and those inside each child document (a tile, a badge). */\n22\tfunction texts(doc: MosaicDocument): Array<{ label: string; text: string; px: number }> {\n23\t  const own = (d: MosaicDocument) => (d.sources ?? [])\n24\t    .filter((s) => (s as { type?: string }).type === \"text\")\n25\t    .map((s) => {\n26\t      const src = s as unknown as { editor?: { label?: string }; layers: Array<{ content: { text: string }; style: { fontSize: number } }> };\n27\t      return { label: src.editor?.label ?? \"\", text: src.layers[0].content.text, px: src.layers[0].style.fontSize };\n28\t    });\n29\t  return [...own(doc), ...Object.values(doc.children ?? {}).flatMap((c) => own(c as MosaicDocument))];\n30\t}\n31\tconst textOf = (doc: MosaicDocument, label: string) => texts(doc).find((t) => t.label === label)?.text;\n32\t\n33\tconst TEN = \"6xR25, 4xR50, 3xR100, 2xR250, 1xR500, 1xR1000, 5xV25, 3xV50, 2xV100, 1xV250\";\n34\tconst SIX = \"6xR25, 4xR50, 3xR100, 2xR250, 1xR500, 5xV25\";\n35\tconst MAXED = { finishers: 9999, newPbs: 9999, firstTimers: 9999, visitors: 9999, volunteers: 9999, firstTimeVolunteers: 9999 };\n36\t\n37\tdescribe(ID, () => {\n38\t  it(\"draws the default week the brief promised, every string as typed\", async () => {\n39\t    const doc = await render();\n40\t    expect(textOf(doc, \"event-name\")).toBe(\"WILLOWMERE PARK 5K\");\n41\t    expect(textOf(doc, \"run-number\")).toBe(\"#312\");\n42\t    expect(textOf(doc, \"run-date\")).toBe(\"SAT 03 OCT 2026\");\n43\t    expect(textOf(doc, \"value-finishers\")).toBe(\"214\");\n44\t    expect(textOf(doc, \"value-volunteers\")).toBe(\"31\");\n45\t    expect(textOf(doc, \"value-newPbs\")).toBe(\"38\");\n46\t    expect(textOf(doc, \"value-firstTimers\")).toBe(\"27\");\n47\t    expect(textOf(doc, \"value-visitors\")).toBe(\"19\");\n48\t    expect(textOf(doc, \"value-firstTimeVolunteers\")).toBe(\"4\");\n49\t    expect(textOf(doc, \"band-title\")).toBe(\"MILESTONE CLUBS\");\n50\t    expect([1, 2, 3, 4].map((i) => `${textOf(doc, `badge-club-${i}`)} ${textOf(doc, `badge-caption-${i}`)}`)).toEqual([\n51\t      \"25 4 runners\", \"50 3 runners\", \"100 1 runner\", \"25 2 volunteers\",\n52\t    ]);\n53\t    expect(textOf(doc, \"footer\")).toBe(\"Sample week: event and numbers are invented\");\n54\t    // Every string on the card is ASCII.\n55\t    for (const t of texts(doc)) expect(t.text).toMatch(/^[\\x20-\\x7e]+$/);\n56\t  });\n57\t\n58\t  it(\"binds what it shows: the header props, each count to its own key, the footer, the accent and the band\", async () => {\n59\t    const doc = await render();\n60\t    const { byProp, rejected } = resolvePropBindings(doc, 1080, 1080, { propsSchema: WeeklyRunReportV1.propsSchema });\n61\t    expect(rejected).toEqual([]);\n62\t    for (const k of [\"eventName\", \"runNumber\", \"date\", \"footer\", \"accent\", \"milestones\"]) expect(byProp[k]).toHaveLength(1);\n63\t    expect(byProp.counts).toHaveLength(6);\n64\t  });\n65\t\n66\t  it(\"clears its safe minimum at its own hint\", async () => {\n67\t    const ev = evaluateM0(String((await render()).m0), { width: 1080, height: 1080 });\n68\t    expect(ev.feasible && ev.meetsPrecision).toBe(true);\n69\t  });\n70\t\n71\t  it(\"draws each tile and badge as a child document on the lattice: no recovery inset on a child, 5-smooth child canvases\", async () => {\n72\t    const smooth = (n: number) => { let k = n; for (const f of [2, 3, 5]) while (k % f === 0) k /= f; return k === 1; };\n73\t    for (const over of [{}, { milestones: TEN }, { milestones: \"\" }, { eventName: \"Great Salterns Nature Reserve 5k Juniors\", counts: MAXED }] as WeeklyRunReportProps[]) {\n74\t      for (const [w, h] of CONTRACT_CANVASES) {\n75\t        if (over.milestones === TEN && w <= 480) continue;\n76\t        const doc = await render(over, w, h);\n77\t        const refs = (doc.sources ?? []).filter((s) => (s as { type?: string }).type === \"mosaic\");\n78\t        expect(refs.length).toBe(Object.keys(doc.children ?? {}).length);\n79\t        for (const r of refs) expect((r as { placement?: { inset?: unknown } }).placement?.inset).toBeUndefined();\n80\t        for (const c of Object.values(doc.children ?? {})) {\n81\t          const size = (c as MosaicDocument).size!;\n82\t          expect(smooth(size.width) && smooth(size.height)).toBe(true);\n83\t        }\n84\t      }\n85\t    }\n86\t  });\n87\t\n88\t  it(\"keeps its layout contract at the seven contract canvases for the copy that stresses it\", async () => {\n89\t    expect(layoutIntentOf(await render())).not.toBeNull();\n90\t    const sweep = (over: WeeklyRunReportProps, canvases = CONTRACT_CANVASES) =>\n91\t      sweepLayout((p, ctx) => WeeklyRunReportV1.render(p, ctx).then(asDocument), ID, { ...WeeklyRunReportV1.defaultProps, ...over }, (w, h) => targetCtx(w, h), canvases);\n92\t    for (const over of [\n93\t      {},\n94\t      { eventName: \"Great Salterns Nature Reserve 5k\" },\n95\t      { eventName: \"Great Salterns Nature Reserve 5k Juniors\" },\n96\t      { eventName: \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" },\n97\t      { counts: MAXED, runNumber: 9999 },\n98\t      { milestones: \"\" },\n99\t      { milestones: \"1xR100\" },\n100\t      { milestones: SIX },\n101\t      { footer: \"\" },\n102\t      { footer: \"Thanks to all 31 volunteers - see you next Saturday at 9am by the cafe\" },\n103\t      { date: \"\" },\n104\t      { accent: \"#ffd23f\" },\n105\t    ] as WeeklyRunReportProps[]) await sweep(over);\n106\t    // Ten clubs: every canvas from 640x360 up; the 480x270 thumbnail refuses them (below).\n107\t    await sweep({ milestones: TEN, counts: MAXED }, CONTRACT_CANVASES.filter(([w]) => w > 480));\n108\t    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n109\t  });\n110\t\n111\t  it(\"keeps the hierarchy: the headline numbers are at least 1.5x the stat numbers and all tile labels share one size, at every canvas\", async () => {\n112\t    for (const over of [{}, { counts: MAXED }, { milestones: TEN }] as WeeklyRunReportProps[]) {\n113\t      for (const [w, h] of CONTRACT_CANVASES) {\n114\t        if (over.milestones === TEN && w < 1080) continue;\n115\t        const doc = await render(over, w, h);\n116\t        const t = texts(doc);\n117\t        const px = (prefix: string) => t.filter((x) => x.label.startsWith(prefix)).map((x) => x.px);\n118\t        const hero = px(\"value-finishers\").concat(px(\"value-volunteers\"));\n119\t        const stat = [\"newPbs\", \"firstTimers\", \"visitors\", \"firstTimeVolunteers\"].flatMap((k) => px(`value-${k}`));\n120\t        expect(hero).toHaveLength(2);\n121\t        expect(stat).toHaveLength(4);\n122\t        expect(Math.min(...hero)).toBeGreaterThanOrEqual(1.5 * Math.max(...stat));\n123\t        // ...and no club number outranks a stat number.\n124\t        for (const b of px(\"badge-club-\")) expect(b).toBeLessThanOrEqual(Math.min(...stat));\n125\t        expect(new Set(px(\"label-\")).size).toBe(1);\n126\t      }\n127\t    }\n128\t  });\n129\t\n130\t  it(\"reflows by aspect: 4x1 stats on the square, 2x2 in portrait and in the wide right column, no slab tiles\", () => {\n131\t    const sq = layoutWeeklyRunReport({}, 1080, 1080);\n132\t    expect(sq.shape).toBe(\"square\");\n133\t    expect(new Set(sq.statRects.map((r) => r.y)).size).toBe(1);\n134\t    const tall = layoutWeeklyRunReport({}, 1080, 1920);\n135\t    expect(tall.shape).toBe(\"tall\");\n136\t    expect(new Set(tall.statRects.map((r) => r.y)).size).toBe(2);\n137\t    const wide = layoutWeeklyRunReport({}, 1920, 1080);\n138\t    expect(wide.shape).toBe(\"wide\");\n139\t    expect(wide.heroRects[0].x).toBe(wide.heroRects[1].x);\n140\t    expect(new Set(wide.statRects.map((r) => r.x)).size).toBe(2);\n141\t    for (const [w, h] of CONTRACT_CANVASES) {\n142\t      const L = layoutWeeklyRunReport({}, w, h);\n143\t      for (const r of [...L.heroRects, ...L.statRects]) expect(r.h).toBeLessThanOrEqual(Math.ceil(r.w * 1.3));\n144\t    }\n145\t  });\n146\t\n147\t  it(\"keeps the milestone band every week: the empty week says so, six clubs wrap to 3 + 3, ten to 5 + 5\", async () => {\n148\t    const empty = await render({ milestones: \"\" });\n149\t    expect(textOf(empty, \"milestone-empty\")).toBe(\"No milestone clubs this week\");\n150\t    expect(texts(empty).some((t) => t.label.startsWith(\"badge-\"))).toBe(false);\n151\t    expect(layoutWeeklyRunReport({ milestones: \"\" }, 1080, 1080).band).toEqual(layoutWeeklyRunReport({}, 1080, 1080).band);\n152\t    const rows = (s: string, w: number, h: number) => {\n153\t      const ys = layoutWeeklyRunReport({ milestones: s }, w, h).badges.map((b) => b.rect.y);\n154\t      return [...new Set(ys)].map((y) => ys.filter((v) => v === y).length);\n155\t    };\n156\t    expect(rows(SIX, 1080, 1080)).toEqual([3, 3]);\n157\t    expect(rows(TEN, 1080, 1080)).toEqual([5, 5]);\n158\t    expect(rows(TEN, 1080, 1920)).toEqual([5, 5]);\n159\t    expect(rows(TEN, 1920, 1080)).toEqual([5, 5]);\n160\t    // Mid-size canvases whose lattice snap trims the badges still take every club count.\n161\t    for (const [w, h] of [[1000, 800], [1200, 900], [1290, 1000], [1440, 900], [1024, 768], [1600, 900]] as const) {\n162\t      for (let n = 6; n <= 10; n++) expect(() => settleLayout({ milestones: TEN.split(\", \").slice(0, n).join(\", \") }, w, h)).not.toThrow();\n163\t    }\n164\t    expect(rows(SIX, 1920, 1080)).toEqual([3, 3]);\n165\t    expect(rows(SIX, 1080, 1920)).toEqual([3, 3]);\n166\t    // Only a band whose two rows would fall below the floor (here a wide thumbnail) takes one long row.\n167\t    expect(settleLayout({ milestones: SIX }, 480, 270).L.badges.map((b) => b.rect.y).every((y, _, a) => y === a[0])).toBe(true);\n168\t    const wide = layoutWeeklyRunReport({ milestones: TEN }, 1920, 1080).badges;\n169\t    expect(new Set(wide.map((b) => `${b.rect.w}x${b.rect.h}`)).size).toBe(1);\n170\t    expect(() => settleLayout({ milestones: TEN }, 480, 270)).toThrow(/milestones cannot be fitted on 480x270/);\n171\t    expect(settleLayout({ milestones: TEN }, 640, 360).L.badges).toHaveLength(10);\n172\t    expect(settleLayout({ milestones: SIX }, 480, 270).L.badges).toHaveLength(6);\n173\t  });\n174\t\n175\t  it(\"parses the runstats milestones line: run clubs then volunteer clubs, ascending, and names a bad entry\", () => {\n176\t    const show = (s: string) => parseMilestones(s).map((b) => `${b.kind}${b.club} ${b.caption}`);\n177\t    expect(show(\"4xR25, 3xR50, 1xR100, 2xV25\")).toEqual([\"R25 4 runners\", \"R50 3 runners\", \"R100 1 runner\", \"V25 2 volunteers\"]);\n178\t    expect(show(\"1xr100,4xR25\")).toEqual([\"R25 4 runners\", \"R100 1 runner\"]);\n179\t    expect(show(\" 1 x V50 , 2xr25 \")).toEqual([\"R25 2 runners\", \"V50 1 volunteer\"]);\n180\t    expect(show(\"\")).toEqual([]);\n181\t    expect(() => parseMilestones(\"4xR30\")).toThrow(/'R30' is not a club \\(25, 50, 100, 250, 500, 1000\\)/);\n182\t    expect(() => parseMilestones(\"4xR25, 2xR25\")).toThrow(/R25 appears twice/);\n183\t    expect(() => parseMilestones(`${TEN}, 1xV500`)).toThrow(/11 entries; at most 10/);\n184\t    expect(() => parseMilestones(\"R25\")).toThrow(/\"R25\" is not <count>x<R\\|V><club>/);\n185\t  });\n186\t\n187\t  it(\"prints numbers and dates exactly: a thousands comma, the weekday from the date\", () => {\n188\t    expect(formatCount(1204)).toBe(\"1,204\");\n189\t    expect(formatCount(9999)).toBe(\"9,999\");\n190\t    expect(formatCount(999)).toBe(\"999\");\n191\t    expect(formatCount(0)).toBe(\"0\");\n192\t    expect(formatRunDate(\"2026-10-03\")).toBe(\"SAT 03 OCT 2026\");\n193\t    expect(formatRunDate(\"2004-10-02\")).toBe(\"SAT 02 OCT 2004\");\n194\t    expect(formatRunDate(\"2026-12-25\")).toBe(\"FRI 25 DEC 2026\");\n195\t    expect(formatRunDate(\"2024-02-29\")).toBe(\"THU 29 FEB 2024\");\n196\t    expect(formatRunDate(\"2026-02-30\")).toBeNull();\n197\t    expect(formatRunDate(\"03/10/2026\")).toBeNull();\n198\t  });\n199\t\n200\t  it(\"refuses every bad input with a message that names the field and the value\", async () => {\n201\t    const counts = { ...WeeklyRunReportV1.defaultProps.counts! };\n202\t    await expect(render({ counts: { ...counts, pb: 3 } as never })).rejects.toThrow(/counts has an unknown key 'pb'; use finishers, volunteers/);\n203\t    const { newPbs: _drop, ...missing } = counts;\n204\t    await expect(render({ counts: missing as never })).rejects.toThrow(/counts is missing 'newPbs'/);\n205\t    await expect(render({ counts: { ...counts, newPbs: 300 } })).rejects.toThrow(/counts.newPbs is 300, more than the 214 finishers/);\n206\t    await expect(render({ counts: { ...counts, firstTimeVolunteers: 40 } })).rejects.toThrow(/counts.firstTimeVolunteers is 40, more than the 31 volunteers/);\n207\t    await expect(render({ counts: { ...counts, finishers: 0 } })).rejects.toThrow(/counts.finishers must be at least 1/);\n208\t    await expect(render({ counts: { ...counts, visitors: 2.5 } })).rejects.toThrow(/counts.visitors must be a whole number/);\n209\t    await expect(render({ counts: { ...counts, finishers: 10000 } })).rejects.toThrow(/counts.finishers must be a whole number from 0 to 9999/);\n210\t    await expect(render({ milestones: \"4xR30\" })).rejects.toThrow(/milestones 'R30' is not a club/);\n211\t    await expect(render({ milestones: \"4xR25, 2xR25\" })).rejects.toThrow(/R25 appears twice/);\n212\t    await expect(render({ date: \"2026-02-30\" })).rejects.toThrow(/date \"2026-02-30\" is not a date/);\n213\t    await expect(render({ runNumber: 0 })).rejects.toThrow(/runNumber must be a whole number from 1 to 9999/);\n214\t    await expect(render({ eventName: \"\" })).rejects.toThrow(/eventName must not be empty/);\n215\t    await expect(render({ eventName: \"Park → 5k\" })).rejects.toThrow(/eventName .* has the character .* \\(U\\+2192\\)/);\n216\t    await expect(render({ eventName: \"A\".repeat(41) })).rejects.toThrow(/eventName .* is 41 characters; the card fits at most 40/);\n217\t    // The footer has no length cap: it shrinks to the floor and only then is refused.\n218\t    expect(textOf(await render({ footer: \"Thanks to all 58 volunteers - see you next Saturday at 9am by the cafe!\" }), \"footer\")).toMatch(/cafe!$/);\n219\t    await expect(render({ footer: \"word \".repeat(60).trim() })).rejects.toThrow(/footer cannot be fitted on 1080x1080 above the 18px readability floor/);\n220\t    await expect(render({ accent: \"green\" })).rejects.toThrow(/accent \"green\" must be #rrggbb/);\n221\t    // A misspelled prop is refused by name, so a typo never leaves the sample week on a real card.\n222\t    // counts may arrive as the raw JSON string a json prop's editor holds.\n223\t    expect(textOf(await render({ counts: JSON.stringify({ ...counts, finishers: 1204 }) } as never), \"value-finishers\")).toBe(\"1,204\");\n224\t    await expect(render({ counts: \"{finishers: 214\" } as never)).rejects.toThrow(/counts is not valid JSON/);\n225\t    await expect(render({ count: counts } as never)).rejects.toThrow(/unknown prop 'count'; did you mean 'counts'\\?/);\n226\t    await expect(render({ milestone: \"1xR50\" } as never)).rejects.toThrow(/unknown prop 'milestone'; did you mean 'milestones'\\?/);\n227\t    await expect(render({ colour: \"#000000\" } as never)).rejects.toThrow(/unknown prop 'colour'\\. The props are eventName/);\n228\t    // Club counts cannot exceed the people who ran or volunteered.\n229\t    const small = { finishers: 40, newPbs: 5, firstTimers: 3, visitors: 2, volunteers: 8, firstTimeVolunteers: 1 };\n230\t    await expect(render({ counts: small, milestones: \"30xR25, 20xR50\" })).rejects.toThrow(/milestones count 50 runners reaching a club, more than the 40 finishers/);\n231\t    await expect(render({ counts: small, milestones: \"9xV25\" })).rejects.toThrow(/milestones count 9 volunteers reaching a club, more than the 8 volunteers/);\n232\t    expect(await render({ counts: small, milestones: \"40xR25, 8xV25\" })).toBeDefined();\n233\t  });\n234\t\n235\t  it(\"takes accented Latin names, an empty date and footer, and a pale accent without losing the numbers\", async () => {\n236\t    const doc = await render({ eventName: \"Llyn Padarn Pàrc 5k\", date: \"\", footer: \"\" });\n237\t    expect(textOf(doc, \"event-name\")).toBe(\"LLYN PADARN PÀRC 5K\");\n238\t    expect(textOf(doc, \"run-date\")).toBeUndefined();\n239\t    expect(textOf(doc, \"footer\")).toBeUndefined();\n240\t    // \"\" falls back to the default accent.\n241\t    expect(layoutWeeklyRunReport({ accent: \"\" }, 1080, 1080).p.accent).toBe(\"#1f7a4d\");\n242\t    // A pale accent keeps the fills and the numbers go to ink.\n243\t    const pale = layoutWeeklyRunReport({ accent: \"#ffd23f\" }, 1080, 1080);\n244\t    expect(pale.p.heroInk).toBe(\"#1b1f1c\");\n245\t    expect(layoutWeeklyRunReport({}, 1080, 1080).p.heroInk).toBe(\"#1f7a4d\");\n246\t  });\n247\t\n248\t  it(\"is the event's card, not ours: no parkrun word in the defaults or the fixed copy, no template credit\", async () => {\n249\t    const doc = await render();\n250\t    const all = JSON.stringify(WeeklyRunReportV1.defaultProps) + texts(doc).map((t) => t.text).join(\" \");\n251\t    expect(all.toLowerCase()).not.toContain(\"parkrun\");\n252\t    const noFooter = await render({ footer: \"\" });\n253\t    // Without the footer, nothing on the card is copy the run director did not type, except the fixed labels.\n254\t    expect(texts(noFooter).map((t) => t.label).filter((l) => !/^(event-name|run-|value-|label-|band-title|badge-)/.test(l))).toEqual([]);\n255\t  });\n256\t\n257\t  it(\"is deterministic\", async () => {\n258\t    expect(await render()).toEqual(await render());\n259\t    expect(await render({ milestones: TEN }, 1920, 1080)).toEqual(await render({ milestones: TEN }, 1920, 1080));\n260\t  });\n261\t});\n262\t"}]},"parent_tool_use_id":null,"session_id":"281cba01-5109-4cf8-8e5b-19d8491f37d2","uuid":"66649784-d5ac-4034-8578-7de8273247fe","timestamp":"2026-10-06T20:55:34.501Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\community\\weekly-run-report\\v1\\weekly-run-report.test.ts","content":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { resolvePropBindings } from \"@m0saic/template-utils\";\nimport type { MosaicDocument } from \"@m0saic/types\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { CONTRACT_CANVASES, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport {\n  WeeklyRunReportV1,\n  formatCount,\n  formatRunDate,\n  layoutWeeklyRunReport,\n  parseMilestones,\n  settleLayout,\n} from \"./weekly-run-report\";\nimport type { WeeklyRunReportProps } from \"./weekly-run-report\";\n\nconst ID = \"@one-a-day/community/weekly-run-report/v1\";\nconst render = (props: WeeklyRunReportProps = {}, w = 1080, h = 1080) =>\n  WeeklyRunReportV1.render({ ...WeeklyRunReportV1.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n\n/** Every drawn string with its label: the parent's and those inside each child document (a tile, a badge). */\nfunction texts(doc: MosaicDocument): Array<{ label: string; text: string; px: number }> {\n  const own = (d: MosaicDocument) => (d.sources ?? [])\n    .filter((s) => (s as { type?: string }).type === \"text\")\n    .map((s) => {\n      const src = s as unknown as { editor?: { label?: string }; layers: Array<{ content: { text: string }; style: { fontSize: number } }> };\n      return { label: src.editor?.label ?? \"\", text: src.layers[0].content.text, px: src.layers[0].style.fontSize };\n    });\n  return [...own(doc), ...Object.values(doc.children ?? {}).flatMap((c) => own(c as MosaicDocument))];\n}\nconst textOf = (doc: MosaicDocument, label: string) => texts(doc).find((t) => t.label === label)?.text;\n\nconst TEN = \"6xR25, 4xR50, 3xR100, 2xR250, 1xR500, 1xR1000, 5xV25, 3xV50, 2xV100, 1xV250\";\nconst SIX = \"6xR25, 4xR50, 3xR100, 2xR250, 1xR500, 5xV25\";\nconst MAXED = { finishers: 9999, newPbs: 9999, firstTimers: 9999, visitors: 9999, volunteers: 9999, firstTimeVolunteers: 9999 };\n\ndescribe(ID, () => {\n  it(\"draws the default week the brief promised, every string as typed\", async () => {\n    const doc = await render();\n    expect(textOf(doc, \"event-name\")).toBe(\"WILLOWMERE PARK 5K\");\n    expect(textOf(doc, \"run-number\")).toBe(\"#312\");\n    expect(textOf(doc, \"run-date\")).toBe(\"SAT 03 OCT 2026\");\n    expect(textOf(doc, \"value-finishers\")).toBe(\"214\");\n    expect(textOf(doc, \"value-volunteers\")).toBe(\"31\");\n    expect(textOf(doc, \"value-newPbs\")).toBe(\"38\");\n    expect(textOf(doc, \"value-firstTimers\")).toBe(\"27\");\n    expect(textOf(doc, \"value-visitors\")).toBe(\"19\");\n    expect(textOf(doc, \"value-firstTimeVolunteers\")).toBe(\"4\");\n    expect(textOf(doc, \"band-title\")).toBe(\"MILESTONE CLUBS\");\n    expect([1, 2, 3, 4].map((i) => `${textOf(doc, `badge-club-${i}`)} ${textOf(doc, `badge-caption-${i}`)}`)).toEqual([\n      \"25 4 runners\", \"50 3 runners\", \"100 1 runner\", \"25 2 volunteers\",\n    ]);\n    expect(textOf(doc, \"footer\")).toBe(\"Sample week: event and numbers are invented\");\n    // Every string on the card is ASCII.\n    for (const t of texts(doc)) expect(t.text).toMatch(/^[\\x20-\\x7e]+$/);\n  });\n\n  it(\"binds what it shows: the header props, each count to its own key, the footer, the accent and the band\", async () => {\n    const doc = await render();\n    const { byProp, rejected } = resolvePropBindings(doc, 1080, 1080, { propsSchema: WeeklyRunReportV1.propsSchema });\n    expect(rejected).toEqual([]);\n    for (const k of [\"eventName\", \"runNumber\", \"date\", \"footer\", \"accent\", \"milestones\"]) expect(byProp[k]).toHaveLength(1);\n    expect(byProp.counts).toHaveLength(6);\n  });\n\n  it(\"clears its safe minimum at its own hint\", async () => {\n    const ev = evaluateM0(String((await render()).m0), { width: 1080, height: 1080 });\n    expect(ev.feasible && ev.meetsPrecision).toBe(true);\n  });\n\n  it(\"draws each tile and badge as a child document on the lattice: no recovery inset on a child, 5-smooth child canvases\", async () => {\n    const smooth = (n: number) => { let k = n; for (const f of [2, 3, 5]) while (k % f === 0) k /= f; return k === 1; };\n    for (const over of [{}, { milestones: TEN }, { milestones: \"\" }, { eventName: \"Great Salterns Nature Reserve 5k Juniors\", counts: MAXED }] as WeeklyRunReportProps[]) {\n      for (const [w, h] of CONTRACT_CANVASES) {\n        if (over.milestones === TEN && w <= 480) continue;\n        const doc = await render(over, w, h);\n        const refs = (doc.sources ?? []).filter((s) => (s as { type?: string }).type === \"mosaic\");\n        expect(refs.length).toBe(Object.keys(doc.children ?? {}).length);\n        for (const r of refs) expect((r as { placement?: { inset?: unknown } }).placement?.inset).toBeUndefined();\n        for (const c of Object.values(doc.children ?? {})) {\n          const size = (c as MosaicDocument).size!;\n          expect(smooth(size.width) && smooth(size.height)).toBe(true);\n        }\n      }\n    }\n  });\n\n  it(\"keeps its layout contract at the seven contract canvases for the copy that stresses it\", async () => {\n    expect(layoutIntentOf(await render())).not.toBeNull();\n    const sweep = (over: WeeklyRunReportProps, canvases = CONTRACT_CANVASES) =>\n      sweepLayout((p, ctx) => WeeklyRunReportV1.render(p, ctx).then(asDocument), ID, { ...WeeklyRunReportV1.defaultProps, ...over }, (w, h) => targetCtx(w, h), canvases);\n    for (const over of [\n      {},\n      { eventName: \"Great Salterns Nature Reserve 5k\" },\n      { eventName: \"Great Salterns Nature Reserve 5k Juniors\" },\n      { eventName: \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" },\n      { counts: MAXED, runNumber: 9999 },\n      { milestones: \"\" },\n      { milestones: \"1xR100\" },\n      { milestones: SIX },\n      { footer: \"\" },\n      { footer: \"Thanks to all 31 volunteers - see you next Saturday at 9am by the cafe\" },\n      { date: \"\" },\n      { accent: \"#ffd23f\" },\n    ] as WeeklyRunReportProps[]) await sweep(over);\n    // Ten clubs: every canvas from 640x360 up; the 480x270 thumbnail refuses them (below).\n    await sweep({ milestones: TEN, counts: MAXED }, CONTRACT_CANVASES.filter(([w]) => w > 480));\n    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n  });\n\n  it(\"keeps the hierarchy: the headline numbers are at least 1.5x the stat numbers and all tile labels share one size, at every canvas\", async () => {\n    for (const over of [{}, { counts: MAXED }, { milestones: TEN }] as WeeklyRunReportProps[]) {\n      for (const [w, h] of CONTRACT_CANVASES) {\n        if (over.milestones === TEN && w < 1080) continue;\n        const doc = await render(over, w, h);\n        const t = texts(doc);\n        const px = (prefix: string) => t.filter((x) => x.label.startsWith(prefix)).map((x) => x.px);\n        const hero = px(\"value-finishers\").concat(px(\"value-volunteers\"));\n        const stat = [\"newPbs\", \"firstTimers\", \"visitors\", \"firstTimeVolunteers\"].flatMap((k) => px(`value-${k}`));\n        expect(hero).toHaveLength(2);\n        expect(stat).toHaveLength(4);\n        expect(Math.min(...hero)).toBeGreaterThanOrEqual(1.5 * Math.max(...stat));\n        // ...and no club number outranks a stat number.\n        for (const b of px(\"badge-club-\")) expect(b).toBeLessThanOrEqual(Math.min(...stat));\n        expect(new Set(px(\"label-\")).size).toBe(1);\n      }\n    }\n  });\n\n  it(\"reflows by aspect: 4x1 stats on the square, 2x2 in portrait and in the wide right column, no slab tiles\", () => {\n    const sq = layoutWeeklyRunReport({}, 1080, 1080);\n    expect(sq.shape).toBe(\"square\");\n    expect(new Set(sq.statRects.map((r) => r.y)).size).toBe(1);\n    const tall = layoutWeeklyRunReport({}, 1080, 1920);\n    expect(tall.shape).toBe(\"tall\");\n    expect(new Set(tall.statRects.map((r) => r.y)).size).toBe(2);\n    const wide = layoutWeeklyRunReport({}, 1920, 1080);\n    expect(wide.shape).toBe(\"wide\");\n    expect(wide.heroRects[0].x).toBe(wide.heroRects[1].x);\n    expect(new Set(wide.statRects.map((r) => r.x)).size).toBe(2);\n    for (const [w, h] of CONTRACT_CANVASES) {\n      const L = layoutWeeklyRunReport({}, w, h);\n      for (const r of [...L.heroRects, ...L.statRects]) expect(r.h).toBeLessThanOrEqual(Math.ceil(r.w * 1.3));\n    }\n  });\n\n  it(\"keeps the milestone band every week: the empty week says so, six clubs wrap to 3 + 3, ten to 5 + 5\", async () => {\n    const empty = await render({ milestones: \"\" });\n    expect(textOf(empty, \"milestone-empty\")).toBe(\"No milestone clubs this week\");\n    expect(texts(empty).some((t) => t.label.startsWith(\"badge-\"))).toBe(false);\n    expect(layoutWeeklyRunReport({ milestones: \"\" }, 1080, 1080).band).toEqual(layoutWeeklyRunReport({}, 1080, 1080).band);\n    const rows = (s: string, w: number, h: number) => {\n      const ys = layoutWeeklyRunReport({ milestones: s }, w, h).badges.map((b) => b.rect.y);\n      return [...new Set(ys)].map((y) => ys.filter((v) => v === y).length);\n    };\n    expect(rows(SIX, 1080, 1080)).toEqual([3, 3]);\n    expect(rows(TEN, 1080, 1080)).toEqual([5, 5]);\n    expect(rows(TEN, 1080, 1920)).toEqual([5, 5]);\n    expect(rows(TEN, 1920, 1080)).toEqual([5, 5]);\n    // Mid-size canvases whose lattice snap trims the badges still take every club count.\n    for (const [w, h] of [[1000, 800], [1200, 900], [1290, 1000], [1440, 900], [1024, 768], [1600, 900]] as const) {\n      for (let n = 6; n <= 10; n++) expect(() => settleLayout({ milestones: TEN.split(\", \").slice(0, n).join(\", \") }, w, h)).not.toThrow();\n    }\n    expect(rows(SIX, 1920, 1080)).toEqual([3, 3]);\n    expect(rows(SIX, 1080, 1920)).toEqual([3, 3]);\n    // Only a band whose two rows would fall below the floor (here a wide thumbnail) takes one long row.\n    expect(settleLayout({ milestones: SIX }, 480, 270).L.badges.map((b) => b.rect.y).every((y, _, a) => y === a[0])).toBe(true);\n    const wide = layoutWeeklyRunReport({ milestones: TEN }, 1920, 1080).badges;\n    expect(new Set(wide.map((b) => `${b.rect.w}x${b.rect.h}`)).size).toBe(1);\n    expect(() => settleLayout({ milestones: TEN }, 480, 270)).toThrow(/milestones cannot be fitted on 480x270/);\n    expect(settleLayout({ milestones: TEN }, 640, 360).L.badges).toHaveLength(10);\n    expect(settleLayout({ milestones: SIX }, 480, 270).L.badges).toHaveLength(6);\n  });\n\n  it(\"parses the runstats milestones line: run clubs then volunteer clubs, ascending, and names a bad entry\", () => {\n    const show = (s: string) => parseMilestones(s).map((b) => `${b.kind}${b.club} ${b.caption}`);\n    expect(show(\"4xR25, 3xR50, 1xR100, 2xV25\")).toEqual([\"R25 4 runners\", \"R50 3 runners\", \"R100 1 runner\", \"V25 2 volunteers\"]);\n    expect(show(\"1xr100,4xR25\")).toEqual([\"R25 4 runners\", \"R100 1 runner\"]);\n    expect(show(\" 1 x V50 , 2xr25 \")).toEqual([\"R25 2 runners\", \"V50 1 volunteer\"]);\n    expect(show(\"\")).toEqual([]);\n    expect(() => parseMilestones(\"4xR30\")).toThrow(/'R30' is not a club \\(25, 50, 100, 250, 500, 1000\\)/);\n    expect(() => parseMilestones(\"4xR25, 2xR25\")).toThrow(/R25 appears twice/);\n    expect(() => parseMilestones(`${TEN}, 1xV500`)).toThrow(/11 entries; at most 10/);\n    expect(() => parseMilestones(\"R25\")).toThrow(/\"R25\" is not <count>x<R\\|V><club>/);\n  });\n\n  it(\"prints numbers and dates exactly: a thousands comma, the weekday from the date\", () => {\n    expect(formatCount(1204)).toBe(\"1,204\");\n    expect(formatCount(9999)).toBe(\"9,999\");\n    expect(formatCount(999)).toBe(\"999\");\n    expect(formatCount(0)).toBe(\"0\");\n    expect(formatRunDate(\"2026-10-03\")).toBe(\"SAT 03 OCT 2026\");\n    expect(formatRunDate(\"2004-10-02\")).toBe(\"SAT 02 OCT 2004\");\n    expect(formatRunDate(\"2026-12-25\")).toBe(\"FRI 25 DEC 2026\");\n    expect(formatRunDate(\"2024-02-29\")).toBe(\"THU 29 FEB 2024\");\n    expect(formatRunDate(\"2026-02-30\")).toBeNull();\n    expect(formatRunDate(\"03/10/2026\")).toBeNull();\n  });\n\n  it(\"refuses every bad input with a message that names the field and the value\", async () => {\n    const counts = { ...WeeklyRunReportV1.defaultProps.counts! };\n    await expect(render({ counts: { ...counts, pb: 3 } as never })).rejects.toThrow(/counts has an unknown key 'pb'; use finishers, volunteers/);\n    const { newPbs: _drop, ...missing } = counts;\n    await expect(render({ counts: missing as never })).rejects.toThrow(/counts is missing 'newPbs'/);\n    await expect(render({ counts: { ...counts, newPbs: 300 } })).rejects.toThrow(/counts.newPbs is 300, more than the 214 finishers/);\n    await expect(render({ counts: { ...counts, firstTimeVolunteers: 40 } })).rejects.toThrow(/counts.firstTimeVolunteers is 40, more than the 31 volunteers/);\n    await expect(render({ counts: { ...counts, finishers: 0 } })).rejects.toThrow(/counts.finishers must be at least 1/);\n    await expect(render({ counts: { ...counts, visitors: 2.5 } })).rejects.toThrow(/counts.visitors must be a whole number/);\n    await expect(render({ counts: { ...counts, finishers: 10000 } })).rejects.toThrow(/counts.finishers must be a whole number from 0 to 9999/);\n    await expect(render({ milestones: \"4xR30\" })).rejects.toThrow(/milestones 'R30' is not a club/);\n    await expect(render({ milestones: \"4xR25, 2xR25\" })).rejects.toThrow(/R25 appears twice/);\n    await expect(render({ date: \"2026-02-30\" })).rejects.toThrow(/date \"2026-02-30\" is not a date/);\n    await expect(render({ runNumber: 0 })).rejects.toThrow(/runNumber must be a whole number from 1 to 9999/);\n    await expect(render({ eventName: \"\" })).rejects.toThrow(/eventName must not be empty/);\n    await expect(render({ eventName: \"Park → 5k\" })).rejects.toThrow(/eventName .* has the character .* \\(U\\+2192\\)/);\n    await expect(render({ eventName: \"A\".repeat(41) })).rejects.toThrow(/eventName .* is 41 characters; the card fits at most 40/);\n    // The footer has no length cap: it shrinks to the floor and only then is refused.\n    expect(textOf(await render({ footer: \"Thanks to all 58 volunteers - see you next Saturday at 9am by the cafe!\" }), \"footer\")).toMatch(/cafe!$/);\n    await expect(render({ footer: \"word \".repeat(60).trim() })).rejects.toThrow(/footer cannot be fitted on 1080x1080 above the 18px readability floor/);\n    await expect(render({ accent: \"green\" })).rejects.toThrow(/accent \"green\" must be #rrggbb/);\n    // A misspelled prop is refused by name, so a typo never leaves the sample week on a real card.\n    // counts may arrive as the raw JSON string a json prop's editor holds.\n    expect(textOf(await render({ counts: JSON.stringify({ ...counts, finishers: 1204 }) } as never), \"value-finishers\")).toBe(\"1,204\");\n    await expect(render({ counts: \"{finishers: 214\" } as never)).rejects.toThrow(/counts is not valid JSON/);\n    await expect(render({ count: counts } as never)).rejects.toThrow(/unknown prop 'count'; did you mean 'counts'\\?/);\n    await expect(render({ milestone: \"1xR50\" } as never)).rejects.toThrow(/unknown prop 'milestone'; did you mean 'milestones'\\?/);\n    await expect(render({ colour: \"#000000\" } as never)).rejects.toThrow(/unknown prop 'colour'\\. The props are eventName/);\n    // Club counts cannot exceed the people who ran or volunteered.\n    const small = { finishers: 40, newPbs: 5, firstTimers: 3, visitors: 2, volunteers: 8, firstTimeVolunteers: 1 };\n    await expect(render({ counts: small, milestones: \"30xR25, 20xR50\" })).rejects.toThrow(/milestones count 50 runners reaching a club, more than the 40 finishers/);\n    await expect(render({ counts: small, milestones: \"9xV25\" })).rejects.toThrow(/milestones count 9 volunteers reaching a club, more than the 8 volunteers/);\n    expect(await render({ counts: small, milestones: \"40xR25, 8xV25\" })).toBeDefined();\n  });\n\n  it(\"takes accented Latin names, an empty date and footer, and a pale accent without losing the numbers\", async () => {\n    const doc = await render({ eventName: \"Llyn Padarn Pàrc 5k\", date: \"\", footer: \"\" });\n    expect(textOf(doc, \"event-name\")).toBe(\"LLYN PADARN PÀRC 5K\");\n    expect(textOf(doc, \"run-date\")).toBeUndefined();\n    expect(textOf(doc, \"footer\")).toBeUndefined();\n    // \"\" falls back to the default accent.\n    expect(layoutWeeklyRunReport({ accent: \"\" }, 1080, 1080).p.accent).toBe(\"#1f7a4d\");\n    // A pale accent keeps the fills and the numbers go to ink.\n    const pale = layoutWeeklyRunReport({ accent: \"#ffd23f\" }, 1080, 1080);\n    expect(pale.p.heroInk).toBe(\"#1b1f1c\");\n    expect(layoutWeeklyRunReport({}, 1080, 1080).p.heroInk).toBe(\"#1f7a4d\");\n  });\n\n  it(\"is the event's card, not ours: no parkrun word in the defaults or the fixed copy, no template credit\", async () => {\n    const doc = await render();\n    const all = JSON.stringify(WeeklyRunReportV1.defaultProps) + texts(doc).map((t) => t.text).join(\" \");\n    expect(all.toLowerCase()).not.toContain(\"parkrun\");\n    const noFooter = await render({ footer: \"\" });\n    // Without the footer, nothing on the card is copy the run director did not type, except the fixed labels.\n    expect(texts(noFooter).map((t) => t.label).filter((l) => !/^(event-name|run-|value-|label-|band-title|badge-)/.test(l))).toEqual([]);\n  });\n\n  it(\"is deterministic\", async () => {\n    expect(await render()).toEqual(await render());\n    expect(await render({ milestones: TEN }, 1920, 1080)).toEqual(await render({ milestones: TEN }, 1920, 1080));\n  });\n});\n","numLines":262,"startLine":1,"totalLines":262}}}
