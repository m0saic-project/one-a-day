{"type":"tool_use","timestamp":1792858848761,"sessionID":"ses_e914a8a92ffed6Ny0syywiP6Oa","part":{"type":"tool","tool":"read","callID":"call_00_gGIGbdwT2EGdBJVM6Zp56056","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-24\\variants\\b\\src\\orienteering-split-analysis.ts"},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-24\\variants\\b\\src\\orienteering-split-analysis.ts</path>\n<type>file</type>\n<content>\n1: import type {\n2:   MosaicColor,\n3:   MosaicDocument,\n4:   MosaicEngineContext,\n5:   MosaicSource,\n6: } from \"@m0saic/types\";\n7: import { asTemplateId } from \"@m0saic/types\";\n8: import { toM0String } from \"@m0saic/dsl-stdlib\";\n9: import {\n10:   bindProp,\n11:   bindPropPath,\n12:   defineMosaicTemplate,\n13:   definePropsSchema,\n14:   makeColorTile,\n15:   placeInsetPieces,\n16:   tag,\n17: } from \"@m0saic/template-utils\";\n18: import type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\n19: import { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n20: import { budget, textCell, widthOf } from \"../../../_shared/text\";\n21: import { whyTutorial } from \"../../../_shared/why\";\n22: import type { WhySpec } from \"../../../_shared/why\";\n23: \n24: /**\n25:  * `@one-a-day/sports/orienteering-split-analysis/v1` - one racer's IOF XML 3.0\n26:  * result row as a shareable split-analysis card: finish time as the hero, the\n27:  * course and the place, then control-by-control legs as a tape whose length is\n28:  * the split, and a footer that answers the one question everyone asks -\n29:  * \"where did I lose time?\" - as TIME W/O MISTAKES, TOTAL LOSS and BEST LEG.\n30:  *\n31:  * ONE CONCEPT: the mistake is the picture. A leg's bar length is its split\n32:  * over the slowest leg, so the eye reads the race; a leg with time loss\n33:  * (`loss > 0`, the WinSplits per-leg number) is drawn in the accent - pink\n34:  * bar, signed pink loss - and a clean leg is neutral with an empty loss cell.\n35:  * No legend: pink = mistake, bar length = split.\n36:  *\n37:  * The rule that bites: time loss is NOT re-derived. WinSplits computes it\n38:  * class-relative from the whole field, so it comes in as a prop per leg; the\n39:  * card only sums the entered losses (TOTAL LOSS), subtracts them from the\n40:  * entered finish (TIME W/O MISTAKES) and takes the min split (BEST LEG) - and\n41:  * it never checks the finish against the split sum. A decimal time, an\n42:  * h:mm:ss loss, a leg count outside 4-18, or a leg that will not fit the\n43:  * canvas fails fast with a named field.\n44:  */\n45: \n46: export type OrienteeringLeg = { control: string; split: string; loss: string };\n47: \n48: export type OrienteeringSplitAnalysisProps = {\n49:   /** The racer, the header's bold line. Up to 40 ASCII; \"\" hides it. */\n50:   name?: string;\n51:   /** The club, first half of the second line. Up to 40 ASCII; \"\" hides it. */\n52:   club?: string;\n53:   /** The class, joined after the club with \" · \". Up to 20 ASCII. */\n54:   className?: string;\n55:   /** The course, the third header line. Up to 48 ASCII; \"\" hides it. */\n56:   course?: string;\n57:   /** The finish time, the hero figure. \"m:ss\" or \"h:mm:ss\", whole seconds. */\n58:   finish?: string;\n59:   /** The place, drawn as the accent \"#12\" chip. 0 hides the chip. */\n60:   place?: number;\n61:   /** Time behind the winner, printed as entered. Up to 16 ASCII; \"\" hides it. */\n62:   behind?: string;\n63:   /** The legs in course order, 4-18, each { control, split, loss }. */\n64:   splits?: OrienteeringLeg[] | string;\n65:   /** The mistake-leg pink - bars, loss text, place chip - as #rrggbb. */\n66:   accent?: string;\n67:   /** Page and ink: \"dark\" share card or \"light\" print. */\n68:   preset?: \"dark\" | \"light\";\n69:   /** Dev-only: check the layout contract and draw it over the card. */\n70:   debugLayout?: boolean;\n71: };\n72: \n73: const ID = \"@one-a-day/sports/orienteering-split-analysis/v1\";\n74: const TITLE = \"Orienteering Split Analysis\";\n75: const DEFAULT_ACCENT = \"#d94f8c\";\n76: const ASCII = /^[\\x20-\\x7e]*$/;\n77: const HEX = /^#[0-9a-fA-F]{6}$/;\n78: \n79: const THEMES = {\n80:   dark: { bg: \"#14111d\", ink: \"#efe9f2\", dim: \"#9b92a4\" },\n81:   light: { bg: \"#f6f2ef\", ink: \"#241d28\", dim: \"#6f6574\" },\n82: } as const;\n83: \n84: /** A 12-control middle course: 13 legs in course order, the last the finish. */\n85: export const DEFAULT_LEGS: OrienteeringLeg[] = [\n86:   { control: \"1\", split: \"4:08\", loss: \"0:47\" },\n87:   { control: \"2\", split: \"2:41\", loss: \"0:00\" },\n88:   { control: \"3\", split: \"3:15\", loss: \"0:00\" },\n89:   { control: \"4\", split: \"2:58\", loss: \"0:00\" },\n90:   { control: \"5\", split: \"5:22\", loss: \"1:20\" },\n91:   { control: \"6\", split: \"3:40\", loss: \"0:00\" },\n92:   { control: \"7\", split: \"1:32\", loss: \"0:00\" },\n93:   { control: \"8\", split: \"4:05\", loss: \"0:00\" },\n94:   { control: \"9\", split: \"3:51\", loss: \"0:51\" },\n95:   { control: \"10\", split: \"2:44\", loss: \"0:00\" },\n96:   { control: \"11\", split: \"3:33\", loss: \"0:00\" },\n97:   { control: \"12\", split: \"4:11\", loss: \"0:00\" },\n98:   { control: \"F\", split: \"1:55\", loss: \"0:00\" },\n99: ];\n100: \n101: const DEFAULTS = {\n102:   name: \"Emma Lindqvist\",\n103:   club: \"OK Klyftamo\",\n104:   className: \"W21E\",\n105:   course: \"Middle, 4.2 km\",\n106:   finish: \"45:02\",\n107:   place: 12,\n108:   behind: \"+1:23\",\n109:   splits: DEFAULT_LEGS,\n110:   accent: DEFAULT_ACCENT,\n111:   preset: \"dark\" as \"dark\" | \"light\",\n112:   debugLayout: false,\n113: };\n114: \n115: const propsSchema = definePropsSchema<OrienteeringSplitAnalysisProps>({\n116:   name: {\n117:     type: \"string\",\n118:     required: false,\n119:     description: \"The racer, the header's bold line. Up to 40 ASCII characters; empty hides the line. The sample is invented.\",\n120:     meta: { control: { placeholder: DEFAULTS.name }, ui: { label: \"Name\", order: 1, primary: true } },\n121:   },\n122:   club: {\n123:     type: \"string\",\n124:     required: false,\n125:     description: 'The club, first half of the second header line. Up to 40 ASCII; empty hides it. Joined to the class with \" · \".',\n126:     meta: { control: { placeholder: DEFAULTS.club }, ui: { label: \"Club\", order: 2 } },\n127:   },\n128:   className: {\n129:     type: \"string\",\n130:     required: false,\n131:     description: 'The class, joined after the club with \" · \". Up to 20 ASCII; empty shows the club alone.',\n132:     meta: { control: { placeholder: DEFAULTS.className }, ui: { label: \"Class\", order: 3 } },\n133:   },\n134:   course: {\n135:     type: \"string\",\n136:     required: false,\n137:     description: \"The course, the third header line, e.g. \\\"Middle, 4.2 km\\\". Up to 48 ASCII; empty hides it.\",\n138:     meta: { control: { placeholder: DEFAULTS.course }, ui: { label: \"Course\", order: 4 } },\n139:   },\n140:   finish: {\n141:     type: \"string\",\n142:     required: false,\n143:     description: 'The finish time, the hero figure. \"m:ss\" (minutes may pass 59, so \"71:40\" is legal) or \"h:mm:ss\", whole seconds. A decimal fails fast.',\n144:     meta: { control: { placeholder: DEFAULTS.finish }, ui: { label: \"Finish\", order: 5, primary: true } },\n145:   },\n146:   place: {\n147:     type: \"number\",\n148:     required: false,\n149:     description: \"The place, drawn as the accent chip #12. Whole number 0-9999; 0 hides the chip.\",\n150:     meta: { constraints: { min: 0, max: 9999 }, control: { placeholder: String(DEFAULTS.place) }, ui: { label: \"Place\", order: 6 } },\n151:   },\n152:   behind: {\n153:     type: \"string\",\n154:     required: false,\n155:     description: 'Time behind the winner, printed as entered, e.g. \"+1:23\". Up to 16 ASCII; empty hides it.',\n156:     meta: { control: { placeholder: DEFAULTS.behind }, ui: { label: \"Behind\", order: 7 } },\n157:   },\n158:   splits: {\n159:     type: \"json\",\n160:     required: false,\n161:     description:\n162:       'The legs in course order, 4-18. Each object is { control, split, loss } - the IOF field names. control is the code, split is \"m:ss\" or \"h:mm:ss\" (whole seconds), loss is the WinSplits per-leg time loss as \"m:ss\" (\"0:00\" = clean, anything more = a mistake leg drawn pink). Example: [{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}].',\n163:     meta: {\n164:       constraints: {\n165:         jsonSchema: {\n166:           type: \"array\",\n167:           minItems: 4,\n168:           maxItems: 18,\n169:           items: {\n170:             type: \"object\",\n171:             required: [\"control\", \"split\", \"loss\"],\n172:             properties: {\n173:               control: { type: \"string\", minLength: 1, maxLength: 8 },\n174:               split: { type: \"string\" },\n175:               loss: { type: \"string\" },\n176:             },\n177:           },\n178:         },\n179:       },\n180:       control: { mono: true, placeholder: '[{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}]' },\n181:       ui: { label: \"Splits\", order: 8, primary: true },\n182:     },\n183:   },\n184:   accent: {\n185:     type: \"string\",\n186:     required: false,\n187:     description: \"The mistake-leg pink - bars, loss text and the place chip - as #rrggbb.\",\n188:     meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 9 } },\n189:   },\n190:   preset: {\n191:     type: \"string\",\n192:     required: false,\n193:     description: 'Page and ink: \"dark\" (default) or \"light\".',\n194:     meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 10 } },\n195:   },\n196:   debugLayout: {\n197:     type: \"boolean\",\n198:     required: false,\n199:     description: \"Dev-only: check the layout contract (every text fits its box, header/body/footer hold their bands, rows equal, tape at least 32% wide) and draw it over the card.\",\n200:     meta: { ui: { label: \"Debug layout\", order: 99 } },\n201:   },\n202: });\n203: \n204: function fail(field: string, rule: string): never {\n205:   throw new Error(`${ID}: ${field} ${rule}`);\n206: }\n207: \n208: /**\n209:  * \"m:ss\" or \"h:mm:ss\" to whole seconds. Minutes may pass 59 in the one-colon\n210:  * form. Seconds (and minutes in the two-colon form) are 0-59. A decimal is\n211:  * refused, not rounded. null when the string is not that grammar.\n212:  */\n213: export function parseSplitTime(text: string): number | null {\n214:   const s = text.trim();\n215:   if (s.length === 0 || /[.]/.test(s)) return null;\n216:   const hms = /^(\\d+):([0-5]\\d):([0-5]\\d)$/.exec(s);\n217:   if (hms) return Number(hms[1]) * 3600 + Number(hms[2]) * 60 + Number(hms[3]);\n218:   const ms = /^(\\d+):([0-5]\\d)$/.exec(s);\n219:   if (ms) return Number(ms[1]) * 60 + Number(ms[2]);\n220:   return null;\n221: }\n222: \n223: /** Compact, no leading zeros. Hours only when the value is at least one hour. */\n224: export function formatSplitTime(sec: number): string {\n225:   const h = Math.floor(sec / 3600);\n226:   const m = Math.floor((sec % 3600) / 60);\n227:   const ss = String(sec % 60).padStart(2, \"0\");\n228:   if (h >= 1) return `${h}:${String(m).padStart(2, \"0\")}:${ss}`;\n229:   return `${m}:${ss}`;\n230: }\n231: \n232: function text(value: unknown, field: string, max: number): string {\n233:   if (typeof value !== \"string\") fail(field, \"must be a string.\");\n234:   if (!ASCII.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII.`);\n235:   const s = value.trim();\n236:   if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n237:   return s;\n238: }\n239: \n240: /** m:ss or h:mm:ss, whole seconds, at least one second, at most 99:59:59. */\n241: function timeField(value: unknown, field: string): { sec: number; printed: string } {\n242:   if (typeof value !== \"string\") fail(field, 'must be a string, \"m:ss\" or \"h:mm:ss\".');\n243:   const sec = parseSplitTime(value);\n244:   if (sec === null) fail(field, `${JSON.stringify(value)} is not a time: write m:ss or h:mm:ss, whole seconds, no decimal (e.g. \"4:08\" or \"1:11:40\").`);\n245:   if (sec < 1) fail(field, `${JSON.stringify(value)} must be at least one second.`);\n246:   if (sec > 359999) fail(field, `${JSON.stringify(value)} is longer than 99:59:59; the card cannot fit it.`);\n247:   return { sec, printed: formatSplitTime(sec) };\n248: }\n249: \n250: /** The WinSplits per-leg loss: m:ss only (never hours), zero allowed (clean). */\n251: function lossField(value: unknown, field: string): { sec: number; printed: string } {\n252:   if (typeof value !== \"string\") fail(field, 'must be a string, \"m:ss\".');\n253:   const t = value.trim();\n254:   if (!/^\\d+:[0-5]\\d$/.test(t)) fail(field, `${JSON.stringify(value)} is not m:ss: write m:ss, whole seconds (e.g. \"0:47\"); a loss is a per-leg time, never hours.`);\n255:   const sec = parseSplitTime(t)!;\n256:   if (sec > 359999) fail(field, `${JSON.stringify(value)} is longer than 99:59:59.`);\n257:   return { sec, printed: formatSplitTime(sec) };\n258: }\n259: \n260: export type Leg = {\n261:   index: number;\n262:   control: string;\n263:   split: string;\n264:   splitSec: number;\n265:   loss: string;\n266:   lossSec: number;\n267:   isMistake: boolean;\n268: };\n269: \n270: export type NormalizedSplitCard = {\n271:   name: string;\n272:   club: string;\n273:   className: string;\n274:   course: string;\n275:   clubLine: string;\n276:   finish: string;\n277:   finishSec: number;\n278:   place: number;\n279:   placeText: string;\n280:   behind: string;\n281:   legs: Leg[];\n282:   slowestSec: number;\n283:   bestSec: number;\n284:   totalLossSec: number;\n285:   totalLossText: string;\n286:   timeWoText: string;\n287:   bestText: string;\n288:   accent: MosaicColor;\n289:   preset: \"dark\" | \"light\";\n290:   debugLayout: boolean;\n291: };\n292: \n293: /** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n294: export function normalizeSplitCard(props: OrienteeringSplitAnalysisProps): NormalizedSplitCard {\n295:   const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n296:   const name = text(p.name, \"name\", 40);\n297:   const club = text(p.club, \"club\", 40);\n298:   const className = text(p.className, \"className\", 20);\n299:   const course = text(p.course, \"course\", 48);\n300:   const behind = text(p.behind, \"behind\", 16);\n301:   if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n302:   if (typeof p.accent !== \"string\" || !HEX.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n303:   if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n304:   const finish = timeField(p.finish, \"finish\");\n305:   if (typeof p.place !== \"number\" || !Number.isFinite(p.place)) fail(\"place\", \"must be a number.\");\n306:   if (!Number.isInteger(p.place)) fail(\"place\", \"must be a whole number.\");\n307:   if (p.place < 0 || p.place > 9999) fail(\"place\", `${p.place} is outside 0-9999; 0 hides the chip.`);\n308: \n309:   let splits = p.splits;\n310:   if (typeof splits === \"string\") {\n311:     try {\n312:       splits = JSON.parse(splits);\n313:     } catch {\n314:       fail(\"splits\", `is not valid JSON: ${JSON.stringify(splits.slice(0, 60))}. Pass a list of {control, split, loss}.`);\n315:     }\n316:   }\n317:   if (!Array.isArray(splits)) fail(\"splits\", 'must be a list of legs, e.g. [{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}].');\n318:   if (splits.length < 4 || splits.length > 18) fail(\"splits\", `has ${splits.length} legs; a course is 4 to 18 legs (the finish leg counts).`);\n319:   const legs: Leg[] = splits.map((raw, i) => {\n320:     if (raw === null || typeof raw !== \"object\" || Array.isArray(raw)) fail(`splits[${i}]`, \"must be an object with control, split and loss.\");\n321:     const o = raw as OrienteeringLeg;\n322:     const control = text(o.control, `splits[${i}].control`, 8);\n323:     if (control === \"\") fail(`splits[${i}].control`, \"is empty; give the control code.\");\n324:     const split = timeField(o.split, `splits[${i}].split`);\n325:     const loss = lossField(o.loss, `splits[${i}].loss`);\n326:     return { index: i, control, split: split.printed, splitSec: split.sec, loss: loss.printed, lossSec: loss.sec, isMistake: loss.sec > 0 };\n327:   });\n328: \n329:   const slowestSec = Math.max(...legs.map((l) => l.splitSec));\n330:   const bestSec = Math.min(...legs.map((l) => l.splitSec));\n331:   const totalLossSec = legs.reduce((a, l) => a + l.lossSec, 0);\n332:   if (totalLossSec > finish.sec) {\n333:     fail(\"splits\", `the per-leg losses sum to ${formatSplitTime(totalLossSec)}, more than the finish ${finish.printed}; time-without-mistakes would be negative.`);\n334:   }\n335:   const clubLine = [club, className].filter((s) => s !== \"\").join(\" \\u00b7 \");\n336:   return {\n337:     name, club, className, course, clubLine,\n338:     finish: finish.printed, finishSec: finish.sec,\n339:     place: p.place, placeText: p.place > 0 ? `#${p.place}` : \"\",\n340:     behind,\n341:     legs, slowestSec, bestSec, totalLossSec,\n342:     totalLossText: totalLossSec > 0 ? `+${formatSplitTime(totalLossSec)}` : \"0:00\",\n343:     timeWoText: formatSplitTime(finish.sec - totalLossSec),\n344:     bestText: formatSplitTime(bestSec),\n345:     accent: p.accent.trim().toLowerCase() as MosaicColor,\n346:     preset: p.preset, debugLayout: p.debugLayout,\n347:   };\n348: }\n349: \n350: function mix(a: string, b: string, t: number): MosaicColor {\n351:   const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n352:   const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n353:   return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n354: }\n355: function luminance(hex: string): number {\n356:   const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n357:   return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n358: }\n359: function onColor(fill: string): MosaicColor {\n360:   const ratio = (other: string) => { const a = luminance(fill), b = luminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n361:   return (ratio(\"#14111d\") >= ratio(\"#ffffff\") ? \"#14111d\" : \"#ffffff\") as MosaicColor;\n362: }\n363: \n364: export type SplitRect = { x: number; y: number; w: number; h: number };\n365: type Bind =\n366:   | { kind: \"prop\"; key: string }\n367:   | { kind: \"path\"; path: (string | number)[]; valueKind: \"string\" | \"number\" }\n368:   | null;\n369: type Cell = { label: string; rect: SplitRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\n370: type Tile = { label: string; rect: SplitRect; color: MosaicColor; radius: number; layer: number; accent?: boolean };\n371: \n372: function fitPx(line: string, cellW: number, maxPx: number, bold = false): number {\n373:   const top = Math.max(1, Math.round(maxPx));\n374:   const room = budget(cellW);\n375:   const w = widthOf(line, top, bold);\n376:   let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n377:   while (px > 1 && widthOf(line, px, bold) > room) px--;\n378:   return px;\n379: }\n380: \n381: /** The whole card as rects and measured fits - pure in (props, canvas). */\n382: export function layoutSplitCard(props: OrienteeringSplitAnalysisProps, W: number, H: number) {\n383:   const p = normalizeSplitCard(props);\n384:   const theme = THEMES[p.preset];\n385:   const ink = theme.ink as MosaicColor;\n386:   const dim = theme.dim as MosaicColor;\n387:   const S = Math.min(H, 0.75 * W);\n388:   const m = Math.max(8, Math.round(S * 0.04));\n389:   const CW = W - 2 * m;\n390:   const floor = Math.max(6, Math.round(Math.min(W, H) * 0.012));\n391:   const small = Math.max(5, Math.round(Math.min(W, H) * 0.009));\n392:   const gap = Math.max(3, Math.round(CW * 0.01));\n393:   const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n394: \n395:   // The three pinned bands: header [0, 0.26], body [0.26, 0.80], footer [0.80, 1].\n396:   const headerBottom = Math.floor(0.26 * H) - 1;\n397:   const bodyTop = Math.ceil(0.26 * H) + 2;\n398:   const bodyBottom = Math.floor(0.8 * H) - 2;\n399:   const footerTop = Math.ceil(0.8 * H) + 2;\n400: \n401:   const cells: Cell[] = [];\n402:   const tiles: Tile[] = [];\n403:   const line = (label: string, rect: SplitRect, value: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string; floorAt?: number } = {}) => {\n404:     if (px < (o.floorAt ?? floor)) unfit(o.field ?? label);\n405:     if (rect.w < 4 || rect.h < 4) unfit(o.field ?? label);\n406:     cells.push({ label, rect, text: value, px, width: widthOf(value, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? ink, bind: o.bind ?? null, over: o.over === true });\n407:   };\n408: \n409:   const portrait = H > W * 1.15;\n410:   const heroCap = Math.round(S * (portrait ? 0.22 : 0.145));\n411: \n412:   type Header = {\n413:     heroPx: number; blockTop: number; blockH: number; rightW: number; leftW: number;\n414:     finishRect: SplitRect; labelPx: number; chipPx: number; chipRect: SplitRect | null; behindPx: number;\n415:     namePx: number; clubPx: number; coursePx: number; leftTop: number; rightTop: number; row1H: number; row2H: number;\n416:     finishLabelRect: SplitRect; placeLabelRect: SplitRect | null; behindRect: SplitRect | null;\n417:   };\n418: \n419:   const headerAt = (heroPx: number): Header | null => {\n420:     if (heroPx <= floor) return null;\n421:     const labelPx = Math.max(small, Math.min(Math.round(heroPx * 0.18), heroPx - 2));\n422:     const chipPx = p.place > 0 ? Math.max(small, Math.min(Math.round(heroPx * 0.26), heroPx - 2)) : 0;\n423:     const behindPx = p.behind !== \"\" ? Math.max(small, Math.min(Math.round(heroPx * 0.24), heroPx - 2)) : 0;\n424:     const chipPad = Math.max(3, Math.round(chipPx * 0.45));\n425: \n426:     const finishW = Math.ceil((widthOf(p.finish, heroPx, true) + 2) / 0.94) + 2;\n427:     const finishLabelW = Math.ceil((widthOf(\"FINISH\", labelPx) + 2) / 0.94) + 2;\n428:     const row1W = finishLabelW + gap + finishW;\n429:     const chipW = p.place > 0 ? Math.ceil((widthOf(p.placeText, chipPx, true) + 2) / 0.94) + 2 + 2 * chipPad : 0;\n430:     const placeLabelW = p.place > 0 ? Math.ceil((widthOf(\"PLACE\", labelPx) + 2) / 0.94) + 2 : 0;\n431:     const behindW = p.behind !== \"\" ? Math.ceil((widthOf(p.behind, behindPx) + 2) / 0.94) + 2 : 0;\n432:     const hasRow2 = p.place > 0 || p.behind !== \"\";\n433:     let row2W = 0;\n434:     if (hasRow2) row2W = (placeLabelW > 0 ? placeLabelW + gap : 0) + (chipW > 0 ? chipW + gap : 0) + behindW;\n435:     const rightW = Math.max(row1W, row2W);\n436:     const leftW = CW - rightW - gap;\n437:     if (leftW < Math.round(CW * 0.34)) return null;\n438: \n439:     const namePx = p.name === \"\" ? 0 : fitPx(p.name, leftW, Math.min(heroPx - 1, Math.round(S * 0.05)), true);\n440:     const clubPx = p.clubLine === \"\" ? 0 : fitPx(p.clubLine, leftW, Math.min(heroPx - 2, Math.round(S * 0.03)));\n441:     const coursePx = p.course === \"\" ? 0 : fitPx(p.course, leftW, Math.min(heroPx - 2, Math.round(S * 0.028)));\n442:     if ((p.name !== \"\" && namePx < floor) || (p.clubLine !== \"\" && clubPx < small) || (p.course !== \"\" && coursePx < small)) return null;\n443:     if (chipPx > 0 && chipPx < small) return null;\n444:     if (labelPx < small) return null;\n445: \n446:     const finishH = Math.round(heroPx * 1.16);\n447:     const finishLabelH = Math.round(labelPx * 1.3);\n448:     const row1H = Math.max(finishH, finishLabelH);\n449:     const chipH = p.place > 0 ? Math.round(chipPx * 1.7) : 0;\n450:     const behindH = p.behind !== \"\" ? Math.round(behindPx * 1.3) : 0;\n451:     const placeLabelH = p.place > 0 ? Math.round(labelPx * 1.3) : 0;\n452:     const row2H = Math.max(chipH, behindH, placeLabelH);\n453:     const rightH = row1H + (hasRow2 ? gap + row2H : 0);\n454: \n455:     const nameH = p.name !== \"\" ? Math.round(namePx * 1.2) : 0;\n456:     const clubH = p.clubLine !== \"\" ? Math.round(clubPx * 1.3) : 0;\n457:     const courseH = p.course !== \"\" ? Math.round(coursePx * 1.3) : 0;\n458:     const leftParts = [nameH, clubH, courseH].filter((h) => h > 0);\n459:     const leftGap = Math.max(2, Math.round(gap * 0.45));\n460:     const leftH = leftParts.reduce((a, h) => a + h, 0) + Math.max(0, leftParts.length - 1) * leftGap;\n461: \n462:     const blockH = Math.max(rightH, leftH, finishH);\n463:     const avail = headerBottom - m;\n464:     if (blockH > avail) return null;\n465:     const blockTop = m + Math.max(0, Math.round((avail - blockH) / 2));\n466:     const rightTop = blockTop;\n467:     const leftTop = blockTop;\n468: \n469:     const finishRect: SplitRect = { x: W - m - finishW, y: rightTop + Math.round((row1H - finishH) / 2), w: finishW, h: finishH };\n470:     const finishLabelRect: SplitRect = { x: W - m - row1W, y: rightTop + Math.round((row1H - finishLabelH) / 2), w: finishLabelW, h: finishLabelH };\n471:     let placeLabelRect: SplitRect | null = null;\n472:     let chipRect: SplitRect | null = null;\n473:     let behindRect: SplitRect | null = null;\n474:     if (hasRow2) {\n475:       const row2Y = rightTop + row1H + gap;\n476:       let rx = W - m;\n477:       if (p.behind !== \"\") {\n478:         behindRect = { x: rx - behindW, y: row2Y + Math.round((row2H - behindH) / 2), w: behindW, h: behindH };\n479:         rx = behindRect.x - gap;\n480:       }\n481:       if (p.place > 0) {\n482:         chipRect = { x: rx - chipW, y: row2Y + Math.round((row2H - chipH) / 2), w: chipW, h: chipH };\n483:         rx = chipRect.x - gap;\n484:         placeLabelRect = { x: rx - placeLabelW, y: row2Y + Math.round((row2H - placeLabelH) / 2), w: placeLabelW, h: placeLabelH };\n485:       }\n486:     }\n487: \n488:     return { heroPx, blockTop, blockH, rightW, leftW, finishRect, labelPx, chipPx, chipRect, behindPx, namePx, clubPx, coursePx, leftTop, rightTop, row1H, row2H, finishLabelRect, placeLabelRect, behindRect };\n489:   };\n490: \n491:   let heroPx = Math.min(heroCap, Math.max(floor + 8, Math.round((headerBottom - m) * 0.5)));\n492:   let header: Header | null = null;\n493:   while (heroPx > floor + 1) {\n494:     header = headerAt(heroPx);\n495:     if (header) break;\n496:     heroPx -= 1;\n497:   }\n498:   const hd = header ?? fail(\"finish\", `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n499: \n500:   // ---- header left block (top-aligned) ----\n501:   let ly = hd.leftTop;\n502:   const leftX = m;\n503:   if (p.name !== \"\") {\n504:     const h = Math.round(hd.namePx * 1.2);\n505:     line(\"name\", { x: leftX, y: ly, w: hd.leftW, h }, p.name, hd.namePx, { bold: true, bind: { kind: \"prop\", key: \"name\" }, field: \"name\" });\n506:     ly += h + Math.max(2, Math.round(gap * 0.45));\n507:   }\n508:   if (p.clubLine !== \"\") {\n509:     const h = Math.round(hd.clubPx * 1.3);\n510:     let cx2 = leftX;\n511:     if (p.club !== \"\") {\n512:       const w = Math.ceil((widthOf(p.club, hd.clubPx) + 2) / 0.94) + 2;\n513:       line(\"club\", { x: cx2, y: ly, w, h }, p.club, hd.clubPx, { color: dim, bind: { kind: \"prop\", key: \"club\" }, field: \"club\", floorAt: small });\n514:       cx2 += w;\n515:     }\n516:     if (p.className !== \"\") {\n517:       const t = p.club !== \"\" ? \" \\u00b7 \" + p.className : p.className;\n518:       const w = Math.ceil((widthOf(t, hd.clubPx) + 2) / 0.94) + 2;\n519:       line(\"class\", { x: cx2, y: ly, w, h }, t, hd.clubPx, { color: dim, bind: { kind: \"prop\", key: \"className\" }, field: \"className\", floorAt: small });\n520:     }\n521:     ly += h + Math.max(2, Math.round(gap * 0.45));\n522:   }\n523:   if (p.course !== \"\") {\n524:     const h = Math.round(hd.coursePx * 1.3);\n525:     line(\"course\", { x: leftX, y: ly, w: hd.leftW, h }, p.course, hd.coursePx, { color: dim, bind: { kind: \"prop\", key: \"course\" }, field: \"course\", floorAt: small });\n526:   }\n527: \n528:   // ---- header right block ----\n529:   line(\"finish\", hd.finishRect, p.finish, hd.heroPx, { bold: true, align: \"right\", bind: { kind: \"prop\", key: \"finish\" }, field: \"finish\" });\n530:   line(\"finish-label\", hd.finishLabelRect, \"FINISH\", hd.labelPx, { color: dim, align: \"right\", floorAt: small });\n531:   if (hd.placeLabelRect) {\n532:     line(\"place-label\", hd.placeLabelRect, \"PLACE\", hd.labelPx, { color: dim, align: \"right\", floorAt: small });\n533:   }\n534:   if (hd.chipRect && p.place > 0) {\n535:     tiles.push({ label: \"place-chip\", rect: hd.chipRect, color: p.accent, radius: 1, layer: 5, accent: true });\n536:     line(\"place\", hd.chipRect, p.placeText, hd.chipPx, { bold: true, align: \"center\", color: onColor(p.accent), bind: { kind: \"prop\", key: \"place\" }, over: true, floorAt: small, field: \"place\" });\n537:   }\n538:   if (hd.behindRect && p.behind !== \"\") {\n539:     line(\"behind\", hd.behindRect, p.behind, hd.behindPx, { color: dim, align: \"right\", bind: { kind: \"prop\", key: \"behind\" }, field: \"behind\", floorAt: small });\n540:   }\n541: \n542:   // ---- body: one row per leg, tape length = split / slowest ----\n543:   const rowH = Math.floor((bodyBottom - bodyTop) / p.legs.length);\n544:   if (rowH < 8) unfit(\"the leg rows\");\n545:   const rowsEnd = bodyTop + rowH * p.legs.length;\n546: \n547:   const idxW = Math.max(Math.round(CW * 0.05), Math.round(S * 0.035));\n548:   const tapeW = Math.round(CW * 0.36);\n549:   if (tapeW / W < 0.32) unfit(\"the tape\");\n550:   const remaining = CW - idxW - tapeW - 3 * gap;\n551:   if (remaining < Math.round(CW * 0.14)) unfit(\"the split and loss columns\");\n552:   const splitColW = Math.round(remaining * 0.5);\n553:   const lossColW = remaining - splitColW;\n554:   let cx = m;\n555:   const take = (w: number) => { const r = { x: cx, w }; cx += w + gap; return r; };\n556:   const cCtrl = take(idxW);\n557:   const cTape = take(tapeW);\n558:   const cSplit = take(splitColW);\n559:   const cLoss = take(lossColW);\n560: \n561:   const rowCap = hd.heroPx - 1;\n562:   const rowHeightCap = Math.floor((rowH - 2) / 1.25);\n563:   const longestControl = p.legs.reduce((s, l) => (l.control.length >= s.length ? l.control : s), \"100\");\n564:   const longestSplit = p.legs.reduce((s, l) => (l.split.length >= s.length ? l.split : s), \"4:08\");\n565:   const mistakeLosses = p.legs.filter((l) => l.isMistake).map((l) => `+${l.loss}`);\n566:   let rowPx = Math.min(rowCap, rowHeightCap);\n567:   rowPx = Math.min(\n568:     rowPx,\n569:     fitPx(longestControl, cCtrl.w, rowPx),\n570:     fitPx(longestSplit, cSplit.w, rowPx),\n571:     ...(mistakeLosses.length > 0 ? [fitPx(mistakeLosses.reduce((s, t) => (t.length >= s.length ? t : s), \"+0:00\"), cLoss.w, rowPx, true)] : []),\n572:   );\n573:   if (rowPx < floor) unfit(\"the leg rows\");\n574: \n575:   const barH = Math.max(4, Math.min(rowH - 4, Math.round(Math.min(rowH * 0.42, S * 0.04))));\n576:   const railColor = mix(theme.bg, theme.ink, 0.14);\n577:   const barColor = mix(theme.bg, theme.ink, p.preset === \"dark\" ? 0.5 : 0.45);\n578:   const textH = Math.round(rowPx * 1.25);\n579:   const textYOff = Math.round((rowH - textH) / 2);\n580: \n581:   const bands: SplitRect[] = [];\n582:   p.legs.forEach((leg, i) => {\n583:     const band: SplitRect = { x: m, y: bodyTop + i * rowH, w: CW, h: rowH };\n584:     bands.push(band);\n585:     const wash = leg.isMistake ? mix(theme.bg, p.accent, 0.16) : mix(theme.bg, theme.ink, i % 2 === 0 ? 0.035 : 0.07);\n586:     tiles.push({ label: `band-${i}`, rect: band, color: wash, radius: 0, layer: 0 });\n587:     if (leg.isMistake) {\n588:       const ruleW = Math.max(2, Math.round(S * 0.004));\n589:       tiles.push({ label: `mistake-rule-${i}`, rect: { x: band.x, y: band.y, w: ruleW, h: band.h }, color: p.accent, radius: 0, layer: 4, accent: true });\n590:     }\n591:     const rail: SplitRect = { x: cTape.x, y: band.y + Math.round((rowH - barH) / 2), w: cTape.w, h: barH };\n592:     tiles.push({ label: `rail-${i}`, rect: rail, color: railColor, radius: 0, layer: 2 });\n593:     const barW = Math.max(1, Math.round(rail.w * leg.splitSec / p.slowestSec));\n594:     const bar: SplitRect = { x: rail.x, y: rail.y, w: barW, h: rail.h };\n595:     tiles.push({ label: `bar-${i}`, rect: bar, color: leg.isMistake ? p.accent : barColor, radius: 0, layer: 3, accent: leg.isMistake });\n596:     const ty = band.y + textYOff;\n597:     line(`ctrl-${i}`, { x: cCtrl.x, y: ty, w: cCtrl.w, h: textH }, leg.control, rowPx, { color: dim, align: \"right\", bind: { kind: \"path\", path: [i, \"control\"], valueKind: \"string\" }, floorAt: small });\n598:     line(`split-${i}`, { x: cSplit.x, y: ty, w: cSplit.w, h: textH }, leg.split, rowPx, { color: dim, align: \"right\", bind: { kind: \"path\", path: [i, \"split\"], valueKind: \"string\" } });\n599:     if (leg.isMistake) {\n600:       line(`loss-${i}`, { x: cLoss.x, y: ty, w: cLoss.w, h: textH }, `+${leg.loss}`, rowPx, { bold: true, color: p.accent, align: \"right\", bind: { kind: \"path\", path: [i, \"loss\"], valueKind: \"string\" } });\n601:     }\n602:   });\n603: \n604:   // ---- footer: three computed cells ----\n605:   const footLabelPx0 = Math.min(hd.heroPx - 2, Math.round(S * 0.02));\n606:   const footValuePx0 = Math.min(hd.heroPx - 1, Math.round(S * 0.042));\n607:   const cellW = Math.floor(CW / 3);\n608:   const footLabels = [\"TIME W/O MISTAKES\", \"TOTAL LOSS\", \"BEST LEG\"] as const;\n609:   const footValues = [p.timeWoText, p.totalLossText, p.bestText];\n610:   let footLabelPx = footLabels.reduce((px, t) => Math.min(px, fitPx(t, cellW, footLabelPx0)), footLabelPx0);\n611:   let footValuePx = footValues.reduce((px, t) => Math.min(px, fitPx(t, cellW, footValuePx0, true)), footValuePx0);\n612:   if (footLabelPx < small) unfit(\"the footer labels\");\n613:   if (footValuePx < floor) unfit(\"the footer values\");\n614:   if (footValuePx >= hd.heroPx) footValuePx = hd.heroPx - 1;\n615:   if (footLabelPx >= hd.heroPx) footLabelPx = Math.max(small, hd.heroPx - 2);\n616:   const footLabelH = Math.round(footLabelPx * 1.3);\n617:   const footValueH = Math.round(footValuePx * 1.2);\n618:   const footGap = Math.max(2, Math.round(gap * 0.45));\n619:   const footBlock = footLabelH + footGap + footValueH;\n620:   let footTop = Math.max(footerTop, rowsEnd + gap);\n621:   if (footTop + footBlock > H - m) {\n622:     footTop = Math.max(footerTop, H - m - footBlock);\n623:   }\n624:   if (footTop + footBlock > H - Math.max(4, Math.round(m * 0.4))) unfit(\"the footer\");\n625: \n626:   const footKeys = [\"time-wo\", \"total-loss\", \"best-leg\"] as const;\n627:   for (let i = 0; i < 3; i++) {\n628:     const x = m + i * cellW;\n629:     const cell: SplitRect = { x, y: footTop, w: cellW, h: footBlock };\n630:     tiles.push({ label: `foot-${i}`, rect: cell, color: mix(theme.bg, theme.ink, 0.04), radius: 0, layer: 0 });\n631:     line(`foot-label-${i}`, { x, y: footTop, w: cellW, h: footLabelH }, footLabels[i], footLabelPx, { color: dim, align: \"center\", floorAt: small });\n632:     line(footKeys[i], { x, y: footTop + footLabelH + footGap, w: cellW, h: footValueH }, footValues[i], footValuePx, { bold: true, align: \"center\" });\n633:   }\n634:   tiles.push({ label: \"rule-foot\", rect: { x: m, y: Math.max(rowsEnd, footTop - gap) + Math.max(0, Math.round((Math.min(gap, footTop - rowsEnd) - 2) / 2)), w: CW, h: 2 }, color: railColor, radius: 0, layer: 1 });\n635: \n636:   return {\n637:     p, theme, cells, tiles, bands, m, floor, small, heroPx: hd.heroPx, rowPx, barH,\n638:     tape: cTape, rowH, rowsTop: bodyTop, rowsEnd, footTop, headerBottom, bodyTop, bodyBottom, footerTop,\n639:   };\n640: }\n641: \n642: const WHY: WhySpec = {\n643:   \"day\": 35,\n644:   \"date\": \"2026-10-24\",\n645:   \"agent\": \"opencode\",\n646:   \"model\": \"deepseek-v4-pro\",\n647:   \"id\": ID,\n648:   \"title\": TITLE,\n649:   \"who\": \"Orienteers who post and analyze their control split times after every race, on Attackpoint and club/WinSplits result pages\",\n650:   \"problem\": [\n651:     \"WinSplits already computes the answer everyone asks after a race - \\\"where did I lose time?\\\" - as a per-leg time loss with mistake legs pink: \\\"Some split times have pink background colour... a mistake has probably been made.\\\"\",\n652:     \"But that analysis lives in a results-table web page nobody can post. Orienteers upload raw splits to Attackpoint and hand-make the graphical split-time analysis World of O News draws for every championship, because the shareable card does not exist.\",\n653:     \"Every club worldwide runs events weekly, so the moment recurs weekly: one racer, one finish time, and a row of control splits that say where the minutes went.\",\n654:   ],\n655:   \"sources\": [\n656:     \"https://attackpoint.org/\",\n657:     \"http://obasen.orientering.se/winsplits/online/en/help_table.asp?databaseId=101857&categoryId=0\",\n658:     \"https://orienteering.sport/iof/it/data-standard-3-0\",\n659:     \"https://news.worldofo.com/2026/07/11/woc-2026-knock-out-sprint-maps-and-results\",\n660:     \"https://orienteeringusa.org/2026/04/junior-nationals-and-flying-pig-xxviii-event-recap/\"\n661:   ],\n662:   \"solution\": [\n663:     \"One deterministic still of one racer's IOF XML 3.0 result row. The finish time is the hero with the course and place beside it; each leg is a tape whose length is the split over the slowest leg, and any leg with time loss is pink in bar and signed loss text.\",\n664:     \"The one design decision: time loss is a prop, never re-derived. WinSplits computes it class-relative, so the card takes it per leg and only sums it (TOTAL LOSS), subtracts it from the finish (TIME W/O MISTAKES) and takes the min split (BEST LEG).\",\n665:     \"Bar length = split, pink = mistake, so the \\\"where did I lose time?\\\" answer reads from the picture without a legend. Emma Lindqvist and her club are invented; the field names mirror the IOF schema (control, split, loss).\",\n666:   ],\n667:   \"usage\": {\n668:     \"command\": \"m0saic make @one-a-day/sports/orienteering-split-analysis/v1 --template-repo . -w 1280 -h 720 -o journal/2026-10-24/split-analysis.png\",\n669:     \"try\": [\n670:       \"preset light, accent #2f6f62: a light page, the mistakes in the new colour\",\n671:       \"place 0: the chip goes; the finish stays the largest figure\",\n672:       \"a mistake on the last leg: the F row turns pink and the loss reads +0:47\",\n673:       \"4 legs for a sprint, 18 for a long course: the tape re-scales, the bands hold\",\n674:     ],\n675:   },\n676:   \"caveats\": [\n677:     \"Time loss is not re-derived: feed the WinSplits per-leg number, or the card sums zeros and every bar reads neutral.\",\n678:     \"Bar length is the split over the slowest leg, not an absolute scale, so it shows relative leg effort and not leg length in minutes.\",\n679:     \"The finish is printed as entered and not checked against the split sum; a finish shorter than the total loss fails fast rather than print a negative time-without-mistakes.\",\n680:   ],\n681:   \"timeline\": {\n682:     \"source\": \"runner\",\n683:     \"phases\": [\n684:       {\n685:         \"name\": \"scout\",\n686:         \"startMs\": 0,\n687:         \"durMs\": 2168,\n688:         \"status\": \"error\"\n689:       },\n690:       {\n691:         \"name\": \"scout (2)\",\n692:         \"startMs\": 2185,\n693:         \"durMs\": 1688,\n694:         \"status\": \"error\"\n695:       },\n696:       {\n697:         \"name\": \"scout (3)\",\n698:         \"startMs\": 8454353,\n699:         \"durMs\": 132981,\n700:         \"calls\": 20,\n701:         \"tokens\": 593418,\n702:         \"costUsd\": 0.07,\n703:         \"tools\": \"websearch 7, bash 5, read 5\"\n704:       },\n705:       {\n706:         \"name\": \"plan\",\n707:         \"startMs\": 8587355,\n708:         \"durMs\": 133083,\n709:         \"calls\": 16,\n710:         \"tokens\": 524097,\n711:         \"costUsd\": 0.08,\n712:         \"tools\": \"read 8, bash 7, write 1\"\n713:       }\n714:     ],\n715:     \"costBasis\": \"reported\"\n716:   }\n717: };\n718: \n719: export const OrienteeringSplitAnalysisV1 = defineMosaicTemplate<OrienteeringSplitAnalysisProps>({\n720:   id: asTemplateId(ID),\n721:   label: \"2026-10-24 · Orienteering Split Analysis\",\n722:   version: 1,\n723:   description:\n724:     \"An orienteering race split-analysis card from one IOF XML 3.0 result row: control-by-control splits as a tape whose length is the leg, mistake legs pink with their time loss signed, finish time as the hero, and time-without-mistakes, total loss and best leg computed from the entered numbers.\",\n725:   capabilities: { tier: \"core\" },\n726:   tags: [\"sports\", \"2026-10-24\", \"day-035\", \"orienteering\", \"splits\", \"time-loss\", \"iof-xml\", \"attackpoint\", \"race-analysis\"],\n727: \n728:   outputHints: {\n729:     width: 1280,\n730:     height: 720,\n731:     fps: 30,\n732:     durationMs: 2000,\n733:     format: { kind: \"image\", container: \"png\" },\n734:     note: \"Static PNG. The finish is the hero at every aspect; the leg tape re-scales with the course length. Minimum tested canvas 480x270.\",\n735:   },\n736: \n737:   propsSchema,\n738:   defaultProps: DEFAULTS,\n739:   render,\n740:   renderTutorial: whyTutorial(WHY, render),\n741: });\n742: \n743: export default OrienteeringSplitAnalysisV1;\n744: \n745: async function render(props: OrienteeringSplitAnalysisProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n746:   const { width: W, height: H } = ctx.target;\n747:   const L = layoutSplitCard(props, W, H);\n748:   const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n749:   const constraints: LayoutConstraint[] = [];\n750:   const relations: RelationalConstraint[] = [];\n751: \n752:   for (const t of [...L.tiles].sort((a, b) => a.layer - b.layer)) {\n753:     const tile = tag({ ...makeColorTile(t.color, t.radius > 0 ? { effects: { rounding: { cornerStyle: \"pill\" } } } : {}) } as MosaicSource, t.label);\n754:     pieces.push({ rect: { ...t.rect, importance: t.layer }, source: t.accent ? bindProp(tile, \"accent\") : tile });\n755:   }\n756:   for (const c of L.cells) {\n757:     const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n758:     const source = c.bind === null\n759:       ? cell\n760:       : c.bind.kind === \"prop\"\n761:         ? bindProp(cell, c.bind.key)\n762:         : bindPropPath(cell, \"splits\", c.bind.path, c.bind.valueKind);\n763:     pieces.push({ rect: { ...c.rect, importance: c.over ? 6 : 5 }, source });\n764:     constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n765:   }\n766: \n767:   const has = (label: string) => L.cells.some((c) => c.label === label);\n768:   for (const label of [\"name\", \"club\", \"class\", \"course\", \"finish\", \"finish-label\", \"place\", \"place-label\", \"behind\"]) {\n769:     if (has(label)) constraints.push({ label, within: { yFrac: [0, 0.26] } });\n770:   }\n771:   if (L.tiles.some((t) => t.label === \"place-chip\")) {\n772:     constraints.push({ label: \"place-chip\", within: { yFrac: [0, 0.26] } });\n773:     constraints.push({ label: \"place-chip\" });\n774:   }\n775: \n776:   for (let i = 0; i < L.p.legs.length; i++) {\n777:     const band = L.bands[i];\n778:     const y0 = Math.max(0, band.y / H - 1 / H);\n779:     const y1 = Math.min(1, (band.y + band.h) / H + 1 / H);\n780:     constraints.push({ label: `band-${i}`, within: { yFrac: [0.26, 0.8] } });\n781:     constraints.push({ label: `rail-${i}`, minWidthFrac: 0.32, within: { yFrac: [y0, y1] } });\n782:     constraints.push({ label: `bar-${i}`, within: { yFrac: [y0, y1] } });\n783:     if (L.tiles.some((t) => t.label === `mistake-rule-${i}`)) constraints.push({ label: `mistake-rule-${i}`, within: { yFrac: [y0, y1] } });\n784:     for (const label of [`ctrl-${i}`, `split-${i}`]) {\n785:       constraints.push({ label, within: { yFrac: [0.26, 0.8] } });\n786:     }\n787:     if (has(`loss-${i}`)) constraints.push({ label: `loss-${i}`, within: { yFrac: [0.26, 0.8] } });\n788:   }\n789:   relations.push({ label: L.p.legs.map((_, i) => `band-${i}`), equal: \"size\", tolerancePx: 2 });\n790: \n791:   for (let i = 0; i < 3; i++) {\n792:     constraints.push({ label: `foot-${i}`, within: { yFrac: [0.8, 1] } });\n793:     constraints.push({ label: `foot-label-${i}`, within: { yFrac: [0.8, 1] } });\n794:   }\n795:   for (const label of [\"time-wo\", \"total-loss\", \"best-leg\"]) constraints.push({ label, within: { yFrac: [0.8, 1] } });\n796:   relations.push({ label: [\"foot-0\", \"foot-1\", \"foot-2\"], equal: \"size\", tolerancePx: 2 });\n797: \n798:   const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n799:   const doc: MosaicDocument = {\n800:     kind: \"mosaic_document\",\n801:     version: 1,\n802:     m0: toM0String(placed.m0, ID),\n803:     assets: {},\n804:     backgroundColor: L.theme.bg as MosaicColor,\n805:     sources: placed.sources,\n806:   };\n807:   return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: props.debugLayout === true });\n808: }\n\n(End of file - total 808 lines)\n</content>","metadata":{"preview":"import type {\n  MosaicColor,\n  MosaicDocument,\n  MosaicEngineContext,\n  MosaicSource,\n} from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport {\n  bindProp,\n  bindPropPath,\n  defineMosaicTemplate,\n  definePropsSchema,\n  makeColorTile,\n  placeInsetPieces,\n  tag,\n} from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-24\\variants\\b\\src\\orienteering-split-analysis.ts","text":"import type {\n  MosaicColor,\n  MosaicDocument,\n  MosaicEngineContext,\n  MosaicSource,\n} from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport {\n  bindProp,\n  bindPropPath,\n  defineMosaicTemplate,\n  definePropsSchema,\n  makeColorTile,\n  placeInsetPieces,\n  tag,\n} from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/sports/orienteering-split-analysis/v1` - one racer's IOF XML 3.0\n * result row as a shareable split-analysis card: finish time as the hero, the\n * course and the place, then control-by-control legs as a tape whose length is\n * the split, and a footer that answers the one question everyone asks -\n * \"where did I lose time?\" - as TIME W/O MISTAKES, TOTAL LOSS and BEST LEG.\n *\n * ONE CONCEPT: the mistake is the picture. A leg's bar length is its split\n * over the slowest leg, so the eye reads the race; a leg with time loss\n * (`loss > 0`, the WinSplits per-leg number) is drawn in the accent - pink\n * bar, signed pink loss - and a clean leg is neutral with an empty loss cell.\n * No legend: pink = mistake, bar length = split.\n *\n * The rule that bites: time loss is NOT re-derived. WinSplits computes it\n * class-relative from the whole field, so it comes in as a prop per leg; the\n * card only sums the entered losses (TOTAL LOSS), subtracts them from the\n * entered finish (TIME W/O MISTAKES) and takes the min split (BEST LEG) - and\n * it never checks the finish against the split sum. A decimal time, an\n * h:mm:ss loss, a leg count outside 4-18, or a leg that will not fit the\n * canvas fails fast with a named field.\n */\n\nexport type OrienteeringLeg = { control: string; split: string; loss: string };\n\nexport type OrienteeringSplitAnalysisProps = {\n  /** The racer, the header's bold line. Up to 40 ASCII; \"\" hides it. */\n  name?: string;\n  /** The club, first half of the second line. Up to 40 ASCII; \"\" hides it. */\n  club?: string;\n  /** The class, joined after the club with \" · \". Up to 20 ASCII. */\n  className?: string;\n  /** The course, the third header line. Up to 48 ASCII; \"\" hides it. */\n  course?: string;\n  /** The finish time, the hero figure. \"m:ss\" or \"h:mm:ss\", whole seconds. */\n  finish?: string;\n  /** The place, drawn as the accent \"#12\" chip. 0 hides the chip. */\n  place?: number;\n  /** Time behind the winner, printed as entered. Up to 16 ASCII; \"\" hides it. */\n  behind?: string;\n  /** The legs in course order, 4-18, each { control, split, loss }. */\n  splits?: OrienteeringLeg[] | string;\n  /** The mistake-leg pink - bars, loss text, place chip - as #rrggbb. */\n  accent?: string;\n  /** Page and ink: \"dark\" share card or \"light\" print. */\n  preset?: \"dark\" | \"light\";\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/sports/orienteering-split-analysis/v1\";\nconst TITLE = \"Orienteering Split Analysis\";\nconst DEFAULT_ACCENT = \"#d94f8c\";\nconst ASCII = /^[\\x20-\\x7e]*$/;\nconst HEX = /^#[0-9a-fA-F]{6}$/;\n\nconst THEMES = {\n  dark: { bg: \"#14111d\", ink: \"#efe9f2\", dim: \"#9b92a4\" },\n  light: { bg: \"#f6f2ef\", ink: \"#241d28\", dim: \"#6f6574\" },\n} as const;\n\n/** A 12-control middle course: 13 legs in course order, the last the finish. */\nexport const DEFAULT_LEGS: OrienteeringLeg[] = [\n  { control: \"1\", split: \"4:08\", loss: \"0:47\" },\n  { control: \"2\", split: \"2:41\", loss: \"0:00\" },\n  { control: \"3\", split: \"3:15\", loss: \"0:00\" },\n  { control: \"4\", split: \"2:58\", loss: \"0:00\" },\n  { control: \"5\", split: \"5:22\", loss: \"1:20\" },\n  { control: \"6\", split: \"3:40\", loss: \"0:00\" },\n  { control: \"7\", split: \"1:32\", loss: \"0:00\" },\n  { control: \"8\", split: \"4:05\", loss: \"0:00\" },\n  { control: \"9\", split: \"3:51\", loss: \"0:51\" },\n  { control: \"10\", split: \"2:44\", loss: \"0:00\" },\n  { control: \"11\", split: \"3:33\", loss: \"0:00\" },\n  { control: \"12\", split: \"4:11\", loss: \"0:00\" },\n  { control: \"F\", split: \"1:55\", loss: \"0:00\" },\n];\n\nconst DEFAULTS = {\n  name: \"Emma Lindqvist\",\n  club: \"OK Klyftamo\",\n  className: \"W21E\",\n  course: \"Middle, 4.2 km\",\n  finish: \"45:02\",\n  place: 12,\n  behind: \"+1:23\",\n  splits: DEFAULT_LEGS,\n  accent: DEFAULT_ACCENT,\n  preset: \"dark\" as \"dark\" | \"light\",\n  debugLayout: false,\n};\n\nconst propsSchema = definePropsSchema<OrienteeringSplitAnalysisProps>({\n  name: {\n    type: \"string\",\n    required: false,\n    description: \"The racer, the header's bold line. Up to 40 ASCII characters; empty hides the line. The sample is invented.\",\n    meta: { control: { placeholder: DEFAULTS.name }, ui: { label: \"Name\", order: 1, primary: true } },\n  },\n  club: {\n    type: \"string\",\n    required: false,\n    description: 'The club, first half of the second header line. Up to 40 ASCII; empty hides it. Joined to the class with \" · \".',\n    meta: { control: { placeholder: DEFAULTS.club }, ui: { label: \"Club\", order: 2 } },\n  },\n  className: {\n    type: \"string\",\n    required: false,\n    description: 'The class, joined after the club with \" · \". Up to 20 ASCII; empty shows the club alone.',\n    meta: { control: { placeholder: DEFAULTS.className }, ui: { label: \"Class\", order: 3 } },\n  },\n  course: {\n    type: \"string\",\n    required: false,\n    description: \"The course, the third header line, e.g. \\\"Middle, 4.2 km\\\". Up to 48 ASCII; empty hides it.\",\n    meta: { control: { placeholder: DEFAULTS.course }, ui: { label: \"Course\", order: 4 } },\n  },\n  finish: {\n    type: \"string\",\n    required: false,\n    description: 'The finish time, the hero figure. \"m:ss\" (minutes may pass 59, so \"71:40\" is legal) or \"h:mm:ss\", whole seconds. A decimal fails fast.',\n    meta: { control: { placeholder: DEFAULTS.finish }, ui: { label: \"Finish\", order: 5, primary: true } },\n  },\n  place: {\n    type: \"number\",\n    required: false,\n    description: \"The place, drawn as the accent chip #12. Whole number 0-9999; 0 hides the chip.\",\n    meta: { constraints: { min: 0, max: 9999 }, control: { placeholder: String(DEFAULTS.place) }, ui: { label: \"Place\", order: 6 } },\n  },\n  behind: {\n    type: \"string\",\n    required: false,\n    description: 'Time behind the winner, printed as entered, e.g. \"+1:23\". Up to 16 ASCII; empty hides it.',\n    meta: { control: { placeholder: DEFAULTS.behind }, ui: { label: \"Behind\", order: 7 } },\n  },\n  splits: {\n    type: \"json\",\n    required: false,\n    description:\n      'The legs in course order, 4-18. Each object is { control, split, loss } - the IOF field names. control is the code, split is \"m:ss\" or \"h:mm:ss\" (whole seconds), loss is the WinSplits per-leg time loss as \"m:ss\" (\"0:00\" = clean, anything more = a mistake leg drawn pink). Example: [{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}].',\n    meta: {\n      constraints: {\n        jsonSchema: {\n          type: \"array\",\n          minItems: 4,\n          maxItems: 18,\n          items: {\n            type: \"object\",\n            required: [\"control\", \"split\", \"loss\"],\n            properties: {\n              control: { type: \"string\", minLength: 1, maxLength: 8 },\n              split: { type: \"string\" },\n              loss: { type: \"string\" },\n            },\n          },\n        },\n      },\n      control: { mono: true, placeholder: '[{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}]' },\n      ui: { label: \"Splits\", order: 8, primary: true },\n    },\n  },\n  accent: {\n    type: \"string\",\n    required: false,\n    description: \"The mistake-leg pink - bars, loss text and the place chip - as #rrggbb.\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 9 } },\n  },\n  preset: {\n    type: \"string\",\n    required: false,\n    description: 'Page and ink: \"dark\" (default) or \"light\".',\n    meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 10 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits its box, header/body/footer hold their bands, rows equal, tape at least 32% wide) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\nfunction fail(field: string, rule: string): never {\n  throw new Error(`${ID}: ${field} ${rule}`);\n}\n\n/**\n * \"m:ss\" or \"h:mm:ss\" to whole seconds. Minutes may pass 59 in the one-colon\n * form. Seconds (and minutes in the two-colon form) are 0-59. A decimal is\n * refused, not rounded. null when the string is not that grammar.\n */\nexport function parseSplitTime(text: string): number | null {\n  const s = text.trim();\n  if (s.length === 0 || /[.]/.test(s)) return null;\n  const hms = /^(\\d+):([0-5]\\d):([0-5]\\d)$/.exec(s);\n  if (hms) return Number(hms[1]) * 3600 + Number(hms[2]) * 60 + Number(hms[3]);\n  const ms = /^(\\d+):([0-5]\\d)$/.exec(s);\n  if (ms) return Number(ms[1]) * 60 + Number(ms[2]);\n  return null;\n}\n\n/** Compact, no leading zeros. Hours only when the value is at least one hour. */\nexport function formatSplitTime(sec: number): string {\n  const h = Math.floor(sec / 3600);\n  const m = Math.floor((sec % 3600) / 60);\n  const ss = String(sec % 60).padStart(2, \"0\");\n  if (h >= 1) return `${h}:${String(m).padStart(2, \"0\")}:${ss}`;\n  return `${m}:${ss}`;\n}\n\nfunction text(value: unknown, field: string, max: number): string {\n  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n  if (!ASCII.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII.`);\n  const s = value.trim();\n  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n  return s;\n}\n\n/** m:ss or h:mm:ss, whole seconds, at least one second, at most 99:59:59. */\nfunction timeField(value: unknown, field: string): { sec: number; printed: string } {\n  if (typeof value !== \"string\") fail(field, 'must be a string, \"m:ss\" or \"h:mm:ss\".');\n  const sec = parseSplitTime(value);\n  if (sec === null) fail(field, `${JSON.stringify(value)} is not a time: write m:ss or h:mm:ss, whole seconds, no decimal (e.g. \"4:08\" or \"1:11:40\").`);\n  if (sec < 1) fail(field, `${JSON.stringify(value)} must be at least one second.`);\n  if (sec > 359999) fail(field, `${JSON.stringify(value)} is longer than 99:59:59; the card cannot fit it.`);\n  return { sec, printed: formatSplitTime(sec) };\n}\n\n/** The WinSplits per-leg loss: m:ss only (never hours), zero allowed (clean). */\nfunction lossField(value: unknown, field: string): { sec: number; printed: string } {\n  if (typeof value !== \"string\") fail(field, 'must be a string, \"m:ss\".');\n  const t = value.trim();\n  if (!/^\\d+:[0-5]\\d$/.test(t)) fail(field, `${JSON.stringify(value)} is not m:ss: write m:ss, whole seconds (e.g. \"0:47\"); a loss is a per-leg time, never hours.`);\n  const sec = parseSplitTime(t)!;\n  if (sec > 359999) fail(field, `${JSON.stringify(value)} is longer than 99:59:59.`);\n  return { sec, printed: formatSplitTime(sec) };\n}\n\nexport type Leg = {\n  index: number;\n  control: string;\n  split: string;\n  splitSec: number;\n  loss: string;\n  lossSec: number;\n  isMistake: boolean;\n};\n\nexport type NormalizedSplitCard = {\n  name: string;\n  club: string;\n  className: string;\n  course: string;\n  clubLine: string;\n  finish: string;\n  finishSec: number;\n  place: number;\n  placeText: string;\n  behind: string;\n  legs: Leg[];\n  slowestSec: number;\n  bestSec: number;\n  totalLossSec: number;\n  totalLossText: string;\n  timeWoText: string;\n  bestText: string;\n  accent: MosaicColor;\n  preset: \"dark\" | \"light\";\n  debugLayout: boolean;\n};\n\n/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\nexport function normalizeSplitCard(props: OrienteeringSplitAnalysisProps): NormalizedSplitCard {\n  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n  const name = text(p.name, \"name\", 40);\n  const club = text(p.club, \"club\", 40);\n  const className = text(p.className, \"className\", 20);\n  const course = text(p.course, \"course\", 48);\n  const behind = text(p.behind, \"behind\", 16);\n  if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n  if (typeof p.accent !== \"string\" || !HEX.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n  const finish = timeField(p.finish, \"finish\");\n  if (typeof p.place !== \"number\" || !Number.isFinite(p.place)) fail(\"place\", \"must be a number.\");\n  if (!Number.isInteger(p.place)) fail(\"place\", \"must be a whole number.\");\n  if (p.place < 0 || p.place > 9999) fail(\"place\", `${p.place} is outside 0-9999; 0 hides the chip.`);\n\n  let splits = p.splits;\n  if (typeof splits === \"string\") {\n    try {\n      splits = JSON.parse(splits);\n    } catch {\n      fail(\"splits\", `is not valid JSON: ${JSON.stringify(splits.slice(0, 60))}. Pass a list of {control, split, loss}.`);\n    }\n  }\n  if (!Array.isArray(splits)) fail(\"splits\", 'must be a list of legs, e.g. [{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}].');\n  if (splits.length < 4 || splits.length > 18) fail(\"splits\", `has ${splits.length} legs; a course is 4 to 18 legs (the finish leg counts).`);\n  const legs: Leg[] = splits.map((raw, i) => {\n    if (raw === null || typeof raw !== \"object\" || Array.isArray(raw)) fail(`splits[${i}]`, \"must be an object with control, split and loss.\");\n    const o = raw as OrienteeringLeg;\n    const control = text(o.control, `splits[${i}].control`, 8);\n    if (control === \"\") fail(`splits[${i}].control`, \"is empty; give the control code.\");\n    const split = timeField(o.split, `splits[${i}].split`);\n    const loss = lossField(o.loss, `splits[${i}].loss`);\n    return { index: i, control, split: split.printed, splitSec: split.sec, loss: loss.printed, lossSec: loss.sec, isMistake: loss.sec > 0 };\n  });\n\n  const slowestSec = Math.max(...legs.map((l) => l.splitSec));\n  const bestSec = Math.min(...legs.map((l) => l.splitSec));\n  const totalLossSec = legs.reduce((a, l) => a + l.lossSec, 0);\n  if (totalLossSec > finish.sec) {\n    fail(\"splits\", `the per-leg losses sum to ${formatSplitTime(totalLossSec)}, more than the finish ${finish.printed}; time-without-mistakes would be negative.`);\n  }\n  const clubLine = [club, className].filter((s) => s !== \"\").join(\" \\u00b7 \");\n  return {\n    name, club, className, course, clubLine,\n    finish: finish.printed, finishSec: finish.sec,\n    place: p.place, placeText: p.place > 0 ? `#${p.place}` : \"\",\n    behind,\n    legs, slowestSec, bestSec, totalLossSec,\n    totalLossText: totalLossSec > 0 ? `+${formatSplitTime(totalLossSec)}` : \"0:00\",\n    timeWoText: formatSplitTime(finish.sec - totalLossSec),\n    bestText: formatSplitTime(bestSec),\n    accent: p.accent.trim().toLowerCase() as MosaicColor,\n    preset: p.preset, debugLayout: p.debugLayout,\n  };\n}\n\nfunction mix(a: string, b: string, t: number): MosaicColor {\n  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n}\nfunction luminance(hex: string): number {\n  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n}\nfunction onColor(fill: string): MosaicColor {\n  const ratio = (other: string) => { const a = luminance(fill), b = luminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n  return (ratio(\"#14111d\") >= ratio(\"#ffffff\") ? \"#14111d\" : \"#ffffff\") as MosaicColor;\n}\n\nexport type SplitRect = { x: number; y: number; w: number; h: number };\ntype Bind =\n  | { kind: \"prop\"; key: string }\n  | { kind: \"path\"; path: (string | number)[]; valueKind: \"string\" | \"number\" }\n  | null;\ntype Cell = { label: string; rect: SplitRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\ntype Tile = { label: string; rect: SplitRect; color: MosaicColor; radius: number; layer: number; accent?: boolean };\n\nfunction fitPx(line: string, cellW: number, maxPx: number, bold = false): number {\n  const top = Math.max(1, Math.round(maxPx));\n  const room = budget(cellW);\n  const w = widthOf(line, top, bold);\n  let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n  while (px > 1 && widthOf(line, px, bold) > room) px--;\n  return px;\n}\n\n/** The whole card as rects and measured fits - pure in (props, canvas). */\nexport function layoutSplitCard(props: OrienteeringSplitAnalysisProps, W: number, H: number) {\n  const p = normalizeSplitCard(props);\n  const theme = THEMES[p.preset];\n  const ink = theme.ink as MosaicColor;\n  const dim = theme.dim as MosaicColor;\n  const S = Math.min(H, 0.75 * W);\n  const m = Math.max(8, Math.round(S * 0.04));\n  const CW = W - 2 * m;\n  const floor = Math.max(6, Math.round(Math.min(W, H) * 0.012));\n  cons[12:20:48] critique-1 🔧 read: C:\src\m0saic-production\one-a-day\journal\2026-10-24\variants\b\src\orienteering-split-analysis.ts
