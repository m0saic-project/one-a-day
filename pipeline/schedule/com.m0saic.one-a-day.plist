<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.m0saic.one-a-day</string>
  <!-- caffeinate keeps the laptop awake for the run; the lid must be open or on AC with an external display. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-is</string>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/src/one-a-day" &amp;&amp; node pipeline/run.mjs &gt;&gt; "$HOME/one-a-day-logs/$(date +%F).console.log" 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <!-- Fill these in (or export them from ~/.zshenv, which -l loads): -->
    <key>ONE_A_DAY_AGENT</key><string>random</string>
    <key>M0SAIC_TELEMETRY</key><string>ghost</string>
    <key>M0SAIC_NO_UPDATE_CHECK</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/one-a-day.launchd.out</string>
  <key>StandardErrorPath</key><string>/tmp/one-a-day.launchd.err</string>
</dict>
</plist>
