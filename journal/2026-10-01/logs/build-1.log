{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QAsShWGWwXAQMjqLDucfJb","type":"tool_result","content":"288\t  const compared = lines.filter((l) => l.dropCs !== null).length;\n289\t  const totalCs = faster.reduce((sum, l) => sum + num(l), 0);\n290\t  const countText = compared === 0 ? \"No times to compare\" : `${faster.length} of ${compared} ${compared === 1 ? \"swim\" : \"swims\"} faster`;\n291\t  // Slower swims are not netted against the total: each is printed on its own row.\n292\t  const totalText = faster.length === 0 ? \"\" : totalCs < 6000 ? `${formatSwimTime(totalCs)} s dropped` : `${formatSwimTime(totalCs)} dropped`;\n293\t  const scaleText = longest === null ? \"\"\n294\t    : bar === \"percent\" ? formatSwimShare(num(longest), longest.entryCs as number)\n295\t    : num(longest) < 6000 ? `${formatSwimTime(num(longest))} s` : formatSwimTime(num(longest));\n296\t  const footnote = compared === 0 ? \"vs entry time. A first swim or a DQ has no drop to show.\"\n297\t    : longest === null ? \"vs entry time. No swim was faster, so no bar is drawn.\"\n298\t    : bar === \"percent\" ? `vs entry time. Bars: share of the entry time dropped; the longest is ${scaleText}.`\n299\t    : `vs entry time. Bars: seconds dropped; the longest is ${scaleText}.`;\n300\t\n301\t  return {\n302\t    swimmer, club, meet, details, course: p.course as SwimCourse, bar, preset: p.preset as \"dark\" | \"light\",\n303\t    accent: p.accent.trim().toLowerCase() as MosaicColor, debugLayout: p.debugLayout,\n304\t    lines, faster: faster.length, compared, totalCs, countText, totalText, scaleText, footnote,\n305\t  };\n306\t}\n307\t\n308\t/* ── colour ── */\n309\t\n310\t// Not exported: the pack index is `export *`, and dev/bench-delta already exports a `mix`.\n311\tfunction mix(a: string, b: string, t: number): MosaicColor {\n312\t  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n313\t  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n314\t  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n315\t}\n316\tfunction luminance(hex: string): number {\n317\t  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n318\t  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n319\t}\n320\t/** The readable ink over a filled chip: dark or white, whichever contrasts more with the caller's accent. */\n321\tfunction onColor(fill: string): MosaicColor {\n322\t  const ratio = (other: string) => { const a = luminance(fill), b = luminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n323\t  return (ratio(\"#0b1220\") >= ratio(\"#ffffff\") ? \"#0b1220\" : \"#ffffff\") as MosaicColor;\n324\t}\n325\t\n326\t/* ── geometry ── */\n327\t\n328\texport type SwimRect = { x: number; y: number; w: number; h: number };\n329\ttype Bind = { prop: \"swimmer\" | \"club\" | \"meet\" | \"details\" } | { row: number; field: \"event\" | \"entry\" | \"final\" | \"standard\" } | null;\n330\ttype Cell = { label: string; rect: SwimRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\n331\ttype Tile = { label: string; rect: SwimRect; color: MosaicColor; radius: number; layer: number; accent?: boolean };\n332\t\n333\t/** The largest whole size up to `maxPx` at which one line fits the cell's budget (`cell * 0.94 - 2px`). */\n334\tfunction fitPx(line: string, cellW: number, maxPx: number, bold: boolean): number {\n335\t  const top = Math.max(1, Math.round(maxPx));\n336\t  const room = budget(cellW), w = widthOf(line, top, bold);\n337\t  let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n338\t  while (px > 1 && widthOf(line, px, bold) > room) px--;\n339\t  return px;\n340\t}\n341\t\n342\t/** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\n343\texport function layoutSwimCard(props: SwimTimeDropCardProps, W: number, H: number) {\n344\t  const p = normalizeSwimCard(props);\n345\t  const theme = THEMES[p.preset];\n346\t  const ink = theme.ink as MosaicColor, dim = theme.dim as MosaicColor;\n347\t  const S = Math.min(W, H);\n348\t  // Wide canvases put the bar in a column; square and portrait need the width\n349\t  // for the text cells, so the bar becomes a strip under the row's text line.\n350\t  const wide = W * 3 >= H * 4;\n351\t  const k = wide ? 1 : Math.max(1, Math.min(1.25, H / W));\n352\t  const m = Math.round(S * 0.055), CW = W - 2 * m;\n353\t  const gap = Math.round(S * 0.022);\n354\t  const rule = Math.max(1, Math.round(S * 0.0025));\n355\t  const floor = Math.max(6, Math.round(S * 0.022));\n356\t  const cells: Cell[] = [];\n357\t  const tiles: Tile[] = [];\n358\t  const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n359\t  /** One fitted line in `rect`; refuses below the floor instead of clipping. */\n360\t  const line = (label: string, rect: SwimRect, value: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string; floor?: number } = {}) => {\n361\t    if (px < (o.floor ?? floor)) unfit(o.field ?? label);\n362\t    cells.push({ label, rect, text: value, px, width: widthOf(value, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? ink, bind: o.bind ?? null, over: o.over === true });\n363\t  };\n364\t\n365\t  // ── header: the name is the largest text; the course chip sits top right ──\n366\t  const right = p.meet !== \"\" || p.details !== \"\";\n367\t  let headerBottom: number;\n368\t  if (wide) {\n369\t    const hH = Math.round((H - 2 * m) * 0.21);\n370\t    const chipH = Math.round(hH * 0.3), chipW = Math.round(chipH * 2.3);\n371\t    const leftW = right ? Math.round(CW * 0.56) : CW - chipW - gap;\n372\t    const rightX = m + leftW + gap, rightW = CW - leftW - gap;\n373\t    const nameH = Math.round(hH * 0.62), subY = m + Math.round(hH * 0.68), subH = m + hH - subY;\n374\t    const midY = m + Math.round(hH * 0.36), midH = subY - midY;\n375\t    line(\"swimmer\", { x: m, y: m, w: leftW, h: nameH }, p.swimmer, fitPx(p.swimmer, leftW, nameH * 0.74, true), { bold: true, bind: { prop: \"swimmer\" } });\n376\t    const subPx = Math.min(...[[p.club, leftW], [p.meet, rightW], [p.details, rightW]].map(([t, w]) => (t === \"\" ? Infinity : fitPx(t as string, w as number, subH * 0.6, false))), Math.round(subH * 0.6));\n377\t    if (p.club !== \"\") line(\"club\", { x: m, y: subY, w: leftW, h: subH }, p.club, subPx, { color: dim, bind: { prop: \"club\" } });\n378\t    if (p.meet !== \"\") line(\"meet\", { x: rightX, y: midY, w: rightW, h: midH }, p.meet, subPx, { color: dim, align: \"right\", bind: { prop: \"meet\" } });\n379\t    if (p.details !== \"\") line(\"details\", { x: rightX, y: subY, w: rightW, h: subH }, p.details, subPx, { color: dim, align: \"right\", bind: { prop: \"details\" } });\n380\t    tiles.push({ label: \"course-chip\", rect: { x: W - m - chipW, y: m, w: chipW, h: chipH }, color: p.accent, radius: 0.5, layer: 1, accent: true });\n381\t    headerBottom = m + hH;\n382\t  } else {\n383\t    const nameH = Math.round(S * 0.085 * k), lineH = Math.round(S * 0.044 * k);\n384\t    const chipH = Math.round(nameH * 0.56), chipW = Math.round(chipH * 2.3);\n385\t    const nameW = CW - chipW - gap;\n386\t    line(\"swimmer\", { x: m, y: m, w: nameW, h: nameH }, p.swimmer, fitPx(p.swimmer, nameW, nameH * 0.74, true), { bold: true, bind: { prop: \"swimmer\" } });\n387\t    tiles.push({ label: \"course-chip\", rect: { x: W - m - chipW, y: m + Math.round((nameH - chipH) / 2), w: chipW, h: chipH }, color: p.accent, radius: 0.5, layer: 1, accent: true });\n388\t    // The club on its own line; the meet and the details share the next one.\n389\t    const meetW = p.details === \"\" ? CW : Math.round(CW * 0.62), detailsW = p.meet === \"\" ? CW : CW - meetW - gap;\n390\t    const subPx = Math.min(...[[p.club, CW], [p.meet, meetW], [p.details, detailsW]].map(([t, w]) => (t === \"\" ? Infinity : fitPx(t as string, w as number, lineH * 0.62, false))), Math.round(lineH * 0.62));\n391\t    let y = m + nameH;\n392\t    if (p.club !== \"\") { line(\"club\", { x: m, y, w: CW, h: lineH }, p.club, subPx, { color: dim, bind: { prop: \"club\" } }); y += lineH; }\n393\t    if (p.meet !== \"\") line(\"meet\", { x: m, y, w: meetW, h: lineH }, p.meet, subPx, { color: dim, bind: { prop: \"meet\" } });\n394\t    if (p.details !== \"\") line(\"details\", { x: W - m - detailsW, y, w: detailsW, h: lineH }, p.details, subPx, { color: dim, align: p.meet === \"\" ? \"left\" : \"right\", bind: { prop: \"details\" } });\n395\t    if (right) y += lineH;\n396\t    headerBottom = y;\n397\t  }\n398\t  const courseChip = tiles[0].rect;\n399\t  line(\"course\", courseChip, p.course, fitPx(p.course, courseChip.w, courseChip.h * 0.5, true), { bold: true, align: \"center\", color: onColor(p.accent), over: true, floor: Math.max(5, floor - 2) });\n400\t\n401\t  // ── summary band, built from the bottom up: count and total, then the footnote that carries the honesty ──\n402\t  const footTop = Math.round(S * 0.025 * k);\n403\t  const oneLine = fitPx(p.footnote, CW, footTop, false);\n404\t  let footPx = oneLine, footLines = [p.footnote];\n405\t  if (oneLine < footTop * 0.9) {\n406\t    // Two lines at the target size beat one shrunken line; shrink only when two do not hold it.\n407\t    footPx = footTop;\n408\t    footLines = wrapMeasured(p.footnote, footPx, budget(CW));\n409\t    while (footLines.length > 2 && footPx > 1) { footPx--; footLines = wrapMeasured(p.footnote, footPx, budget(CW)); }\n410\t  }\n411\t  if (footPx < Math.max(5, floor - 2)) unfit(\"footnote\");\n412\t  const footLineH = Math.round(footPx * 1.4), footH = footLines.length * footLineH + 2;\n413\t  const footRect: SwimRect = { x: m, y: H - m - footH, w: CW, h: footH };\n414\t  cells.push({ label: \"footnote\", rect: footRect, text: footLines.join(\"\\n\"), px: footPx, width: Math.max(...footLines.map((l) => widthOf(l, footPx))), bold: false, align: \"left\", color: dim, bind: null, over: false });\n415\t\n416\t  const sumTop = Math.round(S * 0.05 * k);\n417\t  const countW = Math.round(CW * 0.58), totalW = CW - countW - gap;\n418\t  const sidePx = Math.min(fitPx(p.countText, p.totalText === \"\" ? CW : countW, sumTop, true), p.totalText === \"\" ? Infinity : fitPx(p.totalText, totalW, sumTop, true));\n419\t  // Side by side while that keeps the size; stacked when the pair would have to shrink (portrait).\n420\t  const stacked = p.totalText !== \"\" && sidePx < sumTop * 0.85;\n421\t  const sumPx = stacked ? Math.min(fitPx(p.countText, CW, sumTop, true), fitPx(p.totalText, CW, sumTop, true)) : sidePx;\n422\t  const sumRowH = Math.round(sumPx * 1.45);"}]},"parent_tool_use_id":null,"session_id":"69fab120-65e8-492e-b76a-c27ffd29396a","uuid":"6c3893a1-f52b-459b-981a-7b029342d7c4","timestamp":"2026-10-01T13:23:31.391Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\swim-time-drop-card\\v1\\swim-time-drop-card.ts","content":"  const compared = lines.filter((l) => l.dropCs !== null).length;\n  const totalCs = faster.reduce((sum, l) => sum + num(l), 0);\n  const countText = compared === 0 ? \"No times to compare\" : `${faster.length} of ${compared} ${compared === 1 ? \"swim\" : \"swims\"} faster`;\n  // Slower swims are not netted against the total: each is printed on its own row.\n  const totalText = faster.length === 0 ? \"\" : totalCs < 6000 ? `${formatSwimTime(totalCs)} s dropped` : `${formatSwimTime(totalCs)} dropped`;\n  const scaleText = longest === null ? \"\"\n    : bar === \"percent\" ? formatSwimShare(num(longest), longest.entryCs as number)\n    : num(longest) < 6000 ? `${formatSwimTime(num(longest))} s` : formatSwimTime(num(longest));\n  const footnote = compared === 0 ? \"vs entry time. A first swim or a DQ has no drop to show.\"\n    : longest === null ? \"vs entry time. No swim was faster, so no bar is drawn.\"\n    : bar === \"percent\" ? `vs entry time. Bars: share of the entry time dropped; the longest is ${scaleText}.`\n    : `vs entry time. Bars: seconds dropped; the longest is ${scaleText}.`;\n\n  return {\n    swimmer, club, meet, details, course: p.course as SwimCourse, bar, preset: p.preset as \"dark\" | \"light\",\n    accent: p.accent.trim().toLowerCase() as MosaicColor, debugLayout: p.debugLayout,\n    lines, faster: faster.length, compared, totalCs, countText, totalText, scaleText, footnote,\n  };\n}\n\n/* ── colour ── */\n\n// Not exported: the pack index is `export *`, and dev/bench-delta already exports a `mix`.\nfunction mix(a: string, b: string, t: number): MosaicColor {\n  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n}\nfunction luminance(hex: string): number {\n  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n}\n/** The readable ink over a filled chip: dark or white, whichever contrasts more with the caller's accent. */\nfunction onColor(fill: string): MosaicColor {\n  const ratio = (other: string) => { const a = luminance(fill), b = luminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n  return (ratio(\"#0b1220\") >= ratio(\"#ffffff\") ? \"#0b1220\" : \"#ffffff\") as MosaicColor;\n}\n\n/* ── geometry ── */\n\nexport type SwimRect = { x: number; y: number; w: number; h: number };\ntype Bind = { prop: \"swimmer\" | \"club\" | \"meet\" | \"details\" } | { row: number; field: \"event\" | \"entry\" | \"final\" | \"standard\" } | null;\ntype Cell = { label: string; rect: SwimRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\ntype Tile = { label: string; rect: SwimRect; color: MosaicColor; radius: number; layer: number; accent?: boolean };\n\n/** The largest whole size up to `maxPx` at which one line fits the cell's budget (`cell * 0.94 - 2px`). */\nfunction fitPx(line: string, cellW: number, maxPx: number, bold: boolean): number {\n  const top = Math.max(1, Math.round(maxPx));\n  const room = budget(cellW), w = widthOf(line, top, bold);\n  let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n  while (px > 1 && widthOf(line, px, bold) > room) px--;\n  return px;\n}\n\n/** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\nexport function layoutSwimCard(props: SwimTimeDropCardProps, W: number, H: number) {\n  const p = normalizeSwimCard(props);\n  const theme = THEMES[p.preset];\n  const ink = theme.ink as MosaicColor, dim = theme.dim as MosaicColor;\n  const S = Math.min(W, H);\n  // Wide canvases put the bar in a column; square and portrait need the width\n  // for the text cells, so the bar becomes a strip under the row's text line.\n  const wide = W * 3 >= H * 4;\n  const k = wide ? 1 : Math.max(1, Math.min(1.25, H / W));\n  const m = Math.round(S * 0.055), CW = W - 2 * m;\n  const gap = Math.round(S * 0.022);\n  const rule = Math.max(1, Math.round(S * 0.0025));\n  const floor = Math.max(6, Math.round(S * 0.022));\n  const cells: Cell[] = [];\n  const tiles: Tile[] = [];\n  const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n  /** One fitted line in `rect`; refuses below the floor instead of clipping. */\n  const line = (label: string, rect: SwimRect, value: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string; floor?: number } = {}) => {\n    if (px < (o.floor ?? floor)) unfit(o.field ?? label);\n    cells.push({ label, rect, text: value, px, width: widthOf(value, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? ink, bind: o.bind ?? null, over: o.over === true });\n  };\n\n  // ── header: the name is the largest text; the course chip sits top right ──\n  const right = p.meet !== \"\" || p.details !== \"\";\n  let headerBottom: number;\n  if (wide) {\n    const hH = Math.round((H - 2 * m) * 0.21);\n    const chipH = Math.round(hH * 0.3), chipW = Math.round(chipH * 2.3);\n    const leftW = right ? Math.round(CW * 0.56) : CW - chipW - gap;\n    const rightX = m + leftW + gap, rightW = CW - leftW - gap;\n    const nameH = Math.round(hH * 0.62), subY = m + Math.round(hH * 0.68), subH = m + hH - subY;\n    const midY = m + Math.round(hH * 0.36), midH = subY - midY;\n    line(\"swimmer\", { x: m, y: m, w: leftW, h: nameH }, p.swimmer, fitPx(p.swimmer, leftW, nameH * 0.74, true), { bold: true, bind: { prop: \"swimmer\" } });\n    const subPx = Math.min(...[[p.club, leftW], [p.meet, rightW], [p.details, rightW]].map(([t, w]) => (t === \"\" ? Infinity : fitPx(t as string, w as number, subH * 0.6, false))), Math.round(subH * 0.6));\n    if (p.club !== \"\") line(\"club\", { x: m, y: subY, w: leftW, h: subH }, p.club, subPx, { color: dim, bind: { prop: \"club\" } });\n    if (p.meet !== \"\") line(\"meet\", { x: rightX, y: midY, w: rightW, h: midH }, p.meet, subPx, { color: dim, align: \"right\", bind: { prop: \"meet\" } });\n    if (p.details !== \"\") line(\"details\", { x: rightX, y: subY, w: rightW, h: subH }, p.details, subPx, { color: dim, align: \"right\", bind: { prop: \"details\" } });\n    tiles.push({ label: \"course-chip\", rect: { x: W - m - chipW, y: m, w: chipW, h: chipH }, color: p.accent, radius: 0.5, layer: 1, accent: true });\n    headerBottom = m + hH;\n  } else {\n    const nameH = Math.round(S * 0.085 * k), lineH = Math.round(S * 0.044 * k);\n    const chipH = Math.round(nameH * 0.56), chipW = Math.round(chipH * 2.3);\n    const nameW = CW - chipW - gap;\n    line(\"swimmer\", { x: m, y: m, w: nameW, h: nameH }, p.swimmer, fitPx(p.swimmer, nameW, nameH * 0.74, true), { bold: true, bind: { prop: \"swimmer\" } });\n    tiles.push({ label: \"course-chip\", rect: { x: W - m - chipW, y: m + Math.round((nameH - chipH) / 2), w: chipW, h: chipH }, color: p.accent, radius: 0.5, layer: 1, accent: true });\n    // The club on its own line; the meet and the details share the next one.\n    const meetW = p.details === \"\" ? CW : Math.round(CW * 0.62), detailsW = p.meet === \"\" ? CW : CW - meetW - gap;\n    const subPx = Math.min(...[[p.club, CW], [p.meet, meetW], [p.details, detailsW]].map(([t, w]) => (t === \"\" ? Infinity : fitPx(t as string, w as number, lineH * 0.62, false))), Math.round(lineH * 0.62));\n    let y = m + nameH;\n    if (p.club !== \"\") { line(\"club\", { x: m, y, w: CW, h: lineH }, p.club, subPx, { color: dim, bind: { prop: \"club\" } }); y += lineH; }\n    if (p.meet !== \"\") line(\"meet\", { x: m, y, w: meetW, h: lineH }, p.meet, subPx, { color: dim, bind: { prop: \"meet\" } });\n    if (p.details !== \"\") line(\"details\", { x: W - m - detailsW, y, w: detailsW, h: lineH }, p.details, subPx, { color: dim, align: p.meet === \"\" ? \"left\" : \"right\", bind: { prop: \"details\" } });\n    if (right) y += lineH;\n    headerBottom = y;\n  }\n  const courseChip = tiles[0].rect;\n  line(\"course\", courseChip, p.course, fitPx(p.course, courseChip.w, courseChip.h * 0.5, true), { bold: true, align: \"center\", color: onColor(p.accent), over: true, floor: Math.max(5, floor - 2) });\n\n  // ── summary band, built from the bottom up: count and total, then the footnote that carries the honesty ──\n  const footTop = Math.round(S * 0.025 * k);\n  const oneLine = fitPx(p.footnote, CW, footTop, false);\n  let footPx = oneLine, footLines = [p.footnote];\n  if (oneLine < footTop * 0.9) {\n    // Two lines at the target size beat one shrunken line; shrink only when two do not hold it.\n    footPx = footTop;\n    footLines = wrapMeasured(p.footnote, footPx, budget(CW));\n    while (footLines.length > 2 && footPx > 1) { footPx--; footLines = wrapMeasured(p.footnote, footPx, budget(CW)); }\n  }\n  if (footPx < Math.max(5, floor - 2)) unfit(\"footnote\");\n  const footLineH = Math.round(footPx * 1.4), footH = footLines.length * footLineH + 2;\n  const footRect: SwimRect = { x: m, y: H - m - footH, w: CW, h: footH };\n  cells.push({ label: \"footnote\", rect: footRect, text: footLines.join(\"\\n\"), px: footPx, width: Math.max(...footLines.map((l) => widthOf(l, footPx))), bold: false, align: \"left\", color: dim, bind: null, over: false });\n\n  const sumTop = Math.round(S * 0.05 * k);\n  const countW = Math.round(CW * 0.58), totalW = CW - countW - gap;\n  const sidePx = Math.min(fitPx(p.countText, p.totalText === \"\" ? CW : countW, sumTop, true), p.totalText === \"\" ? Infinity : fitPx(p.totalText, totalW, sumTop, true));\n  // Side by side while that keeps the size; stacked when the pair would have to shrink (portrait).\n  const stacked = p.totalText !== \"\" && sidePx < sumTop * 0.85;\n  const sumPx = stacked ? Math.min(fitPx(p.countText, CW, sumTop, true), fitPx(p.totalText, CW, sumTop, true)) : sidePx;\n  const sumRowH = Math.round(sumPx * 1.45);","numLines":135,"startLine":288,"totalLines":647}}}
