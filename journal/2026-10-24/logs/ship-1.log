{"type":"tool_use","timestamp":1792859346231,"sessionID":"ses_e9141cfbdffenLAFgwFuHpfkdd","part":{"type":"tool","tool":"read","callID":"call_00_GQ8tWIWML6T3oxdAu66n1593","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\orienteering-split-analysis\\v1\\orienteering-split-analysis.ts"},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\src\\sports\\orienteering-split-analysis\\v1\\orienteering-split-analysis.ts</path>\n<type>file</type>\n<content>\n1: import type {\n2:   MosaicColor,\n3:   MosaicDocument,\n4:   MosaicEngineContext,\n5:   MosaicSource,\n6: } from \"@m0saic/types\";\n7: import { asTemplateId } from \"@m0saic/types\";\n8: import { toM0String } from \"@m0saic/dsl-stdlib\";\n9: import {\n10:   bindProp,\n11:   bindPropPath,\n12:   defineMosaicTemplate,\n13:   definePropsSchema,\n14:   makeColorTile,\n15:   placeInsetPieces,\n16:   tag,\n17: } from \"@m0saic/template-utils\";\n18: import type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\n19: import { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n20: import { budget, textCell, widthOf } from \"../../../_shared/text\";\n21: import { whyTutorial } from \"../../../_shared/why\";\n22: import type { WhySpec } from \"../../../_shared/why\";\n23: \n24: /**\n25:  * `@one-a-day/sports/orienteering-split-analysis/v1` - one racer's IOF XML 3.0\n26:  * result row as a shareable split-analysis card: finish time as the hero, the\n27:  * course and the place, then control-by-control legs as a tape whose length is\n28:  * the split, and a footer that answers the one question everyone asks -\n29:  * \"where did I lose time?\" - as TIME W/O MISTAKES, TOTAL LOSS and BEST LEG.\n30:  *\n31:  * ONE CONCEPT: the mistake is the picture. A leg's bar length is its split\n32:  * over the slowest leg, so the eye reads the race; a leg with time loss\n33:  * (`loss > 0`, the WinSplits per-leg number) is drawn in the accent - pink\n34:  * bar, signed pink loss - and a clean leg is neutral with an empty loss cell.\n35:  * No legend: pink = mistake, bar length = split.\n36:  *\n37:  * The rule that bites: time loss is NOT re-derived. WinSplits computes it\n38:  * class-relative from the whole field, so it comes in as a prop per leg; the\n39:  * card only sums the entered losses (TOTAL LOSS), subtracts them from the\n40:  * entered finish (TIME W/O MISTAKES) and takes the min split (BEST LEG) - and\n41:  * it never checks the finish against the split sum. A decimal time, an\n42:  * h:mm:ss loss, a leg count outside 4-18, or a leg that will not fit the\n43:  * canvas fails fast with a named field.\n44:  */\n45: \n46: export type OrienteeringLeg = { control: string; split: string; loss: string };\n47: \n48: export type OrienteeringSplitAnalysisProps = {\n49:   /** The racer, the header's bold line. Up to 40 ASCII; \"\" hides it. */\n50:   name?: string;\n51:   /** The club, first half of the second line. Up to 40 ASCII; \"\" hides it. */\n52:   club?: string;\n53:   /** The class, joined after the club with \" · \". Up to 20 ASCII. */\n54:   className?: string;\n55:   /** The course, the third header line. Up to 48 ASCII; \"\" hides it. */\n56:   course?: string;\n57:   /** The finish time, the hero figure. \"m:ss\" or \"h:mm:ss\", whole seconds. */\n58:   finish?: string;\n59:   /** The place, drawn as the accent \"#12\" chip. 0 hides the chip. */\n60:   place?: number;\n61:   /** Time behind the winner, printed as entered. Up to 16 ASCII; \"\" hides it. */\n62:   behind?: string;\n63:   /** The legs in course order, 4-18, each { control, split, loss }. */\n64:   splits?: OrienteeringLeg[] | string;\n65:   /** The mistake-leg pink - bars, loss text, place chip - as #rrggbb. */\n66:   accent?: string;\n67:   /** Page and ink: \"dark\" share card or \"light\" print. */\n68:   preset?: \"dark\" | \"light\";\n69:   /** Dev-only: check the layout contract and draw it over the card. */\n70:   debugLayout?: boolean;\n71: };\n72: \n73: const ID = \"@one-a-day/sports/orienteering-split-analysis/v1\";\n74: const TITLE = \"Orienteering Split Analysis\";\n75: const DEFAULT_ACCENT = \"#d94f8c\";\n76: const ASCII = /^[\\x20-\\x7e]*$/;\n77: const HEX = /^#[0-9a-fA-F]{6}$/;\n78: \n79: const THEMES = {\n80:   dark: { bg: \"#14111d\", ink: \"#efe9f2\", dim: \"#9b92a4\" },\n81:   light: { bg: \"#f6f2ef\", ink: \"#241d28\", dim: \"#6f6574\" },\n82: } as const;\n83: \n84: /** A 12-control middle course: 13 legs in course order, the last the finish. */\n85: export const DEFAULT_LEGS: OrienteeringLeg[] = [\n86:   { control: \"1\", split: \"4:08\", loss: \"0:47\" },\n87:   { control: \"2\", split: \"2:41\", loss: \"0:00\" },\n88:   { control: \"3\", split: \"3:15\", loss: \"0:00\" },\n89:   { control: \"4\", split: \"2:58\", loss: \"0:00\" },\n90:   { control: \"5\", split: \"5:22\", loss: \"1:20\" },\n91:   { control: \"6\", split: \"3:40\", loss: \"0:00\" },\n92:   { control: \"7\", split: \"1:32\", loss: \"0:00\" },\n93:   { control: \"8\", split: \"4:05\", loss: \"0:00\" },\n94:   { control: \"9\", split: \"3:51\", loss: \"0:51\" },\n95:   { control: \"10\", split: \"2:44\", loss: \"0:00\" },\n96:   { control: \"11\", split: \"3:33\", loss: \"0:00\" },\n97:   { control: \"12\", split: \"4:11\", loss: \"0:00\" },\n98:   { control: \"F\", split: \"1:55\", loss: \"0:00\" },\n99: ];\n100: \n101: const DEFAULTS = {\n102:   name: \"Emma Lindqvist\",\n103:   club: \"OK Klyftamo\",\n104:   className: \"W21E\",\n105:   course: \"Middle, 4.2 km\",\n106:   finish: \"45:02\",\n107:   place: 12,\n108:   behind: \"+1:23\",\n109:   splits: DEFAULT_LEGS,\n110:   accent: DEFAULT_ACCENT,\n111:   preset: \"dark\" as \"dark\" | \"light\",\n112:   debugLayout: false,\n113: };\n114: \n115: const propsSchema = definePropsSchema<OrienteeringSplitAnalysisProps>({\n116:   name: {\n117:     type: \"string\",\n118:     required: false,\n119:     description: \"The racer, the header's bold line. Up to 40 ASCII characters; empty hides the line. The sample is invented.\",\n120:     meta: { control: { placeholder: DEFAULTS.name }, ui: { label: \"Name\", order: 1, primary: true } },\n121:   },\n122:   club: {\n123:     type: \"string\",\n124:     required: false,\n125:     description: 'The club, first half of the second header line. Up to 40 ASCII; empty hides it. Joined to the class with \" · \".',\n126:     meta: { control: { placeholder: DEFAULTS.club }, ui: { label: \"Club\", order: 2 } },\n127:   },\n128:   className: {\n129:     type: \"string\",\n130:     required: false,\n131:     description: 'The class, joined after the club with \" · \". Up to 20 ASCII; empty shows the club alone.',\n132:     meta: { control: { placeholder: DEFAULTS.className }, ui: { label: \"Class\", order: 3 } },\n133:   },\n134:   course: {\n135:     type: \"string\",\n136:     required: false,\n137:     description: \"The course, the third header line, e.g. \\\"Middle, 4.2 km\\\". Up to 48 ASCII; empty hides it.\",\n138:     meta: { control: { placeholder: DEFAULTS.course }, ui: { label: \"Course\", order: 4 } },\n139:   },\n140:   finish: {\n141:     type: \"string\",\n142:     required: false,\n143:     description: 'The finish time, the hero figure. \"m:ss\" (minutes may pass 59, so \"71:40\" is legal) or \"h:mm:ss\", whole seconds. A decimal fails fast.',\n144:     meta: { control: { placeholder: DEFAULTS.finish }, ui: { label: \"Finish\", order: 5, primary: true } },\n145:   },\n146:   place: {\n147:     type: \"number\",\n148:     required: false,\n149:     description: \"The place, drawn as the accent chip #12. Whole number 0-9999; 0 hides the chip.\",\n150:     meta: { constraints: { min: 0, max: 9999 }, control: { placeholder: String(DEFAULTS.place) }, ui: { label: \"Place\", order: 6 } },\n151:   },\n152:   behind: {\n153:     type: \"string\",\n154:     required: false,\n155:     description: 'Time behind the winner, printed as entered, e.g. \"+1:23\". Up to 16 ASCII; empty hides it.',\n156:     meta: { control: { placeholder: DEFAULTS.behind }, ui: { label: \"Behind\", order: 7 } },\n157:   },\n158:   splits: {\n159:     type: \"json\",\n160:     required: false,\n161:     description:\n162:       'The legs in course order, 4-18. Each object is { control, split, loss } - the IOF field names. control is the code, split is \"m:ss\" or \"h:mm:ss\" (whole seconds), loss is the WinSplits per-leg time loss as \"m:ss\" (\"0:00\" = clean, anything more = a mistake leg drawn pink). Example: [{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}].',\n163:     meta: {\n164:       constraints: {\n165:         jsonSchema: {\n166:           type: \"array\",\n167:           minItems: 4,\n168:           maxItems: 18,\n169:           items: {\n170:             type: \"object\",\n171:             required: [\"control\", \"split\", \"loss\"],\n172:             properties: {\n173:               control: { type: \"string\", minLength: 1, maxLength: 8 },\n174:               split: { type: \"string\" },\n175:               loss: { type: \"string\" },\n176:             },\n177:           },\n178:         },\n179:       },\n180:       control: { mono: true, placeholder: '[{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}]' },\n181:       ui: { label: \"Splits\", order: 8, primary: true },\n182:     },\n183:   },\n184:   accent: {\n185:     type: \"string\",\n186:     required: false,\n187:     description: \"The mistake-leg pink - bars, loss text and the place chip - as #rrggbb.\",\n188:     meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 9 } },\n189:   },\n190:   preset: {\n191:     type: \"string\",\n192:     required: false,\n193:     description: 'Page and ink: \"dark\" (default) or \"light\".',\n194:     meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 10 } },\n195:   },\n196:   debugLayout: {\n197:     type: \"boolean\",\n198:     required: false,\n199:     description: \"Dev-only: check the layout contract (every text fits its box, header/body/footer hold their bands, rows equal, tape at least 32% wide) and draw it over the card.\",\n200:     meta: { ui: { label: \"Debug layout\", order: 99 } },\n201:   },\n202: });\n203: \n204: function fail(field: string, rule: string): never {\n205:   throw new Error(`${ID}: ${field} ${rule}`);\n206: }\n207: \n208: /**\n209:  * \"m:ss\" or \"h:mm:ss\" to whole seconds. Minutes may pass 59 in the one-colon\n210:  * form. Seconds (and minutes in the two-colon form) are 0-59. A decimal is\n211:  * refused, not rounded. null when the string is not that grammar.\n212:  */\n213: export function parseSplitTime(text: string): number | null {\n214:   const s = text.trim();\n215:   if (s.length === 0 || /[.]/.test(s)) return null;\n216:   const hms = /^(\\d+):([0-5]\\d):([0-5]\\d)$/.exec(s);\n217:   if (hms) return Number(hms[1]) * 3600 + Number(hms[2]) * 60 + Number(hms[3]);\n218:   const ms = /^(\\d+):([0-5]\\d)$/.exec(s);\n219:   if (ms) return Number(ms[1]) * 60 + Number(ms[2]);\n220:   return null;\n221: }\n222: \n223: /** Compact, no leading zeros. Hours only when the value is at least one hour. */\n224: export function formatSplitTime(sec: number): string {\n225:   const h = Math.floor(sec / 3600);\n226:   const m = Math.floor((sec % 3600) / 60);\n227:   const ss = String(sec % 60).padStart(2, \"0\");\n228:   if (h >= 1) return `${h}:${String(m).padStart(2, \"0\")}:${ss}`;\n229:   return `${m}:${ss}`;\n230: }\n231: \n232: function text(value: unknown, field: string, max: number): string {\n233:   if (typeof value !== \"string\") fail(field, \"must be a string.\");\n234:   if (!ASCII.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII.`);\n235:   const s = value.trim();\n236:   if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n237:   return s;\n238: }\n239: \n240: /** m:ss or h:mm:ss, whole seconds, at least one second, at most 99:59:59. */\n241: function timeField(value: unknown, field: string): { sec: number; printed: string } {\n242:   if (typeof value !== \"string\") fail(field, 'must be a string, \"m:ss\" or \"h:mm:ss\".');\n243:   const sec = parseSplitTime(value);\n244:   if (sec === null) fail(field, `${JSON.stringify(value)} is not a time: write m:ss or h:mm:ss, whole seconds, no decimal (e.g. \"4:08\" or \"1:11:40\").`);\n245:   if (sec < 1) fail(field, `${JSON.stringify(value)} must be at least one second.`);\n246:   if (sec > 359999) fail(field, `${JSON.stringify(value)} is longer than 99:59:59; the card cannot fit it.`);\n247:   return { sec, printed: formatSplitTime(sec) };\n248: }\n249: \n250: /** The WinSplits per-leg loss: m:ss only (never hours), zero allowed (clean). */\n251: function lossField(value: unknown, field: string): { sec: number; printed: string } {\n252:   if (typeof value !== \"string\") fail(field, 'must be a string, \"m:ss\".');\n253:   const t = value.trim();\n254:   if (!/^\\d+:[0-5]\\d$/.test(t)) fail(field, `${JSON.stringify(value)} is not m:ss: write m:ss, whole seconds (e.g. \"0:47\"); a loss is a per-leg time, never hours.`);\n255:   const sec = parseSplitTime(t)!;\n256:   if (sec > 359999) fail(field, `${JSON.stringify(value)} is longer than 99:59:59.`);\n257:   return { sec, printed: formatSplitTime(sec) };\n258: }\n259: \n260: export type Leg = {\n261:   index: number;\n262:   control: string;\n263:   split: string;\n264:   splitSec: number;\n265:   loss: string;\n266:   lossSec: number;\n267:   isMistake: boolean;\n268: };\n269: \n270: export type NormalizedSplitCard = {\n271:   name: string;\n272:   club: string;\n273:   className: string;\n274:   course: string;\n275:   clubLine: string;\n276:   finish: string;\n277:   finishSec: number;\n278:   place: number;\n279:   placeText: string;\n280:   behind: string;\n281:   legs: Leg[];\n282:   slowestSec: number;\n283:   bestSec: number;\n284:   totalLossSec: number;\n285:   totalLossText: string;\n286:   timeWoText: string;\n287:   bestText: string;\n288:   accent: MosaicColor;\n289:   preset: \"dark\" | \"light\";\n290:   debugLayout: boolean;\n291: };\n292: \n293: /** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n294: export function normalizeSplitCard(props: OrienteeringSplitAnalysisProps): NormalizedSplitCard {\n295:   const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n296:   const name = text(p.name, \"name\", 40);\n297:   const club = text(p.club, \"club\", 40);\n298:   const className = text(p.className, \"className\", 20);\n299:   const course = text(p.course, \"course\", 48);\n300:   const behind = text(p.behind, \"behind\", 16);\n301:   if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n302:   if (typeof p.accent !== \"string\" || !HEX.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n303:   if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n304:   const finish = timeField(p.finish, \"finish\");\n305:   if (typeof p.place !== \"number\" || !Number.isFinite(p.place)) fail(\"place\", \"must be a number.\");\n306:   if (!Number.isInteger(p.place)) fail(\"place\", \"must be a whole number.\");\n307:   if (p.place < 0 || p.place > 9999) fail(\"place\", `${p.place} is outside 0-9999; 0 hides the chip.`);\n308: \n309:   let splits = p.splits;\n310:   if (typeof splits === \"string\") {\n311:     try {\n312:       splits = JSON.parse(splits);\n313:     } catch {\n314:       fail(\"splits\", `is not valid JSON: ${JSON.stringify(splits.slice(0, 60))}. Pass a list of {control, split, loss}.`);\n315:     }\n316:   }\n317:   if (!Array.isArray(splits)) fail(\"splits\", 'must be a list of legs, e.g. [{\"control\":\"1\",\"split\":\"4:08\",\"loss\":\"0:47\"}].');\n318:   if (splits.length < 4 || splits.length > 18) fail(\"splits\", `has ${splits.length} legs; a course is 4 to 18 legs (the finish leg counts).`);\n319:   const legs: Leg[] = splits.map((raw, i) => {\n320:     if (raw === null || typeof raw !== \"object\" || Array.isArray(raw)) fail(`splits[${i}]`, \"must be an object with control, split and loss.\");\n321:     const o = raw as OrienteeringLeg;\n322:     const control = text(o.control, `splits[${i}].control`, 8);\n323:     if (control === \"\") fail(`splits[${i}].control`, \"is empty; give the control code.\");\n324:     const split = timeField(o.split, `splits[${i}].split`);\n325:     const loss = lossField(o.loss, `splits[${i}].loss`);\n326:     return { index: i, control, split: split.printed, splitSec: split.sec, loss: loss.printed, lossSec: loss.sec, isMistake: loss.sec > 0 };\n327:   });\n328: \n329:   const slowestSec = Math.max(...legs.map((l) => l.splitSec));\n330:   const bestSec = Math.min(...legs.map((l) => l.splitSec));\n331:   const totalLossSec = legs.reduce((a, l) => a + l.lossSec, 0);\n332:   if (totalLossSec > finish.sec) {\n333:     fail(\"splits\", `the per-leg losses sum to ${formatSplitTime(totalLossSec)}, more than the finish ${finish.printed}; time-without-mistakes would be negative.`);\n334:   }\n335:   const clubLine = [club, className].filter((s) => s !== \"\").join(\" \\u00b7 \");\n336:   return {\n337:     name, club, className, course, clubLine,\n338:     finish: finish.printed, finishSec: finish.sec,\n339:     place: p.place, placeText: p.place > 0 ? `#${p.place}` : \"\",\n340:     behind,\n341:     legs, slowestSec, bestSec, totalLossSec,\n342:     totalLossText: totalLossSec > 0 ? `+${formatSplitTime(totalLossSec)}` : \"0:00\",\n343:     timeWoText: formatSplitTime(finish.sec - totalLossSec),\n344:     bestText: formatSplitTime(bestSec),\n345:     accent: p.accent.trim().toLowerCase() as MosaicColor,\n346:     preset: p.preset, debugLayout: p.debugLayout,\n347:   };\n348: }\n349: \n350: function mix(a: string, b: string, t: number): MosaicColor {\n351:   const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n352:   const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n353:   return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n354: }\n355: function luminance(hex: string): number {\n356:   const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n357:   return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n358: }\n359: function onColor(fill: string): MosaicColor {\n360:   const ratio = (other: string) => { const a = luminance(fill), b = luminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n361:   return (ratio(\"#14111d\") >= ratio(\"#ffffff\") ? \"#14111d\" : \"#ffffff\") as MosaicColor;\n362: }\n363: \n364: export type SplitRect = { x: number; y: number; w: number; h: number };\n365: type Bind =\n366:   | { kind: \"prop\"; key: string }\n367:   | { kind: \"path\"; path: (string | number)[]; valueKind: \"string\" | \"number\" }\n368:   | null;\n369: type Cell = { label: string; rect: SplitRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\n370: type Tile = { label: string; rect: SplitRect; color: MosaicColor; radius: number; layer: number; accent?: boolean };\n371: \n372: function fitPx(line: string, cellW: number, maxPx: number, bold = false): number {\n373:   const top = Math.max(1, Math.round(maxPx));\n374:   const room = budget(cellW);\n375:   const w = widthOf(line, top, bold);\n376:   let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n377:   while (px > 1 && widthOf(line, px, bold) > room) px--;\n378:   return px;\n379: }\n380: \n381: /** The whole card as rects and measured fits - pure in (props, canvas). */\n382: export function layoutSplitCard(props: OrienteeringSplitAnalysisProps, W: number, H: number) {\n383:   const p = normalizeSplitCard(props);\n384:   const theme = THEMES[p.preset];\n385:   const ink = theme.ink as MosaicColor;\n386:   const dim = theme.dim as MosaicColor;\n387:   const S = Math.min(H, 0.75 * W);\n388:   const m = Math.max(8, Math.round(S * 0.04));\n389:   const CW = W - 2 * m;\n390:   const floor = Math.max(6, Math.round(Math.min(W, H) * 0.012));\n391:   const small = Math.max(5, Math.round(Math.min(W, H) * 0.009));\n392:   const gap = Math.max(3, Math.round(CW * 0.01));\n393:   const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n394: \n395:   // The three pinned bands: header [0, 0.26], body [0.26, 0.80], footer [0.80, 1].\n396:   const headerBottom = Math.floor(0.26 * H) - 1;\n397:   const bodyTop = Math.ceil(0.26 * H) + 2;\n398:   const bodyBottom = Math.floor(0.8 * H) - 2;\n399:   const footerTop = Math.ceil(0.8 * H) + 2;\n400: \n401:   const cells: Cell[] = [];\n402:   const tiles: Tile[] = [];\n403:   const line = (label: string, rect: SplitRect, value: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string; floorAt?: number } = {}) => {\n404:     if (px < (o.floorAt ?? floor)) unfit(o.field ?? label);\n405:     if (rect.w < 4 || rect.h < 4) unfit(o.field ?? label);\n406:     cells.push({ label, rect, text: value, px, width: widthOf(value, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? ink, bind: o.bind ?? null, over: o.over === true });\n407:   };\n408: \n409:   const portrait = H > W * 1.15;\n410:   const heroCap = Math.round(S * (portrait ? 0.22 : 0.145));\n411: \n412:   type Header = {\n413:     heroPx: number; blockTop: number; blockH: number; rightW: number; leftW: number;\n414:     finishRect: SplitRect; labelPx: number; chipPx: number; chipRect: SplitRect | null; behindPx: number;\n415:     namePx: number; clubPx: number; coursePx: number; leftTop: number; rightTop: number; row1H: number; row2H: number;\n416:     finishLabelRect: SplitRect; placeLabelRect: SplitRect | null; behindRect: SplitRect | null;\n417:   };\n418: \n419:   const headerAt = (heroPx: number): Header | null => {\n420:     if (heroPx <= floor) return null;\n421:     const labelPx = Math.max(small, Math.min(Math.round(heroPx * 0.18), heroPx - 2));\n422:     const chipPx = p.place > 0 ? Math.max(small, Math.min(Math.round(heroPx * 0.26), heroPx - 2)) : 0;\n423:     const behindPx = p.behind !== \"\" ? Math.max(small, Math.min(Math.round(heroPx * 0.24), heroPx - 2)) : 0;\n424:     const chipPad = Math.max(3, Math.round(chipPx * 0.45));\n425: \n426:     const finishW = Math.ceil((widthOf(p.finish, heroPx, true) + 2) / 0.94) + 2;\n427:     const finishLabelW = Math.ceil((widthOf(\"FINISH\", labelPx) + 2) / 0.94) + 2;\n428:     const row1W = finishLabelW + gap + finishW;\n429:     const chipW = p.place > 0 ? Math.ceil((widthOf(p.placeText, chipPx, true) + 2) / 0.94) + 2 + 2 * chipPad : 0;\n430:     const placeLabelW = p.place > 0 ? Math.ceil((widthOf(\"PLACE\", labelPx) + 2) / 0.94) + 2 : 0;\n431:     const behindW = p.behind !== \"\" ? Math.ceil((widthOf(p.behind, behindPx) + 2) / 0.94) + 2 : 0;\n432:     const hasRow2 = p.place > 0 || p.behind !== \"\";\n433:     let row2W = 0;\n434:     if (hasRow2) row2W = (placeLabelW > 0 ? placeLabelW + gap : 0) + (chipW > 0 ? chipW + gap : 0) + behindW;\n435:     const rightW = Math.max(row1W, row2W);\n436:     const leftW = CW - rightW - gap;\n437:     if (leftW < Math.round(CW * 0.34)) return null;\n438: \n439:     const namePx = p.name === \"\" ? 0 : fitPx(p.name, leftW, Math.min(heroPx - 1, Math.round(S * 0.05)), true);\n440:     const clubPx = p.clubLine === \"\" ? 0 : fitPx(p.clubLine, leftW, Math.min(heroPx - 2, Math.round(S * 0.03)));\n441:     const coursePx = p.course === \"\" ? 0 : fitPx(p.course, leftW, Math.min(heroPx - 2, Math.round(S * 0.028)));\n442:     if ((p.name !== \"\" && namePx < floor) || (p.clubLine !== \"\" && clubPx < small) || (p.course !== \"\" && coursePx < small)) return null;\n443:     if (chipPx > 0 && chipPx < small) return null;\n444:     if (labelPx < small) return null;\n445: \n446:     const finishH = Math.round(heroPx * 1.16);\n447:     const finishLabelH = Math.round(labelPx * 1.3);\n448:     const row1H = Math.max(finishH, finishLabelH);\n449:     const chipH = p.place > 0 ? Math.round(chipPx * 1.7) : 0;\n450:     const behindH = p.behind !== \"\" ? Math.round(behindPx * 1.3) : 0;\n451:     const placeLabelH = p.place > 0 ? Math.round(labelPx * 1.3) : 0;\n452:     const row2H = Math.max(chipH, behindH, placeLabelH);\n453:     const rightH = row1H + (hasRow2 ? gap + row2H : 0);\n454: \n455:     const nameH = p.name !== \"\" ? Math.round(namePx * 1.2) : 0;\n456:     const clubH = p.clubLine !== \"\" ? Math.round(clubPx * 1.3) : 0;\n457:     const courseH = p.course !== \"\" ? Math.round(coursePx * 1.3) : 0;\n458:     const leftParts = [nameH, clubH, courseH].filter((h) => h > 0);\n459:     const leftGap = Math.max(2, Math.round(gap * 0.45));\n460:     const leftH = leftParts.reduce((a, h) => a + h, 0) + Math.max(0, leftParts.length - 1) * leftGap;\n461: \n462:     const blockH = Math.max(rightH, leftH, finishH);\n463:     const avail = headerBottom - m;\n464:     if (blockH > avail) return null;\n465:     const blockTop = m + Math.max(0, Math.round((avail - blockH) / 2));\n466:     const rightTop = blockTop;\n467:     const leftTop = blockTop;\n468: \n469:     const finishRect: SplitRect = { x: W - m - finishW, y: rightTop + Math.round((row1H - finishH) / 2), w: finishW, h: finishH };\n470:     const finishLabelRect: SplitRect = { x: W - m - row1W, y: rightTop + Math.round((row1H - finishLabelH) / 2), w: finishLabelW, h: finishLabelH };\n471:     let placeLabelRect: SplitRect | null = null;\n472:     let chipRect: SplitRect | null = null;\n473:     let behindRect: SplitRect | null = null;\n474:     if (hasRow2) {\n475:       const row2Y = rightTop + row1H + gap;\n476:       let rx = W - m;\n477:       if (p.behind !== \"\") {\n478:         behindRect = { x: rx - behindW, y: row2Y + Math.round((row2H - behindH) / 2), w: behindW, h: behindH };\n479:         rx = behindRect.x - gap;\n480:       }\n481:       if (p.place > 0) {\n482:         chipRect = { x: rx - chipW, y: row2Y + Math.round((row2H - chipH) / 2), w: chipW, h: chipH };\n483:         rx = chipRect.x - gap;\n484:         placeLabelRect = { x: rx - placeLabelW, y: row2Y + Math.round((row2H - placeLabelH) / 2), w: placeLabelW, h: placeLabelH };\n485:       }\n486:     }\n487: \n488:     return { heroPx, blockTop, blockH, rightW, leftW, finishRect, labelPx, chipPx, chipRect, behindPx, namePx, clubPx, coursePx, leftTop, rightTop, row1H, row2H, finishLabelRect, placeLabelRect, behindRect };\n489:   };\n490: \n491:   let heroPx = Math.min(heroCap, Math.max(floor + 8, Math.round((headerBottom - m) * 0.5)));\n492:   let header: Header | null = null;\n493:   while (heroPx > floor + 1) {\n494:     header = headerAt(heroPx);\n495:     if (header) break;\n496:     heroPx -= 1;\n497:   }\n498:   const hd = header ?? fail(\"finish\", `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n499: \n500:   // ---- header left block (top-aligned) ----\n501:   let ly = hd.leftTop;\n502:   const leftX = m;\n503:   if (p.name !== \"\") {\n504:     const h = Math.round(hd.namePx * 1.2);\n505:     line(\"name\", { x: leftX, y: ly, w: hd.leftW, h }, p.name, hd.namePx, { bold: true, bind: { kind: \"prop\", key: \"name\" }, field: \"name\" });\n506:     ly += h + Math.max(2, Math.round(gap * 0.45));\n507:   }\n508:   if (p.clubLine !== \"\") {\n509:     cons