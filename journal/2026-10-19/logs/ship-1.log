x.js as-is, and\",\n56:     \"the host resolves @m0saic/* from its own module tree at load time.\"\n57:   ],\n58:   \"dependencies\": {\n59:     \"@m0saic/dsl\": \"^2.0.0\",\n60:     \"@m0saic/dsl-stdlib\": \"^3.0.0\",\n61:     \"@m0saic/platform\": \"^0.2.0\",\n62:     \"@m0saic/template-utils\": \"^0.2.0\",\n63:     \"@m0saic/types\": \"^0.2.0\"\n64:   },\n65:   \"devDependencies\": {\n66:     \"@m0saic/knowledge\": \"^0.2.0\",\n67:     \"@m0saic/templates\": \"^0.2.0\",\n68:     \"@types/jest\": \"^30.0.0\",\n69:     \"@types/node\": \"^25.3.3\",\n70:     \"eslint\": \"^9.39.0\",\n71:     \"jest\": \"^30.2.0\",\n72:     \"rimraf\": \"^6.1.3\",\n73:     \"ts-jest\": \"^29.4.6\",\n74:     \"typescript\": \"^5.9.3\",\n75:     \"typescript-eslint\": \"^8.46.4\"\n76:   }\n77: }\n\n(End of file - total 77 lines)\n</content>","metadata":{"preview":"{\n  \"name\": \"one-a-day\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"description\": \"One m0saic template a day, written by an AI agent and built in public. A third-party template repo for Mosaic Desktop and the m0saic CLI.\",\n  \"license\": \"MIT\",\n  \"homepage\": \"https://github.com/m0saic-project/one-a-day\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/m0saic-project/one-a-day.git\"\n  },\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"main\": \"dist/index.js\",\n  \"types\": \"dist/index.d.ts\",\n  \"scripts\": {\n    \"clean\": \"rimraf dist template-manifest.json\",\n    \"build\": \"node tools/check-freeze.mjs && tsc -p tsconfig.build.json && node tools/copy-assets.mjs && node dist/gen-template-manifest.js && node tools/gen-gallery.mjs && node tools/check-registry.mjs && node tools/check-layout.mjs && node tools/check-why.mjs\",\n    \"conventions:sweep\": \"node tools/check-registry.mjs --sweep\",","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\package.json","text":"{\n  \"name\": \"one-a-day\",\n  \"