{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q1dvMytrZmqVgcvCLETpyp","type":"tool_result","content":"172\t  });\n173\t\n174\t  it(\"keeps its contract from 1 to 8 rows at the seven contract canvases, with nothing colliding\", async () => {\n175\t    const rowCounts = Array.from({ length: 8 }, (_, i) => ({ ...LONG, swims: LONG.swims!.slice(0, i + 1) }));\n176\t    for (const p of [...CASES, ...rowCounts]) {\n177\t      await sweepLayout((q, ctx) => T.render(q, ctx).then(asDocument), ID, p, targetCtx);\n178\t      for (const [w, h] of CONTRACT_CANVASES) {\n179\t        const L = layoutSwimCard(p, w, h);\n180\t        const doc = await render(p, w, h);\n181\t        const ev = evaluateM0(String(doc.m0), { width: w, height: h });\n182\t        expect(ev.feasible && ev.meetsPrecision).toBe(true);\n183\t\n184\t        // Every source is labelled and promised something; every text promises that it fits.\n185\t        const intent = layoutIntentOf(doc)!;\n186\t        for (const s of doc.sources ?? []) {\n187\t          expect(s.editor?.label).toBeTruthy();\n188\t          expect(intent.constraints.some((c) => c.label === s.editor?.label) || /^(track|bar|chip)-\\d$/.test(String(s.editor?.label))).toBe(true);\n189\t          if (s.type === \"text\") expect(intent.constraints.some((c) => c.label === s.editor?.label && c.textFits)).toBe(true);\n190\t        }\n191\t\n192\t        // Inside the margins, never below the floor, never cut.\n193\t        for (const c of L.cells) {\n194\t          expect(c.px).toBeGreaterThanOrEqual(L.small);\n195\t          expect(c.text).not.toContain(\"...\");\n196\t          expect(c.rect.x).toBeGreaterThanOrEqual(L.m);\n197\t          expect(c.rect.y).toBeGreaterThanOrEqual(L.m);\n198\t          expect(c.rect.x + c.rect.w).toBeLessThanOrEqual(w - L.m);\n199\t          expect(c.rect.y + c.rect.h).toBeLessThanOrEqual(h - L.m);\n200\t        }\n201\t        // No two texts overlap, and no text sits on a tile it does not belong to.\n202\t        const texts = L.cells.map((c) => ({ label: c.label, rect: c.rect }));\n203\t        const hit = (a: { x: number; y: number; w: number; h: number }, b: { x: number; y: number; w: number; h: number }) => a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;\n204\t        for (let i = 0; i < texts.length; i++) for (let j = i + 1; j < texts.length; j++) {\n205\t          if (hit(texts[i].rect, texts[j].rect)) throw new Error(`${texts[i].label} overlaps ${texts[j].label} at ${w}x${h}`);\n206\t        }\n207\t        for (const t of L.tiles) for (const c of L.cells) {\n208\t          const own = (t.label === \"course-chip\" && c.label === \"course\") || (t.label.startsWith(\"chip-\") && c.label === `standard-${t.label.slice(5)}`);\n209\t          if (!own && hit(t.rect, c.rect)) throw new Error(`${c.label} overlaps ${t.label} at ${w}x${h}`);\n210\t        }\n211\t        // The rows keep to their band, in order, and one or two swims do not become slabs.\n212\t        expect(L.rowH).toBeLessThanOrEqual(L.cap);\n213\t        expect(L.rows[0].top).toBe(L.bandTop + (L.rows[0].top - L.bandTop));\n214\t        expect(L.rows[L.rows.length - 1].top + L.rowH).toBeLessThanOrEqual(L.bandBottom);\n215\t        // The name is the largest text; the summary is second.\n216\t        const px = Object.fromEntries(L.cells.map((c) => [c.label, c.px]));\n217\t        if (p === CASES[0]) {\n218\t          expect(px.swimmer).toBeGreaterThan(px[\"summary-count\"]);\n219\t          expect(px[\"summary-count\"]).toBeGreaterThan(px[\"event-0\"]);\n220\t        }\n221\t      }"}]},"parent_tool_use_id":null,"session_id":"69fab120-65e8-492e-b76a-c27ffd29396a","uuid":"a7680489-0952-4c03-b4f7-ed1f9e1826b3","timestamp":"2026-10-01T13:29:48.360Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\swim-time-drop-card\\v1\\swim-time-drop-card.test.ts","content":"  });\n\n  it(\"keeps its contract from 1 to 8 rows at the seven contract canvases, with nothing colliding\", async () => {\n    const rowCounts = Array.from({ length: 8 }, (_, i) => ({ ...LONG, swims: LONG.swims!.slice(0, i + 1) }));\n    for (const p of [...CASES, ...rowCounts]) {\n      await sweepLayout((q, ctx) => T.render(q, ctx).then(asDocument), ID, p, targetCtx);\n      for (const [w, h] of CONTRACT_CANVASES) {\n        const L = layoutSwimCard(p, w, h);\n        const doc = await render(p, w, h);\n        const ev = evaluateM0(String(doc.m0), { width: w, height: h });\n        expect(ev.feasible && ev.meetsPrecision).toBe(true);\n\n        // Every source is labelled and promised something; every text promises that it fits.\n        const intent = layoutIntentOf(doc)!;\n        for (const s of doc.sources ?? []) {\n          expect(s.editor?.label).toBeTruthy();\n          expect(intent.constraints.some((c) => c.label === s.editor?.label) || /^(track|bar|chip)-\\d$/.test(String(s.editor?.label))).toBe(true);\n          if (s.type === \"text\") expect(intent.constraints.some((c) => c.label === s.editor?.label && c.textFits)).toBe(true);\n        }\n\n        // Inside the margins, never below the floor, never cut.\n        for (const c of L.cells) {\n          expect(c.px).toBeGreaterThanOrEqual(L.small);\n          expect(c.text).not.toContain(\"...\");\n          expect(c.rect.x).toBeGreaterThanOrEqual(L.m);\n          expect(c.rect.y).toBeGreaterThanOrEqual(L.m);\n          expect(c.rect.x + c.rect.w).toBeLessThanOrEqual(w - L.m);\n          expect(c.rect.y + c.rect.h).toBeLessThanOrEqual(h - L.m);\n        }\n        // No two texts overlap, and no text sits on a tile it does not belong to.\n        const texts = L.cells.map((c) => ({ label: c.label, rect: c.rect }));\n        const hit = (a: { x: number; y: number; w: number; h: number }, b: { x: number; y: number; w: number; h: number }) => a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;\n        for (let i = 0; i < texts.length; i++) for (let j = i + 1; j < texts.length; j++) {\n          if (hit(texts[i].rect, texts[j].rect)) throw new Error(`${texts[i].label} overlaps ${texts[j].label} at ${w}x${h}`);\n        }\n        for (const t of L.tiles) for (const c of L.cells) {\n          const own = (t.label === \"course-chip\" && c.label === \"course\") || (t.label.startsWith(\"chip-\") && c.label === `standard-${t.label.slice(5)}`);\n          if (!own && hit(t.rect, c.rect)) throw new Error(`${c.label} overlaps ${t.label} at ${w}x${h}`);\n        }\n        // The rows keep to their band, in order, and one or two swims do not become slabs.\n        expect(L.rowH).toBeLessThanOrEqual(L.cap);\n        expect(L.rows[0].top).toBe(L.bandTop + (L.rows[0].top - L.bandTop));\n        expect(L.rows[L.rows.length - 1].top + L.rowH).toBeLessThanOrEqual(L.bandBottom);\n        // The name is the largest text; the summary is second.\n        const px = Object.fromEntries(L.cells.map((c) => [c.label, c.px]));\n        if (p === CASES[0]) {\n          expect(px.swimmer).toBeGreaterThan(px[\"summary-count\"]);\n          expect(px[\"summary-count\"]).toBeGreaterThan(px[\"event-0\"]);\n        }\n      }","numLines":50,"startLine":172,"totalLines":316}}}
