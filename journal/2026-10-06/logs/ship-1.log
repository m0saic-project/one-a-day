{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MeiCrj7HGjvDaMfAoPEygX","type":"tool_result","content":"        expect(text).toMatch(/conventions: meets 0\\.2\\.0 \\(frozen at 0\\.3\\.0\\)\\./);\n        expect(text).toMatch(/old\\/v1 shipped at 0\\.2\\.0: behind on bindingHints — not a defect/);\n        expect(text).toMatch(/✗ 1 error\\(s\\)\\. 1 lagging finding\\(s\\) on shipped templates/);\n    });\n    it(\"a manifest from before `shipped` existed: every hashed folder shipped at `release`, and a repo that only lags passes\", async () => {\n        const dir = repoWithManifest({ release: \"0.2.0\", files: { \"src/basics/old/v1/old.ts\": \"sha256:old\", \"src/_shared/util.ts\": \"sha256:util\" } });\n        dirs.push(dir);\n        const { report, exitCode } = await (0, templateDoctor_1.runTemplateDoctor)({ repoPath: dir }, depsWith(tmpl(\"old\", \"title\", false)));\n        expect(exitCode).toBe(0);\n        expect(report.ok).toBe(true);\n        expect(report.errors).toEqual([]);\n        expect(report.lagging.map((f) => f.convention)).toEqual([\"bindingHints\"]);\n        expect(report.conventions).toMatchObject({ shippedAt: \"0.2.0\", lagOnly: true, meets: \"0.2.0\" });\n        expect(report.conventions.byTemplate[0]).toMatchObject({ shippedAt: \"0.2.0\", lagging: [\"bindingHints\"] });\n        expect(report.loadDiagnostics).toEqual([]);\n        expect((0, templateDoctor_1.formatDoctorReport)(report)).toMatch(/✓ no errors\\. 1 lagging finding\\(s\\) on shipped templates — rules added after they shipped; not a defect/);\n    });\n    it(\"a rule of the template's own day is still an error on a shipped template\", async () => {\n        const dir = repoWithManifest({ release: \"0.2.0\", hashVersion: 2, shipped: { \"src/basics/bad/v1\": \"0.2.0\" }, files: { \"src/basics/bad/v1/bad.ts\": \"sha256:bad\" } });\n        dirs.push(dir);\n        const { report, exitCode } = await (0, templateDoctor_1.runTemplateDoctor)({ repoPath: dir }, depsWith(tmpl(\"bad\", \"nope\", false)));\n        expect(exitCode).toBe(1);\n        // bindingsSound is a 0.2.0 rule: shipping at 0.2.0 exempts nothing\n        expect(report.errors.map((f) => f.convention)).toContain(\"bindingsSound\");\n        expect(report.lagging.map((f) => f.convention)).not.toContain(\"bindingsSound\");\n        expect(report.conventions.byTemplate[0].shippedAt).toBe(\"0.2.0\");\n    });\n    it(\"a manifest the doctor cannot place a template in reports a load warning and holds the template to every rule\", async () => {\n        const dir = repoWithManifest({ release: \"0.3.0\", hashVersion: 2, shipped: {}, files: { \"src/basics/old/v1/old.ts\": \"sha256:old\" } });\n        dirs.push(dir);\n        const { report, exitCode } = await (0, templateDoctor_1.runTemplateDoctor)({ repoPath: dir }, depsWith(tmpl(\"old\", \"title\", false)));\n        expect(exitCode).toBe(1);\n        expect(report.loadDiagnostics).toEqual([\n            { code: \"FREEZE_MANIFEST\", severity: \"warning\", message: expect.stringMatching(/src\\/basics\\/old\\/v1 is hashed but \"shipped\" names no m0saic line/) },\n        ]);\n        expect(report.errors.map((f) => f.convention)).toEqual([\"bindingHints\"]);\n        expect(report.lagging).toEqual([]);\n        expect(report.conventions.byTemplate[0].shippedAt).toBeNull();\n    });\n});\ndescribe(\"m0saic doctor — the catalog convention (catalogSidecar, 0.3.1)\", () => {\n    const dirs = [];\n    afterAll(() => {\n        for (const d of dirs)\n            fs.rmSync(d, { recursive: true, force: true });\n    });\n    it(\"a template that describes itself in its file (label / description / tags) is an error when it has not shipped\", async () => {\n        const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"m0saic-doctor-catalog-\"));\n        dirs.push(dir);\n        const { report, exitCode } = await (0, templateDoctor_1.runTemplateDoctor)({ repoPath: dir }, depsWith(legacy(\"described\")));\n        expect(exitCode).toBe(1);\n        const f = report.errors.find((e) => e.convention === \"catalogSidecar\");\n        expect(f.templateId).toBe(\"@doctor-fixture/basics/described/v1\");\n        expect(f.violations.map((v) => v.key).sort()).toEqual([\"description\", \"label\", \"props.title.description\", \"props.title.label\", \"props.title.placeholder\", \"tags\"]);\n        expect(f.fix).toMatch(/template-catalog\\.json/);\n    });\n    it(\"the same template shipped before 0.3.1 lags the rule instead — its file can never change\", async () => {\n        const dir = repoWithManifest({ release: \"0.3.0\", hashVersion: 2, shipped: { \"src/basics/described/v1\": \"0.2.0\" }, files: { \"src/basics/described/v1/d.ts\": \"sha256:d\" } });\n        dirs.push(dir);\n        const { report, exitCode } = await (0, templateDoctor_1.runTemplateDoctor)({ repoPath: dir }, depsWith(legacy(\"described\")));\n        expect(exitCode).toBe(0);\n        expect(report.errors).toEqual([]);\n        expect(report.lagging.map((f) => f.convention)).toEqual([\"catalogSidecar\"]);\n        expect(report.conventions.byTemplate[0]).toMatchObject({ shippedAt: \"0.2.0\", lagging: [\"catalogSidecar\"], behind: [\"0.3.1\"] });\n    });\n    it(\"a catalogued template meets the rule: the loader's merge answers for the file, not the catalog\", async () => {\n        const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"m0saic-doctor-catalog-\"));\n        dirs.push(dir);\n        const { report } = await (0, templateDoctor_1.runTemplateDoctor)({ repoPath: dir }, depsWith(tmpl(\"good\", \"title\")));\n        expect(report.errors.filter((f) => f.convention === \"catalogSidecar\")).toEqual([]);\n        expect(report.errors.filter((f) => f.convention === \"browseSurface\")).toEqual([]);\n    });\n});\ndescribe(\"m0saic doctor — the repo's conventions target (repo.conventions, 0.3.1)\", () => {\n    const dirs = [];\n    afterAll(() => {\n        for (const d of dirs)\n            fs.rmSync(d, { recursive: