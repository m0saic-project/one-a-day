572e\").map((t) => t.label)).size).toBeGreaterThan(0);\n    expect(L.tiles.filter((t) => t.color === \"#e4572e\").every((t) => /pace-marker|percentile-chip|header-rule|stat-divider/.test(t.label))).toBe(true);\n    expect(L.tiles.filter((t) => t.color !== \"#e4572e\" && !/track|tick/.test(t.label)).map((t) => t.label)).toEqual([]);\n    // The chip text is the readable ink over the accent, not the dim chrome.\n    const chipText = L.cells.find((c) => c.label === \"percentile\")!;\n    expect(chipText.color === \"#0b1220\" || chipText.color === \"#ffffff\").toBe(true);\n  });","lineStart":220,"lineEnd":259,"totalLines":323,"truncated":true}},"title":"src\\sports\\erg-pb-card\\v1\\erg-pb-card.test.ts","time":{"start":1792416414703,"end":1792416414744}},"metadata":{"openai":{"itemId":"fc_7afef9b3-c914-92a3-aabc-edb527ecfdc0_0"}},"id":"prt_15457fbe7001cGqmGzRUIwe6Mq","sessionID":"ses_eabad0e61ffeMfJmuPCNFqL7sc","messageID":"msg_15456344a001ue7GZ9tqfJfZDW"}}
