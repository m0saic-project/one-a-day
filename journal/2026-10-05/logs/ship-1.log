{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P9x8tLEgZw5Z71MEV2VVda","type":"tool_result","content":"1\timport type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\n2\timport { asTemplateId } from \"@m0saic/types\";\n3\timport { toM0String } from \"@m0saic/dsl-stdlib\";\n4\timport { bindProp, bindPropPath, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\n5\timport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\n6\timport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n7\timport { budget, textCell, widthOf } from \"../../../_shared/text\";\n8\timport { whyTutorial } from \"../../../_shared/why\";\n9\timport type { WhySpec } from \"../../../_shared/why\";\n10\t\n11\t/**\n12\t * `@one-a-day/music/radio-top-30-chart/v1` - a radio station's weekly chart\n13\t * as one card: the station, a computed `TOP 30`, the week, and every row as\n14\t * rank / artist / title / label, from the lines a music director already\n15\t * types (`Artist | Title | Label | last week`).\n16\t *\n17\t * ONE CONCEPT: the fit rule is the template. A row is two lines (the artist,\n18\t * bold; then the title with the label after it in dimmer ink), every row cell\n19\t * is the same size, and thirty rows share one artist size and one title size\n20\t * so the columns read as columns. Long copy goes down a ladder, in this\n21\t * order:\n22\t *   1. the shared sizes come down together, by at most 15%, for every line\n23\t *      that can be fitted inside that allowance;\n24\t *   2. a line that needs more shrinks ALONE, to no less than half its cap,\n25\t *      and costs the other rows nothing;\n26\t *   3. past that the render refuses, naming the row and the canvas. No\n27\t *      ellipsis, no clipping, no dropped label.\n28\t * The grid follows the aspect: up to 10 rows a column on a wide canvas\n29\t * (3 x 10), up to 15 on a square or portrait one (2 x 15); ranks read down a\n30\t * column, then the next.\n31\t *\n32\t * The rule that bites: nothing here is typed twice. The rank is the position\n33\t * in the list, the count in the title is the number of rows, and the marker\n34\t * under a rank is last week's rank minus this week's (`+3`, `-2`, `=`, `NEW`,\n35\t * `RE`), as text: the bundled font has no arrows, and up is the accent, down\n36\t * is dim ink, never red or green. Sizes are fractions of the canvas with no\n37\t * pixel floor, so a 480x270 render is a thumbnail of the 1920x1080 one, not a\n38\t * different card.\n39\t */\n40\t\n41\texport type RadioTop30ChartProps = {\n42\t  /** The header mark: call sign and frequency, free text. */\n43\t  station?: string;\n44\t  /** The line under the station. \"\" removes it. */\n45\t  weekOf?: string;\n46\t  /** Prefix of the chart title: \"Loud Rock\" gives LOUD ROCK TOP 10. \"\" gives TOP 30. */\n47\t  genre?: string;\n48\t  /** The chart, in rank order: 1-30 lines of \"Artist | Title | Label\" or \"Artist | Title | Label | LW\". */\n49\t  rows?: string[];\n50\t  /** The bottom line: a URL, a credit. \"\" removes the line. */\n51\t  footer?: string;\n52\t  /** Rank numerals, the chart title, up / NEW / RE markers, as #rrggbb. */\n53\t  accent?: string;\n54\t  /** Page and ink. */\n55\t  preset?: \"dark\" | \"light\";\n56\t  /** Rank 1 as a full-width lead row above the grid. */\n57\t  lead?: boolean;\n58\t  /** Dev-only: check the layout contract and draw it over the card. */\n59\t  debugLayout?: boolean;\n60\t};\n61\t\n62\tconst ID = \"@one-a-day/music/radio-top-30-chart/v1\";\n63\tconst DEFAULT_ACCENT = \"#ff3d9a\";\n64\tconst THEMES = {\n65\t  dark: { bg: \"#131117\", row: \"#1e1b25\", ink: \"#f4f2f6\", dim: \"#a09bab\" },\n66\t  light: { bg: \"#f1eee7\", row: \"#fffdf9\", ink: \"#18151c\", dim: \"#6b6674\" },\n67\t} as const;\n68\t\n69\t// An invented station and an invented chart. 91.6 is an even-tenth frequency,\n70\t// which is not a US FM channel, so the default cannot be mistaken for a real\n71\t// station's chart. Row 7's title is 53 characters on purpose: it is the row\n72\t// that shows what the fit ladder does.\n73\tconst DEFAULT_ROWS = [\n74\t  \"Paper Lanterns | Night Bus Home | Tidewater | 2\",\n75\t  \"Glass Orchard | Slow Weather | Half Moon Recordings | 1\",\n76\t  \"The Marigolds | Kitchen Radio | Fern & Flint | 5\",\n77\t  \"Delta Kiosk | Parking Lot Hymns | Low Tide | 4\",\n78\t  'Nora Vance | \"Blue Receipt\" [Single] | Self-Released | NEW',\n79\t  \"Static Bloom | Greenhouse | Tidewater | 3\",\n80\t  \"Hollow Pines | A Field Guide to Leaving Early Without Saying Goodbye | Brass Key | 12\",\n81\t  \"Juno Park | Soft Machines [EP] | Night Shift | 6\",\n82\t  \"Cardigan Sea | Postcards | Half Moon Recordings | 9\",\n83\t  \"Vera & the Lowlights | Last Call | Brass Key | 15\",\n84\t  \"Mothwing | Porchlight | Fern & Flint | 8\",\n85\t  \"Tall Grass Choir | Everything Is Fine Here | Low Tide | NEW\",\n86\t  \"Okapi | Signal Hill | Night Shift | 7\",\n87\t  \"Rosa Calloway | Late Bloomer | Tidewater | 10\",\n88\t  \"Sunday Arcade | High Score [EP] | Self-Released | 22\",\n89\t  \"The Understudies | Second String | Brass Key | 11\",\n90\t  \"Pilot Light | Embers | Low Tide | 13\",\n91\t  \"Ferris | Midway | Half Moon Recordings | RE\",\n92\t  \"Lakehouse Tapes | Volume Two | Self-Released | 14\",\n93\t  'Anya Brook | \"Cold Coffee\" [Single] | Fern & Flint | NEW',\n94\t  \"Quiet Motors | Idle | Night Shift | 16\",\n95\t  \"Marble Run | Gravity Songs | Tidewater | 19\",\n96\t  \"The Night Clerks | Room 12 | Brass Key | 17\",\n97\t  \"Wren Abbott | Small Hours | Low Tide | 27\",\n98\t  \"Copper Wire | Loose Ends | Half Moon Recordings | 18\",\n99\t  \"Day Camp | Bug Juice | Self-Released | 20\",\n100\t  \"Sister Static | AM Gold | Night Shift | 30\",\n101\t  \"Halloway | Winter Coat | Fern & Flint | 21\",\n102\t  \"Plum Street | Corner Store | Tidewater | NEW\",\n103\t  \"The Long Weekend | Monday | Brass Key | 24\",\n104\t];\n105\t\n106\tconst DEFAULTS = {\n107\t  station: \"KOAD 91.6 FM\",\n108\t  weekOf: \"Week of Oct 6, 2026\",\n109\t  genre: \"\",\n110\t  rows: DEFAULT_ROWS,\n111\t  footer: \"Sample chart: artists, titles and labels are invented\",\n112\t  accent: DEFAULT_ACCENT,\n113\t  preset: \"dark\" as \"dark\" | \"light\",\n114\t  lead: false,\n115\t  debugLayout: false,\n116\t};\n117\t\n118\tconst propsSchema = definePropsSchema<RadioTop30ChartProps>({\n119\t  rows: {\n120\t    type: \"json\",\n121\t    required: false,\n122\t    description:\n123\t      'The chart in rank order, 1 to 30 lines, each \"Artist | Title | Label\" or \"Artist | Title | Label | LW\". LW is last week\\'s rank (1-200), NEW, RE, or empty for no marker on that row. The rank is the position in the list and the count sets the title (TOP 30, TOP 10); the card does not sort or re-rank. NACC conventions such as \"Title\" [Single] and Title [EP] pass through as typed.',\n124\t    meta: {\n125\t      constraints: { jsonSchema: { type: \"array\", minItems: 1, maxItems: 30, items: { type: \"string\" } } },\n126\t      ui: { label: \"Chart rows\", order: 1, primary: true },\n127\t    },\n128\t  },\n129\t  station: {\n130\t    type: \"string\",\n131\t    required: false,\n132\t    description: 'The header mark: call sign and frequency, free text, 1 to 32 characters (\"WXYZ 90.1 FM\"). The sample station is invented.',\n133\t    meta: { control: { placeholder: DEFAULTS.station }, ui: { label: \"Station\", order: 2 } },\n134\t  },\n135\t  weekOf: {\n136\t    type: \"string\",\n137\t    required: false,\n138\t    description: \"The line under the station, free text (no date parsing), up to 48 characters. Empty removes it.\",\n139\t    meta: { control: { placeholder: DEFAULTS.weekOf }, ui: { label: \"Week of\", order: 3 } },\n140\t  },\n141\t  genre: {\n142\t    type: \"string\",\n143\t    required: false,\n144\t    description: 'A prefix for the chart title, up to 24 characters: \"Loud Rock\" with ten rows gives LOUD ROCK TOP 10. Empty gives TOP 30.',\n145\t    meta: { control: { placeholder: \"Loud Rock\" }, ui: { label: \"Genre\", order: 4 } },\n146\t  },\n147\t  footer: {\n148\t    type: \"string\",\n149\t    required: false,\n150\t    description: 'The bottom line, up to 90 characters: the station\\'s URL, \"As reported to NACC\". Empty removes the line.',\n151\t    meta: { control: { placeholder: DEFAULTS.footer }, ui: { label: \"Footer\", order: 5 } },\n152\t  },\n153\t  lead: {\n154\t    type: \"boolean\",\n155\t    required: false,\n156\t    description: \"Rank 1 leaves the grid and becomes a full-width lead row under the header; ranks 2 and up fill the grid.\",\n157\t    meta: { ui: { label: \"Lead row for #1\", order: 6 } },\n158\t  },\n159\t  accent: {\n160\t    type: \"string\",\n161\t    required: false,\n162\t    description: \"The rank numerals, the chart title, the header rule and the up / NEW / RE markers, as #rrggbb. On the light page a pale accent is darkened until it reads.\",\n163\t    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 7 } },\n164\t  },\n165\t  preset: {\n166\t    type: \"string\",\n167\t    required: false,\n168\t    description: 'Page and ink: \"dark\" (default) or \"light\".',\n169\t    meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 8 } },\n170\t  },\n171\t  debugLayout: {\n172\t    type: \"boolean\",\n173\t    required: false,\n174\t    description: \"Dev-only: check the layout contract (every text fits its box, the header and footer sit in their bands, every row has a cell and the cells are one size) and draw it over the card.\",\n175\t    meta: { ui: { label: \"Debug layout\", order: 99 } },\n176\t  },\n177\t});\n178\t\n179\t/* ── the chart: pure, exported, and what the test asserts ── */\n180\t\n181\tfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n182\t\n183\t/**\n184\t * Printable ASCII plus the accented Latin letters (Latin-1 and Latin\n185\t * Extended-A, U+00C0-U+017F without the two maths signs): the bundled font\n186\t * has a glyph for every one of them in both weights. Anything else is refused\n187\t * by name instead of rendering as tofu.\n188\t */\n189\tconst DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\n190\tfunction text(value: unknown, field: string, max: number): string {\n191\t  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n192\t  if (!DRAWN.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII and accented Latin letters (U+00C0-U+017F).`);\n193\t  const s = value.trim();\n194\t  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card takes at most ${max}.`);\n195\t  return s;\n196\t}\n197\t\n198\texport type RadioChartMove = \"up\" | \"down\" | \"same\" | \"new\" | \"re\";\n199\texport type RadioChartRow = {\n200\t  rank: number;\n201\t  artist: string;\n202\t  title: string;\n203\t  label: string;\n204\t  /** \"+3\", \"-2\", \"=\", \"NEW\", \"RE\"; \"\" when the line has no last-week field. */\n205\t  marker: string;\n206\t  move: RadioChartMove | null;\n207\t};\n208\t\n209\t/** One chart line, \"Artist | Title | Label\" or \"Artist | Title | Label | LW\", at list position `index` (rank index + 1). */\n210\texport function parseRadioChartRow(raw: unknown, index: number): RadioChartRow {\n211\t  const rank = index + 1;\n212\t  const at = `rows[${index}] (line ${rank})`;\n213\t  const line = text(raw, at, 240);\n214\t  const f = line.split(\"|\").map((s) => s.trim());\n215\t  if (f.length < 3 || f.length > 4) {\n216\t    fail(at, `${JSON.stringify(line)} has ${f.length} field${f.length === 1 ? \"\" : \"s\"} between \"|\"; write \"Artist | Title | Label\" or \"Artist | Title | Label | LW\" (a \"|\" inside a name cannot be written).`);\n217\t  }\n218\t  const [artist, title, label] = f;\n219\t  ([\"artist\", \"title\", \"label\"] as const).forEach((name, k) => {\n220\t    if (f[k] === \"\") fail(at, `has an empty ${name}; a chart row carries an artist, a title and a label.`);\n221\t    const max = name === \"label\" ? 40 : 80;\n222\t    if (f[k].length > max) fail(at, `${name} is ${f[k].length} characters; the card takes at most ${max}.`);\n223\t  });\n224\t  const lw = (f[3] ?? \"\").toUpperCase();\n225\t  let marker = \"\", move: RadioChartMove | null = null;\n226\t  if (lw === \"NEW\") { marker = \"NEW\"; move = \"new\"; }\n227\t  else if (lw === \"RE\") { marker = \"RE\"; move = \"re\"; }\n228\t  else if (lw !== \"\") {\n229\t    const n = /^\\d{1,3}$/.test(lw) ? Number(lw) : NaN;\n230\t    if (!(n >= 1 && n <= 200)) fail(at, `last week ${JSON.stringify(f[3])} must be a rank from 1 to 200, NEW, RE, or empty.`);\n231\t    const d = n - rank;\n232\t    marker = d > 0 ? `+${d}` : d < 0 ? `-${-d}` : \"=\";\n233\t    move = d > 0 ? \"up\" : d < 0 ? \"down\" : \"same\";\n234\t  }\n235\t  return { rank, artist, title, label, marker, move };\n236\t}\n237\t\n238\texport type RadioChart = ReturnType<typeof normalizeRadioChart>;\n239\t\n240\t/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n241\texport function normalizeRadioChart(props: RadioTop30ChartProps) {\n242\t  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n243\t  const station = text(p.station, \"station\", 32);\n244\t  if (station === \"\") fail(\"station\", \"is empty; the card is headed by the station (call sign and frequency).\");\n245\t  const weekOf = text(p.weekOf, \"weekOf\", 48);\n246\t  const genre = text(p.genre, \"genre\", 24);\n247\t  const footer = text(p.footer, \"footer\", 90);\n248\t  if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n249\t  if (typeof p.accent !== \"string\" || !/^#[0-9a-fA-F]{6}$/.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n250\t  if (typeof p.lead !== \"boolean\") fail(\"lead\", \"must be a boolean.\");\n251\t  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n252\t  if (!Array.isArray(p.rows)) fail(\"rows\", 'must be a list of chart lines (\"Artist | Title | Label\").');\n253\t  if (p.rows.length < 1) fail(\"rows\", \"is empty; a chart needs at least one line.\");\n254\t  if (p.rows.length > 30) fail(\"rows\", `has ${p.rows.length} lines; a station chart is 30, and a longer list needs a second card.`);\n255\t  const rows = p.rows.map((r, i) => parseRadioChartRow(r, i));\n256\t  return {\n257\t    station, weekOf, genre, footer, rows,\n258\t    /** Computed from the rows, never typed, so the title cannot contradict the list. */\n259\t    chartTitle: `${genre === \"\" ? \"\" : `${genre.toUpperCase()} `}TOP ${rows.length}`,\n260\t    hasMarkers: rows.some((r) => r.marker !== \"\"),\n261\t    accent: p.accent.trim().toLowerCase() as MosaicColor,\n262\t    preset: p.preset as \"dark\" | \"light\", lead: p.lead, debugLayout: p.debugLayout,\n263\t  };\n264\t}\n265\t\n266\t/* ── colour ── */\n267\t\n268\t// Not exported: the repo index is `export *`, and other templates export a `mix`.\n269\tfunction mix(a: string, b: string, t: number): MosaicColor {\n270\t  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n271\t  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n272\t  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n273\t}\n274\tfunction luminance(hex: string): number {\n275\t  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n276\t  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n277\t}\n278\tfunction contrast(a: string, b: string): number {\n279\t  const x = luminance(a), y = luminance(b);\n280\t  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);\n281\t}\n282\t/** The accent as INK on a row: itself when it reads there, otherwise pulled toward the page's ink until it does. */\n283\tfunction accentInk(accent: string, on: string, ink: string): MosaicColor {\n284\t  let t = 0;\n285\t  while (t < 0.6 && contrast(mix(accent, ink, t), on) < 3.6) t += 0.1;\n286\t  return mix(accent, ink, t);\n287\t}\n288\t\n289\t/* ── geometry ── */\n290\t\n291\t/** The shared sizes may come down by this much for the lines that can be caught; a line that needs more shrinks alone. */\n292\texport const RADIO_CHART_SHARED_FLOOR = 0.85;\n293\t/** A line alone goes no lower than this fraction of its cap; past it the render refuses. */\n294\texport const RADIO_CHART_ALONE_FLOOR = 0.5;\n295\t/** The lead row (`lead: true`) is this many grid rows tall. */\n296\tconst LEAD_ROWS = 1.7;\n297\t\n298\texport type RadioChartRect = { x: number; y: number; w: number; h: number };\n299\ttype Bind = \"station\" | \"weekOf\" | \"footer\" | \"genre\" | null;\n300\ttype Cell = { label: string; rect: RadioChartRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; row: number | null };"}]},"parent_tool_use_id":null,"session_id":"c0c5478d-b8b8-4c4e-a5d2-3efdbb764255","uuid":"16ced587-dfca-4f6d-8c63-4084a78812c1","timestamp":"2026-10-05T13:53:47.012Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\music\\radio-top-30-chart\\v1\\radio-top-30-chart.ts","content":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, bindPropPath, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/music/radio-top-30-chart/v1` - a radio station's weekly chart\n * as one card: the station, a computed `TOP 30`, the week, and every row as\n * rank / artist / title / label, from the lines a music director already\n * types (`Artist | Title | Label | last week`).\n *\n * ONE CONCEPT: the fit rule is the template. A row is two lines (the artist,\n * bold; then the title with the label after it in dimmer ink), every row cell\n * is the same size, and thirty rows share one artist size and one title size\n * so the columns read as columns. Long copy goes down a ladder, in this\n * order:\n *   1. the shared sizes come down together, by at most 15%, for every line\n *      that can be fitted inside that allowance;\n *   2. a line that needs more shrinks ALONE, to no less than half its cap,\n *      and costs the other rows nothing;\n *   3. past that the render refuses, naming the row and the canvas. No\n *      ellipsis, no clipping, no dropped label.\n * The grid follows the aspect: up to 10 rows a column on a wide canvas\n * (3 x 10), up to 15 on a square or portrait one (2 x 15); ranks read down a\n * column, then the next.\n *\n * The rule that bites: nothing here is typed twice. The rank is the position\n * in the list, the count in the title is the number of rows, and the marker\n * under a rank is last week's rank minus this week's (`+3`, `-2`, `=`, `NEW`,\n * `RE`), as text: the bundled font has no arrows, and up is the accent, down\n * is dim ink, never red or green. Sizes are fractions of the canvas with no\n * pixel floor, so a 480x270 render is a thumbnail of the 1920x1080 one, not a\n * different card.\n */\n\nexport type RadioTop30ChartProps = {\n  /** The header mark: call sign and frequency, free text. */\n  station?: string;\n  /** The line under the station. \"\" removes it. */\n  weekOf?: string;\n  /** Prefix of the chart title: \"Loud Rock\" gives LOUD ROCK TOP 10. \"\" gives TOP 30. */\n  genre?: string;\n  /** The chart, in rank order: 1-30 lines of \"Artist | Title | Label\" or \"Artist | Title | Label | LW\". */\n  rows?: string[];\n  /** The bottom line: a URL, a credit. \"\" removes the line. */\n  footer?: string;\n  /** Rank numerals, the chart title, up / NEW / RE markers, as #rrggbb. */\n  accent?: string;\n  /** Page and ink. */\n  preset?: \"dark\" | \"light\";\n  /** Rank 1 as a full-width lead row above the grid. */\n  lead?: boolean;\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/music/radio-top-30-chart/v1\";\nconst DEFAULT_ACCENT = \"#ff3d9a\";\nconst THEMES = {\n  dark: { bg: \"#131117\", row: \"#1e1b25\", ink: \"#f4f2f6\", dim: \"#a09bab\" },\n  light: { bg: \"#f1eee7\", row: \"#fffdf9\", ink: \"#18151c\", dim: \"#6b6674\" },\n} as const;\n\n// An invented station and an invented chart. 91.6 is an even-tenth frequency,\n// which is not a US FM channel, so the default cannot be mistaken for a real\n// station's chart. Row 7's title is 53 characters on purpose: it is the row\n// that shows what the fit ladder does.\nconst DEFAULT_ROWS = [\n  \"Paper Lanterns | Night Bus Home | Tidewater | 2\",\n  \"Glass Orchard | Slow Weather | Half Moon Recordings | 1\",\n  \"The Marigolds | Kitchen Radio | Fern & Flint | 5\",\n  \"Delta Kiosk | Parking Lot Hymns | Low Tide | 4\",\n  'Nora Vance | \"Blue Receipt\" [Single] | Self-Released | NEW',\n  \"Static Bloom | Greenhouse | Tidewater | 3\",\n  \"Hollow Pines | A Field Guide to Leaving Early Without Saying Goodbye | Brass Key | 12\",\n  \"Juno Park | Soft Machines [EP] | Night Shift | 6\",\n  \"Cardigan Sea | Postcards | Half Moon Recordings | 9\",\n  \"Vera & the Lowlights | Last Call | Brass Key | 15\",\n  \"Mothwing | Porchlight | Fern & Flint | 8\",\n  \"Tall Grass Choir | Everything Is Fine Here | Low Tide | NEW\",\n  \"Okapi | Signal Hill | Night Shift | 7\",\n  \"Rosa Calloway | Late Bloomer | Tidewater | 10\",\n  \"Sunday Arcade | High Score [EP] | Self-Released | 22\",\n  \"The Understudies | Second String | Brass Key | 11\",\n  \"Pilot Light | Embers | Low Tide | 13\",\n  \"Ferris | Midway | Half Moon Recordings | RE\",\n  \"Lakehouse Tapes | Volume Two | Self-Released | 14\",\n  'Anya Brook | \"Cold Coffee\" [Single] | Fern & Flint | NEW',\n  \"Quiet Motors | Idle | Night Shift | 16\",\n  \"Marble Run | Gravity Songs | Tidewater | 19\",\n  \"The Night Clerks | Room 12 | Brass Key | 17\",\n  \"Wren Abbott | Small Hours | Low Tide | 27\",\n  \"Copper Wire | Loose Ends | Half Moon Recordings | 18\",\n  \"Day Camp | Bug Juice | Self-Released | 20\",\n  \"Sister Static | AM Gold | Night Shift | 30\",\n  \"Halloway | Winter Coat | Fern & Flint | 21\",\n  \"Plum Street | Corner Store | Tidewater | NEW\",\n  \"The Long Weekend | Monday | Brass Key | 24\",\n];\n\nconst DEFAULTS = {\n  station: \"KOAD 91.6 FM\",\n  weekOf: \"Week of Oct 6, 2026\",\n  genre: \"\",\n  rows: DEFAULT_ROWS,\n  footer: \"Sample chart: artists, titles and labels are invented\",\n  accent: DEFAULT_ACCENT,\n  preset: \"dark\" as \"dark\" | \"light\",\n  lead: false,\n  debugLayout: false,\n};\n\nconst propsSchema = definePropsSchema<RadioTop30ChartProps>({\n  rows: {\n    type: \"json\",\n    required: false,\n    description:\n      'The chart in rank order, 1 to 30 lines, each \"Artist | Title | Label\" or \"Artist | Title | Label | LW\". LW is last week\\'s rank (1-200), NEW, RE, or empty for no marker on that row. The rank is the position in the list and the count sets the title (TOP 30, TOP 10); the card does not sort or re-rank. NACC conventions such as \"Title\" [Single] and Title [EP] pass through as typed.',\n    meta: {\n      constraints: { jsonSchema: { type: \"array\", minItems: 1, maxItems: 30, items: { type: \"string\" } } },\n      ui: { label: \"Chart rows\", order: 1, primary: true },\n    },\n  },\n  station: {\n    type: \"string\",\n    required: false,\n    description: 'The header mark: call sign and frequency, free text, 1 to 32 characters (\"WXYZ 90.1 FM\"). The sample station is invented.',\n    meta: { control: { placeholder: DEFAULTS.station }, ui: { label: \"Station\", order: 2 } },\n  },\n  weekOf: {\n    type: \"string\",\n    required: false,\n    description: \"The line under the station, free text (no date parsing), up to 48 characters. Empty removes it.\",\n    meta: { control: { placeholder: DEFAULTS.weekOf }, ui: { label: \"Week of\", order: 3 } },\n  },\n  genre: {\n    type: \"string\",\n    required: false,\n    description: 'A prefix for the chart title, up to 24 characters: \"Loud Rock\" with ten rows gives LOUD ROCK TOP 10. Empty gives TOP 30.',\n    meta: { control: { placeholder: \"Loud Rock\" }, ui: { label: \"Genre\", order: 4 } },\n  },\n  footer: {\n    type: \"string\",\n    required: false,\n    description: 'The bottom line, up to 90 characters: the station\\'s URL, \"As reported to NACC\". Empty removes the line.',\n    meta: { control: { placeholder: DEFAULTS.footer }, ui: { label: \"Footer\", order: 5 } },\n  },\n  lead: {\n    type: \"boolean\",\n    required: false,\n    description: \"Rank 1 leaves the grid and becomes a full-width lead row under the header; ranks 2 and up fill the grid.\",\n    meta: { ui: { label: \"Lead row for #1\", order: 6 } },\n  },\n  accent: {\n    type: \"string\",\n    required: false,\n    description: \"The rank numerals, the chart title, the header rule and the up / NEW / RE markers, as #rrggbb. On the light page a pale accent is darkened until it reads.\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 7 } },\n  },\n  preset: {\n    type: \"string\",\n    required: false,\n    description: 'Page and ink: \"dark\" (default) or \"light\".',\n    meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 8 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits its box, the header and footer sit in their bands, every row has a cell and the cells are one size) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n/* ── the chart: pure, exported, and what the test asserts ── */\n\nfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n\n/**\n * Printable ASCII plus the accented Latin letters (Latin-1 and Latin\n * Extended-A, U+00C0-U+017F without the two maths signs): the bundled font\n * has a glyph for every one of them in both weights. Anything else is refused\n * by name instead of rendering as tofu.\n */\nconst DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\nfunction text(value: unknown, field: string, max: number): string {\n  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n  if (!DRAWN.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII and accented Latin letters (U+00C0-U+017F).`);\n  const s = value.trim();\n  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card takes at most ${max}.`);\n  return s;\n}\n\nexport type RadioChartMove = \"up\" | \"down\" | \"same\" | \"new\" | \"re\";\nexport type RadioChartRow = {\n  rank: number;\n  artist: string;\n  title: string;\n  label: string;\n  /** \"+3\", \"-2\", \"=\", \"NEW\", \"RE\"; \"\" when the line has no last-week field. */\n  marker: string;\n  move: RadioChartMove | null;\n};\n\n/** One chart line, \"Artist | Title | Label\" or \"Artist | Title | Label | LW\", at list position `index` (rank index + 1). */\nexport function parseRadioChartRow(raw: unknown, index: number): RadioChartRow {\n  const rank = index + 1;\n  const at = `rows[${index}] (line ${rank})`;\n  const line = text(raw, at, 240);\n  const f = line.split(\"|\").map((s) => s.trim());\n  if (f.length < 3 || f.length > 4) {\n    fail(at, `${JSON.stringify(line)} has ${f.length} field${f.length === 1 ? \"\" : \"s\"} between \"|\"; write \"Artist | Title | Label\" or \"Artist | Title | Label | LW\" (a \"|\" inside a name cannot be written).`);\n  }\n  const [artist, title, label] = f;\n  ([\"artist\", \"title\", \"label\"] as const).forEach((name, k) => {\n    if (f[k] === \"\") fail(at, `has an empty ${name}; a chart row carries an artist, a title and a label.`);\n    const max = name === \"label\" ? 40 : 80;\n    if (f[k].length > max) fail(at, `${name} is ${f[k].length} characters; the card takes at most ${max}.`);\n  });\n  const lw = (f[3] ?? \"\").toUpperCase();\n  let marker = \"\", move: RadioChartMove | null = null;\n  if (lw === \"NEW\") { marker = \"NEW\"; move = \"new\"; }\n  else if (lw === \"RE\") { marker = \"RE\"; move = \"re\"; }\n  else if (lw !== \"\") {\n    const n = /^\\d{1,3}$/.test(lw) ? Number(lw) : NaN;\n    if (!(n >= 1 && n <= 200)) fail(at, `last week ${JSON.stringify(f[3])} must be a rank from 1 to 200, NEW, RE, or empty.`);\n    const d = n - rank;\n    marker = d > 0 ? `+${d}` : d < 0 ? `-${-d}` : \"=\";\n    move = d > 0 ? \"up\" : d < 0 ? \"down\" : \"same\";\n  }\n  return { rank, artist, title, label, marker, move };\n}\n\nexport type RadioChart = ReturnType<typeof normalizeRadioChart>;\n\n/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\nexport function normalizeRadioChart(props: RadioTop30ChartProps) {\n  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n  const station = text(p.station, \"station\", 32);\n  if (station === \"\") fail(\"station\", \"is empty; the card is headed by the station (call sign and frequency).\");\n  const weekOf = text(p.weekOf, \"weekOf\", 48);\n  const genre = text(p.genre, \"genre\", 24);\n  const footer = text(p.footer, \"footer\", 90);\n  if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n  if (typeof p.accent !== \"string\" || !/^#[0-9a-fA-F]{6}$/.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n  if (typeof p.lead !== \"boolean\") fail(\"lead\", \"must be a boolean.\");\n  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n  if (!Array.isArray(p.rows)) fail(\"rows\", 'must be a list of chart lines (\"Artist | Title | Label\").');\n  if (p.rows.length < 1) fail(\"rows\", \"is empty; a chart needs at least one line.\");\n  if (p.rows.length > 30) fail(\"rows\", `has ${p.rows.length} lines; a station chart is 30, and a longer list needs a second card.`);\n  const rows = p.rows.map((r, i) => parseRadioChartRow(r, i));\n  return {\n    station, weekOf, genre, footer, rows,\n    /** Computed from the rows, never typed, so the title cannot contradict the list. */\n    chartTitle: `${genre === \"\" ? \"\" : `${genre.toUpperCase()} `}TOP ${rows.length}`,\n    hasMarkers: rows.some((r) => r.marker !== \"\"),\n    accent: p.accent.trim().toLowerCase() as MosaicColor,\n    preset: p.preset as \"dark\" | \"light\", lead: p.lead, debugLayout: p.debugLayout,\n  };\n}\n\n/* ── colour ── */\n\n// Not exported: the repo index is `export *`, and other templates export a `mix`.\nfunction mix(a: string, b: string, t: number): MosaicColor {\n  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n}\nfunction luminance(hex: string): number {\n  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n}\nfunction contrast(a: string, b: string): number {\n  const x = luminance(a), y = luminance(b);\n  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);\n}\n/** The accent as INK on a row: itself when it reads there, otherwise pulled toward the page's ink until it does. */\nfunction accentInk(accent: string, on: string, ink: string): MosaicColor {\n  let t = 0;\n  while (t < 0.6 && contrast(mix(accent, ink, t), on) < 3.6) t += 0.1;\n  return mix(accent, ink, t);\n}\n\n/* ── geometry ── */\n\n/** The shared sizes may come down by this much for the lines that can be caught; a line that needs more shrinks alone. */\nexport const RADIO_CHART_SHARED_FLOOR = 0.85;\n/** A line alone goes no lower than this fraction of its cap; past it the render refuses. */\nexport const RADIO_CHART_ALONE_FLOOR = 0.5;\n/** The lead row (`lead: true`) is this many grid rows tall. */\nconst LEAD_ROWS = 1.7;\n\nexport type RadioChartRect = { x: number; y: number; w: number; h: number };\ntype Bind = \"station\" | \"weekOf\" | \"footer\" | \"genre\" | null;\ntype Cell = { label: string; rect: RadioChartRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; row: number | null };","numLines":300,"startLine":1,"totalLines":632}}}
