"How do I create an image of my deck to share on social media?\\\"; TopDeck.gg sells 16:9 deck images \\\"perfect for: Social media bragging rights - Share your 4-0 tournament deck\\\"; DeckPassport: \\\"No more walls of text to explain your deck. Just share the card.\\\"\"\n592:   ],\n593:   \"sources\": [\n594:     \"https://mythichub.com/blog/turn-a-boring-decklist-into-an-awesome-image\",\n595:     \"https://mythichub.com/deck-spotlight\",\n596:     \"https://archidekt.com/faq\",\n597:     \"https://overpower.topdeck.gg/blog/visual-deck-display-20250626\",\n598:     \"https://github.com/YohannBethoule/DeckPassport\"\n599:   ],\n600:   \"solution\": [\n601:     \"One card per deck from the fields a builder export already shows: deck name, commander, colour identity, bracket and record, the eight-bucket mana curve, 3-6 highlight cards and the plan one-liner. Deterministic, so a game-night lineup or a top-8 is one CLI loop.\",\n602:     \"The one decision: the curve never lies. AVG MV and the spell count are COMPUTED from the buckets (179/63 = 2.84 at defaults), never typed, and the bars are height-proportional to the counts with the tallest filling the plot - the card cannot disagree with itself.\"\n603:   ],\n604:   \"usage\": {\n605:     \"command\": \"m0saic make @one-a-day/gaming/commander-deck-spotlight/v1 --template-repo . -w 1920 -h 1080 -o journal/2026-10-16/commander-deck-spotlight.png\",\n606:     \"try\": [\n607:       \"curve: 8 counts for MV 0..7+; AVG MV and the spell count follow the buckets\",\n608:       \"highlights: 3-6 rows of { name, note, qty } - the cards you would paste in chat\",\n609:       \"manaIdentity \\\"UB\\\" drops the chips to two; \\\"\\\" removes the chip row entirely\",\n610:       \"-w 1080 -h 1920 for the phone view: the body stacks, curve over highlights\"\n611:     ]\n612:   },\n613:   \"caveats\": [\n614:     \"No card art, no network: every existing tool puts Scryfall art at the center and a member may ask \\\"where's my commander's art?\\\" - this demo is rectangles and numbers only.\",\n615:     \"Mana values and bracket are not in the raw export lines; the player reads them off the builder UI and passes them as props.\",\n616:     \"A 100-card list cannot fit: 3-6 highlight rows is the digest the ecosystem converged on, not a full decklist.\"\n617:   ],\n618:   \"timeline\": {\n619:     \"source\": \"runner\",\n620:     \"phases\": [\n621:       {\n622:         \"name\": \"scout\",\n623:         \"startMs\": 0,\n624:         \"durMs\": 628558,\n625:         \"calls\": 23,\n626:         \"tokens\": 833417,\n627:         \"costUsd\": 0.06,\n628:         \"tools\": \"bash 16, websearch 5, write 2\"\n629:       },\n630:       {\n631:         \"name\": \"plan\",\n632:         \"startMs\": 628579,\n633:         \"durMs\": 484895,\n634:         \"calls\": 26,\n635:         \"tokens\": 701093,\n636:         \"costUsd\": 0.04,\n637:         \"tools\": \"bash 22, grep 3, write 1\"\n638:       }\n639:     ],\n640:     \"costBasis\": \"reported\"\n641:   }\n642: };\n643: \n644: export const CommanderDeckSpotlightV1 = defineMosaicTemplate<CommanderDeckSpotlightProps>({\n645:   id: asTemplateId(ID),\n646:   label: \"2026-10-16 · Commander Deck Spotlight Card\",\n647:   version: 1,\n648:   description: \"A Magic Commander/EDH deck as one share card from the decklist fields themselves: kicker, bracket and record pills, deck name, commander line with WUBRG mana chips, an eight-bar mana curve with derived AVG MV and spell count, 3-6 highlight rows and the plan one-liner.\",\n649:   capabilities: { tier: \"core\" },\n650:   tags: [\"gaming\", \"2026-10-16\", \"day-027\", \"mtg\", \"commander\", \"edh\", \"decklist\", \"deck-tech\", \"share-card\"],\n651: \n652:   outputHints: {\n653:     width: 1920,\n654:     height: 1080,\n655:     fps: 30,\n656:     durationMs: 2000,\n657:     format: { kind: \"image\", container: \"png\" },\n658:     note: \"Still PNG. Landscape runs curve and highlights side by side; portrait stacks them in the same bands; square reads as landscape. Minimum tested canvas 480x270.\",\n659:   },\n660: \n661:   propsSchema,\n662:   defaultProps: DEFAULTS,\n663: \n664:   render,\n665:   renderTutorial: whyTutorial(WHY, render),\n666: });\n667: \n668: export default CommanderDeckSpotlightV1;\n669: \n670: async function render(props: CommanderDeckSpotlightProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n671:   const { width: W, height: H } = ctx.target;\n672:   const L = layoutSpotlightCard(props, W, H);\n673:   const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n674:   const constraints: LayoutConstraint[] = [];\n675: \n676:   // Tiles first, then text: placeInsetPieces puts a rect on the first overlay\n677:   // layer it does not collide with, so tiles of one kind share a layer.\n678:   for (const t of [...L.tiles].sort((a, b) => a.layer - b.layer)) {\n679:     const tile = tag(\n680:       makeColorTile(t.color, { effects: { rounding: { cornerStyle: \"rounded\", borderRadius: t.radius } } }) as MosaicSource,\n681:       t.label,\n682:     );\n683:     const source =\n684:       t.bind === \"accent\"\n\n(Showing lines 555-684 of 740. Use offset=685 to continue.)\n</content>","metadata":{"preview":"    m,\n    CW,\n    gap,\n    floor,\n    small,\n    cells,\n    tiles,\n    bars,\n    rows,\n    chipSide,\n    sideBySide,\n    curveCell,\n    hlCell,\n    bodyTop,\n    bodyBottom,\n    plotTop,\n    plotBottom,\n    plotH,\n  };\n}","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\src\\gaming\\commander-deck-spotlight\\v1\\commander-deck-spotlight.ts","text":"    m,\n    CW,\n    gap,\n    floor,\n    small,\n    cells,\n    tiles,\n    bars,\n    rows,\n    chipSide,\n    sideBySide,\n    curveCell,\n    hlCell,\n    bodyTop,\n    bodyBottom,\n    plotTop,\n    plotBottom,\n    plotH,\n  };\n}\n\n/**\n * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n * convention, src/_shared/why.ts): the run, the problem with the sources the\n * agent opened, the solution, how to use it, then the template itself.\n */\nconst WHY: WhySpec = {\n  \"day\": 27,\n  \"date\": \"2026-10-16\",\n  \"agent\": \"opencode\",\n  \"model\": \"mimo-v2.6-pro\",\n  \"id\": \"@one-a-day/gaming/commander-deck-spotlight/v1\",\n  \"title\": \"Commander Deck Spotlight Card\",\n  \"who\": \"Commander/EDH players on r/EDH, deck-building Facebook groups and playgroup chats, sharing decklists exported from Moxfield, Archidekt or ManaBox\",\n  \"problem\": [\n    \"Mythichub's builder blog: \\\"I was looking into creating a reusable template that I could post there and on other social media. I created a tool for myself that turns decks into fun images\\\" - and \\\"it's easy to scroll past a plain list or a link to a decklist. I think an image gets more attention\\\".\",\n    \"The ecosystem converged on one digest: Archidekt's FAQ answers \\\"How do I create an image of my deck to share on social media?\\\"; TopDeck.gg sells 16:9 deck images \\\"perfect for: Social media bragging rights - Share your 4-0 tournament deck\\\"; DeckPassport: \\\"No more walls of text to explain your deck. Just share the card.\\\"\"\n  ],\n  \"sources\": [\n    \"https://mythichub.com/blog/turn-a-boring-decklist-into-an-awesome-image\",\n    \"https://mythichub.com/deck-spotlight\",\n    \"https://archidekt.com/faq\",\n    \"https://overpower.topdeck.gg/blog/visual-deck-display-20250626\",\n    \"https://github.com/YohannBethoule/DeckPassport\"\n  ],\n  \"solution\": [\n    \"One card per deck from the fields a builder export already shows: deck name, commander, colour identity, bracket and record, the eight-bucket mana curve, 3-6 highlight cards and the plan one-liner. Deterministic, so a game-night lineup or a top-8 is one CLI loop.\",\n    \"The one decision: the curve never lies. AVG MV and the spell count are COMPUTED from the buckets (179/63 = 2.84 at defaults), never typed, and the bars are height-proportional to the counts with the tallest filling the plot - the card cannot disagree with itself.\"\n  ],\n  \"usage\": {\n    \"command\": \"m0saic make @one-a-day/gaming/commander-deck-spotlight/v1 --template-repo . -w 1920 -h 1080 -o journal/2026-10-16/commander-deck-spotlight.png\",\n    \"try\": [\n      \"curve: 8 counts for MV 0..7+; AVG MV and the spell count follow the buckets\",\n      \"highlights: 3-6 rows of { name, note, qty } - the cards you would paste in chat\",\n      \"manaIdentity \\\"UB\\\" drops the chips to two; \\\"\\\" removes the chip row entirely\",\n      \"-w 1080 -h 1920 for the phone view: the body stacks, curve over highlights\"\n    ]\n  },\n  \"caveats\": [\n    \"No card art, no network: every existing tool puts Scryfall art at the center and a member may ask \\\"where's my commander's art?\\\" - this demo is rectangles and numbers only.\",\n    \"Mana values and bracket are not in the raw export lines; the player reads them off the builder UI and passes them as props.\",\n    \"A 100-card list cannot fit: 3-6 highlight rows is the digest the ecosystem converged on, not a full decklist.\"\n  ],\n  \"timeline\": {\n    \"source\": \"runner\",\n    \"phases\": [\n      {\n        \"name\": \"scout\",\n        \"startMs\": 0,\n        \"durMs\": 628558,\n        \"calls\": 23,\n        \"tokens\": 833417,\n        \"costUsd\": 0.06,\n        \"tools\": \"bash 16, websearch 5, write 2\"\n      },\n      {\n        \"name\": \"plan\",\n        \"startMs\": 628579,\n        \"durMs\": 484895,\n        \"calls\": 26,\n        \"tokens\": 701093,\n        \"costUsd\": 0.04,\n        \"tools\": \"bash 22, grep 3, write 1\"\n      }\n    ],\n    \"costBasis\": \"reported\"\n  }\n};\n\nexport const CommanderDeckSpotlightV1 = defineMosaicTemplate<CommanderDeckSpotlightProps>({\n  id: asTemplateId(ID),\n  label: \"2026-10-16 · Commander Deck Spotlight Card\",\n  version: 1,\n  description: \"A Magic Commander/EDH deck as one share card from the decklist fields themselves: kicker, bracket and record pills, deck name, commander line with WUBRG mana chips, an eight-bar mana curve with derived AVG MV and spell count, 3-6 highlight rows and the plan one-liner.\",\n  capabilities: { tier: \"core\" },\n  tags: [\"gaming\", \"2026-10-16\", \"day-027\", \"mtg\", \"commander\", \"edh\", \"decklist\", \"deck-tech\", \"share-card\"],\n\n  outputHints: {\n    width: 1920,\n    height: 1080,\n    fps: 30,\n    durationMs: 2000,\n    format: { kind: \"image\", container: \"png\" },\n    note: \"Still PNG. Landscape runs curve and highlights side by side; portrait stacks them in the same bands; square reads as landscape. Minimum tested canvas 480x270.\",\n  },\n\n  propsSchema,\n  defaultProps: DEFAULTS,\n\n  render,\n  renderTutorial: whyTutorial(WHY, render),\n});\n\nexport default CommanderDeckSpotlightV1;\n\nasync function render(props: CommanderDeckSpotlightProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n  const { width: W, height: H } = ctx.target;\n  const L = layoutSpotlightCard(props, W, H);\n  const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n  const constraints: LayoutConstraint[] = [];\n\n  // Tiles first, then text: placeInsetPieces puts a rect on the first overlay\n  // layer it does not collide with, so tiles of one kind share a layer.\n  for (const t of [...L.tiles].sort((a, b) => a.layer - b.layer)) {\n    const tile = tag(\n      makeColorTile(t.color, { effects: { rounding: { cornerStyle: \"rounded\", borderRadius: t.radius } } }) as MosaicSource,\n      t.label,\n    );\n    const source =\n      t.bind === \"accent\"","lineStart":555,"lineEnd":684,"totalLines":740,"truncated":true}},"title":"src\\gaming\\commander-deck-spotlight\\v1\\commander-deck-spotlight.ts","time":{"start":1792162727625,"end":1792162727737}},"id":"prt_145390398001835L5mCpfkIr20","sessionID":"ses_ebac7ca9cfferAeVboCf1pHO3D","messageID":"ms