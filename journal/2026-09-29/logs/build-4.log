ines":["         const widest = String(Math.max(...p.numbers.values()));","         constraints.push((0, layout_1.textFitsMeasured)(\"cell-number\", widest, B.numberPx, (0, text_1.widthOf)(widest, B.numberPx)));","     }","-    // The designed shape: the lattice plus its border (a 25x3 is not 25/3 once the border is on).","+    // The designed shape: the lattice plus its border (a 25x3 is not 25/3 once the border is on), within 2%.","     const shape = (pz.cols * B.pitch - B.rule + 2 * B.border) / (pz.rows * B.pitch - B.rule + 2 * B.border);","-    constraints.push({ label: \"board\", aspect: shape, ...(pz.cols === pz.rows ? { minWidthFrac: 0.45, minHeightFrac: 0.45 } : {}) });","+    constraints.push({ label: \"board\", aspect: shape, aspectTolerance: 0.02 * Math.max(shape, 1 / shape), ...(pz.cols === pz.rows ? { minWidthFrac: 0.45, minHeightFrac: 0.45 } : {}) });","     if (L.themeLines.length > 0)","         constraints.push({ label: \"theme-swatch\", aspect: 1, aspectTolerance: 0.2 });","     const relations = [];"]}]},{"filePath":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-09-29\\variants\\a\\renders\\landscape.output.json","hunks":[{"oldStart":5,"oldLines":10,"newStart":5,"newLines":10,"lines":["   \"exitCode\": 0,","   \"renderStatus\": \"ok\",","   \"run\": {","-    \"id\": \"b90ee799-9efe-4f86-825e-e861b183416e\",","-    \"startedAtIso\": \"2026-09-29T15:20:33.873Z\",","-    \"finishedAtIso\": \"2026-09-29T15:20:34.612Z\",","-    \"elapsedMs\": 739,","+    \"id\": \"5df3bdc6-2323-4eaf-b866-0e4645e8d72c\",","+    \"startedAtIso\": \"2026-09-29T15:22:40.935Z\",","+    \"finishedAtIso\": \"2026-09-29T15:22:41.830Z\",","+    \"elapsedMs\": 895,","     \"estimatedMs\": 1924,","     \"costModelVersion\": 3,","     \"machineFactor\": 5.67551622418879,"]}]},{"filePath":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-09-29\\variants\\a\\renders\\portrait.output.json","hunks":[{"oldStart":5,"oldLines":10,"newStart":5,"newLines":10,"lines":["   \"exitC