{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bape5Uibt8EMJY2yVxRrVB","type":"tool_result","content":"1\timport type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\n2\timport { asTemplateId } from \"@m0saic/types\";\n3\timport { toM0String } from \"@m0saic/dsl-stdlib\";\n4\timport { bindProp, bindPropRange, bindProps, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\n5\timport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\n6\timport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n7\timport { budget, textCell, widthOf } from \"../../../_shared/text\";\n8\timport { whyTutorial } from \"../../../_shared/why\";\n9\timport type { WhySpec } from \"../../../_shared/why\";\n10\t\n11\t/**\n12\t * `@one-a-day/gaming/crossword-grid-card/v1` - the solved crossword grid a\n13\t * blogger puts atop a write-up, drawn from the puzzle file's own fields\n14\t * instead of a screenshot of the solving app: blocks, derived clue numbers,\n15\t * letters, circled squares, the theme entries tinted and listed, and the\n16\t * caption line. With `solved: false` it is a constructor's new-puzzle teaser.\n17\t *\n18\t * ONE CONCEPT: a lattice this big is drawn in LAYERS, not cells. The board is\n19\t * a paper tile, a theme tile and an ink tile masked to \"board minus paper\n20\t * cells\" (border, rules and blocks in one path), a ring tile, and one\n21\t * multi-layer text source for all the letters and one for all the numbers\n22\t * (each glyph placed by a pixel xExpr/yExpr). Any size is under 40 frames and\n23\t * about 8 overlays deep. Per-cell grids would be 1,500+ frames at 25x25, past\n24\t * the engine's 400-frame budget; a text source per row stacks past the ~25\n25\t * overlays where the engine silently degrades inline masks.\n26\t *\n27\t * The rule that bites: equal cells come from ONE integer lattice,\n28\t * `X_k = round(x0 + k * pitch)`, that every layer reads - the mask holes, the\n29\t * tint cells, the glyph offsets. Compute any of them from its own rounding\n30\t * and the rules drift off the letters by a pixel per cell.\n31\t */\n32\t\n33\texport type CrosswordGridCardProps = {\n34\t  /** The solution: rows split by \"/\" or newlines, \"#\" or \".\" for a block, A-Z; an unbroken square string reads as n x n. */\n35\t  grid?: string;\n36\t  /** Clue ids to tint and list (\"17A 3D\"), spaces or commas. \"\" = none. */\n37\t  themeEntries?: string;\n38\t  /** 0-based row-major cell indices to ring (the .puz order). \"\" = none. */\n39\t  circles?: string;\n40\t  /** CrosswordPuzzle title, 1-40 printable ASCII. */\n41\t  title?: string;\n42\t  /** Constructor(s), 1-48 printable ASCII; shown as \"by <author>\". */\n43\t  author?: string;\n44\t  /** Outlet or series for the caption line, 1-24 printable ASCII. */\n45\t  publication?: string;\n46\t  /** CrosswordPuzzle date, YYYY-MM-DD. */\n47\t  date?: string;\n48\t  /** false = the teaser: no letters, no theme tint, no answer list. */\n49\t  solved?: boolean;\n50\t  /** Theme-cell fill and list swatches (#rrggbb). Never used as text ink. */\n51\t  themeColor?: string;\n52\t  /** Dev-only: check the layout contract and draw it over the card. */\n53\t  debugLayout?: boolean;\n54\t};\n55\t\n56\tconst ID = \"@one-a-day/gaming/crossword-grid-card/v1\";\n57\tconst HEX = /^#[0-9a-fA-F]{6}$/;\n58\tconst PAGE = \"#F2EFE8\" as MosaicColor;\n59\tconst PAPER = \"#FFFFFF\" as MosaicColor;\n60\tconst INK = \"#15171C\" as MosaicColor;\n61\tconst DIM = \"#5E626B\" as MosaicColor;\n62\tconst MIN_SIDE = 3;\n63\tconst MAX_SIDE = 25;\n64\tconst MAX_THEMES = 8;\n65\tconst MAX_CIRCLES = 120;\n66\tconst LETTER_EM = 0.6;\n67\tconst NUMBER_EM = 0.28;\n68\tconst NUMBER_FLOOR_PX = 6;\n69\t/** Roboto: ascent 0.928 em, cap height 0.711 em - where the ink sits under a top-aligned layer. */\n70\tconst CAP_TOP_EM = 0.928 - 0.711;\n71\tconst CAP_MID_EM = CAP_TOP_EM + 0.711 / 2;\n72\t\n73\texport const CROSSWORD_DEFAULTS = {\n74\t  grid: \"PAN#BOW/AGE#ARE/DOGSLED/##AIL##/CATNAPS/OWE#SAT/YES#TRY\",\n75\t  themeEntries: \"9A 12A\",\n76\t  circles: \"14 15 16 28 29 30\",\n77\t  title: \"Cats and Dogs\",\n78\t  author: \"one-a-day agent\",\n79\t  publication: \"Demo Mini\",\n80\t  date: \"2026-09-29\",\n81\t  solved: true,\n82\t  themeColor: \"#FFE08A\",\n83\t  debugLayout: false,\n84\t} as const;\n85\t\n86\tconst propsSchema = definePropsSchema<CrosswordGridCardProps>({\n87\t  grid: {\n88\t    type: \"string\",\n89\t    required: false,\n90\t    description: 'The solution grid. Rows split by \"/\" or newlines; \"#\" or \".\" is a block; letters A-Z (uppercase). 3-25 cells each way, rows of equal length. An unbroken string whose length is a square (the .puz solution string, puzpy p.solution) is read as n x n.',\n91\t    meta: { control: { multiline: true, placeholder: CROSSWORD_DEFAULTS.grid }, ui: { label: \"Grid (solution rows)\", order: 1 } },\n92\t  },\n93\t  themeEntries: {\n94\t    type: \"string\",\n95\t    required: false,\n96\t    description: 'Clue ids to tint and list, e.g. \"17A 38A 3D\" (spaces or commas). Each must exist in the grid numbering; at most 8. \"\" for none.',\n97\t    meta: { control: { placeholder: \"17A 38A 61A\" }, ui: { label: \"Theme entries\", order: 2 } },\n98\t  },\n99\t  circles: {\n100\t    type: \"string\",\n101\t    required: false,\n102\t    description: 'Circled squares as 0-based row-major cell indices (the .puz order), spaces or commas; each must be a white cell. \"\" for none.',\n103\t    meta: { control: { placeholder: \"14 15 16\" }, ui: { label: \"Circled squares\", order: 3 } },\n104\t  },\n105\t  title: {\n106\t    type: \"string\",\n107\t    required: false,\n108\t    description: \"CrosswordPuzzle title, 1-40 printable ASCII characters. The rect that shows it is bound to it.\",\n109\t    meta: { control: { placeholder: CROSSWORD_DEFAULTS.title }, ui: { label: \"Title\", order: 4 } },\n110\t  },\n111\t  author: {\n112\t    type: \"string\",\n113\t    required: false,\n114\t    description: 'Constructor(s), 1-48 printable ASCII characters; drawn as \"by <author>\".',\n115\t    meta: { control: { placeholder: CROSSWORD_DEFAULTS.author }, ui: { label: \"Author\", order: 5 } },\n116\t  },\n117\t  publication: {\n118\t    type: \"string\",\n119\t    required: false,\n120\t    description: \"Outlet or series for the caption line, 1-24 printable ASCII characters.\",\n121\t    meta: { control: { placeholder: CROSSWORD_DEFAULTS.publication }, ui: { label: \"Publication\", order: 6 } },\n122\t  },\n123\t  date: {\n124\t    type: \"string\",\n125\t    required: false,\n126\t    description: \"CrosswordPuzzle date as YYYY-MM-DD; the caption shows the weekday and M/D/YY.\",\n127\t    meta: { control: { placeholder: CROSSWORD_DEFAULTS.date }, ui: { label: \"Date\", order: 7 } },\n128\t  },\n129\t  solved: {\n130\t    type: \"boolean\",\n131\t    required: false,\n132\t    description: \"true = the solution card. false = the new-puzzle teaser: blocks, numbers and circles only; letters, theme tint and answers are hidden.\",\n133\t    meta: { ui: { label: \"Show solution\", order: 8 } },\n134\t  },\n135\t  themeColor: {\n136\t    type: \"string\",\n137\t    required: false,\n138\t    description: \"Theme-cell fill and list swatches as #rrggbb. Letters stay in ink.\",\n139\t    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: CROSSWORD_DEFAULTS.themeColor }, ui: { label: \"Theme color\", order: 9 } },\n140\t  },\n141\t  debugLayout: {\n142\t    type: \"boolean\",\n143\t    required: false,\n144\t    description: \"Dev-only: check the layout contract (every text fits, the board keeps its shape) and draw it over the card.\",\n145\t    meta: { ui: { label: \"Debug layout\", order: 99 } },\n146\t  },\n147\t});\n148\t\n149\t// ---------------------------------------------------------------- the puzzle\n150\t\n151\tfunction fail(field: string, rule: string): never {\n152\t  throw new Error(`${ID}: ${field} ${rule}`);\n153\t}\n154\t\n155\texport type CrosswordPuzzle = {\n156\t  rows: number;\n157\t  cols: number;\n158\t  /** Row-major; null is a block. */\n159\t  cells: Array<string | null>;\n160\t};\n161\t\n162\t/** Parse the grid prop. Every refusal names the field, and for a cell its row and column (1-based). */\n163\texport function parseCrosswordGrid(raw: unknown): CrosswordPuzzle {\n164\t  if (typeof raw !== \"string\") fail(\"grid\", \"must be a string of rows.\");\n165\t  const text = raw.trim();\n166\t  let lines = text.split(/\\s*[/\\r\\n]+\\s*/).filter((l) => l.length > 0);\n167\t  if (lines.length === 1) {\n168\t    const n = Math.round(Math.sqrt(lines[0].length));\n169\t    if (n * n === lines[0].length && n >= MIN_SIDE) lines = Array.from({ length: n }, (_, r) => lines[0].slice(r * n, (r + 1) * n));\n170\t  }\n171\t  if (lines.length < MIN_SIDE || lines.length > MAX_SIDE) fail(\"grid\", `must have ${MIN_SIDE}-${MAX_SIDE} rows (got ${lines.length}); split rows with \"/\" or newlines.`);\n172\t  const cols = lines[0].length;\n173\t  if (cols < MIN_SIDE || cols > MAX_SIDE) fail(\"grid\", `rows must have ${MIN_SIDE}-${MAX_SIDE} cells (row 1 has ${cols}).`);\n174\t  const cells: Array<string | null> = [];\n175\t  lines.forEach((line, r) => {\n176\t    if (line.length !== cols) fail(\"grid\", `row ${r + 1} has ${line.length} cells but row 1 has ${cols}; every row must be the same length.`);\n177\t    for (let c = 0; c < cols; c++) {\n178\t      const ch = line[c];\n179\t      if (ch === \"#\" || ch === \".\") cells.push(null);\n180\t      else if (ch >= \"A\" && ch <= \"Z\") cells.push(ch);\n181\t      else if (ch >= \"a\" && ch <= \"z\") fail(\"grid\", `row ${r + 1} column ${c + 1} is lowercase \"${ch}\"; letters must be A-Z (the .puz solution is uppercase).`);\n182\t      else fail(\"grid\", `row ${r + 1} column ${c + 1} is ${JSON.stringify(ch)}; use A-Z for letters and \"#\" or \".\" for a block.`);\n183\t    }\n184\t  });\n185\t  if (!cells.some((c) => c !== null)) fail(\"grid\", \"must have at least one white cell.\");\n186\t  return { rows: lines.length, cols, cells };\n187\t}\n188\t\n189\texport type CrosswordEntry = { id: string; number: number; dir: \"A\" | \"D\"; cells: number[]; answer: string };\n190\t\n191\t/**\n192\t * The standard American numbering: a white cell takes the next number when it\n193\t * starts an across entry (left is edge or block, right is white) or a down\n194\t * entry (above is edge or block, below is white). Left to right, top to bottom.\n195\t * Unchecked cells (British style) simply start nothing.\n196\t */\n197\texport function numberCrosswordGrid(pz: CrosswordPuzzle): { numbers: Map<number, number>; entries: Map<string, CrosswordEntry> } {\n198\t  const { rows, cols, cells } = pz;\n199\t  const white = (r: number, c: number) => r >= 0 && r < rows && c >= 0 && c < cols && cells[r * cols + c] !== null;\n200\t  const numbers = new Map<number, number>();\n201\t  const entries = new Map<string, CrosswordEntry>();\n202\t  let n = 0;\n203\t  for (let r = 0; r < rows; r++) {\n204\t    for (let c = 0; c < cols; c++) {\n205\t      if (!white(r, c)) continue;\n206\t      const across = !white(r, c - 1) && white(r, c + 1);\n207\t      const down = !white(r - 1, c) && white(r + 1, c);\n208\t      if (!across && !down) continue;\n209\t      n++;\n210\t      numbers.set(r * cols + c, n);\n211\t      const walk = (dir: \"A\" | \"D\") => {\n212\t        const idx: number[] = [];\n213\t        for (let rr = r, cc = c; white(rr, cc); dir === \"A\" ? cc++ : rr++) idx.push(rr * cols + cc);\n214\t        entries.set(`${n}${dir}`, { id: `${n}${dir}`, number: n, dir, cells: idx, answer: idx.map((i) => cells[i]).join(\"\") });\n215\t      };\n216\t      if (across) walk(\"A\");\n217\t      if (down) walk(\"D\");\n218\t    }\n219\t  }\n220\t  return { numbers, entries };\n221\t}\n222\t\n223\tfunction tokens(raw: unknown, field: string): string[] {\n224\t  if (typeof raw !== \"string\") fail(field, 'must be a string (spaces or commas between items; \"\" for none).');\n225\t  return raw.split(/[\\s,]+/).filter((t) => t.length > 0);\n226\t}\n227\t\n228\tfunction ascii(raw: unknown, field: string, max: number): string {\n229\t  if (typeof raw !== \"string\" || /[^\\x20-\\x7e]/.test(raw)) fail(field, \"must be printable ASCII text.\");\n230\t  const s = raw.trim().replace(/\\s+/g, \" \");\n231\t  if (s.length < 1 || s.length > max) fail(field, `must have 1-${max} characters (got ${s.length}).`);\n232\t  return s;\n233\t}\n234\t\n235\t/** WCAG contrast ratio of two #rrggbb colours. */\n236\tfunction contrast(a: string, b: string): number {\n237\t  const lum = (hex: string) => {\n238\t    const [r, g, bl] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));\n239\t    return 0.2126 * r + 0.7152 * g + 0.0722 * bl;\n240\t  };\n241\t  const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);\n242\t  return (hi + 0.05) / (lo + 0.05);\n243\t}\n244\t\n245\tconst WEEKDAYS = [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"];\n246\t\n247\t/** Weekday by calendar arithmetic (Sakamoto) - no clock, no Date. */\n248\tfunction weekday(y: number, m: number, d: number): string {\n249\t  const t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];\n250\t  const yy = m < 3 ? y - 1 : y;\n251\t  return WEEKDAYS[(yy + Math.floor(yy / 4) - Math.floor(yy / 100) + Math.floor(yy / 400) + t[m - 1] + d) % 7];\n252\t}\n253\t\n254\t/** Every prop validated; a bad value fails with its field named, never falls back to the sample. */\n255\texport function normalizeCrossword(props: CrosswordGridCardProps) {\n256\t  const p = { ...CROSSWORD_DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) } as Required<CrosswordGridCardProps>;\n257\t  const pz = parseCrosswordGrid(p.grid);\n258\t  const { numbers, entries } = numberCrosswordGrid(pz);\n259\t\n260\t  const themeIds = tokens(p.themeEntries, \"themeEntries\");\n261\t  if (themeIds.length > MAX_THEMES) fail(\"themeEntries\", `may list at most ${MAX_THEMES} entries (got ${themeIds.length}).`);\n262\t  const themes: CrosswordEntry[] = [];\n263\t  for (const id of themeIds) {\n264\t    if (!/^[1-9]\\d{0,2}[AD]$/.test(id)) fail(\"themeEntries\", `\"${id}\" must be a clue id like 17A or 3D.`);\n265\t    if (themes.some((t) => t.id === id)) fail(\"themeEntries\", `lists ${id} twice.`);\n266\t    const e = entries.get(id);\n267\t    if (!e) fail(\"themeEntries\", `${id} is not an entry in this grid's numbering.`);\n268\t    themes.push(e);\n269\t  }\n270\t\n271\t  const circleIds = tokens(p.circles, \"circles\");\n272\t  if (circleIds.length > MAX_CIRCLES) fail(\"circles\", `may ring at most ${MAX_CIRCLES} squares (got ${circleIds.length}).`);\n273\t  const circles: number[] = [];\n274\t  for (const t of circleIds) {\n275\t    if (!/^\\d+$/.test(t)) fail(\"circles\", `\"${t}\" must be a 0-based cell index.`);\n276\t    const i = Number(t);\n277\t    if (i >= pz.rows * pz.cols) fail(\"circles\", `${i} is outside the ${pz.cols}x${pz.rows} grid (0-${pz.rows * pz.cols - 1}).`);\n278\t    if (pz.cells[i] === null) fail(\"circles\", `${i} (row ${Math.floor(i / pz.cols) + 1} column ${(i % pz.cols) + 1}) is a block; only white squares are circled.`);\n279\t    if (circles.includes(i)) fail(\"circles\", `lists ${i} twice.`);\n280\t    circles.push(i);\n281\t  }\n282\t\n283\t  const title = ascii(p.title, \"title\", 40);\n284\t  const author = ascii(p.author, \"author\", 48);\n285\t  const publication = ascii(p.publication, \"publication\", 24);\n286\t  if (typeof p.date !== \"string\" || !/^\\d{4}-\\d{2}-\\d{2}$/.test(p.date)) fail(\"date\", \"must be YYYY-MM-DD.\");\n287\t  const [y, m, d] = p.date.split(\"-\").map(Number);\n288\t  const leap = y % 4 === 0 && (y % 100 !== 0 || y % 400 === 0);\n289\t  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n290\t  if (y < 1 || m < 1 || m > 12 || d < 1 || d > days[m - 1]) fail(\"date\", `${p.date} is not a calendar date.`);\n291\t  if (typeof p.solved !== \"boolean\") fail(\"solved\", \"must be true or false.\");\n292\t  if (typeof p.themeColor !== \"string\" || !HEX.test(p.themeColor)) fail(\"themeColor\", `${JSON.stringify(p.themeColor)} must be #rrggbb.`);\n293\t  const inkOnTheme = contrast(INK, p.themeColor);\n294\t  if (inkOnTheme < 4.5) fail(\"themeColor\", `${p.themeColor} is too dark for the ink letters over it (${inkOnTheme.toFixed(1)}:1, needs 4.5:1); pick a lighter highlighter colour.`);\n295\t  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be true or false.\");\n296\t\n297\t  // Where each theme id sits in the RAW prop string, so its list cell can bind that token.\n298\t  const themeSpans = [...(p.themeEntries as string).matchAll(/[^\\s,]+/g)].map((t) => ({ start: t.index ?? 0, end: (t.index ?? 0) + t[0].length }));\n299\t  const metaDate = `${weekday(y, m, d)} ${m}/${d}/${String(y % 100).padStart(2, \"0\")}`;\n300\t  const metaTail = `${pz.cols}x${pz.rows} | ${p.solved ? \"solution\" : \"puzzle\"}`;\n301\t  const metaRest = `${metaDate} | ${metaTail}`;\n302\t  return { ...p, pz, numbers, entries, themes, themeSpans, circles, title, author, publication, meta: `${publication} | ${metaRest}`, metaRest, metaDate, metaTail, themeColor: p.themeColor as MosaicColor };\n303\t}\n304\t\n305\texport type CrosswordNormalized = ReturnType<typeof normalizeCrossword>;\n306\t\n307\t// ---------------------------------------------------------------- geometry\n308\t\n309\texport type CrosswordRect = { x: number; y: number; w: number; h: number };\n310\tconst rect = (x: number, y: number, w: number, h: number): CrosswordRect => {\n311\t  const x0 = Math.round(x), y0 = Math.round(y);\n312\t  return { x: x0, y: y0, w: Math.max(1, Math.round(x + w) - x0), h: Math.max(1, Math.round(y + h) - y0) };\n313\t};\n314\t\n315\t/** Height a fitted block needs: Roboto's em box is 1.17 em (ascent + descent), each extra line 1.25 em, plus 2px. */\n316\tconst blockH = (px: number, lines: number) => Math.ceil(px * (1.17 + 1.25 * (lines - 1))) + 2;\n317\t\n318\t/** Lossless line breaks: split at spaces, cut an over-long token, never drop a glyph. */\n319\tfunction wrap(text: string, px: number, maxW: number, bold: boolean): string[] {\n320\t  const lines: string[] = [];\n321\t  let rest = text;\n322\t  while (widthOf(rest, px, bold) > maxW) {\n323\t    let n = 1;\n324\t    while (n < rest.length && widthOf(rest.slice(0, n + 1), px, bold) <= maxW) n++;\n325\t    const space = rest.lastIndexOf(\" \", n);\n326\t    if (space > 0) { lines.push(rest.slice(0, space)); rest = rest.slice(space + 1); }\n327\t    else { lines.push(rest.slice(0, n)); rest = rest.slice(n); }\n328\t  }\n329\t  lines.push(rest);\n330\t  return lines;\n331\t}\n332\t\n333\t/** A text cell; `bind` names the prop it shows, `token` the span of the raw prop string it shows (a theme id). */\n334\texport type CrosswordTextBox = { label: string; rect: CrosswordRect; text: string; px: number; width: number; bold: boolean; color: MosaicColor; hAlign: \"left\" | \"right\"; vAlign: \"top\" | \"middle\" | \"bottom\"; bind?: \"title\" | \"author\" | \"publication\" | \"date\" | \"themeEntries\"; token?: { start: number; end: number } };\n335\t\n336\t/**\n337\t * The largest size (maxPx down to floorPx, then on down to 6 so the contract\n338\t * flags it rather than the render dying) at which `text` fits `w` x `maxH` in\n339\t * one of `lineOptions` line counts, tried in order.\n340\t */\n341\tfunction fit(text: string, w: number, maxH: number, maxPx: number, floorPx: number, lineOptions: number[], bold: boolean) {\n342\t  const tryAt = (px: number, maxLines: number) => {\n343\t    const lines = wrap(text, px, budget(w), bold);\n344\t    if (lines.length > maxLines || blockH(px, lines.length) > maxH) return null;\n345\t    return { lines, px, width: Math.max(...lines.map((l) => widthOf(l, px, bold))) };\n346\t  };\n347\t  for (const maxLines of lineOptions) {\n348\t    for (let px = Math.max(floorPx, Math.floor(maxPx)); px >= floorPx; px--) {\n349\t      const hit = tryAt(px, maxLines);\n350\t      if (hit) return hit;\n351\t    }\n352\t  }\n353\t  const most = Math.max(...lineOptions);\n354\t  for (let px = floorPx - 1; px >= 6; px--) {\n355\t    const hit = tryAt(px, most);\n356\t    if (hit) return hit;\n357\t  }\n358\t  const lines = wrap(text, 6, budget(w), bold);\n359\t  return { lines, px: 6, width: Math.max(...lines.map((l) => widthOf(l, 6, bold))) };\n360\t}\n361\t\n362\t/** One cell of the caption line: its text, its offset from the line's origin, its box width and its measured ink width. */\n363\ttype MetaCell = { text: string; bold: boolean; dx: number; dy: number; w: number; width: number };\n364\ttype MetaFit = { px: number; height: number; cells: [MetaCell, MetaCell, MetaCell] };\n365\t\n366\t/** A lead cell and a tail cell sharing one size: side by side (the tail may wrap in its own column), or stacked. */\n367\ttype Pair = { px: number; stacked: boolean; tail: string[]; leadW: number; tailX: number; height: number };\n368\tconst leadBoxW = (w: number) => Math.ceil((w + 3) / 0.94) + 1;\n369\t\n370\t/**\n371\t * The largest size at which `lead` + `tail` fit `w` x `maxH`, trying the\n372\t * `modes` in order at each size range: \"line\" (one line), \"wrap\" (the tail\n373\t * wraps to two lines beside the lead), \"stack\" (the tail on the next line).\n374\t */\n375\tfunction pairFit(lead: string, leadBold: boolean, tail: string, tailStacked: string, w: number, maxH: number, maxPx: number, floorPx: number, modes: Array<\"line\" | \"wrap\" | \"stack\">): Pair {\n376\t  const at = (px: number, mode: \"line\" | \"wrap\" | \"stack\"): Pair | null => {\n377\t    const leadW = widthOf(lead, px, leadBold);\n378\t    if (mode === \"stack\") {\n379\t      const lines = wrap(tailStacked, px, budget(w), false);\n380\t      return leadW <= budget(w) && lines.length === 1 && 2 * blockH(px, 1) <= maxH ? { px, stacked: true, tail: lines, leadW, tailX: 0, height: 2 * blockH(px, 1) } : null;\n381\t    }\n382\t    const tailX = Math.max(leadBoxW(leadW), Math.round(leadW + px * 0.3));\n383\t    if (w - tailX < 2 * px) return null;\n384\t    const lines = wrap(tail, px, budget(w - tailX), false);\n385\t    return lines.length <= (mode === \"line\" ? 1 : 2) && blockH(px, lines.length) <= maxH ? { px, stacked: false, tail: lines, leadW, tailX, height: blockH(px, lines.length) } : null;\n386\t  };\n387\t  for (const [lo, hi] of [[floorPx, Math.max(floorPx, Math.floor(maxPx))], [6, floorPx - 1]]) {\n388\t    for (const mode of modes) for (let px = hi; px >= lo; px--) { const hit = at(px, mode); if (hit) return hit; }\n389\t  }\n390\t  const lines = wrap(tailStacked, 6, budget(w), false);\n391\t  return { px: 6, stacked: true, tail: lines, leadW: widthOf(lead, 6, leadBold), tailX: 0, height: blockH(6, 1) + blockH(6, lines.length) };\n392\t}\n393\t\n394\texport type CrosswordBoard = {\n395\t  pitch: number;\n396\t  rule: number;\n397\t  border: number;\n398\t  /** Integer lattice lines: X[k] is the centre line left of column k (length cols+1). */\n399\t  X: number[];\n400\t  Y: number[];\n401\t  /** The whole board as drawn: ink border included. */\n402\t  ink: CrosswordRect;\n403\t  /** The paper part of cell i (inside the rules). */\n404\t  hole: (i: number) => CrosswordRect;\n405\t  letterPx: number;\n406\t  /** 0 when the clue numbers are dropped (below the 6px floor). */\n407\t  numberPx: number;\n408\t};\n409\t\n410\tfunction boardSizing(cols: number, rows: number, availW: number, availH: number) {\n411\t  let pitch = Math.min(availW / cols, availH / rows);\n412\t  for (let k = 0; k < 3; k++) {\n413\t    const rule = Math.max(1, Math.round(pitch * 0.03));\n414\t    const border = Math.max(2, 2 * rule, Math.round(pitch * 0.06));\n415\t    pitch = Math.min((availW - 2 * border + rule) / cols, (availH - 2 * border + rule) / rows);\n416\t  }\n417\t  const rule = Math.max(1, Math.round(pitch * 0.03));\n418\t  const border = Math.max(2, 2 * rule, Math.round(pitch * 0.06));\n419\t  return { pitch, rule, border, inkW: cols * pitch - rule + 2 * border, inkH: rows * pitch - rule + 2 * border };\n420\t}\n421\t\n422\tfunction boardAt(cols: number, rows: number, s: ReturnType<typeof boardSizing>, inkX: number, inkY: number): CrosswordBoard {\n423\t  const { pitch, rule, border } = s;\n424\t  const lead = border - Math.ceil(rule / 2);\n425\t  const x0 = Math.round(inkX) + lead, y0 = Math.round(inkY) + lead;\n426\t  const X = Array.from({ length: cols + 1 }, (_, k) => Math.round(x0 + k * pitch));\n427\t  const Y = Array.from({ length: rows + 1 }, (_, k) => Math.round(y0 + k * pitch));\n428\t  const ink = { x: X[0] - lead, y: Y[0] - lead, w: X[cols] - X[0] - rule + 2 * border, h: Y[rows] - Y[0] - rule + 2 * border };\n429\t  const hole = (i: number): CrosswordRect => {\n430\t    const r = Math.floor(i / cols), c = i % cols;\n431\t    const x = X[c] + Math.ceil(rule / 2), y = Y[r] + Math.ceil(rule / 2);\n432\t    return { x, y, w: X[c + 1] - Math.floor(rule / 2) - x, h: Y[r + 1] - Math.floor(rule / 2) - y };\n433\t  };\n434\t  const letterPx = Math.max(6, Math.round(pitch * LETTER_EM));\n435\t  const n = Math.round(pitch * NUMBER_EM);\n436\t  return { pitch, rule, border, X, Y, ink, hole, letterPx, numberPx: n >= NUMBER_FLOOR_PX ? n : 0 };\n437\t}\n438\t\n439\texport type CrosswordThemeLine = { swatch: CrosswordRect; id: CrosswordTextBox; answer: CrosswordTextBox };\n440\texport type CrosswordLayout = {\n441\t  mode: \"landscape\" | \"portrait\" | \"square\";\n442\t  margin: number;\n443\t  gutter: number;\n444\t  board: CrosswordBoard;\n445\t  /** Where the caption copy lives (for the no-overlap assertion). */\n446\t  panel: CrosswordRect;\n447\t  texts: CrosswordTextBox[];\n448\t  themeLines: CrosswordThemeLine[];\n449\t};\n450\t\n451\t/**\n452\t * The card's geometry from ctx.target alone. Margin ~3.6% of the short side;\n453\t * the board-to-panel gutter is twice that. Landscape: board left, full height,\n454\t * copy in a column. Portrait: header over a full-width board, list and caption\n455\t * under it. Between: board on top, caption strip under it.\n456\t */\n457\texport function layoutCrosswordCard(p: CrosswordNormalized, W: number, H: number): CrosswordLayout {\n458\t  const { rows, cols } = p.pz;\n459\t  const S = Math.min(W, H), a = W / H;\n460\t  const margin = Math.round(S * 0.036), gutter = 2 * margin;\n461\t  const mode = a >= 1.25 ? \"landscape\" : a <= 0.8 ? \"portrait\" : \"square\";\n462\t  const floorPx = Math.max(8, Math.round(S * 0.013));\n463\t  const titleFloor = Math.max(9, Math.round(S * 0.022));\n464\t  const texts: CrosswordTextBox[] = [];\n465\t  const themeLines: CrosswordThemeLine[] = [];\n466\t  const showThemes = p.solved && p.themes.length > 0;\n467\t\n468\t  const place = (label: string, text: string, x: number, y: number, w: number, maxH: number, maxPx: number, floor: number, lineOptions: number[], opts: Partial<CrosswordTextBox> = {}) => {\n469\t    const bold = opts.bold === true;\n470\t    const f = fit(text, w, maxH, maxPx, floor, lineOptions, bold);\n471\t    const box: CrosswordTextBox = { label, rect: rect(x, y, w, blockH(f.px, f.lines.length)), text: f.lines.join(\"\\n\"), px: f.px, width: f.width, bold, color: INK, hAlign: \"left\", vAlign: \"middle\", ...opts };\n472\t    texts.push(box);\n473\t    return box;\n474\t  };\n475\t\n476\t  /** Place a fitted pair at (x, y): lead and tail top-aligned, each its own cell (the bare prop value is bound). */\n477\t  const pair = (P: Pair, x: number, y: number, w: number, lead: { label: string; text: string; color: MosaicColor; bold: boolean; bind?: CrosswordTextBox[\"bind\"] }, tail: { label: string; color: MosaicColor; bind?: CrosswordTextBox[\"bind\"] }) => {\n478\t    texts.push({ label: lead.label, rect: rect(x, y, leadBoxW(P.leadW), blockH(P.px, 1)), text: lead.text, px: P.px, width: P.leadW, bold: lead.bold, color: lead.color, hAlign: \"left\", vAlign: \"top\", ...(lead.bind ? { bind: lead.bind } : {}) });\n479\t    const tx = x + P.tailX, ty = P.stacked ? y + blockH(P.px, 1) : y;\n480\t    texts.push({ label: tail.label, rect: rect(tx, ty, x + w - tx, blockH(P.px, P.tail.length)), text: P.tail.join(\"\\n\"), px: P.px, width: Math.max(...P.tail.map((l) => widthOf(l, P.px))), bold: false, color: tail.color, hAlign: \"left\", vAlign: \"top\", ...(tail.bind ? { bind: tail.bind } : {}) });\n481\t  };\n482\t  const byline = (P: Pair, x: number, y: number, w: number) => pair(P, x, y, w, { label: \"byline-by\", text: \"by\", color: DIM, bold: false }, { label: \"byline\", color: INK, bind: \"author\" });\n483\t  const bylineFit = (w: number, maxH: number, maxPx: number) => pairFit(\"by\", false, p.author, p.author, w, maxH, maxPx, floorPx, [\"line\", \"wrap\"]);\n484\t  /**\n485\t   * The caption line as three cells - publication, date, the rest - so the two\n486\t   * that show a prop are each its own handle. One line, or the date and the\n487\t   * rest on a second line under the publication; the largest size that fits.\n488\t   */\n489\t  const metaFit = (w: number, maxH: number, maxPx: number): MetaFit => {\n490\t    const at = (px: number, stacked: boolean, force: boolean): MetaFit | null => {\n491\t      const lh = blockH(px, 1);\n492\t      const date = stacked ? p.metaDate : `| ${p.metaDate}`, tail = `| ${p.metaTail}`;\n493\t      const pubW = widthOf(p.publication, px, true), dateW = widthOf(date, px), tailW = widthOf(tail, px);\n494\t      // Fit on the solved card's tail so the teaser's shorter \"puzzle\" lands at the same size and place.\n495\t      const fitW = Math.max(tailW, widthOf(`| ${p.pz.cols}x${p.pz.rows} | solution`, px));\n496\t      // The next cell starts one space after this one's ink, as the brief's single-spaced line reads;\n497\t      // the boxes overlap by the fit's slack, which is transparent.\n498\t      const step = (segW: number) => Math.round(segW + widthOf(\" \", px));\n499\t      const x1 = stacked ? 0 : step(pubW), dy = stacked ? lh : 0, x2 = x1 + step(dateW);\n500\t      const height = stacked ? 2 * lh : lh;\n501\t      if (!force && (pubW > budget(w) || w - x2 < 2 * px || fitW > budget(w - x2) || height > maxH)) return null;\n502\t      return {\n503\t        px,\n504\t        height,\n505\t        cells: [\n506\t          { text: p.publication, bold: true, dx: 0, dy: 0, w: leadBoxW(pubW), width: pubW },\n507\t          { text: date, bold: false, dx: x1, dy, w: leadBoxW(dateW), width: dateW },\n508\t          { text: tail, bold: false, dx: x2, dy, w: Math.max(1, w - x2), width: tailW },\n509\t        ],\n510\t      };\n511\t    };\n512\t    for (const [lo, hi] of [[floorPx, Math.max(floorPx, Math.floor(maxPx))], [6, floorPx - 1]]) {\n513\t      for (const stacked of [false, true]) for (let px = hi; px >= lo; px--) { const hit = at(px, stacked, false); if (hit) return hit; }\n514\t    }\n515\t    return at(6, true, true) as MetaFit;\n516\t  };\n517\t  const meta = (M: MetaFit, x: number, y: number) => {\n518\t    const cell = (c: MetaCell, label: string, color: MosaicColor, bind?: CrosswordTextBox[\"bind\"]) =>\n519\t      texts.push({ label, rect: rect(x + c.dx, y + c.dy, c.w, blockH(M.px, 1)), text: c.text, px: M.px, width: c.width, bold: c.bold, color, hAlign: \"left\", vAlign: \"top\", ...(bind ? { bind } : {}) });\n520\t    cell(M.cells[0], \"meta-publication\", INK, \"publication\");\n521\t    cell(M.cells[1], \"meta-date\", DIM, \"date\");\n522\t    cell(M.cells[2], \"meta\", DIM);\n523\t  };\n524\t\n525\t  /** The theme list as one block: heading + lines, `perCol` lines per sub-column. Returns its height. */\n526\t  const themeBlock = (x: number, y: number, w: number, h: number, maxPx: number, subCols: number, dryRun: boolean): number => {\n527\t    if (!showThemes) return 0;\n528\t    const n = p.themes.length, perCol = Math.ceil(n / subCols);\n529\t    const colGap = Math.round(S * 0.03);\n530\t    const colW = (w - (subCols - 1) * colGap) / subCols;\n531\t    const idText = (t: CrosswordEntry) => t.id;\n532\t    // One size for every line: the largest that fits every line's width and the block's height.\n533\t    let px = Math.floor(maxPx);\n534\t    const lineW = (q: number) => Math.max(...p.themes.map((t) => Math.round(q * 0.75) + Math.round(q * 0.5) + Math.max(...p.themes.map((u) => widthOf(idText(u), q))) + Math.round(q * 0.6) + widthOf(t.answer, q, true)));\n535\t    const pitchOf = (q: number) => Math.max(blockH(q, 1), Math.round(q * 1.55));\n536\t    const headPx = (q: number) => Math.max(floorPx, Math.round(q * 0.72));\n537\t    while (px > 6 && (lineW(px) > budget(colW) || blockH(headPx(px), 1) + Math.round(px * 0.35) + perCol * pitchOf(px) > h)) px--;\n538\t    const hp = headPx(px), pitch = pitchOf(px);\n539\t    const total = blockH(hp, 1) + Math.round(px * 0.35) + perCol * pitch;\n540\t    // Too small a canvas for the list even at 6 px: drop it (the tint still marks the entries) rather than overflow.\n541\t    if (total > h) return 0;\n542\t    if (dryRun) return total;\n543\t    place(\"theme-heading\", \"THEME ANSWERS\", x, y, w, blockH(hp, 1), hp, Math.min(hp, floorPx), [1], { bold: true, color: DIM });\n544\t    const idW = Math.max(...p.themes.map((u) => widthOf(idText(u), px)));\n545\t    p.themes.forEach((t, i) => {\n546\t      const col = Math.floor(i / perCol), row = i % perCol;\n547\t      const cx = x + col * (colW + colGap);\n548\t      const ry = y + blockH(hp, 1) + Math.round(px * 0.35) + row * pitch;\n549\t      const sw = Math.round(px * 0.75);\n550\t      const swatch = rect(cx, ry + (pitch - sw) / 2, sw, sw);\n551\t      const idX = cx + sw + Math.round(px * 0.5);\n552\t      const idBox: CrosswordTextBox = { label: `theme-id-${i}`, rect: rect(idX, ry, Math.ceil((idW + 3) / 0.94) + 1, pitch), text: t.id, px, width: widthOf(t.id, px), bold: false, color: DIM, hAlign: \"left\", vAlign: \"middle\", bind: \"themeEntries\", token: p.themeSpans[i] };\n553\t      const ansX = idX + idW + Math.round(px * 0.6);\n554\t      const ansBox: CrosswordTextBox = { label: `theme-${i}`, rect: rect(ansX, ry, cx + colW - ansX, pitch), text: t.answer, px, width: widthOf(t.answer, px, true), bold: true, color: INK, hAlign: \"left\", vAlign: \"middle\" };\n555\t      texts.push(idBox, ansBox);\n556\t      themeLines.push({ swatch, id: idBox, answer: ansBox });\n557\t    });\n558\t    return total;\n559\t  };\n560\t\n561\t  let board: CrosswordBoard;\n562\t  let panel: CrosswordRect;\n563\t  if (mode === \"landscape\") {\n564\t    const s = boardSizing(cols, rows, Math.min(H - 2 * margin, (W - 2 * margin - gutter) * 0.6), H - 2 * margin);\n565\t    board = boardAt(cols, rows, s, margin, (H - s.inkH) / 2);\n566\t    const px0 = board.ink.x + board.ink.w + gutter;\n567\t    const top = Math.min(board.ink.y, margin + (H - 2 * margin) * 0.04), bottom = H - top;\n568\t    panel = rect(px0, top, W - margin - px0, bottom - top);\n569\t    const w = panel.w, x = panel.x;\n570\t    const tf = fit(p.title, w, panel.h * 0.3, S * 0.075, titleFloor, [2], true);\n571\t    const bP = bylineFit(w, panel.h * 0.12, S * 0.036);\n572\t    const mP = metaFit(w, panel.h * 0.1, S * 0.028);\n573\t    const metaH = mP.height;\n574\t    // No theme list (the PROP is empty, not merely hidden): the title block centres in the space above the caption line.\n575\t    const groupH = blockH(tf.px, tf.lines.length) + Math.round(S * 0.008) + bP.height;\n576\t    const ty = p.themes.length > 0 ? panel.y : panel.y + Math.max(0, (panel.h - metaH - gutter / 2 - groupH) / 2);\n577\t    const t = place(\"title\", p.title, x, ty, w, panel.h * 0.3, S * 0.075, titleFloor, [2], { bold: true, vAlign: \"top\", bind: \"title\" });\n578\t    const by = t.rect.y + t.rect.h + Math.round(S * 0.008);\n579\t    byline(bP, x, by, w);\n580\t    meta(mP, x, panel.y + panel.h - metaH);\n581\t    // The list sits centred in the space between the title block and the caption line.\n582\t    const free0 = by + bP.height + gutter / 2, free1 = panel.y + panel.h - metaH - gutter / 2;\n583\t    const listH = themeBlock(x, free0, w, free1 - free0, S * 0.038, 1, true);\n584\t    themeBlock(x, free0 + Math.max(0, (free1 - free0 - listH) / 2), w, free1 - free0, S * 0.038, 1, false);\n585\t  } else if (mode === \"portrait\") {\n586\t    const s = boardSizing(cols, rows, W - 2 * margin, (H - 2 * margin - 2 * gutter) * 0.6);\n587\t    const rest = H - 2 * margin - 2 * gutter - s.inkH;\n588\t    const headH = Math.round(rest * (p.themes.length > 0 ? 0.36 : 0.5));\n589\t    board = boardAt(cols, rows, s, (W - s.inkW) / 2, margin + headH + gutter);\n590\t    panel = rect(margin, margin, W - 2 * margin, H - 2 * margin);\n591\t    const x = margin, w = W - 2 * margin;\n592\t    // Header: title + byline, centred in the band above the board.\n593\t    const tf = fit(p.title, w, headH * 0.66, S * 0.085, titleFloor, [2], true);\n594\t    const bP = bylineFit(w, headH * 0.3, S * 0.04);\n595\t    const gap = Math.round(S * 0.012);\n596\t    const headUsed = blockH(tf.px, tf.lines.length) + gap + bP.height;\n597\t    const hy = margin + Math.max(0, (headH - headUsed) / 2);\n598\t    const t = place(\"title\", p.title, x, hy, w, headH * 0.66, S * 0.085, titleFloor, [2], { bold: true, bind: \"title\" });\n599\t    byline(bP, x, t.rect.y + t.rect.h + gap, w);\n600\t    // Footer: the list centred in the band under the board, the caption line at the bottom.\n601\t    const footY = board.ink.y + board.ink.h + gutter, footB = H - margin;\n602\t    const mP = metaFit(w, (footB - footY) * 0.2, S * 0.032);\n603\t    const metaH = mP.height;\n604\t    meta(mP, x, p.themes.length > 0 ? footB - metaH : footY + Math.max(0, (footB - footY - metaH) / 2));\n605\t    const free1 = footB - metaH - gutter / 2;\n606\t    const listH = themeBlock(x, footY, w, free1 - footY, S * 0.042, 1, true);\n607\t    themeBlock(x, footY + Math.max(0, (free1 - footY - listH) / 2), w, free1 - footY, S * 0.042, 1, false);\n608\t  } else {\n609\t    // The column split follows the PROP, not solved: the teaser keeps the solved card's geometry (\"nothing else moves\").\n610\t    const leftW = (W - 2 * margin) * (p.themes.length > 0 ? 0.54 : 1);\n611\t    // A title too long for one line at S/20 wraps to two, and the board gives up that second line's height.\n612\t    const tp = Math.ceil(S / 20);\n613\t    const twoLines = wrap(p.title, tp, budget(leftW), true).length > 1;\n614\t    const s = boardSizing(cols, rows, W - 2 * margin, H * 0.72 - (twoLines ? blockH(tp, 2) - blockH(tp, 1) : 0));\n615\t    board = boardAt(cols, rows, s, (W - s.inkW) / 2, margin);\n616\t    const y0 = board.ink.y + board.ink.h + gutter;\n617\t    panel = rect(margin, y0, W - 2 * margin, H - margin - y0);\n618\t    const x = panel.x;\n619\t    const mP = metaFit(leftW, panel.h * 0.3, S * 0.022);\n620\t    const metaH = mP.height;\n621\t    const bP = bylineFit(leftW, panel.h * 0.3, S * 0.028);\n622\t    const bylineH = bP.height;\n623\t    const gap = Math.round(S * 0.006);\n624\t    const titleMax = panel.h - metaH - bylineH - 2 * gap;\n625\t    const t = place(\"title\", p.title, x, panel.y, leftW, titleMax, S * 0.058, titleFloor, [2], { bold: true, vAlign: \"top\", bind: \"title\" });\n626\t    byline(bP, x, t.rect.y + t.rect.h + gap, leftW);\n627\t    meta(mP, x, panel.y + panel.h - metaH);\n628\t    if (showThemes) {\n629\t      const rx = panel.x + panel.w * 0.58, rw = panel.x + panel.w - rx;\n630\t      themeBlock(rx, panel.y, rw, panel.h, S * 0.03, p.themes.length > 4 ? 2 : 1, false);\n631\t    }\n632\t  }\n633\t  return { mode, margin, gutter, board, panel, texts, themeLines };\n634\t}\n635\t\n636\t// ---------------------------------------------------------------- drawing\n637\t\n638\tconst num = (v: number) => String(Math.round(v * 100) / 100);\n639\t\n640\t/** One svg text source holding many glyphs, each placed by a pixel offset inside its rect. */\n641\tfunction glyphRow(label: string, glyphs: Array<{ text: string; x: number; y: number }>, px: number, bold: boolean): MosaicSource {\n642\t  return {\n643\t    type: \"text\",\n644\t    rasterizer: \"svg\",\n645\t    renderMode: { kind: \"image\" },\n646\t    layers: glyphs.map((g) => ({\n647\t      content: { kind: \"literal\", text: g.text },\n648\t      style: { fontSize: px, fontColor: INK, ...(bold ? { fontWeight: \"bold\" } : {}) },\n649\t      placement: { hAlign: \"left\", vAlign: \"top\", xExpr: num(g.x), yExpr: num(g.y) },\n650\t    })),\n651\t    editor: { owner: \"template\", label },\n652\t  } as MosaicSource;\n653\t}\n654\t\n655\tconst masked = (color: MosaicColor, r: CrosswordRect, path: string, label: string): MosaicSource =>\n656\t  tag(makeColorTile(color, { mask: { kind: \"inline-mask\", localPath: path, bounds: { x: 0, y: 0, width: r.w, height: r.h } } }), label);\n657\t\n658\t/** Circle subpath; `cw` picks the winding so a pair makes an annulus under nonzero and evenodd alike. */\n659\tconst circle = (cx: number, cy: number, r: number, cw: boolean) =>\n660\t  `M${num(cx - r)} ${num(cy)}a${num(r)} ${num(r)} 0 1 ${cw ? 1 : 0} ${num(2 * r)} 0a${num(r)} ${num(r)} 0 1 ${cw ? 1 : 0} ${num(-2 * r)} 0z`;\n661\t\n662\texport type CrosswordDrawn = { pieces: Array<{ rect: CrosswordRect & { importance: number }; source: MosaicSource }>; layout: CrosswordLayout; constraints: LayoutConstraint[]; relations: RelationalConstraint[] };\n663\t\n664\texport function drawCrosswordCard(p: CrosswordNormalized, W: number, H: number): CrosswordDrawn {\n665\t  const L = layoutCrosswordCard(p, W, H);\n666\t  const { pz } = p;\n667\t  const B = L.board;\n668\t  const pieces: CrosswordDrawn[\"pieces\"] = [];\n669\t  const add = (r: CrosswordRect, importance: number, source: MosaicSource) => pieces.push({ rect: { ...r, importance }, source });\n670\t  const ink = B.ink;\n671\t  const local = (r: CrosswordRect) => ({ x: r.x - ink.x, y: r.y - ink.y, w: r.w, h: r.h });\n672\t\n673\t  // 1. paper under the whole board.\n674\t  add(ink, 1, tag(makeColorTile(PAPER), \"board-paper\"));\n675\t  // 2. theme tint: the lattice cells of every theme entry (a crossing cell once).\n676\t  const themeCells = [...new Set(p.solved ? p.themes.flatMap((t) => t.cells) : [])].sort((a, b) => a - b);\n677\t  if (themeCells.length > 0) {\n678\t    const path = themeCells.map((i) => {\n679\t      const r = Math.floor(i / pz.cols), c = i % pz.cols;\n680\t      const q = local({ x: B.X[c], y: B.Y[r], w: B.X[c + 1] - B.X[c], h: B.Y[r + 1] - B.Y[r] });\n681\t      return `M${q.x} ${q.y}h${q.w}v${q.h}h${-q.w}z`;\n682\t    }).join(\"\");\n683\t    add(ink, 2, masked(p.themeColor, ink, path, \"theme-tint\"));\n684\t  }\n685\t  // 3. ink: the board minus every paper cell = the border, the rules and the blocks in one path.\n686\t  const holes = pz.cells.map((ch, i) => (ch === null ? \"\" : (() => { const q = local(B.hole(i)); return `M${q.x} ${q.y}v${q.h}h${q.w}v${-q.h}z`; })())).join(\"\");\n687\t  // The board is the puzzle's handle: a double-click opens the grid first, then what marks it.\n688\t  const marks = p.solved ? [{ propKey: \"grid\" }, { propKey: \"themeEntries\" }, { propKey: \"circles\" }, { propKey: \"themeColor\" }] : [{ propKey: \"grid\" }, { propKey: \"circles\" }];\n689\t  add(ink, 3, bindProps(masked(INK, ink, `M0 0H${ink.w}V${ink.h}H0Z${holes}`, \"board\"), marks));\n690\t  // 4. rings, over the tint and under the letter.\n691\t  if (p.circles.length > 0) {\n692\t    const path = p.circles.map((i) => {\n693\t      const q = local(B.hole(i));\n694\t      const ro = Math.min(q.w, q.h) / 2 - Math.max(0.5, B.pitch * 0.02);\n695\t      const t = Math.max(1, B.pitch * 0.035);\n696\t      return circle(q.x + q.w / 2, q.y + q.h / 2, ro, true) + circle(q.x + q.w / 2, q.y + q.h / 2, ro - t, false);\n697\t    }).join(\"\");\n698\t    add(ink, 4, masked(INK, ink, path, \"rings\"));\n699\t    // A knockout in the cell's own fill behind a clue number that sits on a ring, as solving apps do.\n700\t    if (B.numberPx > 0) {\n701\t      const tinted = new Set(themeCells);\n702\t      const knock: Record<\"paper\" | \"theme\", string[]> = { paper: [], theme: [] };\n703\t      for (const i of p.circles) {\n704\t        const n = p.numbers.get(i);\n705\t        if (n === undefined) continue;\n706\t        const q = local(B.hole(i));\n707\t        const w = Math.ceil(Math.max(1, q.w * 0.07) + widthOf(String(n), B.numberPx) + q.w * 0.03);\n708\t        const h = Math.ceil(q.h * 0.06 + 0.711 * B.numberPx + q.h * 0.04);\n709\t        knock[tinted.has(i) ? \"theme\" : \"paper\"].push(`M${q.x} ${q.y}h${w}v${h}h${-w}z`);\n710\t      }\n711\t      if (knock.paper.length > 0) add(ink, 5, masked(PAPER, ink, knock.paper.join(\"\"), \"number-knockout\"));\n712\t      if (knock.theme.length > 0) add(ink, 6, masked(p.themeColor, ink, knock.theme.join(\"\"), \"number-knockout\"));\n713\t    }\n714\t  }\n715\t  // 7-8. numbers and letters: ONE source each over the lattice, every glyph placed on it. A source\n716\t  // per row would stack 2 x rows overlays at the root, and past ~25 the engine drops inline masks.\n717\t  const band: CrosswordRect = { x: B.X[0], y: B.Y[0], w: B.X[pz.cols] - B.X[0], h: B.Y[pz.rows] - B.Y[0] };\n718\t  const nums: Array<{ text: string; x: number; y: number }> = [];\n719\t  const lets: Array<{ text: string; x: number; y: number }> = [];\n720\t  pz.cells.forEach((ch, i) => {\n721\t    if (ch === null) return;\n722\t    const h = B.hole(i);\n723\t    const n = p.numbers.get(i);\n724\t    if (n !== undefined && B.numberPx > 0) {\n725\t      nums.push({ text: String(n), x: h.x - band.x + Math.max(1, h.w * 0.07), y: Math.max(0, h.y - band.y + h.h * 0.06 - CAP_TOP_EM * B.numberPx) });\n726\t    }\n727\t    if (p.solved) {\n728\t      lets.push({ text: ch, x: h.x - band.x + (h.w - widthOf(ch, B.letterPx, true)) / 2, y: Math.max(0, h.y - band.y + h.h * 0.57 - CAP_MID_EM * B.letterPx) });\n729\t    }\n730\t  });\n731\t  if (nums.length > 0) add(band, 7, glyphRow(\"cell-number\", nums, B.numberPx, false));\n732\t  if (lets.length > 0) add(band, 8, glyphRow(\"cell-letter\", lets, B.letterPx, true));\n733\t  // The caption copy and the list swatches.\n734\t  for (const t of L.texts) {\n735\t    const src = tag(textCell({ text: t.text, fontSize: t.px, color: t.color, hAlign: t.hAlign, vAlign: t.vAlign, bold: t.bold, label: t.label }), t.label);\n736\t    const raw = t.bind === \"themeEntries\" ? String(p.themeEntries) : \"\";\n737\t    add(t.rect, 1, !t.bind ? src : t.token ? bindPropRange(src, t.bind, undefined, { start: 0, end: raw.length }, t.token) : bindProp(src, t.bind));\n738\t  }\n739\t  for (const line of L.themeLines) add(line.swatch, 1, bindProp(tag(makeColorTile(p.themeColor), \"theme-swatch\"), \"themeColor\"));\n740\t\n741\t  // The contract: every text fits (measured), the board keeps its shape and size.\n742\t  const constraints: LayoutConstraint[] = L.texts.map((t) => textFitsMeasured(t.label, t.text, t.px, t.width));\n743\t  if (p.solved) constraints.push(textFitsMeasured(\"cell-letter\", \"W\", B.letterPx, widthOf(\"W\", B.letterPx, true)));\n744\t  if (B.numberPx > 0 && p.numbers.size > 0) {\n745\t    const widest = String(Math.max(...p.numbers.values()));\n746\t    constraints.push(textFitsMeasured(\"cell-number\", widest, B.numberPx, widthOf(widest, B.numberPx)));\n747\t  }\n748\t  // The designed shape: the lattice plus its border (a 25x3 is not 25/3 once the border is on), within 2%.\n749\t  const shape = (pz.cols * B.pitch - B.rule + 2 * B.border) / (pz.rows * B.pitch - B.rule + 2 * B.border);\n750\t  constraints.push({ label: \"board\", aspect: shape, aspectTolerance: 0.02 * Math.max(shape, 1 / shape), ...(pz.cols === pz.rows ? { minWidthFrac: 0.45, minHeightFrac: 0.45 } : {}) });\n751\t  if (L.themeLines.length > 0) constraints.push({ label: \"theme-swatch\", aspect: 1, aspectTolerance: 0.2 });\n752\t  const relations: RelationalConstraint[] = [];\n753\t  // The cells are not rects (they are holes in one mask), so equal cells are the test's to assert, from the lattice lines.\n754\t  if (L.themeLines.length >= 2) relations.push({ label: \"theme-swatch\", equal: \"size\", tolerance: 0.02, tolerancePx: 1 } as RelationalConstraint);\n755\t  return { pieces, layout: L, constraints, relations };\n756\t}\n757\t\n758\t// ---------------------------------------------------------------- the story\n759\t\n760\t/**\n761\t * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n762\t * convention, src/_shared/why.ts): the run, the problem with the sources the\n763\t * agent opened, the solution, how to use it, then the template itself.\n764\t */\n765\tconst WHY: WhySpec = {\n766\t  \"day\": 10,\n767\t  \"date\": \"2026-09-29\",\n768\t  \"agent\": \"claude\",\n769\t  \"model\": \"claude-opus-5-5\",\n770\t  \"id\": \"@one-a-day/gaming/crossword-grid-card/v1\",\n771\t  \"title\": \"Crossword Grid Card\",\n772\t  \"who\": \"Crossword bloggers who post the solved grid atop every write-up (Crossword Fiend, NYT to Universal) and indie constructors posting a weekly .puz\",\n773\t  \"problem\": [\n774\t    \"Every Crossword Fiend write-up opens with a picture of the solved grid, and each one is a screenshot or phone photo of whatever app the reviewer solved in: Screenshot-2026-09-22-213516.png, IMG_2411.jpeg, grid.png, wpsol092726.png. Size, style and app chrome change from grid to grid.\",\n775\t    \"The caption under it is typed by hand (\\\"WSJ * 9/22/26 * Tues * \\\"Variety Pack\\\" * Zhoukin Burnikel * solution * 20260922\\\"), and because the picture cannot mark the theme, every post retypes a separate \\\"THEME ANSWERS:\\\" list. The .puz file holding all of it sits on the same site.\",\n776\t  ],\n777\t  \"sources\": [\n778\t    \"https://crosswordfiend.com/2026/09/21/tuesday-september-22-2026/\",\n779\t    \"https://crosswordfiend.com/2026/09/24/friday-september-25-2026/\",\n780\t    \"https://crosswordfiend.com/2026/09/26/sunday-september-27-2026/\",\n781\t    \"https://crosswordfiend.com/download/\",\n782\t    \"https://crosshare.org/crosswords/pJMezWuZ6oRSxfHehRTw/wanting-for-winter\",\n783\t    \"https://github.com/alexdej/puzpy\",\n784\t    \"https://github.com/viresh-ratnakar/exet\"\n785\t  ],\n786\t  \"solution\": [\n787\t    \"Paste the solution rows from the puzzle file (for a square grid, puzpy's p.solution pastes as is). The card derives the clue numbers, reads each theme answer from the grid, tints it and lists it, and writes the caption line, so every grid on a blog matches. solved=false hides the letters for a new-puzzle teaser.\",\n788\t    \"The decision that matters: the board is a few masked layers (paper, theme tint, ink with the paper cells cut out, rings) plus one text source for every letter and one for every number, all on one integer lattice. A 25x25 takes no more layers than a 7x7 (8 at most), and every size from 3 to 25 renders the same way.\",\n789\t  ],\n790\t  \"usage\": {\n791\t    \"command\": \"m0saic make @one-a-day/gaming/crossword-grid-card/v1 --template-repo . -w 1080 -h 1080 -o grid.png\",\n792\t    \"try\": [\n793\t      \"grid: rows split by \\\"/\\\" (\\\"#\\\" or \\\".\\\" is a block); a square grid's unbroken .puz string also works\",\n794\t      \"themeEntries: \\\"17A 38A 61A\\\" - the ids your write-up already lists\",\n795\t      \"circles: \\\"14 15 16\\\" - 0-based cell indices, the .puz order\",\n796\t      \"--props '{\\\"solved\\\":false}' - the new-puzzle teaser: no letters, tint or answers\"\n797\t    ]\n798\t  },\n799\t  \"caveats\": [\n800\t    \"No .puz parser: paste the solution rows. A rebus square shows its first letter (what the .puz solution string holds), and shaded squares are not drawn.\",\n801\t    \"Grids 3 to 25 cells each way; paste a non-square grid as rows split by \\\"/\\\". Clue numbers are dropped below 6 px, so a 15x15 at 480x270 shows letters only.\",\n802\t    \"A still card: no clue text and no fill-in animation yet.\"\n803\t  ],\n804\t  \"timeline\": {\n805\t    \"source\": \"runner\",\n806\t    \"phases\": [\n807\t      {\n808\t        \"name\": \"scout\",\n809\t        \"startMs\": 0,\n810\t        \"durMs\": 701073,\n811\t        \"calls\": 41,\n812\t        \"tokens\": 8010625,\n813\t        \"costUsd\": 9.8,\n814\t        \"tools\": \"Bash 25, WebSearch 6, WebFetch 3\"\n815\t      },\n816\t      {\n817\t        \"name\": \"plan\",\n818\t        \"startMs\": 701118,\n819\t        \"durMs\": 525743,\n820\t        \"calls\": 24,\n821\t        \"tokens\": 4086662,\n822\t        \"costUsd\": 6.46,\n823\t        \"tools\": \"Bash 19, Read 1, TaskStop 1\"\n824\t      }\n825\t    ],\n826\t    \"costBasis\": \"reported\"\n827\t  }\n828\t};\n829\t\n830\texport const CrosswordGridCardV1 = defineMosaicTemplate<CrosswordGridCardProps>({\n831\t  id: asTemplateId(ID),\n832\t  label: \"2026-09-29 · Crossword Grid Card\",\n833\t  version: 1,\n834\t  description: \"Crossword Grid Card: the solved grid for a crossword write-up from the puzzle's own fields - blocks, derived clue numbers, circles, theme entries tinted and listed, and the caption line. solved=false makes the teaser.\",\n835\t  capabilities: { tier: \"core\" },\n836\t  tags: [\"gaming\", \"2026-09-29\", \"day-010\", \"crossword\", \"puzzle\", \"share-card\"],\n837\t\n838\t  outputHints: {\n839\t    width: 1080,\n840\t    height: 1080,\n841\t    fps: 30,\n842\t    durationMs: 2000,\n843\t    format: { kind: \"image\", container: \"png\" },\n844\t    note: \"Static card - square for the top of a write-up; 1920x1080 and 1080x1920 lay out for link shares and stories.\",\n845\t  },\n846\t\n847\t  propsSchema,\n848\t  defaultProps: { ...CROSSWORD_DEFAULTS },\n849\t\n850\t  render,\n851\t  renderTutorial: whyTutorial(WHY, render),\n852\t});\n853\t\n854\texport default CrosswordGridCardV1;\n855\t\n856\tasync function render(props: CrosswordGridCardProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n857\t  // The schema is documentation; render() is the gate.\n858\t  const p = normalizeCrossword(props);\n859\t  const W = Math.max(1, Math.round(ctx.target.width));\n860\t  const H = Math.max(1, Math.round(ctx.target.height));\n861\t  const { pieces, constraints, relations } = drawCrosswordCard(p, W, H);\n862\t  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n863\t  const doc: MosaicDocument = {\n864\t    kind: \"mosaic_document\",\n865\t    version: 1,\n866\t    m0: toM0String(placed.m0, ID),\n867\t    assets: {},\n868\t    backgroundColor: PAGE,\n869\t    sources: placed.sources,\n870\t  };\n871\t  return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: p.debugLayout === true });\n872\t}\n873\t"}]},"parent_tool_use_id":null,"session_id":"af1c23bb-6b01-433b-b16a-de6cab8056e5","uuid":"cfea98b2-b27b-423b-b16d-d4ccf1955765","timestamp":"2026-09-29T15:40:03.392Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\gaming\\crossword-grid-card\\v1\\crossword-grid-card.ts","content":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, bindPropRange, bindProps, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/gaming/crossword-grid-card/v1` - the solved crossword grid a\n * blogger puts atop a write-up, drawn from the puzzle file's own fields\n * instead of a screenshot of the solving app: blocks, derived clue numbers,\n * letters, circled squares, the theme entries tinted and listed, and the\n * caption line. With `solved: false` it is a constructor's new-puzzle teaser.\n *\n * ONE CONCEPT: a lattice this big is drawn in LAYERS, not cells. The board is\n * a paper tile, a theme tile and an ink tile masked to \"board minus paper\n * cells\" (border, rules and blocks in one path), a ring tile, and one\n * multi-layer text source for all the letters and one for all the numbers\n * (each glyph placed by a pixel xExpr/yExpr). Any size is under 40 frames and\n * about 8 overlays deep. Per-cell grids would be 1,500+ frames at 25x25, past\n * the engine's 400-frame budget; a text source per row stacks past the ~25\n * overlays where the engine silently degrades inline masks.\n *\n * The rule that bites: equal cells come from ONE integer lattice,\n * `X_k = round(x0 + k * pitch)`, that every layer reads - the mask holes, the\n * tint cells, the glyph offsets. Compute any of them from its own rounding\n * and the rules drift off the letters by a pixel per cell.\n */\n\nexport type CrosswordGridCardProps = {\n  /** The solution: rows split by \"/\" or newlines, \"#\" or \".\" for a block, A-Z; an unbroken square string reads as n x n. */\n  grid?: string;\n  /** Clue ids to tint and list (\"17A 3D\"), spaces or commas. \"\" = none. */\n  themeEntries?: string;\n  /** 0-based row-major cell indices to ring (the .puz order). \"\" = none. */\n  circles?: string;\n  /** CrosswordPuzzle title, 1-40 printable ASCII. */\n  title?: string;\n  /** Constructor(s), 1-48 printable ASCII; shown as \"by <author>\". */\n  author?: string;\n  /** Outlet or series for the caption line, 1-24 printable ASCII. */\n  publication?: string;\n  /** CrosswordPuzzle date, YYYY-MM-DD. */\n  date?: string;\n  /** false = the teaser: no letters, no theme tint, no answer list. */\n  solved?: boolean;\n  /** Theme-cell fill and list swatches (#rrggbb). Never used as text ink. */\n  themeColor?: string;\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/gaming/crossword-grid-card/v1\";\nconst HEX = /^#[0-9a-fA-F]{6}$/;\nconst PAGE = \"#F2EFE8\" as MosaicColor;\nconst PAPER = \"#FFFFFF\" as MosaicColor;\nconst INK = \"#15171C\" as MosaicColor;\nconst DIM = \"#5E626B\" as MosaicColor;\nconst MIN_SIDE = 3;\nconst MAX_SIDE = 25;\nconst MAX_THEMES = 8;\nconst MAX_CIRCLES = 120;\nconst LETTER_EM = 0.6;\nconst NUMBER_EM = 0.28;\nconst NUMBER_FLOOR_PX = 6;\n/** Roboto: ascent 0.928 em, cap height 0.711 em - where the ink sits under a top-aligned layer. */\nconst CAP_TOP_EM = 0.928 - 0.711;\nconst CAP_MID_EM = CAP_TOP_EM + 0.711 / 2;\n\nexport const CROSSWORD_DEFAULTS = {\n  grid: \"PAN#BOW/AGE#ARE/DOGSLED/##AIL##/CATNAPS/OWE#SAT/YES#TRY\",\n  themeEntries: \"9A 12A\",\n  circles: \"14 15 16 28 29 30\",\n  title: \"Cats and Dogs\",\n  author: \"one-a-day agent\",\n  publication: \"Demo Mini\",\n  date: \"2026-09-29\",\n  solved: true,\n  themeColor: \"#FFE08A\",\n  debugLayout: false,\n} as const;\n\nconst propsSchema = definePropsSchema<CrosswordGridCardProps>({\n  grid: {\n    type: \"string\",\n    required: false,\n    description: 'The solution grid. Rows split by \"/\" or newlines; \"#\" or \".\" is a block; letters A-Z (uppercase). 3-25 cells each way, rows of equal length. An unbroken string whose length is a square (the .puz solution string, puzpy p.solution) is read as n x n.',\n    meta: { control: { multiline: true, placeholder: CROSSWORD_DEFAULTS.grid }, ui: { label: \"Grid (solution rows)\", order: 1 } },\n  },\n  themeEntries: {\n    type: \"string\",\n    required: false,\n    description: 'Clue ids to tint and list, e.g. \"17A 38A 3D\" (spaces or commas). Each must exist in the grid numbering; at most 8. \"\" for none.',\n    meta: { control: { placeholder: \"17A 38A 61A\" }, ui: { label: \"Theme entries\", order: 2 } },\n  },\n  circles: {\n    type: \"string\",\n    required: false,\n    description: 'Circled squares as 0-based row-major cell indices (the .puz order), spaces or commas; each must be a white cell. \"\" for none.',\n    meta: { control: { placeholder: \"14 15 16\" }, ui: { label: \"Circled squares\", order: 3 } },\n  },\n  title: {\n    type: \"string\",\n    required: false,\n    description: \"CrosswordPuzzle title, 1-40 printable ASCII characters. The rect that shows it is bound to it.\",\n    meta: { control: { placeholder: CROSSWORD_DEFAULTS.title }, ui: { label: \"Title\", order: 4 } },\n  },\n  author: {\n    type: \"string\",\n    required: false,\n    description: 'Constructor(s), 1-48 printable ASCII characters; drawn as \"by <author>\".',\n    meta: { control: { placeholder: CROSSWORD_DEFAULTS.author }, ui: { label: \"Author\", order: 5 } },\n  },\n  publication: {\n    type: \"string\",\n    required: false,\n    description: \"Outlet or series for the caption line, 1-24 printable ASCII characters.\",\n    meta: { control: { placeholder: CROSSWORD_DEFAULTS.publication }, ui: { label: \"Publication\", order: 6 } },\n  },\n  date: {\n    type: \"string\",\n    required: false,\n    description: \"CrosswordPuzzle date as YYYY-MM-DD; the caption shows the weekday and M/D/YY.\",\n    meta: { control: { placeholder: CROSSWORD_DEFAULTS.date }, ui: { label: \"Date\", order: 7 } },\n  },\n  solved: {\n    type: \"boolean\",\n    required: false,\n    description: \"true = the solution card. false = the new-puzzle teaser: blocks, numbers and circles only; letters, theme tint and answers are hidden.\",\n    meta: { ui: { label: \"Show solution\", order: 8 } },\n  },\n  themeColor: {\n    type: \"string\",\n    required: false,\n    description: \"Theme-cell fill and list swatches as #rrggbb. Letters stay in ink.\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: CROSSWORD_DEFAULTS.themeColor }, ui: { label: \"Theme color\", order: 9 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits, the board keeps its shape) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n// ---------------------------------------------------------------- the puzzle\n\nfunction fail(field: string, rule: string): never {\n  throw new Error(`${ID}: ${field} ${rule}`);\n}\n\nexport type CrosswordPuzzle = {\n  rows: number;\n  cols: number;\n  /** Row-major; null is a block. */\n  cells: Array<string | null>;\n};\n\n/** Parse the grid prop. Every refusal names the field, and for a cell its row and column (1-based). */\nexport function parseCrosswordGrid(raw: unknown): CrosswordPuzzle {\n  if (typeof raw !== \"string\") fail(\"grid\", \"must be a string of rows.\");\n  const text = raw.trim();\n  let lines = text.split(/\\s*[/\\r\\n]+\\s*/).filter((l) => l.length > 0);\n  if (lines.length === 1) {\n    const n = Math.round(Math.sqrt(lines[0].length));\n    if (n * n === lines[0].length && n >= MIN_SIDE) lines = Array.from({ length: n }, (_, r) => lines[0].slice(r * n, (r + 1) * n));\n  }\n  if (lines.length < MIN_SIDE || lines.length > MAX_SIDE) fail(\"grid\", `must have ${MIN_SIDE}-${MAX_SIDE} rows (got ${lines.length}); split rows with \"/\" or newlines.`);\n  const cols = lines[0].length;\n  if (cols < MIN_SIDE || cols > MAX_SIDE) fail(\"grid\", `rows must have ${MIN_SIDE}-${MAX_SIDE} cells (row 1 has ${cols}).`);\n  const cells: Array<string | null> = [];\n  lines.forEach((line, r) => {\n    if (line.length !== cols) fail(\"grid\", `row ${r + 1} has ${line.length} cells but row 1 has ${cols}; every row must be the same length.`);\n    for (let c = 0; c < cols; c++) {\n      const ch = line[c];\n      if (ch === \"#\" || ch === \".\") cells.push(null);\n      else if (ch >= \"A\" && ch <= \"Z\") cells.push(ch);\n      else if (ch >= \"a\" && ch <= \"z\") fail(\"grid\", `row ${r + 1} column ${c + 1} is lowercase \"${ch}\"; letters must be A-Z (the .puz solution is uppercase).`);\n      else fail(\"grid\", `row ${r + 1} column ${c + 1} is ${JSON.stringify(ch)}; use A-Z for letters and \"#\" or \".\" for a block.`);\n    }\n  });\n  if (!cells.some((c) => c !== null)) fail(\"grid\", \"must have at least one white cell.\");\n  return { rows: lines.length, cols, cells };\n}\n\nexport type CrosswordEntry = { id: string; number: number; dir: \"A\" | \"D\"; cells: number[]; answer: string };\n\n/**\n * The standard American numbering: a white cell takes the next number when it\n * starts an across entry (left is edge or block, right is white) or a down\n * entry (above is edge or block, below is white). Left to right, top to bottom.\n * Unchecked cells (British style) simply start nothing.\n */\nexport function numberCrosswordGrid(pz: CrosswordPuzzle): { numbers: Map<number, number>; entries: Map<string, CrosswordEntry> } {\n  const { rows, cols, cells } = pz;\n  const white = (r: number, c: number) => r >= 0 && r < rows && c >= 0 && c < cols && cells[r * cols + c] !== null;\n  const numbers = new Map<number, number>();\n  const entries = new Map<string, CrosswordEntry>();\n  let n = 0;\n  for (let r = 0; r < rows; r++) {\n    for (let c = 0; c < cols; c++) {\n      if (!white(r, c)) continue;\n      const across = !white(r, c - 1) && white(r, c + 1);\n      const down = !white(r - 1, c) && white(r + 1, c);\n      if (!across && !down) continue;\n      n++;\n      numbers.set(r * cols + c, n);\n      const walk = (dir: \"A\" | \"D\") => {\n        const idx: number[] = [];\n        for (let rr = r, cc = c; white(rr, cc); dir === \"A\" ? cc++ : rr++) idx.push(rr * cols + cc);\n        entries.set(`${n}${dir}`, { id: `${n}${dir}`, number: n, dir, cells: idx, answer: idx.map((i) => cells[i]).join(\"\") });\n      };\n      if (across) walk(\"A\");\n      if (down) walk(\"D\");\n    }\n  }\n  return { numbers, entries };\n}\n\nfunction tokens(raw: unknown, field: string): string[] {\n  if (typeof raw !== \"string\") fail(field, 'must be a string (spaces or commas between items; \"\" for none).');\n  return raw.split(/[\\s,]+/).filter((t) => t.length > 0);\n}\n\nfunction ascii(raw: unknown, field: string, max: number): string {\n  if (typeof raw !== \"string\" || /[^\\x20-\\x7e]/.test(raw)) fail(field, \"must be printable ASCII text.\");\n  const s = raw.trim().replace(/\\s+/g, \" \");\n  if (s.length < 1 || s.length > max) fail(field, `must have 1-${max} characters (got ${s.length}).`);\n  return s;\n}\n\n/** WCAG contrast ratio of two #rrggbb colours. */\nfunction contrast(a: string, b: string): number {\n  const lum = (hex: string) => {\n    const [r, g, bl] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));\n    return 0.2126 * r + 0.7152 * g + 0.0722 * bl;\n  };\n  const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);\n  return (hi + 0.05) / (lo + 0.05);\n}\n\nconst WEEKDAYS = [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"];\n\n/** Weekday by calendar arithmetic (Sakamoto) - no clock, no Date. */\nfunction weekday(y: number, m: number, d: number): string {\n  const t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];\n  const yy = m < 3 ? y - 1 : y;\n  return WEEKDAYS[(yy + Math.floor(yy / 4) - Math.floor(yy / 100) + Math.floor(yy / 400) + t[m - 1] + d) % 7];\n}\n\n/** Every prop validated; a bad value fails with its field named, never falls back to the sample. */\nexport function normalizeCrossword(props: CrosswordGridCardProps) {\n  const p = { ...CROSSWORD_DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) } as Required<CrosswordGridCardProps>;\n  const pz = parseCrosswordGrid(p.grid);\n  const { numbers, entries } = numberCrosswordGrid(pz);\n\n  const themeIds = tokens(p.themeEntries, \"themeEntries\");\n  if (themeIds.length > MAX_THEMES) fail(\"themeEntries\", `may list at most ${MAX_THEMES} entries (got ${themeIds.length}).`);\n  const themes: CrosswordEntry[] = [];\n  for (const id of themeIds) {\n    if (!/^[1-9]\\d{0,2}[AD]$/.test(id)) fail(\"themeEntries\", `\"${id}\" must be a clue id like 17A or 3D.`);\n    if (themes.some((t) => t.id === id)) fail(\"themeEntries\", `lists ${id} twice.`);\n    const e = entries.get(id);\n    if (!e) fail(\"themeEntries\", `${id} is not an entry in this grid's numbering.`);\n    themes.push(e);\n  }\n\n  const circleIds = tokens(p.circles, \"circles\");\n  if (circleIds.length > MAX_CIRCLES) fail(\"circles\", `may ring at most ${MAX_CIRCLES} squares (got ${circleIds.length}).`);\n  const circles: number[] = [];\n  for (const t of circleIds) {\n    if (!/^\\d+$/.test(t)) fail(\"circles\", `\"${t}\" must be a 0-based cell index.`);\n    const i = Number(t);\n    if (i >= pz.rows * pz.cols) fail(\"circles\", `${i} is outside the ${pz.cols}x${pz.rows} grid (0-${pz.rows * pz.cols - 1}).`);\n    if (pz.cells[i] === null) fail(\"circles\", `${i} (row ${Math.floor(i / pz.cols) + 1} column ${(i % pz.cols) + 1}) is a block; only white squares are circled.`);\n    if (circles.includes(i)) fail(\"circles\", `lists ${i} twice.`);\n    circles.push(i);\n  }\n\n  const title = ascii(p.title, \"title\", 40);\n  const author = ascii(p.author, \"author\", 48);\n  const publication = ascii(p.publication, \"publication\", 24);\n  if (typeof p.date !== \"string\" || !/^\\d{4}-\\d{2}-\\d{2}$/.test(p.date)) fail(\"date\", \"must be YYYY-MM-DD.\");\n  const [y, m, d] = p.date.split(\"-\").map(Number);\n  const leap = y % 4 === 0 && (y % 100 !== 0 || y % 400 === 0);\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  if (y < 1 || m < 1 || m > 12 || d < 1 || d > days[m - 1]) fail(\"date\", `${p.date} is not a calendar date.`);\n  if (typeof p.solved !== \"boolean\") fail(\"solved\", \"must be true or false.\");\n  if (typeof p.themeColor !== \"string\" || !HEX.test(p.themeColor)) fail(\"themeColor\", `${JSON.stringify(p.themeColor)} must be #rrggbb.`);\n  const inkOnTheme = contrast(INK, p.themeColor);\n  if (inkOnTheme < 4.5) fail(\"themeColor\", `${p.themeColor} is too dark for the ink letters over it (${inkOnTheme.toFixed(1)}:1, needs 4.5:1); pick a lighter highlighter colour.`);\n  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be true or false.\");\n\n  // Where each theme id sits in the RAW prop string, so its list cell can bind that token.\n  const themeSpans = [...(p.themeEntries as string).matchAll(/[^\\s,]+/g)].map((t) => ({ start: t.index ?? 0, end: (t.index ?? 0) + t[0].length }));\n  const metaDate = `${weekday(y, m, d)} ${m}/${d}/${String(y % 100).padStart(2, \"0\")}`;\n  const metaTail = `${pz.cols}x${pz.rows} | ${p.solved ? \"solution\" : \"puzzle\"}`;\n  const metaRest = `${metaDate} | ${metaTail}`;\n  return { ...p, pz, numbers, entries, themes, themeSpans, circles, title, author, publication, meta: `${publication} | ${metaRest}`, metaRest, metaDate, metaTail, themeColor: p.themeColor as MosaicColor };\n}\n\nexport type CrosswordNormalized = ReturnType<typeof normalizeCrossword>;\n\n// ---------------------------------------------------------------- geometry\n\nexport type CrosswordRect = { x: number; y: number; w: number; h: number };\nconst rect = (x: number, y: number, w: number, h: number): CrosswordRect => {\n  const x0 = Math.round(x), y0 = Math.round(y);\n  return { x: x0, y: y0, w: Math.max(1, Math.round(x + w) - x0), h: Math.max(1, Math.round(y + h) - y0) };\n};\n\n/** Height a fitted block needs: Roboto's em box is 1.17 em (ascent + descent), each extra line 1.25 em, plus 2px. */\nconst blockH = (px: number, lines: number) => Math.ceil(px * (1.17 + 1.25 * (lines - 1))) + 2;\n\n/** Lossless line breaks: split at spaces, cut an over-long token, never drop a glyph. */\nfunction wrap(text: string, px: number, maxW: number, bold: boolean): string[] {\n  const lines: string[] = [];\n  let rest = text;\n  while (widthOf(rest, px, bold) > maxW) {\n    let n = 1;\n    while (n < rest.length && widthOf(rest.slice(0, n + 1), px, bold) <= maxW) n++;\n    const space = rest.lastIndexOf(\" \", n);\n    if (space > 0) { lines.push(rest.slice(0, space)); rest = rest.slice(space + 1); }\n    else { lines.push(rest.slice(0, n)); rest = rest.slice(n); }\n  }\n  lines.push(rest);\n  return lines;\n}\n\n/** A text cell; `bind` names the prop it shows, `token` the span of the raw prop string it shows (a theme id). */\nexport type CrosswordTextBox = { label: string; rect: CrosswordRect; text: string; px: number; width: number; bold: boolean; color: MosaicColor; hAlign: \"left\" | \"right\"; vAlign: \"top\" | \"middle\" | \"bottom\"; bind?: \"title\" | \"author\" | \"publication\" | \"date\" | \"themeEntries\"; token?: { start: number; end: number } };\n\n/**\n * The largest size (maxPx down to floorPx, then on down to 6 so the contract\n * flags it rather than the render dying) at which `text` fits `w` x `maxH` in\n * one of `lineOptions` line counts, tried in order.\n */\nfunction fit(text: string, w: number, maxH: number, maxPx: number, floorPx: number, lineOptions: number[], bold: boolean) {\n  const tryAt = (px: number, maxLines: number) => {\n    const lines = wrap(text, px, budget(w), bold);\n    if (lines.length > maxLines || blockH(px, lines.length) > maxH) return null;\n    return { lines, px, width: Math.max(...lines.map((l) => widthOf(l, px, bold))) };\n  };\n  for (const maxLines of lineOptions) {\n    for (let px = Math.max(floorPx, Math.floor(maxPx)); px >= floorPx; px--) {\n      const hit = tryAt(px, maxLines);\n      if (hit) return hit;\n    }\n  }\n  const most = Math.max(...lineOptions);\n  for (let px = floorPx - 1; px >= 6; px--) {\n    const hit = tryAt(px, most);\n    if (hit) return hit;\n  }\n  const lines = wrap(text, 6, budget(w), bold);\n  return { lines, px: 6, width: Math.max(...lines.map((l) => widthOf(l, 6, bold))) };\n}\n\n/** One cell of the caption line: its text, its offset from the line's origin, its box width and its measured ink width. */\ntype MetaCell = { text: string; bold: boolean; dx: number; dy: number; w: number; width: number };\ntype MetaFit = { px: number; height: number; cells: [MetaCell, MetaCell, MetaCell] };\n\n/** A lead cell and a tail cell sharing one size: side by side (the tail may wrap in its own column), or stacked. */\ntype Pair = { px: number; stacked: boolean; tail: string[]; leadW: number; tailX: number; height: number };\nconst leadBoxW = (w: number) => Math.ceil((w + 3) / 0.94) + 1;\n\n/**\n * The largest size at which `lead` + `tail` fit `w` x `maxH`, trying the\n * `modes` in order at each size range: \"line\" (one line), \"wrap\" (the tail\n * wraps to two lines beside the lead), \"stack\" (the tail on the next line).\n */\nfunction pairFit(lead: string, leadBold: boolean, tail: string, tailStacked: string, w: number, maxH: number, maxPx: number, floorPx: number, modes: Array<\"line\" | \"wrap\" | \"stack\">): Pair {\n  const at = (px: number, mode: \"line\" | \"wrap\" | \"stack\"): Pair | null => {\n    const leadW = widthOf(lead, px, leadBold);\n    if (mode === \"stack\") {\n      const lines = wrap(tailStacked, px, budget(w), false);\n      return leadW <= budget(w) && lines.length === 1 && 2 * blockH(px, 1) <= maxH ? { px, stacked: true, tail: lines, leadW, tailX: 0, height: 2 * blockH(px, 1) } : null;\n    }\n    const tailX = Math.max(leadBoxW(leadW), Math.round(leadW + px * 0.3));\n    if (w - tailX < 2 * px) return null;\n    const lines = wrap(tail, px, budget(w - tailX), false);\n    return lines.length <= (mode === \"line\" ? 1 : 2) && blockH(px, lines.length) <= maxH ? { px, stacked: false, tail: lines, leadW, tailX, height: blockH(px, lines.length) } : null;\n  };\n  for (const [lo, hi] of [[floorPx, Math.max(floorPx, Math.floor(maxPx))], [6, floorPx - 1]]) {\n    for (const mode of modes) for (let px = hi; px >= lo; px--) { const hit = at(px, mode); if (hit) return hit; }\n  }\n  const lines = wrap(tailStacked, 6, budget(w), false);\n  return { px: 6, stacked: true, tail: lines, leadW: widthOf(lead, 6, leadBold), tailX: 0, height: blockH(6, 1) + blockH(6, lines.length) };\n}\n\nexport type CrosswordBoard = {\n  pitch: number;\n  rule: number;\n  border: number;\n  /** Integer lattice lines: X[k] is the centre line left of column k (length cols+1). */\n  X: number[];\n  Y: number[];\n  /** The whole board as drawn: ink border included. */\n  ink: CrosswordRect;\n  /** The paper part of cell i (inside the rules). */\n  hole: (i: number) => CrosswordRect;\n  letterPx: number;\n  /** 0 when the clue numbers are dropped (below the 6px floor). */\n  numberPx: number;\n};\n\nfunction boardSizing(cols: number, rows: number, availW: number, availH: number) {\n  let pitch = Math.min(availW / cols, availH / rows);\n  for (let k = 0; k < 3; k++) {\n    const rule = Math.max(1, Math.round(pitch * 0.03));\n    const border = Math.max(2, 2 * rule, Math.round(pitch * 0.06));\n    pitch = Math.min((availW - 2 * border + rule) / cols, (availH - 2 * border + rule) / rows);\n  }\n  const rule = Math.max(1, Math.round(pitch * 0.03));\n  const border = Math.max(2, 2 * rule, Math.round(pitch * 0.06));\n  return { pitch, rule, border, inkW: cols * pitch - rule + 2 * border, inkH: rows * pitch - rule + 2 * border };\n}\n\nfunction boardAt(cols: number, rows: number, s: ReturnType<typeof boardSizing>, inkX: number, inkY: number): CrosswordBoard {\n  const { pitch, rule, border } = s;\n  const lead = border - Math.ceil(rule / 2);\n  const x0 = Math.round(inkX) + lead, y0 = Math.round(inkY) + lead;\n  const X = Array.from({ length: cols + 1 }, (_, k) => Math.round(x0 + k * pitch));\n  const Y = Array.from({ length: rows + 1 }, (_, k) => Math.round(y0 + k * pitch));\n  const ink = { x: X[0] - lead, y: Y[0] - lead, w: X[cols] - X[0] - rule + 2 * border, h: Y[rows] - Y[0] - rule + 2 * border };\n  const hole = (i: number): CrosswordRect => {\n    const r = Math.floor(i / cols), c = i % cols;\n    const x = X[c] + Math.ceil(rule / 2), y = Y[r] + Math.ceil(rule / 2);\n    return { x, y, w: X[c + 1] - Math.floor(rule / 2) - x, h: Y[r + 1] - Math.floor(rule / 2) - y };\n  };\n  const letterPx = Math.max(6, Math.round(pitch * LETTER_EM));\n  const n = Math.round(pitch * NUMBER_EM);\n  return { pitch, rule, border, X, Y, ink, hole, letterPx, numberPx: n >= NUMBER_FLOOR_PX ? n : 0 };\n}\n\nexport type CrosswordThemeLine = { swatch: CrosswordRect; id: CrosswordTextBox; answer: CrosswordTextBox };\nexport type CrosswordLayout = {\n  mode: \"landscape\" | \"portrait\" | \"square\";\n  margin: number;\n  gutter: number;\n  board: CrosswordBoard;\n  /** Where the caption copy lives (for the no-overlap assertion). */\n  panel: CrosswordRect;\n  texts: CrosswordTextBox[];\n  themeLines: CrosswordThemeLine[];\n};\n\n/**\n * The card's geometry from ctx.target alone. Margin ~3.6% of the short side;\n * the board-to-panel gutter is twice that. Landscape: board left, full height,\n * copy in a column. Portrait: header over a full-width board, list and caption\n * under it. Between: board on top, caption strip under it.\n */\nexport function layoutCrosswordCard(p: CrosswordNormalized, W: number, H: number): CrosswordLayout {\n  const { rows, cols } = p.pz;\n  const S = Math.min(W, H), a = W / H;\n  const margin = Math.round(S * 0.036), gutter = 2 * margin;\n  const mode = a >= 1.25 ? \"landscape\" : a <= 0.8 ? \"portrait\" : \"square\";\n  const floorPx = Math.max(8, Math.round(S * 0.013));\n  const titleFloor = Math.max(9, Math.round(S * 0.022));\n  const texts: CrosswordTextBox[] = [];\n  const themeLines: CrosswordThemeLine[] = [];\n  const showThemes = p.solved && p.themes.length > 0;\n\n  const place = (label: string, text: string, x: number, y: number, w: number, maxH: number, maxPx: number, floor: number, lineOptions: number[], opts: Partial<CrosswordTextBox> = {}) => {\n    const bold = opts.bold === true;\n    const f = fit(text, w, maxH, maxPx, floor, lineOptions, bold);\n    const box: CrosswordTextBox = { label, rect: rect(x, y, w, blockH(f.px, f.lines.length)), text: f.lines.join(\"\\n\"), px: f.px, width: f.width, bold, color: INK, hAlign: \"left\", vAlign: \"middle\", ...opts };\n    texts.push(box);\n    return box;\n  };\n\n  /** Place a fitted pair at (x, y): lead and tail top-aligned, each its own cell (the bare prop value is bound). */\n  const pair = (P: Pair, x: number, y: number, w: number, lead: { label: string; text: string; color: MosaicColor; bold: boolean; bind?: CrosswordTextBox[\"bind\"] }, tail: { label: string; color: MosaicColor; bind?: CrosswordTextBox[\"bind\"] }) => {\n    texts.push({ label: lead.label, rect: rect(x, y, leadBoxW(P.leadW), blockH(P.px, 1)), text: lead.text, px: P.px, width: P.leadW, bold: lead.bold, color: lead.color, hAlign: \"left\", vAlign: \"top\", ...(lead.bind ? { bind: lead.bind } : {}) });\n    const tx = x + P.tailX, ty = P.stacked ? y + blockH(P.px, 1) : y;\n    texts.push({ label: tail.label, rect: rect(tx, ty, x + w - tx, blockH(P.px, P.tail.length)), text: P.tail.join(\"\\n\"), px: P.px, width: Math.max(...P.tail.map((l) => widthOf(l, P.px))), bold: false, color: tail.color, hAlign: \"left\", vAlign: \"top\", ...(tail.bind ? { bind: tail.bind } : {}) });\n  };\n  const byline = (P: Pair, x: number, y: number, w: number) => pair(P, x, y, w, { label: \"byline-by\", text: \"by\", color: DIM, bold: false }, { label: \"byline\", color: INK, bind: \"author\" });\n  const bylineFit = (w: number, maxH: number, maxPx: number) => pairFit(\"by\", false, p.author, p.author, w, maxH, maxPx, floorPx, [\"line\", \"wrap\"]);\n  /**\n   * The caption line as three cells - publication, date, the rest - so the two\n   * that show a prop are each its own handle. One line, or the date and the\n   * rest on a second line under the publication; the largest size that fits.\n   */\n  const metaFit = (w: number, maxH: number, maxPx: number): MetaFit => {\n    const at = (px: number, stacked: boolean, force: boolean): MetaFit | null => {\n      const lh = blockH(px, 1);\n      const date = stacked ? p.metaDate : `| ${p.metaDate}`, tail = `| ${p.metaTail}`;\n      const pubW = widthOf(p.publication, px, true), dateW = widthOf(date, px), tailW = widthOf(tail, px);\n      // Fit on the solved card's tail so the teaser's shorter \"puzzle\" lands at the same size and place.\n      const fitW = Math.max(tailW, widthOf(`| ${p.pz.cols}x${p.pz.rows} | solution`, px));\n      // The next cell starts one space after this one's ink, as the brief's single-spaced line reads;\n      // the boxes overlap by the fit's slack, which is transparent.\n      const step = (segW: number) => Math.round(segW + widthOf(\" \", px));\n      const x1 = stacked ? 0 : step(pubW), dy = stacked ? lh : 0, x2 = x1 + step(dateW);\n      const height = stacked ? 2 * lh : lh;\n      if (!force && (pubW > budget(w) || w - x2 < 2 * px || fitW > budget(w - x2) || height > maxH)) return null;\n      return {\n        px,\n        height,\n        cells: [\n          { text: p.publication, bold: true, dx: 0, dy: 0, w: leadBoxW(pubW), width: pubW },\n          { text: date, bold: false, dx: x1, dy, w: leadBoxW(dateW), width: dateW },\n          { text: tail, bold: false, dx: x2, dy, w: Math.max(1, w - x2), width: tailW },\n        ],\n      };\n    };\n    for (const [lo, hi] of [[floorPx, Math.max(floorPx, Math.floor(maxPx))], [6, floorPx - 1]]) {\n      for (const stacked of [false, true]) for (let px = hi; px >= lo; px--) { const hit = at(px, stacked, false); if (hit) return hit; }\n    }\n    return at(6, true, true) as MetaFit;\n  };\n  const meta = (M: MetaFit, x: number, y: number) => {\n    const cell = (c: MetaCell, label: string, color: MosaicColor, bind?: CrosswordTextBox[\"bind\"]) =>\n      texts.push({ label, rect: rect(x + c.dx, y + c.dy, c.w, blockH(M.px, 1)), text: c.text, px: M.px, width: c.width, bold: c.bold, color, hAlign: \"left\", vAlign: \"top\", ...(bind ? { bind } : {}) });\n    cell(M.cells[0], \"meta-publication\", INK, \"publication\");\n    cell(M.cells[1], \"meta-date\", DIM, \"date\");\n    cell(M.cells[2], \"meta\", DIM);\n  };\n\n  /** The theme list as one block: heading + lines, `perCol` lines per sub-column. Returns its height. */\n  const themeBlock = (x: number, y: number, w: number, h: number, maxPx: number, subCols: number, dryRun: boolean): number => {\n    if (!showThemes) return 0;\n    const n = p.themes.length, perCol = Math.ceil(n / subCols);\n    const colGap = Math.round(S * 0.03);\n    const colW = (w - (subCols - 1) * colGap) / subCols;\n    const idText = (t: CrosswordEntry) => t.id;\n    // One size for every line: the largest that fits every line's width and the block's height.\n    let px = Math.floor(maxPx);\n    const lineW = (q: number) => Math.max(...p.themes.map((t) => Math.round(q * 0.75) + Math.round(q * 0.5) + Math.max(...p.themes.map((u) => widthOf(idText(u), q))) + Math.round(q * 0.6) + widthOf(t.answer, q, true)));\n    const pitchOf = (q: number) => Math.max(blockH(q, 1), Math.round(q * 1.55));\n    const headPx = (q: number) => Math.max(floorPx, Math.round(q * 0.72));\n    while (px > 6 && (lineW(px) > budget(colW) || blockH(headPx(px), 1) + Math.round(px * 0.35) + perCol * pitchOf(px) > h)) px--;\n    const hp = headPx(px), pitch = pitchOf(px);\n    const total = blockH(hp, 1) + Math.round(px * 0.35) + perCol * pitch;\n    // Too small a canvas for the list even at 6 px: drop it (the tint still marks the entries) rather than overflow.\n    if (total > h) return 0;\n    if (dryRun) return total;\n    place(\"theme-heading\", \"THEME ANSWERS\", x, y, w, blockH(hp, 1), hp, Math.min(hp, floorPx), [1], { bold: true, color: DIM });\n    const idW = Math.max(...p.themes.map((u) => widthOf(idText(u), px)));\n    p.themes.forEach((t, i) => {\n      const col = Math.floor(i / perCol), row = i % perCol;\n      const cx = x + col * (colW + colGap);\n      const ry = y + blockH(hp, 1) + Math.round(px * 0.35) + row * pitch;\n      const sw = Math.round(px * 0.75);\n      const swatch = rect(cx, ry + (pitch - sw) / 2, sw, sw);\n      const idX = cx + sw + Math.round(px * 0.5);\n      const idBox: CrosswordTextBox = { label: `theme-id-${i}`, rect: rect(idX, ry, Math.ceil((idW + 3) / 0.94) + 1, pitch), text: t.id, px, width: widthOf(t.id, px), bold: false, color: DIM, hAlign: \"left\", vAlign: \"middle\", bind: \"themeEntries\", token: p.themeSpans[i] };\n      const ansX = idX + idW + Math.round(px * 0.6);\n      const ansBox: CrosswordTextBox = { label: `theme-${i}`, rect: rect(ansX, ry, cx + colW - ansX, pitch), text: t.answer, px, width: widthOf(t.answer, px, true), bold: true, color: INK, hAlign: \"left\", vAlign: \"middle\" };\n      texts.push(idBox, ansBox);\n      themeLines.push({ swatch, id: idBox, answer: ansBox });\n    });\n    return total;\n  };\n\n  let board: CrosswordBoard;\n  let panel: CrosswordRect;\n  if (mode === \"landscape\") {\n    const s = boardSizing(cols, rows, Math.min(H - 2 * margin, (W - 2 * margin - gutter) * 0.6), H - 2 * margin);\n    board = boardAt(cols, rows, s, margin, (H - s.inkH) / 2);\n    const px0 = board.ink.x + board.ink.w + gutter;\n    const top = Math.min(board.ink.y, margin + (H - 2 * margin) * 0.04), bottom = H - top;\n    panel = rect(px0, top, W - margin - px0, bottom - top);\n    const w = panel.w, x = panel.x;\n    const tf = fit(p.title, w, panel.h * 0.3, S * 0.075, titleFloor, [2], true);\n    const bP = bylineFit(w, panel.h * 0.12, S * 0.036);\n    const mP = metaFit(w, panel.h * 0.1, S * 0.028);\n    const metaH = mP.height;\n    // No theme list (the PROP is empty, not merely hidden): the title block centres in the space above the caption line.\n    const groupH = blockH(tf.px, tf.lines.length) + Math.round(S * 0.008) + bP.height;\n    const ty = p.themes.length > 0 ? panel.y : panel.y + Math.max(0, (panel.h - metaH - gutter / 2 - groupH) / 2);\n    const t = place(\"title\", p.title, x, ty, w, panel.h * 0.3, S * 0.075, titleFloor, [2], { bold: true, vAlign: \"top\", bind: \"title\" });\n    const by = t.rect.y + t.rect.h + Math.round(S * 0.008);\n    byline(bP, x, by, w);\n    meta(mP, x, panel.y + panel.h - metaH);\n    // The list sits centred in the space between the title block and the caption line.\n    const free0 = by + bP.height + gutter / 2, free1 = panel.y + panel.h - metaH - gutter / 2;\n    const listH = themeBlock(x, free0, w, free1 - free0, S * 0.038, 1, true);\n    themeBlock(x, free0 + Math.max(0, (free1 - free0 - listH) / 2), w, free1 - free0, S * 0.038, 1, false);\n  } else if (mode === \"portrait\") {\n    const s = boardSizing(cols, rows, W - 2 * margin, (H - 2 * margin - 2 * gutter) * 0.6);\n    const rest = H - 2 * margin - 2 * gutter - s.inkH;\n    const headH = Math.round(rest * (p.themes.length > 0 ? 0.36 : 0.5));\n    board = boardAt(cols, rows, s, (W - s.inkW) / 2, margin + headH + gutter);\n    panel = rect(margin, margin, W - 2 * margin, H - 2 * margin);\n    const x = margin, w = W - 2 * margin;\n    // Header: title + byline, centred in the band above the board.\n    const tf = fit(p.title, w, headH * 0.66, S * 0.085, titleFloor, [2], true);\n    const bP = bylineFit(w, headH * 0.3, S * 0.04);\n    const gap = Math.round(S * 0.012);\n    const headUsed = blockH(tf.px, tf.lines.length) + gap + bP.height;\n    const hy = margin + Math.max(0, (headH - headUsed) / 2);\n    const t = place(\"title\", p.title, x, hy, w, headH * 0.66, S * 0.085, titleFloor, [2], { bold: true, bind: \"title\" });\n    byline(bP, x, t.rect.y + t.rect.h + gap, w);\n    // Footer: the list centred in the band under the board, the caption line at the bottom.\n    const footY = board.ink.y + board.ink.h + gutter, footB = H - margin;\n    const mP = metaFit(w, (footB - footY) * 0.2, S * 0.032);\n    const metaH = mP.height;\n    meta(mP, x, p.themes.length > 0 ? footB - metaH : footY + Math.max(0, (footB - footY - metaH) / 2));\n    const free1 = footB - metaH - gutter / 2;\n    const listH = themeBlock(x, footY, w, free1 - footY, S * 0.042, 1, true);\n    themeBlock(x, footY + Math.max(0, (free1 - footY - listH) / 2), w, free1 - footY, S * 0.042, 1, false);\n  } else {\n    // The column split follows the PROP, not solved: the teaser keeps the solved card's geometry (\"nothing else moves\").\n    const leftW = (W - 2 * margin) * (p.themes.length > 0 ? 0.54 : 1);\n    // A title too long for one line at S/20 wraps to two, and the board gives up that second line's height.\n    const tp = Math.ceil(S / 20);\n    const twoLines = wrap(p.title, tp, budget(leftW), true).length > 1;\n    const s = boardSizing(cols, rows, W - 2 * margin, H * 0.72 - (twoLines ? blockH(tp, 2) - blockH(tp, 1) : 0));\n    board = boardAt(cols, rows, s, (W - s.inkW) / 2, margin);\n    const y0 = board.ink.y + board.ink.h + gutter;\n    panel = rect(margin, y0, W - 2 * margin, H - margin - y0);\n    const x = panel.x;\n    const mP = metaFit(leftW, panel.h * 0.3, S * 0.022);\n    const metaH = mP.height;\n    const bP = bylineFit(leftW, panel.h * 0.3, S * 0.028);\n    const bylineH = bP.height;\n    const gap = Math.round(S * 0.006);\n    const titleMax = panel.h - metaH - bylineH - 2 * gap;\n    const t = place(\"title\", p.title, x, panel.y, leftW, titleMax, S * 0.058, titleFloor, [2], { bold: true, vAlign: \"top\", bind: \"title\" });\n    byline(bP, x, t.rect.y + t.rect.h + gap, leftW);\n    meta(mP, x, panel.y + panel.h - metaH);\n    if (showThemes) {\n      const rx = panel.x + panel.w * 0.58, rw = panel.x + panel.w - rx;\n      themeBlock(rx, panel.y, rw, panel.h, S * 0.03, p.themes.length > 4 ? 2 : 1, false);\n    }\n  }\n  return { mode, margin, gutter, board, panel, texts, themeLines };\n}\n\n// ---------------------------------------------------------------- drawing\n\nconst num = (v: number) => String(Math.round(v * 100) / 100);\n\n/** One svg text source holding many glyphs, each placed by a pixel offset inside its rect. */\nfunction glyphRow(label: string, glyphs: Array<{ text: string; x: number; y: number }>, px: number, bold: boolean): MosaicSource {\n  return {\n    type: \"text\",\n    rasterizer: \"svg\",\n    renderMode: { kind: \"image\" },\n    layers: glyphs.map((g) => ({\n      content: { kind: \"literal\", text: g.text },\n      style: { fontSize: px, fontColor: INK, ...(bold ? { fontWeight: \"bold\" } : {}) },\n      placement: { hAlign: \"left\", vAlign: \"top\", xExpr: num(g.x), yExpr: num(g.y) },\n    })),\n    editor: { owner: \"template\", label },\n  } as MosaicSource;\n}\n\nconst masked = (color: MosaicColor, r: CrosswordRect, path: string, label: string): MosaicSource =>\n  tag(makeColorTile(color, { mask: { kind: \"inline-mask\", localPath: path, bounds: { x: 0, y: 0, width: r.w, height: r.h } } }), label);\n\n/** Circle subpath; `cw` picks the winding so a pair makes an annulus under nonzero and evenodd alike. */\nconst circle = (cx: number, cy: number, r: number, cw: boolean) =>\n  `M${num(cx - r)} ${num(cy)}a${num(r)} ${num(r)} 0 1 ${cw ? 1 : 0} ${num(2 * r)} 0a${num(r)} ${num(r)} 0 1 ${cw ? 1 : 0} ${num(-2 * r)} 0z`;\n\nexport type CrosswordDrawn = { pieces: Array<{ rect: CrosswordRect & { importance: number }; source: MosaicSource }>; layout: CrosswordLayout; constraints: LayoutConstraint[]; relations: RelationalConstraint[] };\n\nexport function drawCrosswordCard(p: CrosswordNormalized, W: number, H: number): CrosswordDrawn {\n  const L = layoutCrosswordCard(p, W, H);\n  const { pz } = p;\n  const B = L.board;\n  const pieces: CrosswordDrawn[\"pieces\"] = [];\n  const add = (r: CrosswordRect, importance: number, source: MosaicSource) => pieces.push({ rect: { ...r, importance }, source });\n  const ink = B.ink;\n  const local = (r: CrosswordRect) => ({ x: r.x - ink.x, y: r.y - ink.y, w: r.w, h: r.h });\n\n  // 1. paper under the whole board.\n  add(ink, 1, tag(makeColorTile(PAPER), \"board-paper\"));\n  // 2. theme tint: the lattice cells of every theme entry (a crossing cell once).\n  const themeCells = [...new Set(p.solved ? p.themes.flatMap((t) => t.cells) : [])].sort((a, b) => a - b);\n  if (themeCells.length > 0) {\n    const path = themeCells.map((i) => {\n      const r = Math.floor(i / pz.cols), c = i % pz.cols;\n      const q = local({ x: B.X[c], y: B.Y[r], w: B.X[c + 1] - B.X[c], h: B.Y[r + 1] - B.Y[r] });\n      return `M${q.x} ${q.y}h${q.w}v${q.h}h${-q.w}z`;\n    }).join(\"\");\n    add(ink, 2, masked(p.themeColor, ink, path, \"theme-tint\"));\n  }\n  // 3. ink: the board minus every paper cell = the border, the rules and the blocks in one path.\n  const holes = pz.cells.map((ch, i) => (ch === null ? \"\" : (() => { const q = local(B.hole(i)); return `M${q.x} ${q.y}v${q.h}h${q.w}v${-q.h}z`; })())).join(\"\");\n  // The board is the puzzle's handle: a double-click opens the grid first, then what marks it.\n  const marks = p.solved ? [{ propKey: \"grid\" }, { propKey: \"themeEntries\" }, { propKey: \"circles\" }, { propKey: \"themeColor\" }] : [{ propKey: \"grid\" }, { propKey: \"circles\" }];\n  add(ink, 3, bindProps(masked(INK, ink, `M0 0H${ink.w}V${ink.h}H0Z${holes}`, \"board\"), marks));\n  // 4. rings, over the tint and under the letter.\n  if (p.circles.length > 0) {\n    const path = p.circles.map((i) => {\n      const q = local(B.hole(i));\n      const ro = Math.min(q.w, q.h) / 2 - Math.max(0.5, B.pitch * 0.02);\n      const t = Math.max(1, B.pitch * 0.035);\n      return circle(q.x + q.w / 2, q.y + q.h / 2, ro, true) + circle(q.x + q.w / 2, q.y + q.h / 2, ro - t, false);\n    }).join(\"\");\n    add(ink, 4, masked(INK, ink, path, \"rings\"));\n    // A knockout in the cell's own fill behind a clue number that sits on a ring, as solving apps do.\n    if (B.numberPx > 0) {\n      const tinted = new Set(themeCells);\n      const knock: Record<\"paper\" | \"theme\", string[]> = { paper: [], theme: [] };\n      for (const i of p.circles) {\n        const n = p.numbers.get(i);\n        if (n === undefined) continue;\n        const q = local(B.hole(i));\n        const w = Math.ceil(Math.max(1, q.w * 0.07) + widthOf(String(n), B.numberPx) + q.w * 0.03);\n        const h = Math.ceil(q.h * 0.06 + 0.711 * B.numberPx + q.h * 0.04);\n        knock[tinted.has(i) ? \"theme\" : \"paper\"].push(`M${q.x} ${q.y}h${w}v${h}h${-w}z`);\n      }\n      if (knock.paper.length > 0) add(ink, 5, masked(PAPER, ink, knock.paper.join(\"\"), \"number-knockout\"));\n      if (knock.theme.length > 0) add(ink, 6, masked(p.themeColor, ink, knock.theme.join(\"\"), \"number-knockout\"));\n    }\n  }\n  // 7-8. numbers and letters: ONE source each over the lattice, every glyph placed on it. A source\n  // per row would stack 2 x rows overlays at the root, and past ~25 the engine drops inline masks.\n  const band: CrosswordRect = { x: B.X[0], y: B.Y[0], w: B.X[pz.cols] - B.X[0], h: B.Y[pz.rows] - B.Y[0] };\n  const nums: Array<{ text: string; x: number; y: number }> = [];\n  const lets: Array<{ text: string; x: number; y: number }> = [];\n  pz.cells.forEach((ch, i) => {\n    if (ch === null) return;\n    const h = B.hole(i);\n    const n = p.numbers.get(i);\n    if (n !== undefined && B.numberPx > 0) {\n      nums.push({ text: String(n), x: h.x - band.x + Math.max(1, h.w * 0.07), y: Math.max(0, h.y - band.y + h.h * 0.06 - CAP_TOP_EM * B.numberPx) });\n    }\n    if (p.solved) {\n      lets.push({ text: ch, x: h.x - band.x + (h.w - widthOf(ch, B.letterPx, true)) / 2, y: Math.max(0, h.y - band.y + h.h * 0.57 - CAP_MID_EM * B.letterPx) });\n    }\n  });\n  if (nums.length > 0) add(band, 7, glyphRow(\"cell-number\", nums, B.numberPx, false));\n  if (lets.length > 0) add(band, 8, glyphRow(\"cell-letter\", lets, B.letterPx, true));\n  // The caption copy and the list swatches.\n  for (const t of L.texts) {\n    const src = tag(textCell({ text: t.text, fontSize: t.px, color: t.color, hAlign: t.hAlign, vAlign: t.vAlign, bold: t.bold, label: t.label }), t.label);\n    const raw = t.bind === \"themeEntries\" ? String(p.themeEntries) : \"\";\n    add(t.rect, 1, !t.bind ? src : t.token ? bindPropRange(src, t.bind, undefined, { start: 0, end: raw.length }, t.token) : bindProp(src, t.bind));\n  }\n  for (const line of L.themeLines) add(line.swatch, 1, bindProp(tag(makeColorTile(p.themeColor), \"theme-swatch\"), \"themeColor\"));\n\n  // The contract: every text fits (measured), the board keeps its shape and size.\n  const constraints: LayoutConstraint[] = L.texts.map((t) => textFitsMeasured(t.label, t.text, t.px, t.width));\n  if (p.solved) constraints.push(textFitsMeasured(\"cell-letter\", \"W\", B.letterPx, widthOf(\"W\", B.letterPx, true)));\n  if (B.numberPx > 0 && p.numbers.size > 0) {\n    const widest = String(Math.max(...p.numbers.values()));\n    constraints.push(textFitsMeasured(\"cell-number\", widest, B.numberPx, widthOf(widest, B.numberPx)));\n  }\n  // The designed shape: the lattice plus its border (a 25x3 is not 25/3 once the border is on), within 2%.\n  const shape = (pz.cols * B.pitch - B.rule + 2 * B.border) / (pz.rows * B.pitch - B.rule + 2 * B.border);\n  constraints.push({ label: \"board\", aspect: shape, aspectTolerance: 0.02 * Math.max(shape, 1 / shape), ...(pz.cols === pz.rows ? { minWidthFrac: 0.45, minHeightFrac: 0.45 } : {}) });\n  if (L.themeLines.length > 0) constraints.push({ label: \"theme-swatch\", aspect: 1, aspectTolerance: 0.2 });\n  const relations: RelationalConstraint[] = [];\n  // The cells are not rects (they are holes in one mask), so equal cells are the test's to assert, from the lattice lines.\n  if (L.themeLines.length >= 2) relations.push({ label: \"theme-swatch\", equal: \"size\", tolerance: 0.02, tolerancePx: 1 } as RelationalConstraint);\n  return { pieces, layout: L, constraints, relations };\n}\n\n// ---------------------------------------------------------------- the story\n\n/**\n * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n * convention, src/_shared/why.ts): the run, the problem with the sources the\n * agent opened, the solution, how to use it, then the template itself.\n */\nconst WHY: WhySpec = {\n  \"day\": 10,\n  \"date\": \"2026-09-29\",\n  \"agent\": \"claude\",\n  \"model\": \"claude-opus-5-5\",\n  \"id\": \"@one-a-day/gaming/crossword-grid-card/v1\",\n  \"title\": \"Crossword Grid Card\",\n  \"who\": \"Crossword bloggers who post the solved grid atop every write-up (Crossword Fiend, NYT to Universal) and indie constructors posting a weekly .puz\",\n  \"problem\": [\n    \"Every Crossword Fiend write-up opens with a picture of the solved grid, and each one is a screenshot or phone photo of whatever app the reviewer solved in: Screenshot-2026-09-22-213516.png, IMG_2411.jpeg, grid.png, wpsol092726.png. Size, style and app chrome change from grid to grid.\",\n    \"The caption under it is typed by hand (\\\"WSJ * 9/22/26 * Tues * \\\"Variety Pack\\\" * Zhoukin Burnikel * solution * 20260922\\\"), and because the picture cannot mark the theme, every post retypes a separate \\\"THEME ANSWERS:\\\" list. The .puz file holding all of it sits on the same site.\",\n  ],\n  \"sources\": [\n    \"https://crosswordfiend.com/2026/09/21/tuesday-september-22-2026/\",\n    \"https://crosswordfiend.com/2026/09/24/friday-september-25-2026/\",\n    \"https://crosswordfiend.com/2026/09/26/sunday-september-27-2026/\",\n    \"https://crosswordfiend.com/download/\",\n    \"https://crosshare.org/crosswords/pJMezWuZ6oRSxfHehRTw/wanting-for-winter\",\n    \"https://github.com/alexdej/puzpy\",\n    \"https://github.com/viresh-ratnakar/exet\"\n  ],\n  \"solution\": [\n    \"Paste the solution rows from the puzzle file (for a square grid, puzpy's p.solution pastes as is). The card derives the clue numbers, reads each theme answer from the grid, tints it and lists it, and writes the caption line, so every grid on a blog matches. solved=false hides the letters for a new-puzzle teaser.\",\n    \"The decision that matters: the board is a few masked layers (paper, theme tint, ink with the paper cells cut out, rings) plus one text source for every letter and one for every number, all on one integer lattice. A 25x25 takes no more layers than a 7x7 (8 at most), and every size from 3 to 25 renders the same way.\",\n  ],\n  \"usage\": {\n    \"command\": \"m0saic make @one-a-day/gaming/crossword-grid-card/v1 --template-repo . -w 1080 -h 1080 -o grid.png\",\n    \"try\": [\n      \"grid: rows split by \\\"/\\\" (\\\"#\\\" or \\\".\\\" is a block); a square grid's unbroken .puz string also works\",\n      \"themeEntries: \\\"17A 38A 61A\\\" - the ids your write-up already lists\",\n      \"circles: \\\"14 15 16\\\" - 0-based cell indices, the .puz order\",\n      \"--props '{\\\"solved\\\":false}' - the new-puzzle teaser: no letters, tint or answers\"\n    ]\n  },\n  \"caveats\": [\n    \"No .puz parser: paste the solution rows. A rebus square shows its first letter (what the .puz solution string holds), and shaded squares are not drawn.\",\n    \"Grids 3 to 25 cells each way; paste a non-square grid as rows split by \\\"/\\\". Clue numbers are dropped below 6 px, so a 15x15 at 480x270 shows letters only.\",\n    \"A still card: no clue text and no fill-in animation yet.\"\n  ],\n  \"timeline\": {\n    \"source\": \"runner\",\n    \"phases\": [\n      {\n        \"name\": \"scout\",\n        \"startMs\": 0,\n        \"durMs\": 701073,\n        \"calls\": 41,\n        \"tokens\": 8010625,\n        \"costUsd\": 9.8,\n        \"tools\": \"Bash 25, WebSearch 6, WebFetch 3\"\n      },\n      {\n        \"name\": \"plan\",\n        \"startMs\": 701118,\n        \"durMs\": 525743,\n        \"calls\": 24,\n        \"tokens\": 4086662,\n        \"costUsd\": 6.46,\n        \"tools\": \"Bash 19, Read 1, TaskStop 1\"\n      }\n    ],\n    \"costBasis\": \"reported\"\n  }\n};\n\nexport const CrosswordGridCardV1 = defineMosaicTemplate<CrosswordGridCardProps>({\n  id: asTemplateId(ID),\n  label: \"2026-09-29 · Crossword Grid Card\",\n  version: 1,\n  description: \"Crossword Grid Card: the solved grid for a crossword write-up from the puzzle's own fields - blocks, derived clue numbers, circles, theme entries tinted and listed, and the caption line. solved=false makes the teaser.\",\n  capabilities: { tier: \"core\" },\n  tags: [\"gaming\", \"2026-09-29\", \"day-010\", \"crossword\", \"puzzle\", \"share-card\"],\n\n  outputHints: {\n    width: 1080,\n    height: 1080,\n    fps: 30,\n    durationMs: 2000,\n    format: { kind: \"image\", container: \"png\" },\n    note: \"Static card - square for the top of a write-up; 1920x1080 and 1080x1920 lay out for link shares and stories.\",\n  },\n\n  propsSchema,\n  defaultProps: { ...CROSSWORD_DEFAULTS },\n\n  render,\n  renderTutorial: whyTutorial(WHY, render),\n});\n\nexport default CrosswordGridCardV1;\n\nasync function render(props: CrosswordGridCardProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n  // The schema is documentation; render() is the gate.\n  const p = normalizeCrossword(props);\n  const W = Math.max(1, Math.round(ctx.target.width));\n  const H = Math.max(1, Math.round(ctx.target.height));\n  const { pieces, constraints, relations } = drawCrosswordCard(p, W, H);\n  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n  const doc: MosaicDocument = {\n    kind: \"mosaic_document\",\n    version: 1,\n    m0: toM0String(placed.m0, ID),\n    assets: {},\n    backgroundColor: PAGE,\n    sources: placed.sources,\n  };\n  return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: p.debugLayout === true });\n}\n","numLines":873,"startLine":1,"totalLines":873}}}
