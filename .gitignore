# dependencies
node_modules

# NOTE: dist/ and template-manifest.json are COMMITTED on purpose — hosts
# load dist/index.js straight from a clone (there is no src/ load path), and
# the daily run rebuilds both before every commit. Never hand-edit them.

# local render output
test-output

# the daily run's raw agent transcripts (large; the trimmed .log beside each is committed)
journal/**/logs/*.jsonl
journal/**/logs/*.raw.txt
# the runner's own console mirror (written after the commit too; the scheduler keeps the console log)
journal/**/logs/runner.log
journal/**/logs/preflight.log
# variant renders: the stills are committed, the clips are not
journal/**/renders/*.mp4
journal/**/renders/*.mov
journal/**/renders/*.webm

# the clip tools/gen-previews.mjs renders as the source of a preview.gif: deleted once the
# GIF is written; this covers a run that was killed in between
assets/templates/**/.preview-gif-source.mp4

# OS files
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env

# runtime caches an agent pointed into the day's journal (day 003 committed 241 mask PNGs this way);
# the gate deletes them too — this covers a hand commit
journal/**/cache/
journal/**/m0saic-runtime/
