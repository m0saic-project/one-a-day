{"type":"tool_use","timestamp":1792528621565,"sessionID":"ses_ea4f89b40ffeJA5Vf8sjCWqpcq","part":{"type":"tool","tool":"read","callID":"call_00_5uqjPt5sS87e9GLAHLS53704","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\tools\\new-template.mjs"},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\tools\\new-template.mjs</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env node\n2: /**\n3:  * new-template — scaffold one template that passes every convention on the\n4:  * first build, and wire it everywhere the repo expects.\n5:  *\n6:  *   node tools/new-template.mjs <pack>/<slug> [--title \"Human Title\"] [--description \"One line.\"]\n7:  *\n8:  * Writes:\n9:  *   src/<pack>/<slug>/v1/<slug>.ts        the template (typed props, bound\n10:  *                                         text, fitted copy, deterministic) with\n11:  *                                         its WHY spec + renderTutorial (the\n12:  *                                         why-tutorial convention, src/_shared/why.ts),\n13:  *                                         pre-filled from today's journal when\n14:  *                                         ONE_A_DAY_DAY_DIR (or journal/<today>/) exists\n15:  *   src/<pack>/<slug>/v1/<slug>.test.ts   locks bindings, floors, determinism\n16:  * and appends a row to src/<pack>/registry.ts + the import / array entry /\n17:  * `export *` in src/<pack>/index.ts. A NEW pack also gets registry.ts +\n18:  * index.ts and is wired into src/repo.ts, src/template-registry.ts and\n19:  * src/index.ts (and CURRICULUM.md, where one exists).\n20:  *\n21:  * The title is \"<date> · <Title>\" and the tags carry the date and the day\n22:  * (\"2026-09-20\", \"day-001\"): hosts sort the grid by name or by first tag, so\n23:  * the day is the ordinal (a repo that ships daily outgrows \"NN ·\" fast).\n24:  *\n25:  * Then: npm run build && npm run previews && npm run build && npm run verify\n26:  */\n27: import fs from \"node:fs\";\n28: import path from \"node:path\";\n29: import { spawnSync } from \"node:child_process\";\n30: import { fileURLToPath, pathToFileURL } from \"node:url\";\n31: \n32: const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n33: const argv = process.argv.slice(2);\n34: const target = argv.find((a) => !a.startsWith(\"--\"));\n35: const opt = (name) => { const i = argv.indexOf(name); return i >= 0 ? argv[i + 1] : undefined; };\n36: if (!target || !/^[a-z][a-z0-9-]*\\/[a-z][a-z0-9-]*$/.test(target)) {\n37:   console.error('usage: node tools/new-template.mjs <pack>/<slug> [--title \"Human Title\"] [--description \"One line.\"]\\n  pack and slug: lowercase, digits, dashes.');\n38:   process.exit(2);\n39: }\n40: const [pack, slug] = target.split(\"/\");\n41: const pascal = (s) => s.split(\"-\").map((w) => w[0].toUpperCase() + w.slice(1)).join(\"\");\n42: const camel = (s) => { const p = pascal(s); return p[0].toLowerCase() + p.slice(1); };\n43: const title = opt(\"--title\") ?? slug.split(\"-\").map((w) => w[0].toUpperCase() + w.slice(1)).join(\" \");\n44: const description = opt(\"--description\") ?? `${title}: describe the ONE concept this template teaches, in one line, for the Templates page.`;\n45: const exportName = `${pascal(slug)}V1`;\n46: const read = (rel) => fs.readFileSync(path.join(ROOT, rel), \"utf8\");\n47: const write = (rel, s) => { fs.mkdirSync(path.dirname(path.join(ROOT, rel)), { recursive: true }); fs.writeFileSync(path.join(ROOT, rel), s); touched.push(rel); };\n48: const touched = [];\n49: \n50: const repoId = /repoId:\\s*asRepoId\\(\"([^\"]+)\"\\)/.exec(read(\"src/repo.ts\"))?.[1];\n51: if (!repoId) { console.error(\"new-template: could not read repoId from src/repo.ts\"); process.exit(1); }\n52: const ID = `${repoId}/${pack}/${slug}/v1`;\n53: const STARTER = fs.existsSync(path.join(ROOT, \"src/_shared/tutorial.ts\"));\n54: const packDir = `src/${pack}`;\n55: const packExists = fs.existsSync(path.join(ROOT, packDir, \"registry.ts\"));\n56: if (fs.existsSync(path.join(ROOT, packDir, slug))) { console.error(`new-template: ${packDir}/${slug} already exists`); process.exit(1); }\n57: \n58: // The `harness` pack is internal fixtures (hidden, unnumbered): a day's\n59: // template never lands there (the gate refuses it too).\n60: const INTERNAL_PACKS = new Set([\"harness\"]);\n61: if (INTERNAL_PACKS.has(pack)) { console.error(`new-template: ${pack}/ is the internal harness pack — a day's template goes in a public pack (see pipeline/config.json packs.vocabulary)`); process.exit(1); }\n62: \n63: // ── the WHY skeleton: pre-filled from today's journal where it already knows ──\n64: // The runner sets ONE_A_DAY_DAY_DIR / ONE_A_DAY_DATE; an interactive session\n65: // gets journal/<today>/ when it exists. Anything the journal cannot supply is\n66: // the placeholder the gate refuses, so an unfilled WHY cannot ship.\n67: const PLACEHOLDER = \"[fill me]\";\n68: const readJson = (file) => { try { return JSON.parse(fs.readFileSync(file, \"utf8\")); } catch { return null; } };\n69: const todayIso = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \"0\")}-${String(d.getDate()).padStart(2, \"0\")}`; };\n70: const DATE = process.env.ONE_A_DAY_DATE ?? todayIso();\n71: const DAY_DIR = process.env.ONE_A_DAY_DAY_DIR ?? path.join(ROOT, \"journal\", DATE);\n72: const dayState = readJson(path.join(DAY_DIR, \"state.json\")) ?? {};\n73: const dayRun = readJson(path.join(DAY_DIR, \"run.json\")) ?? {};\n74: const indexRows = (() => { const v = readJson(path.join(ROOT, \"journal\", \"index.json\")); return Array.isArray(v) ? v : []; })();\n75: const dayNumber = (() => { const row = indexRows.find((r) => r.date === DATE); return row?.day ?? indexRows.filter((r) => r.date < DATE).length + 1; })();\n76: const ascii = (v) => String(v).replace(/[^\\x20-\\x7e]/g, \"?\").replace(/\\s+/g, \" \").trim();\n77: const WHY = {\n78:   day: dayNumber,\n79:   date: DATE,\n80:   agent: ascii(dayRun.runner?.adapter ?? PLACEHOLDER),\n81:   model: ascii(dayRun.model?.selfDeclared ?? PLACEHOLDER),\n82:   id: ID,\n83:   title,\n84:   who: dayState.who ? ascii(dayState.who) : `${PLACEHOLDER} who has the problem, and where they were found`,\n85:   problem: [dayState.useCase ? ascii(dayState.useCase) : `${PLACEHOLDER} what was observed, in the evidence's words`],\n86:   sources: Array.isArray(dayState.sources) && dayState.sources.length ? dayState.sources.map(ascii).slice(0, 12) : [`https://example.com/${PLACEHOLDER.replace(/[^a-z]/g, \"\")}`],\n87:   solution: [ascii(description)],\n88:   usage: { command: `m0saic make ${ID} --template-repo . -w 1280 -h 720 -o out.png`, try: [] },\n89: };\n90: // timeline: the runner's trace so far (scout, plan, this build call) - the ship\n91: // phase re-copies it once every phase has run. No trace = self-reported, and a\n92: // placeholder phase name so the gate refuses an unfilled one.\n93: const trace = readJson(path.join(DAY_DIR, \"trace.json\"));\n94: if (trace && Array.isArray(trace.phases) && trace.phases.length) {\n95:   const { timelineFromTrace } = await import(pathToFileURL(path.join(ROOT, \"pipeline\", \"lib\", \"trace.mjs\")).href);\n96:   WHY.timeline = timelineFromTrace(trace);\n97: } else {\n98:   WHY.timeline = { source: \"self-reported\", phases: [{ name: `${PLACEHOLDER} scout`, startMs: 0, durMs: 0 }] };\n99: }\n100: const whyLiteral = JSON.stringify(WHY, null, 2);\n101: // The display title carries the day it shipped; the tags make it sortable\n102: // and searchable by date and by day number.\n103: const DAY_TAG = `day-${String(dayNumber).padStart(3, \"0\")}`;\n104: const DATED_TITLE = `${DATE} · ${title}`;\n105: const TAGS = [pack, DATE, DAY_TAG];\n106: \n107: // ── the template ──\n108: const tutorialImport = STARTER ? `\\nimport { lessonTutorial } from \"../../../_shared/tutorial\";\\n` : \"\";\n109: const tutorial = STARTER ? `\n110:   renderTutorial: lessonTutorial({\n111:     title: ${JSON.stringify(title)},\n112:     lines: [\n113:       \"State the one concept this template teaches, in a sentence a reader can act on.\",\n114:       \"Name the rule that bites - the thing that costs an afternoon when you get it wrong.\",\n115:     ],\n116:     explore: [\n117:       \"Double-click the title on the preview - it is bound\",\n118:       \"Resize the preview - the title keeps its band\",\n119:     ],\n120:   }),\n121: ` : \"\";\n122: const templateTs = `import type {\n123:   MosaicColor,\n124:   MosaicDocument,\n125:   MosaicEngineContext,\n126:   MosaicSource,\n127: } from \"@m0saic/types\";\n128: import { asTemplateId } from \"@m0saic/types\";\n129: import { toM0String } from \"@m0saic/dsl-stdlib\";\n130: import {\n131:   bindProp,\n132:   defineMosaicTemplate,\n133:   definePropsSchema,\n134:   placeInsetPieces,\n135:   svgLabel,\n136:   tag,\n137: } from \"@m0saic/template-utils\";\n138: import type { LayoutConstraint } from \"@m0saic/template-utils\";\n139: import { TEXT_EM, textFitsAll, withLayoutIntent } from \"../../../_shared/layout\";\n140: import { whyTutorial } from \"../../../_shared/why\";\n141: import type { WhySpec } from \"../../../_shared/why\";\n142: ${tutorialImport}\n143: /**\n144:  * \\`${ID}\\` — one line on what it draws.\n145:  *\n146:  * ONE CONCEPT: the single idea, stated plainly.\n147:  *\n148:  * The rule that bites: the thing that will cost someone an afternoon.\n149:  *\n150:  * Scaffolded by tools/new-template.mjs — it passes every build-gate and\n151:  * doctor convention as generated (typed props with defaults, a bound title,\n152:  * fitted svg copy, deterministic geometry from ctx.target, the page colour\n153:  * as the document background and never a full-canvas rect, no prop that\n154:  * nothing on the canvas shows). Replace the body; keep the shape.\n155:  */\n156: \n157: export type ${pascal(slug)}Props = {\n158:   /** Headline - the rect that shows it is bound to it. */\n159:   title?: string;\n160:   /** Dev-only: check the layout contract and draw it over the card. */\n161:   debugLayout?: boolean;\n162: };\n163: \n164: const ID = ${JSON.stringify(ID)};\n165: const INK = \"#eaeef2\" as MosaicColor;\n166: const DIM = \"#9aa7b4\" as MosaicColor;\n167: /** The page: document.backgroundColor. A full-canvas colour rect would be a\n168:  *  click target over everything (doctor: canvasFill), and a colour PROP with\n169:  *  no rect to bind it to would need declaring (doctor: bindingsDeclared). */\n170: const PAGE = \"#1c2833\" as MosaicColor;\n171: const DEFAULT_TITLE = ${JSON.stringify(title)};\n172: \n173: const propsSchema = definePropsSchema<${pascal(slug)}Props>({\n174:   title: {\n175:     type: \"string\",\n176:     required: false,\n177:     description: \"Headline. The rect that shows it is bound to it, so Make's double-click edits it in place.\",\n178:     meta: { control: { placeholder: DEFAULT_TITLE }, ui: { label: \"Title\", order: 1 } },\n179:   },\n180:   debugLayout: {\n181:     type: \"boolean\",\n182:     required: false,\n183:     description: \"Dev-only: check the layout contract (every text fits its box, the title sits in its band) and draw it over the card.\",\n184:     meta: { ui: { label: \"Debug layout\", order: 99 } },\n185:   },\n186: });\n187: \n188: /**\n189:  * What the geometry promises, as canvas-independent invariants against the\n190:  * source labels - the layout contract (src/_shared/layout.ts). Every text\n191:  * gets textFits with the bundled font's calibrated ruler (TEXT_EM.prose;\n192:  * a template that measures the block itself uses textFitsMeasured, exact);\n193:  * the chrome the design depends on gets a band. Only labels that rendered.\n194:  */\n195: function layoutContract(): LayoutConstraint[] {\n196:   return [\n197:     ...textFitsAll([\"title\", \"caption\"], { charWidthEm: TEXT_EM.prose }),\n198:     { label: \"title\", within: { yFrac: [0.2, 0.6] }, minWidthFrac: 0.5 },\n199:     { label: \"caption\", within: { yFrac: [0.5, 0.8] } },\n200:   ];\n201: }\n202: \n203: /**\n204:  * Why this template exists - rendered by \\`renderTutorial\\` (the why-tutorial\n205:  * convention, src/_shared/why.ts): the run, the problem with the sources the\n206:  * agent opened, the solution, how to use it, then the template itself.\n207:  * Pre-filled from journal/${DATE}/ - replace every \"${PLACEHOLDER}\" and say it\n208:  * in the evidence's own words. The build refuses a placeholder.\n209:  */\n210: const WHY: WhySpec = ${whyLiteral};\n211: \n212: export const ${exportName} = defineMosaicTemplate<${pascal(slug)}Props>({\n213:   id: asTemplateId(ID),\n214:   label: ${JSON.stringify(DATED_TITLE)},\n215:   version: 1,\n216:   description: ${JSON.stringify(description)},\n217:   capabilities: { tier: \"core\" },\n218:   tags: ${JSON.stringify(TAGS)},\n219: \n220:   outputHints: {\n221:     width: 1280,\n222:     height: 720,\n223:     fps: 30,\n224:     durationMs: 2000,\n225:     format: { kind: \"image\", container: \"png\" },\n226:     note: \"Static card - any canvas and any duration render cleanly.\",\n227:   },\n228: \n229:   propsSchema,\n230:   defaultProps: {\n231:     title: DEFAULT_TITLE,\n232:     debugLayout: false,\n233:   },\n234: \n235:   render,\n236:   renderTutorial: whyTutorial(WHY, render),\n237: ${tutorial}});\n238: \n239: export default ${exportName};\n240: \n241: async function render(\n242:   props: ${pascal(slug)}Props,\n243:   ctx: MosaicEngineContext,\n244: ): Promise<MosaicDocument> {\n245:     // The schema is documentation; render() is the gate.\n246:     const title = props.title ?? DEFAULT_TITLE;\n247:     if (typeof title !== \"string\") throw new Error(\\`\\${ID}: title must be a string.\\`);\n248:     const { width: W, height: H } = ctx.target;\n249:     const px = (fx: number, fy: number, fw: number, fh: number) => ({\n250:       x: Math.round(fx * W),\n251:       y: Math.round(fy * H),\n252:       w: Math.round(fw * W),\n253:       h: Math.round(fh * H),\n254:     });\n255: \n256:     const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n257:     const piece = (rect: { x: number; y: number; w: number; h: number }, importance: number, source: MosaicSource) =>\n258:       pieces.push({ rect: { ...rect, importance }, source });\n259: \n260:     // No backdrop rect: the page is document.backgroundColor below.\n261:     // The title rect is BOUND to the prop it shows (bind what you display).\n262:     const head = px(0.06, 0.3, 0.88, 0.2);\n263:     // Every text source is TAGGED (editor.label) so the layout contract can find it.\n264:     piece(head, 2, bindProp(tag(svgLabel(title || \" \", head.w, head.h, { maxPx: Math.round(H * 0.08), maxLines: 1, color: INK }), \"title\"), \"title\"));\n265: \n266:     // Static caption - not a prop, so nothing to bind.\n267:     const cap = px(0.06, 0.6, 0.88, 0.08);\n268:     piece(cap, 2, tag(svgLabel(\"replace this scaffold with the one thing this template teaches\", cap.w, cap.h, { maxPx: Math.round(H * 0.026), maxLines: 1, color: DIM }), \"caption\"));\n269: \n270:     const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n271:     const doc: MosaicDocument = {\n272:       kind: \"mosaic_document\",\n273:       version: 1,\n274:       m0: toM0String(placed.m0, ID),\n275:       assets: {},\n276:       backgroundColor: PAGE,\n277:       sources: placed.sources,\n278:     };\n279:     return withLayoutIntent(doc, ctx, { templateId: ID, constraints: layoutContract(), debug: props.debugLayout === true });\n280: }\n281: `;\n282: \n283: const testTs = `import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\n284: import { resolvePropBindings } from \"@m0saic/template-utils\";\n285: \n286: import { asDocument, targetCtx } from \"../../../__testutils__/render\";\n287: import { layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\n288: import { ${exportName} } from \"./${slug}\";\n289: \n290: const render = (\n291:   props: Parameters<typeof ${exportName}.render>[0] = {},\n292:   w = 1280,\n293:   h = 720,\n294: ) => ${exportName}.render({ ...${exportName}.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n295: \n296: describe(${JSON.stringify(ID)}, () => {\n297:   it(\"binds the title rect to the title prop - Make's double-click edits it in place\", async () => {\n298:     const doc = await render();\n299:     const { byProp, rejected } = resolvePropBindings(doc, 1280, 720, { propsSchema: ${exportName}.propsSchema });\n300:     expect(rejected).toEqual([]);\n301:     expect(byProp.title).toHaveLength(1);\n302:   });\n303: \n304:   it(\"clears its safe minimum at its own hint\", async () => {\n305:     const ev = evaluateM0(String((await render()).m0), { width: 1280, height: 720 });\n306:     expect(ev.feasible && ev.meetsPrecision).toBe(true);\n307:   });\n308: \n309:   it(\"keeps its layout contract at the seven contract canvases - defaults, a long title, an empty one\", async () => {\n310:     expect(layoutIntentOf(await render())).not.toBeNull();\n311:     for (const over of [{}, { title: \"A title long enough to have to shrink before it fits the band on a narrow canvas\" }, { title: \"\" }]) {\n312:       await sweepLayout((p, ctx) => ${exportName}.render(p, ctx).then(asDocument), ${JSON.stringify(ID)}, { ...${exportName}.defaultProps, ...over }, (w, h) => targetCtx(w, h));\n313:     }\n314:     expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n315:   });\n316: \n317:   it(\"is deterministic and rejects a title that is not a string\", async () => {\n318:     expect(await render()).toEqual(await render());\n319:     await expect(render({ title: 42 as never })).rejects.toThrow(/must be a string/);\n320:   });\n321: });\n322: `;\n323: write(`${packDir}/${slug}/v1/${slug}.ts`, templateTs);\n324: write(`${packDir}/${slug}/v1/${slug}.test.ts`, testTs);\n325: \n326: // ── registry row ──\n327: const row = `  {\n328:     slug: ${JSON.stringify(slug)},\n329:     templateId: ${JSON.stringify(ID)},\n330:     exportName: ${JSON.stringify(exportName)},\n331:     title: ${JSON.stringify(DATED_TITLE)},\n332:     description:\n333:       ${JSON.stringify(description)},\n334:     tags: ${JSON.stringify(TAGS)},\n335:   },\n336: `;\n337: const registryVar = `${camel(pack)}Registry`;\n338: const templatesVar = `${camel(pack)}Templates`;\n339: if (packExists) {\n340:   const rel = `${packDir}/registry.ts`;\n341:   const s = read(rel);\n342:   const i = s.lastIndexOf(\"];\");\n343:   if (i < 0) { console.error(`new-template: ${rel} has no closing ];`); process.exit(1); }\n344:   write(rel, s.slice(0, i) + row + s.slice(i));\n345:   const irel = `${packDir}/index.ts`;\n346:   let idx = read(irel);\n347:   const importLine = `import { ${exportName} } from \"./${slug}/v1/${slug}\";\\n`;\n348:   const lastImport = idx.lastIndexOf(\"\\nimport {\");\n349:   const lastImportEnd = idx.indexOf(\"\\n\", idx.indexOf(\";\", lastImport)) + 1;\n350:   idx = idx.slice(0, lastImportEnd) + importLine + idx.slice(lastImportEnd);\n351:   const arr = idx.indexOf(`export const ${templatesVar}`);\n352:   const close = idx.indexOf(\"];\", arr);\n353:   idx = idx.slice(0, close) + `  ${exportName} as unknown as MosaicTemplate<MosaicTemplateProps>,\\n` + idx.slice(close);\n354:   idx = idx.trimEnd() + `\\nexport * from \"./${slug}/v1/${slug}\";\\n`;\n355:   write(irel, idx);\n356: } else {\n357:   write(`${packDir}/registry.ts`, `import type { StarterRegistryEntry } from \"../registry-types\";\n358: \n359: /**\n360:  * ${STARTER ? \"Chapter\" : \"Pack\"} registry: \\`${pack}\\` — array order is the ${STARTER ? \"teaching\" : \"display\"} order.\n361:  */\n362: export const ${registryVar}: StarterRegistryEntry[] = [\n363: ${row}];\n364: `);\n365:   write(`${packDir}/index.ts`, `import type { MosaicTemplate, MosaicTemplateProps } from \"@m0saic/types\";\n366: \n367: import { ${exportName} } from \"./${slug}/v1/${slug}\";\n368: \n369: /** ${STARTER ? \"Chapter\" : \"Pack\"} \\`${pack}\\`, in registry order (mirrors ./registry.ts). */\n370: export const ${templatesVar}: MosaicTemplate<MosaicTemplateProps>[] = [\n371:   ${exportName} as unknown as MosaicTemplate<MosaicTemplateProps>,\n372: ];\n373: \n374: // \\`export *\\` ONLY — see the note in src/index.ts.\n375: export * from \"./${slug}/v1/${slug}\";\n376: `);\n377:   // repo.ts pack descriptor\n378:   let repo = read(\"src/repo.ts\");\n379:   const packsClose = repo.indexOf(\"];\", repo.indexOf(\"TEMPLATE_PACKS\"));\n380:   repo = repo.slice(0, packsClose) + `  {\n381:     id: ${JSON.stringify(pack)},\n382:     title: ${JSON.stringify(pascal(pack).replace(/([A-Z])/g, \" $1\").trim())},\n383:     description:\n384:       ${JSON.stringify(`${pascal(pack)}: one line on what this pack teaches.`)},\n385:   },\n386: ` + repo.slice(packsClose);\n387:   write(\"src/repo.ts\", repo);\n388:   // template-registry.ts\n389:   let tr = read(\"src/template-registry.ts\");\n390:   const lastReg = tr.lastIndexOf('/registry\";');\n391:   const lastRegEnd = tr.indexOf(\"\\n\", lastReg) + 1;\n392:   tr = tr.slice(0, lastRegEnd) + `import { ${registryVar} } from \"./${pack}/registry\";\\n` + tr.slice(lastRegEnd);\n393:   const chClose = tr.indexOf(\"];\", tr.indexOf(\"CHAPTERS\"));\n394:   tr = tr.slice(0, chClose) + `  { pack: ${JSON.stringify(pack)}, entries: ${registryVar} },\\n` + tr.slice(chClose);\n395:   write(\"src/template-registry.ts\", tr);\n396:   // src/index.ts\n397:   let ix = read(\"src/index.ts\");\n398:   const lastTplImport = ix.lastIndexOf('Templates } from \"./');\n399:   const lastTplImportEnd = ix.indexOf(\"\\n\", lastTplImport) + 1;\n400:   ix = ix.slice(0, lastTplImportEnd) + `import { ${templatesVar} } from \"./${pack}\";\\n` + ix.slice(lastTplImportEnd);\n401:   const arrClose = ix.indexOf(\"];\", ix.indexOf(\"export const templates\"));\n402:   ix = ix.slice(0, arrClose) + `  ...${templatesVar},\\n` + ix.slice(arrClose);\n403:   const lastExport = ix.lastIndexOf('export * from \"./');\n404:   const lastExportEnd = ix.indexOf(\"\\n\", lastExport) + 1;\n405:   ix = ix.slice(0, lastExportEnd) + `export * from \"./${pack}\";\\n` + ix.slice(lastExportEnd);\n406:   write(\"src/index.ts\", ix);\n407:   // CURRICULUM.md (starter): the dep policy lints for a `## <pack>` heading\n408:   if (fs.existsSync(path.join(ROOT, \"CURRICULUM.md\"))) {\n409:     let cur = read(\"CURRICULUM.md\");\n410:     const section = `## ${pack}\\n\\nWhat this chapter teaches, in a paragraph.\\n\\n| # | Template | id |\\n|---|---|---|\\n| ${DATE} | ${title} | \\`${pack}/${slug}/v1\\` |\\n`;\n411:     const anchor = \"\\n---\\n\\n## What is not here yet\\n\";\n412:     cur = cur.includes(anchor) ? cur.replace(anchor, `\\n${section}${anchor}`) : cur.trimEnd() + `\\n\\n${section}`;\n413:     write(\"CURRICULUM.md\", cur);\n414:   }\n415: }\n416: if (STARTER && packExists) {\n417:   // append the CURRICULUM row to the chapter's table\n418:   const rel = \"CURRICULUM.md\";\n419:   if (fs.existsSync(path.join(ROOT, rel))) {\n420:     const cur = read(rel);\n421:     const h = cur.indexOf(`\\n## ${pack}\\n`);\n422:     if (h >= 0) {\n423:       const tableEnd = (() => { let i = cur.indexOf(\"\\n|\", h); let last = -1; while (i >= 0 && i < (cur.indexOf(\"\\n## \", h + 1) < 0 ? cur.length : cur.indexOf(\"\\n## \", h + 1))) { last = i; i = cur.indexOf(\"\\n|\", i + 1); } return last; })();\n424:       if (tableEnd >= 0) {\n425:         const lineEnd = cur.indexOf(\"\\n\", tableEnd + 1);\n426:         write(rel, cur.slice(0, lineEnd) + `\\n| ${DATE} | ${title} | \\`${pack}/${slug}/v1\\` |` + cur.slice(lineEnd));\n427:       }\n428:     }\n429:   }\n430: }\n431: \n432: console.log(`new-template: ${ID}  (${DATED_TITLE})`);\n433: for (const f of touched) console.log(`  ${fs.existsSync(path.join(ROOT, f)) ? \"wrote\" : \"?\"}  ${f}`);\n434: console.log(\"\\nNext:\\n  npm run build && npm run previews && npm run build && npm run fingerprints:update && npm run verify\\n  then edit \" + `${packDir}/${slug}/v1/${slug}.ts` + \" — the header comment is the lesson; \" + `${slug}.layout.m0` + \" beside it is the layout fingerprint;\\n  write the description and the search tags into the template's row in \" + `${packDir}/registry.ts` + \" too — that row, not the template file, is what the manifest and TEMPLATES.md show;\\n  fill WHY (the why-tutorial: who, the observed problem, its sources, the solution, how to use it) — the build refuses a \" + PLACEHOLDER + \".\");\n\n(End of file - total 434 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env node\n/**\n * new-template — scaffold one template that passes every convention on the\n * first build, and wire it everywhere the repo expects.\n *\n *   node tools/new-template.mjs <pack>/<slug> [--title \"Human Title\"] [--description \"One line.\"]\n *\n * Writes:\n *   src/<pack>/<slug>/v1/<slug>.ts        the template (typed props, bound\n *                                         text, fitted copy, deterministic) with\n *                                         its WHY spec + renderTutorial (the\n *                                         why-tutorial convention, src/_shared/why.ts),\n *                                         pre-filled from today's journal when\n *                                         ONE_A_DAY_DAY_DIR (or journal/<today>/) exists\n *   src/<pack>/<slug>/v1/<slug>.test.ts   locks bindings, floors, determinism\n * and appends a row to src/<pack>/registry.ts + the import / array entry /\n * `export *` in src/<pack>/index.ts. A NEW pack also gets registry.ts +\n * index.ts and is wired into src/repo.ts, src/template-registry.ts and\n * src/index.ts (and CURRICULUM.md, where one exists).\n *","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\tools\\new-template.mjs","text":"#!/usr/bin/env node\n/**\n * new-template — scaffold one template that passes every convention on the\n * first build, and wire it everywhere the repo expects.\n *\n *   node tools/new-template.mjs <pack>/<slug> [--title \"Human Title\"] [--description \"One line.\"]\n *\n * Writes:\n *   src/<pack>/<slug>/v1/<slug>.ts        the template (typed props, bound\n *                                         text, fitted copy, deterministic) with\n *                                         its WHY spec + renderTutorial (the\n *                                         why-tutorial convention, src/_shared/why.ts),\n *                                         pre-filled from today's journal when\n *                                         ONE_A_DAY_DAY_DIR (or journal/<today>/) exists\n *   src/<pack>/<slug>/v1/<slug>.test.ts   locks bindings, floors, determinism\n * and appends a row to src/<pack>/registry.ts + the import / array entry /\n * `export *` in src/<pack>/index.ts. A NEW pack also gets registry.ts +\n * index.ts and is wired into src/repo.ts, src/template-registry.ts and\n * src/index.ts (and CURRICULUM.md, where one exists).\n *\n * The title is \"<date> · <Title>\" and the tags carry the date and the day\n * (\"2026-09-20\", \"day-001\"): hosts sort the grid by name or by first tag, so\n * the day is the ordinal (a repo that ships daily outgrows \"NN ·\" fast).\n *\n * Then: npm run build && npm run previews && npm run build && npm run verify\n */\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { spawnSync } from \"node:child_process\";\nimport { fileURLToPath, pathToFileURL } from \"node:url\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst argv = process.argv.slice(2);\nconst target = argv.find((a) => !a.startsWith(\"--\"));\nconst opt = (name) => { const i = argv.indexOf(name); return i >= 0 ? argv[i + 1] : undefined; };\nif (!target || !/^[a-z][a-z0-9-]*\\/[a-z][a-z0-9-]*$/.test(target)) {\n  console.error('usage: node tools/new-template.mjs <pack>/<slug> [--title \"Human Title\"] [--description \"One line.\"]\\n  pack and slug: lowercase, digits, dashes.');\n  process.exit(2);\n}\nconst [pack, slug] = target.split(\"/\");\nconst pascal = (s) => s.split(\"-\").map((w) => w[0].toUpperCase() + w.slice(1)).join(\"\");\nconst camel = (s) => { const p = pascal(s); return p[0].toLowerCase() + p.slice(1); };\nconst title = opt(\"--title\") ?? slug.split(\"-\").map((w) => w[0].toUpperCase() + w.slice(1)).join(\" \");\nconst description = opt(\"--description\") ?? `${title}: describe the ONE concept this template teaches, in one line, for the Templates page.`;\nconst exportName = `${pascal(slug)}V1`;\nconst read = (rel) => fs.readFileSync(path.join(ROOT, rel), \"utf8\");\nconst write = (rel, s) => { fs.mkdirSync(path.dirname(path.join(ROOT, rel)), { recursive: true }); fs.writeFileSync(path.join(ROOT, rel), s); touched.push(rel); };\nconst touched = [];\n\nconst repoId = /repoId:\\s*asRepoId\\(\"([^\"]+)\"\\)/.exec(read(\"src/repo.ts\"))?.[1];\nif (!repoId) { console.error(\"new-template: could not read repoId from src/repo.ts\"); process.exit(1); }\nconst ID = `${repoId}/${pack}/${slug}/v1`;\nconst STARTER = fs.existsSync(path.join(ROOT, \"src/_shared/tutorial.ts\"));\nconst packDir = `src/${pack}`;\nconst packExists = fs.existsSync(path.join(ROOT, packDir, \"registry.ts\"));\nif (fs.existsSync(path.join(ROOT, packDir, slug))) { console.error(`new-template: ${packDir}/${slug} already exists`); process.exit(1); }\n\n// The `harness` pack is internal fixtures (hidden, unnumbered): a day's\n// template never lands there (the gate refuses it too).\nconst INTERNAL_PACKS = new Set([\"harness\"]);\nif (INTERNAL_PACKS.has(pack)) { console.error(`new-template: ${pack}/ is the internal harness pack — a day's template goes in a public pack (see pipeline/config.json packs.vocabulary)`); process.exit(1); }\n\n// ── the WHY skeleton: pre-filled from today's journal where it already knows ──\n// The runner sets ONE_A_DAY_DAY_DIR / ONE_A_DAY_DATE; an interactive session\n// gets journal/<today>/ when it exists. Anything the journal cannot supply is\n// the placeholder the gate refuses, so an unfilled WHY cannot ship.\nconst PLACEHOLDER = \"[fill me]\";\nconst readJson = (file) => { try { return JSON.parse(fs.readFileSync(file, \"utf8\")); } catch { return null; } };\nconst todayIso = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \"0\")}-${String(d.getDate()).padStart(2, \"0\")}`; };\nconst DATE = process.env.ONE_A_DAY_DATE ?? todayIso();\nconst DAY_DIR = process.env.ONE_A_DAY_DAY_DIR ?? path.join(ROOT, \"journal\", DATE);\nconst dayState = readJson(path.join(DAY_DIR, \"state.json\")) ?? {};\nconst dayRun = readJson(path.join(DAY_DIR, \"run.json\")) ?? {};\nconst indexRows = (() => { const v = readJson(path.join(ROOT, \"journal\", \"index.json\")); return Array.isArray(v) ? v : []; })();\nconst dayNumber = (() => { const row = indexRows.find((r) => r.date === DATE); return row?.day ?? indexRows.filter((r) => r.date < DATE).length + 1; })();\nconst ascii = (v) => String(v).replace(/[^\\x20-\\x7e]/g, \"?\").replace(/\\s+/g, \" \").trim();\nconst WHY = {\n  day: dayNumber,\n  date: DATE,\n  agent: ascii(dayRun.runner?.adapter ?? PLACEHOLDER),\n  model: ascii(dayRun.model?.selfDeclared ?? PLACEHOLDER),\n  id: ID,\n  title,\n  who: dayState.who ? ascii(dayState.who) : `${PLACEHOLDER} who has the problem, and where they were found`,\n  problem: [dayState.useCase ? ascii(dayState.useCase) : `${PLACEHOLDER} what was observed, in the evidence's words`],\n  sources: Array.isArray(dayState.sources) && dayState.sources.length ? dayState.sources.map(ascii).slice(0, 12) : [`https://example.com/${PLACEHOLDER.replace(/[^a-z]/g, \"\")}`],\n  solution: [ascii(description)],\n  usage: { command: `m0saic make ${ID} --template-repo . -w 1280 -h 720 -o out.png`, try: [] },\n};\n// timeline: the runner's trace so far (scout, plan, this build call) - the ship\n// phase re-copies it once every phase has run. No trace = self-reported, and a\n// placeholder phase name so the gate refuses an unfilled one.\nconst trace = readJson(path.join(DAY_DIR, \"trace.json\"));\nif (trace && Array.isArray(trace.phases) && trace.phases.length) {\n  const { timelineFromTrace } = await import(pathToFileURL(path.join(ROOT, \"pipeline\", \"lib\", \"trace.mjs\")).href);\n  WHY.timeline = timelineFromTrace(trace);\n} else {\n  WHY.timeline = { source: \"self-reported\", phases: [{ name: `${PLACEHOLDER} scout`, startMs: 0, durMs: 0 }] };\n}\nconst whyLiteral = JSON.stringify(WHY, null, 2);\n// The display title carries the day it shipped; the tags make it sortable\n// and searchable by date and by day number.\nconst DAY_TAG = `day-${String(dayNumber).padStart(3, \"0\")}`;\nconst DATED_TITLE = `${DATE} · ${title}`;\nconst TAGS = [pack, DATE, DAY_TAG];\n\n// ── the template ──\nconst tutorialImport = STARTER ? `\\nimport { lessonTutorial } from \"../../../_shared/tutorial\";\\n` : \"\";\nconst tutorial = STARTER ? `\n  renderTutorial: lessonTutorial({\n    title: ${JSON.stringify(title)},\n    lines: [\n      \"State the one concept this template teaches, in a sentence a reader can act on.\",\n      \"Name the rule that bites - the thing that costs an afternoon when you get it wrong.\",\n    ],\n    explore: [\n      \"Double-click the title on the preview - it is bound\",\n      \"Resize the preview - the title keeps its band\",\n    ],\n  }),\n` : \"\";\nconst templateTs = `import type {\n  MosaicColor,\n  MosaicDocument,\n  MosaicEngineContext,\n  MosaicSource,\n} from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport {\n  bindProp,\n  defineMosaicTemplate,\n  definePropsSchema,\n  placeInsetPieces,\n  svgLabel,\n  tag,\n} from \"@m0saic/template-utils\";\nimport type { LayoutConstraint } from \"@m0saic/template-utils\";\nimport { TEXT_EM, textFitsAll, withLayoutIntent } from \"../../../_shared/layout\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n${tutorialImport}\n/**\n * \\`${ID}\\` — one line on what it draws.\n *\n * ONE CONCEPT: the single idea, stated plainly.\n *\n * The rule that bites: the thing that will cost someone an afternoon.\n *\n * Scaffolded by tools/new-template.mjs — it passes every build-gate and\n * doctor convention as generated (typed props with defaults, a bound title,\n * fitted svg copy, deterministic geometry from ctx.target, the page colour\n * as the document background and never a full-canvas rect, no prop that\n * nothing on the canvas shows). Replace the body; keep the shape.\n */\n\nexport type ${pascal(slug)}Props = {\n  /** Headline - the rect that shows it is bound to it. */\n  title?: string;\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = ${JSON.stringify(ID)};\nconst INK = \"#eaeef2\" as MosaicColor;\nconst DIM = \"#9aa7b4\" as MosaicColor;\n/** The page: document.backgroundColor. A full-canvas colour rect would be a\n *  click target over everything (doctor: canvasFill), and a colour PROP with\n *  no rect to bind it to would need declaring (doctor: bindingsDeclared). */\nconst PAGE = \"#1c2833\" as MosaicColor;\nconst DEFAULT_TITLE = ${JSON.stringify(title)};\n\nconst propsSchema = definePropsSchema<${pascal(slug)}Props>({\n  title: {\n    type: \"string\",\n    required: false,\n    description: \"Headline. The rect that shows it is bound to it, so Make's double-click edits it in place.\",\n    meta: { control: { placeholder: DEFAULT_TITLE }, ui: { label: \"Title\", order: 1 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits its box, the title sits in its band) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n/**\n * What the geometry promises, as canvas-independent invariants against the\n * source labels - the layout contract (src/_shared/layout.ts). Every text\n * gets textFits with the bundled font's calibrated ruler (TEXT_EM.prose;\n * a template that measures the block itself uses textFitsMeasured, exact);\n * the chrome the design depends on gets a band. Only labels that rendered.\n */\nfunction layoutContract(): LayoutConstraint[] {\n  return [\n    ...textFitsAll([\"title\", \"caption\"], { charWidthEm: TEXT_EM.prose }),\n    { label: \"title\", within: { yFrac: [0.2, 0.6] }, minWidthFrac: 0.5 },\n    { label: \"caption\", within: { yFrac: [0.5, 0.8] } },\n  ];\n}\n\n/**\n * Why this template exists - rendered by \\`renderTutorial\\` (the why-tutorial\n * convention, src/_shared/why.ts): the run, the problem with the sources the\n * agent opened, the solution, how to use it, then the template itself.\n * Pre-filled from journal/${DATE}/ - replace every \"${PLACEHOLDER}\" and say it\n * in the evidence's own words. The build refuses a placeholder.\n */\nconst WHY: WhySpec = ${whyLiteral};\n\nexport const ${exportName} = defineMosaicTemplate<${pascal(slug)}Props>({\n  id: asTemplateId(ID),\n  label: ${JSON.stringify(DATED_TITLE)},\n  version: 1,\n  description: ${JSON.stringify(description)},\n  capabilities: { tier: \"core\" },\n  tags: ${JSON.stringify(TAGS)},\n\n  outputHints: {\n    width: 1280,\n    height: 720,\n    fps: 30,\n    durationMs: 2000,\n    format: { kind: \"image\", container: \"png\" },\n    note: \"Static card - any canvas and any duration render cleanly.\",\n  },\n\n  propsSchema,\n  defaultProps: {\n    title: DEFAULT_TITLE,\n    debugLayout: false,\n  },\n\n  render,\n  renderTutorial: whyTutorial(WHY, render),\n${tutorial}});\n\nexport default ${exportName};\n\nasync function render(\n  props: ${pascal(slug)}Props,\n  ctx: MosaicEngineContext,\n): Promise<MosaicDocument> {\n    // The schema is documentation; render() is the gate.\n    const title = props.title ?? DEFAULT_TITLE;\n    if (typeof title !== \"string\") throw new Error(\\`\\${ID}: title must be a string.\\`);\n    const { width: W, height: H } = ctx.target;\n    const px = (fx: number, fy: number, fw: number, fh: number) => ({\n      x: Math.round(fx * W),\n      y: Math.round(fy * H),\n      w: Math.round(fw * W),\n      h: Math.round(fh * H),\n    });\n\n    const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n    const piece = (rect: { x: number; y: number; w: number; h: number }, importance: number, source: MosaicSource) =>\n      pieces.push({ rect: { ...rect, importance }, source });\n\n    // No backdrop rect: the page is document.backgroundColor below.\n    // The title rect is BOUND to the prop it shows (bind what you display).\n    const head = px(0.06, 0.3, 0.88, 0.2);\n    // Every text source is TAGGED (editor.label) so the layout contract can find it.\n    piece(head, 2, bindProp(tag(svgLabel(title || \" \", head.w, head.h, { maxPx: Math.round(H * 0.08), maxLines: 1, color: INK }), \"title\"), \"title\"));\n\n    // Static caption - not a prop, so nothing to bind.\n    const cap = px(0.06, 0.6, 0.88, 0.08);\n    piece(cap, 2, tag(svgLabel(\"replace this scaffold with the one thing this template teaches\", cap.w, cap.h, { maxPx: Math.round(H * 0.026), maxLines: 1, color: DIM }), \"caption\"));\n\n    const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n    const doc: MosaicDocument = {\n      kind: \"mosaic_document\",\n      version: 1,\n      m0: toM0String(placed.m0, ID),\n      assets: {},\n      backgroundColor: PAGE,\n      sources: placed.sources,\n    };\n    return withLayoutIntent(doc, ctx, { templateId: ID, constraints: layoutContract(), debug: props.debugLayout === true });\n}\n`;\n\nconst testTs = `import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { resolvePropBindings } from \"@m0saic/template-utils\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport { ${exportName} } from \"./${slug}\";\n\nconst render = (\n  props: Parameters<typeof ${exportName}.render>[0] = {},\n  w = 1280,\n  h = 720,\n) => ${exportName}.render({ ...${exportName}.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n\ndescribe(${JSON.stringify(ID)}, () => {\n  it(\"binds the title rect to the title prop - Make's double-click edits it in place\", async () => {\n    const doc = await render();\n    const { byProp, rejected } = resolvePropBindings(doc, 1280, 720, { propsSchema: ${exportName}.propsSchema });\n    expect(rejected).toEqual([]);\n    expect(byProp.title).toHaveLength(1);\n  });\n\n  it(\"clears its safe minimum at its own hint\", async () => {\n    const ev = evaluateM0(String((await render()).m0), { width: 1280, height: 720 });\n    expect(ev.feasible && ev.meetsPrecision).toBe(true);\n  });\n\n  it(\"keeps its layout contract at the seven contract canvases - defaults, a long title, an empty one\", async () => {\n    expect(layoutIntentOf(await render())).not.toBeNull();\n    for (const over of [{}, { title: \"A title long enough to have to shrink before it fits the band on a narrow canvas\" }, { title: \"\" }]) {\n      await sweepLayout((p, ctx) => ${exportName}.render(p, ctx).then(asDocument), ${JSON.stringify(ID)}, { ...${exportName}.defaultProps, ...over }, (w, h) => targetCtx(w, h));\n    }\n    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n  });\n\n  it(\"is deterministic and rejects a title that is not a string\", async () => {\n    expect(await render()).toEqual(await render());\n    await expect(render({ title: 42 as never })).rejects.toThrow(/must be a string/);\n  });\n});\n`;\nwrite(`${packDir}/${slug}/v1/${slug}.ts`, templateTs);\nwrite(`${packDir}/${slug}/v1/${slug}.test.ts`, testTs);\n\n// ── registry row ──\nconst row = `  {\n    slug: ${JSON.stringify(slug)},\n    templateId: ${JSON.stringify(ID)},\n    exportName: ${JSON.stringify(exportName)},\n    title: ${JSON.stringify(DATED_TITLE)},\n    description:\n      ${JSON.stringify(description)},\n    tags: ${JSON.stringify(TAGS)},\n  },\n`;\nconst registryVar = `${camel(pack)}Registry`;\nconst templatesVar = `${camel(pack)}Templates`;\nif (packExists) {\n  const rel = `${packDir}/registry.ts`;\n  const s = read(rel);\n  const i = s.lastIndexOf(\"];\");\n  if (i < 0) { console.error(`new-template: ${rel} has no closing ];`); process.exit(1); }\n  write(rel, s.slice(0, i) + row + s.slice(i));\n  const irel = `${packDir}/index.ts`;\n  let idx = read(irel);\n  const importLine = `import { ${exportName} } from \"./${slug}/v1/${slug}\";\\n`;\n  const lastImport = idx.lastIndexOf(\"\\nimport {\");\n  const lastImportEnd = idx.indexOf(\"\\n\", idx.indexOf(\";\", lastImport)) + 1;\n  idx = idx.slice(0, lastImportEnd) + importLine + idx.slice(lastImportEnd);\n  const arr = idx.indexOf(`export const ${templatesVar}`);\n  const close = idx.indexOf(\"];\", arr);\n  idx = idx.slice(0, close) + `  ${exportName} as unknown as MosaicTemplate<MosaicTemplateProps>,\\n` + idx.slice(close);\n  idx = idx.trimEnd() + `\\nexport * from \"./${slug}/v1/${slug}\";\\n`;\n  write(irel, idx);\n} else {\n  write(`${packDir}/registry.ts`, `import type { StarterRegistryEntry } from \"../registry-types\";\n\n/**\n * ${STARTER ? \"Chapter\" : \"Pack\"} registry: \\`${pack}\\` — array order is the ${STARTER ? \"teaching\" : \"display\"} order.\n */\nexport const ${registryVar}: StarterRegistryEntry[] = [\n${row}];\n`);\n  write(`${packDir}/index.ts`, `import type { MosaicTemplate, MosaicTemplateProps } from \"@m0saic/types\";\n\nimport { ${exportName} } from \"./${slug}/v1/${slug}\";\n\n/** ${STARTER ? \"Chapter\" : \"Pack\"} \\`${pack}\\`, in registry order (mirrors ./registry.ts). */\nexport const ${templatesVar}: MosaicTemplate<MosaicTemplateProps>[] = [\n  ${exportName} as unknown as MosaicTemplate<MosaicTemplateProps>,\n];\n\n// \\`export *\\` ONLY — see the note in src/index.ts.\nexport * from \"./${slug}/v1/${slug}\";\n`);\n  // repo.ts pack descriptor\n  let repo = read(\"src/repo.ts\");\n  const packsClose = repo.indexOf(\"];\", repo.indexOf(\"TEMPLATE_PACKS\"));\n  repo = repo.slice(0, packsClose) + `  {\n    id: ${JSON.stringify(pack)},\n    title: ${JSON.stringify(pascal(pack).replace(/([A-Z])/g, \" $1\").trim())},\n    description:\n      ${JSON.stringify(`${pascal(pack)}: one line on what this pack teaches.`)},\n  },\n` + repo.slice(packsClose);\n  write(\"src/repo.ts\", repo);\n  // template-registry.ts\n  let tr = read(\"src/template-registry.ts\");\n  const lastReg = tr.lastIndexOf('/registry\";');\n  const lastRegEnd = tr.indexOf(\"\\n\", lastReg) + 1;\n  tr = tr.slice(0, lastRegEnd) + `import { ${registryVar} } from \"./${pack}/registry\";\\n` + tr.slice(lastRegEnd);\n  const chClose = tr.indexOf(\"];\", tr.indexOf(\"CHAPTERS\"));\n  tr = tr.slice(0, chClose) + `  { pack: ${JSON.stringify(pack)}, entries: ${registryVar} },\\n` + tr.slice(chClose);\n  write(\"src/template-registry.ts\", tr);\n  // src/index.ts\n  let ix = read(\"src/index.ts\");\n  const lastTplImport = ix.lastIndexOf('Templates } from \"./');\n  const lastTplImportEnd = ix.indexOf(\"\\n\", lastTplImport) + 1;\n  ix = ix.slice(0, lastTplImportEnd) + `import { ${templatesVar} } from \"./${pack}\";\\n` + ix.slice(lastTplImportEnd);\n  const arrClose = ix.indexOf(\"];\", ix.indexOf(\"export const templates\"));\n  ix = ix.slice(0, arrClose) + `  ...${templatesVar},\\n` + ix.slice(arrClose);\n  const lastExport = ix.lastIndexOf('export * from \"./');\n  const lastExportEnd = ix.indexOf(\"\\n\", lastExport) + 1;\n  ix = ix.slice(0, lastExportEnd) + `export * from \"./${pack}\";\\n` + ix.slice(lastExportEnd);\n  write(\"src/index.ts\", ix);\n  // CURRICULUM.md (starter): the dep policy lints for a `## <pack>` heading\n  if (fs.existsSync(path.join(ROOT, \"CURRICULUM.md\"))) {\n    let cur = read(\"CURRICULUM.md\");\n    const section = `## ${pack}\\n\\nWhat this chapter teaches, in a paragraph.\\n\\n| # | Template | id |\\n|---|---|---|\\n| ${DATE} | ${title} | \\`${pack}/${slug}/v1\\` |\\n`;\n    const anchor = \"\\n---\\n\\n## What is not here yet\\n\";\n    cur = cur.includes(anchor) ? cur.replace(anchor, `\\n${section}${anchor}`) : cur.trimEnd() + `\\n\\n${section}`;\n    write(\"CURRICULUM.md\", cur);\n  }\n}\nif (STARTER && packExists) {\n  // append the CURRICULUM row to the chapter's table\n  const rel = \"CURRICULUM.md\";\n  if (fs.existsSync(path.join(ROOT, rel))) {\n    const cur = read(rel);\n    const h = cur.indexOf(`\\n## ${pack}\\n`);\n    if (h >= 0) {\n      const tableEnd = (() => { let i = cur.indexOf(\"\\n|\", h); let last = -1; while (i >= 0 && i < (cur.indexOf(\"\\n## \", h + 1) < 0 ? cur.length : cur.indexOf(\"\\n## \", h + 1))) { last = i; i = cur.indexOf(\"\\n|\", i + 1); } return last; })();\n      if (tableEnd >= 0) {\n        const lineEnd = cur.indexOf(\"\\n\", tableEnd + 1);\n        write(rel, cur.slice(0, lineEnd) + `\\n| ${DATE} | ${title} | \\`${pack}/${slug}/v1\\` |` + cur.slice(lineEnd));\n      }\n    }\n  }\n}\n\nconsole.log(`new-template: ${ID}  (${DATED_TITLE})`);\nfor (const f of touched) console.log(`  ${fs.existsSync(path.join(ROOT, f)) ? \"wrote\" : \"?\"}  ${f}`);\nconsole.log(\"\\nNext:\\n  npm run build && npm run previews && npm run build && npm run fingerprints:update && npm run verify\\n  then edit \" + `${packDir}/${slug}/v1/${slug}.ts` + \" — the header comment is the lesson; \" + `${slug}.layout.m0` + \" beside it is the layout fingerprint;\\n  write the description and the search tags into the template's row in \" + `${packDir}/registry.ts` + \" too — that row, not the template file, is what the manifest and TEMPLATES.md show;\\n  fill WHY (the why-tutorial: who, the observed problem, its sources, the solution, how to use it) — the build refuses a \" + PLACEHOLDER + \".\");","lineStart":1,"lineEnd":434,"totalLines":434,"truncated":false}},"title":"tools\\new-template.mjs","time":{"start":179