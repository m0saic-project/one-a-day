ex: string): number {\n304:   const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n305:   return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n306: }\n307: /** The readable ink over a filled chip: dark or white, whichever contrasts more with the caller's accent. */\n308: function onColor(fill: string): MosaicColor {\n309:   const ratio = (other: string) => { const a = luminance(fill), b = luminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n310:   return (ratio(\"#0b1220\") >= ratio(\"#ffffff\") ? \"#0b1220\" : \"#ffffff\") as MosaicColor;\n311: }\n312: \n313: /* ── geometry ── */\n314: \n315: export type ErgRect = { x: number; y: number; w: number; h: number };\n316: type Bind = \"rower\" | \"note\" | \"piece\" | \"split\" | \"result\" | \"spm\" | \"watts\" | \"drag\" | \"percentile\" | \"percentileCohort\" | null;\n317: type Cell = { label: string; rect: ErgRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\n318: type Tile = { label: string; rect: ErgRect; color: MosaicColor; radius: number; layer: number; accent?: boolean };\n319: \n320: /** The largest whole size up to `maxPx` at which one line fits the cell's budget (`cell * 0.94 - 2px`). */\n321: function fitPx(line: string, cellW: number, maxPx: number, bold = false): number {\n322:   const top = Math.max(1, Math.round(maxPx));\n323:   const room = budget(cellW), w = widthOf(line, top, bold);\n324:   let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n325:   while (px > 1 && widthOf(line, px, bold) > room) px--;\n326:   return px;\n327: }\n328: \n329: /** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\n330: export function layoutErgCard(props: ErgPbCardProps, W: number, H: number) {\n331:   const p = normalizeErgCard(props);\n332