p achievements - sector times, deltas vs PB, apex speeds - as shareable cards. SimTelemetry.site records telemetry at 60Hz. Drivers currently screenshot lap times or manually create graphics; a deterministic lap card lets them share standardized achievements.\"\n193\t  ],\n194\t  \"sources\": [\n195\t    \"https://simtelemetry.site\",\n196\t    \"https://news.ycombinator.com/item?id=49045861\"\n197\t  ],\n198\t  \"solution\": [\n199\t    \"A deterministic lap card: each sector shows its time and delta (negative = faster, positive = slower) with a proportional bar that is green when faster or red when slower than PB. Driver name and top speed complete the context. The delta bar makes it obvious at a glance which sector was the bottleneck on this run.\"\n200\t  ],\n201\t  \"usage\": {\n202\t    \"command\": \"m0saic make @one-a-day/sports/lap-telemetry-card/v1 --template-repo . -w 1280 -h 720 -o lap.png\",\n203\t    \"try\": [\n204\t      \"Add --topSpeed 310 to show higher speeds\",\n205\t      \"Try portrait: -w 1080 -h 1920\",\n206\t      \"Square crop: -w 1080 -h 1080\"\n207\t    ]\n208\t  },\n209\t  \"timeline\": {\n210\t    \"source\": \"runner\",\n211\t    \"phases\": [\n212\t      {\n213\t        \"name\": \"scout\",\n214\t        \"startMs\": 0,\n215\t        \"durMs\": 217259,\n216\t        \"calls\": 100,\n217\t        \"tokens\": 8356979,\n218\t        \"costUsd\": 0.44,\n219\t        \"tools\": \"Bash 93, Read 4, Write 2\"\n220\t      },\n221\t      {\n222\t        \"name\": \"plan\",\n223\t        \"startMs\": 217273,\n224\t        \"durMs\": 63094,\n225\t        \"calls\": 11,\n226\t        \"tokens\": 923341,\n227\t        \"costUsd\": 0.11,\n228\t        \"tools\": \"Read 7, Glob 2, Bash 1\"\n229\t      }\n230\t    ],\n231\t    \"costBasis\": \"reported\"\n232\t  }\n233\t};\n234\t\n235\texport const LapTelemetryCardV1 = defineMosaicTemplate<LapTelemetryCardProps>({\n236\t  id: asTemplateId(ID),\n237\t  label: \"2026-10-02 · Sim Racing Lap Card\",\n238\t  version: 1,\n239\t  description: \"A sim racing lap card: track name, lap time and delta vs PB, sector breakdown with times and delta bars (green for faster, red for slower), driver name, and top speed.\",\n240\t  capabilities: { tier: \"core\" },\n241\t  tags: [\"sports\",\"2026-10-02\",\"day-013\",\"racing\",\"telemetry\",\"sector\",\"delta\"],\n242\t\n243\t  outputHints: {\n244\t    width: 1280,\n245\t    height: 720,\n246\t    fps: 30,\n247\t    durationMs: 2000,\n248\t    format: { kind: \"image\", container: \"png\" },\n249\t    note: \"Static card - renders cleanly at any canvas size and duration.\",\n250\t  },\n251\t\n252\t  propsSchema,\n253\t  defaultProps: {\n254\t    trackName: DEFAULTS.trackName,\n255\t    lapTime: DEFAULTS.lapTime,\n256\t    pbTime: DEFAULTS.pbTime,\n257\t    sector1Time: DEFAULTS.sector1Time,\n258\t    sector2Time: DEFAULTS.sector2Time,\n259\t    sector3Time: DEFAULTS.sector3Time,\n260\t    sector1Pb: DEFAULTS.sector1Pb,\n261\t    sector2Pb: DEFAULTS.sector2Pb,\n262\t    sector3Pb: DEFAULTS.sector3Pb,\n263\t    driverId: DEFAULTS.driverId,\n264\t    topSpeed: DEFAULTS.topSpeed,\n265\t    debugLayout: false,\n266\t  },\n267\t\n268\t  render,\n269\t  renderTutorial: whyTutorial(WHY, render),\n270\t});\n271\t\n272\texport default LapTelemetryCardV1;\n273\t\n274\tfunction parseTimeToMs(timeStr: string): number {\n275\t  const parts = timeStr.trim().split(\":\");\n276\t  if (parts.length === 1) {\n277\t    return Math.round(parseFloat(parts[0]) * 1000);\n278\t  } else if (parts.length === 2) {\n279\t    const mins = parseInt(parts[0], 10);\n280\t    const secs = parseFloat(parts[1]);\n281\t    return Math.round((mins * 60 + secs) * 1000);\n282\t  }\n283\t  throw new Error(`Invalid time format: ${timeStr}`);\n284\t}\n285\t\n286\tfunction formatTime(ms: number): string {\n287\t  const totalSecs = ms / 1000;\n288\t  const mins = Math.floor(totalSecs / 60);\n289\t  const secs = totalSecs - mins * 60;\n290\t  if (mins > 0) {\n291\t    return `${mins}:${secs.toFixed(3).padStart(7, \"0\")}`;\n292\t  }\n293\t  return secs.toFixed(3);\n294\t}\n295\t\n296\tfunction formatDelta(ms: number): string {\n297\t  const sign = ms >= 0 ? \"+\" : \"\";\n298\t  const secs = Math.abs(ms / 1000);\n299\t  return `${sign}${secs.toFixed(3)}s`;\n300\t}\n301\t\n302\tasync function render(\n303\t  props: LapTelemetryCardProps,\n304\t  ctx: MosaicEngineContext,\n305\t): Promise<MosaicDocument> {\n306\t    const { width: W, height: H } = ctx.target;\n307\t\n308\t    const trackName = props.trackName ?? DEFAULTS.trackName;\n309\t    const lapTime = props.lapTime ?? DEFAULTS.lapTime;\n310\t    const pbTime = props.pbTime ?? DEFAULTS.pbTime;\n311\t    const sector1Time = props.sector1Time ?? DEFAULTS.sector1Time;\n312\t    const sector2Time = props.sector2Time ?? DEFAULTS.sector2Time;\n313\t    const sector3Time = props.sector3Time ?? DEFAULTS.sector3Time;\n314\t    const sector1Pb = props.sector1Pb ?? DEFAULTS.sector1Pb;\n315\t    const sector2Pb = props.sector2Pb ?? DEFAULTS.sector2Pb;\n316\t    const sector3Pb = props.sector3Pb ?? DEFAULTS.sector3Pb;\n317\t    const driverId = props.driverId ?? DEFAULTS.driverId;\n318\t    const topSpeed = props.topSpeed ?? DEFAULTS.topSpeed;\n319\t\n320\t    if (typeof trackName !== \"string\") throw new Error(`${ID}: trackName must be a string.`);\n321\t    if (typeof lapTime !== \"string\") throw new Error(`${ID}: lapTime must be a string.`);\n322\t    if (typeof pbTime !== \"string\") throw new Error(`${ID}: pbTime must be a string.`);\n323\t    if (typeof driverId !== \"string\") throw new Error(`${ID}: driverId must be a string.`);\n324\t\n325\t    const px = (fx: number, fy: number, fw: number, fh: number) => ({\n326\t      x: Math.round(fx * W),\n327\t      y: Math.round(fy * H),\n328\t      w: Math.round(fw * W),\n329\t      h: Math.round(fh * H),\n330\t    });\n331\t\n332\t    const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n333\t    const piece = (rect: { x: n