olved: false` it is a constructor's new-puzzle teaser.\n    17\t *\n    18\t * ONE CONCEPT: a lattice this big is drawn in LAYERS, not cells. The board is\n    19\t * a paper tile, a theme tile and an ink tile masked to \"board minus paper\n    20\t * cells\" (border, rules and blocks in one path), a ring tile, and one\n    21\t * multi-layer text source per row for the letters and one for the numbers\n    22\t * (each glyph placed by a pixel xExpr/yExpr). A 25x25 is ~60 frames; a\n    23\t * per-cell grid would be 1,500+, past the engine's 400-frame budget.\n    24\t *\n    25\t * The rule that bites: equal cells come from ONE integer lattice,\n    26\t * `X_k = round(x0 + k * pitch)`, that every layer reads - the mask holes, the\n    27\t * tint cells, the glyph offsets. Compute any of them from its own rounding\n    28\t * and the rules drift off the letters by a pixel per cell.\n    29\t */\n    30\t\n    31\texport type CrosswordGridCardProps = {\n    32\t  /** The solution: rows split by \"/\" or newlines, \"#\" or \".\" for a block, A-Z; an unbroken square string reads as n x n. */\n    33\t  grid?: string;\n    34\t  /** Clue ids to tint and list (\"17A 3D\"), spaces or commas. \"\" = none. */\n    35\t  themeEntries?: string;\n    36\t  /** 0-based row-major cell indices to ring (the .puz order). \"\" = none. */\n    37\t  circles?: string;\n    38\t  /** CrosswordPuzzle title, 1-40 printable ASCII. */\n    39\t  title?: string;\n    40\t  /** Constructor(s), 1-48 printable ASCII; shown as \"by <author>\". */\n    41\t  author?: string;\n    42\t  /** Outlet or series for the caption line, 1-24 printable ASCII. */\n    43\t  publication?: string;\n    44\t  /** CrosswordPuzzle date, YYYY-MM-DD. */\n    45\t  date?: string;\n    46\t  /** false = the teaser: no letters, no theme tint, no answer list. */\n    47\t  solved?: boolean;\n    48\t  /** Theme-cell fill and list swatches (#rrggbb). Never used as text ink. */\n    49\t  themeColor?: string;\n    50\t  /** Dev-only: check the layout contract and draw it over the card. */\n    51\t  debugLayout?: boolean;\n    52\t};\n    53\t\n    54\tconst ID = \"@one-a-day/gaming/crossword-grid-card/v1\";\n    55\tconst HEX = /^#[0-9a-fA-F]{6}$/;\n    56\tconst PAGE = \"#F2EFE8\" as MosaicColor;\n    57\tconst PAPER = \"#FFFFFF\" as MosaicColor;\n    58\tconst INK = \"#15171C\" as MosaicColor;\n    59\tconst DIM = \"#5E626B\" as MosaicColor;\n    60\tconst MIN_SIDE = 3;\n    61\tconst MAX_SIDE = 25;\n    62\tconst MAX_THEMES = 8;\n    63\tconst MAX_CIRCLES = 120;\n    64\tconst LETTER_EM = 0.6;\n    65\tconst NUMBER_EM = 0.28;\n    66\tconst NUMBER_FLOOR_PX = 6;\n    67\t/** Roboto: ascent 0.928 em, cap height 0.711 em - where the ink sits under a top-aligned layer. */\n    68\tconst CAP_TOP_EM = 0.928 - 0.711;\n    69\tconst CAP_MID_EM = CAP_TOP_EM + 0.711 / 2;\n    70\t\n    71\texport const CROSSWORD_DEFAULTS = {\n    72\t  grid: \"PAN#BOW/AGE#ARE/DOGSLED/##AIL##/CATNAPS/OWE#SAT/YES#TRY\",\n    73\t  themeEntries: \"9A 12A\",\n    74\t  circles: \"14 15 16 28 29 30\",\n    75\t  title: \"Cats and Dogs\",\n    76\t  author: \"one-a-day agent\",\n    77\t  publication: \"Demo Mini\",\n    78\t  date: \"2026-09-29\",\n    79\t  solved: true,\n    80\t  themeColor: \"#FFE08A\",\n    81\t  debugLayout: false,\n    82\t} as const;\n    83\t\n    84\tconst propsSchema = definePropsSchema<CrosswordGridCardProps>({\n    85\t  grid: {\n    86\t    type: \"string\",\n    87\t    required: false,\n    88\t    description: 'The solution grid. Rows split by \"/\" or newlines; \"#\" or \".\" is a block; letters A-Z (uppercase). 3-25 cells each way, rows of equal length. An unbroken string whose length is a square (the .puz solution string, puzpy p.solution) is read as n x n.',\n    89\t    meta: { control: { multiline: true, placeholder: CROSSWORD_DEFAULTS.grid }, ui: { label: \"Grid (solution rows)\", order: 1 } },\n    90\t  },\n    91\t  themeEntries: {\n    92\t    type: \"string\",\n    93\t    required: false,\n    94\t    description: 'Clue ids to tint and list, e.g. \"17A 38A 3D\" (spaces or commas). Each must exist in the grid numbering; at most 8. \"\" for none.',\n    95\t    meta: { control: { placeholder: \"17A 38A 61A\" }, ui: { label: \"Theme entries\", order: 2 } },\n    96\t  },\n    97\t  circles: {\n    98\t    type: \"string\",\n    99\t    required: false,\n   100\t    description: 'Circled squares as 0-based row-major cell indices (the .puz order), spaces or commas; each must be a white cell. \"\" for none.',\n   101\t    meta: { control: { placeholder: \"14 15 16\" }, ui: { label: \"Circled squares\", order: 3 } },\n   102\t  },\n   103\t  title: {\n   104\t    type: \"string\",\n   105\t    required: false,\n   106\t    description: \"CrosswordPuzzle title, 1-40 printable ASCII characters. The rect that shows it is bound to it.\",\n   107\t    meta: { control: { placeholder: CROSSWORD_DEFAULTS.title }, ui: { label: \"Title\", order: 4 } },\n   108\t  },\n   109\t  author: {\n   110\t    type: \"string\",\n   111\t    required: false,\n   112\t    description: 'Constructor(s), 1-48 printable ASCII characters; drawn as \"by <author>\".',\n   113\t    meta: { control: { placeholder: CROSSWORD_DEFAULTS.author }, ui: { label: \"Author\", order: 5 } },\n   114\t  },\n   115\t  publication: {\n   116\t    type: \"string\",\n   117\t    required: false,\n   118\t    description: \"Outlet or series for the caption line, 1-24 printable ASCII characters.\",\n   119\t    meta: { control: { placeholder: CROSSWORD_DEFAULTS.publication }, ui: { label: \"Publication\", order: 6 } },\n   120\t  },\n   121\t  date: {\n   122\t    type: \"string\",\n   123\t    required: false,\n   124\t    description: \"CrosswordPuzzle date as YYYY-MM-DD; the caption shows the weekday and M/D/YY.\",\n   125\t    meta: { control: { placeholder: CROSSWORD_DEFAULTS.date }, ui: { label: \"Date\", order: 7 } },\n   126\t  },\n   127\t  solved: {\n   128\t    type: \"boolean\",\n   129\t    required: false,\n   130\t    description: \"true = the solution card. false = the new-puzzle teaser: blocks, numbers and circles only; letters, theme tint and answers are hidden.\",\n   131\t    meta: { ui: { label: \"Show solution\", order: 8 } },\n   132\t  },\n   133\t  themeColor: {\n   134\t    type: \"string\",\n   135\t    required: false,\n   136\t    description: \"Theme-cell fill and list swatches as #rrggbb. Letters stay in ink.\",\n   137\t    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: CROSSWORD_DEFAULTS.themeColor }, ui: { label: \"Theme color\", order: 9 } },\n   138\t  },\n   139\t  debugLayout: {\n   140\t    type: \"boolean\",\n   141\t    required: false,\n   142\t    description: \"Dev-only: check the layout contract (every text fits, the board keeps its shape) and draw it over the card.\",\n   143\t    meta: { ui: { label: \"Debug layout\", order: 99 } },\n   144\t  },\n   145\t});\n   146\t\n   147\t// ---------------------------------------------------------------- the puzzle\n   148\t\n   149\tfunction fail(field: string, rule: string): never {\n   150\t  throw new Error(`${ID}: ${field} ${rule}`);\n   151\t}\n   152\t\n   153\texport type CrosswordPuzzle = {\n   154\t  rows: number;\n   155\t  cols: number;\n   156\t  /** Row-major; null is a block. */\n   157\t  cells: Array<string | null>;\n   158\t};\n   159\t\n   160\t/** Parse the grid prop. Every refusal names the field, and for a cell its row and column (1-based). */\n   161\texport function parseCrosswordGrid(raw: unknown): CrosswordPuzzle {\n   162\t  if (typeof raw !== \"string\") fail(\"grid\", \"must be a string of rows.\");\n   163\t  const text = raw.trim();\n   164\t  let lines = text.split(/\\s*[/\\r\\n]+\\s*/).filter((l) => l.length > 0);\n   165\t  if (lines.length === 1) {\n   166\t    const n = Math.round(Math.sqrt(lines[0].length));\n   167\t    if (n * n === lines[0].length && n >= MIN_SIDE) lines = Array.from({ length: n }, (_, r) => lines[0].slice(r * n, (r + 1) * n));\n   168\t  }\n   169\t  if (lines.length < MIN_SIDE || lines.length > MAX_SIDE) fail(\"grid\", `must have ${MIN_SIDE}-${MAX_SIDE} rows (got ${lines.length}); split rows with \"/\" or newlines.`);\n   170\t  const cols = lines[0].length;\n   171\t  if (cols < MIN_SIDE || cols > MAX_SIDE) fail(\"grid\", `rows must have ${MIN_SIDE}-${MAX_SIDE} cells (row 1 has ${cols}).`);\n   172\t  const cells: Array<string | null> = [];\n   173\t  lines.forEach((line, r) => {\n   174\t    if (line.length !== cols) fail(\"grid\", `row ${r + 1} has ${line.length} cells but row 1 has ${cols}; every row must be the same length.`);\n   175\t    for (let c = 0; c < cols; c++) {\n   176\t      const ch = line[c];\n   177\t      if (ch === \"#\" || ch === \".\") cells.push(null);\n   178\t      else if (ch >= \"A\" && ch <= \"Z\") cells.push(ch);\n   179\t      else if (ch >= \"a\" && ch <= \"z\") fail(\"grid\", `row ${r + 1} column ${c + 1} is lowercase \"${ch}\"; letters must be A-Z (the .puz solution is uppercase).`);\n   180\t      else fail(\"grid\", `row ${r + 1} column ${c + 1} is ${JSON.stringify(ch)}; use A-Z for letters and \"#\" or \".\" for a block.`);\n   181\t    }\n   182\t  });\n   183\t  if (!cells.some((c) => c !== null)) fail(\"grid\", \"must have at least one white cell.\");\n   184\t  return { rows: lines.length, cols, cells };\n   185\t}\n   186\t\n   187\texport type CrosswordEntry = { id: string; number: number; dir: \"A\" | \"D\"; cells: number[]; answer: string };\n   188\t\n   189\t/**\n   190\t * The standard American numbering: a white cell takes the next number when it\n   191\t * starts an across entry (left is edge or block, right is white) or a down\n   192\t * entry (above is edge or block, below is white). Left to right, top to bottom.\n   193\t * Unchecked cells (British style) simply start nothing.\n   194\t */\n   195\texport function numberCrosswordGrid(pz: CrosswordPuzzle): { numbers: Map<number, number>; entries: Map<string, CrosswordEntry> } {\n   196\t  const { rows, cols, cells } = pz;\n   197\t  const white = (r: number, c: number) => r >= 0 && r < rows && c >= 0 && c < cols && cells[r * cols + c] !== null;\n   198\t  const numbers = new Map<number, number>();\n   199\t  const entries = new Map<string, CrosswordEntry>();\n   200\t  let n = 0;\n   201\t  for (let r = 0; r < rows; r++) {\n   202\t    for (let c = 0; c < cols; c++) {\n   203\t      if (!white(r, c)) continue;\n   204\t      const across = !white(r, c - 1) && white(r, c + 1);\n   205\t      const down = !white(r - 1, c) && white(r + 1, c);\n   206\t      if (!across && !down) continue;\n   207\t      n++;\n   208\t      numbers.set(r * cols + c, n);\n   209\t      const walk = (dir: \"A\" | \"D\") => {\n   210\t        const idx: number[] = [];\n   211\t        for (let rr = r, cc = c; white(rr, cc); dir === \"A\" ? cc++ : rr++) idx.push(rr * cols + cc);\n   212\t        entries.set(`${n}${dir}`, { id: `${n}${dir}`, number: n, dir, cells: idx, answer: idx.map((i) => cells[i]).join(\"\") });\n   213\t      };\n   214\t      if (across) walk(\"A\");\n   215\t      if (down) walk(\"D\");\n   216\t    }\n   217\t  }\n   218\t  return { numbers, entries };\n   219\t}\n   220\t\n   221\tfunction tokens(raw: unknown, field: string): string[] {\n   222\t  if (typeof raw !== \"string\") fail(field, 'must be a string (spaces or commas between items; \"\" for none).');\n   223\t  return raw.split(/[\\s,]+/).filter((t) => t.length > 0);\n   224\t}\n   225\t\n   226\tfunction ascii(raw: unknown, field: string, max: number): string {\n   227\t  if (typeof raw !== \"string\" || /[^\\x20-\\x7e]/.test(raw)) fail(field, \"must be printable ASCII text.\");\n   228\t  const s = raw.trim().replace(/\\s+/g, \" \");\n   229\t  if (s.length < 1 || s.length > max) fail(field, `must have 1-${max} characters (got ${s.length}).`);\n   230\t  return s;\n   231\t}\n   232\t\n   233\tconst WEEKDAYS = [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"];\n   234\t\n   235\t/** Weekday by calendar arithmetic (Sakamoto) - no clock, no Date. */\n   236\tfunction weekday(y: number, m: number, d: number): string {\n   237\t  const t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];\n   238\t  const yy = m < 3 ? y - 1 : y;\n   239\t  return WEEKDAYS[(yy + Math.floor(yy / 4) - Math.floor(yy / 100) + Math.floor(yy / 400) + t[m - 1] + d) % 7];\n   240\t}\n   241\t\n   242\t/** Every prop validated; a bad value fails with its field named, never falls back to the sample. */\n   243\texport function normalizeCrossword(props: CrosswordGridCardProps) {\n   244\t  const p = { ...CROSSWORD_DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) } as Required<CrosswordGridCardProps>;\n   245\t  const pz = parseCrosswordGrid(p.grid);\n   246\t  const { numbers, entries } = numberCrosswordGrid(pz);\n   247\t\n   248\t  const themeIds = tokens(p.themeEntries, \"themeEntries\");\n   249\t  if (themeIds.length > MAX_THEMES) fail(\"themeEntries\", `may list at most ${MAX_THEMES} entries (got ${themeIds.length}).`);\n   250\t  const themes: CrosswordEntry[] = [];\n   251\t  for (const id of themeIds) {\n   252\t    if (!/^[1-9]\\d{0,2}[AD]$/.test(id)) fail(\"themeEntries\", `\"${id}\" must be a clue id like 17A or 3D.`);\n   253\t    if (themes.some((t) => t.id === id)) fail(\"themeEntries\", `lists ${id} twice.`);\n   254\t    const e = entries.get(id);\n   255\t    if (!e) fail(\"themeEntries\", `${id} is not an entry in this grid's numbering.`);\n   256\t    themes.push(e);\n   257\t  }\n   258\t\n   259\t  const circleIds = tokens(p.circles, \"circles\");\n   260\t  if (circleIds.length > MAX_CIRCLES) fail(\"circles\", `may ring at most ${MAX_CIRCLES} squares (got ${circleIds.length}).`);\n   261\t  const circles: number[] = [];\n   262\t  for (const t of circleIds) {\n   263\t    if (!/^\\d+$/.test(t)) fail(\"circles\", `\"${t}\" must be a 0-based cell index.`);\n   264\t    const i = Number(t);\n   265\t    if (i >= pz.rows * pz.cols) fail(\"circles\", `${i} is outside the ${pz.cols}x${pz.rows} grid (0-${pz.rows * pz.cols - 1}).`);\n   266\t    if (pz.cells[i] === null) fail(\"circles\", `${i} (row ${Math.floor(i / pz.cols) + 1} column ${(i % pz.cols) + 1}) is a block; only white squares are circled.`);\n   267\t    if (circles.includes(i)) fail(\"circles\", `lists ${i} twice.`);\n   268\t    circles.push(i);\n   269\t  }\n   270\t\n   271\t  const title = ascii(p.title, \"title\", 40);\n   272\t  const author = ascii(p.author, \"author\", 48);\n   273\t  const publication = ascii(p.publication, \"publication\", 24);\n   274\t  if (typeof p.date !== \"string\" || !/^\\d{4}-\\d{2}-\\d{2}$/.test(p.date)) fail(\"date\", \"must be YYYY-MM-DD.\");\n   275\t  const [y, m, d] = p.date.split(\"-\").map(Number);\n   276\t  const leap = y % 4 === 0 && (y % 100 !== 0 || y % 400 === 0);\n   277\t  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n   278\t  if (y < 1 || m < 1 || m > 12 || d < 1 || d > days[m - 1]) fail(\"date\", `${p.date} is not a calendar date.`);\n   279\t  if (typeof p.solved !== \"boolean\") fail(\"solved\", \"must be true or false.\");\n   280\t  if (typeof p.themeColor !== \"string\" || !HEX.test(p.themeColor)) fail(\"themeColor\", `${JSON.stringify(p.themeColor)} must be #rrggbb.`);\n   281\t  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be true or false.\");\n   282\t\n   283\t  const metaRest = `${weekday(y, m, d)} ${m}/${d}/${String(y % 100).padStart(2, \"0\")} | ${pz.cols}x${pz.rows} | ${p.solved ? \"solution\" : \"puzzle\"}`;\n   284\t  return { ...p, pz, numbers, entries, themes, circles, title, author, publication, meta: `${publication} | ${metaRest}`, metaRest, themeColor: p.themeColor as MosaicColor };\n   285\t}\n   286\t\n   287\texport type CrosswordNormalized = ReturnType<typeof normalizeCrossword>;\n   288\t\n   289\t// ---------------------------------------------------------------- geometry\n   290\t\n   291\texport type CrosswordRect = { x: number; y: number; w: number; h: number };\n   292\tconst rect = (x: number, y: number, w: number, h: number): CrosswordRect => {\n   293\t  const x0 = Math.round(x), y0 = Math.round(y);\n   294\t  return { x: x0, y: y0, w: Math.max(1, Math.round(x + w) - x0), h: Math.max(1, Math.round(y + h) - y0) };\n   295\t};\n   296\t\n   297\t/** Height a fitted block needs: Roboto's em box is 1.17 em (ascent + descent), each extra line 1.25 em, plus 2px. */\n   298\tconst blockH = (px: number, lines: number) => Math.ceil(px * (1.17 + 1.25 * (lines - 1))) + 2;\n   299\t\n   300\t/** Lossless line breaks: split at spaces, cut an over-long token, never drop a glyph. */\n   301\tfunction wrap(text: string, px: number, maxW: number, bold: boolean): string[] {\n   302\t  const lines: string[] = [];\n   303\t  let rest = text;\n   304\t  while (widthOf(rest, px, bold) > maxW) {\n   305\t    let n = 1;\n   306\t    while (n < rest.length && widthOf(rest.slice(0, n + 1), px, bold) <= maxW) n++;\n   307\t    const space = rest.lastIndexOf(\" \", n);\n   308\t    if (space > 0) { lines.push(rest.slice(0, space)); rest = rest.slice(space + 1); }\n   309\t    else { lines.push(rest.slice(0, n)); rest = rest.slice(n); }\n   310\t  }\n   311\t  lines.push(rest);\n   312\t  return lines;\n   313\t}\n   314\t\n   315\texport type CrosswordTextBox = { label: string; rect: CrosswordRect; text: string; px: number; width: number; bold: boolean; color: MosaicColor; hAlign: \"left\" | \"right\"; vAlign: \"top\" | \"middle\" | \"bottom\"; bind?: \"title\" | \"author\" | \"publication\" };\n   316\t\n   317\t/**\n   318\t * The largest size (maxPx down to floorPx, then on down to 6 so the contract\n   319\t * flags it rather than the render dying) at which `text` fits `w` x `maxH` in\n   320\t * one of `lineOptions` line counts, tried in order.\n   321\t */\n   322\tfunction fit(text: string, w: number, maxH: number, maxPx: number, floorPx: number, lineOptions: number[], bold: boolean) {\n   323\t  const tryAt = (px: number, maxLines: number) => {\n   324\t    const lines = wrap(text, px, budget(w), bold);\n   325\t    if (lines.length > maxLines || blockH(px, lines.length) > maxH) return null;\n   326\t    return { lines, px, width: Math.max(...lines.map((l) => widthOf(l, px, bold))) };\n   327\t  };\n   328\t  for (const maxLines of lineOptions) {\n   329\t    for (let px = Math.max(floorPx, Math.floor(maxPx)); px >= floorPx; px--) {\n   330\t      const hit = tryAt(px, maxLines);\n   331\t      if (hit) return hit;\n   332\t    }\n   333\t  }\n   334\t  const most = Math.max(...lineOptions);\n   335\t  for (let px = floorPx - 1; px >= 6; px--) {\n   336\t    const hit = tryAt(px, most);\n   337\t    if (hit) return hit;\n   338\t  }\n   339\t  const lines = wrap(text, 6, budget(w), bold);\n   340\t  return { lines, px: 6, width: Math.max(...lines.map((l) => widthOf(l, 6, bold))) };\n   341\t}\n   342\t\n   343\t/** A lead cell and a tail cell sharing one size: side by side (the tail may wrap in its own column), or stacked. */\n   344\ttype Pair = { px: number; stacked: boolean; tail: string[]; leadW: number; tailX: number; height: number };\n   345\tconst leadBoxW = (w: number) => Math.ceil((w + 3) / 0.94) + 1;\n   346\t\n   347\t/**\n   348\t * The largest size at which `lead` + `tail` fit `w` x `maxH`, trying the\n   349\t * `modes` in order at each size range: \"line\" (one line), \"wrap\" (the tail\n   350\t * wraps to two lines beside the lead), \"stack\" (the tail on the next line).\n   351\t */\n   352\tfunction pairFit(lead: string, leadBold: boolean, tail: string, tailStacked: string, w: number, maxH: number, maxPx: number, floorPx: number, modes: Array<\"line\" | \"wrap\" | \"stack\">): Pair {\n   353\t  const at = (px: number, mode: \"line\" | \"wrap\" | \"stack\"): Pair | null => {\n   354\t    const leadW = widthOf(lead, px, leadBold);\n   355\t    if (mode === \"stack\") {\n   356\t      const lines = wrap(tailStacked, px, budget(w), false);\n   357\t      return leadW <= budget(w) && lines.length === 1 && 2 * blockH(px, 1) <= maxH ? { px, stacked: true, tail: lines, leadW, tailX: 0, height: 2 * blockH(px, 1) } : null;\n   358\t    }\n   359\t    const tailX = Math.max(leadBoxW(leadW), Math.round(leadW + px * 0.3));\n   360\t    if (w - tailX < 2 * px) return null;\n   361\t    const lines = wrap(tail, px, budget(w - tailX), false);\n   362\t    return lines.length <= (mode === \"line\" ? 1 : 2) && blockH(px, lines.length) <= maxH ? { px, stacked: false, tail: lines, leadW, tailX, height: blockH(px, lines.length) } : null;\n   363\t  };\n   364\t  for (const [lo, hi] of [[floorPx, Math.max(floorPx, Math.floor(maxPx))], [6, floorPx - 1]]) {\n   365\t    for (const mode of modes) for (let px = hi; px >= lo; px--) { const hit = at(px, mode); if (hit) return hit; }\n   366\t  }\n   367\t  const lines = wrap(tailStacked, 6, budget(w), false);\n   368\t  return { px: 6, stacked: true, tail: lines, leadW: widthOf(lead, 6, leadBold), tailX: 0, height: blockH(6, 1) + blockH(6, lines.length) };\n   369\t}\n   370\t\n   371\texport type CrosswordBoard = {\n   372\t  pitch: number;\n   373\t  rule: number;\n   374\t  border: number;\n   375\t  /** Integer lattice lines: X[k] is the centre line left of column k (length cols+1). */\n   376\t  X: number[];\n   377\t  Y: number[];\n   378\t  /** The whole board as drawn: ink border included. */\n   379\t  ink: CrosswordRect;\n   380\t  /** The paper part of cell i (inside the rules). */\n   381\t  hole: (i: number) => CrosswordRect;\n   382\t  letterPx: number;\n   383\t  /** 0 when the clue numbers are dropped (below the 6px floor). */\n   384\t  numberPx: number;\n   385\t};\n   386\t\n   387\tfunction boardSizing(cols: number, rows: number, availW: number, availH: number) {\n   388\t  let pitch = Math.min(availW / cols, availH / rows);\n   389\t  for (let k = 0; k < 3; k++) {\n   390\t    const rule = Math.max(1, Math.round(pitch * 0.03));\n   391\t    const border = Math.max(2, 2 * rule, Math.round(pitch * 0.06));\n   392\t    pitch = Math.min((availW - 2 * border + rule) / cols, (availH - 2 * border + rule) / rows);\n   393\t  }\n   394\t  const rule = Math.max(1, Math.round(pitch * 0.03));\n   395\t  const border = Math.max(2, 2 * rule, Math.round(pitch * 0.06));\n   396\t  return { pitch, rule, border, inkW: cols * pitch - rule + 2 * border, inkH: rows * pitch - rule + 2 * border };\n   397\t}\n   398\t\n   399\tfunction boardAt(cols: number, rows: number, s: ReturnType<typeof boardSizing>, inkX: number, inkY: number): CrosswordBoard {\n   400\t  const { pitch, rule, border } = s;\n   401\t  const lead = border - Math.ceil(rule / 2);\n   402\t  const x0 = Math.round(inkX) + lead, y0 = Math.round(inkY) + lead;\n   403\t  const X = Array.from({ length: cols + 1 }, (_, k) => Math.round(x0 + k * pitch));\n   404\t  const Y = Array.from({ length: rows + 1 }, (_, k) => Math.round(y0 + k * pitch));\n   405\t  const ink = { x: X[0] - lead, y: Y[0] - lead, w: X[cols] - X[0] - rule + 2 * border, h: Y[rows] - Y[0] - rule + 2 * border };\n   406\t  const hole = (i: number): CrosswordRect => {\n   407\t    const r = Math.floor(i / cols), c = i % cols;\n   408\t    const x = X[c] + Math.ceil(rule / 2), y = Y[r] + Math.ceil(rule / 2);\n   409\t    return { x, y, w: X[c + 1] - Math.floor(rule / 2) - x, h: Y[r + 1] - Math.floor(rule / 2) - y };\n   410\t  };\n   411\t  const letterPx = Math.max(6, Math.round(pitch * LETTER_EM));\n   412\t  const n = Math.round(pitch * NUMBER_EM);\n   413\t  return { pitch, rule, border, X, Y, ink, hole, letterPx, numberPx: n >= NUMBER_FLOOR_PX ? n : 0 };\n   414\t}\n   415\t\n   416\texport type CrosswordThemeLine = { swatch: CrosswordRect; id: CrosswordTextBox; answer: CrosswordTextBox };\n   417\texport type CrosswordLayout = {\n   418\t  mode: \"landscape\" | \"portrait\" | \"square\";\n   419\t  margin: number;\n   420\t  gutter: number;\n   421\t  board: CrosswordBoard;\n   422\t  /** Where the caption copy lives (for the no-overlap assertion). */\n   423\t  panel: CrosswordRect;\n   424\t  texts: CrosswordTextBox[];\n   425\t  themeLines: CrosswordThemeLine[];\n   426\t};\n   427\t\n   428\t/**\n   429\t * The card's geometry from ctx.target alone. Margin ~3.6% of the short side;\n   430\t * the board-to-panel gutter is twice that. Landscape: board left, full height,\n   431\t * copy in a column. Portrait: header over a full-width board, list and caption\n   432\t * under it. Between: board on top, caption strip under it.\n   433\t */\n   434\texport function layoutCrosswordCard(p: CrosswordNormalized, W: number, H: number): CrosswordLayout {\n   435\t  const { rows, cols } = p.pz;\n   436\t  const S = Math.min(W, H), a = W / H;\n   437\t  const margin = Math.round(S * 0.036), gutter = 2 * margin;\n   438\t  const mode = a >= 1.25 ? \"landscape\" : a <= 0.8 ? \"portrait\" : \"square\";\n   439\t  const floorPx = Math.max(8, Math.round(S * 0.013));\n   440\t  const titleFloor = Math.max(9, Math.round(S * 0.022));\n   441\t  const texts: CrosswordTextBox[] = [];\n   442\t  const themeLines: CrosswordThemeLine[] = [];\n   443\t  const showThemes = p.solved && p.themes.length > 0;\n   444\t\n   445\t  const place = (label: string, text: string, x: number, y: number, w: number, maxH: number, maxPx: number, floor: number, lineOptions: number[], opts: Partial<CrosswordTextBox> = {}) => {\n   446\t    const bold = opts.bold === true;\n   447\t    const f = fit(text, w, maxH, maxPx, floor, lineOptions, bold);\n   448\t    const box: CrosswordTextBox = { label, rect: rect(x, y, w, blockH(f.px, f.lines.length)), text: f.lines.join(\"\\n\"), px: f.px, width: f.width, bold, color: INK, hAlign: \"left\", vAlign: \"middle\", ...opts };\n   449\t    texts.push(box);\n   450\t    return box;\n   451\t  };\n   452\t\n   453\t  /** Place a fitted pair at (x, y): lead and tail top-aligned, each its own cell (the bare prop value is bound). */\n   454\t  const pair = (P: Pair, x: number, y: number, w: number, lead: { label: string; text: string; color: MosaicColor; bold: boolean; bind?: CrosswordTextBox[\"bind\"] }, tail: { label: string; color: MosaicColor; bind?: CrosswordTextBox[\"bind\"] }) => {\n   455\t    texts.push({ label: lead.label, rect: rect(x, y, leadBoxW(P.leadW), blockH(P.px, 1)), text: lead.text, px: P.px, width: P.leadW, bold: lead.bold, color: lead.color, hAlign: \"left\", vAlign: \"top\", ...(lead.bind ? { bind: lead.bind } : {}) });\n   456\t    const tx = x + P.tailX, ty = P.stacked ? y + blockH(P.px, 1) : y;\n   457\t    texts.push({ label: tail.label, rect: rect(tx, ty, x + w - tx, blockH(P.px, P.tail.length)), text: P.tail.join(\"\\n\"), px: P.px, width: Math.max(...P.tail.map((l) => widthOf(l, P.px))), bold: false, color: tail.color, hAlign: \"left\", vAlign: \"top\", ...(tail.bind ? { bind: tail.bind } : {}) });\n   458\t  };\n   459\t  const byline = (P: Pair, x: number, y: number, w: number) => pair(P, x, y, w, { label: \"byline-by\", text: \"by\", color: DIM, bold: false }, { label: \"byline\", color: INK, bind: \"author\" });\n   460\t  const bylineFit = (w: number, maxH: number, maxPx: number) => pairFit(\"by\", false, p.author, p.author, w, maxH, maxPx, floorPx, [\"line\", \"wrap\"]);\n   461\t  const meta = (P: Pair, x: number, y: number, w: number) => pair(P, x, y, w, { label: \"meta-publication\", text: p.publication, color: INK, bold: true, bind: \"publication\" }, { label: \"meta\", color: DIM });\n   462\t  const metaFit = (w: number, maxH: number, maxPx: number) => pairFit(p.publication, true, `| ${p.metaRest}`, p.metaRest, w, maxH, maxPx, floorPx, [\"line\", \"stack\"]);\n   463\t\n   464\t  /** The theme list as one block: heading + lines, `perCol` lines per sub-column. Returns its height. */\n   465\t  const themeBlock = (x: number, y: number, w: number, h: number, maxPx: number, subCols: number, dryRun: boolean): number => {\n   466\t    if (!showThemes) return 0;\n   467\t    const n = p.themes.length, perCol = Math.ceil(n / subCols);\n   468\t    const colGap = Math.round(S * 0.03);\n   469\t    const colW = (w - (subCols - 1) * colGap) / subCols;\n   470\t    const idText = (t: CrosswordEntry) => t.id;\n   471\t    // One size for every line: the largest that fits every line's width and the block's height.\n   472\t    let px = Math.floor(maxPx);\n   473\t    const lineW = (q: number) => Math.max(...p.themes.map((t) => Math.round(q * 0.75) + Math.round(q * 0.5) + Math.max(...p.themes.map((u) => widthOf(idText(u), q))) + Math.round(q * 0.6) + widthOf(t.answer, q, true)));\n   474\t    const pitchOf = (q: number) => Math.max(blockH(q, 1), Math.round(q * 1.55));\n   475\t    const headPx = (q: number) => Math.max(floorPx, Math.round(q * 0.72));\n   476\t    while (px > 6 && (lineW(px) > budget(colW) || blockH(headPx(px), 1) + Math.round(px * 0.35) + perCol * pitchOf(px) > h)) px--;\n   477\t    const hp = headPx(px), pitch = pitchOf(px);\n   478\t    const total = blockH(hp, 1) + Math.round(px * 0.35) + perCol * pitch;\n   479\t    if (dryRun) return total;\n   480\t    place(\"theme-heading\", \"THEME ANSWERS\", x, y, w, blockH(hp, 1), hp, Math.min(hp, floorPx), [1], { bold: true, color: DIM });\n   481\t    const idW = Math.max(...p.themes.map((u) => widthOf(idText(u), px)));\n   482\t    p.themes.forEach((t, i) => {\n   483\t      const col = Math.floor(i / perCol), row = i % perCol;\n   484\t      const cx = x + col * (colW + colGap);\n   485\t      const ry = y + blockH(hp, 1) + Math.round(px * 0.35) + row * pitch;\n   486\t      const sw = Math.round(px * 0.75);\n   487\t      const swatch = rect(cx, ry + (pitch - sw) / 2, sw, sw);\n   488\t      const idX = cx + sw + Math.round(px * 0.5);\n   489\t      const idBox: CrosswordTextBox = { label: `theme-id-${i}`, rect: rect(idX, ry, Math.ceil((idW + 3) / 0.94) + 1, pitch), text: t.id, px, width