{"type":"tool_use","timestamp":1792528643779,"sessionID":"ses_ea4f89b40ffeJA5Vf8sjCWqpcq","part":{"type":"tool","tool":"read","callID":"call_00_bo3VOfNxWS1nrw6Dtepr2613","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\community\\qsl-card\\v1\\qsl-card.ts"},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\src\\community\\qsl-card\\v1\\qsl-card.ts</path>\n<type>file</type>\n<content>\n1: import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\n2: import { asTemplateId } from \"@m0saic/types\";\n3: import { toM0String } from \"@m0saic/dsl-stdlib\";\n4: import { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\n5: import type { LayoutConstraint } from \"@m0saic/template-utils\";\n6: import { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n7: import { budget, textCell, widthOf } from \"../../../_shared/text\";\n8: import { whyTutorial } from \"../../../_shared/why\";\n9: import type { WhySpec } from \"../../../_shared/why\";\n10: \n11: /**\n12:  * `@one-a-day/community/qsl-card/v1` - a ham radio QSL card for ONE contact,\n13:  * rendered from the fields of one ADIF log record, so a script can loop over\n14:  * a whole log and write one card per QSO.\n15:  *\n16:  * ONE CONCEPT: the props ARE the log record. Each prop is an ADIF field in\n17:  * camelCase taking the ADIF format (QSO_DATE \"20261003\", TIME_ON \"1432\",\n18:  * FREQ \"14.074\" in MHz), and the card prints it the way a QSL does\n19:  * (\"03 OCT 2026\", \"14:32\"). BAND is not a prop: it is DERIVED from FREQ with\n20:  * the ADIF 3.1.6 band enumeration, so the two can never disagree on a card.\n21:  *\n22:  * The rule that bites: a callsign is never ellipsized. A card with half a\n23:  * call on it confirms nothing. The station call is sized from its own text\n24:  * (a short K1A is limited by the band's height, a long VP2V/G4ABC by its\n25:  * width), the QSO table reflows by aspect (6x1, 3x2, 2x3) before any type\n26:  * shrinks, the table values shrink before the call drops below twice their\n27:  * size, and copy that cannot fit above the readability floor (10/270 of\n28:  * the short side) is refused with an error that names the prop.\n29:  */\n30: \n31: export type QslCardProps = {\n32:   /** STATION_CALLSIGN: the sender, the biggest thing on the card. */\n33:   stationCallsign?: string;\n34:   /** CALL: the station worked - \"TO RADIO <call>\". */\n35:   call?: string;\n36:   /** QSO_DATE as YYYYMMDD (UTC). */\n37:   qsoDate?: string;\n38:   /** TIME_ON as HHMM or HHMMSS (UTC). */\n39:   timeOn?: string;\n40:   /** FREQ in MHz, printed as given; BAND is derived from it. */\n41:   freq?: string;\n42:   /** MODE (or SUBMODE), printed as the log says it. */\n43:   mode?: string;\n44:   /** RST_SENT: \"59\", \"599\" or a signed dB report (\"-12\"). */\n45:   rstSent?: string;\n46:   /** MY_GRIDSQUARE: 4, 6 or 8 character Maidenhead; \"\" hides the line. */\n47:   myGridsquare?: string;\n48:   /** MY_CITY / MY_STATE as one line; \"\" hides it. */\n49:   qth?: string;\n50:   /** MY_POTA_REF: a Parks on the Air reference; \"\" hides it. */\n51:   myPotaRef?: string;\n52:   /** QSLMSG: the footer line; \"\" hides it. */\n53:   qslMsg?: string;\n54:   /** The one accent: top bar, label rules, TO RADIO tag. */\n55:   accentColor?: string;\n56:   /** Dev-only: check the layout contract and draw it over the card. */\n57:   debugLayout?: boolean;\n58: };\n59: \n60: const ID = \"@one-a-day/community/qsl-card/v1\";\n61: /** The face: document.backgroundColor, never a full-canvas rect (doctor: canvasFill). */\n62: const PAPER = \"#f4f1ea\";\n63: const INK = \"#1b2a4a\";\n64: const DIM = \"#66758c\";\n65: const DEFAULT_ACCENT = \"#b3261e\";\n66: \n67: // Labelled examples, not anybody's log: N0CALL is the placeholder call ham\n68: // software ships with, W1AW the ARRL station its documentation uses, and the\n69: // grid EN34 sits in the 0 call district, so it agrees with N0CALL.\n70: const DEFAULTS = {\n71:   stationCallsign: \"N0CALL\",\n72:   call: \"W1AW\",\n73:   qsoDate: \"20261003\",\n74:   timeOn: \"1432\",\n75:   freq: \"14.074\",\n76:   mode: \"FT8\",\n77:   rstSent: \"-12\",\n78:   myGridsquare: \"EN34\",\n79:   qth: \"Minneapolis, MN\",\n80:   myPotaRef: \"US-1234\",\n81:   qslMsg: \"TNX QSO 73\",\n82:   accentColor: DEFAULT_ACCENT,\n83:   debugLayout: false,\n84: };\n85: \n86: const propsSchema = definePropsSchema<QslCardProps>({\n87:   stationCallsign: {\n88:     type: \"string\",\n89:     required: false,\n90:     description: \"STATION_CALLSIGN: your call, the biggest thing on the card. 3-13 characters of A-Z, 0-9 and /, with at least one digit (portable suffixes like /P are fine); upper-cased. Never ellipsized: a call that cannot fit the canvas is refused.\",\n91:     meta: { control: { placeholder: DEFAULTS.stationCallsign }, ui: { label: \"Station callsign\", order: 1, primary: true } },\n92:   },\n93:   call: {\n94:     type: \"string\",\n95:     required: false,\n96:     description: \"CALL: the station you worked, printed as TO RADIO <call>. Same rule as the station callsign.\",\n97:     meta: { control: { placeholder: DEFAULTS.call }, ui: { label: \"Worked call (CALL)\", order: 2, primary: true } },\n98:   },\n99:   qsoDate: {\n100:     type: \"string\",\n101:     required: false,\n102:     description: 'QSO_DATE as the log writes it, YYYYMMDD in UTC (1930 or later). Printed with the month spelled out, \"03 OCT 2026\", so it reads the same in the US and in Europe.',\n103:     meta: { control: { placeholder: DEFAULTS.qsoDate }, ui: { label: \"QSO date (YYYYMMDD)\", order: 3 } },\n104:   },\n105:   timeOn: {\n106:     type: \"string\",\n107:     required: false,\n108:     description: 'TIME_ON in UTC, HHMM or HHMMSS. Printed as 14:32 (or 14:32:05) under the UTC label.',\n109:     meta: { control: { placeholder: DEFAULTS.timeOn }, ui: { label: \"Time on (HHMM UTC)\", order: 4 } },\n110:   },\n111:   freq: {\n112:     type: \"string\",\n113:     required: false,\n114:     description: 'FREQ in MHz, e.g. \"14.074\" or \"1296.200\", printed as given (no rounding, up to 6 decimals). The BAND cell is derived from it with the ADIF 3.1.6 band table (14.074 -> 20m, 432.100 -> 70cm); a frequency outside every amateur band (27.185) is refused.',\n115:     meta: { control: { placeholder: DEFAULTS.freq }, ui: { label: \"Frequency (MHz)\", order: 5 } },\n116:   },\n117:   mode: {\n118:     type: \"string\",\n119:     required: false,\n120:     description: \"MODE or SUBMODE as the log says it (SSB, CW, FT8, FT4, RTTY...). 1-8 characters of A-Z, 0-9 and -, upper-cased; not checked against the ADIF mode list.\",\n121:     meta: { control: { placeholder: DEFAULTS.mode }, ui: { label: \"Mode\", order: 6 } },\n122:   },\n123:   rstSent: {\n124:     type: \"string\",\n125:     required: false,\n126:     description: 'RST_SENT: the report you gave, RS or RST digits (\"59\", \"599\") or a signed dB report (\"-12\", \"+05\").',\n127:     meta: { control: { placeholder: DEFAULTS.rstSent }, ui: { label: \"Report sent (RST)\", order: 7 } },\n128:   },\n129:   myGridsquare: {\n130:     type: \"string\",\n131:     required: false,\n132:     description: 'MY_GRIDSQUARE: 4, 6 or 8 character Maidenhead locator, printed in canonical case (\"EN34lw\"). Empty removes the GRID line.',\n133:     meta: { control: { placeholder: \"none\" }, ui: { label: \"My grid square\", order: 8 } },\n134:   },\n135:   qth: {\n136:     type: \"string\",\n137:     required: false,\n138:     description: \"Your QTH (MY_CITY / MY_STATE as one line), up to 32 characters of printable ASCII. Empty removes the line.\",\n139:     meta: { control: { placeholder: \"none\" }, ui: { label: \"QTH\", order: 9 } },\n140:   },\n141:   myPotaRef: {\n142:     type: \"string\",\n143:     required: false,\n144:     description: 'MY_POTA_REF: a Parks on the Air reference (\"US-1234\", \"K-12345\", \"GB-0001@GB-ENG\"). Empty removes the POTA line - most cards are not from a park.',\n145:     meta: { control: { placeholder: \"none\" }, ui: { label: \"My POTA ref\", order: 10 } },\n146:   },\n147:   qslMsg: {\n148:     type: \"string\",\n149:     required: false,\n150:     description: \"QSLMSG: the footer line, up to 40 characters of printable ASCII. Empty removes it.\",\n151:     meta: { control: { placeholder: \"none\" }, ui: { label: \"QSL message\", order: 11 } },\n152:   },\n153:   accentColor: {\n154:     type: \"string\",\n155:     required: false,\n156:     description: \"The one accent, as #rrggbb: the bar along the top, the rules under the table labels and the TO RADIO tag.\",\n157:     meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 12 } },\n158:   },\n159:   debugLayout: {\n160:     type: \"boolean\",\n161:     required: false,\n162:     description: \"Dev-only: check the layout contract (every text fits its box, the call sits in the top half, the QSO table is complete, the accent bar spans the card) and draw it over the card.\",\n163:     meta: { ui: { label: \"Debug layout\", order: 99 } },\n164:   },\n165: });\n166: \n167: /* ── the ADIF record: pure, exported, and what the test asserts ── */\n168: \n169: function fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n170: \n171: /** An ADIF Number in MHz -> integer Hz; null when it is not one (more than 6 decimals is not one here). */\n172: export function qslMHzToHz(text: string): number | null {\n173:   const m = /^(\\d{0,7})(?:\\.(\\d{1,6}))?$/.exec(text);\n174:   if (!m || (m[1] === \"\" && m[2] === undefined)) return null;\n175:   return Number(m[1] || \"0\") * 1_000_000 + Number((m[2] ?? \"\").padEnd(6, \"0\"));\n176: }\n177: \n178: /** The ADIF 3.1.6 Band enumeration (section III.B.4), lower and upper edge in MHz, both inclusive. */\n179: const ADIF_BANDS: ReadonlyArray<readonly [string, string, string]> = [\n180:   [\"2190m\", \".1357\", \".1378\"], [\"630m\", \".472\", \".479\"], [\"560m\", \".501\", \".504\"],\n181:   [\"160m\", \"1.8\", \"2.0\"], [\"80m\", \"3.5\", \"4.0\"], [\"60m\", \"5.06\", \"5.45\"], [\"40m\", \"7.0\", \"7.3\"],\n182:   [\"30m\", \"10.1\", \"10.15\"], [\"20m\", \"14.0\", \"14.35\"], [\"17m\", \"18.068\", \"18.168\"], [\"15m\", \"21.0\", \"21.45\"],\n183:   [\"12m\", \"24.890\", \"24.99\"], [\"10m\", \"28.0\", \"29.7\"], [\"8m\", \"40\", \"45\"], [\"6m\", \"50\", \"54\"],\n184:   [\"5m\", \"54.000001\", \"69.9\"], [\"4m\", \"70\", \"71\"], [\"2m\", \"144\", \"148\"], [\"1.25m\", \"222\", \"225\"],\n185:   [\"70cm\", \"420\", \"450\"], [\"33cm\", \"902\", \"928\"], [\"23cm\", \"1240\", \"1300\"], [\"13cm\", \"2300\", \"2450\"],\n186:   [\"9cm\", \"3300\", \"3500\"], [\"6cm\", \"5650\", \"5925\"], [\"3cm\", \"10000\", \"10500\"], [\"1.25cm\", \"24000\", \"24250\"],\n187:   [\"6mm\", \"47000\", \"47200\"], [\"4mm\", \"75500\", \"81000\"], [\"2.5mm\", \"119980\", \"123000\"], [\"2mm\", \"134000\", \"149000\"],\n188:   [\"1mm\", \"241000\", \"250000\"], [\"submm\", \"300000\", \"7500000\"],\n189: ];\n190: const BAND_HZ = ADIF_BANDS.map(([band, lo, hi]) => ({ band, lo: qslMHzToHz(lo) as number, hi: qslMHzToHz(hi) as number }));\n191: \n192: /** FREQ (MHz text) -> the ADIF band name, or null when the frequency is in no amateur band. Integer Hz, no floats. */\n193: export function qslBandOf(freq: string): string | null {\n194:   const hz = qslMHzToHz(freq);\n195:   if (hz === null) return null;\n196:   return BAND_HZ.find((b) => hz >= b.lo && hz <= b.hi)?.band ?? null;\n197: }\n198: \n199: const MONTHS = [\"JAN\", \"FEB\", \"MAR\", \"APR\", \"MAY\", \"JUN\", \"JUL\", \"AUG\", \"SEP\", \"OCT\", \"NOV\", \"DEC\"];\n200: /** QSO_DATE \"20261003\" -> \"03 OCT 2026\"; null for anything that is not a calendar date from 1930 on (ADIF's floor). */\n201: export function qslFormatDate(text: string): string | null {\n202:   const m = /^(\\d{4})(\\d{2})(\\d{2})$/.exec(text);\n203:   if (!m) return null;\n204:   const y = Number(m[1]), mo = Number(m[2]), d = Number(m[3]);\n205:   const leap = (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;\n206:   const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n207:   if (y < 1930 || mo < 1 || mo > 12 || d < 1 || d > days[mo - 1]) return null;\n208:   return `${m[3]} ${MONTHS[mo - 1]} ${m[1]}`;\n209: }\n210: \n211: /** TIME_ON \"1432\" -> \"14:32\", \"143205\" -> \"14:32:05\"; null outside 00:00:00-23:59:59. */\n212: export function qslFormatTime(text: string): string | null {\n213:   const m = /^(\\d{2})(\\d{2})(\\d{2})?$/.exec(text);\n214:   if (!m || Number(m[1]) > 23 || Number(m[2]) > 59 || (m[3] !== undefined && Number(m[3]) > 59)) return null;\n215:   return m[3] === undefined ? `${m[1]}:${m[2]}` : `${m[1]}:${m[2]}:${m[3]}`;\n216: }\n217: \n218: /** A Maidenhead locator (4, 6 or 8 characters) in canonical case - \"EN34lw55\" - or null. */\n219: export function qslGrid(text: string): string | null {\n220:   const m = /^([A-R]{2})(\\d{2})(?:([A-X]{2})(\\d{2})?)?$/i.exec(text);\n221:   if (!m) return null;\n222:   return `${m[1].toUpperCase()}${m[2]}${(m[3] ?? \"\").toLowerCase()}${m[4] ?? \"\"}`;\n223: }\n224: \n225: function str(value: unknown, field: string): string {\n226:   if (typeof value !== \"string\") fail(field, \"must be a string.\");\n227:   return value.trim();\n228: }\n229: \n230: function callsign(value: unknown, field: string): string {\n231:   const s = str(value, field).toUpperCase();\n232:   if (s === \"\") fail(field, \"must not be empty: a QSL card confirms a contact between two calls.\");\n233:   if (!/^[A-Z0-9/]{3,13}$/.test(s) || !/\\d/.test(s) || !/[A-Z]/.test(s) || /^\\/|\\/$|\\/\\//.test(s)) {\n234:     fail(field, `${JSON.stringify(s)} is not a callsign: 3-13 characters of A-Z, 0-9 and /, with a letter and a digit, no spaces.`);\n235:   }\n236:   return s;\n237: }\n238: \n239: function printable(value: unknown, field: string, max: number): string {\n240:   const s = str(value, field);\n241:   if (!/^[\\x20-\\x7e]*$/.test(s)) fail(field, `${JSON.stringify(s)} has a character outside printable ASCII, which the card's font is not known to draw.`);\n242:   if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n243:   return s;\n244: }\n245: \n246: /** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n247: export function normalizeQslCard(props: QslCardProps) {\n248:   const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) } as typeof DEFAULTS;\n249:   const stationCallsign = callsign(p.stationCallsign, \"stationCallsign\");\n250:   const call = callsign(p.call, \"call\");\n251: \n252:   const qsoDate = str(p.qsoDate, \"qsoDate\");\n253:   const date = qslFormatDate(qsoDate);\n254:   if (date === null) fail(\"qsoDate\", `${JSON.stringify(qsoDate)} is not an ADIF date: YYYYMMDD, a real calendar day from 1930 on.`);\n255:   const timeOn = str(p.timeOn, \"timeOn\");\n256:   const time = qslFormatTime(timeOn);\n257:   if (time === null) fail(\"timeOn\", `${JSON.stringify(timeOn)} is not an ADIF time: HHMM or HHMMSS, 0000 to 235959 UTC.`);\n258: \n259:   const freq = str(p.freq, \"freq\");\n260:   if (qslMHzToHz(freq) === null) fail(\"freq\", `${JSON.stringify(freq)} is not a frequency in MHz: digits with up to 6 decimals, e.g. \"14.074\".`);\n261:   const band = qslBandOf(freq);\n262:   if (band === null) fail(\"freq\", `${freq} MHz is in no amateur band of the ADIF 3.1.6 band table, so the card cannot name its BAND.`);\n263: \n264:   const mode = str(p.mode, \"mode\").toUpperCase();\n265:   if (!/^[A-Z0-9-]{1,8}$/.test(mode)) fail(\"mode\", `${JSON.stringify(mode)} must be 1-8 characters of A-Z, 0-9 and -.`);\n266:   const rst = str(p.rstSent, \"rstSent\");\n267:   if (!/^[1-5][1-9][1-9]?$/.test(rst) && !/^[+-]\\d{1,2}$/.test(rst)) fail(\"rstSent\", `${JSON.stringify(rst)} is not a report: RS or RST digits (\"59\", \"599\") or signed dB (\"-12\", \"+05\").`);\n268: \n269:   const gridRaw = str(p.myGridsquare, \"myGridsquare\");\n270:   const grid = gridRaw === \"\" ? \"\" : qslGrid(gridRaw);\n271:   if (grid === null) fail(\"myGridsquare\", `${JSON.stringify(gridRaw)} is not a Maidenhead locator: 4, 6 or 8 characters like \"EN34\", \"EN34lw\" (fields A-R, subsquares a-x).`);\n272:   const qth = printable(p.qth, \"qth\", 32);\n273:   const pota = str(p.myPotaRef, \"myPotaRef\").toUpperCase();\n274:   if (pota !== \"\" && !/^[A-Z0-9]{1,4}-\\d{4,5}(@[A-Z0-9-]{2,6})?$/.test(pota)) fail(\"myPotaRef\", `${JSON.stringify(pota)} is not a POTA reference: \"US-1234\", \"K-12345\" or \"GB-0001@GB-ENG\".`);\n275:   const qslMsg = printable(p.qslMsg, \"qslMsg\", 40);\n276:   const accent = str(p.accentColor, \"accentColor\");\n277:   if (!/^#[0-9a-fA-F]{6}$/.test(accent)) fail(\"accentColor\", `${JSON.stringify(accent)} must be #rrggbb.`);\n278:   if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n279: \n280:   return {\n281:     stationCallsign, call, date, time, freq, band, mode, rst, grid, qth, pota, qslMsg,\n282:     accent: accent.toLowerCase() as MosaicColor, debugLayout: p.debugLayout,\n283:   };\n284: }\n285: \n286: /* ── colour ── */\n287: \n288: function qslMix(a: string, b: string, t: number): MosaicColor {\n289:   const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n290:   const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * t));\n291:   return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n292: }\n293: function qslLuminance(hex: string): number {\n294:   const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n295:   return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n296: }\n297: /** The readable ink on the accent tag: the paper or the navy, whichever contrasts more with the caller's accent. */\n298: function qslOnColor(fill: string): MosaicColor {\n299:   const ratio = (other: string) => { const a = qslLuminance(fill), b = qslLuminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n300:   return (ratio(INK) >= ratio(PAPER) ? INK : PAPER) as MosaicColor;\n301: }\n302: \n303: /* ── geometry ── */\n304: \n305: export type QslRect = { x: number; y: number; w: number; h: number };\n306: type Bind = Exclude<keyof QslCardProps, \"debugLayout\"> | null;\n307: type Cell = { label: string; rect: QslRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\n308: type Tile = { label: string; rect: QslRect; color: MosaicColor; radius: number; bind?: \"accentColor\" };\n309: \n310: /** The cell width a line needs at `px` under the fit rule (`cell * 0.94 - 2px`). */\n311: function need(text: string, px: number, bold: boolean): number {\n312:   return Math.ceil((widthOf(text, px, bold) + 2) / 0.94) + 1;\n313: }\n314: /** The largest whole size up to `maxPx` at which `widthAt(px)` is at most `room`. */\n315: function largest(maxPx: number, room: number, widthAt: (px: number) => number): number {\n316:   let px = Math.max(1, Math.round(maxPx));\n317:   while (px > 1 && widthAt(px) > room) px--;\n318:   return px;\n319: }\n320: /** One line in a cell: the largest size up to `maxPx` that fits the cell's budget. */\n321: function fitPx(line: string, cellW: number, maxPx: number, bold: boolean): number {\n322:   const top = Math.max(1, Math.round(maxPx)), room = budget(cellW), w = widthOf(line, top, bold);\n323:   let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n324:   while (px > 1 && widthOf(line, px, bold) > room) px--;\n325:   return px;\n326: }\n327: \n328: /** The six cells of the QSO table, in reading order. */\n329: export const QSL_COLUMNS = [\"date\", \"utc\", \"mhz\", \"band\", \"mode\", \"rst\"] as const;\n330: const COLUMN_LABEL: Record<(typeof QSL_COLUMNS)[number], string> = { date: \"DATE\", utc: \"UTC\", mhz: \"MHz\", band: \"BAND\", mode: \"MODE\", rst: \"RST\" };\n331: const CONFIRM = \"CONFIRMING OUR QSO\";\n332: const MARK = \"ADIF QSO CARD\";\n333: \n334: /** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\n335: export function layoutQslCard(props: QslCardProps, W: number, H: number) {\n336:   const p = normalizeQslCard(props);\n337:   const S = Math.min(W, H), aspect = W / H;\n338:   // The table reflows by aspect first; type shrinks only after that.\n339:   const shape: \"wide\" | \"square\" | \"tall\" = aspect >= 1.25 ? \"wide\" : aspect >= 0.8 ? \"square\" : \"tall\";\n340:   const grid = shape === \"wide\" ? { rows: 1, cols: 6 } : shape === \"square\" ? { rows: 2, cols: 3 } : { rows: 3, cols: 2 };\n341:   const floor = Math.max(1, Math.round((S * 10) / 270));\n342:   const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} above the ${floor}px readability floor: shorten it or render a larger canvas.`);\n343: \n344:   const barH = Math.max(2, Math.round(S * 0.022));\n345:   const m = Math.round(S * 0.065), CW = W - 2 * m;\n346:   const top = barH + Math.round(S * 0.045), bottom = H - Math.round(S * 0.05), CH = bottom - top;\n347:   const gap = Math.round(S * 0.03);\n348:   const rule = Math.max(1, Math.round(S / 400));\n349:   const ruleColor = qslMix(PAPER, INK, 0.28);\n350:   const fr = { wide: [0.4, 0.15, 0.31], square: [0.33, 0.19, 0.36], tall: [0.28, 0.17, 0.47] }[shape];\n351:   const hh = Math.round(CH * fr[0]), sh = Math.round(CH * fr[1]), th = Math.round(CH * fr[2]), fh = CH - hh - sh - th;\n352:   const headY = top, stripY = headY + hh, tableY = stripY + sh, footY = tableY + th;\n353: \n354:   const cells: Cell[] = [];\n355:   const tiles: Tile[] = [];\n356:   const line = (label: string, rect: QslRect, text: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string } = {}) => {\n357:     if (px < floor) unfit(o.field ?? label);\n358:     cells.push({ label, rect, text, px, width: widthOf(text, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? (INK as MosaicColor), bind: o.bind ?? null, over: o.over === true });\n359:   };\n360: \n361:   tiles.push({ label: \"accent-bar\", rect: { x: 0, y: 0, w: W, h: barH }, color: p.accent, radius: 0, bind: \"accentColor\" });\n362: \n363:   // ── header: the station call, sized from its own text, and the station block ──\n364:   type StationLine = { label: string; value: string; tag?: string; bind: Bind };\n365:   const station: StationLine[] = [];\n366:   if (p.grid !== \"\") station.push({ label: \"station-grid\", tag: \"GRID\", value: p.grid, bind: \"myGridsquare\" });\n367:   if (p.qth !== \"\") station.push({ label: \"station-qth\", value: p.qth, bind: \"qth\" });\n368:   if (p.pota !== \"\") station.push({ label: \"station-pota\", tag: \"POTA\", value: p.pota, bind: \"myPotaRef\" });\n369:   const tagGap = (px: number) => Math.round(px * 0.3);\n370:   const lineNeed = (l: StationLine, px: number) => need(l.value, px, false) + (l.tag ? need(l.tag, px, false) + tagGap(px) : 0);\n371:   /** One station line drawn right- or left-aligned from `edge`: the tag in the dim ink, the value in the ink. */\n372:   const stationLine = (l: StationLine, y: number, h: number, px: number, edge: number, align: \"left\" | \"right\") => {\n373:     const vw = need(l.value, px, false), tw = l.tag ? need(l.tag, px, false) : 0;\n374:     const valueX = align === \"right\" ? edge - vw : edge + (l.tag ? tw + tagGap(px) : 0);\n375:     if (l.tag) line(`${l.label}-tag`, { x: align === \"right\" ? valueX - tagGap(px) - tw : edge, y, w: tw, h }, l.tag, px, { align, color: DIM as MosaicColor, field: l.bind as string });\n376:     line(l.label, { x: valueX, y, w: vw, h }, l.value, px, { align, bind: l.bind, field: l.bind as string });\n377:   };\n378: \n379:   let callPx: number;\n380:   if (shape === \"wide\") {\n381:     // The call takes the left, the station block the right as right-aligned\n382:     // lines; the block takes what its longest line needs (28-50% of the width).\n383:     const lineTop = Math.max(floor, Math.min(Math.round(hh * 0.13), Math.round(S * 0.05))), lineH = Math.max(Math.round(hh * 0.21), Math.ceil(lineTop / 0.62));\n384:     const stationW = station.length === 0 ? 0\n385:       : Math.max(Math.round(CW * 0.28), Math.min(Math.round(CW * 0.5), Math.max(...station.map((l) => lineNeed(l, lineTop)))));\n386:     const linePx = Math.min(lineTop, ...station.map((l) => largest(lineTop, stationW, (px) => lineNeed(l, px))));\n387:     const callW = station.length === 0 ? CW : CW - stationW - gap;\n388:     callPx = fitPx(p.stationCallsign, callW, hh * 0.72, true);\n389:     line(\"callsign\", { x: m, y: headY, w: callW, h: hh }, p.stationCallsign, callPx, { bold: true, bind: \"stationCallsign\", field: \"stationCallsign\" });\n390:     const y0 = headY + Math.round((hh - station.length * lineH) / 2);\n391:     station.forEach((l, i) => stationLine(l, y0 + i * lineH, lineH, linePx, m + CW, \"right\"));\n392:   } else {\n393:     // The call spans the width; the QTH and then GRID + POTA sit under it on one or two lines.\n394:     const rows: StationLine[][] = [];\n395:     if (p.qth !== \"\") rows.push(station.filter((l) => l.label === \"station-qth\"));\n396:     const tagged = station.filter((l) => l.tag);\n397:     if (tagged.length > 0) rows.push(tagged);\n398:     const lineTop = Math.max(floor, Math.min(Math.round(hh * 0.1), Math.round(S * 0.05))), lineH = Math.ceil(lineTop / 0.62);\n399:     const rowNeed = (row: StationLine[], px: number) => row.reduce((sum, l) => sum + lineNeed(l, px), 0) + (row.length - 1) * gap * 2;\n400:     const linePx = Math.min(lineTop, ...rows.map((row) => largest(lineTop, CW, (px) => rowNeed(row, px))));\n401:     const callMaxH = hh - rows.length * lineH;\n402:     callPx = fitPx(p.stationCallsign, CW, callMaxH * 0.72, true);\n403:     const callH = Math.min(callMaxH, Math.ceil(callPx / 0.72));\n404:     const y0 = headY + Math.round((hh - callH - rows.length * lineH) / 2);\n405:     line(\"callsign\", { x: m, y: y0, w: CW, h: callH }, p.stationCallsign, callPx, { bold: true, bind: \"stationCallsign\", field: \"stationCallsign\" });\n406:     rows.forEach((row, r) => {\n407:       let x = m;\n408:       for (const l of row) { stationLine(l, y0 + callH + r * lineH, lineH, linePx, x, \"left\"); x += lineNeed(l, linePx) + gap * 2; }\n409:     });\n410:   }\n411: \n412:   // ── to-radio strip: the TO RADIO tag, the worked call (second largest), the confirmation ──\n413:   tiles.push({ label: \"rule-head\", rect: { x: m, y: stripY, w: CW, h: rule }, color: ruleColor, radius: 0 });\n414:   const tagPxOf = (px: number) => Math.max(floor, Math.round(px * 0.4));\n415:   const chipPad = (tagPx: number) => Math.round(tagPx * 0.55);\n416:   const chipW = (tagPx: number) => need(\"TO RADIO\", tagPx, true) + 2 * chipPad(tagPx);\n417:   const workedCap = Math.round(callPx * 0.62);\n418:   const oneLineTop = Math.min(Math.round((sh - rule) * 0.5), workedCap);\n419:   const oneLineW = (px: number) => chipW(tagPxOf(px)) + gap + need(p.call, px, true) + gap + need(CONFIRM, tagPxOf(px), false);\n420:   const oneLinePx = largest(oneLineTop, CW, oneLineW);\n421:   const twoLines = shape !== \"wide\" && oneLinePx < oneLineTop * 0.85;\n422:   let workedPx: number;\n423:   {\n424:     const y = stripY + rule;\n425:     const h2Min = twoLines ? Math.max(Math.round((sh - rule) * 0.4), Math.ceil(floor / 0.6)) : 0;\n426:     const h1 = sh - rule - h2Min;\n427:     workedPx = twoLines ? largest(Math.min(Math.round(h1 * 0.62), workedCap), CW, (px) => chipW(tagPxOf(px)) + gap + need(p.call, px, true)) : oneLinePx;\n428:     const tagPx = tagPxOf(workedPx);\n429:     const cw = chipW(tagPx), chipH = Math.round(tagPx * 1.9);\n430:     const chip: QslRect = { x: m, y: y + Math.round((h1 - chipH) / 2), w: cw, h: chipH };\n431:     tiles.push({ label: \"to-radio-chip\", rect: chip, color: p.accent, radius: 0.18 });\n432:     line(\"to-radio\", chip, \"TO RADIO\", tagPx, { bold: true, align: \"center\", color: qslOnColor(p.accent), over: true, field: \"the TO RADIO tag\" });\n433:     const wx = m + cw + gap;\n434:     line(\"worked-call\", { x: wx, y, w: need(p.call, workedPx, true), h: h1 }, p.call, workedPx, { bold: true, bind: \"call\", field: \"call\" });\n435:     if (twoLines) {\n436:       const h2 = h2Min, cpx = Math.min(tagPx, fitPx(CONFIRM, CW, h2 * 0.6, false));\n437:       line(\"confirm\", { x: m, y: y + h1, w: need(CONFIRM, cpx, false), h: h2 }, CONFIRM, cpx, { color: DIM as MosaicColor, field: \"the confirmation line\" });\n438:     } else {\n439:       const cw2 = need(CONFIRM, tagPx, false);\n440:       line(\"confirm\", { x: m + CW - cw2, y, w: cw2, h: h1 }, CONFIRM, tagPx, { align: \"right\", color: DIM as MosaicColor, field: \"the confirmation line\" });\n441:     }\n442:   }\n443: \n444:   // ── the QSO table: a label over a value per cell, columns weighted by what they hold ──\n445:   const values: Record<(typeof QSL_COLUMNS)[number], { text: string; bind: Bind }> = {\n446:     date: { text: p.date, bind: \"qsoDate\" }, utc: { text: p.time, bind: \"timeOn\" }, mhz: { text: p.freq, bind: \"freq\" },\n447:     // BAND is derived from FREQ, so nothing binds it.\n448:     band: { text: p.band, bind: null }, mode: { text: p.mode, bind: \"mode\" }, rst: { text: p.rst, bind: \"rstSent\" },\n449:   };\n450:   // The table starts a little below the strip, so its first label never reads as part of the line above.\n451:   const tablePad = Math.round(S * 0.02), rowH = Math.floor((th - tablePad) / grid.rows);\n452:   const labelH = Math.round(rowH * 0.3), accentRule = Math.max(1, Math.round(S / 300));\n453:   const valueH = rowH - labelH - accentRule - Math.round(rowH * 0.06);\n454:   const colGap = Math.round(S * 0.035);\n455:   const cellsAt = (c: number) => QSL_COLUMNS.filter((_, i) => i % grid.cols === c);\n456:   // Hierarchy: the station call is at least twice a table value, the worked call at least one.\n457:   const valueTop = Math.min(Math.round(valueH * 0.7), Math.floor(callPx / 2), workedPx, Math.round(S * 0.11));\n458:   const labelPxOf = (px: number) => Math.max(floor, Math.min(Math.round(labelH * 0.6), Math.round(px * 0.5)));\n459:   const colNeed = (px: number) => Array.from({ length: grid.cols }, (_, c) =>\n460:     Math.max(...cellsAt(c).map((k) => Math.max(need(values[k].text, px, true), need(COLUMN_LABEL[k], labelPxOf(px), false)))));\n461:   const valuePx = largest(valueTop, CW, (px) => colNeed(px).reduce((a, b) => a + b, 0) + (grid.cols - 1) * colGap);\n462:   if (valuePx < floor) unfit(\"the QSO table\");\n463:   const labelPx = labelPxOf(valuePx);\n464:   const needs = colNeed(valuePx), sumNeed = needs.reduce((a, b) => a + b, 0);\n465:   const spare = CW - sumNeed - (grid.cols - 1) * colGap;\n466:   const colX: number[] = [], colW: number[] = [];\n467:   let x = m;\n468:   needs.forEach((n, c) => {\n469:     // The spare width is shared equally, so the gutters read as one rhythm; the content weights the rest.\n470:     const w = c === grid.cols - 1 ? m + CW - x : n + Math.floor(spare / grid.cols);\n471:     colX.push(x); colW.push(w); x += w + colGap;\n472:   });\n473:   for (let r = 0; r < grid.rows; r++) {\n474:     const ry = tableY + tablePad + r * rowH;\n475:     tiles.push({ label: `label-rule-${r}`, rect: { x: m, y: ry + labelH, w: CW, h: accentRule }, color: p.accent, radius: 0 });\n476:   }\n477:   QSL_COLUMNS.forEach((k, i) => {\n478:     const r = Math.floor(i / grid.cols), c = i % grid.cols, ry = tableY + tablePad + r * rowH;\n479:     line(`col-label-${k}`, { x: colX[c], y: ry, w: colW[c], h: labelH }, COLUMN_LABEL[k], labelPx, { color: DIM as MosaicColor, field: \"the QSO table labels\" });\n480:     line(`col-value-${k}`, { x: colX[c], y: ry + labelH + accentRule, w: colW[c], h: valueH }, values[k].text, valuePx, { bold: true, bind: values[k].bind, field: \"the QSO table\" });\n481:   });\n482: \n483:   // ── footer: QSLMSG on the left, the card's small mark on the right (dropped when it costs fit) ──\n484:   tiles.push({ label: \"rule-foot\", rect: { x: m, y: footY, w: CW, h: rule }, color: ruleColor, radius: 0 });\n485:   const fy = footY + rule, fH = fh - rule;\n486:   const footTop = Math.max(floor, Math.min(Math.round(fH * 0.42), Math.round(S * 0.045)));\n487:   const markPx = Math.max(floor, Math.round(footTop * 0.75));\n488:   const markW = need(MARK, markPx, false);\n489:   let showMark = true, msgPx = footTop;\n490:   if (p.qslMsg !== \"\") {\n491:     msgPx = fitPx(p.qslMsg, CW - markW - gap, footTop, false);\n492:     if (msgPx < footTop * 0.85) { showMark = false; msgPx = fitPx(p.qslMsg, CW, footTop, false); }\n493:     line(\"qslmsg\", { x: m, y: fy, w: need(p.qslMsg, msgPx, false), h: fH }, p.qslMsg, msgPx, { bind: \"qslMsg\", field: \"qslMsg\" });\n494:   }\n495:   if (showMark) line(\"mark\", { x: m + CW - markW, y: fy, w: markW, h: fH }, MARK, markPx, { align: \"right\", color: DIM as MosaicColor, field: \"the card mark\" });\n496: \n497:   return { p, shape, grid, floor, cells, tiles, callPx, workedPx, valuePx, labelPx, twoLines, showMark, bands: { headY, stripY, tableY, footY, bottom } };\n498: }\n499: \n500: /**\n501:  * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n502:  * convention, src/_shared/why.ts): the run, the problem with the sources the\n503:  * agent opened, the solution, how to use it, then the template itself.\n504:  */\n505: const WHY: WhySpec = {\n506:   \"day\": 14,\n507:   \"date\": \"2026-10-03\",\n508:   \"agent\": \"claude\",\n509:   \"model\": \"claude-opus-5-5\",\n510:   \"id\": \"@one-a-day/community/qsl-card/v1\",\n511:   \"title\": \"Ham Radio QSL Card\",\n512:   \"who\": \"Ham radio operators who owe every station they worked a QSL card, gathered around their loggers (World Radio League, Wavelog, Log4OM) and POTA activators.\",\n513:   \"problem\": [\n514:     \"The World Radio League forum thread \\\"QSL Card Generator\\\" opens (57 likes) asking to \\\"select a template ... the appropriate information (other callsign/band/frequency/mode/time/report/etc.) would be auto populated ... a PNG or JPEG could be saved off\\\". A new licensee replies: \\\"struggling with putting together a card\\\".\",\n515:     \"It is a batch job: \\\"Auto QSL Card\\\" asks for a card \\\"to all contacts made that day ... if I'm on a camping trip for 8 days\\\", and page 2 posts a Pillow script drawing text at hand-picked (x, y) points. Wavelog, DigiQSL and S53ZO's label tool take ADIF in, but none renders an image per QSO from a command line.\"\n516:   ],\n517:   \"sources\": [\n518:     \"https://community.worldradioleague.com/t/qsl-card-generator/13739\",\n519:     \"https://community.worldradioleague.com/t/qsl-card-generator/13739?page=2\",\n520:     \"https://community.worldradioleague.com/t/auto-qsl-card/\",\n521:     \"https://www.adif.org/316/ADIF_316.htm\",\n522:     \"https://github.com/s53zo/ADIF-to-QSL-label\",\n523:     \"https://cq.sk/en/adif-to-qsl-label/\",\n524:     \"https://docs.wavelog.org/user-guide/qsl/qsl-postcard-designer/\",\n525:     \"https://digiqsl.com/features\",\n526:     \"https://amateurradio.com/qsling-made-easy\"\n527:   ],\n528:   \"solution\": [\n529:     \"One card per QSO from one ADIF record. The props are the ADIF fields in camelCase, in ADIF formats (qsoDate \\\"20261003\\\", timeOn \\\"1432\\\", freq \\\"14.074\\\"), printed the QSL way: 03 OCT 2026, 14:32. BAND is not a prop: it is derived from FREQ with the ADIF 3.1.6 band table, so the two never disagree.\",\n530:     \"The decision that matters: a callsign is never ellipsized. The call is sized from its own text, the QSO table reflows 6x1, 3x2 or 2x3 by aspect before any type shrinks, and copy that cannot fit above the floor is refused with an error naming the prop. No photo background in v1: paper, one accent and type.\"\n531:   ],\n532:   \"usage\": {\n533:     \"command\": \"m0saic make @one-a-day/community/qsl-card/v1 --template-repo . -w 1920 -h 1080 --props '{\\\"call\\\":\\\"DL1ABC\\\",\\\"freq\\\":\\\"7.074\\\",\\\"timeOn\\\":\\\"0915\\\"}' -o qsl-DL1ABC.png\",\n534:     \"try\": [\n535:       \"--props @qso.json, one file per ADIF record: a loop over the log writes one card per QSO\",\n536:       \"-w 1650 -h 1050: the 5.5 x 3.5 in card at 300 dpi; -w 1080 -h 1080 or -h 1920 reflow the table to 3x2 or 2x3\",\n537:       \"freq \\\"432.100\\\" prints BAND 70cm; freq \\\"27.185\\\" (CB) is refused: it is in no amateur band\",\n538:       \"myPotaRef \\\"\\\", myGridsquare \\\"\\\": the lines and their prefixes go; accentColor \\\"#1f5fa8\\\" for a blue card\"\n539:     ]\n540:   },\n541:   \"timeline\": {\n542:     \"source\": \"runner\",\n543:     \"phases\": [\n544:       {\n545:         \"name\": \"scout\",\n546:         \"startMs\": 0,\n547:         \"durMs\": 187402,\n548:         \"calls\": 29,\n549:         \"tokens\": 2732923,\n550:         \"costUsd\": 1.3,\n551:         \"tools\": \"Bash 16, WebSearch 11, ToolSearch 1\"\n552:       },\n553:       {\n554:         \"name\": \"plan\",\n555:         \"startMs\": 187417,\n556:         \"durMs\": 235946,\n557:         \"calls\": 7,\n558:         \"tokens\": 650247,\n559:         \"costUsd\": 0.73,\n560:         \"tools\": \"Bash 6, Write 1\"\n561:       },\n562:       {\n563:         \"name\": \"build\",\n564:         \"startMs\": 423392,\n565:         \"durMs\": 1207648,\n566:         \"calls\": 64,\n567:         \"tokens\": 16253730,\n568:         \"costUsd\": 4.48,\n569:         \"tools\": \"Bash 42, Read 19, Write 3\"\n570:       },\n571:       {\n572:         \"name\": \"critique\",\n573:         \"startMs\": 1631053,\n574:         \"durMs\": 272372,\n575:         \"calls\": 44,\n576:         \"tokens\": 7128751,\n577:         \"costUsd\": 2.05,\n578:         \"tools\": \"Bash 22, Read 21, Write 1\"\n579:       }\n580:     ],\n581:     \"costBasis\": \"reported\"\n582:   },\n583:   \"caveats\": [\n584:     \"No photo background in v1: the card is paper, one accent colour and type. Shack and park photos, the usual QSL face, are a later version.\",\n585:     \"One QSO per card. It reads no .adi file: your script maps each ADIF record to the props and calls m0saic make once per QSO.\",\n586:     \"RST_RCVD, QSL_VIA and the rig are not printed. BAND is always derived from FREQ, so a log whose BAND disagrees with its FREQ shows the FREQ band.\"\n587:   ]\n588: };\n589: \n590: export const QslCardV1 = defineMosaicTemplate<QslCardProps>({\n591:   id: asTemplateId(ID),\n592:   label: \"2026-10-03 · Ham Radio QSL Card\",\n593:   version: 1,\n594:   description: \"A ham radio QSL card for one contact, from one ADIF log record: props named after the ADIF fields, the date and time printed the QSL way, BAND derived from FREQ. Paper and type only, no photo background in v1.\",\n595:   capabilities: { tier: \"core\" },\n596:   tags: [\"community\",\"2026-10-03\",\"day-014\", \"ham-radio\", \"qsl\", \"adif\", \"card\"],\n597: \n598:   outputHints: {\n599:     width: 1920,\n600:     height: 1080,\n601:     fps: 30,\n602:     durationMs: 2000,\n603:     format: { kind: \"image\", container: \"png\" },\n604:     note: \"Still PNG, one card per QSO. The physical card is 5.5 x 3.5 in (1650x1050 at 300 dpi); portrait and square reflow the QSO table to 2x3 and 3x2. Minimum tested canvas 480x270.\",\n605:   },\n606: \n607:   propsSchema,\n608:   defaultProps: DEFAULTS,\n609: \n610:   render,\n611:   renderTutorial: whyTutorial(WHY, render),\n612: });\n613: \n614: export default QslCardV1;\n615: \n616: async function render(props: QslCardProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n617:   const { width: W, height: H } = ctx.target;\n618:   const L = layoutQslCard(props, W, H);\n619:   const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n620:   const constraints: LayoutConstraint[] = [];\n621: \n622:   for (const t of L.tiles) {\n623:     const tile = tag({ ...makeColorTile(t.color, t.radius > 0 ? { effects: { rounding: { cornerStyle: \"rounded\", borderRadius: t.radius } } } : {}) } as MosaicSource, t.label);\n624:     // The accent bar is the rect that shows `accentColor`.\n625:     pieces.push({ rect: { ...t.rect, importance: 1 }, source: t.bind ? bindProp(tile, t.bind) : tile });\n626:   }\n627:   for (const c of L.cells) {\n628:     const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n629:     // A text rect is BOUND to the prop it shows; derived copy (BAND, the labels, the chrome) is not.\n630:     pieces.push({ rect: { ...c.rect, importance: c.over ? 3 : 2 }, source: c.bind === null ? cell : bindProp(cell, c.bind) });\n631:     constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n632:   }\n633: \n634:   // What the geometry promises: every text fits (above); the call in the top\n635:   // half; all six QSO values present and in the table band; the footer at the\n636:   // bottom; the accent bar across the card.\n637:   constraints.push({ label: \"callsign\", within: { yFrac: [0, 0.5] } });\n638:   for (const k of [\"date\", \"utc\", \"mhz\", \"band\", \"mode\", \"rst\"]) constraints.push({ label: `col-value-${k}`, within: { yFrac: [0.3, 0.92] } });\n639:   if (L.cells.some((c) => c.label === \"qslmsg\")) constraints.push({ label: \"qslmsg\", within: { yFrac: [0.6, 1] } });\n640:   constraints.push({ label: \"accent-bar\", minWidthFrac: 0.98 });\n641:   constraints.push({ label: \"worked-call\" });\n642: \n643:   const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n644:   const doc: MosaicDocument = {\n645:     kind: \"mosaic_document\",\n646:     version: 1,\n647:     m0: toM0String(placed.m0, ID),\n648:     assets: {},\n649:     backgroundColor: PAPER as MosaicColor,\n650:     sources: placed.sources,\n651:   };\n652:   return withLayoutIntent(doc, ctx, { templateId: ID, constraints, debug: props.debugLayout === true });\n653: }\n\n(End of file - total 653 lines)\n</content>","metadata":{"preview":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/community/qsl-card/v1` - a ham radio QSL card for ONE contact,\n * rendered from the fields of one ADIF log record, so a script can loop over\n * a whole log and write one card per QSO.\n *\n * ONE CONCEPT: the props ARE the log record. Each prop is an ADIF field in\n * camelCase taking the ADIF format (QSO_DATE \"20261003\", TIME_ON \"1432\",\n * FREQ \"14.074\" in MHz), and the card prints it the way a QSL does\n * (\"03 OCT 2026\", \"14:32\"). BAND is not a prop: it is DERIVED from FREQ with\n * the ADIF 3.1.6 band enumeration, so the two can never disagree on a card.","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\src\\community\\qsl-card\\v1\\qsl-card.ts","text":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/community/qsl-card/v1` - a ham radio QSL card for ONE contact,\n * rendered from the fields of one ADIF log record, so a script can loop over\n * a whole log and write one card per QSO.\n *\n * ONE CONCEPT: the props ARE the log record. Each prop is an ADIF field in\n * camelCase taking the ADIF format (QSO_DATE \"20261003\", TIME_ON \"1432\",\n * FREQ \"14.074\" in MHz), and the card prints it the way a QSL does\n * (\"03 OCT 2026\", \"14:32\"). BAND is not a prop: it is DERIVED from FREQ with\n * the ADIF 3.1.6 band enumeration, so the two can never disagree on a card.\n *\n * The rule that bites: a callsign is never ellipsized. A card with half a\n * call on it confirms nothing. The station call is sized from its own text\n * (a short K1A is limited by the band's height, a long VP2V/G4ABC by its\n * width), the QSO table reflows by aspect (6x1, 3x2, 2x3) before any type\n * shrinks, the table values shrink before the call drops below twice their\n * size, and copy that cannot fit above the readability floor (10/270 of\n * the short side) is refused with an error that names the prop.\n */\n\nexport type QslCardProps = {\n  /** STATION_CALLSIGN: the sender, the biggest thing on the card. */\n  stationCallsign?: string;\n  /** CALL: the station worked - \"TO RADIO <call>\". */\n  call?: string;\n  /** QSO_DATE as YYYYMMDD (UTC). */\n  qsoDate?: string;\n  /** TIME_ON as HHMM or HHMMSS (UTC). */\n  timeOn?: string;\n  /** FREQ in MHz, printed as given; BAND is derived from it. */\n  freq?: string;\n  /** MODE (or SUBMODE), printed as the log says it. */\n  mode?: string;\n  /** RST_SENT: \"59\", \"599\" or a signed dB report (\"-12\"). */\n  rstSent?: string;\n  /** MY_GRIDSQUARE: 4, 6 or 8 character Maidenhead; \"\" hides the line. */\n  myGridsquare?: string;\n  /** MY_CITY / MY_STATE as one line; \"\" hides it. */\n  qth?: string;\n  /** MY_POTA_REF: a Parks on the Air reference; \"\" hides it. */\n  myPotaRef?: string;\n  /** QSLMSG: the footer line; \"\" hides it. */\n  qslMsg?: string;\n  /** The one accent: top bar, label rules, TO RADIO tag. */\n  accentColor?: string;\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/community/qsl-card/v1\";\n/** The face: document.backgroundColor, never a full-canvas rect (doctor: canvasFill). */\nconst PAPER = \"#f4f1ea\";\nconst INK = \"#1b2a4a\";\nconst DIM = \"#66758c\";\nconst DEFAULT_ACCENT = \"#b3261e\";\n\n// Labelled examples, not anybody's log: N0CALL is the placeholder call ham\n// software ships with, W1AW the ARRL station its documentation uses, and the\n// grid EN34 sits in the 0 call district, so it agrees with N0CALL.\nconst DEFAULTS = {\n  stationCallsign: \"N0CALL\",\n  call: \"W1AW\",\n  qsoDate: \"20261003\",\n  timeOn: \"1432\",\n  freq: \"14.074\",\n  mode: \"FT8\",\n  rstSent: \"-12\",\n  myGridsquare: \"EN34\",\n  qth: \"Minneapolis, MN\",\n  myPotaRef: \"US-1234\",\n  qslMsg: \"TNX QSO 73\",\n  accentColor: DEFAULT_ACCENT,\n  debugLayout: false,\n};\n\nconst propsSchema = definePropsSchema<QslCardProps>({\n  stationCallsign: {\n    type: \"string\",\n    required: false,\n    description: \"STATION_CALLSIGN: your call, the biggest thing on the card. 3-13 characters of A-Z, 0-9 and /, with at least one digit (portable suffixes like /P are fine); upper-cased. Never ellipsized: a call that cannot fit the canvas is refused.\",\n    meta: { control: { placeholder: DEFAULTS.stationCallsign }, ui: { label: \"Station callsign\", order: 1, primary: true } },\n  },\n  call: {\n    type: \"string\",\n    required: false,\n    description: \"CALL: the station you worked, printed as TO RADIO <call>. Same rule as the station callsign.\",\n    meta: { control: { placeholder: DEFAULTS.call }, ui: { label: \"Worked call (CALL)\", order: 2, primary: true } },\n  },\n  qsoDate: {\n    type: \"string\",\n    required: false,\n    description: 'QSO_DATE as the log writes it, YYYYMMDD in UTC (1930 or later). Printed with the month spelled out, \"03 OCT 2026\", so it reads the same in the US and in Europe.',\n    meta: { control: { placeholder: DEFAULTS.qsoDate }, ui: { label: \"QSO date (YYYYMMDD)\", order: 3 } },\n  },\n  timeOn: {\n    type: \"string\",\n    required: false,\n    description: 'TIME_ON in UTC, HHMM or HHMMSS. Printed as 14:32 (or 14:32:05) under the UTC label.',\n    meta: { control: { placeholder: DEFAULTS.timeOn }, ui: { label: \"Time on (HHMM UTC)\", order: 4 } },\n  },\n  freq: {\n    type: \"string\",\n    required: false,\n    description: 'FREQ in MHz, e.g. \"14.074\" or \"1296.200\", printed as given (no rounding, up to 6 decimals). The BAND cell is derived from it with the ADIF 3.1.6 band table (14.074 -> 20m, 432.100 -> 70cm); a frequency outside every amateur band (27.185) is refused.',\n    meta: { control: { placeholder: DEFAULTS.freq }, ui: { label: \"Frequency (MHz)\", order: 5 } },\n  },\n  mode: {\n    type: \"string\",\n    required: false,\n    description: \"MODE or SUBMODE as the log says it (SSB, CW, FT8, FT4, RTTY...). 1-8 characters of A-Z, 0-9 and -, upper-cased; not checked against the ADIF mode list.\",\n    meta: { control: { placeholder: DEFAULTS.mode }, ui: { label: \"Mode\", order: 6 } },\n  },\n  rstSent: {\n    type: \"string\",\n    required: false,\n    description: 'RST_SENT: the report you gave, RS or RST digits (\"59\", \"599\") or a signed dB report (\"-12\", \"+05\").',\n    meta: { control: { placeholder: DEFAULTS.rstSent }, ui: { label: \"Report sent (RST)\", order: 7 } },\n  },\n  myGridsquare: {\n    type: \"string\",\n    required: false,\n    description: 'MY_GRIDSQUARE: 4, 6 or 8 character Maidenhead locator, printed in canonical case (\"EN34lw\"). Empty removes the GRID line.',\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"My grid square\", order: 8 } },\n  },\n  qth: {\n    type: \"string\",\n    required: false,\n    description: \"Your QTH (MY_CITY / MY_STATE as one line), up to 32 characters of printable ASCII. Empty removes the line.\",\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"QTH\", order: 9 } },\n  },\n  myPotaRef: {\n    type: \"string\",\n    required: false,\n    description: 'MY_POTA_REF: a Parks on the Air reference (\"US-1234\", \"K-12345\", \"GB-0001@GB-ENG\"). Empty removes the POTA line - most cards are not from a park.',\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"My POTA ref\", order: 10 } },\n  },\n  qslMsg: {\n    type: \"string\",\n    required: false,\n    description: \"QSLMSG: the footer line, up to 40 characters of printable ASCII. Empty removes it.\",\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"QSL message\", order: 11 } },\n  },\n  accentColor: {\n    type: \"string\",\n    required: false,\n    description: \"The one accent, as #rrggbb: the bar along the top, the rules under the table labels and the TO RADIO tag.\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 12 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits its box, the call sits in the top half, the QSO table is complete, the accent bar spans the card) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n/* ── the ADIF record: pure, exported, and what the test asserts ── */\n\nfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n\n/** An ADIF Number in MHz -> integer Hz; null when it is not one (more than 6 decimals is not one here). */\nexport function qslMHzToHz(text: string): number | null {\n  const m = /^(\\d{0,7})(?:\\.(\\d{1,6}))?$/.exec(text);\n  if (!m || (m[1] === \"\" && m[2] === undefined)) return null;\n  return Number(m[1] || \"0\") * 1_000_000 + Number((m[2] ?? \"\").padEnd(6, \"0\"));\n}\n\n/** The ADIF 3.1.6 Band enumeration (section III.B.4), lower and upper edge in MHz, both inclusive. */\nconst ADIF_BANDS: ReadonlyArray<readonly [string, string, string]> = [\n  [\"2190m\", \".1357\", \".1378\"], [\"630m\", \".472\", \".479\"], [\"560m\", \".501\", \".504\"],\n  [\"160m\", \"1.8\", \"2.0\"], [\"80m\", \"3.5\", \"4.0\"], [\"60m\", \"5.06\", \"5.45\"], [\"40m\", \"7.0\", \"7.3\"],\n  [\"30m\", \"10.1\", \"10.15\"], [\"20m\", \"14.0\", \"14.35\"], [\"17m\", \"18.068\", \"18.168\"], [\"15m\", \"21.0\", \"21.45\"],\n  [\"12m\", \"24.890\", \"24.99\"], [\"10m\", \"28.0\", \"29.7\"], [\"8m\", \"40\", \"45\"], [\"6m\", \"50\", \"54\"],\n  [\"5m\", \"54.000001\", \"69.9\"], [\"4m\", \"70\", \"71\"], [\"2m\", \"144\", \"148\"], [\"1.25m\", \"222\", \"225\"],\n  [\"70cm\", \"420\", \"450\"], [\"33cm\", \"902\", \"928\"], [\"23cm\", \"1240\", \"1300\"], [\"13cm\", \"2300\", \"2450\"],\n  [\"9cm\", \"3300\", \"3500\"], [\"6cm\", \"5650\", \"5925\"], [\"3cm\", \"10000\", \"10500\"], [\"1.25cm\", \"24000\", \"24250\"],\n  [\"6mm\", \"47000\", \"47200\"], [\"4mm\", \"75500\", \"81000\"], [\"2.5mm\", \"119980\", \"123000\"], [\"2mm\", \"134000\", \"149000\"],\n  [\"1mm\", \"241000\", \"250000\"], [\"submm\", \"300000\", \"7500000\"],\n];\nconst BAND_HZ = ADIF_BANDS.map(([band, lo, hi]) => ({ band, lo: qslMHzToHz(lo) as number, hi: qslMHzToHz(hi) as number }));\n\n/** FR