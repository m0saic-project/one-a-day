{"type":"tool_use","timestamp":1792416104246,"sessionID":"ses_eabad0e61ffeMfJmuPCNFqL7sc","part":{"type":"tool","tool":"read","callID":"call-b374034a-f357-440b-a7ce-c1b0097bf5d3-10","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\erg-pb-card\\v1\\erg-pb-card.ts","limit":250},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\src\\sports\\erg-pb-card\\v1\\erg-pb-card.ts</path>\n<type>file</type>\n<content>\n1: import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\n2: import { asTemplateId } from \"@m0saic/types\";\n3: import { toM0String } from \"@m0saic/dsl-stdlib\";\n4: import { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag, wrapMeasured } from \"@m0saic/template-utils\";\n5: import type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\n6: import { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n7: import { budget, textCell, widthOf } from \"../../../_shared/text\";\n8: import { whyTutorial } from \"../../../_shared/why\";\n9: import type { WhySpec } from \"../../../_shared/why\";\n10: \n11: /**\n12:  * `@one-a-day/sports/erg-pb-card/v1` - one indoor rower's piece as a share\n13:  * card: the /500m split as the hero figure on a fixed 1:00-3:00 pace track,\n14:  * the piece's time or metres second, stroke rate, watts and drag as cells,\n15:  * and the season-ranking percentile as a chip - from PM5/Logbook numbers\n16:  * every rower already has.\n17:  *\n18:  * ONE CONCEPT: the split is the hero. /500m pace is the unit the community\n19:  * compares in - a \"5k 18:42,2\" is read as 1:52.4 - so the card's hierarchy\n20:  * is the forum's own: split biggest, the piece's result second, the PM5's\n21:  * supporting numbers as cells, the percentile as a chip the rower supplies.\n22:  *\n23:  * The rule that bites: the template computes no claim it cannot verify. No\n24:  * PB badge, no invented percentile (the ranking moves with season, age and\n25:  * weight class), no cross-check between watts and split - the PM5 is\n26:  * authoritative, every figure is entered, and the pace track is a FIXED\n27:  * scale that claims nothing about ranking (the chip does that). A split\n28:  * outside 1:00-3:00 clamps the MARKER to the track's end; the printed split\n29:  * is always the truth.\n30:  */\n31: \n32: export type ErgPbCardProps = {\n33:   /** The rower's name, the header's bold line. Up to 40 characters; accented Latin letters are drawn. */\n34:   rower?: string;\n35:   /** Second header line (\"the 2026 season's median 2k\"); \"\" removes it. Up to 48 characters. */\n36:   note?: string;\n37:   /** The split as the PM5 prints it, \"m:ss.t\" from 1:00.0 to 9:59.9 (e.g. \"1:58.8\"). The hero figure AND the marker position. */\n38:   split?: string;\n39:   /** The piece's result - a time (\"7:55.0\", \"3:36:47\") or metres (\"7,096 m\"); \"\" removes the figure and its caption. Up to 14 characters. */\n40:   result?: string;\n41:   /** The caption under the result (\"2,000 m\", \"marathon\"); \"\" removes it. Up to 16 characters. */\n42:   piece?: string;\n43:   /** Stroke rate; 10-60, or 0 to hide the cell. */\n44:   spm?: number;\n45:   /** Watts; 20-600, or 0 to hide the cell. */\n46:   watts?: number;\n47:   /** Drag factor; 50-250, or 0 to hide the cell. */\n48:   drag?: number;\n49:   /** The season-ranking percentile the rower supplies, 1-99; 0 hides the chip and its cohort line. */\n50:   percentile?: number;\n51:   /** The dim line under the chip (\"2026 rower ranking\"); \"\" hides it. Up to 40 characters. */\n52:   percentileCohort?: string;\n53:   /** The marker, the chip and the rules, as #rrggbb. */\n54:   accent?: string;\n55:   /** Page and ink. */\n56:   preset?: \"dark\" | \"light\";\n57:   /** Dev-only: check the layout contract and draw it over the card. */\n58:   debugLayout?: boolean;\n59: };\n60: \n61: const ID = \"@one-a-day/sports/erg-pb-card/v1\";\n62: export const TITLE = \"Erg PB Card\";\n63: const DEFAULT_ACCENT = \"#1c6fb8\";\n64: /** The page is document.backgroundColor, never a full-canvas rect (doctor: canvasFill). */\n65: const THEMES = {\n66:   dark: { bg: \"#0c1a24\", ink: \"#eaf3f7\", dim: \"#7f95a1\" },\n67:   light: { bg: \"#f4f8fa\", ink: \"#0f2230\", dim: \"#4f6270\" },\n68: } as const;\n69: \n70: // An invented rower at the 2026 ranking's own median 2k: time 7:55.0 and the\n71: // 50th percentile are the cited ranking page's printed 50th band (10,198\n72: // ranked rowers); 1:58.8 is that time over 4; 209 W is 2.8 / (pace s/m)^3;\n73: // spm and drag are illustrative. The WHY says which is which.\n74: const DEFAULTS = {\n75:   rower: \"Marcus Alder\",\n76:   note: \"the 2026 season's median 2k\",\n77:   split: \"1:58.8\",\n78:   result: \"7:55.0\",\n79:   piece: \"2,000 m\",\n80:   spm: 26,\n81:   watts: 209,\n82:   drag: 110,\n83:   percentile: 50,\n84:   percentileCohort: \"2026 rower ranking\",\n85:   accent: DEFAULT_ACCENT,\n86:   preset: \"dark\" as \"dark\" | \"light\",\n87:   debugLayout: false,\n88: };\n89: \n90: /** The pace track's fixed scale, in tenths of a second per 500m: 1:00 to 3:00. */\n91: export const PACE_MIN_TENTHS = 600;\n92: export const PACE_MAX_TENTHS = 1800;\n93: /** The five ticks, labeled, at equal quarters of the track. */\n94: export const PACE_TICKS = [\"1:00\", \"1:30\", \"2:00\", \"2:30\", \"3:00\"] as const;\n95: \n96: const propsSchema = definePropsSchema<ErgPbCardProps>({\n97:   split: {\n98:     type: \"string\",\n99:     required: false,\n100:     description: 'The /500m split as the PM5 prints it: \"m:ss.t\" from 1:00.0 to 9:59.9 (e.g. \"1:58.8\"). The card\\'s hero figure, and the marker on the 1:00-3:00 pace track. Only leaving it unset takes the sample split.',\n101:     meta: { control: { placeholder: DEFAULTS.split }, ui: { label: \"Split /500m\", order: 1, primary: true } },\n102:   },\n103:   result: {\n104:     type: \"string\",\n105:     required: false,\n106:     description: 'The piece\\'s result: a time (\"7:55.0\", \"3:36:47\") or metres (\"7,096 m\"). Empty removes the figure and its caption. Up to 14 characters.',\n107:     meta: { control: { placeholder: DEFAULTS.result }, ui: { label: \"Result\", order: 2 } },\n108:   },\n109:   piece: {\n110:     type: \"string\",\n111:     required: false,\n112:     description: 'The caption under the result: \"2,000 m\", \"1 hour\", \"marathon\". Empty removes it. Up to 16 characters.',\n113:     meta: { control: { placeholder: DEFAULTS.piece }, ui: { label: \"Piece\", order: 3 } },\n114:   },\n115:   rower: {\n116:     type: \"string\",\n117:     required: false,\n118:     description: \"The rower's name, the header's bold line. Up to 40 characters; accented Latin letters are drawn. The sample is an invented rower.\",\n119:     meta: { control: { placeholder: DEFAULTS.rower }, ui: { label: \"Rower\", order: 4 } },\n120:   },\n121:   note: {\n122:     type: \"string\",\n123:     required: false,\n124:     description: 'The second header line (the default names where the sample numbers came from). Empty removes it. Up to 48 characters.',\n125:     meta: { control: { placeholder: \"none\" }, ui: { label: \"Note\", order: 5 } },\n126:   },\n127:   spm: {\n128:     type: \"number\",\n129:     required: false,\n130:     description: \"Stroke rate as the PM5 shows it. Integer 10-60; 0 hides the cell.\",\n131:     meta: { constraints: { min: 0, max: 60 }, control: { placeholder: String(DEFAULTS.spm) }, ui: { label: \"SPM\", order: 6 } },\n132:   },\n133:   watts: {\n134:     type: \"number\",\n135:     required: false,\n136:     description: \"Watts as the PM5 shows it - entered, not computed from the split. Integer 20-600; 0 hides the cell.\",\n137:     meta: { constraints: { min: 0, max: 600 }, control: { placeholder: String(DEFAULTS.watts) }, ui: { label: \"Watts\", order: 7 } },\n138:   },\n139:   drag: {\n140:     type: \"number\",\n141:     required: false,\n142:     description: \"Drag factor as the PM5 shows it. Integer 50-250; 0 hides the cell.\",\n143:     meta: { constraints: { min: 0, max: 250 }, control: { placeholder: String(DEFAULTS.drag) }, ui: { label: \"Drag\", order: 8 } },\n144:   },\n145:   percentile: {\n146:     type: \"number\",\n147:     required: false,\n148:     description: \"The season-ranking percentile as a chip the rower supplies (the ranking page prints the bands; they move with season, age and weight class, so the card computes none). Integer 1-99; 0 hides the chip and its cohort line.\",\n149:     meta: { constraints: { min: 0, max: 99 }, control: { placeholder: String(DEFAULTS.percentile) }, ui: { label: \"Percentile\", order: 9 } },\n150:   },\n151:   percentileCohort: {\n152:     type: \"string\",\n153:     required: false,\n154:     description: 'The dim line under the chip naming the cohort: \"2026 rower ranking\". Empty hides the line. Up to 40 characters.',\n155:     meta: { control: { placeholder: \"none\" }, ui: { label: \"Ranking cohort\", order: 10 } },\n156:   },\n157:   accent: {\n158:     type: \"string\",\n159:     required: false,\n160:     description: \"The marker, the chip and the rules, as #rrggbb (the club or crew colour).\",\n161:     meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 11 } },\n162:   },\n163:   preset: {\n164:     type: \"string\",\n165:     required: false,\n166:     description: 'Page and ink: \"dark\" (default) or \"light\".',\n167:     meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 12 } },\n168:   },\n169:   debugLayout: {\n170:     type: \"boolean\",\n171:     required: false,\n172:     description: \"Dev-only: check the layout contract (every text fits its box, the marker is on the track, the ticks are one size) and draw it over the card.\",\n173:     meta: { ui: { label: \"Debug layout\", order: 99 } },\n174:   },\n175: });\n176: \n177: /* ── the arithmetic: pure, exported, and what the test asserts ── */\n178: \n179: function fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n180: \n181: /** \"1:58.8\" -> 1188 tenths of a second; null when it is not a split the PM5 prints. */\n182: export function parseErgSplit(text: string): number | null {\n183:   const m = /^([1-9]):([0-5]\\d)\\.(\\d)$/.exec(text);\n184:   if (!m) return null;\n185:   return (Number(m[1]) * 60 + Number(m[2])) * 10 + Number(m[3]);\n186: }\n187: \n188: /**\n189:  * The marker's place on the 1:00-3:00 track, 0..1. A split at or under 1:00\n190:  * pins the marker at the start, at or over 3:00 at the end - the MARKER\n191:  * clamps, the printed split never changes.\n192:  */\n193: export function ergMarkerFrac(tenths: number): number {\n194:   if (tenths <= PACE_MIN_TENTHS) return 0;\n195:   if (tenths >= PACE_MAX_TENTHS) return 1;\n196:   return (tenths - PACE_MIN_TENTHS) / (PACE_MAX_TENTHS - PACE_MIN_TENTHS);\n197: }\n198: \n199: /** 1 -> \"1ST\", 2 -> \"2ND\", 3 -> \"3RD\", 4 -> \"4TH\", 11 -> \"11TH\", 50 -> \"50TH\". */\n200: export function ergOrdinal(n: number): string {\n201:   const t = n % 100;\n202:   const sfx = t >= 11 && t <= 13 ? \"TH\" : t % 10 === 1 ? \"ST\" : t % 10 === 2 ? \"ND\" : t % 10 === 3 ? \"RD\" : \"TH\";\n203:   return `${n}${sfx}`;\n204: }\n205: \n206: /**\n207:  * Printable ASCII plus the accented Latin letters (Latin-1 and Latin\n208:  * Extended-A, U+00C0-U+017F without the two maths signs) - the set the swim\n209:  * card proved the bundled font draws in both weights. Anything else is\n210:  * refused by name instead of rendering as tofu.\n211:  */\n212: const DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\n213: function text(value: unknown, field: string, min: number, max: number): string {\n214:   if (typeof value !== \"string\") fail(field, \"must be a string.\");\n215:   if (!DRAWN.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII and accented Latin letters (U+00C0-U+017F).`);\n216:   const s = value.trim();\n217:   if (s.length < min) fail(field, \"must not be blank.\");\n218:   if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n219:   return s;\n220: }\n221: \n222: export type ErgStat = { key: \"spm\" | \"watts\" | \"drag\"; label: string; value: number };\n223: \n224: export type NormalizedErgCard = {\n225:   rower: string;\n226:   note: string;\n227:   piece: string;\n228:   splitText: string;\n229:   /** Tenths of a second; the parse is exact integer math. */\n230:   splitTenths: number;\n231:   /** The marker's place on the track, 0..1, clamped for out-of-track splits. */\n232:   markerFrac: number;\n233:   /** True when the split sits outside 1:00-3:00 and the marker clamped. */\n234:   clamped: boolean;\n235:   result: string;\n236:   percentile: number;\n237:   chipText: string;\n238:   percentileCohort: string;\n239:   stats: ErgStat[];\n240:   footnote: string;\n241:   accent: MosaicColor;\n242:   preset: \"dark\" | \"light\";\n243:   debugLayout: boolean;\n244: };\n245: \n246: /** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n247: export function normalizeErgCard(props: ErgPbCardProps): NormalizedErgCard {\n248:   const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n249:   const rower = text(p.rower, \"rower\", 1, 40);\n250:   const note = text(p.note, \"note\", 0, 48);\n\n(Showing lines 1-250 of 723. Use offset=251 to continue.)\n</content>","metadata":{"preview":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag, wrapMeasured } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/sports/erg-pb-card/v1` - one indoor rower's piece as a share\n * card: the /500m split as the hero figure on a fixed 1:00-3:00 pace track,\n * the piece's time or metres second, stroke rate, watts and drag as cells,\n * and the season-ranking percentile as a chip - from PM5/Logbook numbers\n * every rower already has.\n *\n * ONE CONCEPT: the split is the hero. /500m pace is the unit the community\n * compares in - a \"5k 18:42,2\" is read as 1:52.4 - so the card's hierarchy\n * is the forum's own: split biggest, the piece's result second, the PM5's","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\erg-pb-card\\v1\\erg-pb-card.ts","text":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag, wrapMeasured } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/sports/erg-pb-card/v1` - one indoor rower's piece as a share\n * card: the /500m split as the hero figure on a fixed 1:00-3:00 pace track,\n * the piece's time or metres second, stroke rate, watts and drag as cells,\n * and the season-ranking percentile as a chip - from PM5/Logbook numbers\n * every rower already has.\n *\n * ONE CONCEPT: the split is the hero. /500m pace is the unit the community\n * compares in - a \"5k 18:42,2\" is read as 1:52.4 - so the card's hierarchy\n * is the forum's own: split biggest, the piece's result second, the PM5's\n * supporting numbers as cells, the percentile as a chip the rower supplies.\n *\n * The rule that bites: the template computes no claim it cannot verify. No\n * PB badge, no invented percentile (the ranking moves with season, age and\n * weight class), no cross-check between watts and split - the PM5 is\n * authoritative, every figure is entered, and the pace track is a FIXED\n * scale that claims nothing about ranking (the chip does that). A split\n * outside 1:00-3:00 clamps the MARKER to the track's end; the printed split\n * is always the truth.\n */\n\nexport type ErgPbCardProps = {\n  /** The rower's name, the header's bold line. Up to 40 characters; accented Latin letters are drawn. */\n  rower?: string;\n  /** Second header line (\"the 2026 season's median 2k\"); \"\" removes it. Up to 48 characters. */\n  note?: string;\n  /** The split as the PM5 prints it, \"m:ss.t\" from 1:00.0 to 9:59.9 (e.g. \"1:58.8\"). The hero figure AND the marker position. */\n  split?: string;\n  /** The piece's result - a time (\"7:55.0\", \"3:36:47\") or metres (\"7,096 m\"); \"\" removes the figure and its caption. Up to 14 characters. */\n  result?: string;\n  /** The caption under the result (\"2,000 m\", \"marathon\"); \"\" removes it. Up to 16 characters. */\n  piece?: string;\n  /** Stroke rate; 10-60, or 0 to hide the cell. */\n  spm?: number;\n  /** Watts; 20-600, or 0 to hide the cell. */\n  watts?: number;\n  /** Drag factor; 50-250, or 0 to hide the cell. */\n  drag?: number;\n  /** The season-ranking percentile the rower supplies, 1-99; 0 hides the chip and its cohort line. */\n  percentile?: number;\n  /** The dim line under the chip (\"2026 rower ranking\"); \"\" hides it. Up to 40 characters. */\n  percentileCohort?: string;\n  /** The marker, the chip and the rules, as #rrggbb. */\n  accent?: string;\n  /** Page and ink. */\n  preset?: \"dark\" | \"light\";\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/sports/erg-pb-card/v1\";\nexport const TITLE = \"Erg PB Card\";\nconst DEFAULT_ACCENT = \"#1c6fb8\";\n/** The page is document.backgroundColor, never a full-canvas rect (doctor: canvasFill). */\nconst THEMES = {\n  dark: { bg: \"#0c1a24\", ink: \"#eaf3f7\", dim: \"#7f95a1\" },\n  light: { bg: \"#f4f8fa\", ink: \"#0f2230\", dim: \"#4f6270\" },\n} as const;\n\n// An invented rower at the 2026 ranking's own median 2k: time 7:55.0 and the\n// 50th percentile are the cited ranking page's printed 50th band (10,198\n// ranked rowers); 1:58.8 is that time over 4; 209 W is 2.8 / (pace s/m)^3;\n// spm and drag are illustrative. The WHY says which is which.\nconst DEFAULTS = {\n  rower: \"Marcus Alder\",\n  note: \"the 2026 season's median 2k\",\n  split: \"1:58.8\",\n  result: \"7:55.0\",\n  piece: \"2,000 m\",\n  spm: 26,\n  watts: 209,\n  drag: 110,\n  percentile: 50,\n  percentileCohort: \"2026 rower ranking\",\n  accent: DEFAULT_ACCENT,\n  preset: \"dark\" as \"dark\" | \"light\",\n  debugLayout: false,\n};\n\n/** The pace track's fixed scale, in tenths of a second per 500m: 1:00 to 3:00. */\nexport const PACE_MIN_TENTHS = 600;\nexport const PACE_MAX_TENTHS = 1800;\n/** The five ticks, labeled, at equal quarters of the track. */\nexport const PACE_TICKS = [\"1:00\", \"1:30\", \"2:00\", \"2:30\", \"3:00\"] as const;\n\nconst propsSchema = definePropsSchema<ErgPbCardProps>({\n  split: {\n    type: \"string\",\n    required: false,\n    description: 'The /500m split as the PM5 prints it: \"m:ss.t\" from 1:00.0 to 9:59.9 (e.g. \"1:58.8\"). The card\\'s hero figure, and the marker on the 1:00-3:00 pace track. Only leaving it unset takes the sample split.',\n    meta: { control: { placeholder: DEFAULTS.split }, ui: { label: \"Split /500m\", order: 1, primary: true } },\n  },\n  result: {\n    type: \"string\",\n    required: false,\n    description: 'The piece\\'s result: a time (\"7:55.0\", \"3:36:47\") or metres (\"7,096 m\"). Empty removes the figure and its caption. Up to 14 characters.',\n    meta: { control: { placeholder: DEFAULTS.result }, ui: { label: \"Result\", order: 2 } },\n  },\n  piece: {\n    type: \"string\",\n    required: false,\n    description: 'The caption under the result: \"2,000 m\", \"1 hour\", \"marathon\". Empty removes it. Up to 16 characters.',\n    meta: { control: { placeholder: DEFAULTS.piece }, ui: { label: \"Piece\", order: 3 } },\n  },\n  rower: {\n    type: \"string\",\n    required: false,\n    description: \"The rower's name, the header's bold line. Up to 40 characters; accented Latin letters are drawn. The sample is an invented rower.\",\n    meta: { control: { placeholder: DEFAULTS.rower }, ui: { label: \"Rower\", order: 4 } },\n  },\n  note: {\n    type: \"string\",\n    required: false,\n    description: 'The second header line (the default names where the sample numbers came from). Empty removes it. Up to 48 characters.',\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"Note\", order: 5 } },\n  },\n  spm: {\n    type: \"number\",\n    required: false,\n    description: \"Stroke rate as the PM5 shows it. Integer 10-60; 0 hides the cell.\",\n    meta: { constraints: { min: 0, max: 60 }, control: { placeholder: String(DEFAULTS.spm) }, ui: { label: \"SPM\", order: 6 } },\n  },\n  watts: {\n    type: \"number\",\n    required: false,\n    description: \"Watts as the PM5 shows it - entered, not computed from the split. Integer 20-600; 0 hides the cell.\",\n    meta: { constraints: { min: 0, max: 600 }, control: { placeholder: String(DEFAULTS.watts) }, ui: { label: \"Watts\", order: 7 } },\n  },\n  drag: {\n    type: \"number\",\n    required: false,\n    description: \"Drag factor as the PM5 shows it. Integer 50-250; 0 hides the cell.\",\n    meta: { constraints: { min: 0, max: 250 }, control: { placeholder: String(DEFAULTS.drag) }, ui: { label: \"Drag\", order: 8 } },\n  },\n  percentile: {\n    type: \"number\",\n    required: false,\n    description: \"The season-ranking percentile as a chip the rower supplies (the ranking page prints the bands; they move with season, age and weight class, so the card computes none). Integer 1-99; 0 hides the chip and its cohort line.\",\n    meta: { constraints: { min: 0, max: 99 }, control: { placeholder: String(DEFAULTS.percentile) }, ui: { label: \"Percentile\", order: 9 } },\n  },\n  percentileCohort: {\n    type: \"string\",\n    required: false,\n    description: 'The dim line under the chip naming the cohort: \"2026 rower ranking\". Empty hides the line. Up to 40 characters.',\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"Ranking cohort\", order: 10 } },\n  },\n  accent: {\n    type: \"string\",\n    required: false,\n    description: \"The marker, the chip and the rules, as #rrggbb (the club or crew colour).\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 11 } },\n  },\n  preset: {\n    type: \"string\",\n    required: false,\n    description: 'Page and ink: \"dark\" (default) or \"light\".',\n    meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 12 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits its box, the marker is on the track, the ticks are one size) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n/* ── the arithmetic: pure, exported, and what the test asserts ── */\n\nfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n\n/** \"1:58.8\" -> 1188 tenths of a second; null when it is not a split the PM5 prints. */\nexport function parseErgSplit(text: string): number | null {\n  const m = /^([1-9]):([0-5]\\d)\\.(\\d)$/.exec(text);\n  if (!m) return null;\n  return (Number(m[1]) * 60 + Number(m[2])) * 10 + Number(m[3]);\n}\n\n/**\n * The marker's place on the 1:00-3:00 track, 0..1. A split at or under 1:00\n * pins the marker at the start, at or over 3:00 at the end - the MARKER\n * clamps, the printed split never changes.\n */\nexport function ergMarkerFrac(tenths: number): number {\n  if (tenths <= PACE_MIN_TENTHS) return 0;\n  if (tenths >= PACE_MAX_TENTHS) return 1;\n  return (tenths - PACE_MIN_TENTHS) / (PACE_MAX_TENTHS - PACE_MIN_TENTHS);\n}\n\n/** 1 -> \"1ST\", 2 -> \"2ND\", 3 -> \"3RD\", 4 -> \"4TH\", 11 -> \"11TH\", 50 -> \"50TH\". */\nexport function ergOrdinal(n: number): string {\n  const t = n % 100;\n  const sfx = t >= 11 && t <= 13 ? \"TH\" : t % 10 === 1 ? \"ST\" : t % 10 === 2 ? \"ND\" : t % 10 === 3 ? \"RD\" : \"TH\";\n  return `${n}${sfx}`;\n}\n\n/**\n * Printable ASCII plus the accented Latin letters (Latin-1 and Latin\n * Extended-A, U+00C0-U+017F without the two maths signs) - the set the swim\n * card proved the bundled font draws in both weights. Anything else is\n * refused by name instead of rendering as tofu.\n */\nconst DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\nfunction text(value: unknown, field: string, min: number, max: number): string {\n  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n  if (!DRAWN.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII and accented Latin letters (U+00C0-U+017F).`);\n  const s = value.trim();\n  if (s.length < min) fail(field, \"must not be blank.\");\n  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n  return s;\n}\n\nexport type ErgStat = { key: \"spm\" | \"watts\" | \"drag\"; label: string; value: number };\n\nexport type NormalizedErgCard = {\n  rower: string;\n  note: string;\n  piece: string;\n  splitText: string;\n  /** Tenths of a second; the parse is exact integer math. */\n  splitTenths: number;\n  /** The marker's place on the track, 0..1, clamped for out-of-track splits. */\n  markerFrac: number;\n  /** True when the split sits outside 1:00-3:00 and the marker clamped. */\n  clamped: boolean;\n  result: string;\n  percentile: number;\n  chipText: string;\n  percentileCohort: string;\n  stats: ErgStat[];\n  footnote: string;\n  accent: MosaicColor;\n  preset: \"dark\" | \"light\";\n  debugLayout: boolean;\n};\n\n/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\nexport function normalizeErgCard(props: ErgPbCardProps): NormalizedErgCard {\n  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n  const rower = text(p.rower, \"rower\", 1, 40);\n  const note = text(p.note, \"note\", 0, 48);","lineStart":1,"lineEnd":250,"totalLines":723,"truncated":true}},"title":"src\\sports\\erg-pb-card\\v1\\erg-pb-card.ts","time":{"start":1792416104230,"end":1792416104244}},"metadata":{"openai":{"itemId":"fc_c6c2e395-3ee1-95c4-951c-84c6c2b896ae_1"}},"id":"prt_154533f1e001OgoCQngrSg5Fgb","sessionID":"ses_eabad0e61ffeMfJmuPCNFqL7sc","messageID":"msg_15453321e001WhJkNB1kpM7t6J"}}
