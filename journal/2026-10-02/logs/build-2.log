or 1 personal best time. */\n49\t  sector1Pb?: string;\n50\t  /** Sector 2 personal best time. */\n51\t  sector2Pb?: string;\n52\t  /** Sector 3 personal best time. */\n53\t  sector3Pb?: string;\n54\t  /** Driver name or callsign. */\n55\t  driverId?: string;\n56\t  /** Top speed in km/h. */\n57\t  topSpeed?: string;\n58\t  /** Dev-only: check the layout contract and draw it over the card. */\n59\t  debugLayout?: boolean;\n60\t};\n61\t\n62\tconst ID = \"@one-a-day/sports/lap-telemetry-card/v1\";\n63\tconst INK = \"#eaeef2\" as MosaicColor;\n64\tconst DIM = \"#9aa7b4\" as MosaicColor;\n65\tconst GREEN = \"#2ecc71\" as MosaicColor;\n66\tconst RED = \"#e74c3c\" as MosaicColor;\n67\tconst PAGE = \"#1c2833\" as MosaicColor;\n68\t\n69\tconst DEFAULTS = {\n70\t  trackName: \"Nurburgring\",\n71\t  lapTime: \"7:45.123\",\n72\t  pbTime: \"7:42.456\",\n73\t  sector1Time: \"2:30.123\",\n74\t  sector2Time: \"2:45.234\",\n75\t  sector3Time: \"2:29.766\",\n76\t  sector1Pb: \"2:29.456\",\n77\t  sector2Pb: \"2:44.123\",\n78\t  sector3Pb: \"2:29.123\",\n79\t  driverId: \"Driver\",\n80\t  topSpeed: \"285\",\n81\t};\n82\t\n83\tconst propsSchema = definePropsSchema<LapTelemetryCardProps>({\n84\t  trackName: {\n85\t    type: \"string\",\n86\t    required: false,\n87\t    description: \"The track or circuit name, up to 40 characters.\",\n88\t    meta: { control: { placeholder: DEFAULTS.trackName }, ui: { label: \"Track\", order: 1 } },\n89\t  },\n90\t  lapTime: {\n91\t    type: \"string\",\n92\t    required: false,\n93\t    description: \"Lap time in M:SS.sss or SS.sss format.\",\n94\t    meta: { control: { placeholder: DEFAULTS.lapTime }, ui: { label: \"Lap time\", order: 2 } },\n95\t  },\n96\t  pbTime: {\n97\t    type: \"string\",\n98\t    required: false,\n99\t    description: \"Personal best lap time.\",\n100\t    meta: { control: { placeholder: DEFAULTS.pbTime }, ui: { label: \"PB time\", order: 3 } },\n101\t  },\n102\t  sector1Time: {\n103\t    type: \"string\",\n104\t    required: 