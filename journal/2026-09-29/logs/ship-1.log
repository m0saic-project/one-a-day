"One a Day\",","+    \"templates\": 12","+  },","+  \"mode\": \"gate\",","+  \"loadDiagnostics\": [],","+  \"rendered\": 12,","+  \"skipped\": [],","+  \"errors\": [],","+  \"warnings\": [","+    {","+      \"templateId\": \"@one-a-day/social/episode-audiogram/v1\",","+      \"convention\": \"bindingsCover\",","+      \"severity\": \"warning\",","+      \"violations\": [","+        {","+          \"key\": \"clipSec\",","+          \"detail\": \"\\\"clipSec\\\" (default 30, drawn as \\\"30\\\") is drawn as text but no source binds it — wrap the source that shows it: bindProp(src, \\\"clipSec\\\").\"","+        }","+      ],","+      \"fix\": \"a prop drawn as text should be bound to the rect that shows it (bindProp(src, \\\"<key>\\\")) so Make's double-click edits it in place. Bind the rect that SHOWS the prop, even when its value is empty.\"","+    },","+    {","+      \"templateId\": \"@one-a-day/events/talk-timer/v1\",","+      \"convention\": \"bindingsCover\",","+      \"severity\": \"warning\",","+      \"violations\": [","+        {","+          \"key\": \"finalSec\",","+          \"detail\": \"\\\"finalSec\\\" (default 30, drawn as \\\"30\\\") is drawn as text but no source binds it — wrap the source that shows it: bindProp(src, \\\"finalSec\\\").\"","+        }","+      ],","+      \"fix\": \"a prop drawn as text should be bound to the rect that shows it (bindProp(src, \\\"<key>\\\")) so Make's double-click edits it in place. Bind the rect that SHOWS the prop, even when its value is empty.\"","+    },","+    {","+      \"templateId\": \"@one-a-day/gaming/speedrun-pb-recap/v1\",","+      \"convention\": \"bindingsCover\",","+      \"severity\": \"warning\",","+      \"violations\": [","+        {","+          \"key\": \"clipSec\",","+          \"detail\": \"\\\"clipSec\\\" (default 20, drawn as \\\"20\\\") is drawn as text but no source binds it — wrap the source that shows it: bindProp(src, \\\"clipSec\\\").\"","+        }","+      ],","+      \"fix\": \"a prop drawn as text should be bound to the rect that shows it (bindProp(src, \\\"<key>\\\")) so Make's double-click edits it in place. Bind the rect that SHOWS the prop, even when its value is empty.\"","+    },","+    {","+      \"templateId\": \"@one-a-day/sports/powerlifting-meet-recap/v1\",","+      \"convention\": \"bindingsCover\",","+      \"severity\": \"warning\",","+      \"violations\": [","+        {","+          \"key\": \"clipSec\",","+          \"detail\": \"\\\"clipSec\\\" (default 12, drawn as \\\"12\\\") is drawn as text, but every rect that shows it already binds \\\"details\\\" — a composite line. Add this prop to that rect: bindProps(src, [… , { propKey: \\\"clipSec\\\" }]), or split the line so each prop has its own rect.\"","+        }","+      ],","+      \"fix\": \"a prop drawn as text should be bound to the rect that shows it (bindProp(src, \\\"<key>\\\")) so Make's double-click edits it in place. Bind the rect that SHOWS the prop, even when its value is empty.\"","+    }","+  ],","+  \"lagging\": [","+    {","+      \"templateId\": \"@one-a-day/harness/agent-timeline/v1\",","+      \"convention\": \"bindingsDeclared\",","+      \"severity\": \"error\",","+      \"violations\": [","+        {","+          \"key\": \"phases\",","+          \"detail\": \"\\\"phases\\\" can carry a leaf handle but nothing binds it — bind the rect that shows it (bindProp(src, \\\"phases\\\")), or declare why it has none: bindings.unbound = { \\\"phases\\\": \\\"<reason>\\\" }.\"","+        },","+        {","+          \"key\": \"accent\",","+          \"detail\": \"\\\"accent\\\" can carry a color handle but nothing binds it — bind the rect that shows it (bindProp(src, \\\"accent\\\")), or declare why it has none: bindings.unbound = { \\\"accent\\\": \\\"<reason>\\\" }.\"","+        }","+      ],","+      \"fix\": \"every prop that CAN carry a canvas handle is either bound on the rect that shows it (bindProp / bindProps / bindPropPath / bindPropRect) or named in 