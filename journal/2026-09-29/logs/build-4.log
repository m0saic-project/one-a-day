, { bold: true, color: DIM });\n528\t    const idW = Math.max(...p.themes.map((u) => widthOf(idText(u), px)));\n529\t    p.themes.forEach((t, i) => {\n530\t      const col = Math.floor(i / perCol), row = i % perCol;\n531\t      const cx = x + col * (colW + colGap);\n532\t      const ry = y + blockH(hp, 1) + Math.round(px * 0.35) + row * pitch;\n533\t      const sw = Math.round(px * 0.75);\n534\t      const swatch = rect(cx, ry + (pitch - sw) / 2, sw, sw);\n535\t      const idX = cx + sw + Math.round(px * 0.5);\n536\t      const idBox: CrosswordTextBox = { label: `theme-id-${i}`, rect: rect(idX, ry, Math.ceil((idW + 3) / 0.94) + 1, pitch), text: t.id, px, width: widthOf(t.id, px), bold: false, color: DIM, hAlign: \"left\", vAlign: \"middle\", bind: \"themeEntries\", token: p.themeSpans[i] };\n537\t      const ansX = idX + idW + Math.round(px * 0.6);\n538\t      const ansBox: CrosswordTextBox = { label: `theme-${i}`, rect: rect(ansX, ry, cx + colW - ansX, pitch), text: t.answer, px, width: widthOf(t.answer, px, true), bold: true, color: INK, hAlign: \"left\", vAlign: \"middle\" };\n539\t      texts.push(idBox, ansBox);\n540\t      themeLines.push({ swatch, id: idBox, answer: ansBox });\n541\t    });\n542\t    return total;\n543\t  };\n544\t\n545\t  let board: CrosswordBoard;\n546\t  let panel: CrosswordRect;\n547\t  if (mode === \"landscape\") {\n548\t    const s = boardSizing(cols, rows, Math.min(H - 2 * margin, (W - 2 * margin - gutter) * 0.6), H - 2 * margin);\n549\t    board = boardAt(cols, rows, s, margin, (H - s.inkH) / 2);\n550\t    const px0 = board.ink.x + board.ink.w + gutter;\n551\t    const top = Math.min(board.ink.y, margin + (H - 2 * margin) * 0.04), bottom = H - top;\n552\t    panel = rect(px0, top, W - margin - px0, bottom - top);\n553\t    const w = panel.w, x = panel.x;\n554\t    const t = place(\"title\", p.title, x, panel.y, w, panel.h * 0.3, S * 0.075, titleFloor, [2], { bold: true, vAlign: \"top\", bind: \"title\" });\n555\t    const bP = bylineFit(w, panel.h * 0.12, S * 0.036);\n556\t    const by = t.rect.y + t.rect.h + Math.round(S * 0.008);\n557\t    byline(bP, x, by, w);\n558\t    const mP = metaFit(w, panel.h * 0.1, S * 0.028);\n559\t    const metaH = mP.height;\n560\t    meta(mP, x, panel.y + panel.h - metaH);\n561\t    // The list sits centred in the space between the title block and the caption line.\n562\t    const free0 = by + bP.height + gutter / 2, free1 = panel.y + panel.h - metaH - gutter / 2;\n563\t    const listH = themeBlock(x, free0, w, free1 - free0, S * 0.038, 1, true);\n564\t    themeBlock(x, free0 + Math.max(0, (free1 - free0 - listH) / 2), w, free1 - free0, S * 0.038, 1, false);\n565\t  } else if (mode === \"portrait\") {\n566\t    const s = boardSizing(cols, rows, W - 2 * margin, (H - 2 * margin - 2 * gutter) * 0.6);\n567\t    const rest = H - 2 * margin - 2 * gutter - s.inkH;\n568\t    const headH = Math.round(rest * 0.36);\n569\t    board = boardAt(cols, rows, s, (W - s.inkW) / 2, margin + headH + gutter);\n570\t    panel = rect(margin, margin, W - 2 * margin, H - 2 * margin);\n571\t    const x = margin, w = W - 2 * margin;\n572\t    // Header: title + byline, centred in the band above the board.\n573\t    const tf = fit(p.title, w, headH * 0.66, S * 0.085, titleFloor, [2], true);\n574\t    const bP = bylineFit(w, headH * 0.3, S * 0.04);\n575\t    const gap = Math.round(S * 0.012);\n576\t    const headUsed = blockH(tf.px, tf.lines.length) + gap + bP.height;\n577\t    const hy = margin + Math.max(0, (headH - headUsed) / 2);\n578\t    const t = place(\"title\", p.title, x, hy, w, headH * 0.66, S * 0.085, titleFloor, [2], { bold: true, bind: \"title\" });\n579\t    byline(bP, x, t.rect.y + t.rect.h + gap, w);\n580\t    // Footer: the list centred in the band under the board, the caption line at the bottom.\n581\t    const footY = board.ink.y + board.ink.h + gutter, footB = H - margin;\n582\t    const mP = metaFit(w, (footB - footY) * 0.2, S * 0.032);\n583\t    const metaH = mP.height;\n584\t    meta(mP, x, footB - metaH);\n585\t    const free1 = footB - metaH - gutter / 2;\n586\t    const listH = themeBlock(x, footY, w, free1 - footY, S * 0.042, 1, true);\n587\t    themeBlock(x, footY + Math.max(0, (free1 - footY - listH) / 2), w, free1 - footY, S * 0.042, 1, false);\n588\t  } else {\n589\t    // The column split follows the PROP, not solved: the teaser keeps the solved card's geometry (\"nothing else moves\").\n590\t    const leftW = (W - 2 * margin) * (p.themes.length > 0 ? 0.54 : 1);\n591\t    // A title too long for one line at S/20 wraps to two, and the board gives up that second line's height.\n592\t    const tp = Math.ceil(S / 20);\n593\t    const twoLines = wrap(p.title, tp, budget(leftW), true).length > 1;\n594\t    const s = boardSizing(cols, rows, W - 2 * margin, H * 0.72 - (twoLines ? blockH(tp, 2) - blockH(tp, 1) : 0));\n595\t    board = boardAt(cols, rows, s, (W - s.inkW) / 2, margin);\n596\t    const y0 = board.ink.y + board.ink.h + gutter;\n597\t    panel = rect(margin, y0, W - 2 * margin, H - margin - y0);\n598\t    const x = panel.x;\n599\t    const mP = metaFit(leftW, panel.h * 0.3, S * 0.022);\n600\t    const metaH = mP.height;\n601\t    const bP = bylineFit(leftW, panel.h * 0.3, S * 0.028);\n602\t    const bylineH = bP.height;\n603\t    const gap = Math.round(S * 0.006);\n604\t    const titleMax = panel.h - metaH - bylineH - 2 * gap;\n605\t    const t = place(\"title\", p.title, x, panel.y, leftW, titleMax, S * 0.058, titleFloor, [2], { bold: true, vAlign: \"top\", bind: \"title\" });\n606\t    byline(bP, x, t.rect.y + t.rect.h + gap, leftW);\n607\t    meta(mP, x, panel.y + panel.h - metaH);\n608\t    if (showThemes) {\n609\t      const rx = panel.x + panel.w * 0.58, rw = panel.x + panel.w - rx;\n610\t      themeBlock(rx, panel.y, rw, panel.h, S * 0.03, p.themes.length > 4 ? 2 : 1, false);\n611\t    }\n612\t  }\n613\t  return { mode, margin, gutter, board, panel, texts, themeLines };\n614\t}\n615\t\n616\t// -----------------