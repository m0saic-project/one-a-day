   },\n    \"plan\": {\n      \"calls\": 1,\n      \"lastExitCode\": 0,\n      \"timedOut\": false,\n      \"ms\": 121512,\n      \"done\": true\n    },\n    \"build\": {\n      \"calls\": 1,\n      \"lastExitCode\": 0,\n      \"timedOut\": false,\n      \"ms\": 2248619,\n      \"done\": true\n    },\n    \"critique\": {\n      \"calls\": 1,\n      \"lastExitCode\": 1,\n      \"timedOut\": false,\n      \"ms\": 73308,\n      \"done\": false\n    }\n  },\n  \"result\": {\n    \"status\": \"no-ship\",\n    \"templateId\": null,\n    \"reason\": \"scout phase did not complete\"\n  },\n  \"gate\": {\n    \"reasons\": [],\n    \"at\": \"2026-10-20T13:16:22.432Z\"\n  }\n}","lineStart":1,"lineEnd":68,"totalLines":68,"truncated":false}},"title":"journal\\2026-10-20\\run.json","time":{"start":1792530903296,"end":1792530903327}},"id":"prt_15b2af034001WART4PP41ypyU0","sessionID":"ses_ea4d52decffeaHsc6A3RWeHtGB","messageID":"msg_15b2ad446001UTc7NWns5dByhC"}}
