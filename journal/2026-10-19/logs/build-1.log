ons, order-matched, within\n230:      * `centerTolerancePx`. Built for axis ticks that must sit exactly where\n231:      * computed geometry places a feature the contract CANNOT measure (a\n232:      * mask-drawn data point): the tick is a real rect, so its center is the\n233:      * proxy guarantee for the whole alignment.\n234:      */\n235:     xCenters?: number[];\n236:     /** As `xCenters`, for y (boxes sorted by y). */\n237:     yCenters?: number[];\n238:     /** Absolute px tolerance for xCenters/yCenters. Default 4. */\n239:     centerTolerancePx?: number;\n240:     /**\n241:      * GROUP-RELATIVE position lock: centers as fractions of the label group's\n242:      * own center-span (first center → 0, last center → 1), boxes sorted by x.\n243:      * MODEL-FREE — no canvas-space origin needed, so it is immune to the\n244:      * card/rail chain's quantization drift that makes absolute xCenters\n245:      * unmodelable from inside a template. Catches any element displaced\n246:      * WITHIN the group (uniform whole-group shifts are structural when the\n247:      * group shares its offset weights with the feature it proxies).\n248:      */\n249:     xCentersFrac?: number[];\n250:     /** As `xCentersFrac`, for y. */\n251:     yCentersFrac?: number[];\n252:     /** Tolerance for the frac variants, as a fraction of the span. Default 0.015. */\n253:     centerToleranceFrac?: number;\n254:     /**\n255:      * TEXT-FIT lock: the tagged TEXT source's literal string, at its authored\n256:      * fontSize, must fit its box — estimated as longestLine × fontSize ×\n257:      * `charWidthEm` (default 0.72, a CONSERVATIVE em-width modeling the CLI\n258:      * rasterizer, which sets wider than the app; the whole point is to make\n259:      * Make flag what would only break in the render). Non-text / expr-content\n260:      * sources are skipped (nothing static to measure).\n261:      */\n262:     textFits?: {\n263:         charWidthEm?: number;\n264:         padPx?: number;\n265:     };\n266: };\n267: /**\n268:  * A RELATIONAL invariant — compares a SET of labeled nodes (the image-collage's\n269:  * \"uniform thumbnails\" / \"consistent gutters\"). The set is the union of frames\n270:  * tagged with `label` (a single label's many nodes, or several labels combined).\n271:  */\n272: export type RelationalConstraint = {\n273:     /** The node set: frames tagged with this label, or any of these labels. */\n274:     label: string | string[];\n275:     /** All nodes share this metric within `tolerance` (or `tolerancePx`). `\"size\"` = width AND height. */\n276:     equal?: \"width\" | \"height\" | \"aspect\" | \"size\";\n277:     /** Tolerance for `equal` (relative — fraction of the metric). Default `0.02`. */\n278:     tolerance?: number;\n279:     /** Absolute escape for `equal` (px): also pass when the raw spread is within\n280:      *  this many pixels — the engine's equal split guarantees ±1px, which can\n281:      *  exceed any sane fraction at tiny paint sizes. Not applied to `aspect`. */\n282:     tolerancePx?: number;\n283:     /**\n284:      * Uniform gaps between nodes along an axis (nodes sorted by that axis).\n285:      * 1-D — correct for a single row/column of nodes; for a 2-D packed layout\n286:      * use `lattice` instead (sorting a grid's boxes along one axis produces\n287:      * negative \"gaps\" across rows).\n288:      */\n289:     gutter?: {\n290:         axis: \"x\" | \"y\";\n291:         /** Target gap as a fraction of the canvas axis. Omit → just assert uniformity. */\n292:         target?: number;\n293:         /** Tolerance as a canvas fraction. Default `0.01`. */\n294:         tolerance?: number;\n295:     };\n296:     /**\n297:      * 2-D lattice gutters: every box's gap to its nearest neighbor per axis\n298:      * (in PIXELS — the gutter is authored in px and the tolerance is the\n299:      * engine's absolute floor-error bound). The image-collage's \"consistent\n300:      * gutters everywhere\" invariant.\n301:      */\n302:     lattice?: LatticeGutterSpec;\n303:     /**\n304:      * Null-space accounting: the labeled boxes' painted area vs the canvas\n305:      * (`1 − painted/canvas` must match the planned unpainted fraction). The\n306:      * image-collage's \"gutters + margins are the ONLY empty space\" invariant.\n307:      * Meaningful from a single node (a one-image sheet), unlike the pairwise\n308:      * relations.\n309:      */\n310:     coverage?: CoverageSpec;\n311: };\n312: export type LayoutResolution = {\n313:     stableKey: string;\n314:     sourceIndex: number;\n315:     rect: {\n316:         x: number;\n317:         y: number;\n318:         w: number;\n319:         h: number;\n\n(Showing lines 200-319 of 349. Use offset=320 to continue.)\n</content>","metadata":{"preview":"            kind?: \"string\" | \"number\" | \"color\" | \"rect\" | \"media\";\n            onClear?: PropBindingClearAction;\n            seedDraft?: string;\n        };\n    };\n}>(src: T, propKey: string, path: ReadonlyArray<string | number>, kind: \"string\" | \"number\" | \"color\" | \"media\", opts?: {\n    onClear?: PropBindingClearAction;\n    seedDraft?: string;\n}): T;\nexport type LayoutConstraint = {\n    /** The source tag to constrain (`sources[i].editor.label`). May hit MANY frames. */\n    label: string;\n    /** Realized aspect ratio (w/h) within `aspectTolerance`. */\n    aspect?: number;\n    /** Tolerance for `aspect`. Default `0.02`. */\n    aspectTolerance?: number;\n    /** Realized width as a fraction of canvas width (`w / canvasW`). */\n    minWidthFrac?: number;\n    maxWidthFrac?: number;\n    /** Realized height as a fraction of canvas height (`h / canvasH`). */","truncated":true,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\node_modules\\@m0saic\\template-utils\\dist\\geometry-contract\\layoutConstraint.d.ts","text":"            kind?: \"string\" | \"number\" | \"color\" | \"rect\" | \"media\";\n            onCl