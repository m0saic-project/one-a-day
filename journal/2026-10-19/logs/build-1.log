 ],\n38:     editor: { owner: \"template\", label: opts.label },\n39:   } as MosaicSource;\n40: }\n41: \n42: /** Measured width of one block, in the weight that will be drawn. */\n43: export function widthOf(text: string, fontSize: number, bold = false): number {\n44:   const fontPath = bold ? resolveFontFile({ weight: \"bold\" })?.path : undefined;\n45:   return measureText(text, { fontSize, ...(fontPath ? { fontPath } : {}) }).width;\n46: }\n47: \n48: /** Shrink one line until it fits `maxW` (never wraps); returns the size. */\n49: export function fitLine(text: string, maxW: number, maxPx: number, minPx: number, bold = false): number {\n50:   let px = Math.round(maxPx);\n51:   while (px > minPx && widthOf(text, px, bold) > maxW) px = Math.max(minPx, Math.round(px * 0.92));\n52:   return px;\n53: }\n54: \n55: /**\n56:  * Word-wrap that also survives a token wider than the box (a URL, a long\n57:  * flag): `wrapMeasured` never breaks a word, so such a token would run off\n58:  * the edge. Over-long tokens are chunked by character to `chunkW` first.\n59:  */\n60: export function wrapFit(text: string, fontSize: number, maxW: number, chunkW = maxW): string[] {\n61:   const width = (t: string) => measureText(t, { fontSize }).width;\n62:   const words = text.split(\" \").filter((w) => w.length > 0).flatMap((w) => {\n63:     if (width(w) <= chunkW) return [w];\n64:     const chunks: string[] = [];\n65:     let cur = \"\";\n66:     for (const ch of w) {\n67:       if (cur.length > 0 && width(cur + ch) > chunkW) { chunks.push(cur); cur = ch; } else cur += ch;\n68:     }\n69:     if (cur.length > 0) chunks.push(cur);\n70:     return chunks;\n71:   });\n72:   return wrapMeasured(words.join(\" \"), fontSize, maxW);\n73: }\n74: \n75: /** Cut `text` to fit `maxW` at `fontSize` with a trailing \"...\" - the last resort after shrinking. */\n76: export function ellipsize(text: string, fontSize: number, maxW: number, bold = false): string {\n77:   if (widthOf(text, fontSize, bold) <= maxW) return text;\n78:   let t = text;\n79:   while (t.length > 1 && widthOf(t + \"...\", fontSize, bold) > maxW) t = t.slice(0, -1);\n80:   return t.trimEnd() + \"...\";\n81: }\n\n(End of file - total 81 lines)\n</content>","metadata":{"preview":"import type { MosaicColor, MosaicSource } from \"@m0saic/types\";\nimport { measureText, resolveFontFile, wrapMeasured } from \"@m0saic/template-utils\";\n\n/**\n * The text kit the shared pages and harness cards draw with: svg-rasterized\n * cells (the bundled deterministic font, no drawtext), measured fits, and a\n * word-wrap that survives a token wider than its box. Templates written by\n * the daily agent usually carry their own fitter (the og-card measures bold\n * against the bold file); this kit is for the repo's own chrome.\n */\n\n/** The fit budget inside a cell: `cell * 0.94 - 2px` (the layout contract's rule). */\nexport function budget(cellW: number): number {\n  return Math.max(8, Math.floor(cellW * 0.94 - 2));\n}\n\n/** One svg-rasterized text cell, aligned inside its rect. */\nexport function textCell(opts: {\n  text: string;\n  fontSize: number;","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\src\\_shared\\text.ts","text":"import type { MosaicColor, MosaicSource } from \"@m0saic/types\";\nimport { measureText, resolveFontFile, wrapMeasured } from \"@m0saic/template-utils\";\n\n/**\n * The text kit the shared pages and harness cards draw with: svg-rasterized\n * cells (the bundled deterministic font, no drawtext), measured fits, and a\n * word-wrap that survives a token wider than its box. Templates written by\n * the daily agent usually carry their own fitter (the og-card measures bold\n * against the bold file); this kit is for the repo's own chrome.\n */\n\n/** The fit budget inside a cell: `cell * 0.94 - 2px` (the layout contract's rule). */\nexport function budget(cellW: number): number {\n  return Math.max(8, Math.floor(cellW * 0.94 - 2));\n}\n\n/** One svg-rasterized text cell, aligned inside its rect. */\nexport function textCell(opts: {\n  text: string;\n  fontSize: number;\n  color: MosaicColor;\n  hAlign: \"left\" | \"right\" | \"center\";\n  bold?: boolean;\n  vAlign?: \"top\" | \"middle\" | \"bottom\";\n  label: string;\n}): MosaicSource {\n  return {\n    type: \"text\",\n    rasterizer: \"svg\",\n    renderMode: { kind: \"image\" },\n    layers: [\n      {\n        content: { kind: \"literal\", text: opts.text },\n        style: { fontSize: opts.fontSize, fontColor: opts.color, ...(opts.bold ? { fontWeight: \"bold\" } : {}) },\n        placement: { hAlign: opts.hAlign, vAlign: opts.vAlign ?? \"middle\" },\n      },\n    ],\n    editor: { owner: \"template\", label: opts.label },\n  } as MosaicSource;\n}\n\n/** Measured width of one block, in the weight that will be drawn. */\nexport function widthOf(text: string, fontSize: number, bold = false): number {\n  const fontPath = bold ? resolveFontFile({ weight: \"bold\" })?.path : undefined;\n  return measureText(text, { fontSize, ...(fontPath ? { fontPath } : {}) }).width;\n}\n\n/** Shrink one line until it fits `maxW` (never wraps); returns the size. */\nexport function fitLine(text: string, maxW: number, maxPx: number, minPx: number, bold = false): number {\n  let px = Math.round(maxPx);\n  while (px > minPx && widthOf(text, px, bold) > maxW) px = Math.max(minPx, Math.round(px * 0.92));\n  return px;\n}\n\n/**\n * Word-wrap that also survives a token wider than the box (a URL, a long\n * flag): `wrapMeasured` never breaks a word, so such a token would run off\n * the edge. Over-long tokens are chunked by character to `chunkW` first.\n */\nexport function wrapFit(text: string, fontSize: number, maxW: number, chunkW = maxW): string[] {\n  const width = (t: string) => measureText(t, { fontSize }).width;\n  const words = text.split(\" \").filter((w) => w.length > 0).flatMap((w) => {\n    if (width(w) <= chunkW) return [w];\n    const chunks: string[] = [];\n    let cur = \"\";\n    for (const ch of w) {\n      if (cur.length > 0 && width(cur + ch) > chunkW) { chunks.push(cur); cur = ch; } else cur += ch;\n    }\n    if (cur.length > 0) chunks.push(cur);\n    return chunks;\n  });\n  return wrapMeasured(words.join(\" \"), fontSize, maxW);\n}\n\n/** Cut `text` to fit `maxW` at `fontSize` with a trailing \"...\" - the last resort after shrinking. */\nexport function ellipsize(text: string, fontSize: number, maxW: number, bold = false): string {\n  if (widthOf(text, fontSize, bold) <= maxW) return text;\n  let t = text;\n  while (t.length > 1 && widthOf(t + \"...\", fontSize, bold) > maxW) t = t.slice(0, -1);\n  return t.trimEnd() + \"...\";\n}","lineStart":1,"lineEnd":81,"totalLines":81,"truncated":false}},"title":"src\\_shared\\text.ts","time":{"start":1792416110767,"end":1792416110858}},"metadata":{"openai":{"itemId":"fc_67b966a1-2988-9f8c-878e-43ad8e9135ad_2"}},"id":"prt_1545358ab001RsDR2jGAmRHFMT","sessionID":"ses_eabad0e61ffeMfJmuPCNFqL7sc","messageID":"msg_1545342ed001wifssncB8fiwF4"}}
