\",\n75:       playoffResult: \"none\",\n76:       awards: [],\n77:       districtPoints: 0,\n78:     } as const;\n79:     for (const over of [{}, stressed, emptied]) {\n80:       await sweepLayout(\n81:         (p, ctx) => FrcEventRecapV1.render(p, ctx).then(asDocument),\n82:         \"@one-a-day/sports/frc-event-recap/v1\",\n83:         { ...FrcEventRecapV1.defaultProps, ...over },\n84:         (w, h) => targetCtx(w, h),\n85:       );\n86:     }\n87:     expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n88:   });\n89: \n90:   it(\"shows the scout's cited TBA page as a finished card at defaults\", async () => {\n91:     const texts = textsOf(await render());\n92:     for (const t of [\"FRC EVENT RECAP\", \"TEAM 9128\", \"Harbor City District\", \" - Week 4\", \"RANK 1\", \"of 48 teams\", \"17-0-0\", \"W - L - T\", \"CAPTAIN - ALLIANCE 1\", \"EVENT WINNER\", \"AWARDS\", \"Innovation in Control Award\", \"78 DISTRICT POINTS\", \"DATA: THE BLUE ALLIANCE\"]) {\n93:       expect(texts).toContain(t);\n94:     }\n95:   });\n96: \n97:   it(\"derives the TBA-vocabulary copy\", () => {\n98:     expect(allianceChipText(\"captain\", 1)).toBe(\"CAPTAIN - ALLIANCE 1\");\n99:     expect(allianceChipText(\"pick1\", 4)).toBe(\"1ST PICK - ALLIANCE 4\");\n100:     expect(allianceChipText(\"pick2\", 8)).toBe(\"2ND PICK - ALLIANCE 8\");\n101:     expect(allianceChipText(\"none\", 1)).toBe(\"\");\n102:     expect(playoffChipText(\"winner\")).toBe(\"EVENT WINNER\");\n103:     expect(playoffChipText(\"finalist\")).toBe(\"FINALIST\");\n104:     expect(playoffChipText(\"semifinalist\")).toBe(\"SEMIFINALIST\");\n105:     expect(playoffChipText(\"quarterfinalist\")).toBe(\"QUARTERFINALIST\");\n106:     expect(playoffChipText(\"none\")).toBe(\"\");\n107:     expect(recordText(\"17-0-0\")).toBe(\"17-0-0\");\n108:     expect(() => recordText(\"17-0\")).toThrow(/record/);\n109:     expect(() => recordText(\"17/0/0\")).toThrow(/record/);\n110:  