rc.layers[0].content.text, px: src.layers[0].style.fontSize };\n28:     });\n29: }\n30: const textOf = (doc: MosaicDocument, label: string) => texts(doc).find((t) => t.label === label)?.text;\n31: \n32: describe(ID, () => {\n33:   it(\"draws the default card the brief promised, every string as derived or typed\", async () => {\n34:     const doc = await render();\n35:     expect(textOf(doc, \"geocache-label\")).toBe(\"GEOCACHING\");\n36:     expect(textOf(doc, \"cacher-name\")).toBe(\"GEOHIKER55\");\n37:     expect(textOf(doc, \"caching-since\")).toBe(\"caching since 2015\");\n38:     expect(textOf(doc, \"find-count\")).toBe(\"1,000\");\n39:     expect(textOf(doc, \"milestone-line\")).toBe(\"1,000th find\");\n40:     expect(textOf(doc, \"milestone-badge-text\")).toBe(\"MILESTONE\");\n41:     expect(textOf(doc, \"mix-legend\")).toBe(\"Trad 812 / Mystery 121 / Multi 38 / Event 20 / Letterbox 9\");\n42:     expect(textOf(doc, \"tile-ftf-value\")).toBe(\"24\");\n43:     expect(textOf(doc, \"tile-ftf-label\")).toBe(\"FTF\");\n44:     expect(textOf(doc, \"tile-d-value\")).toBe(\"2.3\");\n45:     expect(textOf(doc, \"tile-d-label\")).toBe(\"AVG D\");\n46:     expect(textOf(doc, \"tile-t-value\")).toBe(\"1.8\");\n47:     expect(textOf(doc, \"tile-t-label\")).toBe(\"AVG T\");\n48:     expect(textOf(doc, \"footer\")).toBe(\"Sample card: the geocacher and the numbers are invented\");\n49:     // The default counts sum exactly to the find count: no Other in the legend.\n50:     expect(textOf(doc, \"mix-legend\")).not.toContain(\"Other\");\n51:     for (const t of texts(doc)) expect(t.text).toMatch(/^[\\x20-\\x7e]+$/);\n52:   });\n53: \n54:   it(\"binds what it shows: the name, the count, each tile value, the since line, the mix, the accent, the footer\", async () => {\n55:     const doc = await render();\n56:     const { byProp, rejected } = resolvePropBindings(doc, 1080, 1080, { propsSchema: GeocacheMilestoneCardV1.propsSchema });\n57:     expect(rejected).toEqual([]);\n58:     for (const k of [\"cacherName\", \"findCount\", \"ftfCount\", \"avgD\", \"avgT\", \"sinceYear\", \"footer\"]) expect(byProp[k]).toHaveLength(1);\n59:     // The accent colours the header rule and the milestone badge.\n60:     expect(byProp.accent).toHaveLength(2);\n61:     // typeMix is a json list: edited as a structured form, not bound to a rect.\n62:     expect(byProp.typeMix).toBeUndefined();\n63:   });\n64: \n65:   it(\"clears its safe minimum at its own hint\", async () => {\n66:     const ev = evaluateM0(String((await render()).m0), { width: 1080, height: 1080 });\n67:     expect(ev.feasible && ev.meetsPrecision).toBe(true);\n68:   });\n69: \n70:   it(\"keeps its layout contract at the seven contract canvases for the copy that stresses it\", async () => {\n71:     expect(layoutIntentOf(await render())).not.toBeNull();\n72:     const sweep = (over: GeocacheMilestoneCardProps, canvases = CONTRACT_CANVASES) =>\n73:       sweepLayout((p, ctx) => GeocacheMilestoneCardV1.render(p, ctx).then(asDocument), ID, { ...GeocacheMilestoneCardV1.defaultProps, ...over }, (w, h) => targetCtx(w, h), canvases);\n74:     for (const over of [\n75:       {},\n76:       { cacherName: \"TEAM_GEOHIKER_AND_FRIEND\" },\n77:       { findCount: 1042 },\n78:       { findCount: 1500 },\n79:       { findCount: 9999999 },\n80:       { footer: \"\" },\n81:       { accent: \"#ffd23f\" },\n82:       { typeMix: [{ type: \"Traditional\", count: 320 }, { type: \"Mystery\", count: 80 }] },\n83:     ] as GeocacheMilestoneCardProps[]) await sweep(over);\n84:     expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n85:   });\n86: \n87:   it(\"keeps the hierarchy: the hero count is the largest text, above the name and every tile value, at every canvas\", async () => {\n88:     for (const [w, h] of CONTRACT_CANVASES) {\n89:       const doc = await render({}, w, h);\n90:       const t = texts(doc);\n91:       const px = (label: string) => t.filter((x) => x.label === label).map((x) => x.px);\n92:       const find = px(\"find-count\");\n93:       const name = px(\"cacher-name\");\n94:       const tileValues = [\"tile-ftf-value\", \"tile-d-value\", \"tile-t-value\"].flatMap((l) => px(l));\n95:       expect(find).toHaveLength(1);\n96:       expect(Math.max(...find)).toBeGreaterThan(Math.max(...name));\n97:       expect(Math.max(...find)).toBeGreaterThan(Math.max(...tileValues));\n98:     }\n99:   });\n100: \n101:   it(\"derives the milestone and the ordinal, never types them: 1000 is one, 1042 is not\", async () => {\n102:     const m1 = await render();\n103:     expect(textOf(m1, \"milestone-badge-text\")).toBe(\"MILESTONE\");\n104:     const n1 = await render({ findCount: 1042 });\n105:     expect(textOf(n1, \"milestone-line\")).toBe(\"1,042nd find\");\n106:     expect(textOf(n1, \"milestone-badge-text\")).toBeUndefined();\n107:     expect(textOf(await render({ findCount: 1500 }), \"milestone-badge-text\")).toBe(\"MILESTONE\");\n108:     expect(textOf(await render({ findCount: 5000 }), \"milestone-badge-text\")).toBe(\"MILESTONE\");\n109:     expect(textOf(await render({ findCount: 6000 }), \"milestone-badge-text\")).toBe(\"MILESTONE\");\n110:   });\n111: \n112:   it(\"follows Project-GC's milestone ladder exactly\", () => {\n113:     for (const n of [1, 10, 50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 1000, 1500, 2000, 2500, 3000, 3500, 4000, 4500, 5000, 6000, 10000]) {\n114:       expect(isMilestone(n)).toBe(true);\n115:     }\n116:     for (const n of [0, 2, 9, 11, 49, 51, 99, 101, 199, 201, 1042, 1001, 1100, 1300, 5500, 5600]) {\n117:       expect(isMilestone(n)).toBe(false);\n118:     }\n119:   });\n120: \n121:   it(\"formats the ordinal and the count with a thousands comma and the right suffix\", () => {\n122:     expect(ordinal(1000)).toBe(\"1,000th\");\n123:     expect(ordinal(1042)).toBe(\"1,042nd\");\n124:     expect(ordinal(11)).toBe(\"11th\");\n125:     expect(ordinal(21)).toBe(\"21st\");\n126:     expect(ordinal(1)).toBe(\"1st\");\n127:     expect(ordinal(2)).toBe(\"2nd\");\n128:     expect(ordinal(3)).toBe(\"3rd\");\n129:     expect(ordinal(111)).toBe(\"111th\");\n130:     expect(ordinal(121)).toBe(\"121st\");\n131:     expect(ordinal(122)).toBe(\"122nd\");\n132:     expect(ordinal(123)).toBe(\"123rd\");\n133:     expect(ordinal(1204)).toBe(\"1,204th\");\n134:     expect(ordinal(9999999)).toBe(\"9,999,999th\");\n135:   });\n136: \n137:   it(\"keeps the top five types by count and folds the rest into a grey Other\", () => {\n138:     const mix = parseTypeMix(\n139:       [\n140:         { type: \"Traditional\", count: 812 },\n141:         { type: \"Mystery\", count: 121 },\n142:         { type: \"Multi\", count: 38 },\n143:         { type: \"Letterbox\", count: 9 },\n144:         { type: \"Event\", count: 20 },\n145:       ],\n146:       1000,\n147:     );\n148:     expect(mix.top.map((e) => `${e.type} ${e.count}`)).toEqual([\"Traditional 812\", \"Mystery 121\", \"Multi 38\", \"Event 20\", \"Letterbox 9\"]);\n149:     expect(mix.other).toBe(0);\n150:     expect(mix.legend).toBe(\"Trad 812 / Mystery 121 / Multi 38 / Event 20 / Letterbox 9\");\n151:     const partial = parseTypeMix([{ type: \"Traditional\", count: 320 }, { type: \"Mystery\", count: 80 }], 1000);\n152:     expect(partial.top).toHaveLength(2);\n153:     expect(partial.other).toBe(600);\n154:     expect(partial.legend).toBe(\"Trad 320 / Mystery 80 / Other 600\");\n155:     expect(parseTypeMix([], 1000).legend).toBe(\"Other 1,000\");\n156:   });\n157: \n158:   it(\"refuses every bad input with a message that names the field and the value\", async () => {\n159:     await expect(render({ findCount: 2.5 })).rejects.toThrow(/findCount must be a whole number/);\n160:     await expect(render({ findCount: 0 })).rejects.toThrow(/findCount must be a whole number from 1/);\n161:     await expect(render({ avgD: 5.5 })).rejects.toThrow(/avgD must be a number from 1.0 to 5.0/);\n162:     await expect(render({ avgT: 0.5 })).rejects.toThrow(/avgT must be a number from 1.0 to 5.0/);\n163:     await expect(render({ ftfCount: 1001 })).rejects.toThrow(/ftfCount must be a whole number from 0 to findCount \\(1000\\)/);\n164:     await expect(render({ sinceYear: 1999 })).rejects.toThrow(/sinceYear must be a whole year from 2000 to 2026/);\n165:     await expect(render({ typeMix: [{ type: \"Traditionl\", count: 10 }] })).rejects.toThrow(/unknown type \"Traditionl\"; did you mean 'Traditional'\\?/);\n166:     await expect(render({ typeMix: [{ type: \"Traditional\", count: 1200 }] })).rejects.toThrow(/shown types count 1200 finds, more than findCount 1000/);\n167:     await expect(render({ typeMix: [{ type: \"Traditional\", count: 10 }, { type: \"Traditional\", count: 5 }] })).rejects.toThrow(/'Traditional' appears twice/);\n168:     await expect(render({ cacherName: \"\" })).rejects.toThrow(/cacherName must not be empty/);\n169:     await expect(render({ accent: \"green\" })).rejects.toThrow(/accent \"green\" must be #rrggbb/);\n170:     // A misspelled prop is refused by name, so a typo never leaves the sample on a real card.\n171:     await expect(render({ findcount: 500 } as never)).rejects.toThrow(/unknown prop 'findcount'; did you mean 'findCount'\\?/);\n172:     // typeMix may arrive as the raw JSON string a json prop's editor holds.\n173:     expect(textOf(await render({ typeMix: JSON.stringify([{ type: \"Traditional\", count: 900 }]) } as never), \"mix-legend\")).toBe(\"Trad 900 / Other 100\");\n174:     await expect(render({ typeMix: \"{not json\" } as never)).rejects.toThrow(/typeMix is not valid JSON/);\n175:     // A name too long for the thumbnail is refused above the floor, but fits a real canvas.\n176:     expect(textOf(await render({ cacherName: \"A\".repeat(40) }, 1080, 1080), \"cacher-name\")).toBe(\"A\".repeat(40));\n177:     await expect(render({ cacherName: \"A\".repeat(40) }, 480, 270)).rejects.toThrow(/cacherName cannot be fitted on 480x270/);\n178:   });\n179: \n180:   it(\"takes a pale accent and still reads the hero number in ink\", () => {\n181:     expect(normalizeGeocacheMilestoneCard({}).heroInk).toBe(\"#4a8f3c\");\n182:     expect(normalizeGeocacheMilestoneCard({ accent: \"#ffd23f\" }).heroInk).toBe(\"#1b1f1c\");\n183:     expect(normalizeGeocacheMilestoneCard({ accent: \"\" }).accent).toBe(\"#4a8f3c\");\n184:   });\n185: \n186:   it(\"stacks four bands on the square and portrait, side by side on the wide canvas\", () => {\n187:     expect(layoutGeocacheMilestoneCard({}, 1080, 1080).shape).toBe(\"square\");\n188:     expect(layoutGeocacheMilestoneCard({}, 1080, 1920).shape).toBe(\"tall\");\n189:     expect(layoutGeocacheMilestoneCard({}, 1920, 1080).shape).toBe(\"wide\");\n190:     const wide = layoutGeocacheMilestoneCard({}, 1920, 1080);\n191:     expect(wide.headRect.y).toBe(wide.heroRect.y);\n192:     expect(wide.heroRect.x).toBeGreaterThan(wide.headRect.x + wide.headRect.w);\n193:     const square = layoutGeocacheMilestoneCard({}, 1080, 1080);\n194:     expect(square.heroRect.y).toBeGreaterThan(square.headRect.y + square.headRect.h);\n195:   });\n196: \n197:   it(\"is deterministic\", async () => {\n198:     expect(await render()).toEqual(await render());\n199:     expect(await render({ findCount: 1042 }, 1920, 1080)).toEqual(await render({ findCount: 1042 }, 1920, 1080));\n200:   });\n201: });\n\n(End of file - total 201 lines)\n</content>","metadata":{"preview":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { resolvePropBindings } from \"@m0saic/template-utils\";\nimport type { MosaicDocument } from \"@m0saic/types\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { CONTRACT_CANVASES, layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport {\n  GeocacheMilestoneCardV1,\n  isMilestone,\n  layoutGeocacheMilestoneCard,\n  normalizeGeocacheMilestoneCard,\n  ordinal,\n  parseTypeMix,\n} from \"./geocache-milestone-card\";\nimport type { GeocacheMile