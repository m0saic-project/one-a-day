{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EVN3J3WcjkA8yW4wyMQ4ro","type":"tool_result","content":"1\timport type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\n2\timport { asTemplateId } from \"@m0saic/types\";\n3\timport { toM0String } from \"@m0saic/dsl-stdlib\";\n4\timport { bindProp, bindPropPath, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag, wrapMeasured } from \"@m0saic/template-utils\";\n5\timport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\n6\timport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n7\timport { budget, textCell, widthOf } from \"../../../_shared/text\";\n8\timport { whyTutorial } from \"../../../_shared/why\";\n9\timport type { WhySpec } from \"../../../_shared/why\";\n10\t\n11\t/**\n12\t * `@one-a-day/sports/swim-time-drop-card/v1` - one swimmer's meet as a card:\n13\t * per event the entry time, the time swum, the drop in seconds, a bar and\n14\t * the standard reached, from the rows a meet results file already holds.\n15\t *\n16\t * ONE CONCEPT: a bar says what it measures. The drop is always PRINTED in\n17\t * seconds (the recaps' own unit), but a card mixes a 50 and a 200, and in\n18\t * seconds the long event always wins. So the bar is one of two stated\n19\t * things - the share of the entry time dropped (`bar: \"percent\"`) or the\n20\t * seconds dropped (`bar: \"seconds\"`) - the longest bar fills the track, a\n21\t * percent bar prints its own number at its end (a bar in percent beside a\n22\t * drop in seconds is two units, and a footnote alone does not carry that),\n23\t * and the footnote names which of the two the bars are.\n24\t *\n25\t * The rule that bites: a slower swim is printed, not drawn. It gets a plus\n26\t * sign in the ordinary ink and an empty track - no red, no bar growing the\n27\t * other way. NT and DQ rows make no claim at all and are not counted. All\n28\t * arithmetic is integer hundredths of a second; nothing is a float until a\n29\t * bar's pixel width.\n30\t */\n31\t\n32\texport type SwimCourse = \"SCY\" | \"SCM\" | \"LCM\";\n33\texport type SwimBar = \"percent\" | \"seconds\";\n34\t/** One swim, as a results row gives it. `standard` is the caller's: the template computes none. */\n35\texport type SwimRow = {\n36\t  /** The event as the club says it: \"50 Free\", \"200 IM\". */\n37\t  event: string;\n38\t  /** Entry (seed) time: \"31.84\", \"1:10.52\", \"19:58.44\"; \"NT\" or \"\" for no time. */\n39\t  entry?: string;\n40\t  /** The time swum, same formats; \"DQ\" for a disqualified swim. */\n41\t  final: string;\n42\t  /** The motivational standard the swim reached, up to 4 characters (\"B\", \"BB\", \"AAAA\"). */\n43\t  standard?: string;\n44\t};\n45\texport type SwimTimeDropCardProps = {\n46\t  /** The header name. */\n47\t  swimmer?: string;\n48\t  /** Second line; \"\" removes it. */\n49\t  club?: string;\n50\t  /** The meet's name; \"\" removes it. */\n51\t  meet?: string;\n52\t  /** Free line for the date, age group or session; \"\" removes it. */\n53\t  details?: string;\n54\t  /** The course chip: times in different courses do not compare. */\n55\t  course?: SwimCourse;\n56\t  /** The swims, in meet order: 1 to 8 rows. */\n57\t  swims?: SwimRow[];\n58\t  /** What a bar's length means - and the footnote with it. */\n59\t  bar?: SwimBar;\n60\t  /** Bars and chips, as #rrggbb (the club's colour). */\n61\t  accent?: string;\n62\t  /** Page and ink. */\n63\t  preset?: \"dark\" | \"light\";\n64\t  /** Dev-only: check the layout contract and draw it over the card. */\n65\t  debugLayout?: boolean;\n66\t};\n67\t\n68\tconst ID = \"@one-a-day/sports/swim-time-drop-card/v1\";\n69\texport const MAX_SWIMS = 8;\n70\t/** The default draws the share of the entry time; \"seconds\" is one prop away. */\n71\tconst DEFAULT_BAR = \"percent\" as SwimBar;\n72\t/**\n73\t * Variant c: a bar in percent beside a number in seconds asks the reader to\n74\t * hold two units, so each percent bar carries its own number at its end and\n75\t * the track is tall enough to hold it. Off, the track is a thin strip and the\n76\t * footnote alone names the bar's unit (variant a).\n77\t */\n78\tconst BAR_LABELS = true;\n79\tconst DEFAULT_ACCENT = \"#2ec4b6\";\n80\t/** The page is document.backgroundColor, never a full-canvas rect (doctor: canvasFill). */\n81\tconst THEMES = {\n82\t  dark: { bg: \"#0e1b25\", ink: \"#eaf2f5\", dim: \"#8ea3ae\" },\n83\t  light: { bg: \"#f5f9fa\", ink: \"#10222c\", dim: \"#55676f\" },\n84\t} as const;\n85\t\n86\t// An invented swimmer at an invented meet. The chips are illustrative: no age\n87\t// group or sex is named, and they were not checked against a season's table.\n88\tconst DEFAULT_SWIMS: SwimRow[] = [\n89\t  { event: \"50 Free\", entry: \"31.84\", final: \"30.97\", standard: \"BB\" },\n90\t  { event: \"100 Free\", entry: \"1:10.52\", final: \"1:08.31\", standard: \"BB\" },\n91\t  { event: \"200 Free\", entry: \"2:36.40\", final: \"2:29.85\", standard: \"B\" },\n92\t  { event: \"100 Back\", entry: \"1:19.77\", final: \"1:20.19\" },\n93\t  { event: \"50 Fly\", entry: \"36.10\", final: \"34.92\", standard: \"B\" },\n94\t  { event: \"200 IM\", entry: \"2:58.03\", final: \"2:54.02\" },\n95\t];\n96\t\n97\tconst DEFAULTS = {\n98\t  swimmer: \"Tessa Marlow\",\n99\t  club: \"Larkmoor Swim Club\",\n100\t  meet: \"October Kickoff Invitational\",\n101\t  details: \"Oct 3-4, 2026\",\n102\t  course: \"SCY\" as SwimCourse,\n103\t  swims: DEFAULT_SWIMS,\n104\t  bar: DEFAULT_BAR,\n105\t  accent: DEFAULT_ACCENT,\n106\t  preset: \"dark\" as \"dark\" | \"light\",\n107\t  debugLayout: false,\n108\t};\n109\t\n110\tconst propsSchema = definePropsSchema<SwimTimeDropCardProps>({\n111\t  swims: {\n112\t    type: \"list\",\n113\t    required: false,\n114\t    description:\n115\t      'The swimmer\\'s swims in meet order, 1 to 8 rows (split a longer meet across two cards). Each row is what a results row gives: the event, the entry (seed) time and the time swum, as \"31.84\", \"1:10.52\" or \"19:58.44\". An entry of \"NT\" (or empty) is a first swim; a final of \"DQ\" is a disqualification - both are printed, neither is counted.',\n116\t    meta: { constraints: { minItems: 1, maxItems: MAX_SWIMS }, ui: { label: \"Swims\", order: 1, primary: true } },\n117\t    fields: {\n118\t      event: { type: \"string\", required: true, description: 'The event as the club says it: \"50 Free\", \"200 IM\", \"100 Breaststroke\". Up to 24 characters.', meta: { ui: { label: \"Event\" } } },\n119\t      entry: { type: \"string\", required: false, description: 'The entry (seed) time, \"31.84\" or \"1:10.52\". \"NT\" or empty when the swimmer had no time.', meta: { control: { placeholder: \"NT\" }, ui: { label: \"Entry time\" } } },\n120\t      final: { type: \"string\", required: true, description: 'The time swum, in the same formats, or \"DQ\".', meta: { ui: { label: \"Final time\" } } },\n121\t      standard: { type: \"string\", required: false, description: 'The motivational standard this swim reached, up to 4 characters (\"B\", \"BB\", \"AAAA\"). You supply it: the tables change by season, age and sex, and the template computes none.', meta: { control: { placeholder: \"none\" }, ui: { label: \"Standard\" } } },\n122\t    },\n123\t  },\n124\t  swimmer: {\n125\t    type: \"string\",\n126\t    required: false,\n127\t    description: \"The swimmer's name, the largest text on the card. Up to 40 characters; accented Latin letters are drawn. The sample is an invented swimmer.\",\n128\t    meta: { control: { placeholder: DEFAULTS.swimmer }, ui: { label: \"Swimmer\", order: 2, primary: true } },\n129\t  },\n130\t  club: {\n131\t    type: \"string\",\n132\t    required: false,\n133\t    description: \"The club, under the name. Empty removes the line.\",\n134\t    meta: { control: { placeholder: \"none\" }, ui: { label: \"Club\", order: 3 } },\n135\t  },\n136\t  meet: {\n137\t    type: \"string\",\n138\t    required: false,\n139\t    description: \"The meet's name. Empty removes it.\",\n140\t    meta: { control: { placeholder: \"none\" }, ui: { label: \"Meet\", order: 4 } },\n141\t  },\n142\t  details: {\n143\t    type: \"string\",\n144\t    required: false,\n145\t    description: \"A free line for the date, the age group or the session. Empty removes it.\",\n146\t    meta: { control: { placeholder: \"none\" }, ui: { label: \"Details\", order: 5 } },\n147\t  },\n148\t  course: {\n149\t    type: \"string\",\n150\t    required: false,\n151\t    description: 'The course the times were swum in, shown as a chip: \"SCY\" (short course yards), \"SCM\" (short course metres) or \"LCM\" (long course metres). Times in different courses do not compare.',\n152\t    meta: { constraints: { oneOf: [\"SCY\", \"SCM\", \"LCM\"] }, ui: { label: \"Course\", order: 6 } },\n153\t  },\n154\t  bar: {\n155\t    type: \"string\",\n156\t    required: false,\n157\t    description: 'What a bar\\'s length means: \"percent\" (the share of the entry time dropped - fair between a 50 and a 200; each bar prints its percent at its end) or \"seconds\" (the seconds dropped, the number already printed on the row - the long events dominate). The longest bar fills its track either way, and the footnote says which it is.',\n158\t    meta: { constraints: { oneOf: [\"percent\", \"seconds\"] }, ui: { label: \"Bar shows\", order: 7 } },\n159\t  },\n160\t  accent: {\n161\t    type: \"string\",\n162\t    required: false,\n163\t    description: \"The club's colour, as #rrggbb: the bars, the course chip and the standard chips.\",\n164\t    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 8 } },\n165\t  },\n166\t  preset: {\n167\t    type: \"string\",\n168\t    required: false,\n169\t    description: 'Page and ink: \"dark\" (default) or \"light\".',\n170\t    meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 9 } },\n171\t  },\n172\t  debugLayout: {\n173\t    type: \"boolean\",\n174\t    required: false,\n175\t    description: \"Dev-only: check the layout contract (every text fits its box, every row has a track, the tracks are one size) and draw it over the card.\",\n176\t    meta: { ui: { label: \"Debug layout\", order: 99 } },\n177\t  },\n178\t});\n179\t\n180\t/* ── the arithmetic: pure, exported, and what the test asserts ── */\n181\t\n182\tfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n183\t\n184\t/** \"31.84\", \"1:10.52\", \"19:58.44\" -> integer hundredths of a second; null when it is not a time. */\n185\texport function parseSwimTime(text: string): number | null {\n186\t  const m = /^(?:(\\d{1,2}):([0-5]\\d)|(\\d{1,2}))\\.(\\d{2})$/.exec(text);\n187\t  if (!m) return null;\n188\t  const cs = m[1] !== undefined ? (Number(m[1]) * 60 + Number(m[2])) * 100 + Number(m[4]) : Number(m[3]) * 100 + Number(m[4]);\n189\t  return cs > 0 ? cs : null;\n190\t}\n191\t\n192\t/** Hundredths back to the way a results sheet prints them: SS.hh under a minute, M:SS.hh above. */\n193\texport function formatSwimTime(cs: number): string {\n194\t  const two = (n: number) => String(n).padStart(2, \"0\");\n195\t  const min = Math.floor(cs / 6000), sec = Math.floor((cs % 6000) / 100), hun = cs % 100;\n196\t  return min > 0 ? `${min}:${two(sec)}.${two(hun)}` : `${sec}.${two(hun)}`;\n197\t}\n198\t\n199\t/** drop = entry - final, with its sign: \"-0.87\" faster, \"+0.42\" slower, \"0.00\" equal. ASCII hyphen-minus. */\n200\texport function formatSwimDrop(dropCs: number): string {\n201\t  return dropCs > 0 ? `-${formatSwimTime(dropCs)}` : dropCs < 0 ? `+${formatSwimTime(-dropCs)}` : \"0.00\";\n202\t}\n203\t\n204\t/**\n205\t * The share of the entry time dropped, to a tenth of a percent, rounded half\n206\t * up in integers. A real drop too small to round to 0.1% says so: \"0.0%\"\n207\t * beside a bar would read as no drop at all.\n208\t */\n209\texport function formatSwimShare(dropCs: number, entryCs: number): string {\n210\t  const tenths = Math.floor((2000 * dropCs + entryCs) / (2 * entryCs));\n211\t  return tenths === 0 && dropCs > 0 ? \"<0.1%\" : `${Math.floor(tenths / 10)}.${tenths % 10}%`;\n212\t}\n213\t\n214\t/**\n215\t * Printable ASCII plus the accented Latin letters (Latin-1 and Latin\n216\t * Extended-A, U+00C0-U+017F without the two maths signs). The bundled font\n217\t * has a glyph for every one of them in both weights - the test walks the\n218\t * range - so a Zoe with a diaeresis is drawn, and anything else is refused\n219\t * by name instead of rendering as tofu.\n220\t */\n221\tconst DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\n222\tfunction text(value: unknown, field: string, min: number, max: number): string {\n223\t  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n224\t  if (!DRAWN.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII and accented Latin letters (U+00C0-U+017F).`);\n225\t  const s = value.trim();\n226\t  if (s.length < min) fail(field, \"must not be blank.\");\n227\t  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n228\t  return s;\n229\t}\n230\t\n231\texport type SwimLine = {\n232\t  event: string;\n233\t  /** Hundredths; null = no entry time (NT). */\n234\t  entryCs: number | null;\n235\t  /** Hundredths; null = DQ. */\n236\t  finalCs: number | null;\n237\t  entryText: string;\n238\t  finalText: string;\n239\t  /** entry - final in hundredths; null when either time is missing. */\n240\t  dropCs: number | null;\n241\t  /** \"-0.87\", \"+0.42\", \"0.00\", \"first swim\" for an NT entry, \"\" for a DQ. */\n242\t  dropText: string;\n243\t  standard: string;\n244\t  /** The bar as a share of its track, 0..1; 0 = no bar (slower, equal, NT, DQ). */\n245\t  share: number;\n246\t  /** The share of the entry time dropped (\"2.7%\") for a faster swim; \"\" otherwise. */\n247\t  shareText: string;\n248\t};\n249\t\n250\t/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n251\texport function normalizeSwimCard(props: SwimTimeDropCardProps) {\n252\t  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n253\t  const swimmer = text(p.swimmer, \"swimmer\", 1, 40);\n254\t  const club = text(p.club, \"club\", 0, 48);\n255\t  const meet = text(p.meet, \"meet\", 0, 48);\n256\t  const details = text(p.details, \"details\", 0, 48);\n257\t  if (p.course !== \"SCY\" && p.course !== \"SCM\" && p.course !== \"LCM\") fail(\"course\", `${JSON.stringify(p.course)} must be \"SCY\", \"SCM\" or \"LCM\".`);\n258\t  if (p.bar !== \"percent\" && p.bar !== \"seconds\") fail(\"bar\", `${JSON.stringify(p.bar)} must be \"percent\" or \"seconds\".`);\n259\t  if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n260\t  if (typeof p.accent !== \"string\" || !/^#[0-9a-fA-F]{6}$/.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n261\t  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n262\t  if (!Array.isArray(p.swims) || p.swims.length === 0) fail(\"swims\", \"must hold at least one { event, entry, final }.\");\n263\t  if (p.swims.length > MAX_SWIMS) fail(\"swims\", `has ${p.swims.length} rows; one card holds at most ${MAX_SWIMS} - split the meet across two cards.`);\n264\t  const bar = p.bar as SwimBar;\n265\t\n266\t  const lines: SwimLine[] = p.swims.map((row, i) => {\n267\t    const at = `swims[${i}]`;\n268\t    if (!row || typeof row !== \"object\" || Array.isArray(row)) fail(at, \"must be an object { event, entry, final, standard? }.\");\n269\t    const event = text(row.event, `${at}.event`, 1, 24);\n270\t    const entryRaw = row.entry === undefined ? \"\" : text(row.entry, `${at}.entry`, 0, 12);\n271\t    if (row.final === undefined) fail(`${at}.final`, 'is missing: give the time swum, or \"DQ\".');\n272\t    const finalRaw = text(row.final, `${at}.final`, 1, 12);\n273\t    const standard = row.standard === undefined ? \"\" : text(row.standard, `${at}.standard`, 0, 12);\n274\t    if (standard.length > 4) fail(`${at}.standard`, `${JSON.stringify(standard)} is longer than 4 characters (\"B\", \"BB\", \"AAAA\").`);\n275\t    if (/\\s/.test(standard)) fail(`${at}.standard`, `${JSON.stringify(standard)} must not contain a space.`);\n276\t    const noTime = entryRaw === \"\" || entryRaw.toUpperCase() === \"NT\";\n277\t    const dq = finalRaw.toUpperCase() === \"DQ\";\n278\t    const entryCs = noTime ? null : parseSwimTime(entryRaw);\n279\t    const finalCs = dq ? null : parseSwimTime(finalRaw);\n280\t    if (!noTime && entryCs === null) fail(`${at}.entry`, `${JSON.stringify(entryRaw)} is not a time: write \"31.84\" or \"1:10.52\", or \"NT\" for no entry time.`);\n281\t    if (!dq && finalCs === null) fail(`${at}.final`, `${JSON.stringify(finalRaw)} is not a time: write \"30.97\" or \"1:08.31\", or \"DQ\".`);\n282\t    if (dq && standard !== \"\") fail(`${at}.standard`, `${JSON.stringify(standard)} is set on a DQ: a disqualified swim has no time and reaches no standard.`);\n283\t    const dropCs = entryCs !== null && finalCs !== null ? entryCs - finalCs : null;\n284\t    return {\n285\t      event, entryCs, finalCs,\n286\t      entryText: entryCs === null ? \"NT\" : formatSwimTime(entryCs),\n287\t      finalText: finalCs === null ? \"DQ\" : formatSwimTime(finalCs),\n288\t      dropCs,\n289\t      dropText: dropCs !== null ? formatSwimDrop(dropCs) : finalCs !== null ? \"first swim\" : \"\",\n290\t      standard, share: 0,\n291\t      shareText: dropCs !== null && dropCs > 0 ? formatSwimShare(dropCs, entryCs as number) : \"\",\n292\t    };\n293\t  });\n294\t\n295\t  // The scale: the largest drop on THIS card fills the track. Bars compare one\n296\t  // swimmer's swims with each other, never swimmers with each other. Fractions\n297\t  // are compared by cross-multiplication, so the choice of the longest is exact.\n298\t  const num = (l: SwimLine) => l.dropCs as number;\n299\t  const den = (l: SwimLine) => (bar === \"percent\" ? (l.entryCs as number) : 1);\n300\t  const faster = lines.filter((l) => l.dropCs !== null && l.dropCs > 0);\n301\t  const longest = faster.reduce<SwimLine | null>((best, l) => (best === null || num(l) * den(best) > num(best) * den(l) ? l : best), null);\n302\t  if (longest) for (const l of faster) l.share = (num(l) * den(longest)) / (den(l) * num(longest));\n303\t\n304\t  const compared = lines.filter((l) => l.dropCs !== null).length;\n305\t  const totalCs = faster.reduce((sum, l) => sum + num(l), 0);\n306\t  const countText = compared === 0 ? \"No times to compare\" : `${faster.length} of ${compared} ${compared === 1 ? \"swim\" : \"swims\"} faster`;\n307\t  // Slower swims are not netted against the total: each is printed on its own row.\n308\t  const totalText = faster.length === 0 ? \"\" : totalCs < 6000 ? `${formatSwimTime(totalCs)} s dropped` : `${formatSwimTime(totalCs)} dropped`;\n309\t  const scaleText = longest === null ? \"\"\n310\t    : bar === \"percent\" ? formatSwimShare(num(longest), longest.entryCs as number)\n311\t    : num(longest) < 6000 ? `${formatSwimTime(num(longest))} s` : formatSwimTime(num(longest));\n312\t  const footnote = compared === 0 ? \"vs entry time. A first swim or a DQ has no drop to show.\"\n313\t    : longest === null ? \"vs entry time. No swim was faster, so no bar is drawn.\"\n314\t    : bar === \"percent\" && BAR_LABELS ? \"vs entry time. Bars and their percentages: share of the entry time dropped.\"\n315\t    : bar === \"percent\" ? `vs entry time. Bars: share of the entry time dropped; the longest is ${scaleText}.`\n316\t    : `vs entry time. Bars: seconds dropped; the longest is ${scaleText}.`;\n317\t\n318\t  return {\n319\t    swimmer, club, meet, details, course: p.course as SwimCourse, bar, preset: p.preset as \"dark\" | \"light\",\n320\t    accent: p.accent.trim().toLowerCase() as MosaicColor, debugLayout: p.debugLayout,\n321\t    lines, faster: faster.length, compared, totalCs, countText, totalText, scaleText, footnote,\n322\t  };\n323\t}\n324\t\n325\t/* ── colour ── */\n326\t\n327\t// Not exported: the pack index is `export *`, and dev/bench-delta already exports a `mix`.\n328\tfunction mix(a: string, b: string, t: number): MosaicColor {\n329\t  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n330\t  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n331\t  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n332\t}\n333\tfunction luminance(hex: string): number {\n334\t  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n335\t  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n336\t}\n337\t/** The readable ink over a filled chip: dark or white, whichever contrasts more with the caller's accent. */\n338\tfunction onColor(fill: string): MosaicColor {\n339\t  const ratio = (other: string) => { const a = luminance(fill), b = luminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n340\t  return (ratio(\"#0b1220\") >= ratio(\"#ffffff\") ? \"#0b1220\" : \"#ffffff\") as MosaicColor;\n341\t}\n342\t\n343\t/* ── geometry ── */\n344\t\n345\texport type SwimRect = { x: number; y: number; w: number; h: number };\n346\ttype Bind = { prop: \"swimmer\" | \"club\" | \"meet\" | \"details\" } | { row: number; field: \"event\" | \"entry\" | \"final\" | \"standard\" } | null;\n347\ttype Cell = { label: string; rect: SwimRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\n348\ttype Tile = { label: string; rect: SwimRect; color: MosaicColor; radius: number; layer: number; accent?: boolean };\n349\t\n350\t/** The largest whole size up to `maxPx` at which one line fits the cell's budget (`cell * 0.94 - 2px`). */\n351\tfunction fitPx(line: string, cellW: number, maxPx: number, bold: boolean): number {\n352\t  const top = Math.max(1, Math.round(maxPx));\n353\t  const room = budget(cellW), w = widthOf(line, top, bold);\n354\t  let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n355\t  while (px > 1 && widthOf(line, px, bold) > room) px--;\n356\t  return px;\n357\t}\n358\t\n359\t/** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\n360\texport function layoutSwimCard(props: SwimTimeDropCardProps, W: number, H: number) {\n361\t  const p = normalizeSwimCard(props);\n362\t  const theme = THEMES[p.preset];\n363\t  const ink = theme.ink as MosaicColor, dim = theme.dim as MosaicColor;\n364\t  const S = Math.min(W, H);\n365\t  // Wide canvases put the bar in a column; square and portrait need the width\n366\t  // for the text cells, so the bar becomes a strip under the row's text line.\n367\t  const wide = W * 3 >= H * 4;\n368\t  const k = wide ? 1 : Math.max(1, Math.min(1.25, H / W));\n369\t  const m = Math.round(S * 0.055), CW = W - 2 * m;\n370\t  const gap = Math.round(S * 0.022);\n371\t  const rule = Math.max(1, Math.round(S * 0.0025));\n372\t  // Below these sizes copy is refused, not shrunk further: the row text and the\n373\t  // header at 1.8% of the short side, the chrome (heads, chips, footnote) at 1.3%.\n374\t  const floor = Math.max(6, Math.round(S * 0.018)), small = Math.max(5, Math.round(S * 0.013));\n375\t  const cells: Cell[] = [];\n376\t  const tiles: Tile[] = [];\n377\t  const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n378\t  /** One fitted line in `rect`; refuses below the floor instead of clipping. */\n379\t  const line = (label: string, rect: SwimRect, value: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string; floor?: number } = {}) => {\n380\t    if (px < (o.floor ?? floor)) unfit(o.field ?? label);\n381\t    cells.push({ label, rect, text: value, px, width: widthOf(value, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? ink, bind: o.bind ?? null, over: o.over === true });\n382\t  };\n383\t\n384\t  // ── header: the name is the largest text; the course chip sits top right ──\n385\t  const right = p.meet !== \"\" || p.details !== \"\";\n386\t  let headerBottom: number;\n387\t  if (wide) {\n388\t    const hH = Math.round((H - 2 * m) * 0.21);\n389\t    const chipH = Math.round(hH * 0.3), chipW = Math.round(chipH * 2.3);\n390\t    const leftW = right ? Math.round(CW * 0.56) : CW - chipW - gap;\n391\t    const rightX = m + leftW + gap, rightW = CW - leftW - gap;\n392\t    const nameH = Math.round(hH * 0.62), subY = m + Math.round(hH * 0.68), subH = m + hH - subY;\n393\t    const midY = m + Math.round(hH * 0.36), midH = subY - midY;\n394\t    line(\"swimmer\", { x: m, y: m, w: leftW, h: nameH }, p.swimmer, fitPx(p.swimmer, leftW, nameH * 0.74, true), { bold: true, bind: { prop: \"swimmer\" } });\n395\t    const subPx = Math.min(...[[p.club, leftW], [p.meet, rightW], [p.details, rightW]].map(([t, w]) => (t === \"\" ? Infinity : fitPx(t as string, w as number, subH * 0.6, false))), Math.round(subH * 0.6));\n396\t    if (p.club !== \"\") line(\"club\", { x: m, y: subY, w: leftW, h: subH }, p.club, subPx, { color: dim, bind: { prop: \"club\" } });\n397\t    if (p.meet !== \"\") line(\"meet\", { x: rightX, y: midY, w: rightW, h: midH }, p.meet, subPx, { color: dim, align: \"right\", bind: { prop: \"meet\" } });\n398\t    if (p.details !== \"\") line(\"details\", { x: rightX, y: subY, w: rightW, h: subH }, p.details, subPx, { color: dim, align: \"right\", bind: { prop: \"details\" } });\n399\t    tiles.push({ label: \"course-chip\", rect: { x: W - m - chipW, y: m, w: chipW, h: chipH }, color: p.accent, radius: 0.5, layer: 1, accent: true });\n400\t    headerBottom = m + hH;\n401\t  } else {\n402\t    const nameH = Math.round(S * 0.085 * k), lineH = Math.round(S * 0.044 * k);\n403\t    const chipH = Math.round(nameH * 0.56), chipW = Math.round(chipH * 2.3);\n404\t    const nameW = CW - chipW - gap;\n405\t    line(\"swimmer\", { x: m, y: m, w: nameW, h: nameH }, p.swimmer, fitPx(p.swimmer, nameW, nameH * 0.74, true), { bold: true, bind: { prop: \"swimmer\" } });\n406\t    tiles.push({ label: \"course-chip\", rect: { x: W - m - chipW, y: m + Math.round((nameH - chipH) / 2), w: chipW, h: chipH }, color: p.accent, radius: 0.5, layer: 1, accent: true });\n407\t    // The club on its own line. The meet and the details share the next one,\n408\t    // split by what each needs, while both fit there at the full size; a long\n409\t    // pair takes a line each rather than shrinking to share one.\n410\t    const subTop = Math.round(lineH * 0.62);\n411\t    const meetNeed = widthOf(p.meet, subTop), detailsNeed = widthOf(p.details, subTop);\n412\t    const both = p.meet !== \"\" && p.details !== \"\";\n413\t    const shared = both && Math.ceil((meetNeed + 2) / 0.94) + Math.ceil((detailsNeed + 2) / 0.94) + 2 * gap <= CW;\n414\t    const detailsW = !both || !shared ? CW : Math.ceil((detailsNeed + 2) / 0.94) + 1, meetW = !both || !shared ? CW : CW - detailsW - 2 * gap;\n415\t    const subPx = Math.min(...[[p.club, CW], [p.meet, meetW], [p.details, detailsW]].map(([t, w]) => (t === \"\" ? Infinity : fitPx(t as string, w as number, subTop, false))), subTop);\n416\t    let y = m + nameH;\n417\t    if (p.club !== \"\") { line(\"club\", { x: m, y, w: CW, h: lineH }, p.club, subPx, { color: dim, bind: { prop: \"club\" } }); y += lineH; }\n418\t    if (p.meet !== \"\") { line(\"meet\", { x: m, y, w: meetW, h: lineH }, p.meet, subPx, { color: dim, bind: { prop: \"meet\" } }); if (!shared) y += lineH; }\n419\t    if (p.details !== \"\") { line(\"details\", { x: W - m - detailsW, y, w: detailsW, h: lineH }, p.details, subPx, { color: dim, align: shared ? \"right\" : \"left\", bind: { prop: \"details\" } }); y += lineH; }\n420\t    headerBottom = y;\n421\t  }\n422\t  const courseChip = tiles[0].rect;\n423\t  line(\"course\", courseChip, p.course, fitPx(p.course, courseChip.w, courseChip.h * 0.5, true), { bold: true, align: \"center\", color: onColor(p.accent), over: true, floor: small });\n424\t\n425\t  // ── summary band, built from the bottom up: count and total, then the footnote that carries the honesty ──\n426\t  const footTop = Math.round(S * 0.025 * k);\n427\t  const oneLine = fitPx(p.footnote, CW, footTop, false);\n428\t  let footPx = oneLine, footLines = [p.footnote];\n429\t  if (oneLine < footTop * 0.9) {\n430\t    // Two lines at the target size beat one shrunken line; shrink only when two do not hold it.\n431\t    footPx = footTop;\n432\t    footLines = wrapMeasured(p.footnote, footPx, budget(CW));\n433\t    while (footLines.length > 2 && footPx > 1) { footPx--; footLines = wrapMeasured(p.footnote, footPx, budget(CW)); }\n434\t  }\n435\t  if (footPx < small) unfit(\"footnote\");\n436\t  const footLineH = Math.round(footPx * 1.4), footH = footLines.length * footLineH + 2;\n437\t  const footRect: SwimRect = { x: m, y: H - m - footH, w: CW, h: footH };\n438\t  cells.push({ label: \"footnote\", rect: footRect, text: footLines.join(\"\\n\"), px: footPx, width: Math.max(...footLines.map((l) => widthOf(l, footPx))), bold: false, align: \"left\", color: dim, bind: null, over: false });\n439\t\n440\t  const sumTop = Math.round(S * 0.05 * k);\n441\t  const countW = Math.round(CW * 0.58), totalW = CW - countW - gap;\n442\t  const sidePx = Math.min(fitPx(p.countText, p.totalText === \"\" ? CW : countW, sumTop, true), p.totalText === \"\" ? Infinity : fitPx(p.totalText, totalW, sumTop, true));\n443\t  // Side by side while that keeps the size; stacked when the pair would have to shrink (portrait).\n444\t  const stacked = p.totalText !== \"\" && sidePx < sumTop * 0.85;\n445\t  const sumPx = stacked ? Math.min(fitPx(p.countText, CW, sumTop, true), fitPx(p.totalText, CW, sumTop, true)) : sidePx;\n446\t  const sumRowH = Math.round(sumPx * 1.45);\n447\t  const sumY = footRect.y - Math.round(S * 0.008) - (stacked ? 2 : 1) * sumRowH;\n448\t  if (stacked) {\n449\t    line(\"summary-count\", { x: m, y: sumY, w: CW, h: sumRowH }, p.countText, sumPx, { bold: true, field: \"the summary\" });\n450\t    line(\"summary-total\", { x: m, y: sumY + sumRowH, w: CW, h: sumRowH }, p.totalText, sumPx, { bold: true, field: \"the summary\" });\n451\t  } else {\n452\t    line(\"summary-count\", { x: m, y: sumY, w: p.totalText === \"\" ? CW : countW, h: sumRowH }, p.countText, sumPx, { bold: true, field: \"the summary\" });\n453\t    if (p.totalText !== \"\") line(\"summary-total\", { x: W - m - totalW, y: sumY, w: totalW, h: sumRowH }, p.totalText, sumPx, { bold: true, align: \"right\", field: \"the summary\" });\n454\t  }\n455\t  const line2 = mix(theme.bg, theme.ink, 0.22);\n456\t  const ruleBottomY = sumY - Math.round(gap * 0.6) - rule;\n457\t  tiles.push({ label: \"rule-top\", rect: { x: m, y: headerBottom + Math.round(gap * 0.5), w: CW, h: rule }, color: line2, radius: 0, layer: 1 });\n458\t  tiles.push({ label: \"rule-bottom\", rect: { x: m, y: ruleBottomY, w: CW, h: rule }, color: line2, radius: 0, layer: 1 });\n459\t\n460\t  // ── the rows: a column-head line, then one row per swim in meet order ──\n461\t  const n = p.lines.length;\n462\t  const bandTop = headerBottom + gap + rule, bandBottom = ruleBottomY - Math.round(gap * 0.5);\n463\t  const headH = Math.round(S * 0.04 * k);\n464\t  const rowsTop = bandTop + headH;\n465\t  // The cap keeps one or two swims from turning into slabs; the group sits at the top of its band.\n466\t  const cap = Math.round(S * (wide ? 0.105 : 0.135 * k));\n467\t  const rowH = Math.min(cap, Math.floor((bandBottom - rowsTop) / n));\n468\t  // Column widths are fractions of the content width, the same in every row,\n469\t  // so a row without a chip keeps the space and the decimal points stack.\n470\t  const g = Math.round(CW * (wide ? 0.012 : 0.01));\n471\t  const frac = wide ? { event: 0.22, entry: 0.12, final: 0.12, track: 0.28, drop: 0.13 } : { event: 0.27, entry: 0.19, final: 0.19, track: 0, drop: 0.19 };\n472\t  const col = (x: number, f: number) => ({ x, w: Math.round(CW * f) });\n473\t  const cEvent = col(m, frac.event);\n474\t  const cEntry = col(cEvent.x + cEvent.w + g, frac.entry);\n475\t  const cFinal = col(cEntry.x + cEntry.w + g, frac.final);\n476\t  const cTrack = wide ? col(cFinal.x + cFinal.w + g, frac.track) : { x: m, w: CW };\n477\t  const cDrop = col(wide ? cTrack.x + cTrack.w + g : cFinal.x + cFinal.w + g, frac.drop);\n478\t  const cChip = { x: cDrop.x + cDrop.w + g, w: W - m - (cDrop.x + cDrop.w + g) };\n479\t\n480\t  // One size for every time on the card and one for every event name: a long\n481\t  // event name shrinks the event column, never the numbers beside it.\n482\t  // The times are fitted to 88% of their column, so two neighbouring\n483\t  // times always keep a gutter; the row text never outgrows the summary.\n484\t  const rowTop = Math.min(Math.round(rowH * (wide ? 0.46 : 0.4)), Math.round(S * 0.04 * k));\n485\t  const tight = (w: number) => Math.round(w * 0.88);\n486\t  let rowPx = rowTop, eventPx = rowTop;\n487\t  for (const l of p.lines) {\n488\t    eventPx = Math.min(eventPx, fitPx(l.event, cEvent.w, eventPx, true));\n489\t    rowPx = Math.min(rowPx, fitPx(l.entryText, tight(cEntry.w), rowPx, false), fitPx(l.finalText, tight(cFinal.w), rowPx, false));\n490\t    if (l.dropText !== \"\") rowPx = Math.min(rowPx, fitPx(l.dropText, tight(cDrop.w), rowPx, l.dropCs !== null));\n491\t  }\n492\t  // The event name is never larger than the times beside it.\n493\t  eventPx = Math.min(eventPx, rowPx);\n494\t  if (rowPx < floor) unfit(`swims (${n} rows)`);\n495\t  const chipPx = p.lines.reduce((px, l) => (l.standard === \"\" ? px : Math.min(px, fitPx(l.standard, cChip.w, px, true))), Math.max(1, Math.round(rowPx * 0.78)));\n496\t  const headPx = [\"EVENT\", \"ENTRY\", \"FINAL\", \"DROP\"].reduce((px, t, i) => Math.min(px, fitPx(t, [cEvent, cEntry, cFinal, cDrop][i].w, px, false)), Math.max(1, Math.min(Math.round(headH * 0.5), rowPx)));\n497\t  const headRect = (c: { x: number; w: number }): SwimRect => ({ x: c.x, y: bandTop, w: c.w, h: headH });\n498\t  line(\"head-event\", headRect(cEvent), \"EVENT\", headPx, { color: dim, floor: small });\n499\t  line(\"head-entry\", headRect(cEntry), \"ENTRY\", headPx, { color: dim, align: \"right\", floor: small });\n500\t  line(\"head-final\", headRect(cFinal), \"FINAL\", headPx, { color: dim, align: \"right\", floor: small });\n501\t  line(\"head-drop\", headRect(cDrop), \"DROP\", headPx, { color: dim, align: \"right\", floor: small });\n502\t\n503\t  const trackColor = mix(theme.bg, theme.ink, 0.13);\n504\t  // The track is tall enough to hold a bar's own number, in both bar modes:\n505\t  // `bar` changes the lengths, the labels and the footnote, not the row's\n506\t  // proportions. Only a percent bar is labelled - in seconds the number is\n507\t  // already on the row, as the drop.\n508\t  const labelled = BAR_LABELS && p.bar === \"percent\";\n509\t  // Never taller than the row's own text: on a card of one or two swims the bar stays a bar, not a slab.\n510\t  const trackH = Math.max(3, BAR_LABELS ? Math.min(Math.round(rowH * (wide ? 0.4 : 0.32)), Math.round(rowPx * 0.9)) : Math.round(rowH * (wide ? 0.26 : 0.13)));\n511\t  const sharePx = Math.max(1, Math.min(Math.round(trackH * 0.78), rowPx));\n512\t  const shareW = labelled ? Math.max(0, ...p.lines.map((l) => (l.share > 0 ? Math.ceil((widthOf(l.shareText, sharePx, true) + 2) / 0.94) + 1 : 0))) : 0;\n513\t  const sharePad = Math.round(trackH * 0.3);\n514\t  const minBar = Math.max(2, Math.round(cTrack.w * 0.01));\n515\t  const chipH = Math.min(Math.round(rowPx * 1.45), Math.round(rowH * 0.46));\n516\t  const rows = p.lines.map((l, i) => {\n517\t    const top = rowsTop + i * rowH;\n518\t    // Square and portrait: the text line ends where the track begins, to the pixel.\n519\t    const trackOff = Math.round(rowH * (BAR_LABELS ? 0.6 : 0.7)), textOff = Math.round(rowH * 0.06);\n520\t    const textRect = wide ? { y: top + Math.round(rowH * 0.12), h: rowH - 2 * Math.round(rowH * 0.12) } : { y: top + textOff, h: Math.min(Math.round(rowH * 0.56), trackOff - textOff) };\n521\t    const cell = (c: { x: number; w: number }): SwimRect => ({ x: c.x, w: c.w, ...textRect });\n522\t    const track: SwimRect = { x: cTrack.x, w: cTrack.w, y: wide ? top + Math.round((rowH - trackH) / 2) : top + trackOff, h: trackH };\n523\t    tiles.push({ label: `track-${i}`, rect: track, color: trackColor, radius: 0.5, layer: 1 });\n524\t    // A bar is drawn for a faster swim only, from the track's left edge. The\n525\t    // floor keeps a real but tiny drop visible; it never invents one.\n526\t    const bar: SwimRect | null = l.share > 0 ? { ...track, w: Math.min(track.w, Math.max(minBar, Math.round(track.w * l.share))) } : null;\n527\t    if (bar) tiles.push({ label: `bar-${i}`, rect: bar, color: p.accent, radius: 0.5, layer: 2 });\n528\t    if (bar && labelled) {\n529\t      // At the bar's end: on the empty track just past it, or inside a bar too long to leave room.\n530\t      const after = bar.w + sharePad + shareW <= track.w;\n531\t      const rect: SwimRect = { x: after ? bar.x + bar.w + sharePad : bar.x + bar.w - sharePad - shareW, y: track.y, w: shareW, h: track.h };\n532\t      line(`share-${i}`, rect, l.shareText, sharePx, { bold: true, align: after ? \"left\" : \"right\", color: after ? ink : onColor(p.accent), over: true, floor: small, field: \"the bar labels\" });\n533\t    }\n534\t    line(`event-${i}`, cell(cEvent), l.event, eventPx, { bold: true, bind: { row: i, field: \"event\" }, field: `swims[${i}].event` });\n535\t    line(`entry-${i}`, cell(cEntry), l.entryText, rowPx, { color: dim, align: \"right\", bind: { row: i, field: \"entry\" } });\n536\t    line(`final-${i}`, cell(cFinal), l.finalText, rowPx, { align: \"right\", bind: { row: i, field: \"final\" } });\n537\t    // The drop is derived (entry - final), so it is not bound. A slower swim's\n538\t    // plus sign is in the same ink as a faster swim's minus: printed, not shouted.\n539\t    if (l.dropText !== \"\") line(`drop-${i}`, cell(cDrop), l.dropText, rowPx, l.dropCs !== null ? { bold: true, align: \"right\" } : { color: dim, align: \"right\" });\n540\t    let chip: SwimRect | null = null;\n541\t    if (l.standard !== \"\") {\n542\t      chip = { x: cChip.x, w: cChip.w, y: textRect.y + Math.round((textRect.h - chipH) / 2), h: chipH };\n543\t      tiles.push({ label: `chip-${i}`, rect: chip, color: p.accent, radius: 0.5, layer: 1 });\n544\t      line(`standard-${i}`, chip, l.standard, chipPx, { bold: true, align: \"center\", color: onColor(p.accent), bind: { row: i, field: \"standard\" }, over: true, floor: small, field: `swims[${i}].standard` });\n545\t    }\n546\t    return { top, track, bar, chip, line: l, labelled: bar !== null && labelled };\n547\t  });\n548\t\n549\t  return { p, theme, wide, cells, tiles, rows, m, floor, small, rowH, rowPx, eventPx, cap, headerBottom, bandTop, bandBottom, footLines: footLines.length, stacked };\n550\t}\n551\t\n552\t/**\n553\t * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n554\t * convention, src/_shared/why.ts): the run, the problem with the sources the\n555\t * agent opened, the solution, how to use it, then the template itself.\n556\t */\n557\tconst WHY: WhySpec = {\n558\t  \"day\": 12,\n559\t  \"date\": \"2026-10-01\",\n560\t  \"agent\": \"claude\",\n561\t  \"model\": \"claude-fable-5.1\",\n562\t  \"id\": \"@one-a-day/sports/swim-time-drop-card/v1\",\n563\t  \"title\": \"Swim Time Drop Card\",\n564\t  \"who\": \"Age-group swim club coaches and parent volunteers who type a recap of time drops and new cuts onto the club GoMotion/TeamUnify site after every meet.\",\n565\t  \"problem\": [\n566\t    \"After every meet the recap is typed by hand. Wave Aquatics lists dozens of lines like \\\"[swimmer] A time 200 Fly, AA time 200 IM\\\", then \\\"Top time drops of the meet: [swimmer] dropped 40 seconds in the 200 Free!\\\". CATCC does the same: \\\"New Nat BB Cuts\\\", then \\\"dropping thirty-three seconds in his 1000 Free\\\".\",\n567\t    \"Maverick Swim Club defines it in writing: \\\"When a swimmer improves upon that baseline time, it is called a time drop\\\", with an award per five drops. The numbers already sit in the file the meet host exports: Hy-Tek Meet Manager writes \\\"both the old CL2 file format and the new HY3 format\\\", and flipturn parses them.\"\n568\t  ],\n569\t  \"sources\": [\n570\t    \"https://www.gomotionapp.com/team/wave/page/news/507024/fall-divisional-meet-recap\",\n571\t    \"https://www.gomotionapp.com/team/catcc/page/news/570837/hvda-scy-bbbc-meet-recap\",\n572\t    \"https://www.mavswim.org/page/celebrations/time-drops\",\n573\t    \"https://hytek.active.com/user_guides_html/swmm6/exportresultstotm.htm\",\n574\t    \"https://github.com/enagon-athletics/flipturn\",\n575\t    \"https://github.com/anedav68/MediaHub\"\n576\t  ],\n577\t  \"solution\": [\n578\t    \"One card per swimmer per meet from the rows a results file holds: event, entry time, final time, plus a standard you supply. Times become integer hundredths; each row prints the drop in seconds with its sign, and the summary counts the faster swims and adds up their drops.\",\n579\t    \"The one decision: a bar says what it measures. Seconds favour long events, so a bar is the share of the entry time dropped, with that percent printed at its end; the longest fills the track. bar \\\"seconds\\\" is one prop away. A slower swim gets a plus sign in the same ink and an empty track - no red.\"\n580\t  ],\n581\t  \"usage\": {\n582\t    \"command\": \"m0saic make @one-a-day/sports/swim-time-drop-card/v1 --template-repo . -w 1080 -h 1080 -o journal/2026-10-01/swim-time-drop-card.png\",\n583\t    \"try\": [\n584\t      \"swims: [{ event, entry, final, standard }] - 1 to 8 rows, times as \\\"31.84\\\" or \\\"1:10.52\\\"\",\n585\t      \"bar \\\"seconds\\\": bars in seconds dropped, the recaps' own unit; the labels go, the footnote changes\",\n586\t      \"entry \\\"NT\\\" (a first swim) or final \\\"DQ\\\": the row is printed, claims nothing and is not counted\",\n587\t      \"accent \\\"#e4572e\\\", preset \\\"light\\\", -w 1920 -h 1080: the club colour, a light page, bars in a column\"\n588\t    ]\n589\t  },\n590\t  \"timeline\": {\n591\t    \"source\": \"runner\",\n592\t    \"phases\": [\n593\t      {\n594\t        \"name\": \"scout\",\n595\t        \"startMs\": 0,\n596\t        \"durMs\": 250040,\n597\t        \"calls\": 26,\n598\t        \"tokens\": 2071821,\n599\t        \"costUsd\": 2.98,\n600\t        \"tools\": \"Bash 9, WebSearch 9, Read 5\"\n601\t      },\n602\t      {\n603\t        \"name\": \"plan\",\n604\t        \"startMs\": 250059,\n605\t        \"durMs\": 240329,\n606\t        \"calls\": 16,\n607\t        \"tokens\": 1600003,\n608\t        \"costUsd\": 2.93,\n609\t        \"tools\": \"Bash 11, Read 4, Write 1\"\n610\t      }\n611\t    ],\n612\t    \"costBasis\": \"reported\"\n613\t  },\n614\t  \"caveats\": [\n615\t    \"It does not read .hy3 or .cl2 files: parse the results yourself (flipturn does) and pass the rows. Standards are not computed either; the default chips are illustrative.\",\n616\t    \"The entry time is the seed, not always the swimmer's fastest earlier swim, so the card says \\\"vs entry time\\\" and claims nothing more.\",\n617\t    \"Eight rows at most (split a long meet across two cards) and no relays: a relay result has no entry time per swimmer.\"\n618\t  ]\n619\t};\n620\t\n621\texport const SwimTimeDropCardV1 = defineMosaicTemplate<SwimTimeDropCardProps>({\n622\t  id: asTemplateId(ID),\n623\t  label: \"2026-10-01 · Swim Time Drop Card\",\n624\t  version: 1,\n625\t  description: \"A swim meet time-drop card for one swimmer: entry time against the time swum per event, the drop in seconds, a bar whose scale the footnote names, and the standard reached.\",\n626\t  capabilities: { tier: \"core\" },\n627\t  tags: [\"sports\", \"2026-10-01\", \"day-012\", \"swimming\", \"time-drop\", \"meet-recap\", \"club\"],\n628\t\n629\t  outputHints: {\n630\t    width: 1080,\n631\t    height: 1080,\n632\t    fps: 30,\n633\t    durationMs: 2000,\n634\t    format: { kind: \"image\", container: \"png\" },\n635\t    note: \"Still PNG. Square and portrait draw each bar under its row; canvases 4:3 and wider put the bars in a column. Minimum tested canvas 480x270.\",\n636\t  },\n637\t\n638\t  propsSchema,\n639\t  defaultProps: DEFAULTS,\n640\t\n641\t  render,\n642\t  renderTutorial: whyTutorial(WHY, render),\n643\t});\n644\t\n645\texport default SwimTimeDropCardV1;\n646\t\n647\tasync function render(props: SwimTimeDropCardProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n648\t  const { width: W, height: H } = ctx.target;\n649\t  const L = layoutSwimCard(props, W, H);\n650\t  const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n651\t  const constraints: LayoutConstraint[] = [];\n652\t\n653\t  // Emitted kind by kind, not row by row: placeInsetPieces puts a rect on the\n654\t  // first overlay layer it does not collide with, so tiles of one kind share\n655\t  // a layer and the chain stays a few layers deep at eight rows.\n656\t  for (const t of [...L.tiles].sort((a, b) => a.layer - b.layer)) {\n657\t    const tile = tag({ ...makeColorTile(t.color, t.radius > 0 ? { effects: { rounding: { cornerStyle: \"rounded\", borderRadius: t.radius } } } : {}) } as MosaicSource, t.label);\n658\t    // `accent` paints the course chip, so that is the rect that shows it.\n659\t    pieces.push({ rect: { ...t.rect, importance: t.layer }, source: t.accent ? bindProp(tile, \"accent\") : tile });\n660\t  }\n661\t  for (const c of L.cells) {\n662\t    const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n663\t    // A text rect is BOUND to the prop it shows; derived text (drops, the summary, the footnote) is not.\n664\t    const source = c.bind === null ? cell : \"prop\" in c.bind ? bindProp(cell, c.bind.prop) : bindPropPath(cell, \"swims\", [c.bind.row, c.bind.field], \"string\");\n665\t    pieces.push({ rect: { ...c.rect, importance: c.over ? 3 : 2 }, source });\n666\t    constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n667\t  }\n668\t\n669\t  // What the geometry promises, against the labels: every text fits its box\n670\t  // (above); the name lives in the top of the card and the summary and the\n671\t  // footnote in the bottom; every row has a track at least a fifth of the\n672\t  // canvas wide, and the tracks are one size; a faster swim has its bar.\n673\t  const has = (label: string) => L.cells.some((c) => c.label === label);\n674\t  constraints.push({ label: \"swimmer\", within: { yFrac: [0, 0.35] } });\n675\t  constraints.push({ label: \"course-chip\", within: { yFrac: [0, 0.35] } });\n676\t  for (const label of [\"summary-count\", \"summary-total\", \"footnote\"]) if (has(label)) constraints.push({ label, within: { yFrac: [0.65, 1] } });\n677\t  constraints.push({ label: \"rule-top\", minWidthFrac: 0.8 }, { label: \"rule-bottom\", minWidthFrac: 0.8, within: { yFrac: [0.6, 1] } });\n678\t  L.rows.forEach((r, i) => {\n679\t    constraints.push({ label: `track-${i}`, minWidthFrac: 0.2 });\n680\t    if (r.bar) constraints.push({ label: `bar-${i}` });\n681\t    if (r.chip) constraints.push({ label: `chip-${i}` });\n682\t  });\n683\t  // A relation compares at least two nodes; a one-swim card has one track and nothing to compare it with.\n684\t  const relations: RelationalConstraint[] = L.rows.length < 2 ? [] : [{ label: L.rows.map((_, i) => `track-${i}`), equal: \"size\", tolerancePx: 2 }];\n685\t\n686\t  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n687\t  const doc: MosaicDocument = {\n688\t    kind: \"mosaic_document\",\n689\t    version: 1,\n690\t    m0: toM0String(placed.m0, ID),\n691\t    assets: {},\n692\t    backgroundColor: L.theme.bg as MosaicColor,\n693\t    sources: placed.sources,\n694\t  };\n695\t  return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: props.debugLayout === true });\n696\t}\n697\t"}]},"parent_tool_use_id":null,"session_id":"3b5f6571-be25-4e81-bc62-381b682f29bf","uuid":"59bb2748-0927-47fa-aa71-6806779f14a8","timestamp":"2026-10-01T14:09:04.356Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-01\\variants\\c\\src\\swim-time-drop-card.ts","content":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, bindPropPath, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag, wrapMeasured } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/sports/swim-time-drop-card/v1` - one swimmer's meet as a card:\n * per event the entry time, the time swum, the drop in seconds, a bar and\n * the standard reached, from the rows a meet results file already holds.\n *\n * ONE CONCEPT: a bar says what it measures. The drop is always PRINTED in\n * seconds (the recaps' own unit), but a card mixes a 50 and a 200, and in\n * seconds the long event always wins. So the bar is one of two stated\n * things - the share of the entry time dropped (`bar: \"percent\"`) or the\n * seconds dropped (`bar: \"seconds\"`) - the longest bar fills the track, a\n * percent bar prints its own number at its end (a bar in percent beside a\n * drop in seconds is two units, and a footnote alone does not carry that),\n * and the footnote names which of the two the bars are.\n *\n * The rule that bites: a slower swim is printed, not drawn. It gets a plus\n * sign in the ordinary ink and an empty track - no red, no bar growing the\n * other way. NT and DQ rows make no claim at all and are not counted. All\n * arithmetic is integer hundredths of a second; nothing is a float until a\n * bar's pixel width.\n */\n\nexport type SwimCourse = \"SCY\" | \"SCM\" | \"LCM\";\nexport type SwimBar = \"percent\" | \"seconds\";\n/** One swim, as a results row gives it. `standard` is the caller's: the template computes none. */\nexport type SwimRow = {\n  /** The event as the club says it: \"50 Free\", \"200 IM\". */\n  event: string;\n  /** Entry (seed) time: \"31.84\", \"1:10.52\", \"19:58.44\"; \"NT\" or \"\" for no time. */\n  entry?: string;\n  /** The time swum, same formats; \"DQ\" for a disqualified swim. */\n  final: string;\n  /** The motivational standard the swim reached, up to 4 characters (\"B\", \"BB\", \"AAAA\"). */\n  standard?: string;\n};\nexport type SwimTimeDropCardProps = {\n  /** The header name. */\n  swimmer?: string;\n  /** Second line; \"\" removes it. */\n  club?: string;\n  /** The meet's name; \"\" removes it. */\n  meet?: string;\n  /** Free line for the date, age group or session; \"\" removes it. */\n  details?: string;\n  /** The course chip: times in different courses do not compare. */\n  course?: SwimCourse;\n  /** The swims, in meet order: 1 to 8 rows. */\n  swims?: SwimRow[];\n  /** What a bar's length means - and the footnote with it. */\n  bar?: SwimBar;\n  /** Bars and chips, as #rrggbb (the club's colour). */\n  accent?: string;\n  /** Page and ink. */\n  preset?: \"dark\" | \"light\";\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/sports/swim-time-drop-card/v1\";\nexport const MAX_SWIMS = 8;\n/** The default draws the share of the entry time; \"seconds\" is one prop away. */\nconst DEFAULT_BAR = \"percent\" as SwimBar;\n/**\n * Variant c: a bar in percent beside a number in seconds asks the reader to\n * hold two units, so each percent bar carries its own number at its end and\n * the track is tall enough to hold it. Off, the track is a thin strip and the\n * footnote alone names the bar's unit (variant a).\n */\nconst BAR_LABELS = true;\nconst DEFAULT_ACCENT = \"#2ec4b6\";\n/** The page is document.backgroundColor, never a full-canvas rect (doctor: canvasFill). */\nconst THEMES = {\n  dark: { bg: \"#0e1b25\", ink: \"#eaf2f5\", dim: \"#8ea3ae\" },\n  light: { bg: \"#f5f9fa\", ink: \"#10222c\", dim: \"#55676f\" },\n} as const;\n\n// An invented swimmer at an invented meet. The chips are illustrative: no age\n// group or sex is named, and they were not checked against a season's table.\nconst DEFAULT_SWIMS: SwimRow[] = [\n  { event: \"50 Free\", entry: \"31.84\", final: \"30.97\", standard: \"BB\" },\n  { event: \"100 Free\", entry: \"1:10.52\", final: \"1:08.31\", standard: \"BB\" },\n  { event: \"200 Free\", entry: \"2:36.40\", final: \"2:29.85\", standard: \"B\" },\n  { event: \"100 Back\", entry: \"1:19.77\", final: \"1:20.19\" },\n  { event: \"50 Fly\", entry: \"36.10\", final: \"34.92\", standard: \"B\" },\n  { event: \"200 IM\", entry: \"2:58.03\", final: \"2:54.02\" },\n];\n\nconst DEFAULTS = {\n  swimmer: \"Tessa Marlow\",\n  club: \"Larkmoor Swim Club\",\n  meet: \"October Kickoff Invitational\",\n  details: \"Oct 3-4, 2026\",\n  course: \"SCY\" as SwimCourse,\n  swims: DEFAULT_SWIMS,\n  bar: DEFAULT_BAR,\n  accent: DEFAULT_ACCENT,\n  preset: \"dark\" as \"dark\" | \"light\",\n  debugLayout: false,\n};\n\nconst propsSchema = definePropsSchema<SwimTimeDropCardProps>({\n  swims: {\n    type: \"list\",\n    required: false,\n    description:\n      'The swimmer\\'s swims in meet order, 1 to 8 rows (split a longer meet across two cards). Each row is what a results row gives: the event, the entry (seed) time and the time swum, as \"31.84\", \"1:10.52\" or \"19:58.44\". An entry of \"NT\" (or empty) is a first swim; a final of \"DQ\" is a disqualification - both are printed, neither is counted.',\n    meta: { constraints: { minItems: 1, maxItems: MAX_SWIMS }, ui: { label: \"Swims\", order: 1, primary: true } },\n    fields: {\n      event: { type: \"string\", required: true, description: 'The event as the club says it: \"50 Free\", \"200 IM\", \"100 Breaststroke\". Up to 24 characters.', meta: { ui: { label: \"Event\" } } },\n      entry: { type: \"string\", required: false, description: 'The entry (seed) time, \"31.84\" or \"1:10.52\". \"NT\" or empty when the swimmer had no time.', meta: { control: { placeholder: \"NT\" }, ui: { label: \"Entry time\" } } },\n      final: { type: \"string\", required: true, description: 'The time swum, in the same formats, or \"DQ\".', meta: { ui: { label: \"Final time\" } } },\n      standard: { type: \"string\", required: false, description: 'The motivational standard this swim reached, up to 4 characters (\"B\", \"BB\", \"AAAA\"). You supply it: the tables change by season, age and sex, and the template computes none.', meta: { control: { placeholder: \"none\" }, ui: { label: \"Standard\" } } },\n    },\n  },\n  swimmer: {\n    type: \"string\",\n    required: false,\n    description: \"The swimmer's name, the largest text on the card. Up to 40 characters; accented Latin letters are drawn. The sample is an invented swimmer.\",\n    meta: { control: { placeholder: DEFAULTS.swimmer }, ui: { label: \"Swimmer\", order: 2, primary: true } },\n  },\n  club: {\n    type: \"string\",\n    required: false,\n    description: \"The club, under the name. Empty removes the line.\",\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"Club\", order: 3 } },\n  },\n  meet: {\n    type: \"string\",\n    required: false,\n    description: \"The meet's name. Empty removes it.\",\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"Meet\", order: 4 } },\n  },\n  details: {\n    type: \"string\",\n    required: false,\n    description: \"A free line for the date, the age group or the session. Empty removes it.\",\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"Details\", order: 5 } },\n  },\n  course: {\n    type: \"string\",\n    required: false,\n    description: 'The course the times were swum in, shown as a chip: \"SCY\" (short course yards), \"SCM\" (short course metres) or \"LCM\" (long course metres). Times in different courses do not compare.',\n    meta: { constraints: { oneOf: [\"SCY\", \"SCM\", \"LCM\"] }, ui: { label: \"Course\", order: 6 } },\n  },\n  bar: {\n    type: \"string\",\n    required: false,\n    description: 'What a bar\\'s length means: \"percent\" (the share of the entry time dropped - fair between a 50 and a 200; each bar prints its percent at its end) or \"seconds\" (the seconds dropped, the number already printed on the row - the long events dominate). The longest bar fills its track either way, and the footnote says which it is.',\n    meta: { constraints: { oneOf: [\"percent\", \"seconds\"] }, ui: { label: \"Bar shows\", order: 7 } },\n  },\n  accent: {\n    type: \"string\",\n    required: false,\n    description: \"The club's colour, as #rrggbb: the bars, the course chip and the standard chips.\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 8 } },\n  },\n  preset: {\n    type: \"string\",\n    required: false,\n    description: 'Page and ink: \"dark\" (default) or \"light\".',\n    meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 9 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits its box, every row has a track, the tracks are one size) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n/* ── the arithmetic: pure, exported, and what the test asserts ── */\n\nfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n\n/** \"31.84\", \"1:10.52\", \"19:58.44\" -> integer hundredths of a second; null when it is not a time. */\nexport function parseSwimTime(text: string): number | null {\n  const m = /^(?:(\\d{1,2}):([0-5]\\d)|(\\d{1,2}))\\.(\\d{2})$/.exec(text);\n  if (!m) return null;\n  const cs = m[1] !== undefined ? (Number(m[1]) * 60 + Number(m[2])) * 100 + Number(m[4]) : Number(m[3]) * 100 + Number(m[4]);\n  return cs > 0 ? cs : null;\n}\n\n/** Hundredths back to the way a results sheet prints them: SS.hh under a minute, M:SS.hh above. */\nexport function formatSwimTime(cs: number): string {\n  const two = (n: number) => String(n).padStart(2, \"0\");\n  const min = Math.floor(cs / 6000), sec = Math.floor((cs % 6000) / 100), hun = cs % 100;\n  return min > 0 ? `${min}:${two(sec)}.${two(hun)}` : `${sec}.${two(hun)}`;\n}\n\n/** drop = entry - final, with its sign: \"-0.87\" faster, \"+0.42\" slower, \"0.00\" equal. ASCII hyphen-minus. */\nexport function formatSwimDrop(dropCs: number): string {\n  return dropCs > 0 ? `-${formatSwimTime(dropCs)}` : dropCs < 0 ? `+${formatSwimTime(-dropCs)}` : \"0.00\";\n}\n\n/**\n * The share of the entry time dropped, to a tenth of a percent, rounded half\n * up in integers. A real drop too small to round to 0.1% says so: \"0.0%\"\n * beside a bar would read as no drop at all.\n */\nexport function formatSwimShare(dropCs: number, entryCs: number): string {\n  const tenths = Math.floor((2000 * dropCs + entryCs) / (2 * entryCs));\n  return tenths === 0 && dropCs > 0 ? \"<0.1%\" : `${Math.floor(tenths / 10)}.${tenths % 10}%`;\n}\n\n/**\n * Printable ASCII plus the accented Latin letters (Latin-1 and Latin\n * Extended-A, U+00C0-U+017F without the two maths signs). The bundled font\n * has a glyph for every one of them in both weights - the test walks the\n * range - so a Zoe with a diaeresis is drawn, and anything else is refused\n * by name instead of rendering as tofu.\n */\nconst DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\nfunction text(value: unknown, field: string, min: number, max: number): string {\n  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n  if (!DRAWN.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII and accented Latin letters (U+00C0-U+017F).`);\n  const s = value.trim();\n  if (s.length < min) fail(field, \"must not be blank.\");\n  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n  return s;\n}\n\nexport type SwimLine = {\n  event: string;\n  /** Hundredths; null = no entry time (NT). */\n  entryCs: number | null;\n  /** Hundredths; null = DQ. */\n  finalCs: number | null;\n  entryText: string;\n  finalText: string;\n  /** entry - final in hundredths; null when either time is missing. */\n  dropCs: number | null;\n  /** \"-0.87\", \"+0.42\", \"0.00\", \"first swim\" for an NT entry, \"\" for a DQ. */\n  dropText: string;\n  standard: string;\n  /** The bar as a share of its track, 0..1; 0 = no bar (slower, equal, NT, DQ). */\n  share: number;\n  /** The share of the entry time dropped (\"2.7%\") for a faster swim; \"\" otherwise. */\n  shareText: string;\n};\n\n/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\nexport function normalizeSwimCard(props: SwimTimeDropCardProps) {\n  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n  const swimmer = text(p.swimmer, \"swimmer\", 1, 40);\n  const club = text(p.club, \"club\", 0, 48);\n  const meet = text(p.meet, \"meet\", 0, 48);\n  const details = text(p.details, \"details\", 0, 48);\n  if (p.course !== \"SCY\" && p.course !== \"SCM\" && p.course !== \"LCM\") fail(\"course\", `${JSON.stringify(p.course)} must be \"SCY\", \"SCM\" or \"LCM\".`);\n  if (p.bar !== \"percent\" && p.bar !== \"seconds\") fail(\"bar\", `${JSON.stringify(p.bar)} must be \"percent\" or \"seconds\".`);\n  if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n  if (typeof p.accent !== \"string\" || !/^#[0-9a-fA-F]{6}$/.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n  if (!Array.isArray(p.swims) || p.swims.length === 0) fail(\"swims\", \"must hold at least one { event, entry, final }.\");\n  if (p.swims.length > MAX_SWIMS) fail(\"swims\", `has ${p.swims.length} rows; one card holds at most ${MAX_SWIMS} - split the meet across two cards.`);\n  const bar = p.bar as SwimBar;\n\n  const lines: SwimLine[] = p.swims.map((row, i) => {\n    const at = `swims[${i}]`;\n    if (!row || typeof row !== \"object\" || Array.isArray(row)) fail(at, \"must be an object { event, entry, final, standard? }.\");\n    const event = text(row.event, `${at}.event`, 1, 24);\n    const entryRaw = row.entry === undefined ? \"\" : text(row.entry, `${at}.entry`, 0, 12);\n    if (row.final === undefined) fail(`${at}.final`, 'is missing: give the time swum, or \"DQ\".');\n    const finalRaw = text(row.final, `${at}.final`, 1, 12);\n    const standard = row.standard === undefined ? \"\" : text(row.standard, `${at}.standard`, 0, 12);\n    if (standard.length > 4) fail(`${at}.standard`, `${JSON.stringify(standard)} is longer than 4 characters (\"B\", \"BB\", \"AAAA\").`);\n    if (/\\s/.test(standard)) fail(`${at}.standard`, `${JSON.stringify(standard)} must not contain a space.`);\n    const noTime = entryRaw === \"\" || entryRaw.toUpperCase() === \"NT\";\n    const dq = finalRaw.toUpperCase() === \"DQ\";\n    const entryCs = noTime ? null : parseSwimTime(entryRaw);\n    const finalCs = dq ? null : parseSwimTime(finalRaw);\n    if (!noTime && entryCs === null) fail(`${at}.entry`, `${JSON.stringify(entryRaw)} is not a time: write \"31.84\" or \"1:10.52\", or \"NT\" for no entry time.`);\n    if (!dq && finalCs === null) fail(`${at}.final`, `${JSON.stringify(finalRaw)} is not a time: write \"30.97\" or \"1:08.31\", or \"DQ\".`);\n    if (dq && standard !== \"\") fail(`${at}.standard`, `${JSON.stringify(standard)} is set on a DQ: a disqualified swim has no time and reaches no standard.`);\n    const dropCs = entryCs !== null && finalCs !== null ? entryCs - finalCs : null;\n    return {\n      event, entryCs, finalCs,\n      entryText: entryCs === null ? \"NT\" : formatSwimTime(entryCs),\n      finalText: finalCs === null ? \"DQ\" : formatSwimTime(finalCs),\n      dropCs,\n      dropText: dropCs !== null ? formatSwimDrop(dropCs) : finalCs !== null ? \"first swim\" : \"\",\n      standard, share: 0,\n      shareText: dropCs !== null && dropCs > 0 ? formatSwimShare(dropCs, entryCs as number) : \"\",\n    };\n  });\n\n  // The scale: the largest drop on THIS card fills the track. Bars compare one\n  // swimmer's swims with each other, never swimmers with each other. Fractions\n  // are compared by cross-multiplication, so the choice of the longest is exact.\n  const num = (l: SwimLine) => l.dropCs as number;\n  const den = (l: SwimLine) => (bar === \"percent\" ? (l.entryCs as number) : 1);\n  const faster = lines.filter((l) => l.dropCs !== null && l.dropCs > 0);\n  const longest = faster.reduce<SwimLine | null>((best, l) => (best === null || num(l) * den(best) > num(best) * den(l) ? l : best), null);\n  if (longest) for (const l of faster) l.share = (num(l) * den(longest)) / (den(l) * num(longest));\n\n  const compared = lines.filter((l) => l.dropCs !== null).length;\n  const totalCs = faster.reduce((sum, l) => sum + num(l), 0);\n  const countText = compared === 0 ? \"No times to compare\" : `${faster.length} of ${compared} ${compared === 1 ? \"swim\" : \"swims\"} faster`;\n  // Slower swims are not netted against the total: each is printed on its own row.\n  const totalText = faster.length === 0 ? \"\" : totalCs < 6000 ? `${formatSwimTime(totalCs)} s dropped` : `${formatSwimTime(totalCs)} dropped`;\n  const scaleText = longest === null ? \"\"\n    : bar === \"percent\" ? formatSwimShare(num(longest), longest.entryCs as number)\n    : num(longest) < 6000 ? `${formatSwimTime(num(longest))} s` : formatSwimTime(num(longest));\n  const footnote = compared === 0 ? \"vs entry time. A first swim or a DQ has no drop to show.\"\n    : longest === null ? \"vs entry time. No swim was faster, so no bar is drawn.\"\n    : bar === \"percent\" && BAR_LABELS ? \"vs entry time. Bars and their percentages: share of the entry time dropped.\"\n    : bar === \"percent\" ? `vs entry time. Bars: share of the entry time dropped; the longest is ${scaleText}.`\n    : `vs entry time. Bars: seconds dropped; the longest is ${scaleText}.`;\n\n  return {\n    swimmer, club, meet, details, course: p.course as SwimCourse, bar, preset: p.preset as \"dark\" | \"light\",\n    accent: p.accent.trim().toLowerCase() as MosaicColor, debugLayout: p.debugLayout,\n    lines, faster: faster.length, compared, totalCs, countText, totalText, scaleText, footnote,\n  };\n}\n\n/* ── colour ── */\n\n// Not exported: the pack index is `export *`, and dev/bench-delta already exports a `mix`.\nfunction mix(a: string, b: string, t: number): MosaicColor {\n  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n}\nfunction luminance(hex: string): number {\n  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n}\n/** The readable ink over a filled chip: dark or white, whichever contrasts more with the caller's accent. */\nfunction onColor(fill: string): MosaicColor {\n  const ratio = (other: string) => { const a = luminance(fill), b = luminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n  return (ratio(\"#0b1220\") >= ratio(\"#ffffff\") ? \"#0b1220\" : \"#ffffff\") as MosaicColor;\n}\n\n/* ── geometry ── */\n\nexport type SwimRect = { x: number; y: number; w: number; h: number };\ntype Bind = { prop: \"swimmer\" | \"club\" | \"meet\" | \"details\" } | { row: number; field: \"event\" | \"entry\" | \"final\" | \"standard\" } | null;\ntype Cell = { label: string; rect: SwimRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\ntype Tile = { label: string; rect: SwimRect; color: MosaicColor; radius: number; layer: number; accent?: boolean };\n\n/** The largest whole size up to `maxPx` at which one line fits the cell's budget (`cell * 0.94 - 2px`). */\nfunction fitPx(line: string, cellW: number, maxPx: number, bold: boolean): number {\n  const top = Math.max(1, Math.round(maxPx));\n  const room = budget(cellW), w = widthOf(line, top, bold);\n  let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n  while (px > 1 && widthOf(line, px, bold) > room) px--;\n  return px;\n}\n\n/** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\nexport function layoutSwimCard(props: SwimTimeDropCardProps, W: number, H: number) {\n  const p = normalizeSwimCard(props);\n  const theme = THEMES[p.preset];\n  const ink = theme.ink as MosaicColor, dim = theme.dim as MosaicColor;\n  const S = Math.min(W, H);\n  // Wide canvases put the bar in a column; square and portrait need the width\n  // for the text cells, so the bar becomes a strip under the row's text line.\n  const wide = W * 3 >= H * 4;\n  const k = wide ? 1 : Math.max(1, Math.min(1.25, H / W));\n  const m = Math.round(S * 0.055), CW = W - 2 * m;\n  const gap = Math.round(S * 0.022);\n  const rule = Math.max(1, Math.round(S * 0.0025));\n  // Below these sizes copy is refused, not shrunk further: the row text and the\n  // header at 1.8% of the short side, the chrome (heads, chips, footnote) at 1.3%.\n  const floor = Math.max(6, Math.round(S * 0.018)), small = Math.max(5, Math.round(S * 0.013));\n  const cells: Cell[] = [];\n  const tiles: Tile[] = [];\n  const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n  /** One fitted line in `rect`; refuses below the floor instead of clipping. */\n  const line = (label: string, rect: SwimRect, value: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string; floor?: number } = {}) => {\n    if (px < (o.floor ?? floor)) unfit(o.field ?? label);\n    cells.push({ label, rect, text: value, px, width: widthOf(value, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? ink, bind: o.bind ?? null, over: o.over === true });\n  };\n\n  // ── header: the name is the largest text; the course chip sits top right ──\n  const right = p.meet !== \"\" || p.details !== \"\";\n  let headerBottom: number;\n  if (wide) {\n    const hH = Math.round((H - 2 * m) * 0.21);\n    const chipH = Math.round(hH * 0.3), chipW = Math.round(chipH * 2.3);\n    const leftW = right ? Math.round(CW * 0.56) : CW - chipW - gap;\n    const rightX = m + leftW + gap, rightW = CW - leftW - gap;\n    const nameH = Math.round(hH * 0.62), subY = m + Math.round(hH * 0.68), subH = m + hH - subY;\n    const midY = m + Math.round(hH * 0.36), midH = subY - midY;\n    line(\"swimmer\", { x: m, y: m, w: leftW, h: nameH }, p.swimmer, fitPx(p.swimmer, leftW, nameH * 0.74, true), { bold: true, bind: { prop: \"swimmer\" } });\n    const subPx = Math.min(...[[p.club, leftW], [p.meet, rightW], [p.details, rightW]].map(([t, w]) => (t === \"\" ? Infinity : fitPx(t as string, w as number, subH * 0.6, false))), Math.round(subH * 0.6));\n    if (p.club !== \"\") line(\"club\", { x: m, y: subY, w: leftW, h: subH }, p.club, subPx, { color: dim, bind: { prop: \"club\" } });\n    if (p.meet !== \"\") line(\"meet\", { x: rightX, y: midY, w: rightW, h: midH }, p.meet, subPx, { color: dim, align: \"right\", bind: { prop: \"meet\" } });\n    if (p.details !== \"\") line(\"details\", { x: rightX, y: subY, w: rightW, h: subH }, p.details, subPx, { color: dim, align: \"right\", bind: { prop: \"details\" } });\n    tiles.push({ label: \"course-chip\", rect: { x: W - m - chipW, y: m, w: chipW, h: chipH }, color: p.accent, radius: 0.5, layer: 1, accent: true });\n    headerBottom = m + hH;\n  } else {\n    const nameH = Math.round(S * 0.085 * k), lineH = Math.round(S * 0.044 * k);\n    const chipH = Math.round(nameH * 0.56), chipW = Math.round(chipH * 2.3);\n    const nameW = CW - chipW - gap;\n    line(\"swimmer\", { x: m, y: m, w: nameW, h: nameH }, p.swimmer, fitPx(p.swimmer, nameW, nameH * 0.74, true), { bold: true, bind: { prop: \"swimmer\" } });\n    tiles.push({ label: \"course-chip\", rect: { x: W - m - chipW, y: m + Math.round((nameH - chipH) / 2), w: chipW, h: chipH }, color: p.accent, radius: 0.5, layer: 1, accent: true });\n    // The club on its own line. The meet and the details share the next one,\n    // split by what each needs, while both fit there at the full size; a long\n    // pair takes a line each rather than shrinking to share one.\n    const subTop = Math.round(lineH * 0.62);\n    const meetNeed = widthOf(p.meet, subTop), detailsNeed = widthOf(p.details, subTop);\n    const both = p.meet !== \"\" && p.details !== \"\";\n    const shared = both && Math.ceil((meetNeed + 2) / 0.94) + Math.ceil((detailsNeed + 2) / 0.94) + 2 * gap <= CW;\n    const detailsW = !both || !shared ? CW : Math.ceil((detailsNeed + 2) / 0.94) + 1, meetW = !both || !shared ? CW : CW - detailsW - 2 * gap;\n    const subPx = Math.min(...[[p.club, CW], [p.meet, meetW], [p.details, detailsW]].map(([t, w]) => (t === \"\" ? Infinity : fitPx(t as string, w as number, subTop, false))), subTop);\n    let y = m + nameH;\n    if (p.club !== \"\") { line(\"club\", { x: m, y, w: CW, h: lineH }, p.club, subPx, { color: dim, bind: { prop: \"club\" } }); y += lineH; }\n    if (p.meet !== \"\") { line(\"meet\", { x: m, y, w: meetW, h: lineH }, p.meet, subPx, { color: dim, bind: { prop: \"meet\" } }); if (!shared) y += lineH; }\n    if (p.details !== \"\") { line(\"details\", { x: W - m - detailsW, y, w: detailsW, h: lineH }, p.details, subPx, { color: dim, align: shared ? \"right\" : \"left\", bind: { prop: \"details\" } }); y += lineH; }\n    headerBottom = y;\n  }\n  const courseChip = tiles[0].rect;\n  line(\"course\", courseChip, p.course, fitPx(p.course, courseChip.w, courseChip.h * 0.5, true), { bold: true, align: \"center\", color: onColor(p.accent), over: true, floor: small });\n\n  // ── summary band, built from the bottom up: count and total, then the footnote that carries the honesty ──\n  const footTop = Math.round(S * 0.025 * k);\n  const oneLine = fitPx(p.footnote, CW, footTop, false);\n  let footPx = oneLine, footLines = [p.footnote];\n  if (oneLine < footTop * 0.9) {\n    // Two lines at the target size beat one shrunken line; shrink only when two do not hold it.\n    footPx = footTop;\n    footLines = wrapMeasured(p.footnote, footPx, budget(CW));\n    while (footLines.length > 2 && footPx > 1) { footPx--; footLines = wrapMeasured(p.footnote, footPx, budget(CW)); }\n  }\n  if (footPx < small) unfit(\"footnote\");\n  const footLineH = Math.round(footPx * 1.4), footH = footLines.length * footLineH + 2;\n  const footRect: SwimRect = { x: m, y: H - m - footH, w: CW, h: footH };\n  cells.push({ label: \"footnote\", rect: footRect, text: footLines.join(\"\\n\"), px: footPx, width: Math.max(...footLines.map((l) => widthOf(l, footPx))), bold: false, align: \"left\", color: dim, bind: null, over: false });\n\n  const sumTop = Math.round(S * 0.05 * k);\n  const countW = Math.round(CW * 0.58), totalW = CW - countW - gap;\n  const sidePx = Math.min(fitPx(p.countText, p.totalText === \"\" ? CW : countW, sumTop, true), p.totalText === \"\" ? Infinity : fitPx(p.totalText, totalW, sumTop, true));\n  // Side by side while that keeps the size; stacked when the pair would have to shrink (portrait).\n  const stacked = p.totalText !== \"\" && sidePx < sumTop * 0.85;\n  const sumPx = stacked ? Math.min(fitPx(p.countText, CW, sumTop, true), fitPx(p.totalText, CW, sumTop, true)) : sidePx;\n  const sumRowH = Math.round(sumPx * 1.45);\n  const sumY = footRect.y - Math.round(S * 0.008) - (stacked ? 2 : 1) * sumRowH;\n  if (stacked) {\n    line(\"summary-count\", { x: m, y: sumY, w: CW, h: sumRowH }, p.countText, sumPx, { bold: true, field: \"the summary\" });\n    line(\"summary-total\", { x: m, y: sumY + sumRowH, w: CW, h: sumRowH }, p.totalText, sumPx, { bold: true, field: \"the summary\" });\n  } else {\n    line(\"summary-count\", { x: m, y: sumY, w: p.totalText === \"\" ? CW : countW, h: sumRowH }, p.countText, sumPx, { bold: true, field: \"the summary\" });\n    if (p.totalText !== \"\") line(\"summary-total\", { x: W - m - totalW, y: sumY, w: totalW, h: sumRowH }, p.totalText, sumPx, { bold: true, align: \"right\", field: \"the summary\" });\n  }\n  const line2 = mix(theme.bg, theme.ink, 0.22);\n  const ruleBottomY = sumY - Math.round(gap * 0.6) - rule;\n  tiles.push({ label: \"rule-top\", rect: { x: m, y: headerBottom + Math.round(gap * 0.5), w: CW, h: rule }, color: line2, radius: 0, layer: 1 });\n  tiles.push({ label: \"rule-bottom\", rect: { x: m, y: ruleBottomY, w: CW, h: rule }, color: line2, radius: 0, layer: 1 });\n\n  // ── the rows: a column-head line, then one row per swim in meet order ──\n  const n = p.lines.length;\n  const bandTop = headerBottom + gap + rule, bandBottom = ruleBottomY - Math.round(gap * 0.5);\n  const headH = Math.round(S * 0.04 * k);\n  const rowsTop = bandTop + headH;\n  // The cap keeps one or two swims from turning into slabs; the group sits at the top of its band.\n  const cap = Math.round(S * (wide ? 0.105 : 0.135 * k));\n  const rowH = Math.min(cap, Math.floor((bandBottom - rowsTop) / n));\n  // Column widths are fractions of the content width, the same in every row,\n  // so a row without a chip keeps the space and the decimal points stack.\n  const g = Math.round(CW * (wide ? 0.012 : 0.01));\n  const frac = wide ? { event: 0.22, entry: 0.12, final: 0.12, track: 0.28, drop: 0.13 } : { event: 0.27, entry: 0.19, final: 0.19, track: 0, drop: 0.19 };\n  const col = (x: number, f: number) => ({ x, w: Math.round(CW * f) });\n  const cEvent = col(m, frac.event);\n  const cEntry = col(cEvent.x + cEvent.w + g, frac.entry);\n  const cFinal = col(cEntry.x + cEntry.w + g, frac.final);\n  const cTrack = wide ? col(cFinal.x + cFinal.w + g, frac.track) : { x: m, w: CW };\n  const cDrop = col(wide ? cTrack.x + cTrack.w + g : cFinal.x + cFinal.w + g, frac.drop);\n  const cChip = { x: cDrop.x + cDrop.w + g, w: W - m - (cDrop.x + cDrop.w + g) };\n\n  // One size for every time on the card and one for every event name: a long\n  // event name shrinks the event column, never the numbers beside it.\n  // The times are fitted to 88% of their column, so two neighbouring\n  // times always keep a gutter; the row text never outgrows the summary.\n  const rowTop = Math.min(Math.round(rowH * (wide ? 0.46 : 0.4)), Math.round(S * 0.04 * k));\n  const tight = (w: number) => Math.round(w * 0.88);\n  let rowPx = rowTop, eventPx = rowTop;\n  for (const l of p.lines) {\n    eventPx = Math.min(eventPx, fitPx(l.event, cEvent.w, eventPx, true));\n    rowPx = Math.min(rowPx, fitPx(l.entryText, tight(cEntry.w), rowPx, false), fitPx(l.finalText, tight(cFinal.w), rowPx, false));\n    if (l.dropText !== \"\") rowPx = Math.min(rowPx, fitPx(l.dropText, tight(cDrop.w), rowPx, l.dropCs !== null));\n  }\n  // The event name is never larger than the times beside it.\n  eventPx = Math.min(eventPx, rowPx);\n  if (rowPx < floor) unfit(`swims (${n} rows)`);\n  const chipPx = p.lines.reduce((px, l) => (l.standard === \"\" ? px : Math.min(px, fitPx(l.standard, cChip.w, px, true))), Math.max(1, Math.round(rowPx * 0.78)));\n  const headPx = [\"EVENT\", \"ENTRY\", \"FINAL\", \"DROP\"].reduce((px, t, i) => Math.min(px, fitPx(t, [cEvent, cEntry, cFinal, cDrop][i].w, px, false)), Math.max(1, Math.min(Math.round(headH * 0.5), rowPx)));\n  const headRect = (c: { x: number; w: number }): SwimRect => ({ x: c.x, y: bandTop, w: c.w, h: headH });\n  line(\"head-event\", headRect(cEvent), \"EVENT\", headPx, { color: dim, floor: small });\n  line(\"head-entry\", headRect(cEntry), \"ENTRY\", headPx, { color: dim, align: \"right\", floor: small });\n  line(\"head-final\", headRect(cFinal), \"FINAL\", headPx, { color: dim, align: \"right\", floor: small });\n  line(\"head-drop\", headRect(cDrop), \"DROP\", headPx, { color: dim, align: \"right\", floor: small });\n\n  const trackColor = mix(theme.bg, theme.ink, 0.13);\n  // The track is tall enough to hold a bar's own number, in both bar modes:\n  // `bar` changes the lengths, the labels and the footnote, not the row's\n  // proportions. Only a percent bar is labelled - in seconds the number is\n  // already on the row, as the drop.\n  const labelled = BAR_LABELS && p.bar === \"percent\";\n  // Never taller than the row's own text: on a card of one or two swims the bar stays a bar, not a slab.\n  const trackH = Math.max(3, BAR_LABELS ? Math.min(Math.round(rowH * (wide ? 0.4 : 0.32)), Math.round(rowPx * 0.9)) : Math.round(rowH * (wide ? 0.26 : 0.13)));\n  const sharePx = Math.max(1, Math.min(Math.round(trackH * 0.78), rowPx));\n  const shareW = labelled ? Math.max(0, ...p.lines.map((l) => (l.share > 0 ? Math.ceil((widthOf(l.shareText, sharePx, true) + 2) / 0.94) + 1 : 0))) : 0;\n  const sharePad = Math.round(trackH * 0.3);\n  const minBar = Math.max(2, Math.round(cTrack.w * 0.01));\n  const chipH = Math.min(Math.round(rowPx * 1.45), Math.round(rowH * 0.46));\n  const rows = p.lines.map((l, i) => {\n    const top = rowsTop + i * rowH;\n    // Square and portrait: the text line ends where the track begins, to the pixel.\n    const trackOff = Math.round(rowH * (BAR_LABELS ? 0.6 : 0.7)), textOff = Math.round(rowH * 0.06);\n    const textRect = wide ? { y: top + Math.round(rowH * 0.12), h: rowH - 2 * Math.round(rowH * 0.12) } : { y: top + textOff, h: Math.min(Math.round(rowH * 0.56), trackOff - textOff) };\n    const cell = (c: { x: number; w: number }): SwimRect => ({ x: c.x, w: c.w, ...textRect });\n    const track: SwimRect = { x: cTrack.x, w: cTrack.w, y: wide ? top + Math.round((rowH - trackH) / 2) : top + trackOff, h: trackH };\n    tiles.push({ label: `track-${i}`, rect: track, color: trackColor, radius: 0.5, layer: 1 });\n    // A bar is drawn for a faster swim only, from the track's left edge. The\n    // floor keeps a real but tiny drop visible; it never invents one.\n    const bar: SwimRect | null = l.share > 0 ? { ...track, w: Math.min(track.w, Math.max(minBar, Math.round(track.w * l.share))) } : null;\n    if (bar) tiles.push({ label: `bar-${i}`, rect: bar, color: p.accent, radius: 0.5, layer: 2 });\n    if (bar && labelled) {\n      // At the bar's end: on the empty track just past it, or inside a bar too long to leave room.\n      const after = bar.w + sharePad + shareW <= track.w;\n      const rect: SwimRect = { x: after ? bar.x + bar.w + sharePad : bar.x + bar.w - sharePad - shareW, y: track.y, w: shareW, h: track.h };\n      line(`share-${i}`, rect, l.shareText, sharePx, { bold: true, align: after ? \"left\" : \"right\", color: after ? ink : onColor(p.accent), over: true, floor: small, field: \"the bar labels\" });\n    }\n    line(`event-${i}`, cell(cEvent), l.event, eventPx, { bold: true, bind: { row: i, field: \"event\" }, field: `swims[${i}].event` });\n    line(`entry-${i}`, cell(cEntry), l.entryText, rowPx, { color: dim, align: \"right\", bind: { row: i, field: \"entry\" } });\n    line(`final-${i}`, cell(cFinal), l.finalText, rowPx, { align: \"right\", bind: { row: i, field: \"final\" } });\n    // The drop is derived (entry - final), so it is not bound. A slower swim's\n    // plus sign is in the same ink as a faster swim's minus: printed, not shouted.\n    if (l.dropText !== \"\") line(`drop-${i}`, cell(cDrop), l.dropText, rowPx, l.dropCs !== null ? { bold: true, align: \"right\" } : { color: dim, align: \"right\" });\n    let chip: SwimRect | null = null;\n    if (l.standard !== \"\") {\n      chip = { x: cChip.x, w: cChip.w, y: textRect.y + Math.round((textRect.h - chipH) / 2), h: chipH };\n      tiles.push({ label: `chip-${i}`, rect: chip, color: p.accent, radius: 0.5, layer: 1 });\n      line(`standard-${i}`, chip, l.standard, chipPx, { bold: true, align: \"center\", color: onColor(p.accent), bind: { row: i, field: \"standard\" }, over: true, floor: small, field: `swims[${i}].standard` });\n    }\n    return { top, track, bar, chip, line: l, labelled: bar !== null && labelled };\n  });\n\n  return { p, theme, wide, cells, tiles, rows, m, floor, small, rowH, rowPx, eventPx, cap, headerBottom, bandTop, bandBottom, footLines: footLines.length, stacked };\n}\n\n/**\n * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n * convention, src/_shared/why.ts): the run, the problem with the sources the\n * agent opened, the solution, how to use it, then the template itself.\n */\nconst WHY: WhySpec = {\n  \"day\": 12,\n  \"date\": \"2026-10-01\",\n  \"agent\": \"claude\",\n  \"model\": \"claude-fable-5.1\",\n  \"id\": \"@one-a-day/sports/swim-time-drop-card/v1\",\n  \"title\": \"Swim Time Drop Card\",\n  \"who\": \"Age-group swim club coaches and parent volunteers who type a recap of time drops and new cuts onto the club GoMotion/TeamUnify site after every meet.\",\n  \"problem\": [\n    \"After every meet the recap is typed by hand. Wave Aquatics lists dozens of lines like \\\"[swimmer] A time 200 Fly, AA time 200 IM\\\", then \\\"Top time drops of the meet: [swimmer] dropped 40 seconds in the 200 Free!\\\". CATCC does the same: \\\"New Nat BB Cuts\\\", then \\\"dropping thirty-three seconds in his 1000 Free\\\".\",\n    \"Maverick Swim Club defines it in writing: \\\"When a swimmer improves upon that baseline time, it is called a time drop\\\", with an award per five drops. The numbers already sit in the file the meet host exports: Hy-Tek Meet Manager writes \\\"both the old CL2 file format and the new HY3 format\\\", and flipturn parses them.\"\n  ],\n  \"sources\": [\n    \"https://www.gomotionapp.com/team/wave/page/news/507024/fall-divisional-meet-recap\",\n    \"https://www.gomotionapp.com/team/catcc/page/news/570837/hvda-scy-bbbc-meet-recap\",\n    \"https://www.mavswim.org/page/celebrations/time-drops\",\n    \"https://hytek.active.com/user_guides_html/swmm6/exportresultstotm.htm\",\n    \"https://github.com/enagon-athletics/flipturn\",\n    \"https://github.com/anedav68/MediaHub\"\n  ],\n  \"solution\": [\n    \"One card per swimmer per meet from the rows a results file holds: event, entry time, final time, plus a standard you supply. Times become integer hundredths; each row prints the drop in seconds with its sign, and the summary counts the faster swims and adds up their drops.\",\n    \"The one decision: a bar says what it measures. Seconds favour long events, so a bar is the share of the entry time dropped, with that percent printed at its end; the longest fills the track. bar \\\"seconds\\\" is one prop away. A slower swim gets a plus sign in the same ink and an empty track - no red.\"\n  ],\n  \"usage\": {\n    \"command\": \"m0saic make @one-a-day/sports/swim-time-drop-card/v1 --template-repo . -w 1080 -h 1080 -o journal/2026-10-01/swim-time-drop-card.png\",\n    \"try\": [\n      \"swims: [{ event, entry, final, standard }] - 1 to 8 rows, times as \\\"31.84\\\" or \\\"1:10.52\\\"\",\n      \"bar \\\"seconds\\\": bars in seconds dropped, the recaps' own unit; the labels go, the footnote changes\",\n      \"entry \\\"NT\\\" (a first swim) or final \\\"DQ\\\": the row is printed, claims nothing and is not counted\",\n      \"accent \\\"#e4572e\\\", preset \\\"light\\\", -w 1920 -h 1080: the club colour, a light page, bars in a column\"\n    ]\n  },\n  \"timeline\": {\n    \"source\": \"runner\",\n    \"phases\": [\n      {\n        \"name\": \"scout\",\n        \"startMs\": 0,\n        \"durMs\": 250040,\n        \"calls\": 26,\n        \"tokens\": 2071821,\n        \"costUsd\": 2.98,\n        \"tools\": \"Bash 9, WebSearch 9, Read 5\"\n      },\n      {\n        \"name\": \"plan\",\n        \"startMs\": 250059,\n        \"durMs\": 240329,\n        \"calls\": 16,\n        \"tokens\": 1600003,\n        \"costUsd\": 2.93,\n        \"tools\": \"Bash 11, Read 4, Write 1\"\n      }\n    ],\n    \"costBasis\": \"reported\"\n  },\n  \"caveats\": [\n    \"It does not read .hy3 or .cl2 files: parse the results yourself (flipturn does) and pass the rows. Standards are not computed either; the default chips are illustrative.\",\n    \"The entry time is the seed, not always the swimmer's fastest earlier swim, so the card says \\\"vs entry time\\\" and claims nothing more.\",\n    \"Eight rows at most (split a long meet across two cards) and no relays: a relay result has no entry time per swimmer.\"\n  ]\n};\n\nexport const SwimTimeDropCardV1 = defineMosaicTemplate<SwimTimeDropCardProps>({\n  id: asTemplateId(ID),\n  label: \"2026-10-01 · Swim Time Drop Card\",\n  version: 1,\n  description: \"A swim meet time-drop card for one swimmer: entry time against the time swum per event, the drop in seconds, a bar whose scale the footnote names, and the standard reached.\",\n  capabilities: { tier: \"core\" },\n  tags: [\"sports\", \"2026-10-01\", \"day-012\", \"swimming\", \"time-drop\", \"meet-recap\", \"club\"],\n\n  outputHints: {\n    width: 1080,\n    height: 1080,\n    fps: 30,\n    durationMs: 2000,\n    format: { kind: \"image\", container: \"png\" },\n    note: \"Still PNG. Square and portrait draw each bar under its row; canvases 4:3 and wider put the bars in a column. Minimum tested canvas 480x270.\",\n  },\n\n  propsSchema,\n  defaultProps: DEFAULTS,\n\n  render,\n  renderTutorial: whyTutorial(WHY, render),\n});\n\nexport default SwimTimeDropCardV1;\n\nasync function render(props: SwimTimeDropCardProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n  const { width: W, height: H } = ctx.target;\n  const L = layoutSwimCard(props, W, H);\n  const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n  const constraints: LayoutConstraint[] = [];\n\n  // Emitted kind by kind, not row by row: placeInsetPieces puts a rect on the\n  // first overlay layer it does not collide with, so tiles of one kind share\n  // a layer and the chain stays a few layers deep at eight rows.\n  for (const t of [...L.tiles].sort((a, b) => a.layer - b.layer)) {\n    const tile = tag({ ...makeColorTile(t.color, t.radius > 0 ? { effects: { rounding: { cornerStyle: \"rounded\", borderRadius: t.radius } } } : {}) } as MosaicSource, t.label);\n    // `accent` paints the course chip, so that is the rect that shows it.\n    pieces.push({ rect: { ...t.rect, importance: t.layer }, source: t.accent ? bindProp(tile, \"accent\") : tile });\n  }\n  for (const c of L.cells) {\n    const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n    // A text rect is BOUND to the prop it shows; derived text (drops, the summary, the footnote) is not.\n    const source = c.bind === null ? cell : \"prop\" in c.bind ? bindProp(cell, c.bind.prop) : bindPropPath(cell, \"swims\", [c.bind.row, c.bind.field], \"string\");\n    pieces.push({ rect: { ...c.rect, importance: c.over ? 3 : 2 }, source });\n    constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n  }\n\n  // What the geometry promises, against the labels: every text fits its box\n  // (above); the name lives in the top of the card and the summary and the\n  // footnote in the bottom; every row has a track at least a fifth of the\n  // canvas wide, and the tracks are one size; a faster swim has its bar.\n  const has = (label: string) => L.cells.some((c) => c.label === label);\n  constraints.push({ label: \"swimmer\", within: { yFrac: [0, 0.35] } });\n  constraints.push({ label: \"course-chip\", within: { yFrac: [0, 0.35] } });\n  for (const label of [\"summary-count\", \"summary-total\", \"footnote\"]) if (has(label)) constraints.push({ label, within: { yFrac: [0.65, 1] } });\n  constraints.push({ label: \"rule-top\", minWidthFrac: 0.8 }, { label: \"rule-bottom\", minWidthFrac: 0.8, within: { yFrac: [0.6, 1] } });\n  L.rows.forEach((r, i) => {\n    constraints.push({ label: `track-${i}`, minWidthFrac: 0.2 });\n    if (r.bar) constraints.push({ label: `bar-${i}` });\n    if (r.chip) constraints.push({ label: `chip-${i}` });\n  });\n  // A relation compares at least two nodes; a one-swim card has one track and nothing to compare it with.\n  const relations: RelationalConstraint[] = L.rows.length < 2 ? [] : [{ label: L.rows.map((_, i) => `track-${i}`), equal: \"size\", tolerancePx: 2 }];\n\n  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n  const doc: MosaicDocument = {\n    kind: \"mosaic_document\",\n    version: 1,\n    m0: toM0String(placed.m0, ID),\n    assets: {},\n    backgroundColor: L.theme.bg as MosaicColor,\n    sources: placed.sources,\n  };\n  return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: props.debugLayout === true });\n}\n","numLines":697,"startLine":1,"totalLines":697}}}
