{"type":"tool_use","timestamp":1792679824254,"sessionID":"ses_e9bf6d764ffeDptE8dPE6jK8gv","part":{"type":"tool","tool":"read","callID":"read:19","state":{"status":"completed","input":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-22\\variants\\a\\src\\frc-event-recap.ts"},"output":"<path>C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-22\\variants\\a\\src\\frc-event-recap.ts</path>\n<type>file</type>\n<content>\n1: import type {\n2:   MosaicColor,\n3:   MosaicDocument,\n4:   MosaicEngineContext,\n5:   MosaicSource,\n6: } from \"@m0saic/types\";\n7: import { asTemplateId } from \"@m0saic/types\";\n8: import { toM0String } from \"@m0saic/dsl-stdlib\";\n9: import {\n10:   bindProp,\n11:   bindPropPath,\n12:   defineMosaicTemplate,\n13:   definePropsSchema,\n14:   makeColorTile,\n15:   placeInsetPieces,\n16:   tag,\n17: } from \"@m0saic/template-utils\";\n18: import type { LayoutConstraint } from \"@m0saic/template-utils\";\n19: import { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n20: import { budget, fitLine, textCell, widthOf } from \"../../../_shared/text\";\n21: import { whyTutorial } from \"../../../_shared/why\";\n22: import type { WhySpec } from \"../../../_shared/why\";\n23: \n24: /**\n25:  * `@one-a-day/sports/frc-event-recap/v1` - an FRC event recap card from the\n26:  * fields The Blue Alliance publishes for a team at an event: the team number\n27:  * as the card's identity, the event and week, the qual rank with the team\n28:  * count, the W-L-T record, the alliance selection and playoff finish as\n29:  * chips, up to three award lines, and the district points in the footer. One\n30:  * deterministic card per event, for the recap posts team media students\n31:  * already write after every tournament.\n32:  *\n33:  * ONE CONCEPT: **the card derives what it can and constrains the rest to The\n34:  * Blue Alliance's own vocabulary.** Rank, team count, record and district\n35:  * points are numbers, validated in `render()`; the alliance and playoff\n36:  * chips come from closed enums (captain / 1st pick / 2nd pick, alliance 1-8;\n37:  * winner / finalist / semifinalist / quarterfinalist) so their text always\n38:  * fits; awards are the one free text on the card, capped at three lines and\n39:  * shrunk to fit above the floor, never ellipsized.\n40:  *\n41:  * The rule that bites: **qualRank above a non-zero teamCount is refused.** A\n42:  * card that says \"RANK 12 of 10 teams\" is lying, and a recap graphic nobody\n43:  * trusts is worse than none.\n44:  */\n45: \n46: export type FrcAllianceRole = \"captain\" | \"pick1\" | \"pick2\" | \"none\";\n47: export type FrcPlayoffResult = \"winner\" | \"finalist\" | \"semifinalist\" | \"quarterfinalist\" | \"none\";\n48: \n49: export type FrcEventRecapProps = {\n50:   /** The team number - the hero line \"TEAM 9128\" (1-99999). */\n51:   teamNumber?: number;\n52:   /** The team nickname, printed in caps under the number. Up to 30 ASCII characters; \"\" removes the line. */\n53:   teamName?: string;\n54:   /** The event name as The Blue Alliance has it (\"Harbor City District\"). Up to 40 ASCII characters. */\n55:   eventName?: string;\n56:   /** Printed after the event name, \" - \" joined: \"Week 4\", \"DCMP\", \"Offseason\". Up to 20 ASCII characters; \"\" removes it. */\n57:   weekLabel?: string;\n58:   /** The qualification rank (1-200). Above teamCount (when set) is refused. */\n59:   qualRank?: number;\n60:   /** The teams at the event, for the \"of 48 teams\" line under the rank (0-200; 0 hides the line). */\n61:   teamCount?: number;\n62:   /** The qualification record as W-L-T digits, e.g. \"17-0-0\". */\n63:   record?: string;\n64:   /** The alliance-selection chip: \"captain\" / \"pick1\" / \"pick2\" (\"CAPTAIN - ALLIANCE N\", \"1ST PICK - ALLIANCE N\", \"2ND PICK - ALLIANCE N\"); \"none\" hides it. */\n65:   allianceRole?: FrcAllianceRole;\n66:   /** The N on the alliance chip (1-8; ignored when the role is \"none\"). */\n67:   allianceNumber?: number;\n68:   /** The playoff chip: \"winner\" (\"EVENT WINNER\") / \"finalist\" / \"semifinalist\" / \"quarterfinalist\"; \"none\" hides it. */\n69:   playoffResult?: FrcPlayoffResult;\n70:   /** 0-3 award lines (TBA award names run long): each up to 60 ASCII characters, shrunk to fit. */\n71:   awards?: string[] | string;\n72:   /** District points, the footer-left \"78 DISTRICT POINTS\" (0-999; 0 hides it - regionals and offseason events earn none). */\n73:   districtPoints?: number;\n74:   /** The one accent - the header rule, the chip outlines, the award ticks - as #rrggbb. */\n75:   accent?: string;\n76:   /** Dev-only: check the layout contract and draw it over the card. */\n77:   debugLayout?: boolean;\n78: };\n79: \n80: const ID = \"@one-a-day/sports/frc-event-recap/v1\";\n81: const HEX = /^#[0-9a-fA-F]{6}$/;\n82: /** Printable ASCII: what the bundled font is guaranteed to draw. */\n83: const ASCII = /^[\\x20-\\x7e]*$/;\n84: \n85: const PAGE = \"#0d131c\" as MosaicColor;\n86: const INK = \"#eef3f9\" as MosaicColor;\n87: const DIM = \"#8d9bb0\" as MosaicColor;\n88: \n89: const HEADER_LABEL = \"FRC EVENT RECAP\";\n90: const RECORD_SUB = \"W - L - T\";\n91: const CREDIT = \"DATA: THE BLUE ALLIANCE\";\n92: const AWARDS_LABEL = \"AWARDS\";\n93: \n94: const DEFAULTS = {\n95:   teamNumber: 9128,\n96:   teamName: \"\",\n97:   eventName: \"Harbor City District\",\n98:   weekLabel: \"Week 4\",\n99:   qualRank: 1,\n100:   teamCount: 48,\n101:   record: \"17-0-0\",\n102:   allianceRole: \"captain\" as FrcAllianceRole,\n103:   allianceNumber: 1,\n104:   playoffResult: \"winner\" as FrcPlayoffResult,\n105:   awards: [\"Innovation in Control Award\"],\n106:   districtPoints: 78,\n107:   accent: \"#2f7bff\",\n108:   debugLayout: false,\n109: };\n110: \n111: const PROPS = Object.keys(DEFAULTS);\n112: \n113: const propsSchema = definePropsSchema<FrcEventRecapProps>({\n114:   teamNumber: {\n115:     type: \"number\",\n116:     required: false,\n117:     description: \"The team number - the hero line \\\"TEAM 9128\\\" (1-99999). Every FRC team is known by its number.\",\n118:     meta: { constraints: { min: 1, max: 99999 }, control: { placeholder: String(DEFAULTS.teamNumber) }, ui: { label: \"Team number\", order: 1, primary: true } },\n119:   },\n120:   teamName: {\n121:     type: \"string\",\n122:     required: false,\n123:     description: \"The team nickname, printed in caps under the number. Up to 30 ASCII characters; empty removes the line (the default renders the number only, like the TBA page).\",\n124:     meta: { control: { placeholder: \"Iron Panthers\" }, ui: { label: \"Team name\", order: 2 } },\n125:   },\n126:   eventName: {\n127:     type: \"string\",\n128:     required: false,\n129:     description: \"The event name as The Blue Alliance has it. Up to 40 ASCII characters; the sample event is invented.\",\n130:     meta: { control: { placeholder: DEFAULTS.eventName }, ui: { label: \"Event\", order: 3, primary: true } },\n131:   },\n132:   weekLabel: {\n133:     type: \"string\",\n134:     required: false,\n135:     description: 'Printed after the event name, \" - \" joined: \"Week 4\", \"DCMP\", \"Offseason\". Up to 20 ASCII characters; empty removes it.',\n136:     meta: { control: { placeholder: DEFAULTS.weekLabel }, ui: { label: \"Week\", order: 4 } },\n137:   },\n138:   qualRank: {\n139:     type: \"number\",\n140:     required: false,\n141:     description: \"The qualification rank (1-200) - the left hero figure. A rank above teamCount (when that is set) is refused: the card would be lying.\",\n142:     meta: { constraints: { min: 1, max: 200 }, control: { placeholder: String(DEFAULTS.qualRank) }, ui: { label: \"Qual rank\", order: 5, primary: true } },\n143:   },\n144:   teamCount: {\n145:     type: \"number\",\n146:     required: false,\n147:     description: 'The teams at the event, for the \"of 48 teams\" line under the rank (0-200); 0 hides the line.',\n148:     meta: { constraints: { min: 0, max: 200 }, control: { placeholder: String(DEFAULTS.teamCount) }, ui: { label: \"Team count\", order: 6 } },\n149:   },\n150:   record: {\n151:     type: \"string\",\n152:     required: false,\n153:     description: 'The qualification record as W-L-T digits, e.g. \"17-0-0\" - the right hero figure.',\n154:     meta: { control: { placeholder: DEFAULTS.record }, ui: { label: \"Record (W-L-T)\", order: 7, primary: true } },\n155:   },\n156:   allianceRole: {\n157:     type: \"string\",\n158:     required: false,\n159:     description: 'The alliance-selection chip: \"captain\", \"pick1\" or \"pick2\" (printed \"CAPTAIN - ALLIANCE N\" / \"1ST PICK - ALLIANCE N\" / \"2ND PICK - ALLIANCE N\"); \"none\" hides the chip.',\n160:     meta: { constraints: { oneOf: [\"captain\", \"pick1\", \"pick2\", \"none\"] }, ui: { label: \"Alliance selection\", order: 8 } },\n161:   },\n162:   allianceNumber: {\n163:     type: \"number\",\n164:     required: false,\n165:     description: 'The alliance number on the chip (1-8); ignored when the role is \"none\".',\n166:     meta: { constraints: { min: 1, max: 8 }, control: { placeholder: String(DEFAULTS.allianceNumber) }, ui: { label: \"Alliance number\", order: 9 } },\n167:   },\n168:   playoffResult: {\n169:     type: \"string\",\n170:     required: false,\n171:     description: 'The playoff chip: \"winner\" (EVENT WINNER), \"finalist\", \"semifinalist\" or \"quarterfinalist\"; \"none\" hides it.',\n172:     meta: { constraints: { oneOf: [\"winner\", \"finalist\", \"semifinalist\", \"quarterfinalist\", \"none\"] }, ui: { label: \"Playoff finish\", order: 10 } },\n173:   },\n174:   awards: {\n175:     type: \"json\",\n176:     required: false,\n177:     description: 'Up to three award lines as The Blue Alliance names them (its names run long): each up to 60 ASCII characters, shrunk to fit, never ellipsized. Example: [\"Innovation in Control Award\", \"Excellence in Engineering Award\"].',\n178:     meta: {\n179:       constraints: { jsonSchema: { type: \"array\", maxItems: 3, items: { type: \"string\", maxLength: 60 } } },\n180:       control: { mono: true, placeholder: '[\"Innovation in Control Award\"]' },\n181:       ui: { label: \"Awards\", order: 11 },\n182:     },\n183:   },\n184:   districtPoints: {\n185:     type: \"number\",\n186:     required: false,\n187:     description: 'District points - the footer-left \"78 DISTRICT POINTS\" (0-999); 0 hides it (regionals and offseason events earn none).',\n188:     meta: { constraints: { min: 0, max: 999 }, control: { placeholder: String(DEFAULTS.districtPoints) }, ui: { label: \"District points\", order: 12 } },\n189:   },\n190:   accent: {\n191:     type: \"string\",\n192:     required: false,\n193:     description: \"The one accent - the header rule, the chip outlines, the award ticks - as #rrggbb. The default is a The-Blue-Alliance-ish blue.\",\n194:     meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULTS.accent }, ui: { label: \"Accent\", order: 13 } },\n195:   },\n196:   debugLayout: {\n197:     type: \"boolean\",\n198:     required: false,\n199:     description: \"Dev-only: check the layout contract (every text fits, the team number holds the top band, the footer holds the bottom) and draw it over the card.\",\n200:     meta: { ui: { label: \"Debug layout\", order: 99 } },\n201:   },\n202: });\n203: \n204: /* ── derived copy: TBA's own vocabulary, never hand-typed at render ── */\n205: \n206: /** The alliance chip's text, or \"\" when the team was not selected. */\n207: export function allianceChipText(role: FrcAllianceRole, allianceNumber: number): string {\n208:   if (role === \"none\") return \"\";\n209:   const head = role === \"captain\" ? \"CAPTAIN\" : role === \"pick1\" ? \"1ST PICK\" : \"2ND PICK\";\n210:   return `${head} - ALLIANCE ${allianceNumber}`;\n211: }\n212: \n213: /** The playoff chip's text, or \"\" when the team did not make the playoffs. */\n214: export function playoffChipText(result: FrcPlayoffResult): string {\n215:   if (result === \"winner\") return \"EVENT WINNER\";\n216:   if (result === \"finalist\") return \"FINALIST\";\n217:   if (result === \"semifinalist\") return \"SEMIFINALIST\";\n218:   if (result === \"quarterfinalist\") return \"QUARTERFINALIST\";\n219:   return \"\";\n220: }\n221: \n222: /** The record as printed - validated W-L-T digits, then as-is. Throws naming the prop. */\n223: export function recordText(wlt: string): string {\n224:   const s = wlt.trim();\n225:   if (!/^\\d{1,3}-\\d{1,3}-\\d{1,3}$/.test(s)) {\n226:     throw new Error(`${ID}: record ${JSON.stringify(wlt)} must be W-L-T digits like \"17-0-0\" (wins-losses-ties).`);\n227:   }\n228:   return s;\n229: }\n230: \n231: /** The line under the rank: \"\" when the team count is not given. */\n232: export function rankSub(teamCount: number): string {\n233:   if (teamCount <= 0) return \"\";\n234:   return `of ${teamCount} team${teamCount === 1 ? \"\" : \"s\"}`;\n235: }\n236: \n237: /* ── the gate: render() refuses impossible input by name ── */\n238: \n239: function fail(field: string, rule: string): never {\n240:   throw new Error(`${ID}: ${field} ${rule}`);\n241: }\n242: \n243: /** Edit distance, for \"did you mean\" on a misspelled prop. */\n244: function distance(a: string, b: string): number {\n245:   const d = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array<number>(b.length).fill(0)]);\n246:   for (let j = 1; j <= b.length; j++) d[0][j] = j;\n247:   for (let i = 1; i <= a.length; i++) for (let j = 1; j <= b.length; j++) d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));\n248:   return d[a.length][b.length];\n249: }\n250: \n251: function pickText(value: unknown, field: string, max: number): string {\n252:   if (typeof value !== \"string\") fail(field, `must be a string, got ${JSON.stringify(value)}.`);\n253:   const s = value.trim();\n254:   const bad = [...s].find((ch) => !ASCII.test(ch));\n255:   if (bad !== undefined) fail(field, `${JSON.stringify(s)} has the character ${JSON.stringify(bad)} (U+${bad.codePointAt(0)!.toString(16).toUpperCase().padStart(4, \"0\")}), which the card's font does not draw: use printable ASCII.`);\n256:   if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card allows at most ${max}.`);\n257:   return s;\n258: }\n259: \n260: function pickWhole(value: unknown, field: string, min: number, max: number): number {\n261:   const n = typeof value === \"string\" && value.trim() !== \"\" ? Number(value) : value;\n262:   if (typeof n !== \"number\" || !Number.isFinite(n)) fail(field, `must be a number, got ${JSON.stringify(value)}.`);\n263:   if (!Number.isInteger(n)) fail(field, `must be a whole number, got ${JSON.stringify(value)}.`);\n264:   if (n < min || n > max) fail(field, `must be from ${min} to ${max}, got ${JSON.stringify(value)}.`);\n265:   return n;\n266: }\n267: \n268: function pickOne<T extends string>(value: unknown, options: readonly T[], field: string): T {\n269:   if (typeof value !== \"string\" || !(options as readonly string[]).includes(value)) {\n270:     fail(field, `must be one of ${options.map((o) => `\"${o}\"`).join(\", \")}; got ${JSON.stringify(value)}.`);\n271:   }\n272:   return value as T;\n273: }\n274: \n275: function pickAwards(value: unknown): string[] {\n276:   let v = value;\n277:   if (typeof v === \"string\") {\n278:     const raw = v;\n279:     try { v = JSON.parse(raw); } catch { fail(\"awards\", `is not valid JSON: ${JSON.stringify(raw.slice(0, 60))}. Pass a list like [\"Innovation in Control Award\"].`); }\n280:   }\n281:   if (!Array.isArray(v)) fail(\"awards\", 'must be a list of award names, e.g. [\"Innovation in Control Award\"].');\n282:   if (v.length > 3) fail(\"awards\", `has ${v.length} lines; the card holds at most 3.`);\n283:   return v.map((a, i) => {\n284:     if (typeof a !== \"string\") fail(\"awards\", `line ${i + 1} must be a string, got ${JSON.stringify(a)}.`);\n285:     return pickText(a, `awards line ${i + 1}`, 60);\n286:   }).filter((a) => a.length > 0);\n287: }\n288: \n289: export type FrcRecapModel = {\n290:   teamNumber: number;\n291:   /** \"TEAM 9128\" - the top-of-card identity. */\n292:   teamLine: string;\n293:   /** The nickname in caps, or \"\" (line removed). */\n294:   teamName: string;\n295:   eventName: string;\n296:   weekLabel: string;\n297:   /** \"Harbor City District - Week 4\" or whichever parts are set; \"\" removes the line. */\n298:   eventLine: string;\n299:   qualRank: number;\n300:   teamCount: number;\n301:   /** \"RANK 1\" - the left hero figure. */\n302:   rankBig: string;\n303:   /** \"of 48 teams\" or \"\". */\n304:   rankSubText: string;\n305:   record: string;\n306:   allianceChip: string;\n307:   playoffChip: string;\n308:   awards: string[];\n309:   districtPoints: number;\n310:   /** \"78 DISTRICT POINTS\" or \"\". */\n311:   pointsText: string;\n312:   accent: MosaicColor;\n313: };\n314: \n315: export function normalizeFrcEventRecap(props: FrcEventRecapProps): FrcRecapModel {\n316:   for (const k of Object.keys(props ?? {})) {\n317:     if (PROPS.includes(k)) continue;\n318:     const near = PROPS.find((n) => distance(n.toLowerCase(), k.toLowerCase()) <= 2);\n319:     fail(\"props\", `has an unknown prop '${k}'${near ? `; did you mean '${near}'?` : \".\"} The props are ${PROPS.join(\", \")}.`);\n320:   }\n321:   const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n322: \n323:   const teamNumber = pickWhole(p.teamNumber, \"teamNumber\", 1, 99999);\n324:   const teamNameRaw = pickText(p.teamName, \"teamName\", 30);\n325:   const eventName = pickText(p.eventName, \"eventName\", 40);\n326:   const weekLabel = pickText(p.weekLabel, \"weekLabel\", 20);\n327:   const qualRank = pickWhole(p.qualRank, \"qualRank\", 1, 200);\n328:   const teamCount = pickWhole(p.teamCount, \"teamCount\", 0, 200);\n329:   if (teamCount > 0 && qualRank > teamCount) {\n330:     fail(\"qualRank\", `is ${qualRank} but teamCount is ${teamCount} - a rank cannot be above the number of teams at the event.`);\n331:   }\n332:   const record = recordText(String(p.record ?? \"\"));\n333:   const allianceRole = pickOne<FrcAllianceRole>(p.allianceRole, [\"captain\", \"pick1\", \"pick2\", \"none\"], \"allianceRole\");\n334:   const playoffResult = pickOne<FrcPlayoffResult>(p.playoffResult, [\"winner\", \"finalist\", \"semifinalist\", \"quarterfinalist\", \"none\"], \"playoffResult\");\n335:   let allianceNumber = DEFAULTS.allianceNumber;\n336:   if (allianceRole !== \"none\") allianceNumber = pickWhole(p.allianceNumber, \"allianceNumber\", 1, 8);\n337:   const awards = pickAwards(p.awards);\n338:   const districtPoints = pickWhole(p.districtPoints, \"districtPoints\", 0, 999);\n339:   if (typeof p.accent !== \"string\" || !HEX.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n340:   if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n341: \n342:   const teamName = teamNameRaw.toUpperCase();\n343:   const eventLine = [eventName, weekLabel].filter((s) => s.length > 0).join(\" - \");\n344:   return {\n345:     teamNumber,\n346:     teamLine: `TEAM ${teamNumber}`,\n347:     teamName,\n348:     eventName,\n349:     weekLabel,\n350:     eventLine,\n351:     qualRank,\n352:     teamCount,\n353:     rankBig: `RANK ${qualRank}`,\n354:     rankSubText: rankSub(teamCount),\n355:     record,\n356:     allianceChip: allianceChipText(allianceRole, allianceNumber),\n357:     playoffChip: playoffChipText(playoffResult),\n358:     awards,\n359:     districtPoints,\n360:     pointsText: districtPoints > 0 ? `${districtPoints} DISTRICT POINTS` : \"\",\n361:     accent: p.accent.trim().toLowerCase() as MosaicColor,\n362:   };\n363: }\n364: \n365: /* ── geometry: a pure function of the model and the canvas ── */\n366: \n367: export type FrcRect = { x: number; y: number; w: number; h: number };\n368: export type FrcFit = { text: string; px: number; width: number };\n369: export type FrcChip = { key: \"alliance\" | \"playoff\"; label: \"alliance-chip\" | \"playoff-chip\"; box: FrcRect; inner: FrcRect; text: FrcFit; textRect: FrcRect };\n370: export type FrcAwardLine = { index: number; text: FrcFit; textRect: FrcRect; tickRect: FrcRect };\n371: \n372: export type FrcLayout = {\n373:   W: number;\n374:   H: number;\n375:   S: number;\n376:   landscape: boolean;\n377:   label: FrcFit;\n378:   labelRect: FrcRect;\n379:   ruleRect: FrcRect;\n380:   team: FrcFit;\n381:   teamRect: FrcRect;\n382:   name: FrcFit | null;\n383:   nameRect: FrcRect | null;\n384:   event: FrcFit | null;\n385:   eventRect: FrcRect | null;\n386:   /** The \" - Week 4\" suffix, its own source so the week prop gets its own binding. */\n387:   week: FrcFit | null;\n388:   weekRect: FrcRect | null;\n389:   rankBig: FrcFit;\n390:   rankBigRect: FrcRect;\n391:   rankSub: FrcFit | null;\n392:   rankSubRect: FrcRect | null;\n393:   recordBig: FrcFit;\n394:   recordBigRect: FrcRect;\n395:   recordSub: FrcFit;\n396:   recordSubRect: FrcRect;\n397:   chips: FrcChip[];\n398:   awardsLabel: FrcFit | null;\n399:   awardsLabelRect: FrcRect | null;\n400:   awards: FrcAwardLine[];\n401:   points: FrcFit | null;\n402:   pointsRect: FrcRect | null;\n403:   credit: FrcFit;\n404:   creditRect: FrcRect;\n405: };\n406: \n407: /** One line, shrunk until it fits its budget; at the floor it must fit - the card never ellipsizes. */\n408: function fitOne(text: string, maxW: number, maxPx: number, minPx: number, bold = false): FrcFit {\n409:   const px = fitLine(text, maxW, maxPx, minPx, bold);\n410:   return { text, px, width: widthOf(text, px, bold) };\n411: }\n412: \n413: /**\n414:  * The whole card as rects and measured fits. Square and portrait stack five\n415:  * bands (header, hero, chips, awards, footer); landscape puts header and hero\n416:  * in a left column, chips and awards in a right one, the footer full-width.\n417:  * The test asserts bands and fits without parsing m0.\n418:  */\n419: export function layoutFrc(m: FrcRecapModel, W: number, H: number): FrcLayout {\n420:   const S = Math.min(W, H);\n421:   const landscape = W >= 1.25 * H;\n422:   const margin = Math.max(6, Math.round(0.05 * S));\n423:   const gap = Math.max(4, Math.round(0.025 * S));\n424:   const minPx = Math.max(5, Math.round(0.013 * S));\n425:   const contentW = Math.max(40, W - 2 * margin);\n426: \n427:   // The columns: everything is full-width, or landscape's left/right split.\n428:   const leftW = landscape ? Math.round(0.48 * contentW) : contentW;\n429:   const rightX = margin + leftW + 2 * gap;\n430:   const rightW = landscape ? Math.max(24, W - margin - rightX) : contentW;\n431: \n432:   // ── the header: label + accent rule, TEAM N, the name, the event ──\n433:   const label = fitOne(HEADER_LABEL, budget(Math.round(0.55 * leftW)), Math.round(0.026 * S), minPx, true);\n434:   const labelH = Math.max(1, Math.round(1.6 * label.px));\n435:   const labelRect: FrcRect = { x: margin, y: margin, w: Math.max(8, Math.ceil(label.width / 0.94) + 4), h: labelH };\n436:   const ruleH = Math.max(2, Math.round(0.006 * S));\n437:   const ruleX = labelRect.x + labelRect.w + Math.round(0.7 * gap);\n438:   const ruleRect: FrcRect = { x: ruleX, y: margin + Math.round((labelH - ruleH) / 2), w: Math.max(8, margin + leftW - ruleX), h: ruleH };\n439: \n440:   let hy = margin + labelH + Math.round(0.5 * gap);\n441:   const team = fitOne(m.teamLine, budget(leftW), Math.round(0.095 * S), minPx, true);\n442:   const teamH = Math.max(1, Math.round(1.3 * team.px));\n443:   const teamRect: FrcRect = { x: margin, y: hy, w: leftW, h: teamH };\n444:   hy += teamH + Math.round(0.25 * gap);\n445: \n446:   let name: FrcFit | null = null;\n447:   let nameRect: FrcRect | null = null;\n448:   if (m.teamName !== \"\") {\n449:     name = fitOne(m.teamName, budget(leftW), Math.round(0.034 * S), minPx, true);\n450:     const nameH = Math.max(1, Math.round(1.5 * name.px));\n451:     nameRect = { x: margin, y: hy, w: leftW, h: nameH };\n452:     hy += nameH + Math.round(0.25 * gap);\n453:   }\n454:   let event: FrcFit | null = null;\n455:   let eventRect: FrcRect | null = null;\n456:   let week: FrcFit | null = null;\n457:   let weekRect: FrcRect | null = null;\n458:   if (m.eventLine !== \"\") {\n459:     // One size for the whole line, then the event and the week as two adjacent\n460:     // sources (each binds the prop it shows).\n461:     const eventPx = fitLine(m.eventLine, budget(leftW), Math.round(0.038 * S), minPx);\n462:     const eventH = Math.max(1, Math.round(1.5 * eventPx));\n463:     if (m.eventName !== \"\") {\n464:       event = { text: m.eventName, px: eventPx, width: widthOf(m.eventName, eventPx) };\n465:       eventRect = { x: margin, y: hy, w: Math.max(8, Math.ceil(event.width * 1.04) + 4), h: eventH };\n466:     }\n467:     if (m.weekLabel !== \"\") {\n468:       const weekText = m.eventName !== \"\" ? ` - ${m.weekLabel}` : m.weekLabel;\n469:       week = { text: weekText, px: eventPx, width: widthOf(weekText, eventPx) };\n470:       weekRect = { x: margin + (eventRect ? eventRect.w : 0), y: hy, w: Math.max(8, Math.ceil(week.width / 0.94) + 4), h: eventH };\n471:     }\n472:     hy += eventH;\n473:   }\n474:   const headerBottom = hy;\n475: \n476:   // ── the hero pair: RANK N (of N teams) and the record - one shared size ──\n477:   const heroCap = Math.round(0.08 * S);\n478:   const subCap = Math.round(0.026 * S);\n479:   const bigPx = Math.min(\n480:     fitLine(m.rankBig, budget(landscape ? leftW : Math.round((contentW - gap) / 2)), heroCap, minPx, true),\n481:     fitLine(m.record, budget(landscape ? leftW : Math.round((contentW - gap) / 2)), heroCap, minPx, true),\n482:   );\n483:   const rankBig: FrcFit = { text: m.rankBig, px: bigPx, width: widthOf(m.rankBig, bigPx, true) };\n484:   const recordBig: FrcFit = { text: m.record, px: bigPx, width: widthOf(m.record, bigPx, true) };\n485:   const subPx = Math.min(\n486:     m.rankSubText !== \"\" ? fitLine(m.rankSubText, budget(contentW), subCap, minPx) : subCap,\n487:     fitLine(RECORD_SUB, budget(contentW), subCap, minPx),\n488:   );\n489:   const rankSub: FrcFit | null = m.rankSubText !== \"\" ? { text: m.rankSubText, px: subPx, width: widthOf(m.rankSubText, subPx) } : null;\n490:   const recordSub: FrcFit = { text: RECORD_SUB, px: subPx, width: widthOf(RECORD_SUB, subPx) };\n491:   const bigH = Math.max(1, Math.round(1.25 * bigPx));\n492:   const subH = Math.max(1, Math.round(1.5 * subPx));\n493:   const heroCellH = bigH + Math.round(0.3 * gap) + subH;\n494: \n495:   // ── the chips: one shared size, accent outline, page fill ──\n496:   const chipTexts: Array<{ key: \"alliance\" | \"playoff\"; label: \"alliance-chip\" | \"playoff-chip\"; text: string }> = [];\n497:   if (m.allianceChip !== \"\") chipTexts.push({ key: \"alliance\", label: \"alliance-chip\", text: m.allianceChip });\n498:   if (m.playoffChip !== \"\") chipTexts.push({ key: \"playoff\", label: \"playoff-chip\", text: m.playoffChip });\n499:   const ring = Math.max(2, Math.round(0.004 * S));\n500:   const chipColW = landscape ? rightW : contentW;\n501:   let chipPx = Math.round(0.03 * S);\n502:   for (const c of chipTexts) chipPx = Math.min(chipPx, fitLine(c.text, budget(chipColW - 2 * ring - 2 * Math.round(0.7 * chipPx)), chipPx, minPx, true));\n503:   const chipPadX = chipTexts.length > 0 ? Math.max(3, Math.round(0.7 * chipPx)) : 0;\n504:   const chipPadY = chipTexts.length > 0 ? Math.max(2, Math.round(0.5 * chipPx)) : 0;\n505:   const chipH = chipTexts.length > 0 ? Math.max(1, Math.round(1.3 * chipPx) + 2 * chipPadY + 2 * ring) : 0;\n506:   const chipGapY = Math.round(0.6 * gap);\n507:   const chipsBlockH = chipTexts.length === 0 ? 0 : landscape ? chipTexts.length * chipH + (chipTexts.length - 1) * chipGapY : chipH;\n508: \n509:   // ── the awards: a label and 0-3 lines, one shared size, an accent tick each ──\n510:   let awardsLabel: FrcFit | null = null;\n511:   let awardsLabelH = 0;\n512:   let awardPx = Math.round(0.03 * S);\n513:   if (m.awards.length > 0) {\n514:     const awardColW = landscape ? rightW : contentW;\n515:     awardsLabel = fitOne(AWARDS_LABEL, budget(awardColW), Math.round(0.024 * S), minPx, true);\n516:     awardsLabelH = Math.max(1, Math.round(1.6 * awardsLabel.px));\n517:     const tickSide0 = Math.max(3, Math.round(0.5 * awardPx));\n518:     const tickGap0 = Math.max(3, Math.round(0.5 * awardPx));\n519:     for (const a of m.awards) awardPx = Math.min(awardPx, fitLine(a, budget(awardColW - tickSide0 - tickGap0), awardPx, minPx));\n520:   }\n521:   const tickSide = m.awards.length > 0 ? Math.max(3, Math.round(0.5 * awardPx)) : 0;\n522:   const tickGap = m.awards.length > 0 ? Math.max(3, Math.round(0.5 * awardPx)) : 0;\n523:   const awardLineH = m.awards.length > 0 ? Math.max(1, Math.round(1.5 * awardPx)) : 0;\n524:   const awardLineGap = Math.round(0.2 * gap);\n525:   const awardsBlockH = m.awards.length === 0 ? 0 : awardsLabelH + Math.round(0.3 * gap) + m.awards.length * awardLineH + (m.awards.length - 1) * awardLineGap;\n526: \n527:   // ── the footer: points left, the TBA credit right ──\n528:   const footerCap = Math.round(0.024 * S);\n529:   const halfW = Math.round((contentW - gap) / 2);\n530:   const points = m.pointsText !== \"\" ? fitOne(m.pointsText, budget(halfW), footerCap, minPx, true) : null;\n531:   const credit = fitOne(CREDIT, budget(halfW), footerCap, minPx);\n532:   const footerH = Math.max(1, Math.round(1.7 * Math.max(points?.px ?? 0, credit.px)));\n533:   const footerY = H - margin - footerH;\n534:   const pointsRect: FrcRect | null = points ? { x: margin, y: footerY, w: halfW, h: footerH } : null;\n535:   const creditRect: FrcRect = { x: margin + contentW - halfW, y: footerY, w: halfW, h: footerH };\n536: \n537:   // ── place the bands ──\n538:   let rankBigRect!: FrcRect;\n539:   let rankSubRect: FrcRect | null = null;\n540:   let recordBigRect!: FrcRect;\n541:   let recordSubRect!: FrcRect;\n542:   const chips: FrcChip[] = [];\n543:   let awardsLabelRect: FrcRect | null = null;\n544:   const awardLines: FrcAwardLine[] = [];\n545: \n546:   if (landscape) {\n547:     // Left column: hero stacked under the header, pushed down a touch.\n548:     const heroStackH = 2 * heroCellH + gap;\n549:     const leftSlack = Math.max(0, footerY - gap - headerBottom - heroStackH);\n550:     let y = headerBottom + gap + Math.round(Math.min(leftSlack * 0.35, 0.08 * H));\n551:     rankBigRect = { x: margin, y, w: leftW, h: bigH };\n552:     rankSubRect = rankSub ? { x: margin, y: y + bigH + Math.round(0.3 * gap), w: leftW, h: subH } : null;\n553:     y += heroCellH + gap;\n554:     recordBigRect = { x: margin, y, w: leftW, h: bigH };\n555:     recordSubRect = { x: margin, y: y + bigH + Math.round(0.3 * gap), w: leftW, h: subH };\n556: \n557:     // Right column: chips at the top, the awards pinned into the lower half.\n558:     let cy = margin;\n559:     chipTexts.forEach((c) => {\n560:       const fit: FrcFit = { text: c.text, px: chipPx, width: widthOf(c.text, chipPx, true) };\n561:       const box: FrcRect = { x: rightX, y: cy, w: rightW, h: chipH };\n562:       const inner: FrcRect = { x: box.x + ring, y: box.y + ring, w: box.w - 2 * ring, h: box.h - 2 * ring };\n563:       chips.push({ key: c.key, label: c.label, box, inner, text: fit, textRect: inner });\n564:       cy += chipH + chipGapY;\n565:     });\n566:     if (m.awards.length > 0 && awardsLabel) {\n567:       const chipsBottom = chips.length > 0 ? cy - chipGapY : margin;\n568:       const top = Math.max(chipsBottom + (chips.length > 0 ? gap : 0), Math.round(0.5 * H));\n569:       const bottom = footerY - gap;\n570:       const ay = top + Math.max(0, Math.round((bottom - top - awardsBlockH) / 2));\n571:       awardsLabelRect = { x: rightX, y: ay, w: rightW, h: awardsLabelH };\n572:       let ly = ay + awardsLabelH + Math.round(0.3 * gap);\n573:       m.awards.forEach((a, i) => {\n574:         const textW = Math.max(8, rightW - tickSide - tickGap);\n575:         awardLines.push({\n576:           index: i,\n577:           text: { text: a, px: awardPx, width: widthOf(a, awardPx) },\n578:           textRect: { x: rightX + tickSide + tickGap, y: ly, w: textW, h: awardLineH },\n579:           tickRect: { x: rightX, y: ly + Math.round((awardLineH - tickSide) / 2), w: tickSide, h: tickSide },\n580:         });\n581:         ly += awardLineH + awardLineGap;\n582:       });\n583:     }\n584:   } else {\n585:     // Square and portrait: five stacked bands, the slack shared out as gaps.\n586:     const cellW = Math.round((contentW - gap) / 2);\n587:     const bands: Array<{ kind: \"hero\" | \"chips\" | \"awards\"; h: number }> = [{ kind: \"hero\", h: heroCellH }];\n588:     if (chipsBlockH > 0) bands.push({ kind: \"chips\", h: chipsBlockH });\n589:     if (awardsBlockH > 0) bands.push({ kind: \"awards\", h: awardsBlockH });\n590:     const natural = bands.reduce((a, b) => a + b.h, 0);\n591:     const middleBottom = footerY - gap;\n592:     const slack = Math.max(0, middleBottom - headerBottom - natural);\n593:     const share = Math.round(slack / (bands.length + 1));\n594:     let y = headerBottom + share;\n595:     for (const band of bands) {\n596:       if (band.kind === \"hero\") {\n597:         const subY = y + bigH + Math.round(0.3 * gap);\n598:         rankBigRect = { x: margin, y, w: cellW, h: bigH };\n599:         rankSubRect = rankSub ? { x: margin, y: subY, w: cellW, h: subH } : null;\n600:         recordBigRect = { x: margin + cellW + gap, y, w: Math.max(8, contentW - cellW - gap), h: bigH };\n601:         recordSubRect = { x: margin + cellW + gap, y: subY, w: Math.max(8, contentW - cellW - gap), h: subH };\n602:       } else if (band.kind === \"chips\") {\n603:         chipTexts.forEach((c, i) => {\n604:           const w = chipTexts.length === 2 ? cellW : Math.round((contentW - gap) / 2);\n605:           const x = margin + i * (w + gap);\n606:           const fit: FrcFit = { text: c.text, px: chipPx, width: widthOf(c.text, chipPx, true) };\n607:           const box: FrcRect = { x, y, w, h: chipH };\n608:           const inner: FrcRect = { x: box.x + ring, y: box.y + ring, w: box.w - 2 * ring, h: box.h - 2 * ring };\n609:           chips.push({ key: c.key, label: c.label, box, inner, text: fit, textRect: inner });\n610:         });\n611:       } else if (awardsLabel) {\n612:         awardsLabelRect = { x: margin, y, w: contentW, h: awardsLabelH };\n613:         let ly = y + awardsLabelH + Math.round(0.3 * gap);\n614:         m.awards.forEach((a, i) => {\n615:           const textW = Math.max(8, contentW - tickSide - tickGap);\n616:           awardLines.push({\n617:             index: i,\n618:             text: { text: a, px: awardPx, width: widthOf(a, awardPx) },\n619:             textRect: { x: margin + tickSide + tickGap, y: ly, w: textW, h: awardLineH },\n620:             tickRect: { x: margin, y: ly + Math.round((awardLineH - tickSide) / 2), w: tickSide, h: tickSide },\n621:           });\n622:           ly += awardLineH + awardLineGap;\n623:         });\n624:       }\n625:       y += band.h + share;\n626:     }\n627:   }\n628: \n629:   return {\n630:     W, H, S, landscape,\n631:     label, labelRect, ruleRect,\n632:     team, teamRect, name, nameRect, event, eventRect, week, weekRect,\n633:     rankBig, rankBigRect, rankSub, rankSubRect,\n634:     recordBig, recordBigRect, recordSub, recordSubRect,\n635:     chips,\n636:     awardsLabel, awardsLabelRect, awards: awardLines,\n637:     points, pointsRect, credit, creditRect,\n638:   };\n639: }\n640: \n641: /**\n642:  * What the geometry promises (the brief's contract): every text measured and\n643:  * fitted; the team number in the top band; the footer texts in the bottom\n644:  * one; the hero pair, the chips (when their props say so) and the awards\n645:  * block (when non-empty, in the middle band) present. No exact fractions -\n646:  * the reflow between square bands and landscape columns is the template's\n647:  * own business.\n648:  */\n649: export function frcContract(L: FrcLayout): LayoutConstraint[] {\n650:   const constraints: LayoutConstraint[] = [\n651:     textFitsMeasured(\"card-label\", L.label.text, L.label.px, L.label.width),\n652:     textFitsMeasured(\"team-number\", L.team.text, L.team.px, L.team.width),\n653:     { label: \"team-number\", within: { yFrac: [0, 0.3] } },\n654:     ...(L.name ? [textFitsMeasured(\"team-name\", L.name.text, L.name.px, L.name.width)] : []),\n655:     ...(L.event ? [textFitsMeasured(\"event-line\", L.event.text, L.event.px, L.event.width)] : []),\n656:     ...(L.week ? [textFitsMeasured(\"week-line\", L.week.text, L.week.px, L.week.width)] : []),\n657:     textFitsMeasured(\"rank-number\", L.rankBig.text, L.rankBig.px, L.rankBig.width),\n658:     { label: \"rank-number\" },\n659:     ...(L.rankSub ? [textFitsMeasured(\"rank-sub\", L.rankSub.text, L.rankSub.px, L.rankSub.width)] : []),\n660:     textFitsMeasured(\"record-text\", L.recordBig.text, L.recordBig.px, L.recordBig.width),\n661:     { label: \"record-text\" },\n662:     textFitsMeasured(\"record-sub\", L.recordSub.text, L.recordSub.px, L.recordSub.width),\n663:     ...L.chips.flatMap((c) => [textFitsMeasured(c.label, c.text.text, c.text.px, c.text.width), { label: c.label } as LayoutConstraint]),\n664:     ...(L.awardsLabel ? [textFitsMeasured(\"awards-label\", L.awardsLabel.text, L.awardsLabel.px, L.awardsLabel.width), { label: \"awards-label\", within: { yFrac: [0.45, 0.9] } } as LayoutConstraint] : []),\n665:     ...L.awards.map((a) => textFitsMeasured(`award-${a.index}`, a.text.text, a.text.px, a.text.width)),\n666:     ...(L.points ? [textFitsMeasured(\"footer-points\", L.points.text, L.points.px, L.points.width), { label: \"footer-points\", within: { yFrac: [0.85, 1] } } as LayoutConstraint] : []),\n667:     textFitsMeasured(\"footer-credit\", L.credit.text, L.credit.px, L.credit.width),\n668:     { label: \"footer-credit\", within: { yFrac: [0.85, 1] } },\n669:   ];\n670:   return constraints;\n671: }\n672: \n673: /**\n674:  * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n675:  * convention, src/_shared/why.ts). Filled from journal/2026-10-22/.\n676:  */\n677: const WHY: WhySpec = {\n678:   day: 33,\n679:   date: \"2026-10-22\",\n680:   agent: \"opencode\",\n681:   model: \"kimi-k3\",\n682:   id: ID,\n683:   title: \"FRC Event Recap\",\n684:   who: \"FIRST Robotics Competition media students and mentors, on Chief Delphi and team social accounts, with The Blue Alliance as the shared record\",\n685:   problem: [\n686:     \"After every event someone on the team writes the recap post. A 2026 build thread: \\\"the media team uploaded some pictures, and I have had a nap! That means it is time to write an event recap\\\" - with rank, EPA and alliance quoted from The Blue Alliance and Statbotics.\",\n687:     \"The numbers all live on one shared page: \\\"Team 9128 was Rank 1 with a record of 17-0-0 ... competed in the playoffs as the Captain of Alliance 1 and won the event\\\" - qual rank, W-L-T record, alliance selection, awards, district points.\",\n688:     \"The appetite for a rendered card is proven: team 9077's FRC Rewind web app turns a season into \\\"a high-quality shareable recap card\\\", and the first reply is \\\"Now I have something other than Spotify Wrapped!\\\"\",\n689:   ],\n690:   sources: [\n691:     \"https://www.chiefdelphi.com/t/release-frc-rewind-a-visual-season-recap-for-every-frc-team/522858\",\n692:     \"https://www.thebluealliance.com/team/9128/2026\",\n693:     \"https://www.chiefdelphi.com/t/frc-team-1710-2026-build-thread-open-alliance/507939?page=4\",\n694:   ],\n695:   solution: [\n696:     \"One deterministic card per event: the props mirror The Blue Alliance's team-event fields one for one - team number, event, week, qual rank, W-L-T record, alliance selection, playoff finish, awards, district points. Batch a whole season from a JSON file.\",\n697:     \"The design decision that matters: derive what can be derived and constrain the rest to TBA's own vocabulary - the chips come from closed enums, so their text always fits; awards, the one free text, are capped at three lines and shrink to fit, never ellipsized.\",\n698:     \"Honest weak spots: no robot photos and no logos - it is a numbers card that rides beside the team's pictures; and a regional or offseason event just zeroes the district points out of the footer.\",\n699:   ],\n700:   usage: {\n701:     command: \"m0saic make @one-a-day/sports/frc-event-recap/v1 --template-repo . -w 1080 -h 1080 -o recap.png\",\n702:     try: [\n703:       \"teamNumber 2471, eventName \\\"Portland District\\\", weekLabel \\\"Week 2\\\" - your own event\",\n704:       \"allianceRole \\\"pick1\\\" + allianceNumber 4 prints \\\"1ST PICK - ALLIANCE 4\\\"\",\n705:       \"playoffResult \\\"finalist\\\"; awards [\\\"Industrial Design Award\\\", \\\"Gracious Professionalism Award\\\"]\",\n706:       \"districtPoints 0 for a regional or offseason event; teamCount 0 drops the \\\"of N teams\\\" line\",\n707:     ],\n708:   },\n709:   caveats: [\n710:     \"Award names are free text and TBA's run long: up to 3 lines, 60 ASCII characters each, shrunk to fit - never ellipsized.\",\n711:     \"qualRank above teamCount (when teamCount is set) is refused: a card that says RANK 12 of 10 teams is lying.\",\n712:     \"Numbers and chips only - no FIRST or TBA marks, no photos; pair it with the team's robot picture.\",\n713:   ],\n714:   timeline: {\n715:     source: \"runner\",\n716:     phases: [\n717:       { name: \"scout\", startMs: 0, durMs: 623202, calls: 28, tokens: 1262534, costUsd: 0.96, tools: \"bash 11, websearch 10, read 4\" },\n718:       { name: \"plan\", startMs: 623230, durMs: 276206, calls: 14, tokens: 511564, costUsd: 0.77, tools: \"read 10, edit 2, bash 1\" },\n719:     ],\n720:     costBasis: \"reported\",\n721:   },\n722: };\n723: \n724: export const FrcEventRecapV1 = defineMosaicTemplate<FrcEventRecapProps>({\n725:   id: asTemplateId(ID),\n726:   label: \"2026-10-22 · FRC Event Recap\",\n727:   version: 1,\n728:   description:\n729:     \"An FRC event recap card from The Blue Alliance team-event fields: team number, event and week, qual rank of N teams, the W-L-T record, alliance-selection and playoff chips, up to three award lines, and district points in the footer.\",\n730:   capabilities: { tier: \"core\" },\n731:   tags: [\"sports\", \"2026-10-22\", \"day-033\", \"frc\", \"robotics\", \"recap\", \"blue-alliance\", \"event\", \"card\"],\n732: \n733:   outputHints: {\n734:     width: 1080,\n735:     height: 1080,\n736:     fps: 30,\n737:     durationMs: 2000,\n738:     format: { kind: \"image\", container: \"png\" },\n739:     note: \"A square still for the recap post (the Instagram feed). 1920x1080 splits header+hero left and chips+awards right; 1080x1920 stacks the five bands.\",\n740:   },\n741: \n742:   propsSchema,\n743:   defaultProps: {\n744:     teamNumber: DEFAULTS.teamNumber,\n745:     teamName: DEFAULTS.teamName,\n746:     eventName: DEFAULTS.eventName,\n747:     weekLabel: DEFAULTS.weekLabel,\n748:     qualRank: DEFAULTS.qualRank,\n749:     teamCount: DEFAULTS.teamCount,\n750:     record: DEFAULTS.record,\n751:     allianceRole: DEFAULTS.allianceRole,\n752:     allianceNumber: DEFAULTS.allianceNumber,\n753:     playoffResult: DEFAULTS.playoffResult,\n754:     awards: [...DEFAULTS.awards],\n755:     districtPoints: DEFAULTS.districtPoints,\n756:     accent: DEFAULTS.accent,\n757:     debugLayout: false,\n758:   },\n759: \n760:   render,\n761:   renderTutorial: whyTutorial(WHY, render),\n762: });\n763: \n764: export default FrcEventRecapV1;\n765: \n766: async function render(props: FrcEventRecapProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n767:   // The schema is documentation; render() is the gate.\n768:   const m = normalizeFrcEventRecap(props);\n769:   const W = Math.max(1, Math.round(ctx.target.width));\n770:   const H = Math.max(1, Math.round(ctx.target.height));\n771:   const L = layoutFrc(m, W, H);\n772: \n773:   const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n774:   const piece = (rect: FrcRect, importance: number, source: MosaicSource) => pieces.push({ rect: { ...rect, importance }, source });\n775: \n776:   // No backdrop rect: the page is document.backgroundColor below.\n777: \n778:   // ── header: the label, the accent rule (bound to the color prop it shows),\n779:   //    TEAM N, the name, the event ──\n780:   piece(L.labelRect, 2, tag(textCell({ text: L.label.text, fontSize: L.label.px, color: DIM, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"card-label\" }), \"card-label\"));\n781:   piece(L.ruleRect, 1, bindProp(tag(makeColorTile(m.accent) as MosaicSource, \"header-rule\"), \"accent\"));\n782:   piece(L.teamRect, 3, bindProp(tag(textCell({ text: L.team.text, fontSize: L.team.px, color: INK, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"team-number\" }), \"team-number\"), \"teamNumber\"));\n783:   if (L.name && L.nameRect) piece(L.nameRect, 3, bindProp(tag(textCell({ text: L.name.text, fontSize: L.name.px, color: DIM, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"team-name\" }), \"team-name\"), \"teamName\"));\n784:   if (L.event && L.eventRect) piece(L.eventRect, 3, bindProp(tag(textCell({ text: L.event.text, fontSize: L.event.px, color: INK, hAlign: \"left\", vAlign: \"middle\", label: \"event-line\" }), \"event-line\"), \"eventName\"));\n785:   if (L.week && L.weekRect) piece(L.weekRect, 3, bindProp(tag(textCell({ text: L.week.text, fontSize: L.week.px, color: INK, hAlign: \"left\", vAlign: \"middle\", label: \"week-line\" }), \"week-line\"), \"weekLabel\"));\n786: \n787:   // ── the hero pair ──\n788:   piece(L.rankBigRect, 3, bindProp(tag(textCell({ text: L.rankBig.text, fontSize: L.rankBig.px, color: INK, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"rank-number\" }), \"rank-number\"), \"qualRank\"));\n789:   if (L.rankSub && L.rankSubRect) piece(L.rankSubRect, 3, bindProp(tag(textCell({ text: L.rankSub.text, fontSize: L.rankSub.px, color: DIM, hAlign: \"left\", vAlign: \"middle\", label: \"rank-sub\" }), \"rank-sub\"), \"teamCount\"));\n790:   piece(L.recordBigRect, 3, bindProp(tag(textCell({ text: L.recordBig.text, fontSize: L.recordBig.px, color: INK, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"record-text\" }), \"record-text\"), \"record\"));\n791:   piece(L.recordSubRect, 3, tag(textCell({ text: L.recordSub.text, fontSize: L.recordSub.px, color: DIM, hAlign: \"left\", vAlign: \"middle\", label: \"record-sub\" }), \"record-sub\"));\n792: \n793:   // ── the chips: accent outline, page fill, the enum's own words ──\n794:   L.chips.forEach((c) => {\n795:     piece(c.box, 1, tag(makeColorTile(m.accent) as MosaicSource, `${c.label}-box`));\n796:     piece(c.inner, 2, tag(makeColorTile(PAGE) as MosaicSource, `${c.label}-fill`));\n797:     // The chip text is the enum's own words; closed pickers never carry a rect\n798:     // binding (the gate: bindingsSound) - Make edits them from the panel.\n799:     piece(c.textRect, 3, tag(textCell({ text: c.text.text, fontSize: c.text.px, color: INK, hAlign: \"center\", bold: true, vAlign: \"middle\", label: c.label }), c.label));\n800:   });\n801: \n802:   // ── the awards: label, then a tick and a line each ──\n803:   if (L.awardsLabel && L.awardsLabelRect) piece(L.awardsLabelRect, 3, tag(textCell({ text: L.awardsLabel.text, fontSize: L.awardsLabel.px, color: DIM, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"awards-label\" }), \"awards-label\"));\n804:   L.awards.forEach((a) => {\n805:     piece(a.tickRect, 2, tag(makeColorTile(m.accent) as MosaicSource, `award-tick-${a.index}`));\n806:     piece(a.textRect, 3, bindPropPath(tag(textCell({ text: a.text.text, fontSize: a.text.px, color: INK, hAlign: \"left\", vAlign: \"middle\", label: `award-${a.index}` }), `award-${a.index}`), \"awards\", [a.index], \"string\"));\n807:   });\n808: \n809:   // ── the footer ──\n810:   if (L.points && L.pointsRect) piece(L.pointsRect, 3, bindProp(tag(textCell({ text: L.points.text, fontSize: L.points.px, color: INK, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"footer-points\" }), \"footer-points\"), \"districtPoints\"));\n811:   piece(L.creditRect, 3, tag(textCell({ text: L.credit.text, fontSize: L.credit.px, color: DIM, hAlign: \"right\", vAlign: \"middle\", label: \"footer-credit\" }), \"footer-credit\"));\n812: \n813:   const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n814:   const doc: MosaicDocument = {\n815:     kind: \"mosaic_document\",\n816:     version: 1,\n817:     m0: toM0String(placed.m0, ID),\n818:     assets: {},\n819:     size: { width: W, height: H },\n820:     fps: ctx.target.fps,\n821:     durationMs: 2000,\n822:     backgroundColor: PAGE,\n823:     sources: placed.sources,\n824:     editor: { label: `FRC Event Recap - Team ${m.teamNumber} - ${m.eventLine || \"event\"}` },\n825:   };\n826:   return withLayoutIntent(doc, ctx, { templateId: ID, constraints: frcContract(L), debug: props.debugLayout === true });\n827: }\n\n(End of file - total 827 lines)\n</content>","metadata":{"preview":"import type {\n  MosaicColor,\n  MosaicDocument,\n  MosaicEngineContext,\n  MosaicSource,\n} from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport {\n  bindProp,\n  bindPropPath,\n  defineMosaicTemplate,\n  definePropsSchema,\n  makeColorTile,\n  placeInsetPieces,\n  tag,\n} from \"@m0saic/template-utils\";\nimport type { LayoutConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, fitLine, textCell, widthOf } from \"../../../_shared/text\";","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-22\\variants\\a\\src\\frc-event-recap.ts","text":"import type {\n  MosaicColor,\n  MosaicDocument,\n  MosaicEngineContext,\n  MosaicSource,\n} from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport {\n  bindProp,\n  bindPropPath,\n  defineMosaicTemplate,\n  definePropsSchema,\n  makeColorTile,\n  placeInsetPieces,\n  tag,\n} from \"@m0saic/template-utils\";\nimport type { LayoutConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, fitLine, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/sports/frc-event-recap/v1` - an FRC event recap card from the\n * fields The Blue Alliance publishes for a team at an event: the team number\n * as the card's identity, the event and week, the qual rank with the team\n * count, the W-L-T record, the alliance selection and playoff finish as\n * chips, up to three award lines, and the district points in the footer. One\n * deterministic card per event, for the recap posts team media students\n * already write after every tournament.\n *\n * ONE CONCEPT: **the card derives what it can and constrains the rest to The\n * Blue Alliance's own vocabulary.** Rank, team count, record and district\n * points are numbers, validated in `render()`; the alliance and playoff\n * chips come from closed enums (captain / 1st pick / 2nd pick, alliance 1-8;\n * winner / finalist / semifinalist / quarterfinalist) so their text always\n * fits; awards are the one free text on the card, capped at three lines and\n * shrunk to fit above the floor, never ellipsized.\n *\n * The rule that bites: **qualRank above a non-zero teamCount is refused.** A\n * card that says \"RANK 12 of 10 teams\" is lying, and a recap graphic nobody\n * trusts is worse than none.\n */\n\nexport type FrcAllianceRole = \"captain\" | \"pick1\" | \"pick2\" | \"none\";\nexport type FrcPlayoffResult = \"winner\" | \"finalist\" | \"semifinalist\" | \"quarterfinalist\" | \"none\";\n\nexport type FrcEventRecapProps = {\n  /** The team number - the hero line \"TEAM 9128\" (1-99999). */\n  teamNumber?: number;\n  /** The team nickname, printed in caps under the number. Up to 30 ASCII characters; \"\" removes the line. */\n  teamName?: string;\n  /** The event name as The Blue Alliance has it (\"Harbor City District\"). Up to 40 ASCII characters. */\n  eventName?: string;\n  /** Printed after the event name, \" - \" joined: \"Week 4\", \"DCMP\", \"Offseason\". Up to 20 ASCII characters; \"\" removes it. */\n  weekLabel?: string;\n  /** The qualification rank (1-200). Above teamCount (when set) is refused. */\n  qualRank?: number;\n  /** The teams at the event, for the \"of 48 teams\" line under the rank (0-200; 0 hides the line). */\n  teamCount?: number;\n  /** The qualification record as W-L-T digits, e.g. \"17-0-0\". */\n  record?: string;\n  /** The alliance-selection chip: \"captain\" / \"pick1\" / \"pick2\" (\"CAPTAIN - ALLIANCE N\", \"1ST PICK - ALLIANCE N\", \"2ND PICK - ALLIANCE N\"); \"none\" hides it. */\n  allianceRole?: FrcAllianceRole;\n  /** The N on the alliance chip (1-8; ignored when the role is \"none\"). */\n  allianceNumber?: number;\n  /** The playoff chip: \"winner\" (\"EVENT WINNER\") / \"finalist\" / \"semifinalist\" / \"quarterfinalist\"; \"none\" hides it. */\n  playoffResult?: FrcPlayoffResult;\n  /** 0-3 award lines (TBA award names run long): each up to 60 ASCII characters, shrunk to fit. */\n  awards?: string[] | string;\n  /** District points, the footer-left \"78 DISTRICT POINTS\" (0-999; 0 hides it - regionals and offseason events earn none). */\n  districtPoints?: number;\n  /** The one accent - the header rule, the chip outlines, the award ticks - as #rrggbb. */\n  accent?: string;\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/sports/frc-event-recap/v1\";\nconst HEX = /^#[0-9a-fA-F]{6}$/;\n/** Printable ASCII: what the bundled font is guaranteed to draw. */\nconst ASCII = /^[\\x20-\\x7e]*$/;\n\nconst PAGE = \"#0d131c\" as MosaicColor;\nconst INK = \"#eef3f9\" as MosaicColor;\nconst DIM = \"#8d9bb0\" as MosaicColor;\n\nconst HEADER_LABEL = \"FRC EVENT RECAP\";\nconst RECORD_SUB = \"W - L - T\";\nconst CREDIT = \"DATA: THE BLUE ALLIANCE\";\nconst AWARDS_LABEL = \"AWARDS\";\n\nconst DEFAULTS = {\n  teamNumber: 9128,\n  teamName: \"\",\n  eventName: \"Harbor City District\",\n  weekLabel: \"Week 4\",\n  qualRank: 1,\n  teamCount: 48,\n  record: \"17-0-0\",\n  allianceRole: \"captain\" as FrcAllianceRole,\n  allianceNumber: 1,\n  playoffResult: \"winner\" as FrcPlayoffResult,\n  awards: [\"Innovation in Control Award\"],\n  districtPoints: 78,\n  accent: \"#2f7bff\",\n  debugLayout: false,\n};\n\nconst PROPS = Object.keys(DEFAULTS);\n\nconst propsSchema = definePropsSchema<FrcEventRecapProps>({\n  teamNumber: {\n    type: \"number\",\n    required: false,\n    description: \"The team number - the hero line \\\"TEAM 9128\\\" (1-99999). Every FRC team is known by its number.\",\n    meta: { constraints: { min: 1, max: 99999 }, control: { placeholder: String(DEFAULTS.teamNumber) }, ui: { label: \"Team number\", order: 1, primary: true } },\n  },\n  teamName: {\n    type: \"string\",\n    required: false,\n    description: \"The team nickname, printed in caps under the number. Up to 30 ASCII characters; empty removes the line (the default renders the number only, like the TBA page).\",\n    meta: { control: { placeholder: \"Iron Panthers\" }, ui: { label: \"Team name\", order: 2 } },\n  },\n  eventName: {\n    type: \"string\",\n    required: false,\n    description: \"The event name as The Blue Alliance has it. Up to 40 ASCII characters; the sample event is invented.\",\n    meta: { control: { placeholder: DEFAULTS.eventName }, ui: { label: \"Event\", order: 3, primary: true } },\n  },\n  weekLabel: {\n    type: \"string\",\n    required: false,\n    description: 'Printed after the event name, \" - \" joined: \"Week 4\", \"DCMP\", \"Offseason\". Up to 20 ASCII characters; empty removes it.',\n    meta: { control: { placeholder: DEFAULTS.weekLabel }, ui: { label: \"Week\", order: 4 } },\n  },\n  qualRank: {\n    type: \"number\",\n    required: false,\n    description: \"The qualification rank (1-200) - the left hero figure. A rank above teamCount (when that is set) is refused: the card would be lying.\",\n    meta: { constraints: { min: 1, max: 200 }, control: { placeholder: String(DEFAULTS.qualRank) }, ui: { label: \"Qual rank\", order: 5, primary: true } },\n  },\n  teamCount: {\n    type: \"number\",\n    required: false,\n    description: 'The teams at the event, for the \"of 48 teams\" line under the rank (0-200); 0 hides the line.',\n    meta: { constraints: { min: 0, max: 200 }, control: { placeholder: String(DEFAULTS.teamCount) }, ui: { label: \"Team count\", order: 6 } },\n  },\n  record: {\n    type: \"string\",\n    required: false,\n    description: 'The qualification record as W-L-T digits, e.g. \"17-0-0\" - the right hero figure.',\n    meta: { control: { placeholder: DEFAULTS.record }, ui: { label: \"Record (W-L-T)\", order: 7, primary: true } },\n  },\n  allianceRole: {\n    type: \"string\",\n    required: false,\n    description: 'The alliance-selection chip: \"captain\", \"pick1\" or \"pick2\" (printed \"CAPTAIN - ALLIANCE N\" / \"1ST PICK - ALLIANCE N\" / \"2ND PICK - ALLIANCE N\"); \"none\" hides the chip.',\n    meta: { constraints: { oneOf: [\"captain\", \"pick1\", \"pick2\", \"none\"] }, ui: { label: \"Alliance selection\", order: 8 } },\n  },\n  allianceNumber: {\n    type: \"number\",\n    required: false,\n    description: 'The alliance number on the chip (1-8); ignored when the role is \"none\".',\n    meta: { constraints: { min: 1, max: 8 }, control: { placeholder: String(DEFAULTS.allianceNumber) }, ui: { label: \"Alliance number\", order: 9 } },\n  },\n  playoffResult: {\n    type: \"string\",\n    required: false,\n    description: 'The playoff chip: \"winner\" (EVENT WINNER), \"finalist\", \"semifinalist\" or \"quarterfinalist\"; \"none\" hides it.',\n    meta: { constraints: { oneOf: [\"winner\", \"finalist\", \"semifinalist\", \"quarterfinalist\", \"none\"] }, ui: { label: \"Playoff finish\", order: 10 } },\n  },\n  awards: {\n    type: \"json\",\n    required: false,\n    description: 'Up to three award lines as The Blue Alliance names them (its names run long): each up to 60 ASCII characters, shrunk to fit, never ellipsized. Example: [\"Innovation in Control Award\", \"Excellence in Engineering Award\"].',\n    meta: {\n      constraints: { jsonSchema: { type: \"array\", maxItems: 3, items: { type: \"string\", maxLength: 60 } } },\n      control: { mono: true, placeholder: '[\"Innovation in Control Award\"]' },\n      ui: { label: \"Awards\", order: 11 },\n    },\n  },\n  districtPoints: {\n    type: \"number\",\n    required: false,\n    description: 'District points - the footer-left \"78 DISTRICT POINTS\" (0-999); 0 hides it (regionals and offseason events earn none).',\n    meta: { constraints: { min: 0, max: 999 }, control: { placeholder: String(DEFAULTS.districtPoints) }, ui: { label: \"District points\", order: 12 } },\n  },\n  accent: {\n    type: \"string\",\n    required: false,\n    description: \"The one accent - the header rule, the chip outlines, the award ticks - as #rrggbb. The default is a The-Blue-Alliance-ish blue.\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULTS.accent }, ui: { label: \"Accent\", order: 13 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits, the team number holds the top band, the footer holds the bottom) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n/* ── derived copy: TBA's own vocabulary, never hand-typed at render ── */\n\n/** The alliance chip's text, or \"\" when the team was not selected. */\nexport function allianceChipText(role: FrcAllianceRole, allianceNumber: number): string {\n  if (role === \"none\") return \"\";\n  const head = role === \"captain\" ? \"CAPTAIN\" : role === \"pick1\" ? \"1ST PICK\" : \"2ND PICK\";\n  return `${head} - ALLIANCE ${allianceNumber}`;\n}\n\n/** The playoff chip's text, or \"\" when the team did not make the playoffs. */\nexport function playoffChipText(result: FrcPlayoffResult): string {\n  if (result === \"winner\") return \"EVENT WINNER\";\n  if (result === \"finalist\") return \"FINALIST\";\n  if (result === \"semifinalist\") return \"SEMIFINALIST\";\n  if (result === \"quarterfinalist\") return \"QUARTERFINALIST\";\n  return \"\";\n}\n\n/** The record as printed - validated W-L-T digits, then as-is. Throws naming the prop. */\nexport function recordText(wlt: string): string {\n  const s = wlt.trim();\n  if (!/^\\d{1,3}-\\d{1,3}-\\d{1,3}$/.test(s)) {\n    throw new Error(`${ID}: record ${JSON.stringify(wlt)} must be W-L-T digits like \"17-0-0\" (wins-losses-ties).`);\n  }\n  return s;\n}\n\n/** The line under the rank: \"\" when the team count is not given. */\nexport function rankSub(teamCount: number): string {\n  if (teamCount <= 0) return \"\";\n  return `of ${teamCount} team${teamCount === 1 ? \"\" : \"s\"}`;\n}\n\n/* ── the gate: render() refuses impossible input by name ── */\n\nfunction fail(field: string, rule: string): never {\n  throw new Error(`${ID}: ${field} ${rule}`);\n}\n\n/** Edit distance, for \"did you mean\" on a misspelled prop. */\nfunction distance(a: string, b: string): number {\n  const d = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array<number>(b.length).fill(0)]);\n  for (let j = 1; j <= b.length; j++) d[0][j] = j;\n  for (let i = 1; i <= a.length; i++) for (let j = 1; j <= b.length; j++) d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));\n  return d[a.length][b.length];\n}\n\nfunction pickText(value: unknown, field: string, max: number): string {\n  if (typeof value !== \"string\") fail(field, `must be a string, got ${JSON.stringify(value)}.`);\n  const s = value.trim();\n  const bad = [...s].find((ch) => !ASCII.test(ch));\n  if (bad !== undefined) fail(field, `${JSON.stringify(s)} has the character ${JSON.stringify(bad)} (U+${bad.codePointAt(0)!.toString(16).toUpperCase().padStart(4, \"0\")}), which the card's font does not draw: use printable ASCII.`);\n  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card allows at most ${max}.`);\n  return s;\n}\n\nfunction pickWhole(value: unknown, field: string, min: number, max: number): number {\n  const n = typeof value === \"string\" && value.trim() !== \"\" ? Number(value) : value;\n  if (typeof n !== \"number\" || !Number.isFinite(n)) fail(field, `must be a number, got ${JSON.stringify(value)}.`);\n  if (!Number.isInteger(n)) fail(field, `must be a whole number, got ${JSON.stringify(value)}.`);\n  if (n < min || n > max) fail(field, `must be from ${min} to ${max}, got ${JSON.stringify(value)}.`);\n  return n;\n}\n\nfunction pickOne<T extends string>(value: unknown, options: readonly T[], field: string): T {\n  if (typeof value !== \"string\" || !(options as readonly string[]).includes(value)) {\n    fail(field, `must be one of ${options.map((o) => `\"${o}\"`).join(\", \")}; got ${JSON.stringify(value)}.`);\n  }\n  return value as T;\n}\n\nfunction pickAwards(value: unknown): string[] {\n  let v = value;\n  if (typeof v === \"string\") {\n    const raw = v;\n    try { v = JSON.parse(raw); } catch { fail(\"awards\", `is not valid JSON: ${JSON.stringify(raw.slice(0, 60))}. Pass a list like [\"Innovation in Control Award\"].`); }\n  }\n  if (!Array.isArray(v)) fail(\"awards\", 'must be a list of award names, e.g. [\"Innovation in Control Award\"].');\n  if (v.length > 3) fail(\"awards\", `has ${v.length} lines; the card holds at most 3.`);\n  return v.map((a, i) => {\n    if (typeof a !== \"string\") fail(\"awards\", `line ${i + 1} must be a string, got ${JSON.stringify(a)}.`);\n    return pickText(a, `awards line ${i + 1}`, 60);\n  }).filter((a) => a.length > 0);\n}\n\nexport type FrcRecapModel = {\n  teamNumber: number;\n  /** \"TEAM 9128\" - the top-of-card identity. */\n  teamLine: string;\n  /** The nickname in caps, or \"\" (line removed). */\n  teamName: string;\n  eventName: string;\n  weekLabel: string;\n  /** \"Harbor City District - Week 4\" or whichever parts are set; \"\" removes the line. */\n  eventLine: string;\n  qualRank: number;\n  teamCount: number;\n  /** \"RANK 1\" - the left hero figure. */\n  rankBig: string;\n  /** \"of 48 teams\" or \"\". */\n  rankSubText: string;\n  record: string;\n  allianceChip: string;\n  playoffChip: string;\n  awards: string[];\n  districtPoints: number;\n  /** \"78 DISTRICT POINTS\" or \"\". */\n  pointsText: string;\n  accent: MosaicColor;\n};\n\nexport function normalizeFrcEventRecap(props: FrcEventRecapProps): FrcRecapModel {\n  f[10:37:04] critique-1 🔧 read: C:\src\m0saic-production\one-a-day\journal\2026-10-22\variants\a\src\frc-event-recap.ts
or (const k of Object.keys(props ?? {})) {\n    if (PROPS.includes(k)) continue;\n    const near = PROPS.find((n) => distance(n.toLowerCase(), k.toLowerCase()) <= 2);\n    fail(\"props\", `has an unknown prop '${k}'${near ? `; did you mean '${near}'?` : \".\"} The props are ${PROPS.join(\", \")}.`);\n  }\n  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n\n  const teamNumber = pickWhole(p.teamNumber, \"teamNumber\", 1, 99999);\n  const teamNameRaw = pickText(p.teamName, \"teamName\", 30);\n  const eventName = pickText(p.eventName, \"eventName\", 40);\n  const weekLabel = pickText(p.weekLabel, \"weekLabel\", 20);\n  const qualRank = pickWhole(p.qualRank, \"qualRank\", 1, 200);\n  const teamCount = pickWhole(p.teamCount, \"teamCount\", 0, 200);\n  if (teamCount > 0 && qualRank > teamCount) {\n    fail(\"qualRank\", `is ${qualRank} but teamCount is ${teamCount} - a rank cannot be above the number of teams at the event.`);\n  }\n  const record = recordText(String(p.record ?? \"\"));\n  const allianceRole = pickOne<FrcAllianceRole>(p.allianceRole, [\"captain\", \"pick1\", \"pick2\", \"none\"], \"allianceRole\");\n  const playoffResult = pickOne<FrcPlayoffResult>(p.playoffResult, [\"winner\", \"finalist\", \"semifinalist\", \"quarterfinalist\", \"none\"], \"playoffResult\");\n  let allianceNumber = DEFAULTS.allianceNumber;\n  if (allianceRole !== \"none\") allianceNumber = pickWhole(p.allianceNumber, \"allianceNumber\", 1, 8);\n  const awards = pickAwards(p.awards);\n  const districtPoints = pickWhole(p.districtPoints, \"districtPoints\", 0, 999);\n  if (typeof p.accent !== \"string\" || !HEX.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n\n  const teamName = teamNameRaw.toUpperCase();\n  const eventLine = [eventName, weekLabel].filter((s) => s.length > 0).join(\" - \");\n  return {\n    teamNumber,\n    teamLine: `TEAM ${teamNumber}`,\n    teamName,\n    eventName,\n    weekLabel,\n    eventLine,\n    qualRank,\n    teamCount,\n    rankBig: `RANK ${qualRank}`,\n    rankSubText: rankSub(teamCount),\n    record,\n    allianceChip: allianceChipText(allianceRole, allianceNumber),\n    playoffChip: playoffChipText(playoffResult),\n    awards,\n    districtPoints,\n    pointsText: districtPoints > 0 ? `${districtPoints} DISTRICT POINTS` : \"\",\n    accent: p.accent.trim().toLowerCase() as MosaicColor,\n  };\n}\n\n/* ── geometry: a pure function of the model and the canvas ── */\n\nexport type FrcRect = { x: number; y: number; w: number; h: number };\nexport type FrcFit = { text: string; px: number; width: number };\nexport type FrcChip = { key: \"alliance\" | \"playoff\"; label: \"alliance-chip\" | \"playoff-chip\"; box: FrcRect; inner: FrcRect; text: FrcFit; textRect: FrcRect };\nexport type FrcAwardLine = { index: number; text: FrcFit; textRect: FrcRect; tickRect: FrcRect };\n\nexport type FrcLayout = {\n  W: number;\n  H: number;\n  S: number;\n  landscape: boolean;\n  label: FrcFit;\n  labelRect: FrcRect;\n  ruleRect: FrcRect;\n  team: FrcFit;\n  teamRect: FrcRect;\n  name: FrcFit | null;\n  nameRect: FrcRect | null;\n  event: FrcFit | null;\n  eventRect: FrcRect | null;\n  /** The \" - Week 4\" suffix, its own source so the week prop gets its own binding. */\n  week: FrcFit | null;\n  weekRect: FrcRect | null;\n  rankBig: FrcFit;\n  rankBigRect: FrcRect;\n  rankSub: FrcFit | null;\n  rankSubRect: FrcRect | null;\n  recordBig: FrcFit;\n  recordBigRect: FrcRect;\n  recordSub: FrcFit;\n  recordSubRect: FrcRect;\n  chips: FrcChip[];\n  awardsLabel: FrcFit | null;\n  awardsLabelRect: FrcRect | null;\n  awards: FrcAwardLine[];\n  points: FrcFit | null;\n  pointsRect: FrcRect | null;\n  credit: FrcFit;\n  creditRect: FrcRect;\n};\n\n/** One line, shrunk until it fits its budget; at the floor it must fit - the card never ellipsizes. */\nfunction fitOne(text: string, maxW: number, maxPx: number, minPx: number, bold = false): FrcFit {\n  const px = fitLine(text, maxW, maxPx, minPx, bold);\n  return { text, px, width: widthOf(text, px, bold) };\n}\n\n/**\n * The whole card as rects and measured fits. Square and portrait stack five\n * bands (header, hero, chips, awards, footer); landscape puts header and hero\n * in a left column, chips and awards in a right one, the footer full-width.\n * The test asserts bands and fits without parsing m0.\n */\nexport function layoutFrc(m: FrcRecapModel, W: number, H: number): FrcLayout {\n  const S = Math.min(W, H);\n  const landscape = W >= 1.25 * H;\n  const margin = Math.max(6, Math.round(0.05 * S));\n  const gap = Math.max(4, Math.round(0.025 * S));\n  const minPx = Math.max(5, Math.round(0.013 * S));\n  const contentW = Math.max(40, W - 2 * margin);\n\n  // The columns: everything is full-width, or landscape's left/right split.\n  const leftW = landscape ? Math.round(0.48 * contentW) : contentW;\n  const rightX = margin + leftW + 2 * gap;\n  const rightW = landscape ? Math.max(24, W - margin - rightX) : contentW;\n\n  // ── the header: label + accent rule, TEAM N, the name, the event ──\n  const label = fitOne(HEADER_LABEL, budget(Math.round(0.55 * leftW)), Math.round(0.026 * S), minPx, true);\n  const labelH = Math.max(1, Math.round(1.6 * label.px));\n  const labelRect: FrcRect = { x: margin, y: margin, w: Math.max(8, Math.ceil(label.width / 0.94) + 4), h: labelH };\n  const ruleH = Math.max(2, Math.round(0.006 * S));\n  const ruleX = labelRect.x + labelRect.w + Math.round(0.7 * gap);\n  const ruleRect: FrcRect = { x: ruleX, y: margin + Math.round((labelH - ruleH) / 2), w: Math.max(8, margin + leftW - ruleX), h: ruleH };\n\n  let hy = margin + labelH + Math.round(0.5 * gap);\n  const team = fitOne(m.teamLine, budget(leftW), Math.round(0.095 * S), minPx, true);\n  const teamH = Math.max(1, Math.round(1.3 * team.px));\n  const teamRect: FrcRect = { x: margin, y: hy, w: leftW, h: teamH };\n  hy += teamH + Math.round(0.25 * gap);\n\n  let name: FrcFit | null = null;\n  let nameRect: FrcRect | null = null;\n  if (m.teamName !== \"\") {\n    name = fitOne(m.teamName, budget(leftW), Math.round(0.034 * S), minPx, true);\n    const nameH = Math.max(1, Math.round(1.5 * name.px));\n    nameRect = { x: margin, y: hy, w: leftW, h: nameH };\n    hy += nameH + Math.round(0.25 * gap);\n  }\n  let event: FrcFit | null = null;\n  let eventRect: FrcRect | null = null;\n  let week: FrcFit | null = null;\n  let weekRect: FrcRect | null = null;\n  if (m.eventLine !== \"\") {\n    // One size for the whole line, then the event and the week as two adjacent\n    // sources (each binds the prop it shows).\n    const eventPx = fitLine(m.eventLine, budget(leftW), Math.round(0.038 * S), minPx);\n    const eventH = Math.max(1, Math.round(1.5 * eventPx));\n    if (m.eventName !== \"\") {\n      event = { text: m.eventName, px: eventPx, width: widthOf(m.eventName, eventPx) };\n      eventRect = { x: margin, y: hy, w: Math.max(8, Math.ceil(event.width * 1.04) + 4), h: eventH };\n    }\n    if (m.weekLabel !== \"\") {\n      const weekText = m.eventName !== \"\" ? ` - ${m.weekLabel}` : m.weekLabel;\n      week = { text: weekText, px: eventPx, width: widthOf(weekText, eventPx) };\n      weekRect = { x: margin + (eventRect ? eventRect.w : 0), y: hy, w: Math.max(8, Math.ceil(week.width / 0.94) + 4), h: eventH };\n    }\n    hy += eventH;\n  }\n  const headerBottom = hy;\n\n  // ── the hero pair: RANK N (of N teams) and the record - one shared size ──\n  const heroCap = Math.round(0.08 * S);\n  const subCap = Math.round(0.026 * S);\n  const bigPx = Math.min(\n    fitLine(m.rankBig, budget(landscape ? leftW : Math.round((contentW - gap) / 2)), heroCap, minPx, true),\n    fitLine(m.record, budget(landscape ? leftW : Math.round((contentW - gap) / 2)), heroCap, minPx, true),\n  );\n  const rankBig: FrcFit = { text: m.rankBig, px: bigPx, width: widthOf(m.rankBig, bigPx, true) };\n  const recordBig: FrcFit = { text: m.record, px: bigPx, width: widthOf(m.record, bigPx, true) };\n  const subPx = Math.min(\n    m.rankSubText !== \"\" ? fitLine(m.rankSubText, budget(contentW), subCap, minPx) : subCap,\n    fitLine(RECORD_SUB, budget(contentW), subCap, minPx),\n  );\n  const rankSub: FrcFit | null = m.rankSubText !== \"\" ? { text: m.rankSubText, px: subPx, width: widthOf(m.rankSubText, subPx) } : null;\n  const recordSub: FrcFit = { text: RECORD_SUB, px: subPx, width: widthOf(RECORD_SUB, subPx) };\n  const bigH = Math.max(1, Math.round(1.25 * bigPx));\n  const subH = Math.max(1, Math.round(1.5 * subPx));\n  const heroCellH = bigH + Math.round(0.3 * gap) + subH;\n\n  // ── the chips: one shared size, accent outline, page fill ──\n  const chipTexts: Array<{ key: \"alliance\" | \"playoff\"; label: \"alliance-chip\" | \"playoff-chip\"; text: string }> = [];\n  if (m.allianceChip !== \"\") chipTexts.push({ key: \"alliance\", label: \"alliance-chip\", text: m.allianceChip });\n  if (m.playoffChip !== \"\") chipTexts.push({ key: \"playoff\", label: \"playoff-chip\", text: m.playoffChip });\n  const ring = Math.max(2, Math.round(0.004 * S));\n  const chipColW = landscape ? rightW : contentW;\n  let chipPx = Math.round(0.03 * S);\n  for (const c of chipTexts) chipPx = Math.min(chipPx, fitLine(c.text, budget(chipColW - 2 * ring - 2 * Math.round(0.7 * chipPx)), chipPx, minPx, true));\n  const chipPadX = chipTexts.length > 0 ? Math.max(3, Math.round(0.7 * chipPx)) : 0;\n  const chipPadY = chipTexts.length > 0 ? Math.max(2, Math.round(0.5 * chipPx)) : 0;\n  const chipH = chipTexts.length > 0 ? Math.max(1, Math.round(1.3 * chipPx) + 2 * chipPadY + 2 * ring) : 0;\n  const chipGapY = Math.round(0.6 * gap);\n  const chipsBlockH = chipTexts.length === 0 ? 0 : landscape ? chipTexts.length * chipH + (chipTexts.length - 1) * chipGapY : chipH;\n\n  // ── the awards: a label and 0-3 lines, one shared size, an accent tick each ──\n  let awardsLabel: FrcFit | null = null;\n  let awardsLabelH = 0;\n  let awardPx = Math.round(0.03 * S);\n  if (m.awards.length > 0) {\n    const awardColW = landscape ? rightW : contentW;\n    awardsLabel = fitOne(AWARDS_LABEL, budget(awardColW), Math.round(0.024 * S), minPx, true);\n    awardsLabelH = Math.max(1, Math.round(1.6 * awardsLabel.px));\n    const tickSide0 = Math.max(3, Math.round(0.5 * awardPx));\n    const tickGap0 = Math.max(3, Math.round(0.5 * awardPx));\n    for (const a of m.awards) awardPx = Math.min(awardPx, fitLine(a, budget(awardColW - tickSide0 - tickGap0), awardPx, minPx));\n  }\n  const tickSide = m.awards.length > 0 ? Math.max(3, Math.round(0.5 * awardPx)) : 0;\n  const tickGap = m.awards.length > 0 ? Math.max(3, Math.round(0.5 * awardPx)) : 0;\n  const awardLineH = m.awards.length > 0 ? Math.max(1, Math.round(1.5 * awardPx)) : 0;\n  const awardLineGap = Math.round(0.2 * gap);\n  const awardsBlockH = m.awards.length === 0 ? 0 : awardsLabelH + Math.round(0.3 * gap) + m.awards.length * awardLineH + (m.awards.length - 1) * awardLineGap;\n\n  // ── the footer: points left, the TBA credit right ──\n  const footerCap = Math.round(0.024 * S);\n  const halfW = Math.round((contentW - gap) / 2);\n  const points = m.pointsText !== \"\" ? fitOne(m.pointsText, budget(halfW), footerCap, minPx, true) : null;\n  const credit = fitOne(CREDIT, budget(halfW), footerCap, minPx);\n  const footerH = Math.max(1, Math.round(1.7 * Math.max(points?.px ?? 0, credit.px)));\n  const footerY = H - margin - footerH;\n  const pointsRect: FrcRect | null = points ? { x: margin, y: footerY, w: halfW, h: footerH } : null;\n  const creditRect: FrcRect = { x: margin + contentW - halfW, y: footerY, w: halfW, h: footerH };\n\n  // ── place the bands ──\n  let rankBigRect!: FrcRect;\n  let rankSubRect: FrcRect | null = null;\n  let recordBigRect!: FrcRect;\n  let recordSubRect!: FrcRect;\n  const chips: FrcChip[] = [];\n  let awardsLabelRect: FrcRect | null = null;\n  const awardLines: FrcAwardLine[] = [];\n\n  if (landscape) {\n    // Left column: hero stacked under the header, pushed down a touch.\n    const heroStackH = 2 * heroCellH + gap;\n    const leftSlack = Math.max(0, footerY - gap - headerBottom - heroStackH);\n    let y = headerBottom + gap + Math.round(Math.min(leftSlack * 0.35, 0.08 * H));\n    rankBigRect = { x: margin, y, w: leftW, h: bigH };\n    rankSubRect = rankSub ? { x: margin, y: y + bigH + Math.round(0.3 * gap), w: leftW, h: subH } : null;\n    y += heroCellH + gap;\n    recordBigRect = { x: margin, y, w: leftW, h: bigH };\n    recordSubRect = { x: margin, y: y + bigH + Math.round(0.3 * gap), w: leftW, h: subH };\n\n    // Right column: chips at the top, the awards pinned into the lower half.\n    let cy = margin;\n    chipTexts.forEach((c) => {\n      const fit: FrcFit = { text: c.text, px: chipPx, width: widthOf(c.text, chipPx, true) };\n      const box: FrcRect = { x: rightX, y: cy, w: rightW, h: chipH };\n      const inner: FrcRect = { x: box.x + ring, y: box.y + ring, w: box.w - 2 * ring, h: box.h - 2 * ring };\n      chips.push({ key: c.key, label: c.label, box, inner, text: fit, textRect: inner });\n      cy += chipH + chipGapY;\n    });\n    if (m.awards.length > 0 && awardsLabel) {\n      const chipsBottom = chips.length > 0 ? cy - chipGapY : margin;\n      const top = Math.max(chipsBottom + (chips.length > 0 ? gap : 0), Math.round(0.5 * H));\n      const bottom = footerY - gap;\n      const ay = top + Math.max(0, Math.round((bottom - top - awardsBlockH) / 2));\n      awardsLabelRect = { x: rightX, y: ay, w: rightW, h: awardsLabelH };\n      let ly = ay + awardsLabelH + Math.round(0.3 * gap);\n      m.awards.forEach((a, i) => {\n        const textW = Math.max(8, rightW - tickSide - tickGap);\n        awardLines.push({\n          index: i,\n          text: { text: a, px: awardPx, width: widthOf(a, awardPx) },\n          textRect: { x: rightX + tickSide + tickGap, y: ly, w: textW, h: awardLineH },\n          tickRect: { x: rightX, y: ly + Math.round((awardLineH - tickSide) / 2), w: tickSide, h: tickSide },\n        });\n        ly += awardLineH + awardLineGap;\n      });\n    }\n  } else {\n    // Square and portrait: five stacked bands, the slack shared out as gaps.\n    const cellW = Math.round((contentW - gap) / 2);\n    const bands: Array<{ kind: \"hero\" | \"chips\" | \"awards\"; h: number }> = [{ kind: \"hero\", h: heroCellH }];\n    if (chipsBlockH > 0) bands.push({ kind: \"chips\", h: chipsBlockH });\n    if (awardsBlockH > 0) bands.push({ kind: \"awards\", h: awardsBlockH });\n    const natural = bands.reduce((a, b) => a + b.h, 0);\n    const middleBottom = footerY - gap;\n    const slack = Math.max(0, middleBottom - headerBottom - natural);\n    const share = Math.round(slack / (bands.length + 1));\n    let y = headerBottom + share;\n    for (const band of bands) {\n      if (band.kind === \"hero\") {\n        const subY = y + bigH + Math.round(0.3 * gap);\n        rankBigRect = { x: margin, y, w: cellW, h: bigH };\n        rankSubRect = rankSub ? { x: margin, y: subY, w: cellW, h: subH } : null;\n        recordBigRect = { x: margin + cellW + gap, y, w: Math.max(8, contentW - cellW - gap), h: bigH };\n        recordSubRect = { x: margin + cellW + gap, y: subY, w: Math.max(8, contentW - cellW - gap), h: subH };\n      } else if (band.kind === \"chips\") {\n        chipTexts.forEach((c, i) => {\n          const w = chipTexts.length === 2 ? cellW : Math.round((contentW - gap) / 2);\n          const x = margin + i * (w + gap);\n          const fit: FrcFit = { text: c.text, px: chipPx, width: widthOf(c.text, chipPx, true) };\n          const box: FrcRect = { x, y, w, h: chipH };\n          const inner: FrcRect = { x: box.x + ring, y: box.y + ring, w: box.w - 2 * ring, h: box.h - 2 * ring };\n          chips.push({ key: c.key, label: c.label, box, inner, text: fit, textRect: inner });\n        });\n      } else if (awardsLabel) {\n        awardsLabelRect = { x: margin, y, w: contentW, h: awardsLabelH };\n        let ly = y + awardsLabelH + Math.round(0.3 * gap);\n        m.awards.forEach((a, i) => {\n          const textW = Math.max(8, contentW - tickSide - tickGap);\n          awardLines.push({\n            index: i,\n            text: { text: a, px: awardPx, width: widthOf(a, awardPx) },\n            textRect: { x: margin + tickSide + tickGap, y: ly, w: textW, h: awardLineH },\n            tickRect: { x: margin, y: ly + Math.round((awardLineH - tickSide) / 2), w: tickSide, h: tickSide },\n          });\n          ly += awardLineH + awardLineGap;\n        });\n      }\n      y += band.h + share;\n    }\n  }\n\n  return {\n    W, H, S, landscape,\n    label, labelRect, ruleRect,\n    team, teamRect, name, nameRect, event, eventRect, week, weekRect,\n    rankBig, rankBigRect, rankSub, rankSubRect,\n    recordBig, recordBigRect, recordSub, recordSubRect,\n    chips,\n    awardsLabel, awardsLabelRect, awards: awardLines,\n    points, pointsRect, credit, creditRect,\n  };\n}\n\n/**\n * What the geometry promises (the brief's contract): every text measured and\n * fitted; the team number in the top band; the footer texts in the bottom\n * one; the hero pair, the chips (when their props say so) and the awards\n * block (when non-empty, in the middle band) present. No exact fractions -\n * the reflow between square bands and landscape columns is the template's\n * own business.\n */\nexport function frcContract(L: FrcLayout): LayoutConstraint[] {\n  const constraints: LayoutConstraint[] = [\n    textFitsMeasured(\"card-label\", L.label.text, L.label.px, L.label.width),\n    textFitsMeasured(\"team-number\", L.team.text, L.team.px, L.team.width),\n    { label: \"team-number\", within: { yFrac: [0, 0.3] } },\n    ...(L.name ? [textFitsMeasured(\"team-name\", L.name.text, L.name.px, L.name.width)] : []),\n    ...(L.event ? [textFitsMeasured(\"event-line\", L.event.text, L.event.px, L.event.width)] : []),\n    ...(L.week ? [textFitsMeasured(\"week-line\", L.week.text, L.week.px, L.week.width)] : []),\n    textFitsMeasured(\"rank-number\", L.rankBig.text, L.rankBig.px, L.rankBig.width),\n    { label: \"rank-number\" },\n    ...(L.rankSub ? [textFitsMeasured(\"rank-sub\", L.rankSub.text, L.rankSub.px, L.rankSub.width)] : []),\n    textFitsMeasured(\"record-text\", L.recordBig.text, L.recordBig.px, L.recordBig.width),\n    { label: \"record-text\" },\n    textFitsMeasured(\"record-sub\", L.recordSub.text, L.recordSub.px, L.recordSub.width),\n    ...L.chips.flatMap((c) => [textFitsMeasured(c.label, c.text.text, c.text.px, c.text.width), { label: c.label } as LayoutConstraint]),\n    ...(L.awardsLabel ? [textFitsMeasured(\"awards-label\", L.awardsLabel.text, L.awardsLabel.px, L.awardsLabel.width), { label: \"awards-label\", within: { yFrac: [0.45, 0.9] } } as LayoutConstraint] : []),\n    ...L.awards.map((a) => textFitsMeasured(`award-${a.index}`, a.text.text, a.text.px, a.text.width)),\n    ...(L.points ? [textFitsMeasured(\"footer-points\", L.points.text, L.points.px, L.points.width), { label: \"footer-points\", within: { yFrac: [0.85, 1] } } as LayoutConstraint] : []),\n    textFitsMeasured(\"footer-credit\", L.credit.text, L.credit.px, L.credit.width),\n    { label: \"footer-credit\", within: { yFrac: [0.85, 1] } },\n  ];\n  return constraints;\n}\n\n/**\n * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n * convention, src/_shared/why.ts). Filled from journal/2026-10-22/.\n */\nconst WHY: WhySpec = {\n  day: 33,\n  date: \"2026-10-22\",\n  agent: \"opencode\",\n  model: \"kimi-k3\",\n  id: ID,\n  title: \"FRC Event Recap\",\n  who: \"FIRST Robotics Competition media students and mentors, on Chief Delphi and team social accounts, with The Blue Alliance as the shared record\",\n  problem: [\n    \"After every event someone on the team writes the recap post. A 2026 build thread: \\\"the media team uploaded some pictures, and I have had a nap! That means it is time to write an event recap\\\" - with rank, EPA and alliance quoted from The Blue Alliance and Statbotics.\",\n    \"The numbers all live on one shared page: \\\"Team 9128 was Rank 1 with a record of 17-0-0 ... competed in the playoffs as the Captain of Alliance 1 and won the event\\\" - qual rank, W-L-T record, alliance selection, awards, district points.\",\n    \"The appetite for a rendered card is proven: team 9077's FRC Rewind web app turns a season into \\\"a high-quality shareable recap card\\\", and the first reply is \\\"Now I have something other than Spotify Wrapped!\\\"\",\n  ],\n  sources: [\n    \"https://www.chiefdelphi.com/t/release-frc-rewind-a-visual-season-recap-for-every-frc-team/522858\",\n    \"https://www.thebluealliance.com/team/9128/2026\",\n    \"https://www.chiefdelphi.com/t/frc-team-1710-2026-build-thread-open-alliance/507939?page=4\",\n  ],\n  solution: [\n    \"One deterministic card per event: the props mirror The Blue Alliance's team-event fields one for one - team number, event, week, qual rank, W-L-T record, alliance selection, playoff finish, awards, district points. Batch a whole season from a JSON file.\",\n    \"The design decision that matters: derive what can be derived and constrain the rest to TBA's own vocabulary - the chips come from closed enums, so their text always fits; awards, the one free text, are capped at three lines and shrink to fit, never ellipsized.\",\n    \"Honest weak spots: no robot photos and no logos - it is a numbers card that rides beside the team's pictures; and a regional or offseason event just zeroes the district points out of the footer.\",\n  ],\n  usage: {\n    command: \"m0saic make @one-a-day/sports/frc-event-recap/v1 --template-repo . -w 1080 -h 1080 -o recap.png\",\n    try: [\n      \"teamNumber 2471, eventName \\\"Portland District\\\", weekLabel \\\"Week 2\\\" - your own event\",\n      \"allianceRole \\\"pick1\\\" + allianceNumber 4 prints \\\"1ST PICK - ALLIANCE 4\\\"\",\n      \"playoffResult \\\"finalist\\\"; awards [\\\"Industrial Design Award\\\", \\\"Gracious Professionalism Award\\\"]\",\n      \"districtPoints 0 for a regional or offseason event; teamCount 0 drops the \\\"of N teams\\\" line\",\n    ],\n  },\n  caveats: [\n    \"Award names are free text and TBA's run long: up to 3 lines, 60 ASCII characters each, shrunk to fit - never ellipsized.\",\n    \"qualRank above teamCount (when teamCount is set) is refused: a card that says RANK 12 of 10 teams is lying.\",\n    \"Numbers and chips only - no FIRST or TBA marks, no photos; pair it with the team's robot picture.\",\n  ],\n  timeline: {\n    source: \"runner\",\n    phases: [\n      { name: \"scout\", startMs: 0, durMs: 623202, calls: 28, tokens: 1262534, costUsd: 0.96, tools: \"bash 11, websearch 10, read 4\" },\n      { name: \"plan\", startMs: 623230, durMs: 276206, calls: 14, tokens: 511564, costUsd: 0.77, tools: \"read 10, edit 2, bash 1\" },\n    ],\n    costBasis: \"reported\",\n  },\n};\n\nexport const FrcEventRecapV1 = defineMosaicTemplate<FrcEventRecapProps>({\n  id: asTemplateId(ID),\n  label: \"2026-10-22 · FRC Event Recap\",\n  version: 1,\n  description:\n    \"An FRC event recap card from The Blue Alliance team-event fields: team number, event and week, qual rank of N teams, the W-L-T record, alliance-selection and playoff chips, up to three award lines, and district points in the footer.\",\n  capabilities: { tier: \"core\" },\n  tags: [\"sports\", \"2026-10-22\", \"day-033\", \"frc\", \"robotics\", \"recap\", \"blue-alliance\", \"event\", \"card\"],\n\n  outputHints: {\n    width: 1080,\n    height: 1080,\n    fps: 30,\n    durationMs: 2000,\n    format: { kind: \"image\", container: \"png\" },\n    note: \"A square still for the recap post (the Instagram feed). 1920x1080 splits header+hero left and chips+awards right; 1080x1920 stacks the five bands.\",\n  },\n\n  propsSchema,\n  defaultProps: {\n    teamNumber: DEFAULTS.teamNumber,\n    teamName: DEFAULTS.teamName,\n    eventName: DEFAULTS.eventName,\n    weekLabel: DEFAULTS.weekLabel,\n    qualRank: DEFAULTS.qualRank,\n    teamCount: DEFAULTS.teamCount,\n    record: DEFAULTS.record,\n    allianceRole: DEFAULTS.allianceRole,\n    allianceNumber: DEFAULTS.allianceNumber,\n    playoffResult: DEFAULTS.playoffResult,\n    awards: [...DEFAULTS.awards],\n    districtPoints: DEFAULTS.districtPoints,\n    accent: DEFAULTS.accent,\n    debugLayout: false,\n  },\n\n  render,\n  renderTutorial: whyTutorial(WHY, render),\n});\n\nexport default FrcEventRecapV1;\n\nasync function render(props: FrcEventRecapProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n  // The schema is documentation; render() is the gate.\n  const m = normalizeFrcEventRecap(props);\n  const W = Math.max(1, Math.round(ctx.target.width));\n  const H = Math.max(1, Math.round(ctx.target.height));\n  const L = layoutFrc(m, W, H);\n\n  const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n  const piece = (rect: FrcRect, importance: number, source: MosaicSource) => pieces.push({ rect: { ...rect, importance }, source });\n\n  // No backdrop rect: the page is document.backgroundColor below.\n\n  // ── header: the label, the accent rule (bound to the color prop it shows),\n  //    TEAM N, the name, the event ──\n  piece(L.labelRect, 2, tag(textCell({ text: L.label.text, fontSize: L.label.px, color: DIM, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"card-label\" }), \"card-label\"));\n  piece(L.ruleRect, 1, bindProp(tag(makeColorTile(m.accent) as MosaicSource, \"header-rule\"), \"accent\"));\n  piece(L.teamRect, 3, bindProp(tag(textCell({ text: L.team.text, fontSize: L.team.px, color: INK, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"team-number\" }), \"team-number\"), \"teamNumber\"));\n  if (L.name && L.nameRect) piece(L.nameRect, 3, bindProp(tag(textCell({ text: L.name.text, fontSize: L.name.px, color: DIM, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"team-name\" }), \"team-name\"), \"teamName\"));\n  if (L.event && L.eventRect) piece(L.eventRect, 3, bindProp(tag(textCell({ text: L.event.text, fontSize: L.event.px, color: INK, hAlign: \"left\", vAlign: \"middle\", label: \"event-line\" }), \"event-line\"), \"eventName\"));\n  if (L.week && L.weekRect) piece(L.weekRect, 3, bindProp(tag(textCell({ text: L.week.text, fontSize: L.week.px, color: INK, hAlign: \"left\", vAlign: \"middle\", label: \"week-line\" }), \"week-line\"), \"weekLabel\"));\n\n  // ── the hero pair ──\n  piece(L.rankBigRect, 3, bindProp(tag(textCell({ text: L.rankBig.text, fontSize: L.rankBig.px, color: INK, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"rank-number\" }), \"rank-number\"), \"qualRank\"));\n  if (L.rankSub && L.rankSubRect) piece(L.rankSubRect, 3, bindProp(tag(textCell({ text: L.rankSub.text, fontSize: L.rankSub.px, color: DIM, hAlign: \"left\", vAlign: \"middle\", label: \"rank-sub\" }), \"rank-sub\"), \"teamCount\"));\n  piece(L.recordBigRect, 3, bindProp(tag(textCell({ text: L.recordBig.text, fontSize: L.recordBig.px, color: INK, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"record-text\" }), \"record-text\"), \"record\"));\n  piece(L.recordSubRect, 3, tag(textCell({ text: L.recordSub.text, fontSize: L.recordSub.px, color: DIM, hAlign: \"left\", vAlign: \"middle\", label: \"record-sub\" }), \"record-sub\"));\n\n  // ── the chips: accent outline, page fill, the enum's own words ──\n  L.chips.forEach((c) => {\n    piece(c.box, 1, tag(makeColorTile(m.accent) as MosaicSource, `${c.label}-box`));\n    piece(c.inner, 2, tag(makeColorTile(PAGE) as MosaicSource, `${c.label}-fill`));\n    // The chip text is the enum's own words; closed pickers never carry a rect\n    // binding (the gate: bindingsSound) - Make edits them from the panel.\n    piece(c.textRect, 3, tag(textCell({ text: c.text.text, fontSize: c.text.px, color: INK, hAlign: \"center\", bold: true, vAlign: \"middle\", label: c.label }), c.label));\n  });\n\n  // ── the awards: label, then a tick and a line each ──\n  if (L.awardsLabel && L.awardsLabelRect) piece(L.awardsLabelRect, 3, tag(textCell({ text: L.awardsLabel.text, fontSize: L.awardsLabel.px, color: DIM, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"awards-label\" }), \"awards-label\"));\n  L.awards.forEach((a) => {\n    piece(a.tickRect, 2, tag(makeColorTile(m.accent) as MosaicSource, `award-tick-${a.index}`));\n    piece(a.textRect, 3, bindPropPath(tag(textCell({ text: a.text.text, fontSize: a.text.px, color: INK, hAlign: \"left\", vAlign: \"middle\", label: `award-${a.index}` }), `award-${a.index}`), \"awards\", [a.index], \"string\"));\n  });\n\n  // ── the footer ──\n  if (L.points && L.pointsRect) piece(L.pointsRect, 3, bindProp(tag(textCell({ text: L.points.text, fontSize: L.points.px, color: INK, hAlign: \"left\", bold: true, vAlign: \"middle\", label: \"footer-points\" }), \"footer-points\"), \"districtPoints\"));\n  piece(L.creditRect, 3, tag(textCell({ text: L.credit.text, fontSize: L.credit.px, color: DIM, hAlign: \"right\", vAlign: \"middle\", label: \"footer-credit\" }), \"footer-credit\"));\n\n  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n  const doc: MosaicDocument = {\n    kind: \"mosaic_document\",\n    version: 1,\n    m0: toM0String(placed.m0, ID),\n    assets: {},\n    size: { width: W, height: H },\n    fps: ctx.target.fps,\n    durationMs: 2000,\n    backgroundColor: PAGE,\n    sources: placed.sources,\n    editor: { label: `FRC Event Recap - Team ${m.teamNumber} - ${m.eventLine || \"event\"}` },\n  };\n  return withLayoutIntent(doc, ctx, { templateId: ID, constraints: frcContract(L), debug: props.debugLayout === true });\n}","lineStart":1,"lineEnd":827,"totalLines":827,"truncated":false}},"title":"journal\\2026-10-22\\variants\\a\\src\\frc-event-recap.ts","time":{"start":1792679823862,"end":1792679824194}},"id":"prt_1640b49d5001Xb5SgAOJe5873G","sessionID":"ses_e9bf6d764ffeDptE8dPE6jK8gv","messageID":"msg_1640ade3f001H6uOKIor9uyayA"}}
