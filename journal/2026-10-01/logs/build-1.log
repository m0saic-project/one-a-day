{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C36fS7Mmy1bGk4NekcdtSz","type":"tool_result","content":"1\timport type { MosaicDocument, MosaicEngineContext } from \"@m0saic/types\";\n2\timport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\n3\timport { assertLayout, checkLayout, textEmUnits, withLayoutContract } from \"@m0saic/template-utils\";\n4\t\n5\t/**\n6\t * The layout-contract convention — every template says what its geometry\n7\t * promises, and the promise travels with the document.\n8\t *\n9\t * `@m0saic/template-utils` already has the machinery: tag a source with a\n10\t * label, declare canvas-independent invariants against the label (`textFits`,\n11\t * `within`, `aspect`, `min/maxWidthFrac`, ...), and `withLayoutContract` checks\n12\t * them when the `debugLayout` knob is on (debug-only at render, by ruling:\n13\t * a render with a clipped line beats no render). What the substrate does not\n14\t * do is let a GATE see the contract - the constraints live inside `render()`.\n15\t *\n16\t * `withLayoutIntent` is `withLayoutContract` plus one stamp: the constraints\n17\t * and relations go on `doc.editor.layoutIntent` on EVERY render (a few hundred\n18\t * bytes of plain data, deterministic, UI-only metadata). `tools/check-layout.mjs`\n19\t * reads it off a default render and sweeps the 7-canvas set with\n20\t * `checkLayout`; the template's own test does the same through `sweepLayout`.\n21\t *\n22\t * What a template should promise (the general tidiness of one template, not\n23\t * pixel positions): every fitted text fits its box (`textFits` on every text\n24\t * label), the chrome lives where the design says (`within` bands, a full-width\n25\t * bar is `minWidthFrac: 1`), a mark keeps its shape (`aspect`), and nothing\n26\t * the design needs is missing (a bare `{ label }` is a presence check).\n27\t * Pin exact fractions only when the brief demands them.\n28\t */\n29\t\n30\texport type LayoutIntent = {\n31\t  constraints: LayoutConstraint[];\n32\t  relations?: RelationalConstraint[];\n33\t  /** Assert through nested children (default: auto). */\n34\t  flatten?: boolean;\n35\t};\n36\t\n37\t/** The canvases the convention sweeps: the 7-canvas set from the authoring contract. */\n38\texport const CONTRACT_CANVASES: ReadonlyArray<readonly [number, number]> = [\n39\t  [1920, 1080],\n40\t  [1280, 720],\n41\t  [1080, 1920],\n42\t  [1080, 1080],\n43\t  [3840, 2160],\n44\t  [640, 360],\n45\t  [480, 270],\n46\t];\n47\t\n48\t/**\n49\t * Calibrated `charWidthEm` rulers for the BUNDLED font (Roboto, the svg\n50\t * rasterizer's): measured width / (em-units x fontSize) over the repo's copy\n51\t * on 2026-09-20 - prose 0.42-0.47, ALL-CAPS 0.57-0.59, URLs ~0.52 - plus a\n52\t * ~12% margin. The contract's default 0.72 is for an unknown font and flags\n53\t * a full-width Roboto line that fits; `textFitsMeasured` is exact when the\n54\t * template measured the block itself.\n55\t */\n56\texport const TEXT_EM = { prose: 0.52, caps: 0.66, url: 0.6 } as const;\n57\t\n58\t/** `textFits` for every label in `labels` - the one constraint every text needs. */\n59\texport function textFitsAll(labels: readonly string[], opts?: { charWidthEm?: number; padPx?: number }): LayoutConstraint[] {\n60\t  return labels.map((label) => ({ label, textFits: { ...(opts ?? {}) } }));\n61\t}\n62\t\n63\t/**\n64\t * `textFits` calibrated to a MEASURED block. The contract's ruler estimates\n65\t * `em-units x fontSize x charWidthEm` with a coarse 0.72 default (Roboto\n66\t * prose is nearer 0.46), so a text that was fitted against the real font at\n67\t * the full box width would be flagged for clipping it cannot do. Hand the\n68\t * contract the measured ratio (+2%) instead: the check then compares the\n69\t * TRUE width with the REALIZED box - which is the crush it exists to catch.\n70\t */\n71\texport function textFitsMeasured(label: string, text: string, fontSize: number, measuredWidthPx: number): LayoutConstraint {\n72\t  const longest = text.split(\"\\n\").reduce((m, l) => Math.max(m, textEmUnits(l)), 0);\n73\t  const em = longest > 0 && fontSize > 0 ? (measuredWidthPx / (longest * fontSize)) * 1.02 : 0.72;\n74\t  return { label, textFits: { charWidthEm: Math.max(0.05, Math.min(2, em)), padPx: 0 } };\n75\t}\n76\t\n77\t/**\n78\t * `withLayoutContract` (the debug tripwire) + the intent stamp (always).\n79\t * Return this from `render()` in place of the bare document.\n80\t */\n81\texport function withLayoutIntent(\n82\t  doc: MosaicDocument,\n83\t  ctx: MosaicEngineContext,\n84\t  opts: { templateId: string; debug?: boolean } & LayoutIntent,\n85\t): MosaicDocument {\n86\t  const intent: LayoutIntent = {\n87\t    constraints: mergeTextFits(opts.constraints),\n88\t    ...(opts.relations && opts.relations.length > 0 ? { relations: opts.relations } : {}),\n89\t    ...(opts.flatten !== undefined ? { flatten: opts.flatten } : {}),\n90\t  };\n91\t  const checked = withLayoutContract(doc, ctx, {\n92\t    templateId: opts.templateId,\n93\t    constraints: intent.constraints,\n94\t    relations: opts.relations,\n95\t    flatten: opts.flatten,\n96\t    debug: opts.debug === true,\n97\t  });\n98\t  return { ...checked, editor: { ...(checked.editor ?? {}), layoutIntent: intent } as MosaicDocument[\"editor\"] };\n99\t}\n100\t\n101\t/**\n102\t * A label is one-to-MANY: a `textFits` constraint applies to EVERY node that\n103\t * carries its label. Several measured constraints on one label (five\n104\t * `phase-meta` cells with different copy) would each be checked against all\n105\t * five - the widest calibration wins, so a narrower sibling could be flagged\n106\t * for a clip it cannot do. Merge them: one `textFits` per label, the WIDEST\n107\t * em (the check stays a true upper bound), other constraints untouched.\n108\t * Prefer unique labels for cells with different copy; this is the safety net.\n109\t */\n110\texport function mergeTextFits(constraints: LayoutConstraint[]): LayoutConstraint[] {\n111\t  const widest = new Map<string, LayoutConstraint>();\n112\t  const out: LayoutConstraint[] = [];\n113\t  for (const c of constraints) {\n114\t    if (!c.textFits) { out.push(c); continue; }\n115\t    const prev = widest.get(c.label);\n116\t    if (!prev) { const copy = { ...c, textFits: { ...c.textFits } }; widest.set(c.label, copy); out.push(copy); continue; }\n117\t    const em = Math.max(prev.textFits?.charWidthEm ?? 0.72, c.textFits.charWidthEm ?? 0.72);\n118\t    const pad = Math.max(prev.textFits?.padPx ?? 2, c.textFits.padPx ?? 2);\n119\t    prev.textFits = { charWidthEm: em, padPx: pad };\n120\t  }\n121\t  return out;\n122\t}\n123\t\n124\t/** The stamped intent of a rendered document, or null when the template declared none. */\n125\texport function layoutIntentOf(doc: MosaicDocument): LayoutIntent | null {\n126\t  const v = (doc.editor as { layoutIntent?: unknown } | undefined)?.layoutIntent;\n127\t  if (!v || typeof v !== \"object\" || !Array.isArray((v as LayoutIntent).constraints)) return null;\n128\t  return v as LayoutIntent;\n129\t}\n130\t\n131\t/** Labels of every `type: \"text\"` source (tagged or not - untagged ones come back as null). */\n132\texport function textLabelsOf(doc: MosaicDocument): Array<string | null> {\n133\t  return (doc.sources ?? [])\n134\t    .filter((s) => s && (s as { type?: string }).type === \"text\")\n135\t    .map((s) => (s as { editor?: { label?: string } }).editor?.label ?? null);\n136\t}\n137\t\n138\t/**\n139\t * Render at every contract canvas and assert the stamped intent holds -\n140\t * the sweep every template's test runs. `variants` are prop overrides worth\n141\t * stressing (long copy, emptied rows, every closed-set value).\n142\t */\n143\texport async function sweepLayout<P extends object>(\n144\t  render: (props: P, ctx: MosaicEngineContext) => Promise<MosaicDocument> | MosaicDocument,\n145\t  templateId: string,\n146\t  props: P,\n147\t  makeCtx: (w: number, h: number) =>