nd this target.\n   */\n  conventions?: string;\n};\n\n/**\n * Preview asset references for a template listing card.\n *\n * All paths are **repo-relative**, intended for zero-exec browsing UIs.\n */\nexport type MosaicTemplatePreview = {\n  /** Repo-relative path to a static preview image (preferred). */\n  image?: string;\n\n  /** Repo-relative path to a short looping preview video (optional). */\n  video?: string;\n\n  /** Repo-relative poster image for video previews (optional). */\n  poster?: string;\n};\n\n/**\n    errors: [],\n    warnings: [],\n    lagging: [],\n    notes: [],\n    fingerprints: { srcRoot: opts.srcRoot ?? \"src\", fallbackDir: LAYOUT_FINGERPRINTS_DIR, present: false, unchanged: 0, missing: 0, changed: 0 },\n    conventions: { meets: null, behind: [], byTemplate: [], shippedAt: null, target: null, lagOnly: false },\n  };\n  const srcRoot = opts.srcRoot ?? \"src\";\n  const shipped = readFreezeShipped(repoPath, srcRoot);\n  report.conventions.shippedAt = shipped.release;\n  process.env.M0SAIC_CLI ??= \"/usr/bin/false\"; // no template may re-invoke a CLI from a check\n\n  // Forget findings from anything loaded earlier in this process.\n  drainTemplateConventionFindings();\n\n  const loaded = await withExternalTemplateOrigin(repoPath, () => deps.load(repoPath, { entryOverridePath: opts.entry }));\n  report.loadDiagnostics = loaded.diagnostics.map((d) => ({ code: String(d.code), severity: d.severity, message: d.message }));\n  // A manifest the doctor cannot read is reported, not fatal: the templates it\n  // could not place are simply held to every current rule.\n  for (const message of shipped.problems) report.loadDiagnostics.push({ code: \"FREEZE_MANIFEST\", severity: \"warning\", message });\n  report.repo.id = loaded.repo?.repoId ? String(loaded.repo.repoId) : null;\n  report.repo.displayName = loaded.repo?.displayName ?? null;\n  report.repo.templates = loaded.templates.length;\n  // The repo's conventions target (0.3.1): the line whose rules it has adopted.\n  const declaredTarget = (loaded.repo as { conventions?: unknown } | undefined)?.conventions;\n  if (declaredTarget !== undefined) {\n    const newest = conventionVersions().slice(-1)[0] ?? null;\n    if (typeof declaredTarget !== \"string\" || !effectiveConventionLine(declaredTarget)) {\n      report.loadDiagnostics.push({ code: \"CONVENTIONS_TARGET\", severity: \"warning\", message: `repo.conventions ${JSON.stringify(declaredTarget)} is not an m0saic line (MAJOR.MINOR.PATCH) — the repo is held to every rule` });\n    } else {\n      report.conventions.target = declaredTarget.trim();\n      if (newest && compareConventionVersions(report.conventions.target, newest) > 0) {\n        report.notes.push({ templateId: report.repo.id ?? \"(repo)\", note: `repo.conventions targets ${report.conventions.target}, newer than this CLI's rules (${newest}) — update m0saic to check the rules that line adds` });\n      }\n    }\n  }\n  if (loaded.diagnostics.some((d) => d.severity === \"error\")) {\n    report.ok = false;\n    return { report, exitCode: 1 };\n  }\n\n  // Register as a host would (a lesson may invoke a sibling by id), still\n  // under the external origin so conventions record instead of throwing.\n  withExternalTemplateOrigin(repoPath, () => {\n    for (const t of loaded.templates) registerTemplate(t);\n  });\n  const ids = new Set(loaded.templates.map((t) => String(t.id)));\n  const shippedAtFor = (templateId: string): string | null => shippedLineFor(templateId, report.repo.id, srcRoot, shipped);\n  const target = report.conventions.target;\n  // Held to the lower of the template's shipped line and the repo's target.\n  const heldToFor = (templateId: string): string | undefined => effectiveConventionLine(shippedAtFor(templateId), target);\n  const isLag = (convention: string, line: string): boolean =>\n    compareConventionVersions(TEMPLATE_CONVENTION_SINCE[convention as keyof typeof TEMPLATE_CONVENTION_SINCE] ?? \"0.0.0\", line) > 0;\n\n  // 