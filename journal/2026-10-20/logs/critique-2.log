\\stills\\landscape.png                  94440 \r\nC:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-20\\variants\\b\\stills\\portrait.png                   101035\r\nC:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-20\\variants\\b\\stills\\square.png                     74100 \r\nC:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-20\\variants\\b\\stills\\tutorial-1.png                 159511\r\nC:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-20\\variants\\b\\stills\\tutorial-2.png                 217009\r\nC:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-20\\variants\\b\\stills\\tutorial-3.png                 261870\r\nC:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-20\\variants\\b\\stills\\tutorial-4.png                 215265\r\nC:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-20\\variants\\b\\stills\\tutorial-5.png                 103984\r\nC:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-20\\variants\\b\\stills\\tutorial-6.png                 115553\r\n\r\n\r\n","exit":0,"truncated":false},"title":"Get-ChildItem -Recurse \"C:\\src\\m0saic-production\\one-a-day\\journal\\2026-10-20\\variants\" | Select-Object FullName, Length","time":{"start":1792530912494,"end":1792530912774}},"id":"prt_15b2b1409001yN02ecwydK3tkP","sessionID":"ses_ea4d52decffeaHsc6A3RWeHtGB","messageID":"msg_15b2b06c30013Uhj0zGjjNe2wz"}}
