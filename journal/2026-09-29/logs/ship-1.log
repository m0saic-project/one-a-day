urnal\"}`;\n  return `${head}\\n\\nAgent: ${agent ?? \"unknown\"}\\nModel: ${model ?? \"undeclared\"} (self-declared)\\n`;\n}\n\n/**\n * @returns {Promise<{ok:boolean,status:\"shipped\"|\"no-ship\"|\"failed\",templateId:string|null,reasons:string[],sha:string|null}>}\n */\nexport async function runGate({ repo, date, dayDir, noPush = false, remote = \"origin\", branch = \"main\", env = {}, say = console.log }) {\n  const logFile = path.join(dayDir, \"logs\", \"gate.log\");\n  const reasons = [];\n  const fail = (r) => { reasons.push(r); say(`[gate] ✗ ${r}`); };\n  const ok = (r) => say(`[gate] ✓ ${r}`);\n  const run = (cmd, args, extra = {}) => runProcess({ cmd, args, cwd: repo, env, logFile, timeoutMs: 20 * 60 * 1000, ...extra });\n  const state = readState(dayDir);\n  const runRec = readRun(dayDir);\n  const day = dayNumber(repo, date);\n  const agent = runRec.runner?.adapter ?? \"unknown\";\n  const model = runRec.model?.selfDeclared ?? null;\n  // Which roster slot drew today (null when the agent was named by hand).\n  // Tomorrow's draw reads it back out of the index to avoid a repeat.\n  const rosterId = runRec.runner?.roster?.id ?? null;\n  const wantShip = state.decision === \"ship\";\n\n  // ── 0. scratch: stray render outputs and journal-side runtime caches are\n  //      deleted, logged, and never counted against the day ──\n  let changes = classifyChanges(porcelain(repo), { date });\n  if (changes.scratch.length) {\n    const byReason = new Map();\n    for (const s of changes.scratch) byReason.set(s.reason, (byReason.get(s.reason) ?? 0) + 1);\n25:export function templateIdForDir(repoId, dir) {\n29:export function encodeTemplateKey(id) { return id.replace(/\\//g, \"__\"); }\n31:export function commitMessage({ day, templateId, title, agent, model, reason }) {\n39:export async function runGate({ repo, date, dayDir, noPush = false, remote = \"origin\", branch = \"main\", env = {}, say = console.log }) {","stderr":"","interrupted":false,"isImage":false,"noOutp