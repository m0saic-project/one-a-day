{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NdgTF9eSNBTEUtCHFnhK1p","type":"tool_result","content":"1\timport type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\n2\timport { asTemplateId } from \"@m0saic/types\";\n3\timport { toM0String } from \"@m0saic/dsl-stdlib\";\n4\timport { bindProp, bindPropPath, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\n5\timport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\n6\timport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n7\timport { budget, textCell, widthOf } from \"../../../_shared/text\";\n8\timport { whyTutorial } from \"../../../_shared/why\";\n9\timport type { WhySpec } from \"../../../_shared/why\";\n10\t\n11\t/**\n12\t * `@one-a-day/music/radio-top-30-chart/v1` - a radio station's weekly chart\n13\t * as one card: the station, a computed `TOP 30`, the week, and every row as\n14\t * rank / artist / title / label, from the lines a music director already\n15\t * types (`Artist | Title | Label | last week`).\n16\t *\n17\t * ONE CONCEPT: the fit rule is the template. A row is two lines (the artist,\n18\t * bold; then the title with the label after it in dimmer ink), every row cell\n19\t * is the same size, and thirty rows share one artist size and one title size\n20\t * so the columns read as columns. Long copy goes down a ladder, in this\n21\t * order:\n22\t *   1. the shared sizes come down together, by at most 15%, for every line\n23\t *      that can be fitted inside that allowance;\n24\t *   2. a line that needs more shrinks ALONE, to no less than half its cap,\n25\t *      and costs the other rows nothing;\n26\t *   3. past that the render refuses, naming the row and the canvas. No\n27\t *      ellipsis, no clipping, no dropped label.\n28\t * The grid follows the aspect: up to 10 rows a column on a wide canvas\n29\t * (3 x 10), up to 15 on a square or portrait one (2 x 15); ranks read down a\n30\t * column, then the next.\n31\t *\n32\t * The rule that bites: nothing here is typed twice. The rank is the position\n33\t * in the list, the count in the title is the number of rows, and the marker\n34\t * under a rank is last week's rank minus this week's (`+3`, `-2`, `=`, `NEW`,\n35\t * `RE`), as text: the bundled font has no arrows, and up is the accent, down\n36\t * is dim ink, never red or green. Sizes are fractions of the canvas with no\n37\t * pixel floor, so a 480x270 render is a thumbnail of the 1920x1080 one, not a\n38\t * different card.\n39\t */\n40\t\n41\texport type RadioTop30ChartProps = {\n42\t  /** The header mark: call sign and frequency, free text. */\n43\t  station?: string;\n44\t  /** The line under the station. \"\" removes it. */\n45\t  weekOf?: string;\n46\t  /** Prefix of the chart title: \"Loud Rock\" gives LOUD ROCK TOP 10. \"\" gives TOP 30. */\n47\t  genre?: string;\n48\t  /** The chart, in rank order: 1-30 lines of \"Artist | Title | Label\" or \"Artist | Title | Label | LW\". */\n49\t  rows?: string[];\n50\t  /** The bottom line: a URL, a credit. \"\" removes the line. */\n51\t  footer?: string;\n52\t  /** Rank numerals, the chart title, up / NEW / RE markers, as #rrggbb. */\n53\t  accent?: string;\n54\t  /** Page and ink. */\n55\t  preset?: \"dark\" | \"light\";\n56\t  /** Rank 1 as a full-width lead row above the grid. */\n57\t  lead?: boolean;\n58\t  /** Dev-only: check the layout contract and draw it over the card. */\n59\t  debugLayout?: boolean;\n60\t};\n61\t\n62\tconst ID = \"@one-a-day/music/radio-top-30-chart/v1\";\n63\tconst DEFAULT_ACCENT = \"#ff3d9a\";\n64\tconst THEMES = {\n65\t  dark: { bg: \"#131117\", row: \"#1e1b25\", ink: \"#f4f2f6\", dim: \"#a09bab\" },\n66\t  light: { bg: \"#f1eee7\", row: \"#fffdf9\", ink: \"#18151c\", dim: \"#6b6674\" },\n67\t} as const;\n68\t\n69\t// An invented station and an invented chart. 91.6 is an even-tenth frequency,\n70\t// which is not a US FM channel, so the default cannot be mistaken for a real\n71\t// station's chart. Row 7's title is 53 characters on purpose: it is the row\n72\t// that shows what the fit ladder does.\n73\tconst DEFAULT_ROWS = [\n74\t  \"Paper Lanterns | Night Bus Home | Tidewater | 2\",\n75\t  \"Glass Orchard | Slow Weather | Half Moon Recordings | 1\",\n76\t  \"The Marigolds | Kitchen Radio | Fern & Flint | 5\",\n77\t  \"Delta Kiosk | Parking Lot Hymns | Low Tide | 4\",\n78\t  'Nora Vance | \"Blue Receipt\" [Single] | Self-Released | NEW',\n79\t  \"Static Bloom | Greenhouse | Tidewater | 3\",\n80\t  \"Hollow Pines | A Field Guide to Leaving Early Without Saying Goodbye | Brass Key | 12\",\n81\t  \"Juno Park | Soft Machines [EP] | Night Shift | 6\",\n82\t  \"Cardigan Sea | Postcards | Half Moon Recordings | 9\",\n83\t  \"Vera & the Lowlights | Last Call | Brass Key | 15\",\n84\t  \"Mothwing | Porchlight | Fern & Flint | 8\",\n85\t  \"Tall Grass Choir | Everything Is Fine Here | Low Tide | NEW\",\n86\t  \"Okapi | Signal Hill | Night Shift | 7\",\n87\t  \"Rosa Calloway | Late Bloomer | Tidewater | 10\",\n88\t  \"Sunday Arcade | High Score [EP] | Self-Released | 22\",\n89\t  \"The Understudies | Second String | Brass Key | 11\",\n90\t  \"Pilot Light | Embers | Low Tide | 13\",\n91\t  \"Ferris | Midway | Half Moon Recordings | RE\",\n92\t  \"Lakehouse Tapes | Volume Two | Self-Released | 14\",\n93\t  'Anya Brook | \"Cold Coffee\" [Single] | Fern & Flint | NEW',\n94\t  \"Quiet Motors | Idle | Night Shift | 16\",\n95\t  \"Marble Run | Gravity Songs | Tidewater | 19\",\n96\t  \"The Night Clerks | Room 12 | Brass Key | 17\",\n97\t  \"Wren Abbott | Small Hours | Low Tide | 27\",\n98\t  \"Copper Wire | Loose Ends | Half Moon Recordings | 18\",\n99\t  \"Day Camp | Bug Juice | Self-Released | 20\",\n100\t  \"Sister Static | AM Gold | Night Shift | 30\",\n101\t  \"Halloway | Winter Coat | Fern & Flint | 21\",\n102\t  \"Plum Street | Corner Store | Tidewater | NEW\",\n103\t  \"The Long Weekend | Monday | Brass Key | 24\",\n104\t];\n105\t\n106\tconst DEFAULTS = {\n107\t  station: \"KOAD 91.6 FM\",\n108\t  weekOf: \"Week of Oct 6, 2026\",\n109\t  genre: \"\",\n110\t  rows: DEFAULT_ROWS,\n111\t  footer: \"Sample chart: artists, titles and labels are invented\",\n112\t  accent: DEFAULT_ACCENT,\n113\t  preset: \"dark\" as \"dark\" | \"light\",\n114\t  lead: false,\n115\t  debugLayout: false,\n116\t};\n117\t\n118\tconst propsSchema = definePropsSchema<RadioTop30ChartProps>({\n119\t  rows: {\n120\t    type: \"json\",\n121\t    required: false,\n122\t    description:\n123\t      'The chart in rank order, 1 to 30 lines, each \"Artist | Title | Label\" or \"Artist | Title | Label | LW\". LW is last week\\'s rank (1-200), NEW, RE, or empty for no marker on that row. The rank is the position in the list and the count sets the title (TOP 30, TOP 10); the card does not sort or re-rank. NACC conventions such as \"Title\" [Single] and Title [EP] pass through as typed.',\n124\t    meta: {\n125\t      constraints: { jsonSchema: { type: \"array\", minItems: 1, maxItems: 30, items: { type: \"string\" } } },\n126\t      ui: { label: \"Chart rows\", order: 1, primary: true },\n127\t    },\n128\t  },\n129\t  station: {\n130\t    type: \"string\",\n131\t    required: false,\n132\t    description: 'The header mark: call sign and frequency, free text, 1 to 32 characters (\"WXYZ 90.1 FM\"). The sample station is invented.',\n133\t    meta: { control: { placeholder: DEFAULTS.station }, ui: { label: \"Station\", order: 2 } },\n134\t  },\n135\t  weekOf: {\n136\t    type: \"string\",\n137\t    required: false,\n138\t    description: \"The line under the station, free text (no date parsing), up to 48 characters. Empty removes it.\",\n139\t    meta: { control: { placeholder: DEFAULTS.weekOf }, ui: { label: \"Week of\", order: 3 } },\n140\t  },\n141\t  genre: {\n142\t    type: \"string\",\n143\t    required: false,\n144\t    description: 'A prefix for the chart title, up to 24 characters: \"Loud Rock\" with ten rows gives LOUD ROCK TOP 10. Empty gives TOP 30.',\n145\t    meta: { control: { placeholder: \"Loud Rock\" }, ui: { label: \"Genre\", order: 4 } },\n146\t  },\n147\t  footer: {\n148\t    type: \"string\",\n149\t    required: false,\n150\t    description: 'The bottom line, up to 90 characters: the station\\'s URL, \"As reported to NACC\". Empty removes the line.',\n151\t    meta: { control: { placeholder: DEFAULTS.footer }, ui: { label: \"Footer\", order: 5 } },\n152\t  },\n153\t  lead: {\n154\t    type: \"boolean\",\n155\t    required: false,\n156\t    description: \"Rank 1 leaves the grid and becomes a full-width lead row under the header; ranks 2 and up fill the grid.\",\n157\t    meta: { ui: { label: \"Lead row for #1\", order: 6 } },\n158\t  },\n159\t  accent: {\n160\t    type: \"string\",\n161\t    required: false,\n162\t    description: \"The rank numerals, the chart title, the header rule and the up / NEW / RE markers, as #rrggbb. On the light page a pale accent is darkened until it reads.\",\n163\t    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 7 } },\n164\t  },\n165\t  preset: {\n166\t    type: \"string\",\n167\t    required: false,\n168\t    description: 'Page and ink: \"dark\" (default) or \"light\".',\n169\t    meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 8 } },\n170\t  },\n171\t  debugLayout: {\n172\t    type: \"boolean\",\n173\t    required: false,\n174\t    description: \"Dev-only: check the layout contract (every text fits its box, the header and footer sit in their bands, every row has a cell and the cells are one size) and draw it over the card.\",\n175\t    meta: { ui: { label: \"Debug layout\", order: 99 } },\n176\t  },\n177\t});\n178\t\n179\t/* ── the chart: pure, exported, and what the test asserts ── */\n180\t\n181\tfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n182\t\n183\t/**\n184\t * Printable ASCII plus the accented Latin letters (Latin-1 and Latin\n185\t * Extended-A, U+00C0-U+017F without the two maths signs): the bundled font\n186\t * has a glyph for every one of them in both weights. Anything else is refused\n187\t * by name instead of rendering as tofu.\n188\t */\n189\tconst DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\n190\tfunction text(value: unknown, field: string, max: number): string {\n191\t  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n192\t  if (!DRAWN.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII and accented Latin letters (U+00C0-U+017F).`);\n193\t  const s = value.trim();\n194\t  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card takes at most ${max}.`);\n195\t  return s;\n196\t}\n197\t\n198\texport type RadioChartMove = \"up\" | \"down\" | \"same\" | \"new\" | \"re\";\n199\texport type RadioChartRow = {\n200\t  rank: number;\n201\t  artist: string;\n202\t  title: string;\n203\t  label: string;\n204\t  /** \"+3\", \"-2\", \"=\", \"NEW\", \"RE\"; \"\" when the line has no last-week field. */\n205\t  marker: string;\n206\t  move: RadioChartMove | null;\n207\t};\n208\t\n209\t/** One chart line, \"Artist | Title | Label\" or \"Artist | Title | Label | LW\", at list position `index` (rank index + 1). */\n210\texport function parseRadioChartRow(raw: unknown, index: number): RadioChartRow {\n211\t  const rank = index + 1;\n212\t  const at = `rows[${index}] (line ${rank})`;\n213\t  const line = text(raw, at, 240);\n214\t  const f = line.split(\"|\").map((s) => s.trim());\n215\t  if (f.length < 3 || f.length > 4) {\n216\t    fail(at, `${JSON.stringify(line)} has ${f.length} field${f.length === 1 ? \"\" : \"s\"} between \"|\"; write \"Artist | Title | Label\" or \"Artist | Title | Label | LW\" (a \"|\" inside a name cannot be written).`);\n217\t  }\n218\t  const [artist, title, label] = f;\n219\t  ([\"artist\", \"title\", \"label\"] as const).forEach((name, k) => {\n220\t    if (f[k] === \"\") fail(at, `has an empty ${name}; a chart row carries an artist, a title and a label.`);\n221\t    const max = name === \"label\" ? 40 : 80;\n222\t    if (f[k].length > max) fail(at, `${name} is ${f[k].length} characters; the card takes at most ${max}.`);\n223\t  });\n224\t  const lw = (f[3] ?? \"\").toUpperCase();\n225\t  let marker = \"\", move: RadioChartMove | null = null;\n226\t  if (lw === \"NEW\") { marker = \"NEW\"; move = \"new\"; }\n227\t  else if (lw === \"RE\") { marker = \"RE\"; move = \"re\"; }\n228\t  else if (lw !== \"\") {\n229\t    const n = /^\\d{1,3}$/.test(lw) ? Number(lw) : NaN;\n230\t    if (!(n >= 1 && n <= 200)) fail(at, `last week ${JSON.stringify(f[3])} must be a rank from 1 to 200, NEW, RE, or empty.`);\n231\t    const d = n - rank;\n232\t    marker = d > 0 ? `+${d}` : d < 0 ? `-${-d}` : \"=\";\n233\t    move = d > 0 ? \"up\" : d < 0 ? \"down\" : \"same\";\n234\t  }\n235\t  return { rank, artist, title, label, marker, move };\n236\t}\n237\t\n238\texport type RadioChart = ReturnType<typeof normalizeRadioChart>;\n239\t\n240\t/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n241\texport function normalizeRadioChart(props: RadioTop30ChartProps) {\n242\t  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n243\t  const station = text(p.station, \"station\", 32);\n244\t  if (station === \"\") fail(\"station\", \"is empty; the card is headed by the station (call sign and frequency).\");\n245\t  const weekOf = text(p.weekOf, \"weekOf\", 48);\n246\t  const genre = text(p.genre, \"genre\", 24);\n247\t  const footer = text(p.footer, \"footer\", 90);\n248\t  if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n249\t  if (typeof p.accent !== \"string\" || !/^#[0-9a-fA-F]{6}$/.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n250\t  if (typeof p.lead !== \"boolean\") fail(\"lead\", \"must be a boolean.\");\n251\t  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n252\t  if (!Array.isArray(p.rows)) fail(\"rows\", 'must be a list of chart lines (\"Artist | Title | Label\").');\n253\t  if (p.rows.length < 1) fail(\"rows\", \"is empty; a chart needs at least one line.\");\n254\t  if (p.rows.length > 30) fail(\"rows\", `has ${p.rows.length} lines; a station chart is 30, and a longer list needs a second card.`);\n255\t  const rows = p.rows.map((r, i) => parseRadioChartRow(r, i));\n256\t  return {\n257\t    station, weekOf, genre, footer, rows,\n258\t    /** Computed from the rows, never typed, so the title cannot contradict the list. */\n259\t    chartTitle: `${genre === \"\" ? \"\" : `${genre.toUpperCase()} `}TOP ${rows.length}`,\n260\t    hasMarkers: rows.some((r) => r.marker !== \"\"),\n261\t    accent: p.accent.trim().toLowerCase() as MosaicColor,\n262\t    preset: p.preset as \"dark\" | \"light\", lead: p.lead, debugLayout: p.debugLayout,\n263\t  };\n264\t}\n265\t\n266\t/* ── colour ── */\n267\t\n268\t// Not exported: the repo index is `export *`, and other templates export a `mix`.\n269\tfunction mix(a: string, b: string, t: number): MosaicColor {\n270\t  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n271\t  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n272\t  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n273\t}\n274\tfunction luminance(hex: string): number {\n275\t  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n276\t  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n277\t}\n278\tfunction contrast(a: string, b: string): number {\n279\t  const x = luminance(a), y = luminance(b);\n280\t  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);\n281\t}\n282\t/** The accent as INK on a row: itself when it reads there, otherwise pulled toward the page's ink until it does. */\n283\tfunction accentInk(accent: string, on: string, ink: string): MosaicColor {\n284\t  let t = 0;\n285\t  while (t < 0.6 && contrast(mix(accent, ink, t), on) < 3.6) t += 0.1;\n286\t  return mix(accent, ink, t);\n287\t}\n288\t\n289\t/* ── geometry ── */\n290\t\n291\t/** The shared sizes may come down by this much for the lines that can be caught; a line that needs more shrinks alone. */\n292\texport const RADIO_CHART_SHARED_FLOOR = 0.85;\n293\t/** A line alone goes no lower than this fraction of its cap; past it the render refuses. */\n294\texport const RADIO_CHART_ALONE_FLOOR = 0.5;\n295\t/** The lead row (`lead: true`) is this many grid rows tall. */\n296\tconst LEAD_ROWS = 1.7;\n297\t\n298\texport type RadioChartRect = { x: number; y: number; w: number; h: number };\n299\ttype Bind = \"station\" | \"weekOf\" | \"footer\" | \"genre\" | null;\n300\ttype Cell = { label: string; rect: RadioChartRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; row: number | null };\n301\ttype Tile = { label: string; rect: RadioChartRect; color: MosaicColor; accent?: boolean };\n302\texport type RadioChartRowLayout = {\n303\t  row: RadioChartRow;\n304\t  /** Its cell: `row-<i>` in the grid, `lead` for the lead row. */\n305\t  tile: RadioChartRect;\n306\t  lead: boolean;\n307\t  /** Grid column and position in it; -1 for the lead row. */\n308\t  column: number;\n309\t  slot: number;\n310\t  artistPx: number;\n311\t  titlePx: number;\n312\t  /** True when that line could not be caught by the shared size and shrank alone. */\n313\t  artistAlone: boolean;\n314\t  titleAlone: boolean;\n315\t};\n316\t\n317\t/** Sizes are 64ths of a pixel, not whole pixels: on a 480x270 thumbnail a whole pixel is a 20% step, and the fit has to stay proportional. */\n318\tconst STEP = 1 / 64;\n319\tconst q = (px: number) => Math.max(STEP, Math.floor(px / STEP) * STEP);\n320\t/** Width of one line per pixel of font size (the rasterizer's metrics are linear in the size). */\n321\tconst em = (line: string, bold = false) => widthOf(line, 100, bold) / 100;\n322\t/** The largest size up to `cap` at which one line fits the cell's budget (`cell * 0.94 - 2px`). */\n323\tfunction fitPx(line: string, cellW: number, cap: number, bold: boolean): number {\n324\t  const room = budget(cellW), e = em(line, bold);\n325\t  let px = q(e > 0 ? Math.min(cap, room / e) : cap);\n326\t  while (px > STEP && widthOf(line, px, bold) > room) px -= STEP;\n327\t  return px;\n328\t}\n329\t/** The narrowest cell whose budget fits `line` at `px`. */\n330\tconst cellFor = (line: string, px: number, bold = false) => Math.ceil((widthOf(line, px, bold) + 2) / 0.94) + 1;\n331\t/** A snug cell for text placed on an exact rect: the measured width with the 2% the contract's ruler asks for, and a pixel. */\n332\tconst snug = (line: string, px: number, bold = false) => Math.ceil(widthOf(line, px, bold) * 1.02) + 1;\n333\t\n334\t/** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\n335\texport function layoutRadioChart(props: RadioTop30ChartProps, W: number, H: number) {\n336\t  const p = normalizeRadioChart(props);\n337\t  const theme = THEMES[p.preset];\n338\t  const ink = theme.ink as MosaicColor, dim = theme.dim as MosaicColor;\n339\t  const accent = accentInk(p.accent, theme.row, theme.ink);\n340\t  const S = Math.min(W, H);\n341\t  // 16:9 and wider: up to 10 rows a column. Square and portrait: up to 15.\n342\t  const wide = W * 10 >= H * 13;\n343\t  const m = Math.round(S * 0.04), CW = W - 2 * m;\n344\t  const cells: Cell[] = [];\n345\t  const tiles: Tile[] = [];\n346\t  const unfit = (what: string, how: string): never => fail(what, `cannot be fitted on ${W}x${H}: ${how}`);\n347\t  const put = (label: string, rect: RadioChartRect, value: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; row?: number } = {}) => {\n348\t    cells.push({ label, rect, text: value, px, width: widthOf(value, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? ink, bind: o.bind ?? null, row: o.row ?? null });\n349\t  };\n350\t\n351\t  // ── header: the station (the largest text on the card) and the chart title on one line, the week under the station ──\n352\t  const hb = Math.round(H * 0.095);\n353\t  const stationH = Math.round(hb * 0.64), weekH = hb - stationH;\n354\t  const stationCap = Math.min(stationH * 0.76, CW * 0.075);\n355\t  const headGap = Math.round(S * 0.03);\n356\t  // The station and the chart title share the line: both come down together until they fit side by side.\n357\t  let hk = Math.min(1, (budget(CW) - headGap) / ((em(p.station, true) + 0.8 * em(p.chartTitle, true)) * stationCap));\n358\t  let stationPx = 0, chartPx = 0, chartW = 0, stationW = 0;\n359\t  for (;; hk -= 0.01) {\n360\t    if (hk < 0.45) unfit(\"station and the chart title\", `shorten the station${p.genre === \"\" ? \"\" : \" or the genre\"}.`);\n361\t    stationPx = q(stationCap * hk); chartPx = q(stationPx * 0.8);\n362\t    chartW = cellFor(p.chartTitle, chartPx, true); stationW = CW - chartW - headGap;\n363\t    if (stationW > 0 && widthOf(p.station, stationPx, true) <= budget(stationW)) break;\n364\t  }\n365\t  // With no week line the station and the title take the middle of the band.\n366\t  const headY = p.weekOf === \"\" ? m + Math.round((hb - stationH) / 2) : m;\n367\t  put(\"station\", { x: m, y: headY, w: stationW, h: stationH }, p.station, stationPx, { bold: true, bind: \"station\" });\n368\t  put(\"chart-title\", { x: m + CW - chartW, y: headY, w: chartW, h: stationH }, p.chartTitle, chartPx, { bold: true, align: \"right\", color: accent, bind: p.genre === \"\" ? null : \"genre\" });\n369\t  if (p.weekOf !== \"\") {\n370\t    const cap = Math.min(weekH * 0.62, S * 0.024), px = fitPx(p.weekOf, CW, cap, false);\n371\t    if (px < cap * RADIO_CHART_ALONE_FLOOR) unfit(\"weekOf\", \"shorten it.\");\n372\t    put(\"week-of\", { x: m, y: m + stationH, w: CW, h: weekH }, p.weekOf, px, { color: dim, bind: \"weekOf\" });\n373\t  }\n374\t  const ruleH = Math.max(2, Math.round(S * 0.004));\n375\t  const ruleY = m + hb + Math.round(S * 0.012);\n376\t  tiles.push({ label: \"header-rule\", rect: { x: m, y: ruleY, w: CW, h: ruleH }, color: p.accent, accent: true });\n377\t\n378\t  // ── footer: one dim line ──\n379\t  const footH = Math.round(H * 0.035), footY = H - Math.round(S * 0.03) - footH;\n380\t  if (p.footer !== \"\") {\n381\t    const cap = Math.min(footH * 0.5, S * 0.019), px = fitPx(p.footer, CW, cap, false);\n382\t    if (px < cap * RADIO_CHART_ALONE_FLOOR) unfit(\"footer\", \"shorten it.\");\n383\t    put(\"footer\", { x: m, y: footY, w: CW, h: footH }, p.footer, px, { color: dim, bind: \"footer\" });\n384\t  }\n385\t\n386\t  // ── the grid: columns = ceil(n / cap), rows per column = ceil(n / columns); every row cell one size ──\n387\t  const bandTop = ruleY + ruleH + Math.round(S * 0.014), bandBottom = footY - Math.round(S * 0.008);\n388\t  const hasLead = p.lead && p.rows.length > 1;\n389\t  const gridRows = hasLead ? p.rows.slice(1) : p.rows;\n390\t  const n = gridRows.length;\n391\t  const columns = Math.ceil(n / (wide ? 10 : 15));\n392\t  const perColumn = Math.ceil(n / columns);\n393\t  const hair = Math.max(1, Math.round(S * 0.002));\n394\t  // A Top 5 does not become slabs: the pitch is capped and the rows group at the top of the band.\n395\t  const pitch = Math.max(2, Math.min(Math.round(S * 0.11), Math.floor((bandBottom - bandTop) / (perColumn + (hasLead ? LEAD_ROWS : 0)))));\n396\t  const leadH = hasLead ? Math.round(pitch * LEAD_ROWS) : 0;\n397\t  const gutter = Math.round(S * 0.025);\n398\t  const colW = Math.floor((CW - (columns - 1) * gutter) / columns);\n399\t  const gridTop = bandTop + leadH;\n400\t\n401\t  /** One row class (the grid rows, or the lead row): where the rank, the two lines and their caps sit in a cell. */\n402\t  const geometry = (cellW: number, cellH: number) => {\n403\t    const artistCap = Math.min(cellH * 0.41, cellW * 0.045), titleCap = artistCap * 0.76;\n404\t    const rankPx = q(artistCap), markPx = q(titleCap * 0.86);\n405\t    // Fixed for the card: wide enough for \"30\" and for \"NEW\".\n406\t    const rankW = Math.max(cellFor(\"30\", rankPx, true), p.hasMarkers ? cellFor(\"NEW\", markPx, true) : 0);\n407\t    const padL = Math.round(cellW * 0.014), gapR = Math.round(cellW * 0.02), padR = Math.round(cellW * 0.02);\n408\t    const textX = padL + rankW + gapR, textW = cellW - textX - padR;\n409\t    const artistH = Math.min(cellH - 1, Math.round(artistCap * 1.22)), titleH = Math.max(1, Math.min(cellH - artistH, Math.round(titleCap * 1.28)));\n410\t    return { artistCap, titleCap, rankPx, markPx, rankW, padL, textX, textW, artistH, titleH, top: Math.floor((cellH - artistH - titleH) / 2), labelGap: Math.round(titleCap * 0.7) };\n411\t  };\n412\t  type Geometry = ReturnType<typeof geometry>;\n413\t\n414\t  const artistFits = (r: RadioChartRow, g: Geometry, px: number) => widthOf(r.artist, px, true) <= budget(g.textW);\n415\t  // Where the label starts on line 2: the title's snug cell, then what is left of the gap once the\n416\t  // cell's own slack is taken off, so the ink-to-ink gap is the same on every row.\n417\t  const labelX = (r: RadioChartRow, g: Geometry, px: number) => {\n418\t    const cell = snug(r.title, px);\n419\t    return cell + Math.max(2, g.labelGap - (cell - Math.ceil(widthOf(r.title, px))));\n420\t  };\n421\t  // The title, a fixed gap, the label: the line fits when the ink fits the budget and the two cells fit the column.\n422\t  const titleFits = (r: RadioChartRow, g: Geometry, px: number) =>\n423\t    widthOf(r.title, px) + g.labelGap + widthOf(r.label, px) <= budget(g.textW) && labelX(r, g, px) + snug(r.label, px) <= g.textW;\n424\t  /** How far below its cap a line has to go to fit: 1 = fits at the cap. */\n425\t  const artistNeed = (r: RadioChartRow, g: Geometry) => Math.min(1, budget(g.textW) / (em(r.artist, true) * g.artistCap));\n426\t  const titleNeed = (r: RadioChartRow, g: Geometry) => Math.min(1, (budget(g.textW) - g.labelGap) / ((em(r.title) + em(r.label)) * g.titleCap));\n427\t  /** A line on its own: the largest size from `from` down that fits; refuses below the floor. */\n428\t  const alone = (r: RadioChartRow, field: \"artist\" | \"title\", cap: number, from: number, fits: (px: number) => boolean) => {\n429\t    let px = q(from);\n430\t    while (px > STEP && !fits(px)) px -= STEP;\n431\t    if (px < cap * RADIO_CHART_ALONE_FLOOR || !fits(px)) {\n432\t      unfit(`row ${r.rank} ${field}`, field === \"title\" ? `shorten it (${r.title.length} characters next to a ${r.label.length}-character label).` : `shorten it (${r.artist.length} characters).`);\n433\t    }\n434\t    return px;\n435\t  };\n436\t\n437\t  /** Draw one row in its cell at the sizes the ladder gave it. */\n438\t  const draw = (i: number, r: RadioChartRow, tile: RadioChartRect, g: Geometry, artistPx: number, titlePx: number) => {\n439\t    const y1 = tile.y + g.top, y2 = y1 + g.artistH;\n440\t    const rankRect = p.hasMarkers ? { x: tile.x + g.padL, y: y1, w: g.rankW, h: g.artistH } : { x: tile.x + g.padL, y: tile.y, w: g.rankW, h: tile.h };\n441\t    put(`rank-${i}`, rankRect, String(r.rank), fitPx(String(r.rank), g.rankW, g.rankPx, true), { bold: true, align: \"center\", color: accent });\n442\t    if (r.marker !== \"\") {\n443\t      const up = r.move === \"up\" || r.move === \"new\" || r.move === \"re\";\n444\t      put(`marker-${i}`, { x: tile.x + g.padL, y: y2, w: g.rankW, h: g.titleH }, r.marker, fitPx(r.marker, g.rankW, g.markPx, true), { bold: true, align: \"center\", color: up ? accent : dim });\n445\t    }\n446\t    const x = tile.x + g.textX;\n447\t    put(`artist-${i}`, { x, y: y1, w: g.textW, h: g.artistH }, r.artist, artistPx, { bold: true, row: i });\n448\t    const lx = labelX(r, g, titlePx);\n449\t    put(`title-${i}`, { x, y: y2, w: snug(r.title, titlePx), h: g.titleH }, r.title, titlePx, { row: i });\n450\t    put(`label-${i}`, { x: x + lx, y: y2, w: g.textW - lx, h: g.titleH }, r.label, titlePx, { color: dim, row: i });\n451\t  };\n452\t\n453\t  const rows: RadioChartRowLayout[] = [];\n454\t  if (hasLead) {\n455\t    // The lead row is one row at a larger scale, across the full width; its two lines are fitted on their own.\n456\t    const r = p.rows[0], tile: RadioChartRect = { x: m, y: bandTop, w: CW, h: leadH - hair };\n457\t    const g = geometry(tile.w, tile.h);\n458\t    const artistPx = alone(r, \"artist\", g.artistCap, g.artistCap, (px) => artistFits(r, g, px));\n459\t    const titlePx = alone(r, \"title\", g.titleCap, g.titleCap, (px) => titleFits(r, g, px));\n460\t    tiles.push({ label: \"lead\", rect: tile, color: theme.row as MosaicColor });\n461\t    draw(0, r, tile, g, artistPx, titlePx);\n462\t    rows.push({ row: r, tile, lead: true, column: -1, slot: -1, artistPx, titlePx, artistAlone: artistPx < q(g.artistCap), titleAlone: titlePx < q(g.titleCap) });\n463\t  }\n464\t\n465\t  const g = geometry(colW, pitch - hair);\n466\t  // The ladder. Step 1: the shared sizes follow the neediest line that is still inside the allowance.\n467\t  const needs = gridRows.flatMap((r) => [artistNeed(r, g), titleNeed(r, g)]);\n468\t  const shared = Math.min(1, ...needs.filter((k) => k >= RADIO_CHART_SHARED_FLOOR));\n469\t  const artistShared = q(g.artistCap * shared), titleShared = q(g.titleCap * shared);\n470\t  gridRows.forEach((r, j) => {\n471\t    const i = hasLead ? j + 1 : j;\n472\t    const column = Math.floor(j / perColumn), slot = j % perColumn;\n473\t    const tile: RadioChartRect = { x: m + column * (colW + gutter), y: gridTop + slot * pitch, w: colW, h: pitch - hair };\n474\t    // Step 2: a line the shared size cannot catch shrinks alone. Step 3 (inside `alone`): past the floor, refuse.\n475\t    const artistAlone = !artistFits(r, g, artistShared), titleAlone = !titleFits(r, g, titleShared);\n476\t    const artistPx = artistAlone ? alone(r, \"artist\", g.artistCap, Math.min(artistShared, g.artistCap * artistNeed(r, g)), (px) => artistFits(r, g, px)) : artistShared;\n477\t    const titlePx = titleAlone ? alone(r, \"title\", g.titleCap, Math.min(titleShared, g.titleCap * titleNeed(r, g)), (px) => titleFits(r, g, px)) : titleShared;\n478\t    tiles.push({ label: `row-${i}`, rect: tile, color: theme.row as MosaicColor });\n479\t    draw(i, r, tile, g, artistPx, titlePx);\n480\t    rows.push({ row: r, tile, lead: false, column, slot, artistPx, titlePx, artistAlone, titleAlone });\n481\t  });\n482\t\n483\t  return { p, theme, wide, cells, tiles, rows, m, columns, perColumn, pitch, colW, gutter, bandTop, bandBottom, gridTop, shared, artistShared, titleShared, artistCap: g.artistCap, titleCap: g.titleCap, rankW: g.rankW };\n484\t}\n485\t\n486\t/**\n487\t * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n488\t * convention, src/_shared/why.ts): the run, the problem with the sources the\n489\t * agent opened, the solution, how to use it, then the template itself.\n490\t */\n491\tconst WHY: WhySpec = {\n492\t  \"day\": 16,\n493\t  \"date\": \"2026-10-05\",\n494\t  \"agent\": \"claude\",\n495\t  \"model\": \"claude-fable-5.1\",\n496\t  \"id\": \"@one-a-day/music/radio-top-30-chart/v1\",\n497\t  \"title\": \"Radio Top 30 Chart\",\n498\t  \"who\": \"Music directors at college and community radio stations, who chart a Top 30 to NACC every Tuesday and post it on the station blog and socials\",\n499\t  \"problem\": [\n500\t    \"Every week a station ranks its 30 most-played new releases and reports them to NACC. WUVT: \\\"they want us to chart our Top 30 on the NACC radio chart every week.\\\" WUSC: the music director \\\"puts it together by looking back at our playlist log to determine the top 30 plays\\\".\",\n501\t    \"Then the same chart is published by hand. KWVA retypes it as a list (\\\"1. CLAIRO Album: Charm Label: Virgin\\\"); WUSC posts \\\"Top 30 chart day\\\". One station of the four opened, WDCE, posts it as a picture: \\\"Here's the WDCE Top 30 from 29 July 2026 (click the image to see a larger version)\\\".\",\n502\t    \"So the evidence for a hand-made picture is one station; the other three show the weekly chore, not a wish for a graphic. The strings are unbounded: \\\"Brat And It's Completely Different But Also Still Brat\\\" is a real row on KWVA's page.\"\n503\t  ],\n504\t  \"sources\": [\n505\t    \"https://create.richmond.edu/parsons/tag/slippers/\",\n506\t    \"https://kwva.uoregon.edu/charts?page=4\",\n507\t    \"https://www.wusc.fm/article/2021/08/top-30-chart-08-24-21\",\n508\t    \"https://www.wusc.fm/article/2021/11/our-weekly-top-30-chart-11-02-21\",\n509\t    \"https://wuvt.vt.edu/article/music-article\",\n510\t    \"https://naccchart.com/reporting-guidelines\",\n511\t    \"https://naccchart.com/faq\",\n512\t    \"https://en.wikipedia.org/wiki/North_American_College_and_Community_Radio_Chart\",\n513\t    \"https://spinitron.com/\"\n514\t  ],\n515\t  \"solution\": [\n516\t    \"Paste the chart as lines, \\\"Artist | Title | Label | last week\\\", and get the week's card: the station, a TOP 30 counted from the rows, and every row as rank, bold artist, then title with its label in dimmer ink. 3 x 10 on a wide canvas, 2 x 15 on a square or a story. The default chart is invented.\",\n517\t    \"The one decision: the fit rule. All rows share one artist size and one title size; the shared sizes give up at most 15% for a long line, a line that needs more shrinks alone to no less than half, and past that the render refuses and names the row. Nothing is cut off and nothing gets an ellipsis.\"\n518\t  ],\n519\t  \"usage\": {\n520\t    \"command\": \"m0saic make @one-a-day/music/radio-top-30-chart/v1 --template-repo . -w 1080 -h 1080 -o journal/2026-10-05/radio-top-30-chart.png\",\n521\t    \"try\": [\n522\t      \"rows: 1-30 lines \\\"Artist | Title | Label | 4\\\"; the 4th field is last week's rank, NEW, RE, or left out\",\n523\t      \"genre \\\"Loud Rock\\\" with ten rows: the title becomes LOUD ROCK TOP 10 and the grid one column\",\n524\t      \"lead true: rank 1 becomes a full-width row above the grid; preset \\\"light\\\" for the studio door\",\n525\t      \"-w 1920 -h 1080 for a blog header (3 x 10), -w 1080 -h 1920 for a story (2 x 15)\"\n526\t    ]\n527\t  },\n528\t  \"timeline\": {\n529\t    \"source\": \"runner\",\n530\t    \"phases\": [\n531\t      {\n532\t        \"name\": \"scout\",\n533\t        \"startMs\": 0,\n534\t        \"durMs\": 236783,\n535\t        \"calls\": 27,\n536\t        \"tokens\": 2571704,\n537\t        \"costUsd\": 3.37,\n538\t        \"tools\": \"WebSearch 11, Bash 7, Edit 3\"\n539\t      },\n540\t      {\n541\t        \"name\": \"plan\",\n542\t        \"startMs\": 236798,\n543\t        \"durMs\": 334008,\n544\t        \"calls\": 15,\n545\t        \"tokens\": 1848161,\n546\t        \"costUsd\": 3.2,\n547\t        \"tools\": \"Bash 13, Edit 1, Write 1\"\n548\t      }\n549\t    ],\n550\t    \"costBasis\": \"reported\"\n551\t  },\n552\t  \"caveats\": [\n553\t    \"It does not read a NACC or Spinitron export: you type or paste the lines (\\\"1. CLAIRO Album: Charm Label: Virgin\\\" becomes \\\"Clairo | Charm | Virgin\\\"). A name with a \\\"|\\\" in it cannot be written.\",\n554\t    \"Thirty rows on a 1080 square are small type: the artist line is about 21 px and the title about 16 px. There is no pixel floor, so a 480x270 render is a thumbnail, not a readable chart.\",\n555\t    \"No cover art, no adds list, no paging. Last-week values are printed as given: two rows may both claim last week's 4.\"\n556\t  ]\n557\t};\n558\t\n559\texport const RadioTop30ChartV1 = defineMosaicTemplate<RadioTop30ChartProps>({\n560\t  id: asTemplateId(ID),\n561\t  label: \"2026-10-05 · Radio Top 30 Chart\",\n562\t  version: 1,\n563\t  description: \"A radio station's weekly chart card from pasted lines (Artist | Title | Label | last week): the station, a computed TOP 30, the week, and thirty equal two-line rows with rank and movement markers, 3 x 10 on a wide canvas and 2 x 15 on a square or story; long titles shrink by rule or are refused, never clipped.\",\n564\t  capabilities: { tier: \"core\" },\n565\t  tags: [\"music\",\"2026-10-05\",\"day-016\",\"radio\",\"college-radio\",\"chart\",\"top-30\",\"nacc\"],\n566\t\n567\t  outputHints: {\n568\t    width: 1080,\n569\t    height: 1080,\n570\t    fps: 30,\n571\t    durationMs: 2000,\n572\t    format: { kind: \"image\", container: \"png\" },\n573\t    note: \"Still PNG. 16:9 and wider: up to 10 rows a column (3 x 10 for a Top 30). Square and portrait: up to 15 (2 x 15). Type is sized for 1080 on the short side; smaller canvases are thumbnails.\",\n574\t  },\n575\t\n576\t  propsSchema,\n577\t  defaultProps: DEFAULTS,\n578\t\n579\t  render,\n580\t  renderTutorial: whyTutorial(WHY, render),\n581\t});\n582\t\n583\texport default RadioTop30ChartV1;\n584\t\n585\tasync function render(props: RadioTop30ChartProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n586\t  const { width: W, height: H } = ctx.target;\n587\t  const L = layoutRadioChart(props, W, H);\n588\t  const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n589\t  const constraints: LayoutConstraint[] = [];\n590\t\n591\t  // Tiles first, then text: placeInsetPieces puts a rect on the first overlay\n592\t  // layer it does not collide with, so the row cells share one layer and the\n593\t  // copy another.\n594\t  for (const t of L.tiles) {\n595\t    const tile = tag({ ...makeColorTile(t.color) } as MosaicSource, t.label);\n596\t    // `accent` paints the header rule, so that is the rect that shows it.\n597\t    pieces.push({ rect: { ...t.rect, importance: 1 }, source: t.accent ? bindProp(tile, \"accent\") : tile });\n598\t  }\n599\t  for (const c of L.cells) {\n600\t    const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n601\t    // A text rect is BOUND to the prop it shows; a row's artist, title and label are bound to its line in `rows`.\n602\t    pieces.push({ rect: { ...c.rect, importance: 2 }, source: c.row !== null ? bindPropPath(cell, \"rows\", [c.row], \"string\") : c.bind === null ? cell : bindProp(cell, c.bind) });\n603\t    constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n604\t  }\n605\t\n606\t  // What the geometry promises, against the labels: every text fits its box\n607\t  // (above); the station and the chart title live in the top fifth and the\n608\t  // footer in the bottom tenth; the header rule spans the card; every row\n609\t  // given has its cell (and its rank, artist and title, as the text\n610\t  // constraints above), each cell at least a quarter of the canvas wide and\n611\t  // inside the chart band, and all of them one size.\n612\t  constraints.push({ label: \"station\", within: { yFrac: [0, 0.2] } });\n613\t  constraints.push({ label: \"chart-title\", within: { yFrac: [0, 0.2] } });\n614\t  if (L.p.footer !== \"\") constraints.push({ label: \"footer\", within: { yFrac: [0.9, 1] } });\n615\t  constraints.push({ label: \"header-rule\", minWidthFrac: 0.9 });\n616\t  const grid = L.rows.filter((r) => !r.lead).map((r) => `row-${r.row.rank - 1}`);\n617\t  grid.forEach((label) => constraints.push({ label, within: { yFrac: [0.08, 0.97] }, minWidthFrac: 0.25 }));\n618\t  if (L.rows.some((r) => r.lead)) constraints.push({ label: \"lead\", within: { yFrac: [0.08, 0.5] }, minWidthFrac: 0.9 });\n619\t  const relations: RelationalConstraint[] = grid.length > 1 ? [{ label: grid, equal: \"size\", tolerancePx: 2 }] : [];\n620\t\n621\t  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n622\t  const doc: MosaicDocument = {\n623\t    kind: \"mosaic_document\",\n624\t    version: 1,\n625\t    m0: toM0String(placed.m0, ID),\n626\t    assets: {},\n627\t    backgroundColor: L.theme.bg as MosaicColor,\n628\t    sources: placed.sources,\n629\t  };\n630\t  return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: props.debugLayout === true });\n631\t}\n632\t"}]},"parent_tool_use_id":null,"session_id":"eae8af87-6e99-41a8-b936-a6bfa1083b92","uuid":"aed03c7e-fe58-4e08-b962-20cfba7f5410","timestamp":"2026-10-05T13:45:43.961Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\music\\radio-top-30-chart\\v1\\radio-top-30-chart.ts","content":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, bindPropPath, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/music/radio-top-30-chart/v1` - a radio station's weekly chart\n * as one card: the station, a computed `TOP 30`, the week, and every row as\n * rank / artist / title / label, from the lines a music director already\n * types (`Artist | Title | Label | last week`).\n *\n * ONE CONCEPT: the fit rule is the template. A row is two lines (the artist,\n * bold; then the title with the label after it in dimmer ink), every row cell\n * is the same size, and thirty rows share one artist size and one title size\n * so the columns read as columns. Long copy goes down a ladder, in this\n * order:\n *   1. the shared sizes come down together, by at most 15%, for every line\n *      that can be fitted inside that allowance;\n *   2. a line that needs more shrinks ALONE, to no less than half its cap,\n *      and costs the other rows nothing;\n *   3. past that the render refuses, naming the row and the canvas. No\n *      ellipsis, no clipping, no dropped label.\n * The grid follows the aspect: up to 10 rows a column on a wide canvas\n * (3 x 10), up to 15 on a square or portrait one (2 x 15); ranks read down a\n * column, then the next.\n *\n * The rule that bites: nothing here is typed twice. The rank is the position\n * in the list, the count in the title is the number of rows, and the marker\n * under a rank is last week's rank minus this week's (`+3`, `-2`, `=`, `NEW`,\n * `RE`), as text: the bundled font has no arrows, and up is the accent, down\n * is dim ink, never red or green. Sizes are fractions of the canvas with no\n * pixel floor, so a 480x270 render is a thumbnail of the 1920x1080 one, not a\n * different card.\n */\n\nexport type RadioTop30ChartProps = {\n  /** The header mark: call sign and frequency, free text. */\n  station?: string;\n  /** The line under the station. \"\" removes it. */\n  weekOf?: string;\n  /** Prefix of the chart title: \"Loud Rock\" gives LOUD ROCK TOP 10. \"\" gives TOP 30. */\n  genre?: string;\n  /** The chart, in rank order: 1-30 lines of \"Artist | Title | Label\" or \"Artist | Title | Label | LW\". */\n  rows?: string[];\n  /** The bottom line: a URL, a credit. \"\" removes the line. */\n  footer?: string;\n  /** Rank numerals, the chart title, up / NEW / RE markers, as #rrggbb. */\n  accent?: string;\n  /** Page and ink. */\n  preset?: \"dark\" | \"light\";\n  /** Rank 1 as a full-width lead row above the grid. */\n  lead?: boolean;\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/music/radio-top-30-chart/v1\";\nconst DEFAULT_ACCENT = \"#ff3d9a\";\nconst THEMES = {\n  dark: { bg: \"#131117\", row: \"#1e1b25\", ink: \"#f4f2f6\", dim: \"#a09bab\" },\n  light: { bg: \"#f1eee7\", row: \"#fffdf9\", ink: \"#18151c\", dim: \"#6b6674\" },\n} as const;\n\n// An invented station and an invented chart. 91.6 is an even-tenth frequency,\n// which is not a US FM channel, so the default cannot be mistaken for a real\n// station's chart. Row 7's title is 53 characters on purpose: it is the row\n// that shows what the fit ladder does.\nconst DEFAULT_ROWS = [\n  \"Paper Lanterns | Night Bus Home | Tidewater | 2\",\n  \"Glass Orchard | Slow Weather | Half Moon Recordings | 1\",\n  \"The Marigolds | Kitchen Radio | Fern & Flint | 5\",\n  \"Delta Kiosk | Parking Lot Hymns | Low Tide | 4\",\n  'Nora Vance | \"Blue Receipt\" [Single] | Self-Released | NEW',\n  \"Static Bloom | Greenhouse | Tidewater | 3\",\n  \"Hollow Pines | A Field Guide to Leaving Early Without Saying Goodbye | Brass Key | 12\",\n  \"Juno Park | Soft Machines [EP] | Night Shift | 6\",\n  \"Cardigan Sea | Postcards | Half Moon Recordings | 9\",\n  \"Vera & the Lowlights | Last Call | Brass Key | 15\",\n  \"Mothwing | Porchlight | Fern & Flint | 8\",\n  \"Tall Grass Choir | Everything Is Fine Here | Low Tide | NEW\",\n  \"Okapi | Signal Hill | Night Shift | 7\",\n  \"Rosa Calloway | Late Bloomer | Tidewater | 10\",\n  \"Sunday Arcade | High Score [EP] | Self-Released | 22\",\n  \"The Understudies | Second String | Brass Key | 11\",\n  \"Pilot Light | Embers | Low Tide | 13\",\n  \"Ferris | Midway | Half Moon Recordings | RE\",\n  \"Lakehouse Tapes | Volume Two | Self-Released | 14\",\n  'Anya Brook | \"Cold Coffee\" [Single] | Fern & Flint | NEW',\n  \"Quiet Motors | Idle | Night Shift | 16\",\n  \"Marble Run | Gravity Songs | Tidewater | 19\",\n  \"The Night Clerks | Room 12 | Brass Key | 17\",\n  \"Wren Abbott | Small Hours | Low Tide | 27\",\n  \"Copper Wire | Loose Ends | Half Moon Recordings | 18\",\n  \"Day Camp | Bug Juice | Self-Released | 20\",\n  \"Sister Static | AM Gold | Night Shift | 30\",\n  \"Halloway | Winter Coat | Fern & Flint | 21\",\n  \"Plum Street | Corner Store | Tidewater | NEW\",\n  \"The Long Weekend | Monday | Brass Key | 24\",\n];\n\nconst DEFAULTS = {\n  station: \"KOAD 91.6 FM\",\n  weekOf: \"Week of Oct 6, 2026\",\n  genre: \"\",\n  rows: DEFAULT_ROWS,\n  footer: \"Sample chart: artists, titles and labels are invented\",\n  accent: DEFAULT_ACCENT,\n  preset: \"dark\" as \"dark\" | \"light\",\n  lead: false,\n  debugLayout: false,\n};\n\nconst propsSchema = definePropsSchema<RadioTop30ChartProps>({\n  rows: {\n    type: \"json\",\n    required: false,\n    description:\n      'The chart in rank order, 1 to 30 lines, each \"Artist | Title | Label\" or \"Artist | Title | Label | LW\". LW is last week\\'s rank (1-200), NEW, RE, or empty for no marker on that row. The rank is the position in the list and the count sets the title (TOP 30, TOP 10); the card does not sort or re-rank. NACC conventions such as \"Title\" [Single] and Title [EP] pass through as typed.',\n    meta: {\n      constraints: { jsonSchema: { type: \"array\", minItems: 1, maxItems: 30, items: { type: \"string\" } } },\n      ui: { label: \"Chart rows\", order: 1, primary: true },\n    },\n  },\n  station: {\n    type: \"string\",\n    required: false,\n    description: 'The header mark: call sign and frequency, free text, 1 to 32 characters (\"WXYZ 90.1 FM\"). The sample station is invented.',\n    meta: { control: { placeholder: DEFAULTS.station }, ui: { label: \"Station\", order: 2 } },\n  },\n  weekOf: {\n    type: \"string\",\n    required: false,\n    description: \"The line under the station, free text (no date parsing), up to 48 characters. Empty removes it.\",\n    meta: { control: { placeholder: DEFAULTS.weekOf }, ui: { label: \"Week of\", order: 3 } },\n  },\n  genre: {\n    type: \"string\",\n    required: false,\n    description: 'A prefix for the chart title, up to 24 characters: \"Loud Rock\" with ten rows gives LOUD ROCK TOP 10. Empty gives TOP 30.',\n    meta: { control: { placeholder: \"Loud Rock\" }, ui: { label: \"Genre\", order: 4 } },\n  },\n  footer: {\n    type: \"string\",\n    required: false,\n    description: 'The bottom line, up to 90 characters: the station\\'s URL, \"As reported to NACC\". Empty removes the line.',\n    meta: { control: { placeholder: DEFAULTS.footer }, ui: { label: \"Footer\", order: 5 } },\n  },\n  lead: {\n    type: \"boolean\",\n    required: false,\n    description: \"Rank 1 leaves the grid and becomes a full-width lead row under the header; ranks 2 and up fill the grid.\",\n    meta: { ui: { label: \"Lead row for #1\", order: 6 } },\n  },\n  accent: {\n    type: \"string\",\n    required: false,\n    description: \"The rank numerals, the chart title, the header rule and the up / NEW / RE markers, as #rrggbb. On the light page a pale accent is darkened until it reads.\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 7 } },\n  },\n  preset: {\n    type: \"string\",\n    required: false,\n    description: 'Page and ink: \"dark\" (default) or \"light\".',\n    meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 8 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits its box, the header and footer sit in their bands, every row has a cell and the cells are one size) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n/* ── the chart: pure, exported, and what the test asserts ── */\n\nfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n\n/**\n * Printable ASCII plus the accented Latin letters (Latin-1 and Latin\n * Extended-A, U+00C0-U+017F without the two maths signs): the bundled font\n * has a glyph for every one of them in both weights. Anything else is refused\n * by name instead of rendering as tofu.\n */\nconst DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\nfunction text(value: unknown, field: string, max: number): string {\n  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n  if (!DRAWN.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII and accented Latin letters (U+00C0-U+017F).`);\n  const s = value.trim();\n  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card takes at most ${max}.`);\n  return s;\n}\n\nexport type RadioChartMove = \"up\" | \"down\" | \"same\" | \"new\" | \"re\";\nexport type RadioChartRow = {\n  rank: number;\n  artist: string;\n  title: string;\n  label: string;\n  /** \"+3\", \"-2\", \"=\", \"NEW\", \"RE\"; \"\" when the line has no last-week field. */\n  marker: string;\n  move: RadioChartMove | null;\n};\n\n/** One chart line, \"Artist | Title | Label\" or \"Artist | Title | Label | LW\", at list position `index` (rank index + 1). */\nexport function parseRadioChartRow(raw: unknown, index: number): RadioChartRow {\n  const rank = index + 1;\n  const at = `rows[${index}] (line ${rank})`;\n  const line = text(raw, at, 240);\n  const f = line.split(\"|\").map((s) => s.trim());\n  if (f.length < 3 || f.length > 4) {\n    fail(at, `${JSON.stringify(line)} has ${f.length} field${f.length === 1 ? \"\" : \"s\"} between \"|\"; write \"Artist | Title | Label\" or \"Artist | Title | Label | LW\" (a \"|\" inside a name cannot be written).`);\n  }\n  const [artist, title, label] = f;\n  ([\"artist\", \"title\", \"label\"] as const).forEach((name, k) => {\n    if (f[k] === \"\") fail(at, `has an empty ${name}; a chart row carries an artist, a title and a label.`);\n    const max = name === \"label\" ? 40 : 80;\n    if (f[k].length > max) fail(at, `${name} is ${f[k].length} characters; the card takes at most ${max}.`);\n  });\n  const lw = (f[3] ?? \"\").toUpperCase();\n  let marker = \"\", move: RadioChartMove | null = null;\n  if (lw === \"NEW\") { marker = \"NEW\"; move = \"new\"; }\n  else if (lw === \"RE\") { marker = \"RE\"; move = \"re\"; }\n  else if (lw !== \"\") {\n    const n = /^\\d{1,3}$/.test(lw) ? Number(lw) : NaN;\n    if (!(n >= 1 && n <= 200)) fail(at, `last week ${JSON.stringify(f[3])} must be a rank from 1 to 200, NEW, RE, or empty.`);\n    const d = n - rank;\n    marker = d > 0 ? `+${d}` : d < 0 ? `-${-d}` : \"=\";\n    move = d > 0 ? \"up\" : d < 0 ? \"down\" : \"same\";\n  }\n  return { rank, artist, title, label, marker, move };\n}\n\nexport type RadioChart = ReturnType<typeof normalizeRadioChart>;\n\n/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\nexport function normalizeRadioChart(props: RadioTop30ChartProps) {\n  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n  const station = text(p.station, \"station\", 32);\n  if (station === \"\") fail(\"station\", \"is empty; the card is headed by the station (call sign and frequency).\");\n  const weekOf = text(p.weekOf, \"weekOf\", 48);\n  const genre = text(p.genre, \"genre\", 24);\n  const footer = text(p.footer, \"footer\", 90);\n  if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n  if (typeof p.accent !== \"string\" || !/^#[0-9a-fA-F]{6}$/.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n  if (typeof p.lead !== \"boolean\") fail(\"lead\", \"must be a boolean.\");\n  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n  if (!Array.isArray(p.rows)) fail(\"rows\", 'must be a list of chart lines (\"Artist | Title | Label\").');\n  if (p.rows.length < 1) fail(\"rows\", \"is empty; a chart needs at least one line.\");\n  if (p.rows.length > 30) fail(\"rows\", `has ${p.rows.length} lines; a station chart is 30, and a longer list needs a second card.`);\n  const rows = p.rows.map((r, i) => parseRadioChartRow(r, i));\n  return {\n    station, weekOf, genre, footer, rows,\n    /** Computed from the rows, never typed, so the title cannot contradict the list. */\n    chartTitle: `${genre === \"\" ? \"\" : `${genre.toUpperCase()} `}TOP ${rows.length}`,\n    hasMarkers: rows.some((r) => r.marker !== \"\"),\n    accent: p.accent.trim().toLowerCase() as MosaicColor,\n    preset: p.preset as \"dark\" | \"light\", lead: p.lead, debugLayout: p.debugLayout,\n  };\n}\n\n/* ── colour ── */\n\n// Not exported: the repo index is `export *`, and other templates export a `mix`.\nfunction mix(a: string, b: string, t: number): MosaicColor {\n  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n}\nfunction luminance(hex: string): number {\n  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n}\nfunction contrast(a: string, b: string): number {\n  const x = luminance(a), y = luminance(b);\n  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);\n}\n/** The accent as INK on a row: itself when it reads there, otherwise pulled toward the page's ink until it does. */\nfunction accentInk(accent: string, on: string, ink: string): MosaicColor {\n  let t = 0;\n  while (t < 0.6 && contrast(mix(accent, ink, t), on) < 3.6) t += 0.1;\n  return mix(accent, ink, t);\n}\n\n/* ── geometry ── */\n\n/** The shared sizes may come down by this much for the lines that can be caught; a line that needs more shrinks alone. */\nexport const RADIO_CHART_SHARED_FLOOR = 0.85;\n/** A line alone goes no lower than this fraction of its cap; past it the render refuses. */\nexport const RADIO_CHART_ALONE_FLOOR = 0.5;\n/** The lead row (`lead: true`) is this many grid rows tall. */\nconst LEAD_ROWS = 1.7;\n\nexport type RadioChartRect = { x: number; y: number; w: number; h: number };\ntype Bind = \"station\" | \"weekOf\" | \"footer\" | \"genre\" | null;\ntype Cell = { label: string; rect: RadioChartRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; row: number | null };\ntype Tile = { label: string; rect: RadioChartRect; color: MosaicColor; accent?: boolean };\nexport type RadioChartRowLayout = {\n  row: RadioChartRow;\n  /** Its cell: `row-<i>` in the grid, `lead` for the lead row. */\n  tile: RadioChartRect;\n  lead: boolean;\n  /** Grid column and position in it; -1 for the lead row. */\n  column: number;\n  slot: number;\n  artistPx: number;\n  titlePx: number;\n  /** True when that line could not be caught by the shared size and shrank alone. */\n  artistAlone: boolean;\n  titleAlone: boolean;\n};\n\n/** Sizes are 64ths of a pixel, not whole pixels: on a 480x270 thumbnail a whole pixel is a 20% step, and the fit has to stay proportional. */\nconst STEP = 1 / 64;\nconst q = (px: number) => Math.max(STEP, Math.floor(px / STEP) * STEP);\n/** Width of one line per pixel of font size (the rasterizer's metrics are linear in the size). */\nconst em = (line: string, bold = false) => widthOf(line, 100, bold) / 100;\n/** The largest size up to `cap` at which one line fits the cell's budget (`cell * 0.94 - 2px`). */\nfunction fitPx(line: string, cellW: number, cap: number, bold: boolean): number {\n  const room = budget(cellW), e = em(line, bold);\n  let px = q(e > 0 ? Math.min(cap, room / e) : cap);\n  while (px > STEP && widthOf(line, px, bold) > room) px -= STEP;\n  return px;\n}\n/** The narrowest cell whose budget fits `line` at `px`. */\nconst cellFor = (line: string, px: number, bold = false) => Math.ceil((widthOf(line, px, bold) + 2) / 0.94) + 1;\n/** A snug cell for text placed on an exact rect: the measured width with the 2% the contract's ruler asks for, and a pixel. */\nconst snug = (line: string, px: number, bold = false) => Math.ceil(widthOf(line, px, bold) * 1.02) + 1;\n\n/** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\nexport function layoutRadioChart(props: RadioTop30ChartProps, W: number, H: number) {\n  const p = normalizeRadioChart(props);\n  const theme = THEMES[p.preset];\n  const ink = theme.ink as MosaicColor, dim = theme.dim as MosaicColor;\n  const accent = accentInk(p.accent, theme.row, theme.ink);\n  const S = Math.min(W, H);\n  // 16:9 and wider: up to 10 rows a column. Square and portrait: up to 15.\n  const wide = W * 10 >= H * 13;\n  const m = Math.round(S * 0.04), CW = W - 2 * m;\n  const cells: Cell[] = [];\n  const tiles: Tile[] = [];\n  const unfit = (what: string, how: string): never => fail(what, `cannot be fitted on ${W}x${H}: ${how}`);\n  const put = (label: string, rect: RadioChartRect, value: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; row?: number } = {}) => {\n    cells.push({ label, rect, text: value, px, width: widthOf(value, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? ink, bind: o.bind ?? null, row: o.row ?? null });\n  };\n\n  // ── header: the station (the largest text on the card) and the chart title on one line, the week under the station ──\n  const hb = Math.round(H * 0.095);\n  const stationH = Math.round(hb * 0.64), weekH = hb - stationH;\n  const stationCap = Math.min(stationH * 0.76, CW * 0.075);\n  const headGap = Math.round(S * 0.03);\n  // The station and the chart title share the line: both come down together until they fit side by side.\n  let hk = Math.min(1, (budget(CW) - headGap) / ((em(p.station, true) + 0.8 * em(p.chartTitle, true)) * stationCap));\n  let stationPx = 0, chartPx = 0, chartW = 0, stationW = 0;\n  for (;; hk -= 0.01) {\n    if (hk < 0.45) unfit(\"station and the chart title\", `shorten the station${p.genre === \"\" ? \"\" : \" or the genre\"}.`);\n    stationPx = q(stationCap * hk); chartPx = q(stationPx * 0.8);\n    chartW = cellFor(p.chartTitle, chartPx, true); stationW = CW - chartW - headGap;\n    if (stationW > 0 && widthOf(p.station, stationPx, true) <= budget(stationW)) break;\n  }\n  // With no week line the station and the title take the middle of the band.\n  const headY = p.weekOf === \"\" ? m + Math.round((hb - stationH) / 2) : m;\n  put(\"station\", { x: m, y: headY, w: stationW, h: stationH }, p.station, stationPx, { bold: true, bind: \"station\" });\n  put(\"chart-title\", { x: m + CW - chartW, y: headY, w: chartW, h: stationH }, p.chartTitle, chartPx, { bold: true, align: \"right\", color: accent, bind: p.genre === \"\" ? null : \"genre\" });\n  if (p.weekOf !== \"\") {\n    const cap = Math.min(weekH * 0.62, S * 0.024), px = fitPx(p.weekOf, CW, cap, false);\n    if (px < cap * RADIO_CHART_ALONE_FLOOR) unfit(\"weekOf\", \"shorten it.\");\n    put(\"week-of\", { x: m, y: m + stationH, w: CW, h: weekH }, p.weekOf, px, { color: dim, bind: \"weekOf\" });\n  }\n  const ruleH = Math.max(2, Math.round(S * 0.004));\n  const ruleY = m + hb + Math.round(S * 0.012);\n  tiles.push({ label: \"header-rule\", rect: { x: m, y: ruleY, w: CW, h: ruleH }, color: p.accent, accent: true });\n\n  // ── footer: one dim line ──\n  const footH = Math.round(H * 0.035), footY = H - Math.round(S * 0.03) - footH;\n  if (p.footer !== \"\") {\n    const cap = Math.min(footH * 0.5, S * 0.019), px = fitPx(p.footer, CW, cap, false);\n    if (px < cap * RADIO_CHART_ALONE_FLOOR) unfit(\"footer\", \"shorten it.\");\n    put(\"footer\", { x: m, y: footY, w: CW, h: footH }, p.footer, px, { color: dim, bind: \"footer\" });\n  }\n\n  // ── the grid: columns = ceil(n / cap), rows per column = ceil(n / columns); every row cell one size ──\n  const bandTop = ruleY + ruleH + Math.round(S * 0.014), bandBottom = footY - Math.round(S * 0.008);\n  const hasLead = p.lead && p.rows.length > 1;\n  const gridRows = hasLead ? p.rows.slice(1) : p.rows;\n  const n = gridRows.length;\n  const columns = Math.ceil(n / (wide ? 10 : 15));\n  const perColumn = Math.ceil(n / columns);\n  const hair = Math.max(1, Math.round(S * 0.002));\n  // A Top 5 does not become slabs: the pitch is capped and the rows group at the top of the band.\n  const pitch = Math.max(2, Math.min(Math.round(S * 0.11), Math.floor((bandBottom - bandTop) / (perColumn + (hasLead ? LEAD_ROWS : 0)))));\n  const leadH = hasLead ? Math.round(pitch * LEAD_ROWS) : 0;\n  const gutter = Math.round(S * 0.025);\n  const colW = Math.floor((CW - (columns - 1) * gutter) / columns);\n  const gridTop = bandTop + leadH;\n\n  /** One row class (the grid rows, or the lead row): where the rank, the two lines and their caps sit in a cell. */\n  const geometry = (cellW: number, cellH: number) => {\n    const artistCap = Math.min(cellH * 0.41, cellW * 0.045), titleCap = artistCap * 0.76;\n    const rankPx = q(artistCap), markPx = q(titleCap * 0.86);\n    // Fixed for the card: wide enough for \"30\" and for \"NEW\".\n    const rankW = Math.max(cellFor(\"30\", rankPx, true), p.hasMarkers ? cellFor(\"NEW\", markPx, true) : 0);\n    const padL = Math.round(cellW * 0.014), gapR = Math.round(cellW * 0.02), padR = Math.round(cellW * 0.02);\n    const textX = padL + rankW + gapR, textW = cellW - textX - padR;\n    const artistH = Math.min(cellH - 1, Math.round(artistCap * 1.22)), titleH = Math.max(1, Math.min(cellH - artistH, Math.round(titleCap * 1.28)));\n    return { artistCap, titleCap, rankPx, markPx, rankW, padL, textX, textW, artistH, titleH, top: Math.floor((cellH - artistH - titleH) / 2), labelGap: Math.round(titleCap * 0.7) };\n  };\n  type Geometry = ReturnType<typeof geometry>;\n\n  const artistFits = (r: RadioChartRow, g: Geometry, px: number) => widthOf(r.artist, px, true) <= budget(g.textW);\n  // Where the label starts on line 2: the title's snug cell, then what is left of the gap once the\n  // cell's own slack is taken off, so the ink-to-ink gap is the same on every row.\n  const labelX = (r: RadioChartRow, g: Geometry, px: number) => {\n    const cell = snug(r.title, px);\n    return cell + Math.max(2, g.labelGap - (cell - Math.ceil(widthOf(r.title, px))));\n  };\n  // The title, a fixed gap, the label: the line fits when the ink fits the budget and the two cells fit the column.\n  const titleFits = (r: RadioChartRow, g: Geometry, px: number) =>\n    widthOf(r.title, px) + g.labelGap + widthOf(r.label, px) <= budget(g.textW) && labelX(r, g, px) + snug(r.label, px) <= g.textW;\n  /** How far below its cap a line has to go to fit: 1 = fits at the cap. */\n  const artistNeed = (r: RadioChartRow, g: Geometry) => Math.min(1, budget(g.textW) / (em(r.artist, true) * g.artistCap));\n  const titleNeed = (r: RadioChartRow, g: Geometry) => Math.min(1, (budget(g.textW) - g.labelGap) / ((em(r.title) + em(r.label)) * g.titleCap));\n  /** A line on its own: the largest size from `from` down that fits; refuses below the floor. */\n  const alone = (r: RadioChartRow, field: \"artist\" | \"title\", cap: number, from: number, fits: (px: number) => boolean) => {\n    let px = q(from);\n    while (px > STEP && !fits(px)) px -= STEP;\n    if (px < cap * RADIO_CHART_ALONE_FLOOR || !fits(px)) {\n      unfit(`row ${r.rank} ${field}`, field === \"title\" ? `shorten it (${r.title.length} characters next to a ${r.label.length}-character label).` : `shorten it (${r.artist.length} characters).`);\n    }\n    return px;\n  };\n\n  /** Draw one row in its cell at the sizes the ladder gave it. */\n  const draw = (i: number, r: RadioChartRow, tile: RadioChartRect, g: Geometry, artistPx: number, titlePx: number) => {\n    const y1 = tile.y + g.top, y2 = y1 + g.artistH;\n    const rankRect = p.hasMarkers ? { x: tile.x + g.padL, y: y1, w: g.rankW, h: g.artistH } : { x: tile.x + g.padL, y: tile.y, w: g.rankW, h: tile.h };\n    put(`rank-${i}`, rankRect, String(r.rank), fitPx(String(r.rank), g.rankW, g.rankPx, true), { bold: true, align: \"center\", color: accent });\n    if (r.marker !== \"\") {\n      const up = r.move === \"up\" || r.move === \"new\" || r.move === \"re\";\n      put(`marker-${i}`, { x: tile.x + g.padL, y: y2, w: g.rankW, h: g.titleH }, r.marker, fitPx(r.marker, g.rankW, g.markPx, true), { bold: true, align: \"center\", color: up ? accent : dim });\n    }\n    const x = tile.x + g.textX;\n    put(`artist-${i}`, { x, y: y1, w: g.textW, h: g.artistH }, r.artist, artistPx, { bold: true, row: i });\n    const lx = labelX(r, g, titlePx);\n    put(`title-${i}`, { x, y: y2, w: snug(r.title, titlePx), h: g.titleH }, r.title, titlePx, { row: i });\n    put(`label-${i}`, { x: x + lx, y: y2, w: g.textW - lx, h: g.titleH }, r.label, titlePx, { color: dim, row: i });\n  };\n\n  const rows: RadioChartRowLayout[] = [];\n  if (hasLead) {\n    // The lead row is one row at a larger scale, across the full width; its two lines are fitted on their own.\n    const r = p.rows[0], tile: RadioChartRect = { x: m, y: bandTop, w: CW, h: leadH - hair };\n    const g = geometry(tile.w, tile.h);\n    const artistPx = alone(r, \"artist\", g.artistCap, g.artistCap, (px) => artistFits(r, g, px));\n    const titlePx = alone(r, \"title\", g.titleCap, g.titleCap, (px) => titleFits(r, g, px));\n    tiles.push({ label: \"lead\", rect: tile, color: theme.row as MosaicColor });\n    draw(0, r, tile, g, artistPx, titlePx);\n    rows.push({ row: r, tile, lead: true, column: -1, slot: -1, artistPx, titlePx, artistAlone: artistPx < q(g.artistCap), titleAlone: titlePx < q(g.titleCap) });\n  }\n\n  const g = geometry(colW, pitch - hair);\n  // The ladder. Step 1: the shared sizes follow the neediest line that is still inside the allowance.\n  const needs = gridRows.flatMap((r) => [artistNeed(r, g), titleNeed(r, g)]);\n  const shared = Math.min(1, ...needs.filter((k) => k >= RADIO_CHART_SHARED_FLOOR));\n  const artistShared = q(g.artistCap * shared), titleShared = q(g.titleCap * shared);\n  gridRows.forEach((r, j) => {\n    const i = hasLead ? j + 1 : j;\n    const column = Math.floor(j / perColumn), slot = j % perColumn;\n    const tile: RadioChartRect = { x: m + column * (colW + gutter), y: gridTop + slot * pitch, w: colW, h: pitch - hair };\n    // Step 2: a line the shared size cannot catch shrinks alone. Step 3 (inside `alone`): past the floor, refuse.\n    const artistAlone = !artistFits(r, g, artistShared), titleAlone = !titleFits(r, g, titleShared);\n    const artistPx = artistAlone ? alone(r, \"artist\", g.artistCap, Math.min(artistShared, g.artistCap * artistNeed(r, g)), (px) => artistFits(r, g, px)) : artistShared;\n    const titlePx = titleAlone ? alone(r, \"title\", g.titleCap, Math.min(titleShared, g.titleCap * titleNeed(r, g)), (px) => titleFits(r, g, px)) : titleShared;\n    tiles.push({ label: `row-${i}`, rect: tile, color: theme.row as MosaicColor });\n    draw(i, r, tile, g, artistPx, titlePx);\n    rows.push({ row: r, tile, lead: false, column, slot, artistPx, titlePx, artistAlone, titleAlone });\n  });\n\n  return { p, theme, wide, cells, tiles, rows, m, columns, perColumn, pitch, colW, gutter, bandTop, bandBottom, gridTop, shared, artistShared, titleShared, artistCap: g.artistCap, titleCap: g.titleCap, rankW: g.rankW };\n}\n\n/**\n * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n * convention, src/_shared/why.ts): the run, the problem with the sources the\n * agent opened, the solution, how to use it, then the template itself.\n */\nconst WHY: WhySpec = {\n  \"day\": 16,\n  \"date\": \"2026-10-05\",\n  \"agent\": \"claude\",\n  \"model\": \"claude-fable-5.1\",\n  \"id\": \"@one-a-day/music/radio-top-30-chart/v1\",\n  \"title\": \"Radio Top 30 Chart\",\n  \"who\": \"Music directors at college and community radio stations, who chart a Top 30 to NACC every Tuesday and post it on the station blog and socials\",\n  \"problem\": [\n    \"Every week a station ranks its 30 most-played new releases and reports them to NACC. WUVT: \\\"they want us to chart our Top 30 on the NACC radio chart every week.\\\" WUSC: the music director \\\"puts it together by looking back at our playlist log to determine the top 30 plays\\\".\",\n    \"Then the same chart is published by hand. KWVA retypes it as a list (\\\"1. CLAIRO Album: Charm Label: Virgin\\\"); WUSC posts \\\"Top 30 chart day\\\". One station of the four opened, WDCE, posts it as a picture: \\\"Here's the WDCE Top 30 from 29 July 2026 (click the image to see a larger version)\\\".\",\n    \"So the evidence for a hand-made picture is one station; the other three show the weekly chore, not a wish for a graphic. The strings are unbounded: \\\"Brat And It's Completely Different But Also Still Brat\\\" is a real row on KWVA's page.\"\n  ],\n  \"sources\": [\n    \"https://create.richmond.edu/parsons/tag/slippers/\",\n    \"https://kwva.uoregon.edu/charts?page=4\",\n    \"https://www.wusc.fm/article/2021/08/top-30-chart-08-24-21\",\n    \"https://www.wusc.fm/article/2021/11/our-weekly-top-30-chart-11-02-21\",\n    \"https://wuvt.vt.edu/article/music-article\",\n    \"https://naccchart.com/reporting-guidelines\",\n    \"https://naccchart.com/faq\",\n    \"https://en.wikipedia.org/wiki/North_American_College_and_Community_Radio_Chart\",\n    \"https://spinitron.com/\"\n  ],\n  \"solution\": [\n    \"Paste the chart as lines, \\\"Artist | Title | Label | last week\\\", and get the week's card: the station, a TOP 30 counted from the rows, and every row as rank, bold artist, then title with its label in dimmer ink. 3 x 10 on a wide canvas, 2 x 15 on a square or a story. The default chart is invented.\",\n    \"The one decision: the fit rule. All rows share one artist size and one title size; the shared sizes give up at most 15% for a long line, a line that needs more shrinks alone to no less than half, and past that the render refuses and names the row. Nothing is cut off and nothing gets an ellipsis.\"\n  ],\n  \"usage\": {\n    \"command\": \"m0saic make @one-a-day/music/radio-top-30-chart/v1 --template-repo . -w 1080 -h 1080 -o journal/2026-10-05/radio-top-30-chart.png\",\n    \"try\": [\n      \"rows: 1-30 lines \\\"Artist | Title | Label | 4\\\"; the 4th field is last week's rank, NEW, RE, or left out\",\n      \"genre \\\"Loud Rock\\\" with ten rows: the title becomes LOUD ROCK TOP 10 and the grid one column\",\n      \"lead true: rank 1 becomes a full-width row above the grid; preset \\\"light\\\" for the studio door\",\n      \"-w 1920 -h 1080 for a blog header (3 x 10), -w 1080 -h 1920 for a story (2 x 15)\"\n    ]\n  },\n  \"timeline\": {\n    \"source\": \"runner\",\n    \"phases\": [\n      {\n        \"name\": \"scout\",\n        \"startMs\": 0,\n        \"durMs\": 236783,\n        \"calls\": 27,\n        \"tokens\": 2571704,\n        \"costUsd\": 3.37,\n        \"tools\": \"WebSearch 11, Bash 7, Edit 3\"\n      },\n      {\n        \"name\": \"plan\",\n        \"startMs\": 236798,\n        \"durMs\": 334008,\n        \"calls\": 15,\n        \"tokens\": 1848161,\n        \"costUsd\": 3.2,\n        \"tools\": \"Bash 13, Edit 1, Write 1\"\n      }\n    ],\n    \"costBasis\": \"reported\"\n  },\n  \"caveats\": [\n    \"It does not read a NACC or Spinitron export: you type or paste the lines (\\\"1. CLAIRO Album: Charm Label: Virgin\\\" becomes \\\"Clairo | Charm | Virgin\\\"). A name with a \\\"|\\\" in it cannot be written.\",\n    \"Thirty rows on a 1080 square are small type: the artist line is about 21 px and the title about 16 px. There is no pixel floor, so a 480x270 render is a thumbnail, not a readable chart.\",\n    \"No cover art, no adds list, no paging. Last-week values are printed as given: two rows may both claim last week's 4.\"\n  ]\n};\n\nexport const RadioTop30ChartV1 = defineMosaicTemplate<RadioTop30ChartProps>({\n  id: asTemplateId(ID),\n  label: \"2026-10-05 · Radio Top 30 Chart\",\n  version: 1,\n  description: \"A radio station's weekly chart card from pasted lines (Artist | Title | Label | last week): the station, a computed TOP 30, the week, and thirty equal two-line rows with rank and movement markers, 3 x 10 on a wide canvas and 2 x 15 on a square or story; long titles shrink by rule or are refused, never clipped.\",\n  capabilities: { tier: \"core\" },\n  tags: [\"music\",\"2026-10-05\",\"day-016\",\"radio\",\"college-radio\",\"chart\",\"top-30\",\"nacc\"],\n\n  outputHints: {\n    width: 1080,\n    height: 1080,\n    fps: 30,\n    durationMs: 2000,\n    format: { kind: \"image\", container: \"png\" },\n    note: \"Still PNG. 16:9 and wider: up to 10 rows a column (3 x 10 for a Top 30). Square and portrait: up to 15 (2 x 15). Type is sized for 1080 on the short side; smaller canvases are thumbnails.\",\n  },\n\n  propsSchema,\n  defaultProps: DEFAULTS,\n\n  render,\n  renderTutorial: whyTutorial(WHY, render),\n});\n\nexport default RadioTop30ChartV1;\n\nasync function render(props: RadioTop30ChartProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n  const { width: W, height: H } = ctx.target;\n  const L = layoutRadioChart(props, W, H);\n  const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n  const constraints: LayoutConstraint[] = [];\n\n  // Tiles first, then text: placeInsetPieces puts a rect on the first overlay\n  // layer it does not collide with, so the row cells share one layer and the\n  // copy another.\n  for (const t of L.tiles) {\n    const tile = tag({ ...makeColorTile(t.color) } as MosaicSource, t.label);\n    // `accent` paints the header rule, so that is the rect that shows it.\n    pieces.push({ rect: { ...t.rect, importance: 1 }, source: t.accent ? bindProp(tile, \"accent\") : tile });\n  }\n  for (const c of L.cells) {\n    const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n    // A text rect is BOUND to the prop it shows; a row's artist, title and label are bound to its line in `rows`.\n    pieces.push({ rect: { ...c.rect, importance: 2 }, source: c.row !== null ? bindPropPath(cell, \"rows\", [c.row], \"string\") : c.bind === null ? cell : bindProp(cell, c.bind) });\n    constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n  }\n\n  // What the geometry promises, against the labels: every text fits its box\n  // (above); the station and the chart title live in the top fifth and the\n  // footer in the bottom tenth; the header rule spans the card; every row\n  // given has its cell (and its rank, artist and title, as the text\n  // constraints above), each cell at least a quarter of the canvas wide and\n  // inside the chart band, and all of them one size.\n  constraints.push({ label: \"station\", within: { yFrac: [0, 0.2] } });\n  constraints.push({ label: \"chart-title\", within: { yFrac: [0, 0.2] } });\n  if (L.p.footer !== \"\") constraints.push({ label: \"footer\", within: { yFrac: [0.9, 1] } });\n  constraints.push({ label: \"header-rule\", minWidthFrac: 0.9 });\n  const grid = L.rows.filter((r) => !r.lead).map((r) => `row-${r.row.rank - 1}`);\n  grid.forEach((label) => constraints.push({ label, within: { yFrac: [0.08, 0.97] }, minWidthFrac: 0.25 }));\n  if (L.rows.some((r) => r.lead)) constraints.push({ label: \"lead\", within: { yFrac: [0.08, 0.5] }, minWidthFrac: 0.9 });\n  const relations: RelationalConstraint[] = grid.length > 1 ? [{ label: grid, equal: \"size\", tolerancePx: 2 }] : [];\n\n  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n  const doc: MosaicDocument = {\n    kind: \"mosaic_document\",\n    version: 1,\n    m0: toM0String(placed.m0, ID),\n    assets: {},\n    backgroundColor: L.theme.bg as MosaicColor,\n    sources: placed.sources,\n  };\n  return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: props.debugLayout === true });\n}\n","numLines":632,"startLine":1,"totalLines":632}}}
