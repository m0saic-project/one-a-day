{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EszPRMrBLU7y5t199a4q4i","type":"tool_result","content":"1\timport type {\n2\t  MosaicColor,\n3\t  MosaicDocument,\n4\t  MosaicEngineContext,\n5\t  MosaicSource,\n6\t} from \"@m0saic/types\";\n7\timport { asTemplateId } from \"@m0saic/types\";\n8\timport { toM0String } from \"@m0saic/dsl-stdlib\";\n9\timport {\n10\t  bindProp,\n11\t  defineMosaicTemplate,\n12\t  definePropsSchema,\n13\t  placeInsetPieces,\n14\t  svgLabel,\n15\t  tag,\n16\t} from \"@m0saic/template-utils\";\n17\timport type { LayoutConstraint } from \"@m0saic/template-utils\";\n18\timport { TEXT_EM, textFitsAll, withLayoutIntent } from \"../../../_shared/layout\";\n19\timport { whyTutorial } from \"../../../_shared/why\";\n20\timport type { WhySpec } from \"../../../_shared/why\";\n21\t\n22\t/**\n23\t * `@one-a-day/sports/chess-game-recap/v1` — shareable game recap card for chess.\n24\t *\n25\t * ONE CONCEPT: render opening name, result (colored icon + label), time control,\n26\t * and rating change as a professional recap card that shares better than a screenshot.\n27\t *\n28\t * The rule that bites: chess-specific UI conventions (result colors: green/red/gray)\n29\t * and tight text fitting across seven canvases from 640×360 to 3840×2160.\n30\t */\n31\t\n32\texport type ChessGameRecapProps = {\n33\t  /** The chess opening name displayed in the header. */\n34\t  opening?: string;\n35\t  /** The game result: win, loss, or draw. */\n36\t  result?: \"win\" | \"loss\" | \"draw\";\n37\t  /** The rating delta displayed (e.g., +32, -18, 0). */\n38\t  ratingChange?: number;\n39\t  /** The time control format (e.g., \"10+5\", \"5+3\", \"1+0\"). */\n40\t  timeControl?: string;\n41\t  /** The game date in ISO format (YYYY-MM-DD). */\n42\t  date?: string;\n43\t  /** The opponent or player name displayed in the footer. */\n44\t  opponentName?: string;\n45\t  /** Dev-only: check the layout contract and draw it over the card. */\n46\t  debugLayout?: boolean;\n47\t};\n48\t\n49\tconst ID = \"@one-a-day/sports/chess-game-recap/v1\";\n50\tconst INK = \"#eaeef2\" as MosaicColor;\n51\tconst DIM = \"#9aa7b4\" as MosaicColor;\n52\tconst PAGE = \"#1c2833\" as MosaicColor;\n53\tconst WIN_COLOR = \"#2caf45\" as MosaicColor;\n54\tconst LOSS_COLOR = \"#d84849\" as MosaicColor;\n55\tconst DRAW_COLOR = \"#8b92a1\" as MosaicColor;\n56\tconst DEFAULT_OPENING = \"King's Indian Defense\";\n57\tconst DEFAULT_RESULT = \"win\" as const;\n58\tconst DEFAULT_RATING = 25;\n59\tconst DEFAULT_TIME = \"10+5\";\n60\tconst DEFAULT_DATE = \"2026-10-07\";\n61\tconst DEFAULT_OPPONENT = \"Opponent\";\n62\t\n63\tconst propsSchema = definePropsSchema<ChessGameRecapProps>({\n64\t  opening: {\n65\t    type: \"string\",\n66\t    required: false,\n67\t    description: \"The chess opening name.\",\n68\t    meta: { control: { placeholder: DEFAULT_OPENING }, ui: { label: \"Opening\", order: 1 } },\n69\t  },\n70\t  result: {\n71\t    type: \"string\",\n72\t    required: false,\n73\t    description: \"Game result: win, loss, or draw.\",\n74\t    meta: { ui: { label: \"Result\", order: 2 } },\n75\t  },\n76\t  ratingChange: {\n77\t    type: \"number\",\n78\t    required: false,\n79\t    description: \"Rating delta.\",\n80\t    meta: { ui: { label: \"Rating Change\", order: 3 } },\n81\t  },\n82\t  timeControl: {\n83\t    type: \"string\",\n84\t    required: false,\n85\t    description: \"Time control format (e.g., 10+5, 5+3).\",\n86\t    meta: { control: { placeholder: DEFAULT_TIME }, ui: { label: \"Time Control\", order: 4 } },\n87\t  },\n88\t  date: {\n89\t    type: \"string\",\n90\t    required: false,\n91\t    description: \"Game date in YYYY-MM-DD format.\",\n92\t    meta: { control: { placeholder: DEFAULT_DATE }, ui: { label: \"Date\", order: 5 } },\n93\t  },\n94\t  opponentName: {\n95\t    type: \"string\",\n96\t    required: false,\n97\t    description: \"Opponent name.\",\n98\t    meta: { control: { placeholder: DEFAULT_OPPONENT }, ui: { label: \"Opponent\", order: 6 } },\n99\t  },\n100\t  debugLayout: {\n101\t    type: \"boolean\",\n102\t    required: false,\n103\t    description: \"Dev-only: check the layout contract and draw it over the card.\",\n104\t    meta: { ui: { label: \"Debug layout\", order: 99 } },\n105\t  },\n106\t});\n107\t\n108\t/**\n109\t * What the geometry promises: opening name fits the header (top 18%), result\n110\t * and stats fit their columns, footer text fits the bottom band (22%).\n111\t */\n112\tfunction layoutContract(): LayoutConstraint[] {\n113\t  return [\n114\t    ...textFitsAll([\"opening\", \"result\", \"time\", \"rating\", \"date\", \"opponent\"], { charWidthEm: TEXT_EM.prose }),\n115\t    { label: \"opening\", within: { yFrac: [0, 0.18] }, minWidthFrac: 0.85 },\n116\t    { label: \"result\", within: { yFrac: [0.18, 0.78] } },\n117\t    { label: \"time\", within: { yFrac: [0.18, 0.78] } },\n118\t    { label: \"rating\", within: { yFrac: [0.18, 0.78] } },\n119\t    { label: \"date\", within: { yFrac: [0.78, 1] } },\n120\t    { label: \"opponent\", within: { yFrac: [0.78, 1] } },\n121\t  ];\n122\t}\n123\t\n124\t/**\n125\t * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n126\t * convention, src/_shared/why.ts): the run, the problem with the sources the\n127\t * agent opened, the solution, how to use it, then the template itself.\n128\t * Pre-filled from journal/2026-10-07/ - replace every \"[fill me]\" and say it\n129\t * in the evidence's own words. The build refuses a placeholder.\n130\t */\n131\tconst WHY: WhySpec = {\n132\t  \"day\": 18,\n133\t  \"date\": \"2026-10-07\",\n134\t  \"agent\": \"claude\",\n135\t  \"model\": \"claude-haiku-4-5-20251001\",\n136\t  \"id\": \"@one-a-day/sports/chess-game-recap/v1\",\n137\t  \"title\": \"Chess Game Recap\",\n138\t  \"who\": \"Chess players on Lichess and Chess.com, streamers analyzing games, and players sharing rating milestones in online communities.\",\n139\t  \"problem\": [\n140\t    \"Players screenshot their games to share online, but screenshots scale poorly across devices and lose metadata when resized. Streamers need clean, shareable recap cards that render vector-sharp at any size without quality loss.\"\n141\t  ],\n142\t  \"sources\": [\n143\t    \"https://github.com/philphilphil/blunderbase\",\n144\t    \"https://github.com/brumar/chess-postmortem-skills\",\n145\t    \"https://news.ycombinator.com/item?id=49857528\",\n146\t    \"https://lichess.org\"\n147\t  ],\n148\t  \"solution\": [\n149\t    \"A chess recap card rendering opening name, result with color-coded label, time control, rating delta, date and opponent in a clean layout. SVG rendering ensures vector-sharp scaling across all devices. Works from PGN metadata with sensible defaults.\"\n150\t  ],\n151\t  \"usage\": {\n152\t    \"command\": \"m0saic make @one-a-day/sports/chess-game-recap/v1 --template-repo . -w 1280 -h 720 -o out.png\",\n153\t    \"try\": [\n154\t      \"opening='Sicilian Defense' result='loss' ratingChange='-12'\",\n155\t      \"opening='Berlin Defense' result='draw' timeControl='classical'\",\n156\t      \"opponentName='Magnus Carlsen' result='win' ratingChange='+89'\"\n157\t    ]\n158\t  },\n159\t  \"timeline\": {\n160\t    \"source\": \"runner\",\n161\t    \"phases\": [\n162\t      {\n163\t        \"name\": \"scout\",\n164\t        \"startMs\": 0,\n165\t        \"durMs\": 220183,\n166\t        \"calls\": 105,\n167\t        \"tokens\": 9009637,\n168\t        \"costUsd\": 0.47,\n169\t        \"tools\": \"Bash 95, Read 7, Write 2\"\n170\t      },\n171\t      {\n172\t        \"name\": \"plan\",\n173\t        \"startMs\": 220200,\n174\t        \"durMs\": 60866,\n175\t        \"calls\": 8,\n176\t        \"tokens\": 615291,\n177\t        \"costUsd\": 0.09,\n178\t        \"tools\": \"Read 6, Edit 1, Write 1\"\n179\t      }\n180\t    ],\n181\t    \"costBasis\": \"reported\"\n182\t  }\n183\t};\n184\t\n185\texport const ChessGameRecapV1 = defineMosaicTemplate<ChessGameRecapProps>({\n186\t  id: asTemplateId(ID),\n187\t  label: \"2026-10-07 · Chess Game Recap\",\n188\t  version: 1,\n189\t  description: \"Chess game recap card: opening, result, time control, and rating change rendered as a shareable card that scales beautifully across all devices.\",\n190\t  capabilities: { tier: \"core\" },\n191\t  tags: [\"sports\",\"2026-10-07\",\"day-018\",\"chess\",\"pgn\",\"lichess\",\"game-analysis\",\"rating-progression\"],\n192\t\n193\t  outputHints: {\n194\t    width: 1280,\n195\t    height: 720,\n196\t    fps: 30,\n197\t    durationMs: 2000,\n198\t    format: { kind: \"image\", container: \"png\" },\n199\t    note: \"Static card - any canvas and any duration render cleanly.\",\n200\t  },\n201\t\n202\t  propsSchema,\n203\t  defaultProps: {\n204\t    opening: DEFAULT_OPENING,\n205\t    result: DEFAULT_RESULT,\n206\t    ratingChange: DEFAULT_RATING,\n207\t    timeControl: DEFAULT_TIME,\n208\t    date: DEFAULT_DATE,\n209\t    opponentName: DEFAULT_OPPONENT,\n210\t    debugLayout: false,\n211\t  },\n212\t\n213\t  render,\n214\t  renderTutorial: whyTutorial(WHY, render),\n215\t});\n216\t\n217\texport default ChessGameRecapV1;\n218\t\n219\tasync function render(\n220\t  props: ChessGameRecapProps,\n221\t  ctx: MosaicEngineContext,\n222\t): Promise<MosaicDocument> {\n223\t    const opening = props.opening ?? DEFAULT_OPENING;\n224\t    const result = props.result ?? DEFAULT_RESULT;\n225\t    const ratingChange = props.ratingChange ?? DEFAULT_RATING;\n226\t    const timeControl = props.timeControl ?? DEFAULT_TIME;\n227\t    const date = props.date ?? DEFAULT_DATE;\n228\t    const opponentName = props.opponentName ?? DEFAULT_OPPONENT;\n229\t\n230\t    if (typeof opening !== \"string\") throw new Error(`${ID}: opening must be a string.`);\n231\t    if (![\"win\", \"loss\", \"draw\"].includes(result)) throw new Error(`${ID}: result must be 'win', 'loss', or 'draw'.`);\n232\t    if (typeof ratingChange !== \"number\") throw new Error(`${ID}: ratingChange must be a number.`);\n233\t    if (typeof timeControl !== \"string\") throw new Error(`${ID}: timeControl must be a string.`);\n234\t    if (typeof date !== \"string\") throw new Error(`${ID}: date must be a string.`);\n235\t    if (typeof opponentName !== \"string\") throw new Error(`${ID}: opponentName must be a string.`);\n236\t\n237\t    const { width: W, height: H } = ctx.target;\n238\t    const px = (fx: number, fy: number, fw: number, fh: number) => ({\n239\t      x: Math.round(fx * W),\n240\t      y: Math.round(fy * H),\n241\t      w: Math.round(fw * W),\n242\t      h: Math.round(fh * H),\n243\t    });\n244\t\n245\t    const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n246\t    const piece = (rect: { x: number; y: number; w: number; h: number }, importance: number, source: MosaicSource) =>\n247\t      pieces.push({ rect: { ...rect, importance }, source });\n248\t\n249\t    // Determine result color and label\n250\t    const resultColor = result === \"win\" ? WIN_COLOR : result === \"loss\" ? LOSS_COLOR : DRAW_COLOR;\n251\t    const resultLabel = result.toUpperCase();\n252\t\n253\t    // Header: opening name (top 18%)\n254\t    const headerBand = px(0, 0, 1, 0.18);\n255\t    const openingLabel = px(0.06, 0.02, 0.88, 0.14);\n256\t    piece(openingLabel, 2, bindProp(tag(svgLabel(opening, openingLabel.w, openingLabel.h, { maxPx: Math.round(H * 0.12), maxLines: 1, color: INK }), \"opening\"), \"opening\"));\n257\t\n258\t    // Main zone (center 60%, from 18% to 78%)\n259\t    const mainStart = 0.18;\n260\t    const mainEnd = 0.78;\n261\t    const mainHeight = mainEnd - mainStart;\n262\t\n263\t    // Left half: result indicator - large colored text showing result\n264\t    const resultLabelBox = px(0.06, mainStart + 0.20, 0.44, 0.30);\n265\t    piece(resultLabelBox, 2, tag(svgLabel(resultLabel, resultLabelBox.w, resultLabelBox.h, { maxPx: Math.round(H * 0.18), maxLines: 1, color: resultColor }), \"result\"));\n266\t\n267\t    // Right half: time control and rating change (stacked)\n268\t    // Time control (upper)\n269\t    const timeBox = px(0.56, mainStart + 0.15, 0.38, 0.15);\n270\t    piece(timeBox, 2, bindProp(tag(svgLabel(timeControl, timeBox.w, timeBox.h, { maxPx: Math.round(H * 0.07), maxLines: 1, color: INK }), \"time\"), \"timeControl\"));\n271\t\n272\t    // Rating change (lower)\n273\t    const ratingText = ratingChange >= 0 ? `+${ratingChange}` : `${ratingChange}`;\n274\t    const ratingBox = px(0.56, mainStart + 0.35, 0.38, 0.15);\n275\t    piece(ratingBox, 2, tag(svgLabel(ratingText, ratingBox.w, ratingBox.h, { maxPx: Math.round(H * 0.07), maxLines: 1, color: DIM }), \"rating\"));\n276\t\n277\t    // Footer: date and opponent (bottom 22%, from 78% to 100%)\n278\t    const footerStart = 0.78;\n279\t    const dateBox = px(0.06, footerStart + 0.02, 0.3, 0.18);\n280\t    piece(dateBox, 2, bindProp(tag(svgLabel(date, dateBox.w, dateBox.h, { maxPx: Math.round(H * 0.06), maxLines: 1, color: DIM }), \"date\"), \"date\"));\n281\t\n282\t    const opponentPrefix = \"vs \";\n283\t    const opponentText = opponentPrefix + opponentName;\n284\t    const opponentBox = px(0.5, footerStart + 0.02, 0.44, 0.18);\n285\t    piece(opponentBox, 2, bindProp(tag(svgLabel(opponentText, opponentBox.w, opponentBox.h, { maxPx: Math.round(H * 0.06), maxLines: 1, color: INK }), \"opponent\"), \"opponentName\"));\n286\t\n287\t    const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n288\t\n289\t    const doc: MosaicDocument = {\n290\t      kind: \"mosaic_document\",\n291\t      version: 1,\n292\t      m0: toM0String(placed.m0, ID),\n293\t      assets: {},\n294\t      backgroundColor: PAGE,\n295\t      sources: placed.sources,\n296\t    };\n297\t    return withLayoutIntent(doc, ctx, { templateId: ID, constraints: layoutContract(), debug: props.debugLayout === true });\n298\t}\n299\t"}]},"parent_tool_use_id":null,"session_id":"25441022-bd78-4c0c-94da-dd6d254f9c20","uuid":"04d69518-fc1d-4c55-8438-8ea5fba4b035","timestamp":"2026-10-07T13:33:05.810Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\chess-game-recap\\v1\\chess-game-recap.ts","content":"import type {\n  MosaicColor,\n  MosaicDocument,\n  MosaicEngineContext,\n  MosaicSource,\n} from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport {\n  bindProp,\n  defineMosaicTemplate,\n  definePropsSchema,\n  placeInsetPieces,\n  svgLabel,\n  tag,\n} from \"@m0saic/template-utils\";\nimport type { LayoutConstraint } from \"@m0saic/template-utils\";\nimport { TEXT_EM, textFitsAll, withLayoutIntent } from \"../../../_shared/layout\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/sports/chess-game-recap/v1` — shareable game recap card for chess.\n *\n * ONE CONCEPT: render opening name, result (colored icon + label), time control,\n * and rating change as a professional recap card that shares better than a screenshot.\n *\n * The rule that bites: chess-specific UI conventions (result colors: green/red/gray)\n * and tight text fitting across seven canvases from 640×360 to 3840×2160.\n */\n\nexport type ChessGameRecapProps = {\n  /** The chess opening name displayed in the header. */\n  opening?: string;\n  /** The game result: win, loss, or draw. */\n  result?: \"win\" | \"loss\" | \"draw\";\n  /** The rating delta displayed (e.g., +32, -18, 0). */\n  ratingChange?: number;\n  /** The time control format (e.g., \"10+5\", \"5+3\", \"1+0\"). */\n  timeControl?: string;\n  /** The game date in ISO format (YYYY-MM-DD). */\n  date?: string;\n  /** The opponent or player name displayed in the footer. */\n  opponentName?: string;\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/sports/chess-game-recap/v1\";\nconst INK = \"#eaeef2\" as MosaicColor;\nconst DIM = \"#9aa7b4\" as MosaicColor;\nconst PAGE = \"#1c2833\" as MosaicColor;\nconst WIN_COLOR = \"#2caf45\" as MosaicColor;\nconst LOSS_COLOR = \"#d84849\" as MosaicColor;\nconst DRAW_COLOR = \"#8b92a1\" as MosaicColor;\nconst DEFAULT_OPENING = \"King's Indian Defense\";\nconst DEFAULT_RESULT = \"win\" as const;\nconst DEFAULT_RATING = 25;\nconst DEFAULT_TIME = \"10+5\";\nconst DEFAULT_DATE = \"2026-10-07\";\nconst DEFAULT_OPPONENT = \"Opponent\";\n\nconst propsSchema = definePropsSchema<ChessGameRecapProps>({\n  opening: {\n    type: \"string\",\n    required: false,\n    description: \"The chess opening name.\",\n    meta: { control: { placeholder: DEFAULT_OPENING }, ui: { label: \"Opening\", order: 1 } },\n  },\n  result: {\n    type: \"string\",\n    required: false,\n    description: \"Game result: win, loss, or draw.\",\n    meta: { ui: { label: \"Result\", order: 2 } },\n  },\n  ratingChange: {\n    type: \"number\",\n    required: false,\n    description: \"Rating delta.\",\n    meta: { ui: { label: \"Rating Change\", order: 3 } },\n  },\n  timeControl: {\n    type: \"string\",\n    required: false,\n    description: \"Time control format (e.g., 10+5, 5+3).\",\n    meta: { control: { placeholder: DEFAULT_TIME }, ui: { label: \"Time Control\", order: 4 } },\n  },\n  date: {\n    type: \"string\",\n    required: false,\n    description: \"Game date in YYYY-MM-DD format.\",\n    meta: { control: { placeholder: DEFAULT_DATE }, ui: { label: \"Date\", order: 5 } },\n  },\n  opponentName: {\n    type: \"string\",\n    required: false,\n    description: \"Opponent name.\",\n    meta: { control: { placeholder: DEFAULT_OPPONENT }, ui: { label: \"Opponent\", order: 6 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n/**\n * What the geometry promises: opening name fits the header (top 18%), result\n * and stats fit their columns, footer text fits the bottom band (22%).\n */\nfunction layoutContract(): LayoutConstraint[] {\n  return [\n    ...textFitsAll([\"opening\", \"result\", \"time\", \"rating\", \"date\", \"opponent\"], { charWidthEm: TEXT_EM.prose }),\n    { label: \"opening\", within: { yFrac: [0, 0.18] }, minWidthFrac: 0.85 },\n    { label: \"result\", within: { yFrac: [0.18, 0.78] } },\n    { label: \"time\", within: { yFrac: [0.18, 0.78] } },\n    { label: \"rating\", within: { yFrac: [0.18, 0.78] } },\n    { label: \"date\", within: { yFrac: [0.78, 1] } },\n    { label: \"opponent\", within: { yFrac: [0.78, 1] } },\n  ];\n}\n\n/**\n * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n * convention, src/_shared/why.ts): the run, the problem with the sources the\n * agent opened, the solution, how to use it, then the template itself.\n * Pre-filled from journal/2026-10-07/ - replace every \"[fill me]\" and say it\n * in the evidence's own words. The build refuses a placeholder.\n */\nconst WHY: WhySpec = {\n  \"day\": 18,\n  \"date\": \"2026-10-07\",\n  \"agent\": \"claude\",\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"id\": \"@one-a-day/sports/chess-game-recap/v1\",\n  \"title\": \"Chess Game Recap\",\n  \"who\": \"Chess players on Lichess and Chess.com, streamers analyzing games, and players sharing rating milestones in online communities.\",\n  \"problem\": [\n    \"Players screenshot their games to share online, but screenshots scale poorly across devices and lose metadata when resized. Streamers need clean, shareable recap cards that render vector-sharp at any size without quality loss.\"\n  ],\n  \"sources\": [\n    \"https://github.com/philphilphil/blunderbase\",\n    \"https://github.com/brumar/chess-postmortem-skills\",\n    \"https://news.ycombinator.com/item?id=49857528\",\n    \"https://lichess.org\"\n  ],\n  \"solution\": [\n    \"A chess recap card rendering opening name, result with color-coded label, time control, rating delta, date and opponent in a clean layout. SVG rendering ensures vector-sharp scaling across all devices. Works from PGN metadata with sensible defaults.\"\n  ],\n  \"usage\": {\n    \"command\": \"m0saic make @one-a-day/sports/chess-game-recap/v1 --template-repo . -w 1280 -h 720 -o out.png\",\n    \"try\": [\n      \"opening='Sicilian Defense' result='loss' ratingChange='-12'\",\n      \"opening='Berlin Defense' result='draw' timeControl='classical'\",\n      \"opponentName='Magnus Carlsen' result='win' ratingChange='+89'\"\n    ]\n  },\n  \"timeline\": {\n    \"source\": \"runner\",\n    \"phases\": [\n      {\n        \"name\": \"scout\",\n        \"startMs\": 0,\n        \"durMs\": 220183,\n        \"calls\": 105,\n        \"tokens\": 9009637,\n        \"costUsd\": 0.47,\n        \"tools\": \"Bash 95, Read 7, Write 2\"\n      },\n      {\n        \"name\": \"plan\",\n        \"startMs\": 220200,\n        \"durMs\": 60866,\n        \"calls\": 8,\n        \"tokens\": 615291,\n        \"costUsd\": 0.09,\n        \"tools\": \"Read 6, Edit 1, Write 1\"\n      }\n    ],\n    \"costBasis\": \"reported\"\n  }\n};\n\nexport const ChessGameRecapV1 = defineMosaicTemplate<ChessGameRecapProps>({\n  id: asTemplateId(ID),\n  label: \"2026-10-07 · Chess Game Recap\",\n  version: 1,\n  description: \"Chess game recap card: opening, result, time control, and rating change rendered as a shareable card that scales beautifully across all devices.\",\n  capabilities: { tier: \"core\" },\n  tags: [\"sports\",\"2026-10-07\",\"day-018\",\"chess\",\"pgn\",\"lichess\",\"game-analysis\",\"rating-progression\"],\n\n  outputHints: {\n    width: 1280,\n    height: 720,\n    fps: 30,\n    durationMs: 2000,\n    format: { kind: \"image\", container: \"png\" },\n    note: \"Static card - any canvas and any duration render cleanly.\",\n  },\n\n  propsSchema,\n  defaultProps: {\n    opening: DEFAULT_OPENING,\n    result: DEFAULT_RESULT,\n    ratingChange: DEFAULT_RATING,\n    timeControl: DEFAULT_TIME,\n    date: DEFAULT_DATE,\n    opponentName: DEFAULT_OPPONENT,\n    debugLayout: false,\n  },\n\n  render,\n  renderTutorial: whyTutorial(WHY, render),\n});\n\nexport default ChessGameRecapV1;\n\nasync function render(\n  props: ChessGameRecapProps,\n  ctx: MosaicEngineContext,\n): Promise<MosaicDocument> {\n    const opening = props.opening ?? DEFAULT_OPENING;\n    const result = props.result ?? DEFAULT_RESULT;\n    const ratingChange = props.ratingChange ?? DEFAULT_RATING;\n    const timeControl = props.timeControl ?? DEFAULT_TIME;\n    const date = props.date ?? DEFAULT_DATE;\n    const opponentName = props.opponentName ?? DEFAULT_OPPONENT;\n\n    if (typeof opening !== \"string\") throw new Error(`${ID}: opening must be a string.`);\n    if (![\"win\", \"loss\", \"draw\"].includes(result)) throw new Error(`${ID}: result must be 'win', 'loss', or 'draw'.`);\n    if (typeof ratingChange !== \"number\") throw new Error(`${ID}: ratingChange must be a number.`);\n    if (typeof timeControl !== \"string\") throw new Error(`${ID}: timeControl must be a string.`);\n    if (typeof date !== \"string\") throw new Error(`${ID}: date must be a string.`);\n    if (typeof opponentName !== \"string\") throw new Error(`${ID}: opponentName must be a string.`);\n\n    const { width: W, height: H } = ctx.target;\n    const px = (fx: number, fy: number, fw: number, fh: number) => ({\n      x: Math.round(fx * W),\n      y: Math.round(fy * H),\n      w: Math.round(fw * W),\n      h: Math.round(fh * H),\n    });\n\n    const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n    const piece = (rect: { x: number; y: number; w: number; h: number }, importance: number, source: MosaicSource) =>\n      pieces.push({ rect: { ...rect, importance }, source });\n\n    // Determine result color and label\n    const resultColor = result === \"win\" ? WIN_COLOR : result === \"loss\" ? LOSS_COLOR : DRAW_COLOR;\n    const resultLabel = result.toUpperCase();\n\n    // Header: opening name (top 18%)\n    const headerBand = px(0, 0, 1, 0.18);\n    const openingLabel = px(0.06, 0.02, 0.88, 0.14);\n    piece(openingLabel, 2, bindProp(tag(svgLabel(opening, openingLabel.w, openingLabel.h, { maxPx: Math.round(H * 0.12), maxLines: 1, color: INK }), \"opening\"), \"opening\"));\n\n    // Main zone (center 60%, from 18% to 78%)\n    const mainStart = 0.18;\n    const mainEnd = 0.78;\n    const mainHeight = mainEnd - mainStart;\n\n    // Left half: result indicator - large colored text showing result\n    const resultLabelBox = px(0.06, mainStart + 0.20, 0.44, 0.30);\n    piece(resultLabelBox, 2, tag(svgLabel(resultLabel, resultLabelBox.w, resultLabelBox.h, { maxPx: Math.round(H * 0.18), maxLines: 1, color: resultColor }), \"result\"));\n\n    // Right half: time control and rating change (stacked)\n    // Time control (upper)\n    const timeBox = px(0.56, mainStart + 0.15, 0.38, 0.15);\n    piece(timeBox, 2, bindProp(tag(svgLabel(timeControl, timeBox.w, timeBox.h, { maxPx: Math.round(H * 0.07), maxLines: 1, color: INK }), \"time\"), \"timeControl\"));\n\n    // Rating change (lower)\n    const ratingText = ratingChange >= 0 ? `+${ratingChange}` : `${ratingChange}`;\n    const ratingBox = px(0.56, mainStart + 0.35, 0.38, 0.15);\n    piece(ratingBox, 2, tag(svgLabel(ratingText, ratingBox.w, ratingBox.h, { maxPx: Math.round(H * 0.07), maxLines: 1, color: DIM }), \"rating\"));\n\n    // Footer: date and opponent (bottom 22%, from 78% to 100%)\n    const footerStart = 0.78;\n    const dateBox = px(0.06, footerStart + 0.02, 0.3, 0.18);\n    piece(dateBox, 2, bindProp(tag(svgLabel(date, dateBox.w, dateBox.h, { maxPx: Math.round(H * 0.06), maxLines: 1, color: DIM }), \"date\"), \"date\"));\n\n    const opponentPrefix = \"vs \";\n    const opponentText = opponentPrefix + opponentName;\n    const opponentBox = px(0.5, footerStart + 0.02, 0.44, 0.18);\n    piece(opponentBox, 2, bindProp(tag(svgLabel(opponentText, opponentBox.w, opponentBox.h, { maxPx: Math.round(H * 0.06), maxLines: 1, color: INK }), \"opponent\"), \"opponentName\"));\n\n    const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n\n    const doc: MosaicDocument = {\n      kind: \"mosaic_document\",\n      version: 1,\n      m0: toM0String(placed.m0, ID),\n      assets: {},\n      backgroundColor: PAGE,\n      sources: placed.sources,\n    };\n    return withLayoutIntent(doc, ctx, { templateId: ID, constraints: layoutContract(), debug: props.debugLayout === true });\n}\n","numLines":299,"startLine":1,"totalLines":299}}}
