{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MudbZBki7Xc4RT5pb4h6oo","type":"tool_result","content":"1\timport type {\n2\t  MosaicColor,\n3\t  MosaicDocument,\n4\t  MosaicEngineContext,\n5\t  MosaicSource,\n6\t} from \"@m0saic/types\";\n7\timport { asTemplateId } from \"@m0saic/types\";\n8\timport { toM0String } from \"@m0saic/dsl-stdlib\";\n9\timport {\n10\t  bindProp,\n11\t  defineMosaicTemplate,\n12\t  definePropsSchema,\n13\t  placeInsetPieces,\n14\t  svgLabel,\n15\t  tag,\n16\t} from \"@m0saic/template-utils\";\n17\timport type { LayoutConstraint } from \"@m0saic/template-utils\";\n18\timport { TEXT_EM, textFitsAll, withLayoutIntent } from \"../../../_shared/layout\";\n19\timport { whyTutorial } from \"../../../_shared/why\";\n20\timport type { WhySpec } from \"../../../_shared/why\";\n21\t\n22\t/**\n23\t * `@one-a-day/sports/lap-telemetry-card/v1` — a sim racing lap achievement card:\n24\t * track name, lap time, personal best, sector breakdown with times and deltas,\n25\t * driver name, and top speed, from telemetry or race results.\n26\t *\n27\t * ONE CONCEPT: the delta bar shows at a glance which sector was the bottleneck —\n28\t * green bars are faster than PB, red bars are slower, and the visual length is\n29\t * proportional to the improvement or loss.\n30\t *\n31\t * The rule that bites: time formatting must match the parser exactly (M:SS.sss\n32\t * or SS.sss), and the delta calculation is signed (negative = faster, positive = slower).\n33\t */\n34\t\n35\texport type LapTelemetryCardProps = {\n36\t  /** The track or circuit name. */\n37\t  trackName?: string;\n38\t  /** Lap time in M:SS.sss or SS.sss format. */\n39\t  lapTime?: string;\n40\t  /** Personal best lap time in M:SS.sss or SS.sss format. */\n41\t  pbTime?: string;\n42\t  /** Sector 1 lap time. */\n43\t  sector1Time?: string;\n44\t  /** Sector 2 lap time. */\n45\t  sector2Time?: string;\n46\t  /** Sector 3 lap time. */\n47\t  sector3Time?: string;\n48\t  /** Sector 1 personal best time. */\n49\t  sector1Pb?: string;\n50\t  /** Sector 2 personal best time. */\n51\t  sector2Pb?: string;\n52\t  /** Sector 3 personal best time. */\n53\t  sector3Pb?: string;\n54\t  /** Driver name or callsign. */\n55\t  driverId?: string;\n56\t  /** Top speed in km/h. */\n57\t  topSpeed?: string;\n58\t  /** Dev-only: check the layout contract and draw it over the card. */\n59\t  debugLayout?: boolean;\n60\t};\n61\t\n62\tconst ID = \"@one-a-day/sports/lap-telemetry-card/v1\";\n63\tconst INK = \"#eaeef2\" as MosaicColor;\n64\tconst DIM = \"#9aa7b4\" as MosaicColor;\n65\tconst GREEN = \"#2ecc71\" as MosaicColor;\n66\tconst RED = \"#e74c3c\" as MosaicColor;\n67\tconst PAGE = \"#1c2833\" as MosaicColor;\n68\t\n69\tconst DEFAULTS = {\n70\t  trackName: \"Nurburgring\",\n71\t  lapTime: \"7:45.123\",\n72\t  pbTime: \"7:42.456\",\n73\t  sector1Time: \"2:30.123\",\n74\t  sector2Time: \"2:45.234\",\n75\t  sector3Time: \"2:29.766\",\n76\t  sector1Pb: \"2:29.456\",\n77\t  sector2Pb: \"2:44.123\",\n78\t  sector3Pb: \"2:29.123\",\n79\t  driverId: \"Driver\",\n80\t  topSpeed: \"285\",\n81\t};\n82\t\n83\tconst propsSchema = definePropsSchema<LapTelemetryCardProps>({\n84\t  trackName: {\n85\t    type: \"string\",\n86\t    required: false,\n87\t    description: \"The track or circuit name, up to 40 characters.\",\n88\t    meta: { control: { placeholder: DEFAULTS.trackName }, ui: { label: \"Track\", order: 1 } },\n89\t  },\n90\t  lapTime: {\n91\t    type: \"string\",\n92\t    required: false,\n93\t    description: \"Lap time in M:SS.sss or SS.sss format.\",\n94\t    meta: { control: { placeholder: DEFAULTS.lapTime }, ui: { label: \"Lap time\", order: 2 } },\n95\t  },\n96\t  pbTime: {\n97\t    type: \"string\",\n98\t    required: false,\n99\t    description: \"Personal best lap time.\",\n100\t    meta: { control: { placeholder: DEFAULTS.pbTime }, ui: { label: \"PB time\", order: 3 } },\n101\t  },\n102\t  sector1Time: {\n103\t    type: \"string\",\n104\t    required: false,\n105\t    description: \"Sector 1 lap time.\",\n106\t    meta: { control: { placeholder: DEFAULTS.sector1Time }, ui: { label: \"Sector 1 time\", order: 4 } },\n107\t  },\n108\t  sector2Time: {\n109\t    type: \"string\",\n110\t    required: false,\n111\t    description: \"Sector 2 lap time.\",\n112\t    meta: { control: { placeholder: DEFAULTS.sector2Time }, ui: { label: \"Sector 2 time\", order: 5 } },\n113\t  },\n114\t  sector3Time: {\n115\t    type: \"string\",\n116\t    required: false,\n117\t    description: \"Sector 3 lap time.\",\n118\t    meta: { control: { placeholder: DEFAULTS.sector3Time }, ui: { label: \"Sector 3 time\", order: 6 } },\n119\t  },\n120\t  sector1Pb: {\n121\t    type: \"string\",\n122\t    required: false,\n123\t    description: \"Sector 1 personal best time.\",\n124\t    meta: { control: { placeholder: DEFAULTS.sector1Pb }, ui: { label: \"Sector 1 PB\", order: 7 } },\n125\t  },\n126\t  sector2Pb: {\n127\t    type: \"string\",\n128\t    required: false,\n129\t    description: \"Sector 2 personal best time.\",\n130\t    meta: { control: { placeholder: DEFAULTS.sector2Pb }, ui: { label: \"Sector 2 PB\", order: 8 } },\n131\t  },\n132\t  sector3Pb: {\n133\t    type: \"string\",\n134\t    required: false,\n135\t    description: \"Sector 3 personal best time.\",\n136\t    meta: { control: { placeholder: DEFAULTS.sector3Pb }, ui: { label: \"Sector 3 PB\", order: 9 } },\n137\t  },\n138\t  driverId: {\n139\t    type: \"string\",\n140\t    required: false,\n141\t    description: \"Driver name or callsign, up to 30 characters.\",\n142\t    meta: { control: { placeholder: DEFAULTS.driverId }, ui: { label: \"Driver\", order: 10 } },\n143\t  },\n144\t  topSpeed: {\n145\t    type: \"string\",\n146\t    required: false,\n147\t    description: \"Top speed in km/h.\",\n148\t    meta: { control: { placeholder: DEFAULTS.topSpeed }, ui: { label: \"Top speed\", order: 11 } },\n149\t  },\n150\t  debugLayout: {\n151\t    type: \"boolean\",\n152\t    required: false,\n153\t    description: \"Dev-only: check the layout contract and draw it over the card.\",\n154\t    meta: { ui: { label: \"Debug layout\", order: 99 } },\n155\t  },\n156\t});\n157\t\n158\tfunction layoutContract(): LayoutConstraint[] {\n159\t  return [\n160\t    ...textFitsAll([\n161\t      \"trackName\", \"lapTime\",\n162\t      \"sector1\", \"sector1-pb\", \"sector1-delta\",\n163\t      \"sector2\", \"sector2-pb\", \"sector2-delta\",\n164\t      \"sector3\", \"sector3-pb\", \"sector3-delta\",\n165\t      \"driverId\", \"topSpeed\"\n166\t    ], { charWidthEm: TEXT_EM.prose }),\n167\t    { label: \"trackName\", within: { yFrac: [0, 0.15] } },\n168\t    { label: \"lapTime\", within: { yFrac: [0.1, 0.2] } },\n169\t    { label: \"sector1\", within: { yFrac: [0.2, 0.4] } },\n170\t    { label: \"sector1-pb\", within: { yFrac: [0.2, 0.4] } },\n171\t    { label: \"sector1-delta\", within: { yFrac: [0.2, 0.4] } },\n172\t    { label: \"sector2\", within: { yFrac: [0.4, 0.6] } },\n173\t    { label: \"sector2-pb\", within: { yFrac: [0.4, 0.6] } },\n174\t    { label: \"sector2-delta\", within: { yFrac: [0.4, 0.6] } },\n175\t    { label: \"sector3\", within: { yFrac: [0.6, 0.8] } },\n176\t    { label: \"sector3-pb\", within: { yFrac: [0.6, 0.8] } },\n177\t    { label: \"sector3-delta\", within: { yFrac: [0.6, 0.8] } },\n178\t    { label: \"driverId\", within: { yFrac: [0.8, 1] } },\n179\t    { label: \"topSpeed\", within: { yFrac: [0.8, 1] } },\n180\t  ];\n181\t}\n182\t\n183\tconst WHY: WhySpec = {\n184\t  \"day\": 13,\n185\t  \"date\": \"2026-10-02\",\n186\t  \"agent\": \"claude\",\n187\t  \"model\": \"claude-haiku-4-5-20251001\",\n188\t  \"id\": \"@one-a-day/sports/lap-telemetry-card/v1\",\n189\t  \"title\": \"Sim Racing Lap Card\",\n190\t  \"who\": \"Competitive sim racers in iRacing, Assetto Corsa, Le Mans Ultimate communities; platforms like SimTelemetry.site, YouTube channels, competitive leagues.\",\n191\t  \"problem\": [\n192\t    \"Sim racers want to share lap achievements - sector times, deltas vs PB, apex speeds - as shareable cards. SimTelemetry.site records telemetry at 60Hz. Drivers currently screenshot lap times or manually create graphics; a deterministic lap card lets them share standardized achievements.\"\n193\t  ],\n194\t  \"sources\": [\n195\t    \"https://simtelemetry.site\",\n196\t    \"https://news.ycombinator.com/item?id=49045861\"\n197\t  ],\n198\t  \"solution\": [\n199\t    \"A deterministic lap card: each sector shows its time and delta (negative = faster, positive = slower) with a proportional bar that is green when faster or red when slower than PB. Driver name and top speed complete the context. The delta bar makes it obvious at a glance which sector was the bottleneck on this run.\"\n200\t  ],\n201\t  \"usage\": {\n202\t    \"command\": \"m0saic make @one-a-day/sports/lap-telemetry-card/v1 --template-repo . -w 1280 -h 720 -o lap.png\",\n203\t    \"try\": [\n204\t      \"Add --topSpeed 310 to show higher speeds\",\n205\t      \"Try portrait: -w 1080 -h 1920\",\n206\t      \"Square crop: -w 1080 -h 1080\"\n207\t    ]\n208\t  },\n209\t  \"timeline\": {\n210\t    \"source\": \"runner\",\n211\t    \"phases\": [\n212\t      {\n213\t        \"name\": \"scout\",\n214\t        \"startMs\": 0,\n215\t        \"durMs\": 217259,\n216\t        \"calls\": 100,\n217\t        \"tokens\": 8356979,\n218\t        \"costUsd\": 0.44,\n219\t        \"tools\": \"Bash 93, Read 4, Write 2\"\n220\t      },\n221\t      {\n222\t        \"name\": \"plan\",\n223\t        \"startMs\": 217273,\n224\t        \"durMs\": 63094,\n225\t        \"calls\": 11,\n226\t        \"tokens\": 923341,\n227\t        \"costUsd\": 0.11,\n228\t        \"tools\": \"Read 7, Glob 2, Bash 1\"\n229\t      }\n230\t    ],\n231\t    \"costBasis\": \"reported\"\n232\t  }\n233\t};\n234\t\n235\texport const LapTelemetryCardV1 = defineMosaicTemplate<LapTelemetryCardProps>({\n236\t  id: asTemplateId(ID),\n237\t  label: \"2026-10-02 · Sim Racing Lap Card\",\n238\t  version: 1,\n239\t  description: \"A sim racing lap card: track name, lap time and delta vs PB, sector breakdown with times and delta bars (green for faster, red for slower), driver name, and top speed.\",\n240\t  capabilities: { tier: \"core\" },\n241\t  tags: [\"sports\",\"2026-10-02\",\"day-013\",\"racing\",\"telemetry\",\"sector\",\"delta\"],\n242\t\n243\t  outputHints: {\n244\t    width: 1280,\n245\t    height: 720,\n246\t    fps: 30,\n247\t    durationMs: 2000,\n248\t    format: { kind: \"image\", container: \"png\" },\n249\t    note: \"Static card - renders cleanly at any canvas size and duration.\",\n250\t  },\n251\t\n252\t  propsSchema,\n253\t  defaultProps: {\n254\t    trackName: DEFAULTS.trackName,\n255\t    lapTime: DEFAULTS.lapTime,\n256\t    pbTime: DEFAULTS.pbTime,\n257\t    sector1Time: DEFAULTS.sector1Time,\n258\t    sector2Time: DEFAULTS.sector2Time,\n259\t    sector3Time: DEFAULTS.sector3Time,\n260\t    sector1Pb: DEFAULTS.sector1Pb,\n261\t    sector2Pb: DEFAULTS.sector2Pb,\n262\t    sector3Pb: DEFAULTS.sector3Pb,\n263\t    driverId: DEFAULTS.driverId,\n264\t    topSpeed: DEFAULTS.topSpeed,\n265\t    debugLayout: false,\n266\t  },\n267\t\n268\t  render,\n269\t  renderTutorial: whyTutorial(WHY, render),\n270\t});\n271\t\n272\texport default LapTelemetryCardV1;\n273\t\n274\tfunction parseTimeToMs(timeStr: string): number {\n275\t  const parts = timeStr.trim().split(\":\");\n276\t  if (parts.length === 1) {\n277\t    return Math.round(parseFloat(parts[0]) * 1000);\n278\t  } else if (parts.length === 2) {\n279\t    const mins = parseInt(parts[0], 10);\n280\t    const secs = parseFloat(parts[1]);\n281\t    return Math.round((mins * 60 + secs) * 1000);\n282\t  }\n283\t  throw new Error(`Invalid time format: ${timeStr}`);\n284\t}\n285\t\n286\tfunction formatTime(ms: number): string {\n287\t  const totalSecs = ms / 1000;\n288\t  const mins = Math.floor(totalSecs / 60);\n289\t  const secs = totalSecs - mins * 60;\n290\t  if (mins > 0) {\n291\t    return `${mins}:${secs.toFixed(3).padStart(7, \"0\")}`;\n292\t  }\n293\t  return secs.toFixed(3);\n294\t}\n295\t\n296\tfunction formatDelta(ms: number): string {\n297\t  const sign = ms >= 0 ? \"+\" : \"\";\n298\t  const secs = Math.abs(ms / 1000);\n299\t  return `${sign}${secs.toFixed(3)}s`;\n300\t}\n301\t\n302\tasync function render(\n303\t  props: LapTelemetryCardProps,\n304\t  ctx: MosaicEngineContext,\n305\t): Promise<MosaicDocument> {\n306\t    const { width: W, height: H } = ctx.target;\n307\t\n308\t    const trackName = props.trackName ?? DEFAULTS.trackName;\n309\t    const lapTime = props.lapTime ?? DEFAULTS.lapTime;\n310\t    const pbTime = props.pbTime ?? DEFAULTS.pbTime;\n311\t    const sector1Time = props.sector1Time ?? DEFAULTS.sector1Time;\n312\t    const sector2Time = props.sector2Time ?? DEFAULTS.sector2Time;\n313\t    const sector3Time = props.sector3Time ?? DEFAULTS.sector3Time;\n314\t    const sector1Pb = props.sector1Pb ?? DEFAULTS.sector1Pb;\n315\t    const sector2Pb = props.sector2Pb ?? DEFAULTS.sector2Pb;\n316\t    const sector3Pb = props.sector3Pb ?? DEFAULTS.sector3Pb;\n317\t    const driverId = props.driverId ?? DEFAULTS.driverId;\n318\t    const topSpeed = props.topSpeed ?? DEFAULTS.topSpeed;\n319\t\n320\t    if (typeof trackName !== \"string\") throw new Error(`${ID}: trackName must be a string.`);\n321\t    if (typeof lapTime !== \"string\") throw new Error(`${ID}: lapTime must be a string.`);\n322\t    if (typeof pbTime !== \"string\") throw new Error(`${ID}: pbTime must be a string.`);\n323\t    if (typeof driverId !== \"string\") throw new Error(`${ID}: driverId must be a string.`);\n324\t\n325\t    const px = (fx: number, fy: number, fw: number, fh: number) => ({\n326\t      x: Math.round(fx * W),\n327\t      y: Math.round(fy * H),\n328\t      w: Math.round(fw * W),\n329\t      h: Math.round(fh * H),\n330\t    });\n331\t\n332\t    const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n333\t    const piece = (rect: { x: n