{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G3eNqzvsRBkCB2ckvz4Q5n","type":"tool_result","content":"1\timport type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\n2\timport { asTemplateId } from \"@m0saic/types\";\n3\timport { toM0String } from \"@m0saic/dsl-stdlib\";\n4\timport { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\n5\timport type { LayoutConstraint } from \"@m0saic/template-utils\";\n6\timport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n7\timport { budget, textCell, widthOf } from \"../../../_shared/text\";\n8\timport { whyTutorial } from \"../../../_shared/why\";\n9\timport type { WhySpec } from \"../../../_shared/why\";\n10\t\n11\t/**\n12\t * `@one-a-day/community/qsl-card/v1` - a ham radio QSL card for ONE contact,\n13\t * rendered from the fields of one ADIF log record, so a script can loop over\n14\t * a whole log and write one card per QSO.\n15\t *\n16\t * ONE CONCEPT: the props ARE the log record. Each prop is an ADIF field in\n17\t * camelCase taking the ADIF format (QSO_DATE \"20261003\", TIME_ON \"1432\",\n18\t * FREQ \"14.074\" in MHz), and the card prints it the way a QSL does\n19\t * (\"03 OCT 2026\", \"14:32\"). BAND is not a prop: it is DERIVED from FREQ with\n20\t * the ADIF 3.1.6 band enumeration, so the two can never disagree on a card.\n21\t *\n22\t * The rule that bites: a callsign is never ellipsized. A card with half a\n23\t * call on it confirms nothing. The station call is sized from its own text\n24\t * (a short K1A is limited by the band's height, a long VP2V/G4ABC by its\n25\t * width), the QSO table reflows by aspect (6x1, 3x2, 2x3) before any type\n26\t * shrinks, the table values shrink before the call drops below twice their\n27\t * size, and copy that cannot fit above the readability floor (10/270 of\n28\t * the short side) is refused with an error that names the prop.\n29\t */\n30\t\n31\texport type QslCardProps = {\n32\t  /** STATION_CALLSIGN: the sender, the biggest thing on the card. */\n33\t  stationCallsign?: string;\n34\t  /** CALL: the station worked - \"TO RADIO <call>\". */\n35\t  call?: string;\n36\t  /** QSO_DATE as YYYYMMDD (UTC). */\n37\t  qsoDate?: string;\n38\t  /** TIME_ON as HHMM or HHMMSS (UTC). */\n39\t  timeOn?: string;\n40\t  /** FREQ in MHz, printed as given; BAND is derived from it. */\n41\t  freq?: string;\n42\t  /** MODE (or SUBMODE), printed as the log says it. */\n43\t  mode?: string;\n44\t  /** RST_SENT: \"59\", \"599\" or a signed dB report (\"-12\"). */\n45\t  rstSent?: string;\n46\t  /** MY_GRIDSQUARE: 4, 6 or 8 character Maidenhead; \"\" hides the line. */\n47\t  myGridsquare?: string;\n48\t  /** MY_CITY / MY_STATE as one line; \"\" hides it. */\n49\t  qth?: string;\n50\t  /** MY_POTA_REF: a Parks on the Air reference; \"\" hides it. */\n51\t  myPotaRef?: string;\n52\t  /** QSLMSG: the footer line; \"\" hides it. */\n53\t  qslMsg?: string;\n54\t  /** The one accent: top bar, label rules, TO RADIO tag. */\n55\t  accentColor?: string;\n56\t  /** Dev-only: check the layout contract and draw it over the card. */\n57\t  debugLayout?: boolean;\n58\t};\n59\t\n60\tconst ID = \"@one-a-day/community/qsl-card/v1\";\n61\t/** The face: document.backgroundColor, never a full-canvas rect (doctor: canvasFill). */\n62\tconst PAPER = \"#f4f1ea\";\n63\tconst INK = \"#1b2a4a\";\n64\tconst DIM = \"#66758c\";\n65\tconst DEFAULT_ACCENT = \"#b3261e\";\n66\t\n67\t// Labelled examples, not anybody's log: N0CALL is the placeholder call ham\n68\t// software ships with, W1AW the ARRL station its documentation uses, and the\n69\t// grid EN34 sits in the 0 call district, so it agrees with N0CALL.\n70\tconst DEFAULTS = {\n71\t  stationCallsign: \"N0CALL\",\n72\t  call: \"W1AW\",\n73\t  qsoDate: \"20261003\",\n74\t  timeOn: \"1432\",\n75\t  freq: \"14.074\",\n76\t  mode: \"FT8\",\n77\t  rstSent: \"-12\",\n78\t  myGridsquare: \"EN34\",\n79\t  qth: \"Minneapolis, MN\",\n80\t  myPotaRef: \"US-1234\",\n81\t  qslMsg: \"TNX QSO 73\",\n82\t  accentColor: DEFAULT_ACCENT,\n83\t  debugLayout: false,\n84\t};\n85\t\n86\tconst propsSchema = definePropsSchema<QslCardProps>({\n87\t  stationCallsign: {\n88\t    type: \"string\",\n89\t    required: false,\n90\t    description: \"STATION_CALLSIGN: your call, the biggest thing on the card. 3-13 characters of A-Z, 0-9 and /, with at least one digit (portable suffixes like /P are fine); upper-cased. Never ellipsized: a call that cannot fit the canvas is refused.\",\n91\t    meta: { control: { placeholder: DEFAULTS.stationCallsign }, ui: { label: \"Station callsign\", order: 1, primary: true } },\n92\t  },\n93\t  call: {\n94\t    type: \"string\",\n95\t    required: false,\n96\t    description: \"CALL: the station you worked, printed as TO RADIO <call>. Same rule as the station callsign.\",\n97\t    meta: { control: { placeholder: DEFAULTS.call }, ui: { label: \"Worked call (CALL)\", order: 2, primary: true } },\n98\t  },\n99\t  qsoDate: {\n100\t    type: \"string\",\n101\t    required: false,\n102\t    description: 'QSO_DATE as the log writes it, YYYYMMDD in UTC (1930 or later). Printed with the month spelled out, \"03 OCT 2026\", so it reads the same in the US and in Europe.',\n103\t    meta: { control: { placeholder: DEFAULTS.qsoDate }, ui: { label: \"QSO date (YYYYMMDD)\", order: 3 } },\n104\t  },\n105\t  timeOn: {\n106\t    type: \"string\",\n107\t    required: false,\n108\t    description: 'TIME_ON in UTC, HHMM or HHMMSS. Printed as 14:32 (or 14:32:05) under the UTC label.',\n109\t    meta: { control: { placeholder: DEFAULTS.timeOn }, ui: { label: \"Time on (HHMM UTC)\", order: 4 } },\n110\t  },\n111\t  freq: {\n112\t    type: \"string\",\n113\t    required: false,\n114\t    description: 'FREQ in MHz, e.g. \"14.074\" or \"1296.200\", printed as given (no rounding, up to 6 decimals). The BAND cell is derived from it with the ADIF 3.1.6 band table (14.074 -> 20m, 432.100 -> 70cm); a frequency outside every amateur band (27.185) is refused.',\n115\t    meta: { control: { placeholder: DEFAULTS.freq }, ui: { label: \"Frequency (MHz)\", order: 5 } },\n116\t  },\n117\t  mode: {\n118\t    type: \"string\",\n119\t    required: false,\n120\t    description: \"MODE or SUBMODE as the log says it (SSB, CW, FT8, FT4, RTTY...). 1-8 characters of A-Z, 0-9 and -, upper-cased; not checked against the ADIF mode list.\",\n121\t    meta: { control: { placeholder: DEFAULTS.mode }, ui: { label: \"Mode\", order: 6 } },\n122\t  },\n123\t  rstSent: {\n124\t    type: \"string\",\n125\t    required: false,\n126\t    description: 'RST_SENT: the report you gave, RS or RST digits (\"59\", \"599\") or a signed dB report (\"-12\", \"+05\").',\n127\t    meta: { control: { placeholder: DEFAULTS.rstSent }, ui: { label: \"Report sent (RST)\", order: 7 } },\n128\t  },\n129\t  myGridsquare: {\n130\t    type: \"string\",\n131\t    required: false,\n132\t    description: 'MY_GRIDSQUARE: 4, 6 or 8 character Maidenhead locator, printed in canonical case (\"EN34lw\"). Empty removes the GRID line.',\n133\t    meta: { control: { placeholder: \"none\" }, ui: { label: \"My grid square\", order: 8 } },\n134\t  },\n135\t  qth: {\n136\t    type: \"string\",\n137\t    required: false,\n138\t    description: \"Your QTH (MY_CITY / MY_STATE as one line), up to 32 characters of printable ASCII. Empty removes the line.\",\n139\t    meta: { control: { placeholder: \"none\" }, ui: { label: \"QTH\", order: 9 } },\n140\t  },\n141\t  myPotaRef: {\n142\t    type: \"string\",\n143\t    required: false,\n144\t    description: 'MY_POTA_REF: a Parks on the Air reference (\"US-1234\", \"K-12345\", \"GB-0001@GB-ENG\"). Empty removes the POTA line - most cards are not from a park.',\n145\t    meta: { control: { placeholder: \"none\" }, ui: { label: \"My POTA ref\", order: 10 } },\n146\t  },\n147\t  qslMsg: {\n148\t    type: \"string\",\n149\t    required: false,\n150\t    description: \"QSLMSG: the footer line, up to 40 characters of printable ASCII. Empty removes it.\",\n151\t    meta: { control: { placeholder: \"none\" }, ui: { label: \"QSL message\", order: 11 } },\n152\t  },\n153\t  accentColor: {\n154\t    type: \"string\",\n155\t    required: false,\n156\t    description: \"The one accent, as #rrggbb: the bar along the top, the rules under the table labels and the TO RADIO tag.\",\n157\t    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 12 } },\n158\t  },\n159\t  debugLayout: {\n160\t    type: \"boolean\",\n161\t    required: false,\n162\t    description: \"Dev-only: check the layout contract (every text fits its box, the call sits in the top half, the QSO table is complete, the accent bar spans the card) and draw it over the card.\",\n163\t    meta: { ui: { label: \"Debug layout\", order: 99 } },\n164\t  },\n165\t});\n166\t\n167\t/* ── the ADIF record: pure, exported, and what the test asserts ── */\n168\t\n169\tfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n170\t\n171\t/** An ADIF Number in MHz -> integer Hz; null when it is not one (more than 6 decimals is not one here). */\n172\texport function qslMHzToHz(text: string): number | null {\n173\t  const m = /^(\\d{0,7})(?:\\.(\\d{1,6}))?$/.exec(text);\n174\t  if (!m || (m[1] === \"\" && m[2] === undefined)) return null;\n175\t  return Number(m[1] || \"0\") * 1_000_000 + Number((m[2] ?? \"\").padEnd(6, \"0\"));\n176\t}\n177\t\n178\t/** The ADIF 3.1.6 Band enumeration (section III.B.4), lower and upper edge in MHz, both inclusive. */\n179\tconst ADIF_BANDS: ReadonlyArray<readonly [string, string, string]> = [\n180\t  [\"2190m\", \".1357\", \".1378\"], [\"630m\", \".472\", \".479\"], [\"560m\", \".501\", \".504\"],\n181\t  [\"160m\", \"1.8\", \"2.0\"], [\"80m\", \"3.5\", \"4.0\"], [\"60m\", \"5.06\", \"5.45\"], [\"40m\", \"7.0\", \"7.3\"],\n182\t  [\"30m\", \"10.1\", \"10.15\"], [\"20m\", \"14.0\", \"14.35\"], [\"17m\", \"18.068\", \"18.168\"], [\"15m\", \"21.0\", \"21.45\"],\n183\t  [\"12m\", \"24.890\", \"24.99\"], [\"10m\", \"28.0\", \"29.7\"], [\"8m\", \"40\", \"45\"], [\"6m\", \"50\", \"54\"],\n184\t  [\"5m\", \"54.000001\", \"69.9\"], [\"4m\", \"70\", \"71\"], [\"2m\", \"144\", \"148\"], [\"1.25m\", \"222\", \"225\"],\n185\t  [\"70cm\", \"420\", \"450\"], [\"33cm\", \"902\", \"928\"], [\"23cm\", \"1240\", \"1300\"], [\"13cm\", \"2300\", \"2450\"],\n186\t  [\"9cm\", \"3300\", \"3500\"], [\"6cm\", \"5650\", \"5925\"], [\"3cm\", \"10000\", \"10500\"], [\"1.25cm\", \"24000\", \"24250\"],\n187\t  [\"6mm\", \"47000\", \"47200\"], [\"4mm\", \"75500\", \"81000\"], [\"2.5mm\", \"119980\", \"123000\"], [\"2mm\", \"134000\", \"149000\"],\n188\t  [\"1mm\", \"241000\", \"250000\"], [\"submm\", \"300000\", \"7500000\"],\n189\t];\n190\tconst BAND_HZ = ADIF_BANDS.map(([band, lo, hi]) => ({ band, lo: qslMHzToHz(lo) as number, hi: qslMHzToHz(hi) as number }));\n191\t\n192\t/** FREQ (MHz text) -> the ADIF band name, or null when the frequency is in no amateur band. Integer Hz, no floats. */\n193\texport function qslBandOf(freq: string): string | null {\n194\t  const hz = qslMHzToHz(freq);\n195\t  if (hz === null) return null;\n196\t  return BAND_HZ.find((b) => hz >= b.lo && hz <= b.hi)?.band ?? null;\n197\t}\n198\t\n199\tconst MONTHS = [\"JAN\", \"FEB\", \"MAR\", \"APR\", \"MAY\", \"JUN\", \"JUL\", \"AUG\", \"SEP\", \"OCT\", \"NOV\", \"DEC\"];\n200\t/** QSO_DATE \"20261003\" -> \"03 OCT 2026\"; null for anything that is not a calendar date from 1930 on (ADIF's floor). */\n201\texport function qslFormatDate(text: string): string | null {\n202\t  const m = /^(\\d{4})(\\d{2})(\\d{2})$/.exec(text);\n203\t  if (!m) return null;\n204\t  const y = Number(m[1]), mo = Number(m[2]), d = Number(m[3]);\n205\t  const leap = (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;\n206\t  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n207\t  if (y < 1930 || mo < 1 || mo > 12 || d < 1 || d > days[mo - 1]) return null;\n208\t  return `${m[3]} ${MONTHS[mo - 1]} ${m[1]}`;\n209\t}\n210\t\n211\t/** TIME_ON \"1432\" -> \"14:32\", \"143205\" -> \"14:32:05\"; null outside 00:00:00-23:59:59. */\n212\texport function qslFormatTime(text: string): string | null {\n213\t  const m = /^(\\d{2})(\\d{2})(\\d{2})?$/.exec(text);\n214\t  if (!m || Number(m[1]) > 23 || Number(m[2]) > 59 || (m[3] !== undefined && Number(m[3]) > 59)) return null;\n215\t  return m[3] === undefined ? `${m[1]}:${m[2]}` : `${m[1]}:${m[2]}:${m[3]}`;\n216\t}\n217\t\n218\t/** A Maidenhead locator (4, 6 or 8 characters) in canonical case - \"EN34lw55\" - or null. */\n219\texport function qslGrid(text: string): string | null {\n220\t  const m = /^([A-R]{2})(\\d{2})(?:([A-X]{2})(\\d{2})?)?$/i.exec(text);\n221\t  if (!m) return null;\n222\t  return `${m[1].toUpperCase()}${m[2]}${(m[3] ?? \"\").toLowerCase()}${m[4] ?? \"\"}`;\n223\t}\n224\t\n225\tfunction str(value: unknown, field: string): string {\n226\t  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n227\t  return value.trim();\n228\t}\n229\t\n230\tfunction callsign(value: unknown, field: string): string {\n231\t  const s = str(value, field).toUpperCase();\n232\t  if (s === \"\") fail(field, \"must not be empty: a QSL card confirms a contact between two calls.\");\n233\t  if (!/^[A-Z0-9/]{3,13}$/.test(s) || !/\\d/.test(s) || !/[A-Z]/.test(s) || /^\\/|\\/$|\\/\\//.test(s)) {\n234\t    fail(field, `${JSON.stringify(s)} is not a callsign: 3-13 characters of A-Z, 0-9 and /, with a letter and a digit, no spaces.`);\n235\t  }\n236\t  return s;\n237\t}\n238\t\n239\tfunction printable(value: unknown, field: string, max: number): string {\n240\t  const s = str(value, field);\n241\t  if (!/^[\\x20-\\x7e]*$/.test(s)) fail(field, `${JSON.stringify(s)} has a character outside printable ASCII, which the card's font is not known to draw.`);\n242\t  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n243\t  return s;\n244\t}\n245\t\n246\t/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n247\texport function normalizeQslCard(props: QslCardProps) {\n248\t  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) } as typeof DEFAULTS;\n249\t  const stationCallsign = callsign(p.stationCallsign, \"stationCallsign\");\n250\t  const call = callsign(p.call, \"call\");\n251\t\n252\t  const qsoDate = str(p.qsoDate, \"qsoDate\");\n253\t  const date = qslFormatDate(qsoDate);\n254\t  if (date === null) fail(\"qsoDate\", `${JSON.stringify(qsoDate)} is not an ADIF date: YYYYMMDD, a real calendar day from 1930 on.`);\n255\t  const timeOn = str(p.timeOn, \"timeOn\");\n256\t  const time = qslFormatTime(timeOn);\n257\t  if (time === null) fail(\"timeOn\", `${JSON.stringify(timeOn)} is not an ADIF time: HHMM or HHMMSS, 0000 to 235959 UTC.`);\n258\t\n259\t  const freq = str(p.freq, \"freq\");\n260\t  if (qslMHzToHz(freq) === null) fail(\"freq\", `${JSON.stringify(freq)} is not a frequency in MHz: digits with up to 6 decimals, e.g. \"14.074\".`);\n261\t  const band = qslBandOf(freq);\n262\t  if (band === null) fail(\"freq\", `${freq} MHz is in no amateur band of the ADIF 3.1.6 band table, so the card cannot name its BAND.`);\n263\t\n264\t  const mode = str(p.mode, \"mode\").toUpperCase();\n265\t  if (!/^[A-Z0-9-]{1,8}$/.test(mode)) fail(\"mode\", `${JSON.stringify(mode)} must be 1-8 characters of A-Z, 0-9 and -.`);\n266\t  const rst = str(p.rstSent, \"rstSent\");\n267\t  if (!/^[1-5][1-9][1-9]?$/.test(rst) && !/^[+-]\\d{1,2}$/.test(rst)) fail(\"rstSent\", `${JSON.stringify(rst)} is not a report: RS or RST digits (\"59\", \"599\") or signed dB (\"-12\", \"+05\").`);\n268\t\n269\t  const gridRaw = str(p.myGridsquare, \"myGridsquare\");\n270\t  const grid = gridRaw === \"\" ? \"\" : qslGrid(gridRaw);\n271\t  if (grid === null) fail(\"myGridsquare\", `${JSON.stringify(gridRaw)} is not a Maidenhead locator: 4, 6 or 8 characters like \"EN34\", \"EN34lw\" (fields A-R, subsquares a-x).`);\n272\t  const qth = printable(p.qth, \"qth\", 32);\n273\t  const pota = str(p.myPotaRef, \"myPotaRef\").toUpperCase();\n274\t  if (pota !== \"\" && !/^[A-Z0-9]{1,4}-\\d{4,5}(@[A-Z0-9-]{2,6})?$/.test(pota)) fail(\"myPotaRef\", `${JSON.stringify(pota)} is not a POTA reference: \"US-1234\", \"K-12345\" or \"GB-0001@GB-ENG\".`);\n275\t  const qslMsg = printable(p.qslMsg, \"qslMsg\", 40);\n276\t  const accent = str(p.accentColor, \"accentColor\");\n277\t  if (!/^#[0-9a-fA-F]{6}$/.test(accent)) fail(\"accentColor\", `${JSON.stringify(accent)} must be #rrggbb.`);\n278\t  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n279\t\n280\t  return {\n281\t    stationCallsign, call, date, time, freq, band, mode, rst, grid, qth, pota, qslMsg,\n282\t    accent: accent.toLowerCase() as MosaicColor, debugLayout: p.debugLayout,\n283\t  };\n284\t}\n285\t\n286\t/* ── colour ── */\n287\t\n288\tfunction qslMix(a: string, b: string, t: number): MosaicColor {\n289\t  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n290\t  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * t));\n291\t  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n292\t}\n293\tfunction qslLuminance(hex: string): number {\n294\t  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n295\t  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n296\t}\n297\t/** The readable ink on the accent tag: the paper or the navy, whichever contrasts more with the caller's accent. */\n298\tfunction qslOnColor(fill: string): MosaicColor {\n299\t  const ratio = (other: string) => { const a = qslLuminance(fill), b = qslLuminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n300\t  return (ratio(INK) >= ratio(PAPER) ? INK : PAPER) as MosaicColor;\n301\t}\n302\t\n303\t/* ── geometry ── */\n304\t\n305\texport type QslRect = { x: number; y: number; w: number; h: number };\n306\ttype Bind = Exclude<keyof QslCardProps, \"debugLayout\"> | null;\n307\ttype Cell = { label: string; rect: QslRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\n308\ttype Tile = { label: string; rect: QslRect; color: MosaicColor; radius: number; bind?: \"accentColor\" };\n309\t\n310\t/** The cell width a line needs at `px` under the fit rule (`cell * 0.94 - 2px`). */\n311\tfunction need(text: string, px: number, bold: boolean): number {\n312\t  return Math.ceil((widthOf(text, px, bold) + 2) / 0.94) + 1;\n313\t}\n314\t/** The largest whole size up to `maxPx` at which `widthAt(px)` is at most `room`. */\n315\tfunction largest(maxPx: number, room: number, widthAt: (px: number) => number): number {\n316\t  let px = Math.max(1, Math.round(maxPx));\n317\t  while (px > 1 && widthAt(px) > room) px--;\n318\t  return px;\n319\t}\n320\t/** One line in a cell: the largest size up to `maxPx` that fits the cell's budget. */\n321\tfunction fitPx(line: string, cellW: number, maxPx: number, bold: boolean): number {\n322\t  const top = Math.max(1, Math.round(maxPx)), room = budget(cellW), w = widthOf(line, top, bold);\n323\t  let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n324\t  while (px > 1 && widthOf(line, px, bold) > room) px--;\n325\t  return px;\n326\t}\n327\t\n328\t/** The six cells of the QSO table, in reading order. */\n329\texport const QSL_COLUMNS = [\"date\", \"utc\", \"mhz\", \"band\", \"mode\", \"rst\"] as const;\n330\tconst COLUMN_LABEL: Record<(typeof QSL_COLUMNS)[number], string> = { date: \"DATE\", utc: \"UTC\", mhz: \"MHz\", band: \"BAND\", mode: \"MODE\", rst: \"RST\" };\n331\tconst CONFIRM = \"CONFIRMING OUR QSO\";\n332\tconst MARK = \"ADIF QSO CARD\";\n333\t\n334\t/** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\n335\texport function layoutQslCard(props: QslCardProps, W: number, H: number) {\n336\t  const p = normalizeQslCard(props);\n337\t  const S = Math.min(W, H), aspect = W / H;\n338\t  // The table reflows by aspect first; type shrinks only after that.\n339\t  const shape: \"wide\" | \"square\" | \"tall\" = aspect >= 1.25 ? \"wide\" : aspect >= 0.8 ? \"square\" : \"tall\";\n340\t  const grid = shape === \"wide\" ? { rows: 1, cols: 6 } : shape === \"square\" ? { rows: 2, cols: 3 } : { rows: 3, cols: 2 };\n341\t  const floor = Math.max(1, Math.round((S * 10) / 270));\n342\t  const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} above the ${floor}px readability floor: shorten it or render a larger canvas.`);\n343\t\n344\t  const barH = Math.max(2, Math.round(S * 0.022));\n345\t  const m = Math.round(S * 0.065), CW = W - 2 * m;\n346\t  const top = barH + Math.round(S * 0.045), bottom = H - Math.round(S * 0.05), CH = bottom - top;\n347\t  const gap = Math.round(S * 0.03);\n348\t  const rule = Math.max(1, Math.round(S / 400));\n349\t  const ruleColor = qslMix(PAPER, INK, 0.28);\n350\t  const fr = { wide: [0.4, 0.15, 0.31], square: [0.33, 0.19, 0.36], tall: [0.28, 0.17, 0.47] }[shape];\n351\t  const hh = Math.round(CH * fr[0]), sh = Math.round(CH * fr[1]), th = Math.round(CH * fr[2]), fh = CH - hh - sh - th;\n352\t  const headY = top, stripY = headY + hh, tableY = stripY + sh, footY = tableY + th;\n353\t\n354\t  const cells: Cell[] = [];\n355\t  const tiles: Tile[] = [];\n356\t  const line = (label: string, rect: QslRect, text: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string } = {}) => {\n357\t    if (px < floor) unfit(o.field ?? label);\n358\t    cells.push({ label, rect, text, px, width: widthOf(text, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? (INK as MosaicColor), bind: o.bind ?? null, over: o.over === true });\n359\t  };\n360\t\n361\t  tiles.push({ label: \"accent-bar\", rect: { x: 0, y: 0, w: W, h: barH }, color: p.accent, radius: 0, bind: \"accentColor\" });\n362\t\n363\t  // ── header: the station call, sized from its own text, and the station block ──\n364\t  type StationLine = { label: string; value: string; tag?: string; bind: Bind };\n365\t  const station: StationLine[] = [];\n366\t  if (p.grid !== \"\") station.push({ label: \"station-grid\", tag: \"GRID\", value: p.grid, bind: \"myGridsquare\" });\n367\t  if (p.qth !== \"\") station.push({ label: \"station-qth\", value: p.qth, bind: \"qth\" });\n368\t  if (p.pota !== \"\") station.push({ label: \"station-pota\", tag: \"POTA\", value: p.pota, bind: \"myPotaRef\" });\n369\t  const tagGap = (px: number) => Math.round(px * 0.3);\n370\t  const lineNeed = (l: StationLine, px: number) => need(l.value, px, false) + (l.tag ? need(l.tag, px, false) + tagGap(px) : 0);\n371\t  /** One station line drawn right- or left-aligned from `edge`: the tag in the dim ink, the value in the ink. */\n372\t  const stationLine = (l: StationLine, y: number, h: number, px: number, edge: number, align: \"left\" | \"right\") => {\n373\t    const vw = need(l.value, px, false), tw = l.tag ? need(l.tag, px, false) : 0;\n374\t    const valueX = align === \"right\" ? edge - vw : edge + (l.tag ? tw + tagGap(px) : 0);\n375\t    if (l.tag) line(`${l.label}-tag`, { x: align === \"right\" ? valueX - tagGap(px) - tw : edge, y, w: tw, h }, l.tag, px, { align, color: DIM as MosaicColor, field: l.bind as string });\n376\t    line(l.label, { x: valueX, y, w: vw, h }, l.value, px, { align, bind: l.bind, field: l.bind as string });\n377\t  };\n378\t\n379\t  let callPx: number;\n380\t  if (shape === \"wide\") {\n381\t    // The call takes the left, the station block the right as right-aligned\n382\t    // lines; the block takes what its longest line needs (28-50% of the width).\n383\t    const lineTop = Math.max(floor, Math.min(Math.round(hh * 0.13), Math.round(S * 0.05))), lineH = Math.max(Math.round(hh * 0.21), Math.ceil(lineTop / 0.62));\n384\t    const stationW = station.length === 0 ? 0\n385\t      : Math.max(Math.round(CW * 0.28), Math.min(Math.round(CW * 0.5), Math.max(...station.map((l) => lineNeed(l, lineTop)))));\n386\t    const linePx = Math.min(lineTop, ...station.map((l) => largest(lineTop, stationW, (px) => lineNeed(l, px))));\n387\t    const callW = station.length === 0 ? CW : CW - stationW - gap;\n388\t    callPx = fitPx(p.stationCallsign, callW, hh * 0.72, true);\n389\t    line(\"callsign\", { x: m, y: headY, w: callW, h: hh }, p.stationCallsign, callPx, { bold: true, bind: \"stationCallsign\", field: \"stationCallsign\" });\n390\t    const y0 = headY + Math.round((hh - station.length * lineH) / 2);\n391\t    station.forEach((l, i) => stationLine(l, y0 + i * lineH, lineH, linePx, m + CW, \"right\"));\n392\t  } else {\n393\t    // The call spans the width; the QTH and then GRID + POTA sit under it on one or two lines.\n394\t    const rows: StationLine[][] = [];\n395\t    if (p.qth !== \"\") rows.push(station.filter((l) => l.label === \"station-qth\"));\n396\t    const tagged = station.filter((l) => l.tag);\n397\t    if (tagged.length > 0) rows.push(tagged);\n398\t    const lineTop = Math.max(floor, Math.min(Math.round(hh * 0.1), Math.round(S * 0.05))), lineH = Math.ceil(lineTop / 0.62);\n399\t    const rowNeed = (row: StationLine[], px: number) => row.reduce((sum, l) => sum + lineNeed(l, px), 0) + (row.length - 1) * gap * 2;\n400\t    const linePx = Math.min(lineTop, ...rows.map((row) => largest(lineTop, CW, (px) => rowNeed(row, px))));\n401\t    const callMaxH = hh - rows.length * lineH;\n402\t    callPx = fitPx(p.stationCallsign, CW, callMaxH * 0.72, true);\n403\t    const callH = Math.min(callMaxH, Math.ceil(callPx / 0.72));\n404\t    const y0 = headY + Math.round((hh - callH - rows.length * lineH) / 2);\n405\t    line(\"callsign\", { x: m, y: y0, w: CW, h: callH }, p.stationCallsign, callPx, { bold: true, bind: \"stationCallsign\", field: \"stationCallsign\" });\n406\t    rows.forEach((row, r) => {\n407\t      let x = m;\n408\t      for (const l of row) { stationLine(l, y0 + callH + r * lineH, lineH, linePx, x, \"left\"); x += lineNeed(l, linePx) + gap * 2; }\n409\t    });\n410\t  }\n411\t\n412\t  // ── to-radio strip: the TO RADIO tag, the worked call (second largest), the confirmation ──\n413\t  tiles.push({ label: \"rule-head\", rect: { x: m, y: stripY, w: CW, h: rule }, color: ruleColor, radius: 0 });\n414\t  const tagPxOf = (px: number) => Math.max(floor, Math.round(px * 0.4));\n415\t  const chipPad = (tagPx: number) => Math.round(tagPx * 0.55);\n416\t  const chipW = (tagPx: number) => need(\"TO RADIO\", tagPx, true) + 2 * chipPad(tagPx);\n417\t  const workedCap = Math.round(callPx * 0.62);\n418\t  const oneLineTop = Math.min(Math.round((sh - rule) * 0.5), workedCap);\n419\t  const oneLineW = (px: number) => chipW(tagPxOf(px)) + gap + need(p.call, px, true) + gap + need(CONFIRM, tagPxOf(px), false);\n420\t  const oneLinePx = largest(oneLineTop, CW, oneLineW);\n421\t  const twoLines = shape !== \"wide\" && oneLinePx < oneLineTop * 0.85;\n422\t  let workedPx: number;\n423\t  {\n424\t    const y = stripY + rule;\n425\t    const h2Min = twoLines ? Math.max(Math.round((sh - rule) * 0.4), Math.ceil(floor / 0.6)) : 0;\n426\t    const h1 = sh - rule - h2Min;\n427\t    workedPx = twoLines ? largest(Math.min(Math.round(h1 * 0.62), workedCap), CW, (px) => chipW(tagPxOf(px)) + gap + need(p.call, px, true)) : oneLinePx;\n428\t    const tagPx = tagPxOf(workedPx);\n429\t    const cw = chipW(tagPx), chipH = Math.round(tagPx * 1.9);\n430\t    const chip: QslRect = { x: m, y: y + Math.round((h1 - chipH) / 2), w: cw, h: chipH };\n431\t    tiles.push({ label: \"to-radio-chip\", rect: chip, color: p.accent, radius: 0.18 });\n432\t    line(\"to-radio\", chip, \"TO RADIO\", tagPx, { bold: true, align: \"center\", color: qslOnColor(p.accent), over: true, field: \"the TO RADIO tag\" });\n433\t    const wx = m + cw + gap;\n434\t    line(\"worked-call\", { x: wx, y, w: need(p.call, workedPx, true), h: h1 }, p.call, workedPx, { bold: true, bind: \"call\", field: \"call\" });\n435\t    if (twoLines) {\n436\t      const h2 = h2Min, cpx = Math.min(tagPx, fitPx(CONFIRM, CW, h2 * 0.6, false));\n437\t      line(\"confirm\", { x: m, y: y + h1, w: need(CONFIRM, cpx, false), h: h2 }, CONFIRM, cpx, { color: DIM as MosaicColor, field: \"the confirmation line\" });\n438\t    } else {\n439\t      const cw2 = need(CONFIRM, tagPx, false);\n440\t      line(\"confirm\", { x: m + CW - cw2, y, w: cw2, h: h1 }, CONFIRM, tagPx, { align: \"right\", color: DIM as MosaicColor, field: \"the confirmation line\" });\n441\t    }\n442\t  }\n443\t\n444\t  // ── the QSO table: a label over a value per cell, columns weighted by what they hold ──\n445\t  const values: Record<(typeof QSL_COLUMNS)[number], { text: string; bind: Bind }> = {\n446\t    date: { text: p.date, bind: \"qsoDate\" }, utc: { text: p.time, bind: \"timeOn\" }, mhz: { text: p.freq, bind: \"freq\" },\n447\t    // BAND is derived from FREQ, so nothing binds it.\n448\t    band: { text: p.band, bind: null }, mode: { text: p.mode, bind: \"mode\" }, rst: { text: p.rst, bind: \"rstSent\" },\n449\t  };\n450\t  // The table starts a little below the strip, so its first label never reads as part of the line above.\n451\t  const tablePad = Math.round(S * 0.02), rowH = Math.floor((th - tablePad) / grid.rows);\n452\t  const labelH = Math.round(rowH * 0.3), accentRule = Math.max(1, Math.round(S / 300));\n453\t  const valueH = rowH - labelH - accentRule - Math.round(rowH * 0.06);\n454\t  const colGap = Math.round(S * 0.035);\n455\t  const cellsAt = (c: number) => QSL_COLUMNS.filter((_, i) => i % grid.cols === c);\n456\t  // Hierarchy: the station call is at least twice a table value, the worked call at least one.\n457\t  const valueTop = Math.min(Math.round(valueH * 0.7), Math.floor(callPx / 2), workedPx, Math.round(S * 0.11));\n458\t  const labelPxOf = (px: number) => Math.max(floor, Math.min(Math.round(labelH * 0.6), Math.round(px * 0.5)));\n459\t  const colNeed = (px: number) => Array.from({ length: grid.cols }, (_, c) =>\n460\t    Math.max(...cellsAt(c).map((k) => Math.max(need(values[k].text, px, true), need(COLUMN_LABEL[k], labelPxOf(px), false)))));\n461\t  const valuePx = largest(valueTop, CW, (px) => colNeed(px).reduce((a, b) => a + b, 0) + (grid.cols - 1) * colGap);\n462\t  if (valuePx < floor) unfit(\"the QSO table\");\n463\t  const labelPx = labelPxOf(valuePx);\n464\t  const needs = colNeed(valuePx), sumNeed = needs.reduce((a, b) => a + b, 0);\n465\t  const spare = CW - sumNeed - (grid.cols - 1) * colGap;\n466\t  const colX: number[] = [], colW: number[] = [];\n467\t  let x = m;\n468\t  needs.forEach((n, c) => {\n469\t    // The spare width is shared equally, so the gutters read as one rhythm; the content weights the rest.\n470\t    const w = c === grid.cols - 1 ? m + CW - x : n + Math.floor(spare / grid.cols);\n471\t    colX.push(x); colW.push(w); x += w + colGap;\n472\t  });\n473\t  for (let r = 0; r < grid.rows; r++) {\n474\t    const ry = tableY + tablePad + r * rowH;\n475\t    tiles.push({ label: `label-rule-${r}`, rect: { x: m, y: ry + labelH, w: CW, h: accentRule }, color: p.accent, radius: 0 });\n476\t  }\n477\t  QSL_COLUMNS.forEach((k, i) => {\n478\t    const r = Math.floor(i / grid.cols), c = i % grid.cols, ry = tableY + tablePad + r * rowH;\n479\t    line(`col-label-${k}`, { x: colX[c], y: ry, w: colW[c], h: labelH }, COLUMN_LABEL[k], labelPx, { color: DIM as MosaicColor, field: \"the QSO table labels\" });\n480\t    line(`col-value-${k}`, { x: colX[c], y: ry + labelH + accentRule, w: colW[c], h: valueH }, values[k].text, valuePx, { bold: true, bind: values[k].bind, field: \"the QSO table\" });\n481\t  });\n482\t\n483\t  // ── footer: QSLMSG on the left, the card's small mark on the right (dropped when it costs fit) ──\n484\t  tiles.push({ label: \"rule-foot\", rect: { x: m, y: footY, w: CW, h: rule }, color: ruleColor, radius: 0 });\n485\t  const fy = footY + rule, fH = fh - rule;\n486\t  const footTop = Math.max(floor, Math.min(Math.round(fH * 0.42), Math.round(S * 0.045)));\n487\t  const markPx = Math.max(floor, Math.round(footTop * 0.75));\n488\t  const markW = need(MARK, markPx, false);\n489\t  let showMark = true, msgPx = footTop;\n490\t  if (p.qslMsg !== \"\") {\n491\t    msgPx = fitPx(p.qslMsg, CW - markW - gap, footTop, false);\n492\t    if (msgPx < footTop * 0.85) { showMark = false; msgPx = fitPx(p.qslMsg, CW, footTop, false); }\n493\t    line(\"qslmsg\", { x: m, y: fy, w: need(p.qslMsg, msgPx, false), h: fH }, p.qslMsg, msgPx, { bind: \"qslMsg\", field: \"qslMsg\" });\n494\t  }\n495\t  if (showMark) line(\"mark\", { x: m + CW - markW, y: fy, w: markW, h: fH }, MARK, markPx, { align: \"right\", color: DIM as MosaicColor, field: \"the card mark\" });\n496\t\n497\t  return { p, shape, grid, floor, cells, tiles, callPx, workedPx, valuePx, labelPx, twoLines, showMark, bands: { headY, stripY, tableY, footY, bottom } };\n498\t}\n499\t\n500\t/**\n501\t * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n502\t * convention, src/_shared/why.ts): the run, the problem with the sources the\n503\t * agent opened, the solution, how to use it, then the template itself.\n504\t */\n505\tconst WHY: WhySpec = {\n506\t  \"day\": 14,\n507\t  \"date\": \"2026-10-03\",\n508\t  \"agent\": \"claude\",\n509\t  \"model\": \"claude-opus-5-5\",\n510\t  \"id\": \"@one-a-day/community/qsl-card/v1\",\n511\t  \"title\": \"Ham Radio QSL Card\",\n512\t  \"who\": \"Ham radio operators who owe every station they worked a QSL card, gathered around their loggers (World Radio League, Wavelog, Log4OM) and POTA activators.\",\n513\t  \"problem\": [\n514\t    \"The World Radio League forum thread \\\"QSL Card Generator\\\" opens (57 likes) asking to \\\"select a template ... the appropriate information (other callsign/band/frequency/mode/time/report/etc.) would be auto populated ... a PNG or JPEG could be saved off\\\". A new licensee replies: \\\"struggling with putting together a card\\\".\",\n515\t    \"It is a batch job: \\\"Auto QSL Card\\\" asks for a card \\\"to all contacts made that day ... if I'm on a camping trip for 8 days\\\", and page 2 posts a Pillow script drawing text at hand-picked (x, y) points. Wavelog, DigiQSL and S53ZO's label tool take ADIF in, but none renders an image per QSO from a command line.\"\n516\t  ],\n517\t  \"sources\": [\n518\t    \"https://community.worldradioleague.com/t/qsl-card-generator/13739\",\n519\t    \"https://community.worldradioleague.com/t/qsl-card-generator/13739?page=2\",\n520\t    \"https://community.worldradioleague.com/t/auto-qsl-card/\",\n521\t    \"https://www.adif.org/316/ADIF_316.htm\",\n522\t    \"https://github.com/s53zo/ADIF-to-QSL-label\",\n523\t    \"https://cq.sk/en/adif-to-qsl-label/\",\n524\t    \"https://docs.wavelog.org/user-guide/qsl/qsl-postcard-designer/\",\n525\t    \"https://digiqsl.com/features\",\n526\t    \"https://amateurradio.com/qsling-made-easy\"\n527\t  ],\n528\t  \"solution\": [\n529\t    \"One card per QSO from one ADIF record. The props are the ADIF fields in camelCase, in ADIF formats (qsoDate \\\"20261003\\\", timeOn \\\"1432\\\", freq \\\"14.074\\\"), printed the QSL way: 03 OCT 2026, 14:32. BAND is not a prop: it is derived from FREQ with the ADIF 3.1.6 band table, so the two never disagree.\",\n530\t    \"The decision that matters: a callsign is never ellipsized. The call is sized from its own text, the QSO table reflows 6x1, 3x2 or 2x3 by aspect before any type shrinks, and copy that cannot fit above the floor is refused with an error naming the prop. No photo background in v1: paper, one accent and type.\"\n531\t  ],\n532\t  \"usage\": {\n533\t    \"command\": \"m0saic make @one-a-day/community/qsl-card/v1 --template-repo . -w 1920 -h 1080 --props '{\\\"call\\\":\\\"DL1ABC\\\",\\\"freq\\\":\\\"7.074\\\",\\\"timeOn\\\":\\\"0915\\\"}' -o qsl-DL1ABC.png\",\n534\t    \"try\": [\n535\t      \"--props @qso.json, one file per ADIF record: a loop over the log writes one card per QSO\",\n536\t      \"-w 1650 -h 1050: the 5.5 x 3.5 in card at 300 dpi; -w 1080 -h 1080 or -h 1920 reflow the table to 3x2 or 2x3\",\n537\t      \"freq \\\"432.100\\\" prints BAND 70cm; freq \\\"27.185\\\" (CB) is refused: it is in no amateur band\",\n538\t      \"myPotaRef \\\"\\\", myGridsquare \\\"\\\": the lines and their prefixes go; accentColor \\\"#1f5fa8\\\" for a blue card\"\n539\t    ]\n540\t  },\n541\t  \"timeline\": {\n542\t    \"source\": \"runner\",\n543\t    \"phases\": [\n544\t      {\n545\t        \"name\": \"scout\",\n546\t        \"startMs\": 0,\n547\t        \"durMs\": 187402,\n548\t        \"calls\": 29,\n549\t        \"tokens\": 2732923,\n550\t        \"costUsd\": 1.3,\n551\t        \"tools\": \"Bash 16, WebSearch 11, ToolSearch 1\"\n552\t      },\n553\t      {\n554\t        \"name\": \"plan\",\n555\t        \"startMs\": 187417,\n556\t        \"durMs\": 235946,\n557\t        \"calls\": 7,\n558\t        \"tokens\": 650247,\n559\t        \"costUsd\": 0.73,\n560\t        \"tools\": \"Bash 6, Write 1\"\n561\t      },\n562\t      {\n563\t        \"name\": \"build\",\n564\t        \"startMs\": 423392,\n565\t        \"durMs\": 1207648,\n566\t        \"calls\": 64,\n567\t        \"tokens\": 16253730,\n568\t        \"costUsd\": 4.48,\n569\t        \"tools\": \"Bash 42, Read 19, Write 3\"\n570\t      },\n571\t      {\n572\t        \"name\": \"critique\",\n573\t        \"startMs\": 1631053,\n574\t        \"durMs\": 272372,\n575\t        \"calls\": 44,\n576\t        \"tokens\": 7128751,\n577\t        \"costUsd\": 2.05,\n578\t        \"tools\": \"Bash 22, Read 21, Write 1\"\n579\t      }\n580\t    ],\n581\t    \"costBasis\": \"reported\"\n582\t  },\n583\t  \"caveats\": [\n584\t    \"No photo background in v1: the card is paper, one accent colour and type. Shack and park photos, the usual QSL face, are a later version.\",\n585\t    \"One QSO per card. It reads no .adi file: your script maps each ADIF record to the props and calls m0saic make once per QSO.\",\n586\t    \"RST_RCVD, QSL_VIA and the rig are not printed. BAND is always derived from FREQ, so a log whose BAND disagrees with its FREQ shows the FREQ band.\"\n587\t  ]\n588\t};\n589\t\n590\texport const QslCardV1 = defineMosaicTemplate<QslCardProps>({\n591\t  id: asTemplateId(ID),\n592\t  label: \"2026-10-03 · Ham Radio QSL Card\",\n593\t  version: 1,\n594\t  description: \"A ham radio QSL card for one contact, from one ADIF log record: props named after the ADIF fields, the date and time printed the QSL way, BAND derived from FREQ. Paper and type only, no photo background in v1.\",\n595\t  capabilities: { tier: \"core\" },\n596\t  tags: [\"community\",\"2026-10-03\",\"day-014\", \"ham-radio\", \"qsl\", \"adif\", \"card\"],\n597\t\n598\t  outputHints: {\n599\t    width: 1920,\n600\t    height: 1080,\n601\t    fps: 30,\n602\t    durationMs: 2000,\n603\t    format: { kind: \"image\", container: \"png\" },\n604\t    note: \"Still PNG, one card per QSO. The physical card is 5.5 x 3.5 in (1650x1050 at 300 dpi); portrait and square reflow the QSO table to 2x3 and 3x2. Minimum tested canvas 480x270.\",\n605\t  },\n606\t\n607\t  propsSchema,\n608\t  defaultProps: DEFAULTS,\n609\t\n610\t  render,\n611\t  renderTutorial: whyTutorial(WHY, render),\n612\t});\n613\t\n614\texport default QslCardV1;\n615\t\n616\tasync function render(props: QslCardProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n617\t  const { width: W, height: H } = ctx.target;\n618\t  const L = layoutQslCard(props, W, H);\n619\t  const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n620\t  const constraints: LayoutConstraint[] = [];\n621\t\n622\t  for (const t of L.tiles) {\n623\t    const tile = tag({ ...makeColorTile(t.color, t.radius > 0 ? { effects: { rounding: { cornerStyle: \"rounded\", borderRadius: t.radius } } } : {}) } as MosaicSource, t.label);\n624\t    // The accent bar is the rect that shows `accentColor`.\n625\t    pieces.push({ rect: { ...t.rect, importance: 1 }, source: t.bind ? bindProp(tile, t.bind) : tile });\n626\t  }\n627\t  for (const c of L.cells) {\n628\t    const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n629\t    // A text rect is BOUND to the prop it shows; derived copy (BAND, the labels, the chrome) is not.\n630\t    pieces.push({ rect: { ...c.rect, importance: c.over ? 3 : 2 }, source: c.bind === null ? cell : bindProp(cell, c.bind) });\n631\t    constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n632\t  }\n633\t\n634\t  // What the geometry promises: every text fits (above); the call in the top\n635\t  // half; all six QSO values present and in the table band; the footer at the\n636\t  // bottom; the accent bar across the card.\n637\t  constraints.push({ label: \"callsign\", within: { yFrac: [0, 0.5] } });\n638\t  for (const k of [\"date\", \"utc\", \"mhz\", \"band\", \"mode\", \"rst\"]) constraints.push({ label: `col-value-${k}`, within: { yFrac: [0.3, 0.92] } });\n639\t  if (L.cells.some((c) => c.label === \"qslmsg\")) constraints.push({ label: \"qslmsg\", within: { yFrac: [0.6, 1] } });\n640\t  constraints.push({ label: \"accent-bar\", minWidthFrac: 0.98 });\n641\t  constraints.push({ label: \"worked-call\" });\n642\t\n643\t  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n644\t  const doc: MosaicDocument = {\n645\t    kind: \"mosaic_document\",\n646\t    version: 1,\n647\t    m0: toM0String(placed.m0, ID),\n648\t    assets: {},\n649\t    backgroundColor: PAPER as MosaicColor,\n650\t    sources: placed.sources,\n651\t  };\n652\t  return withLayoutIntent(doc, ctx, { templateId: ID, constraints, debug: props.debugLayout === true });\n653\t}\n654\t"}]},"parent_tool_use_id":null,"session_id":"5aa0f356-0a54-4ead-ae70-b6948b14086a","uuid":"8a9ebbcc-3884-448a-b6ef-04cf286bf8ba","timestamp":"2026-10-06T16:10:49.632Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\MainDesktop\\.claude\\projects\\C--src-m0saic-production-one-a-day\\5aa0f356-0a54-4ead-ae70-b6948b14086a\\tool-results\\bn4dhazu0.txt","content":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/community/qsl-card/v1` - a ham radio QSL card for ONE contact,\n * rendered from the fields of one ADIF log record, so a script can loop over\n * a whole log and write one card per QSO.\n *\n * ONE CONCEPT: the props ARE the log record. Each prop is an ADIF field in\n * camelCase taking the ADIF format (QSO_DATE \"20261003\", TIME_ON \"1432\",\n * FREQ \"14.074\" in MHz), and the card prints it the way a QSL does\n * (\"03 OCT 2026\", \"14:32\"). BAND is not a prop: it is DERIVED from FREQ with\n * the ADIF 3.1.6 band enumeration, so the two can never disagree on a card.\n *\n * The rule that bites: a callsign is never ellipsized. A card with half a\n * call on it confirms nothing. The station call is sized from its own text\n * (a short K1A is limited by the band's height, a long VP2V/G4ABC by its\n * width), the QSO table reflows by aspect (6x1, 3x2, 2x3) before any type\n * shrinks, the table values shrink before the call drops below twice their\n * size, and copy that cannot fit above the readability floor (10/270 of\n * the short side) is refused with an error that names the prop.\n */\n\nexport type QslCardProps = {\n  /** STATION_CALLSIGN: the sender, the biggest thing on the card. */\n  stationCallsign?: string;\n  /** CALL: the station worked - \"TO RADIO <call>\". */\n  call?: string;\n  /** QSO_DATE as YYYYMMDD (UTC). */\n  qsoDate?: string;\n  /** TIME_ON as HHMM or HHMMSS (UTC). */\n  timeOn?: string;\n  /** FREQ in MHz, printed as given; BAND is derived from it. */\n  freq?: string;\n  /** MODE (or SUBMODE), printed as the log says it. */\n  mode?: string;\n  /** RST_SENT: \"59\", \"599\" or a signed dB report (\"-12\"). */\n  rstSent?: string;\n  /** MY_GRIDSQUARE: 4, 6 or 8 character Maidenhead; \"\" hides the line. */\n  myGridsquare?: string;\n  /** MY_CITY / MY_STATE as one line; \"\" hides it. */\n  qth?: string;\n  /** MY_POTA_REF: a Parks on the Air reference; \"\" hides it. */\n  myPotaRef?: string;\n  /** QSLMSG: the footer line; \"\" hides it. */\n  qslMsg?: string;\n  /** The one accent: top bar, label rules, TO RADIO tag. */\n  accentColor?: string;\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/community/qsl-card/v1\";\n/** The face: document.backgroundColor, never a full-canvas rect (doctor: canvasFill). */\nconst PAPER = \"#f4f1ea\";\nconst INK = \"#1b2a4a\";\nconst DIM = \"#66758c\";\nconst DEFAULT_ACCENT = \"#b3261e\";\n\n// Labelled examples, not anybody's log: N0CALL is the placeholder call ham\n// software ships with, W1AW the ARRL station its documentation uses, and the\n// grid EN34 sits in the 0 call district, so it agrees with N0CALL.\nconst DEFAULTS = {\n  stationCallsign: \"N0CALL\",\n  call: \"W1AW\",\n  qsoDate: \"20261003\",\n  timeOn: \"1432\",\n  freq: \"14.074\",\n  mode: \"FT8\",\n  rstSent: \"-12\",\n  myGridsquare: \"EN34\",\n  qth: \"Minneapolis, MN\",\n  myPotaRef: \"US-1234\",\n  qslMsg: \"TNX QSO 73\",\n  accentColor: DEFAULT_ACCENT,\n  debugLayout: false,\n};\n\nconst propsSchema = definePropsSchema<QslCardProps>({\n  stationCallsign: {\n    type: \"string\",\n    required: false,\n    description: \"STATION_CALLSIGN: your call, the biggest thing on the card. 3-13 characters of A-Z, 0-9 and /, with at least one digit (portable suffixes like /P are fine); upper-cased. Never ellipsized: a call that cannot fit the canvas is refused.\",\n    meta: { control: { placeholder: DEFAULTS.stationCallsign }, ui: { label: \"Station callsign\", order: 1, primary: true } },\n  },\n  call: {\n    type: \"string\",\n    required: false,\n    description: \"CALL: the station you worked, printed as TO RADIO <call>. Same rule as the station callsign.\",\n    meta: { control: { placeholder: DEFAULTS.call }, ui: { label: \"Worked call (CALL)\", order: 2, primary: true } },\n  },\n  qsoDate: {\n    type: \"string\",\n    required: false,\n    description: 'QSO_DATE as the log writes it, YYYYMMDD in UTC (1930 or later). Printed with the month spelled out, \"03 OCT 2026\", so it reads the same in the US and in Europe.',\n    meta: { control: { placeholder: DEFAULTS.qsoDate }, ui: { label: \"QSO date (YYYYMMDD)\", order: 3 } },\n  },\n  timeOn: {\n    type: \"string\",\n    required: false,\n    description: 'TIME_ON in UTC, HHMM or HHMMSS. Printed as 14:32 (or 14:32:05) under the UTC label.',\n    meta: { control: { placeholder: DEFAULTS.timeOn }, ui: { label: \"Time on (HHMM UTC)\", order: 4 } },\n  },\n  freq: {\n    type: \"string\",\n    required: false,\n    description: 'FREQ in MHz, e.g. \"14.074\" or \"1296.200\", printed as given (no rounding, up to 6 decimals). The BAND cell is derived from it with the ADIF 3.1.6 band table (14.074 -> 20m, 432.100 -> 70cm); a frequency outside every amateur band (27.185) is refused.',\n    meta: { control: { placeholder: DEFAULTS.freq }, ui: { label: \"Frequency (MHz)\", order: 5 } },\n  },\n  mode: {\n    type: \"string\",\n    required: false,\n    description: \"MODE or SUBMODE as the log says it (SSB, CW, FT8, FT4, RTTY...). 1-8 characters of A-Z, 0-9 and -, upper-cased; not checked against the ADIF mode list.\",\n    meta: { control: { placeholder: DEFAULTS.mode }, ui: { label: \"Mode\", order: 6 } },\n  },\n  rstSent: {\n    type: \"string\",\n    required: false,\n    description: 'RST_SENT: the report you gave, RS or RST digits (\"59\", \"599\") or a signed dB report (\"-12\", \"+05\").',\n    meta: { control: { placeholder: DEFAULTS.rstSent }, ui: { label: \"Report sent (RST)\", order: 7 } },\n  },\n  myGridsquare: {\n    type: \"string\",\n    required: false,\n    description: 'MY_GRIDSQUARE: 4, 6 or 8 character Maidenhead locator, printed in canonical case (\"EN34lw\"). Empty removes the GRID line.',\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"My grid square\", order: 8 } },\n  },\n  qth: {\n    type: \"string\",\n    required: false,\n    description: \"Your QTH (MY_CITY / MY_STATE as one line), up to 32 characters of printable ASCII. Empty removes the line.\",\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"QTH\", order: 9 } },\n  },\n  myPotaRef: {\n    type: \"string\",\n    required: false,\n    description: 'MY_POTA_REF: a Parks on the Air reference (\"US-1234\", \"K-12345\", \"GB-0001@GB-ENG\"). Empty removes the POTA line - most cards are not from a park.',\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"My POTA ref\", order: 10 } },\n  },\n  qslMsg: {\n    type: \"string\",\n    required: false,\n    description: \"QSLMSG: the footer line, up to 40 characters of printable ASCII. Empty removes it.\",\n    meta: { control: { placeholder: \"none\" }, ui: { label: \"QSL message\", order: 11 } },\n  },\n  accentColor: {\n    type: \"string\",\n    required: false,\n    description: \"The one accent, as #rrggbb: the bar along the top, the rules under the table labels and the TO RADIO tag.\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 12 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits its box, the call sits in the top half, the QSO table is complete, the accent bar spans the card) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n/* ── the ADIF record: pure, exported, and what the test asserts ── */\n\nfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n\n/** An ADIF Number in MHz -> integer Hz; null when it is not one (more than 6 decimals is not one here). */\nexport function qslMHzToHz(text: string): number | null {\n  const m = /^(\\d{0,7})(?:\\.(\\d{1,6}))?$/.exec(text);\n  if (!m || (m[1] === \"\" && m[2] === undefined)) return null;\n  return Number(m[1] || \"0\") * 1_000_000 + Number((m[2] ?? \"\").padEnd(6, \"0\"));\n}\n\n/** The ADIF 3.1.6 Band enumeration (section III.B.4), lower and upper edge in MHz, both inclusive. */\nconst ADIF_BANDS: ReadonlyArray<readonly [string, string, string]> = [\n  [\"2190m\", \".1357\", \".1378\"], [\"630m\", \".472\", \".479\"], [\"560m\", \".501\", \".504\"],\n  [\"160m\", \"1.8\", \"2.0\"], [\"80m\", \"3.5\", \"4.0\"], [\"60m\", \"5.06\", \"5.45\"], [\"40m\", \"7.0\", \"7.3\"],\n  [\"30m\", \"10.1\", \"10.15\"], [\"20m\", \"14.0\", \"14.35\"], [\"17m\", \"18.068\", \"18.168\"], [\"15m\", \"21.0\", \"21.45\"],\n  [\"12m\", \"24.890\", \"24.99\"], [\"10m\", \"28.0\", \"29.7\"], [\"8m\", \"40\", \"45\"], [\"6m\", \"50\", \"54\"],\n  [\"5m\", \"54.000001\", \"69.9\"], [\"4m\", \"70\", \"71\"], [\"2m\", \"144\", \"148\"], [\"1.25m\", \"222\", \"225\"],\n  [\"70cm\", \"420\", \"450\"], [\"33cm\", \"902\", \"928\"], [\"23cm\", \"1240\", \"1300\"], [\"13cm\", \"2300\", \"2450\"],\n  [\"9cm\", \"3300\", \"3500\"], [\"6cm\", \"5650\", \"5925\"], [\"3cm\", \"10000\", \"10500\"], [\"1.25cm\", \"24000\", \"24250\"],\n  [\"6mm\", \"47000\", \"47200\"], [\"4mm\", \"75500\", \"81000\"], [\"2.5mm\", \"119980\", \"123000\"], [\"2mm\", \"134000\", \"149000\"],\n  [\"1mm\", \"241000\", \"250000\"], [\"submm\", \"300000\", \"7500000\"],\n];\nconst BAND_HZ = ADIF_BANDS.map(([band, lo, hi]) => ({ band, lo: qslMHzToHz(lo) as number, hi: qslMHzToHz(hi) as number }));\n\n/** FREQ (MHz text) -> the ADIF band name, or null when the frequency is in no amateur band. Integer Hz, no floats. */\nexport function qslBandOf(freq: string): string | null {\n  const hz = qslMHzToHz(freq);\n  if (hz === null) return null;\n  return BAND_HZ.find((b) => hz >= b.lo && hz <= b.hi)?.band ?? null;\n}\n\nconst MONTHS = [\"JAN\", \"FEB\", \"MAR\", \"APR\", \"MAY\", \"JUN\", \"JUL\", \"AUG\", \"SEP\", \"OCT\", \"NOV\", \"DEC\"];\n/** QSO_DATE \"20261003\" -> \"03 OCT 2026\"; null for anything that is not a calendar date from 1930 on (ADIF's floor). */\nexport function qslFormatDate(text: string): string | null {\n  const m = /^(\\d{4})(\\d{2})(\\d{2})$/.exec(text);\n  if (!m) return null;\n  const y = Number(m[1]), mo = Number(m[2]), d = Number(m[3]);\n  const leap = (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  if (y < 1930 || mo < 1 || mo > 12 || d < 1 || d > days[mo - 1]) return null;\n  return `${m[3]} ${MONTHS[mo - 1]} ${m[1]}`;\n}\n\n/** TIME_ON \"1432\" -> \"14:32\", \"143205\" -> \"14:32:05\"; null outside 00:00:00-23:59:59. */\nexport function qslFormatTime(text: string): string | null {\n  const m = /^(\\d{2})(\\d{2})(\\d{2})?$/.exec(text);\n  if (!m || Number(m[1]) > 23 || Number(m[2]) > 59 || (m[3] !== undefined && Number(m[3]) > 59)) return null;\n  return m[3] === undefined ? `${m[1]}:${m[2]}` : `${m[1]}:${m[2]}:${m[3]}`;\n}\n\n/** A Maidenhead locator (4, 6 or 8 characters) in canonical case - \"EN34lw55\" - or null. */\nexport function qslGrid(text: string): string | null {\n  const m = /^([A-R]{2})(\\d{2})(?:([A-X]{2})(\\d{2})?)?$/i.exec(text);\n  if (!m) return null;\n  return `${m[1].toUpperCase()}${m[2]}${(m[3] ?? \"\").toLowerCase()}${m[4] ?? \"\"}`;\n}\n\nfunction str(value: unknown, field: string): string {\n  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n  return value.trim();\n}\n\nfunction callsign(value: unknown, field: string): string {\n  const s = str(value, field).toUpperCase();\n  if (s === \"\") fail(field, \"must not be empty: a QSL card confirms a contact between two calls.\");\n  if (!/^[A-Z0-9/]{3,13}$/.test(s) || !/\\d/.test(s) || !/[A-Z]/.test(s) || /^\\/|\\/$|\\/\\//.test(s)) {\n    fail(field, `${JSON.stringify(s)} is not a callsign: 3-13 characters of A-Z, 0-9 and /, with a letter and a digit, no spaces.`);\n  }\n  return s;\n}\n\nfunction printable(value: unknown, field: string, max: number): string {\n  const s = str(value, field);\n  if (!/^[\\x20-\\x7e]*$/.test(s)) fail(field, `${JSON.stringify(s)} has a character outside printable ASCII, which the card's font is not known to draw.`);\n  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n  return s;\n}\n\n/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\nexport function normalizeQslCard(props: QslCardProps) {\n  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) } as typeof DEFAULTS;\n  const stationCallsign = callsign(p.stationCallsign, \"stationCallsign\");\n  const call = callsign(p.call, \"call\");\n\n  const qsoDate = str(p.qsoDate, \"qsoDate\");\n  const date = qslFormatDate(qsoDate);\n  if (date === null) fail(\"qsoDate\", `${JSON.stringify(qsoDate)} is not an ADIF date: YYYYMMDD, a real calendar day from 1930 on.`);\n  const timeOn = str(p.timeOn, \"timeOn\");\n  const time = qslFormatTime(timeOn);\n  if (time === null) fail(\"timeOn\", `${JSON.stringify(timeOn)} is not an ADIF time: HHMM or HHMMSS, 0000 to 235959 UTC.`);\n\n  const freq = str(p.freq, \"freq\");\n  if (qslMHzToHz(freq) === null) fail(\"freq\", `${JSON.stringify(freq)} is not a frequency in MHz: digits with up to 6 decimals, e.g. \"14.074\".`);\n  const band = qslBandOf(freq);\n  if (band === null) fail(\"freq\", `${freq} MHz is in no amateur band of the ADIF 3.1.6 band table, so the card cannot name its BAND.`);\n\n  const mode = str(p.mode, \"mode\").toUpperCase();\n  if (!/^[A-Z0-9-]{1,8}$/.test(mode)) fail(\"mode\", `${JSON.stringify(mode)} must be 1-8 characters of A-Z, 0-9 and -.`);\n  const rst = str(p.rstSent, \"rstSent\");\n  if (!/^[1-5][1-9][1-9]?$/.test(rst) && !/^[+-]\\d{1,2}$/.test(rst)) fail(\"rstSent\", `${JSON.stringify(rst)} is not a report: RS or RST digits (\"59\", \"599\") or signed dB (\"-12\", \"+05\").`);\n\n  const gridRaw = str(p.myGridsquare, \"myGridsquare\");\n  const grid = gridRaw === \"\" ? \"\" : qslGrid(gridRaw);\n  if (grid === null) fail(\"myGridsquare\", `${JSON.stringify(gridRaw)} is not a Maidenhead locator: 4, 6 or 8 characters like \"EN34\", \"EN34lw\" (fields A-R, subsquares a-x).`);\n  const qth = printable(p.qth, \"qth\", 32);\n  const pota = str(p.myPotaRef, \"myPotaRef\").toUpperCase();\n  if (pota !== \"\" && !/^[A-Z0-9]{1,4}-\\d{4,5}(@[A-Z0-9-]{2,6})?$/.test(pota)) fail(\"myPotaRef\", `${JSON.stringify(pota)} is not a POTA reference: \"US-1234\", \"K-12345\" or \"GB-0001@GB-ENG\".`);\n  const qslMsg = printable(p.qslMsg, \"qslMsg\", 40);\n  const accent = str(p.accentColor, \"accentColor\");\n  if (!/^#[0-9a-fA-F]{6}$/.test(accent)) fail(\"accentColor\", `${JSON.stringify(accent)} must be #rrggbb.`);\n  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n\n  return {\n    stationCallsign, call, date, time, freq, band, mode, rst, grid, qth, pota, qslMsg,\n    accent: accent.toLowerCase() as MosaicColor, debugLayout: p.debugLayout,\n  };\n}\n\n/* ── colour ── */\n\nfunction qslMix(a: string, b: string, t: number): MosaicColor {\n  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * t));\n  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n}\nfunction qslLuminance(hex: string): number {\n  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n}\n/** The readable ink on the accent tag: the paper or the navy, whichever contrasts more with the caller's accent. */\nfunction qslOnColor(fill: string): MosaicColor {\n  const ratio = (other: string) => { const a = qslLuminance(fill), b = qslLuminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n  return (ratio(INK) >= ratio(PAPER) ? INK : PAPER) as MosaicColor;\n}\n\n/* ── geometry ── */\n\nexport type QslRect = { x: number; y: number; w: number; h: number };\ntype Bind = Exclude<keyof QslCardProps, \"debugLayout\"> | null;\ntype Cell = { label: string; rect: QslRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\ntype Tile = { label: string; rect: QslRect; color: MosaicColor; radius: number; bind?: \"accentColor\" };\n\n/** The cell width a line needs at `px` under the fit rule (`cell * 0.94 - 2px`). */\nfunction need(text: string, px: number, bold: boolean): number {\n  return Math.ceil((widthOf(text, px, bold) + 2) / 0.94) + 1;\n}\n/** The largest whole size up to `maxPx` at which `widthAt(px)` is at most `room`. */\nfunction largest(maxPx: number, room: number, widthAt: (px: number) => number): number {\n  let px = Math.max(1, Math.round(maxPx));\n  while (px > 1 && widthAt(px) > room) px--;\n  return px;\n}\n/** One line in a cell: the largest size up to `maxPx` that fits the cell's budget. */\nfunction fitPx(line: string, cellW: number, maxPx: number, bold: boolean): number {\n  const top = Math.max(1, Math.round(maxPx)), room = budget(cellW), w = widthOf(line, top, bold);\n  let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n  while (px > 1 && widthOf(line, px, bold) > room) px--;\n  return px;\n}\n\n/** The six cells of the QSO table, in reading order. */\nexport const QSL_COLUMNS = [\"date\", \"utc\", \"mhz\", \"band\", \"mode\", \"rst\"] as const;\nconst COLUMN_LABEL: Record<(typeof QSL_COLUMNS)[number], string> = { date: \"DATE\", utc: \"UTC\", mhz: \"MHz\", band: \"BAND\", mode: \"MODE\", rst: \"RST\" };\nconst CONFIRM = \"CONFIRMING OUR QSO\";\nconst MARK = \"ADIF QSO CARD\";\n\n/** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\nexport function layoutQslCard(props: QslCardProps, W: number, H: number) {\n  const p = normalizeQslCard(props);\n  const S = Math.min(W, H), aspect = W / H;\n  // The table reflows by aspect first; type shrinks only after that.\n  const shape: \"wide\" | \"square\" | \"tall\" = aspect >= 1.25 ? \"wide\" : aspect >= 0.8 ? \"square\" : \"tall\";\n  const grid = shape === \"wide\" ? { rows: 1, cols: 6 } : shape === \"square\" ? { rows: 2, cols: 3 } : { rows: 3, cols: 2 };\n  const floor = Math.max(1, Math.round((S * 10) / 270));\n  const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} above the ${floor}px readability floor: shorten it or render a larger canvas.`);\n\n  const barH = Math.max(2, Math.round(S * 0.022));\n  const m = Math.round(S * 0.065), CW = W - 2 * m;\n  const top = barH + Math.round(S * 0.045), bottom = H - Math.round(S * 0.05), CH = bottom - top;\n  const gap = Math.round(S * 0.03);\n  const rule = Math.max(1, Math.round(S / 400));\n  const ruleColor = qslMix(PAPER, INK, 0.28);\n  const fr = { wide: [0.4, 0.15, 0.31], square: [0.33, 0.19, 0.36], tall: [0.28, 0.17, 0.47] }[shape];\n  const hh = Math.round(CH * fr[0]), sh = Math.round(CH * fr[1]), th = Math.round(CH * fr[2]), fh = CH - hh - sh - th;\n  const headY = top, stripY = headY + hh, tableY = stripY + sh, footY = tableY + th;\n\n  const cells: Cell[] = [];\n  const tiles: Tile[] = [];\n  const line = (label: string, rect: QslRect, text: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string } = {}) => {\n    if (px < floor) unfit(o.field ?? label);\n    cells.push({ label, rect, text, px, width: widthOf(text, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? (INK as MosaicColor), bind: o.bind ?? null, over: o.over === true });\n  };\n\n  tiles.push({ label: \"accent-bar\", rect: { x: 0, y: 0, w: W, h: barH }, color: p.accent, radius: 0, bind: \"accentColor\" });\n\n  // ── header: the station call, sized from its own text, and the station block ──\n  type StationLine = { label: string; value: string; tag?: string; bind: Bind };\n  const station: StationLine[] = [];\n  if (p.grid !== \"\") station.push({ label: \"station-grid\", tag: \"GRID\", value: p.grid, bind: \"myGridsquare\" });\n  if (p.qth !== \"\") station.push({ label: \"station-qth\", value: p.qth, bind: \"qth\" });\n  if (p.pota !== \"\") station.push({ label: \"station-pota\", tag: \"POTA\", value: p.pota, bind: \"myPotaRef\" });\n  const tagGap = (px: number) => Math.round(px * 0.3);\n  const lineNeed = (l: StationLine, px: number) => need(l.value, px, false) + (l.tag ? need(l.tag, px, false) + tagGap(px) : 0);\n  /** One station line drawn right- or left-aligned from `edge`: the tag in the dim ink, the value in the ink. */\n  const stationLine = (l: StationLine, y: number, h: number, px: number, edge: number, align: \"left\" | \"right\") => {\n    const vw = need(l.value, px, false), tw = l.tag ? need(l.tag, px, false) : 0;\n    const valueX = align === \"right\" ? edge - vw : edge + (l.tag ? tw + tagGap(px) : 0);\n    if (l.tag) line(`${l.label}-tag`, { x: align === \"right\" ? valueX - tagGap(px) - tw : edge, y, w: tw, h }, l.tag, px, { align, color: DIM as MosaicColor, field: l.bind as string });\n    line(l.label, { x: valueX, y, w: vw, h }, l.value, px, { align, bind: l.bind, field: l.bind as string });\n  };\n\n  let callPx: number;\n  if (shape === \"wide\") {\n    // The call takes the left, the station block the right as right-aligned\n    // lines; the block takes what its longest line needs (28-50% of the width).\n    const lineTop = Math.max(floor, Math.min(Math.round(hh * 0.13), Math.round(S * 0.05))), lineH = Math.max(Math.round(hh * 0.21), Math.ceil(lineTop / 0.62));\n    const stationW = station.length === 0 ? 0\n      : Math.max(Math.round(CW * 0.28), Math.min(Math.round(CW * 0.5), Math.max(...station.map((l) => lineNeed(l, lineTop)))));\n    const linePx = Math.min(lineTop, ...station.map((l) => largest(lineTop, stationW, (px) => lineNeed(l, px))));\n    const callW = station.length === 0 ? CW : CW - stationW - gap;\n    callPx = fitPx(p.stationCallsign, callW, hh * 0.72, true);\n    line(\"callsign\", { x: m, y: headY, w: callW, h: hh }, p.stationCallsign, callPx, { bold: true, bind: \"stationCallsign\", field: \"stationCallsign\" });\n    const y0 = headY + Math.round((hh - station.length * lineH) / 2);\n    station.forEach((l, i) => stationLine(l, y0 + i * lineH, lineH, linePx, m + CW, \"right\"));\n  } else {\n    // The call spans the width; the QTH and then GRID + POTA sit under it on one or two lines.\n    const rows: StationLine[][] = [];\n    if (p.qth !== \"\") rows.push(station.filter((l) => l.label === \"station-qth\"));\n    const tagged = station.filter((l) => l.tag);\n    if (tagged.length > 0) rows.push(tagged);\n    const lineTop = Math.max(floor, Math.min(Math.round(hh * 0.1), Math.round(S * 0.05))), lineH = Math.ceil(lineTop / 0.62);\n    const rowNeed = (row: StationLine[], px: number) => row.reduce((sum, l) => sum + lineNeed(l, px), 0) + (row.length - 1) * gap * 2;\n    const linePx = Math.min(lineTop, ...rows.map((row) => largest(lineTop, CW, (px) => rowNeed(row, px))));\n    const callMaxH = hh - rows.length * lineH;\n    callPx = fitPx(p.stationCallsign, CW, callMaxH * 0.72, true);\n    const callH = Math.min(callMaxH, Math.ceil(callPx / 0.72));\n    const y0 = headY + Math.round((hh - callH - rows.length * lineH) / 2);\n    line(\"callsign\", { x: m, y: y0, w: CW, h: callH }, p.stationCallsign, callPx, { bold: true, bind: \"stationCallsign\", field: \"stationCallsign\" });\n    rows.forEach((row, r) => {\n      let x = m;\n      for (const l of row) { stationLine(l, y0 + callH + r * lineH, lineH, linePx, x, \"left\"); x += lineNeed(l, linePx) + gap * 2; }\n    });\n  }\n\n  // ── to-radio strip: the TO RADIO tag, the worked call (second largest), the confirmation ──\n  tiles.push({ label: \"rule-head\", rect: { x: m, y: stripY, w: CW, h: rule }, color: ruleColor, radius: 0 });\n  const tagPxOf = (px: number) => Math.max(floor, Math.round(px * 0.4));\n  const chipPad = (tagPx: number) => Math.round(tagPx * 0.55);\n  const chipW = (tagPx: number) => need(\"TO RADIO\", tagPx, true) + 2 * chipPad(tagPx);\n  const workedCap = Math.round(callPx * 0.62);\n  const oneLineTop = Math.min(Math.round((sh - rule) * 0.5), workedCap);\n  const oneLineW = (px: number) => chipW(tagPxOf(px)) + gap + need(p.call, px, true) + gap + need(CONFIRM, tagPxOf(px), false);\n  const oneLinePx = largest(oneLineTop, CW, oneLineW);\n  const twoLines = shape !== \"wide\" && oneLinePx < oneLineTop * 0.85;\n  let workedPx: number;\n  {\n    const y = stripY + rule;\n    const h2Min = twoLines ? Math.max(Math.round((sh - rule) * 0.4), Math.ceil(floor / 0.6)) : 0;\n    const h1 = sh - rule - h2Min;\n    workedPx = twoLines ? largest(Math.min(Math.round(h1 * 0.62), workedCap), CW, (px) => chipW(tagPxOf(px)) + gap + need(p.call, px, true)) : oneLinePx;\n    const tagPx = tagPxOf(workedPx);\n    const cw = chipW(tagPx), chipH = Math.round(tagPx * 1.9);\n    const chip: QslRect = { x: m, y: y + Math.round((h1 - chipH) / 2), w: cw, h: chipH };\n    tiles.push({ label: \"to-radio-chip\", rect: chip, color: p.accent, radius: 0.18 });\n    line(\"to-radio\", chip, \"TO RADIO\", tagPx, { bold: true, align: \"center\", color: qslOnColor(p.accent), over: true, field: \"the TO RADIO tag\" });\n    const wx = m + cw + gap;\n    line(\"worked-call\", { x: wx, y, w: need(p.call, workedPx, true), h: h1 }, p.call, workedPx, { bold: true, bind: \"call\", field: \"call\" });\n    if (twoLines) {\n      const h2 = h2Min, cpx = Math.min(tagPx, fitPx(CONFIRM, CW, h2 * 0.6, false));\n      line(\"confirm\", { x: m, y: y + h1, w: need(CONFIRM, cpx, false), h: h2 }, CONFIRM, cpx, { color: DIM as MosaicColor, field: \"the confirmation line\" });\n    } else {\n      const cw2 = need(CONFIRM, tagPx, false);\n      line(\"confirm\", { x: m + CW - cw2, y, w: cw2, h: h1 }, CONFIRM, tagPx, { align: \"right\", color: DIM as MosaicColor, field: \"the confirmation line\" });\n    }\n  }\n\n  // ── the QSO table: a label over a value per cell, columns weighted by what they hold ──\n  const values: Record<(typeof QSL_COLUMNS)[number], { text: string; bind: Bind }> = {\n    date: { text: p.date, bind: \"qsoDate\" }, utc: { text: p.time, bind: \"timeOn\" }, mhz: { text: p.freq, bind: \"freq\" },\n    // BAND is derived from FREQ, so nothing binds it.\n    band: { text: p.band, bind: null }, mode: { text: p.mode, bind: \"mode\" }, rst: { text: p.rst, bind: \"rstSent\" },\n  };\n  // The table starts a little below the strip, so its first label never reads as part of the line above.\n  const tablePad = Math.round(S * 0.02), rowH = Math.floor((th - tablePad) / grid.rows);\n  const labelH = Math.round(rowH * 0.3), accentRule = Math.max(1, Math.round(S / 300));\n  const valueH = rowH - labelH - accentRule - Math.round(rowH * 0.06);\n  const colGap = Math.round(S * 0.035);\n  const cellsAt = (c: number) => QSL_COLUMNS.filter((_, i) => i % grid.cols === c);\n  // Hierarchy: the station call is at least twice a table value, the worked call at least one.\n  const valueTop = Math.min(Math.round(valueH * 0.7), Math.floor(callPx / 2), workedPx, Math.round(S * 0.11));\n  const labelPxOf = (px: number) => Math.max(floor, Math.min(Math.round(labelH * 0.6), Math.round(px * 0.5)));\n  const colNeed = (px: number) => Array.from({ length: grid.cols }, (_, c) =>\n    Math.max(...cellsAt(c).map((k) => Math.max(need(values[k].text, px, true), need(COLUMN_LABEL[k], labelPxOf(px), false)))));\n  const valuePx = largest(valueTop, CW, (px) => colNeed(px).reduce((a, b) => a + b, 0) + (grid.cols - 1) * colGap);\n  if (valuePx < floor) unfit(\"the QSO table\");\n  const labelPx = labelPxOf(valuePx);\n  const needs = colNeed(valuePx), sumNeed = needs.reduce((a, b) => a + b, 0);\n  const spare = CW - sumNeed - (grid.cols - 1) * colGap;\n  const colX: number[] = [], colW: number[] = [];\n  let x = m;\n  needs.forEach((n, c) => {\n    // The spare width is shared equally, so the gutters read as one rhythm; the content weights the rest.\n    const w = c === grid.cols - 1 ? m + CW - x : n + Math.floor(spare / grid.cols);\n    colX.push(x); colW.push(w); x += w + colGap;\n  });\n  for (let r = 0; r < grid.rows; r++) {\n    const ry = tableY + tablePad + r * rowH;\n    tiles.push({ label: `label-rule-${r}`, rect: { x: m, y: ry + labelH, w: CW, h: accentRule }, color: p.accent, radius: 0 });\n  }\n  QSL_COLUMNS.forEach((k, i) => {\n    const r = Math.floor(i / grid.cols), c = i % grid.cols, ry = tableY + tablePad + r * rowH;\n    line(`col-label-${k}`, { x: colX[c], y: ry, w: colW[c], h: labelH }, COLUMN_LABEL[k], labelPx, { color: DIM as MosaicColor, field: \"the QSO table labels\" });\n    line(`col-value-${k}`, { x: colX[c], y: ry + labelH + accentRule, w: colW[c], h: valueH }, values[k].text, valuePx, { bold: true, bind: values[k].bind, field: \"the QSO table\" });\n  });\n\n  // ── footer: QSLMSG on the left, the card's small mark on the right (dropped when it costs fit) ──\n  tiles.push({ label: \"rule-foot\", rect: { x: m, y: footY, w: CW, h: rule }, color: ruleColor, radius: 0 });\n  const fy = footY + rule, fH = fh - rule;\n  const footTop = Math.max(floor, Math.min(Math.round(fH * 0.42), Math.round(S * 0.045)));\n  const markPx = Math.max(floor, Math.round(footTop * 0.75));\n  const markW = need(MARK, markPx, false);\n  let showMark = true, msgPx = footTop;\n  if (p.qslMsg !== \"\") {\n    msgPx = fitPx(p.qslMsg, CW - markW - gap, footTop, false);\n    if (msgPx < footTop * 0.85) { showMark = false; msgPx = fitPx(p.qslMsg, CW, footTop, false); }\n    line(\"qslmsg\", { x: m, y: fy, w: need(p.qslMsg, msgPx, false), h: fH }, p.qslMsg, msgPx, { bind: \"qslMsg\", field: \"qslMsg\" });\n  }\n  if (showMark) line(\"mark\", { x: m + CW - markW, y: fy, w: markW, h: fH }, MARK, markPx, { align: \"right\", color: DIM as MosaicColor, field: \"the card mark\" });\n\n  return { p, shape, grid, floor, cells, tiles, callPx, workedPx, valuePx, labelPx, twoLines, showMark, bands: { headY, stripY, tableY, footY, bottom } };\n}\n\n/**\n * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n * convention, src/_shared/why.ts): the run, the problem with the sources the\n * agent opened, the solution, how to use it, then the template itself.\n */\nconst WHY: WhySpec = {\n  \"day\": 14,\n  \"date\": \"2026-10-03\",\n  \"agent\": \"claude\",\n  \"model\": \"claude-opus-5-5\",\n  \"id\": \"@one-a-day/community/qsl-card/v1\",\n  \"title\": \"Ham Radio QSL Card\",\n  \"who\": \"Ham radio operators who owe every station they worked a QSL card, gathered around their loggers (World Radio League, Wavelog, Log4OM) and POTA activators.\",\n  \"problem\": [\n    \"The World Radio League forum thread \\\"QSL Card Generator\\\" opens (57 likes) asking to \\\"select a template ... the appropriate information (other callsign/band/frequency/mode/time/report/etc.) would be auto populated ... a PNG or JPEG could be saved off\\\". A new licensee replies: \\\"struggling with putting together a card\\\".\",\n    \"It is a batch job: \\\"Auto QSL Card\\\" asks for a card \\\"to all contacts made that day ... if I'm on a camping trip for 8 days\\\", and page 2 posts a Pillow script drawing text at hand-picked (x, y) points. Wavelog, DigiQSL and S53ZO's label tool take ADIF in, but none renders an image per QSO from a command line.\"\n  ],\n  \"sources\": [\n    \"https://community.worldradioleague.com/t/qsl-card-generator/13739\",\n    \"https://community.worldradioleague.com/t/qsl-card-generator/13739?page=2\",\n    \"https://community.worldradioleague.com/t/auto-qsl-card/\",\n    \"https://www.adif.org/316/ADIF_316.htm\",\n    \"https://github.com/s53zo/ADIF-to-QSL-label\",\n    \"https://cq.sk/en/adif-to-qsl-label/\",\n    \"https://docs.wavelog.org/user-guide/qsl/qsl-postcard-designer/\",\n    \"https://digiqsl.com/features\",\n    \"https://amateurradio.com/qsling-made-easy\"\n  ],\n  \"solution\": [\n    \"One card per QSO from one ADIF record. The props are the ADIF fields in camelCase, in ADIF formats (qsoDate \\\"20261003\\\", timeOn \\\"1432\\\", freq \\\"14.074\\\"), printed the QSL way: 03 OCT 2026, 14:32. BAND is not a prop: it is derived from FREQ with the ADIF 3.1.6 band table, so the two never disagree.\",\n    \"The decision that matters: a callsign is never ellipsized. The call is sized from its own text, the QSO table reflows 6x1, 3x2 or 2x3 by aspect before any type shrinks, and copy that cannot fit above the floor is refused with an error naming the prop. No photo background in v1: paper, one accent and type.\"\n  ],\n  \"usage\": {\n    \"command\": \"m0saic make @one-a-day/community/qsl-card/v1 --template-repo . -w 1920 -h 1080 --props '{\\\"call\\\":\\\"DL1ABC\\\",\\\"freq\\\":\\\"7.074\\\",\\\"timeOn\\\":\\\"0915\\\"}' -o qsl-DL1ABC.png\",\n    \"try\": [\n      \"--props @qso.json, one file per ADIF record: a loop over the log writes one card per QSO\",\n      \"-w 1650 -h 1050: the 5.5 x 3.5 in card at 300 dpi; -w 1080 -h 1080 or -h 1920 reflow the table to 3x2 or 2x3\",\n      \"freq \\\"432.100\\\" prints BAND 70cm; freq \\\"27.185\\\" (CB) is refused: it is in no amateur band\",\n      \"myPotaRef \\\"\\\", myGridsquare \\\"\\\": the lines and their prefixes go; accentColor \\\"#1f5fa8\\\" for a blue card\"\n    ]\n  },\n  \"timeline\": {\n    \"source\": \"runner\",\n    \"phases\": [\n      {\n        \"name\": \"scout\",\n        \"startMs\": 0,\n        \"durMs\": 187402,\n        \"calls\": 29,\n        \"tokens\": 2732923,\n        \"costUsd\": 1.3,\n        \"tools\": \"Bash 16, WebSearch 11, ToolSearch 1\"\n      },\n      {\n        \"name\": \"plan\",\n        \"startMs\": 187417,\n        \"durMs\": 235946,\n        \"calls\": 7,\n        \"tokens\": 650247,\n        \"costUsd\": 0.73,\n        \"tools\": \"Bash 6, Write 1\"\n      },\n      {\n        \"name\": \"build\",\n        \"startMs\": 423392,\n        \"durMs\": 1207648,\n        \"calls\": 64,\n        \"tokens\": 16253730,\n        \"costUsd\": 4.48,\n        \"tools\": \"Bash 42, Read 19, Write 3\"\n      },\n      {\n        \"name\": \"critique\",\n        \"startMs\": 1631053,\n        \"durMs\": 272372,\n        \"calls\": 44,\n        \"tokens\": 7128751,\n        \"costUsd\": 2.05,\n        \"tools\": \"Bash 22, Read 21, Write 1\"\n      }\n    ],\n    \"costBasis\": \"reported\"\n  },\n  \"caveats\": [\n    \"No photo background in v1: the card is paper, one accent colour and type. Shack and park photos, the usual QSL face, are a later version.\",\n    \"One QSO per card. It reads no .adi file: your script maps each ADIF record to the props and calls m0saic make once per QSO.\",\n    \"RST_RCVD, QSL_VIA and the rig are not printed. BAND is always derived from FREQ, so a log whose BAND disagrees with its FREQ shows the FREQ band.\"\n  ]\n};\n\nexport const QslCardV1 = defineMosaicTemplate<QslCardProps>({\n  id: asTemplateId(ID),\n  label: \"2026-10-03 · Ham Radio QSL Card\",\n  version: 1,\n  description: \"A ham radio QSL card for one contact, from one ADIF log record: props named after the ADIF fields, the date and time printed the QSL way, BAND derived from FREQ. Paper and type only, no photo background in v1.\",\n  capabilities: { tier: \"core\" },\n  tags: [\"community\",\"2026-10-03\",\"day-014\", \"ham-radio\", \"qsl\", \"adif\", \"card\"],\n\n  outputHints: {\n    width: 1920,\n    height: 1080,\n    fps: 30,\n    durationMs: 2000,\n    format: { kind: \"image\", container: \"png\" },\n    note: \"Still PNG, one card per QSO. The physical card is 5.5 x 3.5 in (1650x1050 at 300 dpi); portrait and square reflow the QSO table to 2x3 and 3x2. Minimum tested canvas 480x270.\",\n  },\n\n  propsSchema,\n  defaultProps: DEFAULTS,\n\n  render,\n  renderTutorial: whyTutorial(WHY, render),\n});\n\nexport default QslCardV1;\n\nasync function render(props: QslCardProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n  const { width: W, height: H } = ctx.target;\n  const L = layoutQslCard(props, W, H);\n  const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n  const constraints: LayoutConstraint[] = [];\n\n  for (const t of L.tiles) {\n    const tile = tag({ ...makeColorTile(t.color, t.radius > 0 ? { effects: { rounding: { cornerStyle: \"rounded\", borderRadius: t.radius } } } : {}) } as MosaicSource, t.label);\n    // The accent bar is the rect that shows `accentColor`.\n    pieces.push({ rect: { ...t.rect, importance: 1 }, source: t.bind ? bindProp(tile, t.bind) : tile });\n  }\n  for (const c of L.cells) {\n    const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n    // A text rect is BOUND to the prop it shows; derived copy (BAND, the labels, the chrome) is not.\n    pieces.push({ rect: { ...c.rect, importance: c.over ? 3 : 2 }, source: c.bind === null ? cell : bindProp(cell, c.bind) });\n    constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n  }\n\n  // What the geometry promises: every text fits (above); the call in the top\n  // half; all six QSO values present and in the table band; the footer at the\n  // bottom; the accent bar across the card.\n  constraints.push({ label: \"callsign\", within: { yFrac: [0, 0.5] } });\n  for (const k of [\"date\", \"utc\", \"mhz\", \"band\", \"mode\", \"rst\"]) constraints.push({ label: `col-value-${k}`, within: { yFrac: [0.3, 0.92] } });\n  if (L.cells.some((c) => c.label === \"qslmsg\")) constraints.push({ label: \"qslmsg\", within: { yFrac: [0.6, 1] } });\n  constraints.push({ label: \"accent-bar\", minWidthFrac: 0.98 });\n  constraints.push({ label: \"worked-call\" });\n\n  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n  const doc: MosaicDocument = {\n    kind: \"mosaic_document\",\n    version: 1,\n    m0: toM0String(placed.m0, ID),\n    assets: {},\n    backgroundColor: PAPER as MosaicColor,\n    sources: placed.sources,\n  };\n  return withLayoutIntent(doc, ctx, { templateId: ID, constraints, debug: props.debugLayout === true });\n}\n","numLines":654,"startLine":1,"totalLines":654}}}
