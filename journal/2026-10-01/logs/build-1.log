{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01289rHL4pTPg27nm67zeuUu","type":"tool_result","content":"1\timport type { MosaicColor, MosaicSource } from \"@m0saic/types\";\n2\timport { measureText, resolveFontFile, wrapMeasured } from \"@m0saic/template-utils\";\n3\t\n4\t/**\n5\t * The text kit the shared pages and harness cards draw with: svg-rasterized\n6\t * cells (the bundled deterministic font, no drawtext), measured fits, and a\n7\t * word-wrap that survives a token wider than its box. Templates written by\n8\t * the daily agent usually carry their own fitter (the og-card measures bold\n9\t * against the bold file); this kit is for the repo's own chrome.\n10\t */\n11\t\n12\t/** The fit budget inside a cell: `cell * 0.94 - 2px` (the layout contract's rule). */\n13\texport function budget(cellW: number): number {\n14\t  return Math.max(8, Math.floor(cellW * 0.94 - 2));\n15\t}\n16\t\n17\t/** One svg-rasterized text cell, aligned inside its rect. */\n18\texport function textCell(opts: {\n19\t  text: string;\n20\t  fontSize: number;\n21\t  color: MosaicColor;\n22\t  hAlign: \"left\" | \"right\" | \"center\";\n23\t  bold?: boolean;\n24\t  vAlign?: \"top\" | \"middle\" | \"bottom\";\n25\t  label: string;\n26\t}): MosaicSource {\n27\t  return {\n28\t    type: \"text\",\n29\t    rasterizer: \"svg\",\n30\t    renderMode: { kind: \"image\" },\n31\t    layers: [\n32\t      {\n33\t        content: { kind: \"literal\", text: opts.text },\n34\t        style: { fontSize: opts.fontSize, fontColor: opts.color, ...(opts.bold ? { fontWeight: \"bold\" } : {}) },\n35\t        placement: { hAlign: opts.hAlign, vAlign: opts.vAlign ?? \"middle\" },\n36\t      },\n37\t    ],\n38\t    editor: { owner: \"template\", label: opts.label },\n39\t  } as MosaicSource;\n40\t}\n41\t\n42\t/** Measured width of one block, in the weight that will be drawn. */\n43\texport function widthOf(text: string, fontSize: number, bold = false): number {\n44\t  const fontPath = bold ? resolveFontFile({ weight: \"bold\" })?.path : undefined;\n45\t  return measureText(text, { fontSize, ...(fontPath ? { fontPath } : {}) }).width;\n46\t}\n47\t\n48\t/** Shrink one line until it fits `maxW` (never wraps); returns the size. */\n49\texport function fitLine(text: string, maxW: number, maxPx: number, minPx: number, bold = false): number {\n50\t  let px = Math.round(maxPx);\n51\t  while (px > minPx && widthOf(text, px, bold) > maxW) px = Math.max(minPx, Math.round(px * 0.92));\n52\t  return px;\n53\t}\n54\t\n55\t/**\n56\t * Word-wrap that also survives a token wider than the box (a URL, a long\n57\t * flag): `wrapMeasured` never breaks a word, so such a token would run off\n58\t * the edge. Over-long tokens are chunked by character to `chunkW` first.\n59\t */\n60\texport function wrapFit(text: string, fontSize: number, maxW: number, chunkW = maxW): string[] {\n61\t  const width = (t: string) => measureText(t, { fontSize }).width;\n62\t  const words = text.split(\" \").filter((w) => w.length > 0).flatMap((w) => {\n63\t    if (width(w) <= chunkW) return [w];\n64\t    const chunks: string[] = [];\n65\t    let cur = \"\";\n66\t    for (const ch of w) {\n67\t      if (cur.length > 0 && width(cur + ch) > chunkW) { chunks.push(cur); cur = ch; } else cur += ch;\n68\t    }\n69\t    if (cur.length > 0) chunks.push(cur);\n70\t    return chunks;\n71\t  });\n72\t  return wrapMeasured(words.join(\" \"), fontSize, maxW);\n73\t}\n74\t\n75\t/** Cut `text` to fit `maxW` at `fontSize` with a trailing \"...\" - the last resort after shrinking. */\n76\texport function ellipsize(text: string, fontSize: number, maxW: number, bold = false): string {\n77\t  if (widthOf(text, fontSize, bold) <= maxW) return text;\n78\t  let t = text;\n79\t  while (t.length > 1 && widthOf(t + \"...\", fontSize, bold) > maxW) t = t.slice(0, -1);\n80\t  return t.trimEnd() + \"...\";\n81\t}\n82\t"}]},"parent_tool_use_id":null,"session_id":"69fab120-65e8-492e-b76a-c27ffd29396a","uuid":"8b536757-39a1-4e3d-a0fa-3cafa708806f","timestamp":"2026-10-01T13:12:51.754Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\_shared\\text.ts","content":"import type { MosaicColor, MosaicSource } from \"@m0saic/types\";\nimport { measureText, resolveFontFile, wrapMeasured } from \"@m0saic/template-utils\";\n\n/**\n * The text kit the shared pages and harness cards draw with: svg-rasterized\n * cells (the bundled deterministic font, no drawtext), measured fits, and a\n * word-wrap that survives a token wider than its box. Templates written by\n * the daily agent usually carry their own fitter (the og-card measures bold\n * against the bold file); this kit is for the repo's own chrome.\n */\n\n/** The fit budget inside a cell: `cell * 0.94 - 2px` (the layout contract's rule). */\nexport function budget(cellW: number): number {\n  return Math.max(8, Math.floor(cellW * 0.94 - 2));\n}\n\n/** One svg-rasterized text cell, aligned inside its rect. */\nexport function textCell(opts: {\n  text: string;\n  fontSize: number;\n  color: MosaicColor;\n  hAlign: \"left\" | \"right\" | \"center\";\n  bold?: boolean;\n  vAlign?: \"top\" | \"middle\" | \"bottom\";\n  label: string;\n}): MosaicSource {\n  return {\n    type: \"text\",\n    rasterizer: \"svg\",\n    renderMode: { kind: \"image\" },\n    layers: [\n      {\n        content: { kind: \"literal\", text: opts.text },\n        style: { fontSize: opts.fontSize, fontColor: opts.color, ...(opts.bold ? { fontWeight: \"bold\" } : {}) },\n        placement: { hAlign: opts.hAlign, vAlign: opts.vAlign ?? \"middle\" },\n      },\n    ],\n    editor: { owner: \"template\", label: opts.label },\n  } as MosaicSource;\n}\n\n/** Measured width of one block, in the weight that will be drawn. */\nexport function widthOf(text: string, fontSize: number, bold = false): number {\n  const fontPath = bold ? resolveFontFile({ weight: \"bold\" })?.path : undefined;\n  return measureText(text, { fontSize, ...(fontPath ? { fontPath } : {}) }).width;\n}\n\n/** Shrink one line until it fits `maxW` (never wraps); returns the size. */\nexport function fitLine(text: string, maxW: number, maxPx: number, minPx: number, bold = false): number {\n  let px = Math.round(maxPx);\n  while (px > minPx && widthOf(text, px, bold) > maxW) px = Math.max(minPx, Math.round(px * 0.92));\n  return px;\n}\n\n/**\n * Word-wrap that also survives a token wider than the box (a URL, a long\n * flag): `wrapMeasured` never breaks a word, so such a token would run off\n * the edge. Over-long tokens are chunked by character to `chunkW` first.\n */\nexport function wrapFit(text: string, fontSize: number, maxW: number, chunkW = maxW): string[] {\n  const width = (t: string) => measureText(t, { fontSize }).width;\n  const words = text.split(\" \").filter((w) => w.length > 0).flatMap((w) => {\n    if (width(w) <= chunkW) return [w];\n    const chunks: string[] = [];\n    let cur = \"\";\n    for (const ch of w) {\n      if (cur.length > 0 && width(cur + ch) > chunkW) { chunks.push(cur); cur = ch; } else cur += ch;\n    }\n    if (cur.length > 0) chunks.push(cur);\n    return chunks;\n  });\n  return wrapMeasured(words.join(\" \"), fontSize, maxW);\n}\n\n/** Cut `text` to fit `maxW` at `fontSize` with a trailing \"...\" - the last resort after shrinking. */\nexport function ellipsize(text: string, fontSize: number, maxW: number, bold = false): string {\n  if (widthOf(text, fontSize, bold) <= maxW) return text;\n  let t = text;\n  while (t.length > 1 && widthOf(t + \"...\", fontSize, bold) > maxW) t = t.slice(0, -1);\n  return t.trimEnd() + \"...\";\n}\n","numLines":82,"startLine":1,"totalLines":82}}}
