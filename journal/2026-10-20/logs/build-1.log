m run test:bundle && npm run test:contract && npm run check:deps\",\n    \"smoke:render\": \"node tools/smoke-render.mjs\",\n    \"previews\": \"node tools/gen-previews.mjs\",\n    \"bundle\": \"node tools/pack-bundle.mjs --unsigned\",\n    \"test:bundle\": \"node --test tools/pack-bundle.test.mjs\",\n    \"day\": \"node pipeline/run.mjs\",\n    \"day:dry\": \"node pipeline/run.mjs --no-push\",\n    \"submit\": \"node tools/submit.mjs\",\n    \"release\": \"node tools/submit.mjs --push\",\n    \"test:pipeline:e2e\": \"node pipeline/e2e-fake-day.mjs && node pipeline/e2e-fake-day.mjs no-ship && node pipeline/e2e-fake-day.mjs tamper && node pipeline/e2e-fake-day.mjs revise\",\n    \"bake:mark\": \"node tools/bake-mark.mjs\"\n  },\n  \"//dependencies\": [\n    \"The @m0saic/* substrate is on npm. The 0.x ranges (types, platform,\",\n    \"template-utils) track the m0saic CLI line; the language packages (dsl,\",\n    \"dsl-stdlib) version on their own. AUTHOR MODE (build / test / lint) is\",\n    \"`npm install && npm run verify` \\u2014 no monorepo checkout, no file: links.\",\n    \"\",\n    \"USING the repo needs no install at all: dist/ and template-manifest.json\",\n    \"are COMMITTED (the daily run rebuilds them), so the app (Templates ->\",\n    \"Add source) and the CLI (--template-repo) load dist/index.js as-is, and\",\n    \"the host resolves @m0saic/* from its own module tree at load time.\"\n  ],\n  \"dependencies\": {\n    \"@m0saic/dsl\": \"^2.0.0\",\n    \"@m0saic/dsl-stdlib\": \"^3.0.0\",\n    \"@m0saic/platform\": \"^0.2.0\",\n    \"@m0saic/template-utils\": \"^0.2.0\",\n    \"@m0saic/types\": \"^0.2.0\"\n  },\n  \"devDependencies\": {\n    \"@m0saic/knowledge\": \"^0.2.0\",\n    \"@m0saic/templates\": \"^0.2.0\",\n    \"@types/jest\": \"^30.0.0\",\n    \"@types/node\": \"^25.3.3\",\n    \"eslint\": \"^9.39.0\",\n    \"jest\": \"^30.2.0\",\n    \"rimraf\": \"^6.1.3\",\n    \"ts-jest\": \"^29.4.6\",\n    \"typescript\": \"^5.9.3\",\n    \"typescript-esli