":"C:\\src\\m0saic-production\\one-a-day\\src\\community\\qsl-card\\v1\\qsl-card.ts","hunks":[{"oldStart":18,"oldLines":8,"newStart":18,"newLines":6,"lines":["  * FREQ \"14.074\" in MHz), and the card prints it the way a QSL does","  * (\"03 OCT 2026\", \"14:32\"). BAND is not a prop: it is DERIVED from FREQ with","  * the ADIF 3.1.6 band enumeration, so the two can never disagree on a card.","- * The record sits in a ruled form - every cell boxed by thin ink rules, the","- * label in its corner - the look of a pre-printed QSL filled in by hand.","  *","  * The rule that bites: a callsign is never ellipsized. A card with half a","  * call on it confirms nothing. The station call is sized from its own text"]},{"oldStart":449,"oldLines":44,"newStart":447,"newLines":37,"lines":["     // BAND is derived from FREQ, so nothing binds it.","     band: { text: p.band, bind: null }, mode: { text: p.mode, bind: \"mode\" }, rst: { text: p.rst, bind: \"rstSent\" },","   };","-  // Variant c: the table is a printed form. Every cell is boxed by thin ink","-  // rules (1/400 of the short side), the label in the box's top-left corner,","-  // the value under it - the look of a pre-printed QSL filled in by hand.","-  const tablePad = Math.round(S * 0.02), boxTop = tableY + tablePad, boxBottom = tableY + th - Math.round(S * 0.02);","-  const ink = Math.max(1, Math.round(S / 400)), cp = Math.round(S * 0.016);","-  const rowH = Math.floor((boxBottom - boxTop) / grid.rows);","-  const labelH = Math.round(rowH * 0.32);","-  const lift = Math.round(cp * 0.4), valueH = rowH - ink - labelH - lift - Math.round(cp * 0.6);","+  // The table starts a little below the strip, so its first label never reads as part of the line above.","+  const tablePad = Math.round(S * 0.02), rowH = Math.floor((th - tablePad) / grid.rows);","+  const labelH = Math.round(rowH * 0.3), accentRule = Math.max(1, Math.round(S / 300));","+  const valueH = rowH - labelH - accentRule - Math.round(rowH * 0.06);","+  const colGap = Math.round(S * 0.035);","   const cellsAt = (c: number) => QSL_COLUMNS.filter((_, i) => i % grid.cols === c);","   // Hierarchy: the station call is at least twice a table value, the worked call at least one.","   const valueTop = Math.min(Math.round(valueH * 0.7), Math.floor(callPx / 2), workedPx, Math.round(S * 0.11));","-  const labelPxOf = (px: number) => Math.max(floor, Math.min(Math.round(labelH * 0.55), Math.round(px * 0.45)));","+  const labelPxOf = (px: number) => Math.max(floor, Math.min(Math.round(labelH * 0.6), Math.round(px * 0.5)));","   const colNeed = (px: number) => Array.from({ length: grid.cols }, (_, c) =>","-    2 * ink + 2 * cp + Math.max(...cellsAt(c).map((k) => Math.max(need(values[k].text, px, true), need(COLUMN_LABEL[k], labelPxOf(px), false)))));","-  const valuePx = largest(valueTop, CW - ink, (px) => colNeed(px).reduce((a, b) => a + b, 0));","+    Math.max(...cellsAt(c).map((k) => Math.max(need(values[k].text, px, true), need(COLUMN_LABEL[k], labelPxOf(px), false)))));","+  const valuePx = largest(valueTop, CW, (px) => colNeed(px).reduce((a, b) => a + b, 0) + (grid.cols - 1) * colGap);","   if (valuePx < floor) unfit(\"the QSO table\");","   const labelPx = labelPxOf(valuePx);","   const needs = colNeed(valuePx), sumNeed = needs.reduce((a, b) => a + b, 0);","-  const spare = CW - ink - sumNeed;","+  const spare = CW - sumNeed - (grid.cols - 1) * colGap;","   const colX: number[] = [], colW: number[] = [];","   let x = m;","   needs.forEach((n, c) => {","-    // The spare width is shared equally, so the boxes keep one rhythm; the content weights the rest.","+    // The spare width is shared equally, so the gutters read as one rhythm; the content weights the rest.","     const w = c === grid.cols - 1 ? m + CW - x : n + Math.floor(spare / grid.cols);","-    colX.push(x); colW.push(w); x += w;","+    colX.push(x); colW.push(w); x += w + colGap;","   });","-  const tableH = grid.rows * rowH;","-  for (let r = 0; r <= grid.rows; r++) {","-    tiles.push({ label: `form-h-${r}`, rect: { x: m, y: r === grid.rows ? boxTop + tableH - ink : boxTop + r * rowH, w: CW, h: ink }, color: INK as MosaicColor, radius: 0 });","-  }","-  for (let c = 0; c <= grid.cols; c++) {","-    tiles.push({ label: `form-v-${c}`, rect: { x: c === grid.cols ? m + CW - ink : colX[c], y: boxTop, w: ink, h: tableH }, color: INK as MosaicColor, radius: 0 });","+  for (let r = 0; r < grid.rows; r++) {","+    const ry = tableY + tablePad + r * rowH;","+    tiles.push({ label: `label-rule-${r}`, rect: { x: m, y: ry + labelH, w: CW, h: accentRule }, color: p.accent, radius: 0 });","   }","   QSL_COLUMNS.forEach((k, i) => {","-    const r = Math.floor(i / grid.cols), c = i % grid.cols, ry = boxTop + r * rowH + ink;","-    const inner = { x: colX[c] + ink + cp, w: colW[c] - 2 * ink - 2 * cp };","-    line(`col-label-${k}`, { ...inner, y: ry + lift, h: labelH }, COLUMN_LABEL[k], labelPx, { color: DIM as MosaicColor, field: \"the QSO table labels\" });","-    line(`col-value-${k}`, { ...inner, y: ry + lift + labelH, h: valueH }, values[k].text, valuePx, { bold: true, bind: values[k].bind, field: \"the QSO table\" });","+    const r = Math.floor(i / grid.cols), c = i % grid.cols, ry = tableY + tablePad + r * rowH;","+    line(`col-label-${k}`, { x: colX[c], y: ry, w: colW[c], h: labelH }, COLUMN_LABEL[k], labelPx, { color: DIM as MosaicColor, field: \"the QSO table labels\" });","+    line(`col-value-${k}`, { x: colX[c], y: ry + labelH + accentRule, w: colW[c], h: valueH }, values[k].text, valuePx, { bold: true, bind: values[k].bind, field: \"the QSO table\" });","   });"," ","   // ── footer: QSLMSG on the left, the card's small mark on the right (dropped when it costs fit) ──"]},{"oldStart":582,"oldLines":7,"newStart":573,"newLines":7,"lines":["   id: asTemplateId(ID),","   label: \"2026-10-03 · Ham Radio QSL Card\",","   version: 1,","-  description: \"A ham radio QSL card for one contact, from one ADIF log record: props named after th