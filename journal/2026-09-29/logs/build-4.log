e string reads as n x n. */","   grid?: string;","-  /** Clue ids to mark and list (\"17A 3D\"), spaces or commas. \"\" = none. */","+  /** Clue ids to tint and list (\"17A 3D\"), spaces or commas. \"\" = none. */","   themeEntries?: string;","   /** 0-based row-major cell indices to ring (the .puz order). \"\" = none. */","   circles?: string;"]},{"oldStart":45,"oldLines":7,"newStart":45,"newLines":7,"lines":["   publication?: string;","   /** CrosswordPuzzle date, YYYY-MM-DD. */","   date?: string;","-  /** false = the teaser: no letters, no theme bars, no answer list. */","+  /** false = the teaser: no letters, no theme tint, no answer list. */","   solved?: boolean;","   /** Theme-cell fill and list swatches (#rrggbb). Never used as text ink. */","   themeColor?: string;"]},{"oldStart":93,"oldLines":7,"newStart":93,"newLines":7,"lines":["   themeEntries: {","     type: \"string\",","     required: false,","-    description: 'Clue ids to mark and list, e.g. \"17A 38A 3D\" (spaces or commas). Each must exist in the grid numbering; at most 8. \"\" for none.',","+    description: 'Clue ids to tint and list, e.g. \"17A 38A 3D\" (spaces or commas). Each must exist in the grid numbering; at most 8. \"\" for none.',","     meta: { control: { placeholder: \"17A 38A 61A\" }, ui: { label: \"Theme entries\", order: 2 } },","   },","   circles: {"]},{"oldStart":129,"oldLines":13,"newStart":129,"newLines":13,"lines":["   solved: {","     type: \"boolean\",","     required: false,","-    description: \"true = the solution card. false = the new-puzzle teaser: blocks, numbers and circles only; letters, theme bars and answers are hidden.\",","+    description: \"true = the solution card. false = the new-puzzle teaser: blocks, numbers and circles only; letters, theme tint and answers are hidden.\",","     meta: { ui: { label: \"Show solution\", order: 8 } },","   },","   themeColor: {","     type: \"string\",","     required: false,","-    description: \"Theme-entry bars and list swatches as #rrggbb. Letters stay in ink.\",","+    description: \"Theme-cell fill and list swatches as #rrggbb. Letters stay in ink.\",","     meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: CROSSWORD_DEFAULTS.themeColor }, ui: { label: \"Theme color\", order: 9 } },","   },","   debugLayout: {"]},{"oldStart":646,"oldLines":28,"newStart":646,"newLines":22,"lines":[" ","   // 1. paper under the whole board.","   add(ink, 1, tag(makeColorTile(PAPER), \"board-paper\"));","-  // 2. theme marks (variant b): the cells stay paper; a bar runs along the bottom of an across","-  // entry's cells and down the left of a down entry's, under the rules so each cell keeps its box.","-  const themeCells: number[] = [];","-  const themed = p.solved ? p.themes : [];","-  if (themed.length > 0) {","-    const bar = Math.max(2, Math.round(B.pitch * 0.14));","-    const path = themed.map((t) => {","-      const first = t.cells[0], last = t.cells[t.cells.length - 1];","-      const r0 = Math.floor(first / pz.cols), c0 = first % pz.cols, r1 = Math.floor(last / pz.cols), c1 = last % pz.cols;","-      const q = t.dir === \"A\"","-        ? local({ x: B.X[c0], y: B.Y[r0 + 1] - Math.floor(B.rule / 2) - bar, w: B.X[c1 + 1] - B.X[c0], h: bar })","-        : local({ x: B.X[c0] + Math.ceil(B.rule / 2), y: B.Y[r0], w: bar, h: B.Y[r1 + 1] - B.Y[r0] });","+  // 2. theme tint: the lattice cells of every theme entry (a crossing cell once).","+  const themeCells = [...new Set(p.solved ? p.themes.flatMap((t) => t.cells) : [])].sort((a, b) => a - b);","+  if (themeCells.length > 0) {","+    const path = themeCells.map((i) => {","+      const r = Math.floor(i / pz.cols), c = i % pz.cols;","+      const q = local({ x: B.X[c], y: B.Y[r], w: B.X[c + 1] - B.X[c], h: B.Y[r + 1] - B.Y[r] });","       return `M${q.x} ${q.y}h${q.w}v${q.h}h${-q.w}z`;","     }).join(\"\");","-    add(ink, 2, masked(p.themeColor, ink, path, \"theme-marks\"));","+    add(ink, 2, masked(p.themeColor, ink, path, \"theme-tint\"));","   }","   // 3. ink: the board minus every paper cell = the border, the rules and the blocks in one path.","   const holes = pz.cells.map((ch, i) => (ch === null ? \"\" : (() => { const q = local(B.hole(i)); return `M${q.x} ${q.y}v${q.h}h${q.w}v${-q.h}z`; })())).join(\"\");","   // The board is the puzzle's handle: a double-click opens the grid first, then what marks it.","   const marks = p.solved ? [{ propKey: \"grid\" }, { propKey: \"themeEntries\" }, { propKey: \"circles\" }, { propKey: \"themeColor\" }] : [{ propKey: \"grid\" }, { propKey: \"circles\" }];","   add(ink, 3, bindProps(masked(INK, ink, `M0 0H${ink.w}V${ink.h}H0Z${holes}`, \"board\"), marks));","-  // 4. rings, over the bars and under the letter.","+  // 4. rings, over the tint and under the letter.","   if (p.circles.length > 0) {","     const path = p.circles.map((i) => {","       const q = local(B.hole(i));"]},{"oldStart":762,"oldLines":8,"newStart":756,"newLines":8,"lines":["     \"https://github.com/viresh-ratnakar/exet\"","   ],","   \"solution\": [","-    \"Paste the solution rows from the puzzle file (puzpy's p.solution pastes as is). The card derives the clue numbers, reads each theme answer from the grid, marks it with a bar and lists it, and writes the caption line, so every grid on a blog looks the same. solved=false hides the letters for a new-puzzle teaser.\",","-    \"The decision that matters: the board is a few masked layers (paper, theme bars, ink with the paper cells cut out, rings) plus one text source for every letter and one for every number, all on one integer lattice. A 25x25 takes no more layers than a 7x7 (8 at most), and every size from 3 to 25 renders the same way.\",","+    \"Paste the solution rows from the puzzle file (puzpy's p.solution pastes as is). The card derives the clue numbers, reads each theme answer from the grid, tints it and lists it, and writes the caption line, so every grid on a blog looks the same. solved=false hides the letters for a new-puzzle teaser.\",","+    \"The decision that matters: the board is a few masked layers (paper, theme tint, ink with the paper cells cut out, rings) plus one text source for every letter and one for every number, all on one integer lattice. A 25x25 takes no more layers than a 7x7 (8 at most), and every size from 3 to 25 renders the same way.\",","   ],","   \"usage\": {","     \"command\": \"m0saic make @one-a-day/gaming/crossword-grid-card/v1 --template-repo . -w 1080 -h 1080 -o grid.png\","]},{"oldStart":771,"oldLines":7,"newStart":765,"newLines":7,"lines":["       \"grid: the .puz solution string, or rows split by \\\"/\\\" (\\\"#\\\" or \\\".\\\" is a block)\",","       \"themeEntries: \\\"17A 38A 61A\\\" - the ids your write-up already lists\",","       \"circles: \\\"14 15 16\\\" - 0-based cell indices, the .puz order\",","-      \"solved: false - the new-puzzle teaser, no letters, bars or answers\"","+      \"solved: false - the new-puzzle teaser, no letters, tint or answers\"","     ]","   },","   \"caveats\": ["]},{"oldStart":809,"oldLines":7,"newStart":803,"newLines":7,"lines":["   id: asTemplateId(ID),","   label: \"2026-09-29 · Crossword Grid Card\",","   version: 1,","-  description: \"Crossword Grid Card: the solved grid for a crossword write-up from the puzzle's own fields - blocks, derived clue numbers, circles, theme entries barred and listed, and the caption line. solved=false makes the teaser.\",","+  description: \"Crossword Grid Card: the solved grid for a crossword write-up from the puzzle's own fields - blocks, derived clue numbers, circles, theme entries tinted and listed, and the caption line. solved=false makes the teaser.\",","   capabilities: { tier: \"core\" },","   tags: [\"gaming\", \"2026-09-29\", \"day-010\", \"crossword\", \"puzzle\", \"share-card\"],"," "]}]}],"moreFiles":0,"changedFiles":["C:\\src\\m0saic-production\\one-a-day\\src\\gaming\\crossword-grid-card\\v1\\crossword-grid-card.test.ts","C:\\src\\m0saic-p