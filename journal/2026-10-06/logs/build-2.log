{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014VrqAkphM3JFYG4UPvutZs","type":"tool_result","content":"230\t    const noun = kind === \"R\" ? \"runner\" : \"volunteer\";\n231\t    return { kind, club, count, caption: `${count} ${noun}${count === 1 ? \"\" : \"s\"}` };\n232\t  });\n233\t  return out.sort((a, b) => (a.kind === b.kind ? a.club - b.club : a.kind === \"R\" ? -1 : 1));\n234\t}\n235\t\n236\t/** The counts object: exactly the six keys, whole numbers, and the sanity checks a results page always passes. */\n237\texport function parseCounts(value: unknown): RunCounts {\n238\t  if (typeof value !== \"object\" || value === null || Array.isArray(value)) fail(\"counts\", `must be an object with the keys ${COUNT_KEYS.join(\", \")}.`);\n239\t  const obj = value as Record<string, unknown>;\n240\t  for (const k of Object.keys(obj)) {\n241\t    if (!(COUNT_KEYS as readonly string[]).includes(k)) fail(\"counts\", `has an unknown key '${k}'; use ${COUNT_KEYS.join(\", \")}.`);\n242\t  }\n243\t  const out = {} as RunCounts;\n244\t  for (const k of COUNT_KEYS) {\n245\t    if (!(k in obj)) fail(\"counts\", `is missing '${k}'; give all six counts (${COUNT_KEYS.join(\", \")}). The card never invents a number.`);\n246\t    const v = obj[k];\n247\t    if (typeof v !== \"number\" || !Number.isInteger(v) || v < 0 || v > MAX_COUNT) fail(`counts.${k}`, `must be a whole number from 0 to ${MAX_COUNT}, got ${JSON.stringify(v)}.`);\n248\t    out[k] = v;\n249\t  }\n250\t  if (out.finishers < 1) fail(\"counts.finishers\", \"must be at least 1: a run with no finishers has no results to report.\");\n251\t  for (const k of [\"newPbs\", \"firstTimers\", \"visitors\"] as const) {\n252\t    if (out[k] > out.finishers) fail(`counts.${k}`, `is ${out[k]}, more than the ${out.finishers} finishers.`);\n253\t  }\n254\t  if (out.firstTimeVolunteers > out.volunteers) fail(\"counts.firstTimeVolunteers\", `is ${out.firstTimeVolunteers}, more than the ${out.volunteers} volunteers.`);\n255\t  return out;\n256\t}\n257\t\n258\tfunction luminance(hex: string): number {\n259\t  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n260\t  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n261\t}\n262\texport function contrast(a: string, b: string): number {\n263\t  const la = luminance(a), lb = luminance(b);\n264\t  return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);\n265\t}\n266\t/** The readable ink on a filled badge: white or the ink, whichever contrasts more. */\n267\tfunction onColor(fill: string): MosaicColor {\n268\t  return (contrast(fill, \"#ffffff\") >= contrast(fill, INK) ? \"#ffffff\" : INK) as MosaicColor;\n269\t}\n270\t\n271\t/** Edit distance, for \"did you mean\" on a misspelled prop. */\n272\tfunction distance(a: string, b: string): number {\n273\t  const d = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array<number>(b.length).fill(0)]);\n274\t  for (let j = 1; j <= b.length; j++) d[0][j] = j;\n275\t  for (let i = 1; i <= a.length; i++) for (let j = 1; j <= b.length; j++) d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));\n276\t  return d[a.length][b.length];\n277\t}\n278\t\n279\t/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n280\texport function normalizeWeeklyRunReport(props: WeeklyRunReportProps) {\n281\t  // A prop the card does not know is refused by name: \"count\" for \"counts\" would\n282\t  // otherwise leave the sample week's invented numbers on a real event's card.\n283\t  const known = Object.keys(DEFAULTS);\n284\t  for (const k of Object.keys(props ?? {})) {\n285\t    if (known.includes(k)) continue;\n286\t    const near = known.find((n) => distance(n.toLowerCase(), k.toLowerCase()) <= 2);\n287\t    fail(\"props\", `has an unknown prop '${k}'${near ? `; did you mean '${near}'?` : \".\"} The props are ${known.join(\", \")}.`);\n288\t  }\n289\t  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) } as typeof DEFAULTS;\n290\t  const eventName = drawn(p.eventName, \"eventName\", 40, false);\n291\t  const title = eventName.toUpperCase();\n292\t  if (!DRAWN.test(title)) fail(\"eventName\", `${JSON.stringify(eventName)} has a letter whose capital the card's font is not known to draw.`);\n293\t  const runNumber = p.runNumber as unknown;\n294\t  if (typeof runNumber !== \"number\" || !Number.isInteger(runNumber) || runNumber < 1 || runNumber > MAX_COUNT) fail(\"runNumber\", `must be a whole number from 1 to ${MAX_COUNT}, got ${JSON.stringify(runNumber)}.`);\n295\t  if (typeof p.date !== \"string\") fail(\"date\", \"must be a string.\");\n296\t  const dateText = p.date.trim();\n297\t  const date = dateText === \"\" ? \"\" : formatRunDate(dateText);\n298\t  if (date === null) fail(\"date\", `${JSON.stringify(dateText)} is not a date: YYYY-MM-DD, a real calendar day (e.g. \"2026-10-03\").`);\n299\t  const counts = parseCounts(p.counts);\n300\t  if (typeof p.milestones !== \"string\") fail(\"milestones\", \"must be a string.\");\n301\t  const milestones = parseMilestones(p.milestones);\n302\t  // Everyone who reached a run club finished this week, everyone who reached a volunteer club volunteered.\n303\t  const runners = milestones.filter((b) => b.kind === \"R\").reduce((a, b) => a + b.count, 0);\n304\t  const helpers = milestones.filter((b) => b.kind === \"V\").reduce((a, b) => a + b.count, 0);\n305\t  if (runners > counts.finishers) fail(\"milestones\", `count ${runners} runners reaching a club, more than the ${counts.finishers} finishers.`);\n306\t  if (helpers > counts.volunteers) fail(\"milestones\", `count ${helpers} volunteers reaching a club, more than the ${counts.volunteers} volunteers.`);\n307\t  // No length cap: the footer shrinks alone to the floor and is refused there (the fit ladder).\n308\t  const footer = drawn(p.footer, \"footer\", Number.POSITIVE_INFINITY, true);\n309\t  if (typeof p.accent !== \"string\") fail(\"accent\", \"must be a string.\");\n310\t  const accentText = p.accent.trim() === \"\" ? DEFAULT_ACCENT : p.accent.trim();\n311\t  if (!/^#[0-9a-fA-F]{6}$/.test(accentText)) fail(\"accent\", `${JSON.stringify(accentText)} must be #rrggbb.`);\n312\t  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n313\t  const accent = accentText.toLowerCase() as MosaicColor;\n314\t  // The headline numbers take the accent only while it reads on the tile.\n315\t  const heroInk = (contrast(accent, TILE) >= 4.5 ? accent : INK) as MosaicColor;\n316\t  return { title, eventName, runNumber, runText: `#${runNumber}`, date, counts, milestones, footer, accent, heroInk, debugLayout: p.debugLayout };\n317\t}\n318\t\n319\t/* ── geometry ── */\n320\t\n321\texport type ReportRect = { x: number; y: number; w: number; h: number };\n322\ttype Bind = { prop: \"eventName\" | \"runNumber\" | \"date\" | \"footer\" } | { prop: \"counts\"; key: CountKey } | null;\n323\t/** `group`: the child document a tile and its text are drawn in (see render). */\n324\ttype Cell = { label: string; rect: ReportRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean; group?: string };\n325\ttype Tile = { label: string; rect: ReportRect; color: MosaicColor; radius: number; bind?: \"accent\" | \"milestones\"; group?: string };\n326\t/** A child document: one tile or badge with its text, on its own small canvas. */\n327\texport type ReportGroup = { key: string; label: \"hero-tile\" | \"stat-tile\" | \"badge\"; rect: ReportRect };\n328\t\n329\t/** The largest 5-smooth number (2^a 3^b 5^c) at or below `n`. */\n330\tfunction smoothDown(n: number): number {\n331\t  for (let v = Math.max(1, Math.floor(n)); v >= 1; v--) {\n332\t    let k = v;\n333\t    for (const f of [2, 3, 5]) while (k % f === 0) k /= f;\n334\t    if (k === 1) return v;\n335\t  }\n336\t  return 1;\n337\t}\n338\t/** The parent's placement lattice (px per step on each axis); 1 = exact. */\n339\texport type Pitch = { x: number; y: number };\n340\t/**\n341\t * Equal rects for a group of equal slots, each ON the parent lattice with\n342\t * 5-smooth sides, centred on its slot and never larger than it. `slack` is how\n343\t * far a rect may lean into the gap around its slot to reach a lattice line, so\n344\t * an unlucky slot start does not cost a whole smooth step.\n345\t * Why: each tile is a child document. A child on a rough canvas fails\n346\t * `latticeSmooth`, and a child ref off the lattice gets a recovery inset that\n347\t * the layout checker's flatten does not apply, so it would judge the tiles\n348\t * unequal although the engine draws them equal.\n349\t */\n350\tfunction snapGroup(slots: ReportRect[], pitch: Pitch, slack: number): ReportRect[] {\n351\t  const span = (pos: number, len: number, step: number) => {\n352\t    const lo = Math.ceil((pos - slack) / step) * step, hi = Math.floor((pos + len + slack) / step) * step;\n353\t    return { lo, hi, steps: Math.floor(Math.min(len, hi - lo) / step) };\n354\t  };\n355\t  const kx = smoothDown(Math.min(...slots.map((r) => span(r.x, r.w, pitch.x).steps)));\n356\t  const ky = smoothDown(Math.min(...slots.map((r) => span(r.y, r.h, pitch.y).steps)));\n357\t  const place = (pos: number, len: number, size: number, step: number) => {\n358\t    const { lo, hi } = span(pos, len, step);\n359\t    const centred = Math.round((pos + len / 2 - size / 2) / step) * step;\n360\t    return Math.max(lo, Math.min(hi - size, centred));\n361\t  };\n362\t  return slots.map((r) => {\n363\t    const w = kx * pitch.x, h = ky * pitch.y;\n364\t    return { x: place(r.x, r.w, w, pitch.x), y: place(r.y, r.h, h, pitch.y), w, h };\n365\t  });\n366\t}\n367\t\n368\t/** The cell width a line needs at `px` under the fit rule (`cell * 0.94 - 2px`). */\n369\tfunction need(text: string, px: number, bold: boolean): number {\n370\t  return Math.ceil((widthOf(text, px, bold) + 2) / 0.94) + 1;\n371\t}\n372\t/** One line in a cell: the largest whole size up to `maxPx` that fits the cell's budget. */\n373\tfunction fitPx(line: string, cellW: number, maxPx: number, bold: boolean): number {\n374\t  const top = Math.max(1, Math.floor(maxPx)), room = budget(cellW), w = widthOf(line, top, bold);\n375\t  let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n376\t  while (px > 1 && widthOf(line, px, bold) > room) px--;\n377\t  return px;\n378\t}\n379\t/** The line box a size needs (the font's ascent + descent with a little air). */\n380\tconst lineH = (px: number) => Math.ceil(px * 1.22);\n381\t\n382\t/** Split a name at the space nearest its middle; null when it has no space. */\n383\tfunction splitTwo(text: string): [string, string] | null {\n384\t  const spaces = [...text].map((ch, i) => (ch === \" \" ? i : -1)).filter((i) => i > 0);\n385\t  if (spaces.length === 0) return null;\n386\t  const mid = text.length / 2;\n387\t  const at = spaces.reduce((best, i) => (Math.abs(i - mid) < Math.abs(best - mid) ? i : best), spaces[0]);\n388\t  return [text.slice(0, at).trim(), text.slice(at + 1).trim()];\n389\t}\n390\t\n391\t/**\n392\t * Every rect of the card for one canvas. Pure: same props, canvas and pitch,\n393\t * same rects. `pitch` is the parent's placement lattice (render finds it, see\n394\t * `settleLayout`); tiles and badges snap to it.\n395\t */\n396\texport function layoutWeeklyRunReport(props: WeeklyRunReportProps, W: number, H: number, pitch: Pitch = { x: 1, y: 1 }) {\n397\t  const p = normalizeWeeklyRunReport(props);\n398\t  const S = Math.min(H, 0.75 * W);\n399\t  const shape: \"wide\" | \"square\" | \"tall\" = W * 10 >= H * 13 ? \"wide\" : W * 10 >= H * 8 ? \"square\" : \"tall\";\n400\t  const floor = Math.max(6, Math.round(S * 0.022));\n401\t  /** Badge copy may go smaller than the page floor: it is short and sits on its own tile. */\n402\t  const small = Math.max(6, Math.round(S * 0.014));\n403\t  const unfit = (field: string, min = floor): never => fail(field, `cannot be fitted on ${W}x${H} above the ${min}px readability floor: shorten it or render a larger canvas.`);\n404\t\n405\t  const m = Math.round(S * 0.05), gap = Math.max(2, Math.round(S * 0.025));\n406\t  const CW = W - 2 * m, top = m, CH = H - 2 * m;\n407\t  // Square tiles: a rounded corner inside a child shows the child canvas, whose cream encodes a shade off the page.\n408\t  const tileRadius = 0, badgeRadius = 0.18;\n409\t\n410\t  const cells: Cell[] = [];\n411\t  const tiles: Tile[] = [];\n412\t  const groups: ReportGroup[] = [];\n413\t  const line = (label: string, rect: ReportRect, text: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string; min?: number; group?: string } = {}) => {\n414\t    if (px < (o.min ?? floor)) unfit(o.field ?? label, o.min ?? floor);\n415\t    cells.push({ label, rect, text, px, width: widthOf(text, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? (INK as MosaicColor), bind: o.bind ?? null, over: o.over === true, group: o.group });\n416\t  };\n417\t\n418\t  // ── bands: the footer is sized by its line, the rest share the height by weight ──\n419\t  const footerDesign = Math.max(floor, Math.round(S * 0.028));\n420\t  const footerPx = p.footer === \"\" ? 0 : Math.min(footerDesign, fitPx(p.footer, CW, footerDesign, false));\n421\t  if (p.footer !== \"\" && footerPx < floor) unfit(\"footer\");\n422\t  const footerH = p.footer === \"\" ? 0 : lineH(footerDesign);\n423\t  const weights = shape === \"wide\" ? [0.16, 0.58, 0.26] : shape === \"square\" ? [0.16, 0.29, 0.25, 0.3] : [0.11, 0.28, 0.39, 0.22];\n424\t  const bandCount = weights.length + (p.footer === \"\" ? 0 : 1);\n425\t  let gapY = gap;\n426\t  const avail = CH - footerH - (bandCount - 1) * gapY;\n427\t  const sumW = weights.reduce((a, b) => a + b, 0);\n428\t  const hs = weights.map((w) => Math.floor((avail * w) / sumW));\n429\t  hs[hs.length - 1] += avail - hs.reduce((a, b) => a + b, 0);\n430\t\n431\t  // Tiles never become slabs: a tile at most 1.3x as tall as it is wide; the slack goes to the gaps.\n432\t  const halfW = Math.floor((CW - gap) / 2);\n433\t  if (shape === \"tall\") {\n434\t    let slack = 0;\n435\t    const heroCap = Math.floor(halfW * 1.3);\n436\t    if (hs[1] > heroCap) { slack += hs[1] - heroCap; hs[1] = heroCap; }\n437\t    const statCap = 2 * Math.floor(halfW * 1.3) + gap;\n438\t    if (hs[2] > statCap) { slack += hs[2] - statCap; hs[2] = statCap; }\n439\t    gapY += Math.floor(slack / (bandCount - 1));\n440\t  }\n441\t\n442\t  // ── header: the event name in capitals, the run number and date, the accent rule ──\n443\t  const headerY = top, headerH = hs[0];\n444\t  const ruleH = Math.max(2, Math.round(S * 0.006));\n445\t  const runDesign = Math.max(floor, Math.min(Math.round(headerH * 0.2), Math.round(S * 0.038)));\n446\t  const sepGap = (px: number) => Math.round(px * 0.55);\n447\t  const sepW = (px: number) => Math.max(1, Math.round(px * 0.09));\n448\t  // The separator sits on the drawn widths, so it is centred between \"#312\" and the date.\n449\t  const runTextW = (px: number) => Math.ceil(widthOf(p.runText, px, true));\n450\t  const runLineW = (px: number) => (p.date === \"\" ? need(p.runText, px, true) : runTextW(px) + 2 * sepGap(px) + sepW(px) + need(p.date, px, false));\n451\t  const runPx = Math.min(runDesign, (() => { let px = runDesign; while (px > 1 && runLineW(px) > CW) px--; return px; })());\n452\t  if (runPx < floor) unfit(\"date\");\n453\t  const runH = lineH(runPx);\n454\t  const nameRoom = headerH - ruleH - runH - Math.round(headerH * 0.08);\n455\t  const nameDesign = Math.min(Math.floor(nameRoom / 1.22), Math.round(S * 0.075));\n456\t  // Wide: the run line shares the name's line when both fit at full size.\n457\t  const nameDesignWide = Math.min(Math.floor((headerH - ruleH - Math.round(headerH * 0.12)) / 1.22 * 0.62), Math.round(S * 0.075));\n458\t  let nameLines: string[] = [p.title];\n459\t  let namePx = fitPx(p.title, CW, nameDesign, true);\n460\t  let runBeside = false;\n461\t  if (shape === \"wide\") {\n462\t    const besidePx = fitPx(p.title, CW - runLineW(runPx) - 2 * gap, nameDesignWide, true);\n463\t    if (besidePx >= Math.round(nameDesignWide * 0.85)) { runBeside = true; namePx = besidePx; }\n464\t  }\n465\t  if (!runBeside && namePx < Math.round(nameDesign * 0.7)) {\n466\t    // Reflow before shrinking further: two lines, split at the space nearest the middle.\n467\t    const two = splitTwo(p.title);\n468\t    if (two) {\n469\t      const twoPx = Math.min(Math.floor(nameRoom / (2 * 1.22)), fitPx(two[0], CW, nameDesign, true), fitPx(two[1], CW, nameDesign, true));\n470\t      if (twoPx > namePx) { nameLines = two; namePx = twoPx; }\n471\t    }\n472\t  }\n473\t  if (namePx < floor) unfit(\"eventName\");\n474\t  {\n475\t    const nh = lineH(namePx);\n476\t    if (runBeside) {\n477\t      const y = headerY + Math.round((headerH - ruleH - nh) / 2);\n478\t      line(\"event-name\", { x: m, y, w: need(p.title, namePx, true), h: nh }, p.title, namePx, { bold: true, bind: { prop: \"eventName\" }, field: \"eventName\" });\n479\t      runLine(m + CW - runLineW(runPx), headerY + Math.round((headerH - ruleH - runH) / 2), \"right\");\n480\t    } else {\n481\t      const blockH = nameLines.length * nh + runH;\n482\t      const y0 = headerY + Math.max(0, Math.round((headerH - ruleH - blockH) / 2 - headerH * 0.02));\n483\t      nameLines.forEach((t, i) => line(nameLines.length === 1 ? \"event-name\" : `event-name-${i + 1}`, { x: m, y: y0 + i * nh, w: need(t, namePx, true), h: nh }, t, namePx, { bold: true, bind: { prop: \"eventName\" }, field: \"eventName\" }));\n484\t      runLine(m, y0 + nameLines.length * nh, \"left\");\n485\t    }\n486\t    tiles.push({ label: \"header-rule\", rect