n35:     for (const prop of [\"teamNumber\", \"eventName\", \"weekLabel\", \"qualRank\", \"teamCount\", \"record\", \"districtPoints\", \"accent\"]) {\n36:       expect(byProp[prop]?.length ?? 0).toBeGreaterThanOrEqual(1);\n37:     }\n38:     expect(byProp.awards?.length ?? 0).toBe(1); // one award line at defaults\n39:     // Closed pickers never carry a rect binding - Make edits them from the panel.\n40:     expect(byProp.allianceRole ?? []).toHaveLength(0);\n41:     expect(byProp.playoffResult ?? []).toHaveLength(0);\n42:   });\n43: \n44:   it(\"clears its safe minimum at its own hint\", async () => {\n45:     const ev = evaluateM0(String((await render()).m0), { width: 1080, height: 1080 });\n46:     expect(ev.feasible && ev.meetsPrecision).toBe(true);\n47:     expect(FrcEventRecapV1.outputHints).toMatchObject({ width: 1080, height: 1080, format: { kind: \"image\" } });\n48:   });\n49: \n50:   it(\"keeps its layout contract at the seven contract canvases - defaults, the copy that stresses it, and every closed-set value\", async () => {\n51:     expect(layoutIntentOf(await render())).not.toBeNull();\n52:     const stressed = {\n53:       teamNumber: 99999,\n54:       teamName: \"IRON PANTHERS ROBOTICS CLUB 99\", // 30 characters\n55:       eventName: \"Harbor City District Championship\", // 33 of 40\n56:       weekLabel: \"Offseason - Remix\",\n57:       qualRank: 200,\n58:       teamCount: 200,\n59:       record: \"120-99-12\",\n60:       allianceRole: \"pick2\",\n61:       allianceNumber: 8,\n62:       playoffResult: \"quarterfinalist\",\n63:       awards: [\n64:         \"Excellence in Engineering Award sponsored by Delphi Company\", // 60 characters\n65:         \"Innovation in Control Award sponsored by Automation Direct\",\n66:         \"Regional Engineering Inspiration Award\",\n67:       ],\n68:       districtPoints: 999,\n69:     } as const;\n70:     const emptied = {\n71:       teamName: \"\",\n72:       weekLabel: \"\",\n73:       teamCount: 0,\n74:       allianceRole: \"none\",\n75:       playoffResult: \"none\",\n76:       awards: [],\n77:       districtPoints: 0,\n78:     } as const;\n79:     for (const over of [{}, stressed, emptied]) {\n80:       await sweepLayout(\n81:         (p, ctx) => FrcEventRecapV1.render(p, ctx).then(asDocument),\n82:         \"@one-a-day/sports/frc-event-recap/v1\",\n83:         { ...FrcEventRecapV1.defaultProps, ...over },\n84:         (w, h) => targetCtx(w, h),\n85:       );\n86:     }\n87:     expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n88:   });\n89: \n90:   it(\"shows the scout's cited TBA page as a finished card at defaults\", async () => {\n91:     const texts = textsOf(await render());\n92:     for (const t of [\"FRC EVENT RECAP\", \"TEAM 9128\", \"Harbor City District\", \" - Week 4\", \"RANK 1\", \"of 48 teams\", \"17-0-0\", \"W - L - T\", \"CAPTAIN - ALLIANCE 1\", \"EVENT WINNER\", \"AWARDS\", \"Innovation in Control Award\", \"78 DISTRICT POINTS\", \"DATA: THE BLUE ALLIANCE\"]) {\n93:       expect(texts).toContain(t);\n94:     }\n95:   });\n96: \n97:   it(\"derives the TBA-vocabulary copy\", () => {\n98:     expect(allianceChipText(\"captain\", 1)).toBe(\"CAPTAIN - ALLIANCE 1\");\n99:     expect(allianceChipText(\"pick1\", 4)).toBe(\"1ST PICK - ALLIANCE 4\");\n100:     expect(allianceChipText(\"pick2\", 8)).toBe(\"2ND PICK - ALLIANCE 8\");\n101:     expect(allianceChipText(\"none\", 1)).toBe(\"\");\n102:     expect(playoffChipText(\"winner\")).toBe(\"EVENT WINNER\");\n103:     expect(playoffChipText(\"finalist\")).toBe(\"FINALIST\");\n104:     expect(playoffChipText(\"semifinalist\")).toBe(\"SEMIFINALIST\");\n105:     expect(playoffChipText(\"quarterfinalist\")).toBe(\"QUARTERFINALIST\");\n106:     expect(playoffChipText(\"none\")).toBe(\"\");\n107:     expect(recordText(\"17-0-0\")).toBe(\"17-0-0\");\n108:     expect(() => recordText(\"17-0\")).toThrow(/record/);\n109:     expect(() => recordText(\"17/0/0\")).toThrow(/record/);\n110:     expect(rankSub(0)).toBe(\"\");\n111:     expect(rankSub(1)).toBe(\"of 1 team\");\n112:     expect(rankSub(48)).toBe(\"of 48 teams\");\n113:   });\n114: \n115:   it(\"drops the optional lines their props say to drop, and keeps the credit\", async () => {\n116:     const texts = textsOf(await render({ teamCount: 0, districtPoints: 0, allianceRole: \"none\", playoffResult: \"none\", awards: [], teamName: \"\", weekLabel: \"\" }));\n117:     expect(texts).not.toContain(\"of 48 teams\");\n118:     expect(texts.some((t) => t.includes(\"DISTRICT POINTS\"))).toBe(false);\n119:     expect(texts).not.toContain(\"CAPTAIN - ALLIANCE 1\");\n120:     expect(texts).not.toContain(\"EVENT WINNER\");\n121:     expect(texts).not.toContain(\"AWARDS\");\n122:     expect(texts).toContain(\"Harbor City District\"); // weekLabel removed, event stays\n123:     expect(texts).toContain(\"DATA: THE BLUE ALLIANCE\"); // the credit never leaves\n124:     const named = textsOf(await render({ teamName: \"Iron Panthers\" }));\n125:     expect(named).toContain(\"IRON PANTHERS\");\n126:   });\n127: \n128:   it(\"refuses impossible input by name\", async () => {\n129:     await expect(render({ qualRank: 12, teamCount: 10 })).rejects.toThrow(/qualRank is 12 but teamCount is 10/);\n130:     await expect(render({ record: \"17/0/0\" })).rejects.toThrow(/record \"17\\/0\\/0\" must be W-L-T digits/);\n131:     await expect(render({ allianceRole: \"captain\", allianceNumber: 9 })).rejects.toThrow(/allianceNumber must be from 1 to 8/);\n132:     await expect(render({ awards: [\"a\", \"b\", \"c\", \"d\"] })).rejects.toThrow(/awards has 4 lines; the card holds at most 3/);\n133:     await expect(render({ eventName: \"Harbor City — District\" })).rejects.toThrow(/eventName/);\n134:     await expect(render({ awards: [\"Excellence in Engineering Award sponsored by the Delphi Company C\"] })).rejects.toThrow(/awards line 1/);\n135:     await expect(render({ teamName: \"x\".repeat(31) })).rejects.toThrow(/teamName/);\n136:     await expect(render({ teamNumbr: 2471 } as never)).rejects.toThrow(/unknown prop 'teamNumbr'; did you mean 'teamNumber'\\?/);\n137:   });\n138: \n139:   it(\"is deterministic and validates the model without rendering\", async () => {\n140:     expect(await render()).toEqual(await render());\n141:     const m = normalizeFrcEventRecap({ allianceRole: \"pick1\", allianceNumber: 4, playoffResult: \"finalist\" });\n142:     expect(m.allianceChip).toBe(\"1ST PICK - ALLIANCE 4\");\n143:     expect(m.playoffChip).toBe(\"FINALIST\");\n144:     expect(m.pointsText).toBe(\"78 DISTRICT POINTS\");\n145:   });\n146: });\n\n(End of file - total 146 lines)\n</content>","metadata":{"preview":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { resolvePropBindings } from \"@m0saic/template-utils\";\nimport type { MosaicDocument } from \"@m0saic/types\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport {\n  FrcEventRecapV1,\n  allianceChipText,\n  normalizeFrcEventRecap,\n  playoffChipText,\n  rankSub,\n  recordText,\n} from \"./frc-event-recap\";\n\nconst render = (\n  props: Parameters<typeof FrcEventRecapV1.render>[0] = {},\n  w = 1080,\n  h = 1080,\n) => FrcEventRecapV1.render({ ...FrcEventRecapV1.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\frc-event-recap\\v1\\frc-event-recap.test.ts","text":"import { evaluateM0 } from \"@m0saic/dsl-stdlib\";\nimport { resolvePropBindings } from \"@m0saic/template-utils\";\nimport type { MosaicDocument } from \"@m0saic/types\";\n\nimport { asDocument, targetCtx } from \"../../../__testutils__/render\";\nimport { layoutIntentOf, sweepLayout } from \"../../../_shared/layout\";\nimport {\n  FrcEventRecapV1,\n  allianceChipText,\n  normalizeFrcEventRecap,\n  playoffChipText,\n  rankSub,\n  recordText,\n} from \"./frc-event-recap\";\n\nconst render = (\n  props: Parameters<typeof FrcEventRecapV1.render>[0] = {},\n  w = 1080,\n  h = 1080,\n) => FrcEventRecapV1.render({ ...FrcEventRecapV1.defaultProps, ...props }, targetCtx(w, h)).then(asDocument);\n\n/** Every literal text on the card (chip boxes and ticks carry none). */\nfunction textsOf(doc: MosaicDocument): string[] {\n  return (doc.sources ?? [])\n    .filter((s) => s && s.type === \"text\")\n    .flatMap((s) => (s.layers ?? []).map((l) => (l.content as { kind: string; text?: string }).text ?? \"\"))\n    .filter((t) => t !== \"\");\n}\n\ndescribe(\"@one-a-day/sports/frc-event-recap/v1\", () => {\n  it(\"binds the rects that show props - Make's double-click edits them in place\", async () => {\n    const doc = await render();\n    const { byProp, rejected } = resolvePropBindings(doc, 1080, 1080, { propsSchema: FrcEventRecapV1.propsSchema });\n    expect(rejected).toEqual([]);\n    for (const prop of [\"teamNumber\", \"eventName\", \"weekLabel\", \"qualRank\", \"teamCount\", \"record\", \"districtPoints\", \"accent\"]) {\n      expect(byProp[prop]?.length ?? 0).toBeGreaterThanOrEqual(1);\n    }\n    expect(byProp.awards?.length ?? 0).toBe(1); // one award line at defaults\n    // Closed pickers never carry a rect binding - Make edits them from the panel.\n    expect(byProp.allianceRole ?? []).toHaveLength(0);\n    expect(byProp.playoffResult ?? []).toHaveLength(0);\n  });\n\n  it(\"clears its safe minimum at its own hint\", async () => {\n    const ev = evaluateM0(String((await render()).m0), { width: 1080, height: 1080 });\n    expect(ev.feasible && ev.meetsPrecision).toBe(true);\n    expect(FrcEventRecapV1.outputHints).toMatchObject({ width: 1080, height: 1080, format: { kind: \"image\" } });\n  });\n\n  it(\"keeps its layout contract at the seven contract canvases - defaults, the copy that stresses it, and every closed-set value\", async () => {\n    expect(layoutIntentOf(await render())).not.toBeNull();\n    const stressed = {\n      teamNumber: 99999,\n      teamName: \"IRON PANTHERS ROBOTICS CLUB 99\", // 30 characters\n      eventName: \"Harbor City District Championship\", // 33 of 40\n      weekLabel: \"Offseason - Remix\",\n      qualRank: 200,\n      teamCount: 200,\n      record: \"120-99-12\",\n      allianceRole: \"pick2\",\n      allianceNumber: 8,\n      playoffResult: \"quarterfinalist\",\n      awards: [\n        \"Excellence in Engineering Award sponsored by Delphi Company\", // 60 characters\n        \"Innovation in Control Award sponsored by Automation Direct\",\n        \"Regional Engineering Inspiration Award\",\n      ],\n      districtPoints: 999,\n    } as const;\n    const emptied = {\n      teamName: \"\",\n      weekLabel: \"\",\n      teamCount: 0,\n      allianceRole: \"none\",\n      playoffResult: \"none\",\n      awards: [],\n      districtPoints: 0,\n    } as const;\n    for (const over of [{}, stressed, emptied]) {\n      await sweepLayout(\n        (p, ctx) => FrcEventRecapV1.render(p, ctx).then(asDocument),\n        \"@one-a-day/sports/frc-event-recap/v1\",\n        { ...FrcEventRecapV1.defaultProps, ...over },\n        (w, h) => targetCtx(w, h),\n      );\n    }\n    expect((await render({ debugLayout: true })).editor).toMatchObject({ layoutContract: { ok: true } });\n  });\n\n  it(\"shows the scout's cited TBA page as a finished card at defaults\", async () => {\n    const texts = textsOf(await render());\n    for (const t of [\"FRC EVENT RECAP\", \"TEAM 9128\", \"Harbor City District\", \" - Week 4\", \"RANK 1\", \"of 48 teams\", \"17-0-0\", \"W - L - T\", \"CAPTAIN - ALLIANCE 1\", \"EVENT WINNER\", \"AWARDS\", \"Innovation in Control Award\", \"78 DISTRICT POINTS\", \"DATA: THE BLUE ALLIANCE\"]) {\n      expect(texts).toContain(t);\n    }\n  });\n\n  it(\"derives the TBA-vocabulary copy\", () => {\n    expect(allianceChipText(\"captain\", 1)).toBe(\"CAPTAIN - ALLIANCE 1\");\n    expect(allianceChipText(\"pick1\", 4)).toBe(\"1ST PICK - ALLIANCE 4\");\n    expect(allianceChipText(\"pick2\", 8)).toBe(\"2ND PICK - ALLIANCE 8\");\n    expect(allianceChipText(\"none\", 1)).toBe(\"\");\n    expect(playoffChipText(\"winner\")).toBe(\"EVENT WINNER\");\n    expect(playoffChipText(\"finalist\")).toBe(\"FINALIST\");\n    expect(playoffChipText(\"semifinalist\")).toBe(\"SEMIFINALIST\");\n    expect(playoffChipText(\"quarterfinalist\")).toBe(\"QUARTERFINALIST\");\n    expect(playoffChipText(\"none\")).toBe(\"\");\n    expect(recordText(\"17-0-0\")).toBe(\"17-0-0\");\n    expect(() => recordText(\"17-0\")).toThrow(/record/);\n    expect(() => recordText(\"17/0/0\")).toThrow(/record/);\n    expect(rankSub(0)).toBe(\"\");\n    expect(rankSub(1)).toBe(\"of 1 team\");\n    expect(rankSub(48)).toBe(\"of 48 teams\");\n  });\n\n  it(\"drops the optional lines their props say to drop, and keeps the credit\", async () => {\n    const texts = textsOf(await render({ teamCount: 0, districtPoints: 0, allianceRole: \"none\", playoffResult: \"none\", awards: [], teamName: \"\", weekLabel: \"\" }));\n    expect(texts).not.toContain(\"of 48 teams\");\n    expect(texts.some((t) => t.includes(\"DISTRICT POINTS\"))).toBe(false);\n    expect(texts).not.toContain(\"CAPTAIN - ALLIANCE 1\");\n    expect(texts).not.toContain(\"EVENT WINNER\");\n    expect(texts).not.toContain(\"AWARDS\");\n    expect(texts).toContain(\"Harbor City District\"); // weekLabel removed, event stays\n    expect(texts).toContain(\"DATA: THE BLUE ALLIANCE\"); // the credit never leaves\n    const named = textsOf(await render({ teamName: \"Iron Panthers\" }));\n    expect(named).toContain(\"IRON PANTHERS\");\n  });\n\n  it(\"refuses impossible input by name\", async () => {\n    await expect(render({ qualRank: 12, teamCount: 10 })).rejects.toThrow(/qualRank is 12 but teamCount is 10/);\n    await expect(render({ record: \"17/0/0\" })).rejects.toThrow(/record \"17\\/0\\/0\" must be W-L-T digits/);\n    await expect(render({ allianceRole: \"captain\", allianceNumber: 9 })).rejects.toThrow(/allianceNumber must be from 1 to 8/);\n    await expect(render({ awards: [\"a\", \"b\", \"c\", \"d\"] })).rejects.toThrow(/awards has 4 lines; the card holds at most 3/);\n    await expect(render({ eventName: \"Harbor City — District\" })).rejects.toThrow(/eventName/);\n    await expect(render({ awards: [\"Excellence in Engineering Award sponsored by the Delphi Company C\"] })).rejects.toThrow(/awards line 1/);\n    await expect(render({ teamName: \"x\".repeat(31) })).rejects.toThrow(/teamName/);\n    await expect(render({ teamNumbr: 2471 } as never)).rejects.toThrow(/unknown prop 'teamNumbr'; did you mean 'teamNumber'\\?/);\n  });\n\n  it(\"is deterministic and validates the model without rendering\", async () => {\n    expect(await render()).toEqual(await render());\n    const m = normalizeFrcEventRecap({ allianceRole: \"pick1\", allianceNumber: 4, playoffResult: \"finalist\" });\n    expect(m.allianceChip).toBe(\"1ST PICK - ALLIANCE 4\");\n    expect(m.playoffChip).toBe(\"FINALIST\");\n    expect(m.pointsText).toBe(\"78 DISTRICT POINTS\");\n  });\n});","lineStart":1,"lineEnd":146,"totalLines":146,"truncated":false}},"title":"src\\sports\\frc-event-recap\\v1\\frc-event-recap.test.ts","time":{"start":1792681983739,"end":1792681983829}},"id":"prt_1642c3ee2001D3Svfe2mK07hg8","sessionID":"ses_e9bef9eb5ffei9kgkpy3SKTJAg","messageID":"msg_1642bfc230016mBeKgrCXMKTzj"}}
