<?xml version="1.0" encoding="UTF-16"?>
<!-- Windows Task Scheduler: schtasks /Create /TN "one-a-day" /XML pipeline\schedule\one-a-day.task.xml -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>one-a-day: one m0saic template a day, agent-run.</Description></RegistrationInfo>
  <Triggers>
    <CalendarTrigger><StartBoundary>2026-09-21T02:00:00</StartBoundary><Enabled>true</Enabled><ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay></CalendarTrigger>
  </Triggers>
  <Settings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <ExecutionTimeLimit>PT6H</ExecutionTimeLimit>
    <WakeToRun>true</WakeToRun>
    <StartWhenAvailable>true</StartWhenAvailable>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -Command "$env:ONE_A_DAY_AGENT='claude'; $env:M0SAIC_TELEMETRY='ghost'; $env:M0SAIC_NO_UPDATE_CHECK='1'; Set-Location $HOME\src\one-a-day; node pipeline/run.mjs *&gt;&gt; ($HOME + '\one-a-day-logs\' + (Get-Date -Format yyyy-MM-dd) + '.console.log')"</Arguments>
    </Exec>
  </Actions>
</Task>
