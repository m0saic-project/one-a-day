{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Mn6AdUEwmxpHFwNY7yAm7","type":"tool_result","content":"1\timport type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\n2\timport { asTemplateId } from \"@m0saic/types\";\n3\timport { toM0String } from \"@m0saic/dsl-stdlib\";\n4\timport { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag, wrapMeasured } from \"@m0saic/template-utils\";\n5\timport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\n6\timport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\n7\timport { budget, textCell, widthOf } from \"../../../_shared/text\";\n8\timport { whyTutorial } from \"../../../_shared/why\";\n9\timport type { WhySpec } from \"../../../_shared/why\";\n10\t\n11\t/**\n12\t * `@one-a-day/sports/cubing-average-card/v1` - one speedcubing average as a\n13\t * card: the solves as bars, the dropped best and worst in parentheses with a\n14\t * hollow bar, the average as the headline, and the delta against the old PB.\n15\t *\n16\t * ONE CONCEPT: the headline is COMPUTED, and the dropped solves stay on the\n17\t * card. The user gives the solves; the count decides the kind (3 is a Mo3, 5\n18\t * an Ao5, 12 an Ao12), so a \"Mo3\" label over five solves cannot happen. The\n19\t * best and the worst are dropped (Ao5, Ao12), printed in parentheses and\n20\t * drawn hollow; the average is the mean of what is left. Each bar says what\n21\t * the footnote says: its distance from the average (`bar: \"spread\"`, the\n22\t * default: left = faster, who carried the average and who dragged it) or its\n23\t * length from zero (`bar: \"length\"`, the slowest fills the track, where a\n24\t * 24-32 second session draws five near-identical bars).\n25\t *\n26\t * The rule that bites: all arithmetic is integer hundredths of a second. The\n27\t * average is rounded to the nearest hundredth with halves going UP, as\n28\t * floor((2 * sum + n) / (2 * n)); a float sum prints 28.34 for a 28.345\n29\t * average. (This is the rounding the template chose; it does not cite a\n30\t * regulation.) A DNF is always the worst solve; the average is DNF when a\n31\t * DNF is still among the counting solves (two DNFs in an Ao5 or Ao12, one in\n32\t * a Mo3). A slower average is printed with a plus sign in the ordinary ink:\n33\t * no warning colour, no chip.\n34\t */\n35\t\n36\texport type CubingBar = \"length\" | \"spread\";\n37\texport type CubingAverageCardProps = {\n38\t  /** The event next to the kind chip: \"3x3\", \"OH\", \"3BLD\". \"\" removes it. */\n39\t  event?: string;\n40\t  /** The solves in the order they were made: 3 (Mo3), 5 (Ao5) or 12 (Ao12) strings. */\n41\t  solves?: string[];\n42\t  /** The previous PB for the same kind of average, as a time; \"\" or \"DNF\" means none. */\n43\t  previousPb?: string;\n44\t  /** The handle or name under the event. \"\" removes it. */\n45\t  cuber?: string;\n46\t  /** A free line next to the name. \"\" removes it. */\n47\t  date?: string;\n48\t  /** What a bar means: its length from zero, or its distance from the average. */\n49\t  bar?: CubingBar;\n50\t  /** A thin tick at the average in every track (`bar: \"length\"` only). */\n51\t  avgLine?: boolean;\n52\t  /** Counting bars, chips and the headline, as #rrggbb. */\n53\t  accent?: string;\n54\t  /** Page and ink. */\n55\t  preset?: \"dark\" | \"light\";\n56\t  /** Dev-only: check the layout contract and draw it over the card. */\n57\t  debugLayout?: boolean;\n58\t};\n59\t\n60\tconst ID = \"@one-a-day/sports/cubing-average-card/v1\";\n61\tconst DEFAULT_ACCENT = \"#ff8a1f\";\n62\tconst THEMES = {\n63\t  dark: { bg: \"#10151c\", ink: \"#eef1f5\", dim: \"#8f9aa8\" },\n64\t  light: { bg: \"#f6f4ef\", ink: \"#161b22\", dim: \"#5d6672\" },\n65\t} as const;\n66\t\n67\t// An invented cuber after an invented Ao5: the best (24.19) and the worst\n68\t// (31.62) are dropped, 29.50+ carries a +2, and the average beats the old PB.\n69\tconst DEFAULTS = {\n70\t  event: \"3x3\",\n71\t  solves: [\"27.84\", \"24.19\", \"29.50+\", \"31.62\", \"26.07\"],\n72\t  previousPb: \"28.35\",\n73\t  cuber: \"mira_cubes\",\n74\t  date: \"Oct 4, 2026\",\n75\t  bar: \"spread\" as CubingBar,\n76\t  avgLine: false,\n77\t  accent: DEFAULT_ACCENT,\n78\t  preset: \"dark\" as \"dark\" | \"light\",\n79\t  debugLayout: false,\n80\t};\n81\t\n82\tconst propsSchema = definePropsSchema<CubingAverageCardProps>({\n83\t  solves: {\n84\t    type: \"json\",\n85\t    required: false,\n86\t    description:\n87\t      'The solves in the order they were made: 3 (a Mo3, the mean of all three), 5 (an Ao5) or 12 (an Ao12), as strings: \"27.84\", \"1:02.45\", \"29.50+\" (the +2 is already in the number, as csTimer prints it) or \"DNF\" (csTimer\\'s \"DNF(15.20)\" is read as DNF). The card works out which two are dropped; do not type the parentheses.',\n88\t    meta: {\n89\t      constraints: { jsonSchema: { type: \"array\", minItems: 3, maxItems: 12, items: { type: \"string\" } } },\n90\t      ui: { label: \"Solves\", order: 1, primary: true },\n91\t    },\n92\t  },\n93\t  previousPb: {\n94\t    type: \"string\",\n95\t    required: false,\n96\t    description: 'The previous PB for the same kind of average (an Ao5 PB for an Ao5), as a time: \"28.35\" or \"1:05.00\". Sets the delta line and the NEW PB chip. Empty or \"DNF\" removes both.',\n97\t    meta: { control: { placeholder: DEFAULTS.previousPb }, ui: { label: \"Previous PB\", order: 2 } },\n98\t  },\n99\t  event: {\n100\t    type: \"string\",\n101\t    required: false,\n102\t    description: 'The event next to the kind chip: \"3x3\", \"OH\", \"3BLD\", \"Skewb\". Free text, up to 24 characters. Empty removes it.',\n103\t    meta: { control: { placeholder: DEFAULTS.event }, ui: { label: \"Event\", order: 3 } },\n104\t  },\n105\t  cuber: {\n106\t    type: \"string\",\n107\t    required: false,\n108\t    description: \"The handle or name under the event, up to 32 characters. Empty removes it. The sample is an invented handle.\",\n109\t    meta: { control: { placeholder: DEFAULTS.cuber }, ui: { label: \"Cuber\", order: 4 } },\n110\t  },\n111\t  date: {\n112\t    type: \"string\",\n113\t    required: false,\n114\t    description: \"A free line next to the name: the date, a session, a thread. Empty removes it.\",\n115\t    meta: { control: { placeholder: DEFAULTS.date }, ui: { label: \"Date\", order: 5 } },\n116\t  },\n117\t  bar: {\n118\t    type: \"string\",\n119\t    required: false,\n120\t    description: 'What a bar means: \"length\" (the solve time from zero; the slowest fills the track) or \"spread\" (the distance from the average, left = faster, right = slower; the largest distance fills its half). With a DNF average there is no centre, so \"spread\" falls back to \"length\" and the footnote says so.',\n121\t    meta: { constraints: { oneOf: [\"length\", \"spread\"] }, ui: { label: \"Bar shows\", order: 6 } },\n122\t  },\n123\t  avgLine: {\n124\t    type: \"boolean\",\n125\t    required: false,\n126\t    description: 'A thin tick at the average in every track, named in the footnote. Only with bar \"length\" and an average that is not DNF.',\n127\t    meta: { ui: { label: \"Average tick\", order: 7 } },\n128\t  },\n129\t  accent: {\n130\t    type: \"string\",\n131\t    required: false,\n132\t    description: \"The counting bars, the chips and the kind chip, as #rrggbb.\",\n133\t    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 8 } },\n134\t  },\n135\t  preset: {\n136\t    type: \"string\",\n137\t    required: false,\n138\t    description: 'Page and ink: \"dark\" (default) or \"light\".',\n139\t    meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 9 } },\n140\t  },\n141\t  debugLayout: {\n142\t    type: \"boolean\",\n143\t    required: false,\n144\t    description: \"Dev-only: check the layout contract (every text fits its box, every solve has a track, the tracks are one size) and draw it over the card.\",\n145\t    meta: { ui: { label: \"Debug layout\", order: 99 } },\n146\t  },\n147\t});\n148\t\n149\t/* ── the arithmetic: pure, exported, and what the test asserts ── */\n150\t\n151\tfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n152\t\n153\tconst TIME = /^(?:(\\d{1,2}):([0-5]\\d)|(\\d{1,2}))\\.(\\d{2})$/;\n154\t/** \"27.84\", \"1:02.45\" -> integer hundredths; null when it is not a time (or is zero). */\n155\texport function parseCubingTime(text: string): number | null {\n156\t  const m = TIME.exec(text);\n157\t  if (!m) return null;\n158\t  const cs = m[1] !== undefined ? (Number(m[1]) * 60 + Number(m[2])) * 100 + Number(m[4]) : Number(m[3]) * 100 + Number(m[4]);\n159\t  return cs > 0 ? cs : null;\n160\t}\n161\t\n162\t/** Hundredths back to the way a scoresheet prints them: SS.hh under a minute, M:SS.hh above. */\n163\texport function formatCubingTime(cs: number): string {\n164\t  const two = (n: number) => String(n).padStart(2, \"0\");\n165\t  const min = Math.floor(cs / 6000), sec = Math.floor((cs % 6000) / 100), hun = cs % 100;\n166\t  return min > 0 ? `${min}:${two(sec)}.${two(hun)}` : `${sec}.${two(hun)}`;\n167\t}\n168\t\n169\texport type ParsedSolve = { cs: number | null; plus: boolean };\n170\t/** One solve as csTimer prints it: \"27.84\", \"29.50+\", \"DNF\", \"DNF(15.20)\" (read as DNF). null when it is none of these. */\n171\texport function parseSolve(text: string): ParsedSolve | null {\n172\t  const s = text.trim();\n173\t  if (/^DNF(?:\\((?:\\d{1,2}:[0-5]\\d|\\d{1,3})\\.\\d{2}\\))?$/i.test(s)) return { cs: null, plus: false };\n174\t  const plus = s.endsWith(\"+\");\n175\t  const cs = parseCubingTime(plus ? s.slice(0, -1) : s);\n176\t  return cs === null ? null : { cs, plus };\n177\t}\n178\t\n179\t/** delta = average - previous PB, with its sign: \"-0.55\" faster, \"+0.31\" slower, \"0.00\" equal. ASCII hyphen-minus. */\n180\texport function formatCubingDelta(deltaCs: number): string {\n181\t  return deltaCs < 0 ? `-${formatCubingTime(-deltaCs)}` : deltaCs > 0 ? `+${formatCubingTime(deltaCs)}` : \"0.00\";\n182\t}\n183\t\n184\texport type CubingKind = \"Mo3\" | \"Ao5\" | \"Ao12\";\n185\texport type CubingSolve = {\n186\t  index: number;\n187\t  cs: number | null;\n188\t  plus: boolean;\n189\t  drop: \"best\" | \"worst\" | null;\n190\t  /** The time cell: \"27.84\", \"29.50+\", \"DNF\", and in parentheses when dropped. */\n191\t  text: string;\n192\t  /** What follows the last digit in `text` (\"+\", \")\", \"+)\"): the cell hangs it past the column's digit edge. */\n193\t  suffix: string;\n194\t};\n195\texport type CubingResult = { n: number; kind: CubingKind; solves: CubingSolve[]; avgCs: number | null; counting: number };\n196\t\n197\t/**\n198\t * The drop rule and the average, from solve strings. Ao5 and Ao12 drop the\n199\t * best (first of equal fastest) and the worst (last of equal slowest; a DNF\n200\t * is always the worst, the last DNF if there are several), so the two are\n201\t * always different solves. A Mo3 drops nothing. The average is the sum of\n202\t * the counting solves over their count, to the nearest hundredth, halves up,\n203\t * in integers; DNF when a DNF still counts.\n204\t */\n205\texport function cubingAverage(raw: readonly string[]): CubingResult {\n206\t  if (!Array.isArray(raw)) fail(\"solves\", \"must be a list of 3, 5 or 12 solve strings.\");\n207\t  const n = raw.length;\n208\t  if (n !== 3 && n !== 5 && n !== 12) {\n209\t    const below = [3, 5, 12].filter((c) => c < n).pop(), above = [3, 5, 12].find((c) => c > n);\n210\t    const need = [\n211\t      below !== undefined ? `${below} (drop the last ${n - below})` : null,\n212\t      above !== undefined ? `${above} (add ${above - n} more)` : null,\n213\t    ].filter(Boolean).join(\" or \");\n214\t    fail(\"solves\", `has ${n} ${n === 1 ? \"entry\" : \"entries\"}; one card is a Mo3 (3 solves), an Ao5 (5) or an Ao12 (12), so a count of ${n} would need ${need}.`);\n215\t  }\n216\t  const parsed = raw.map((r, i) => {\n217\t    const at = `solves[${i}]`;\n218\t    if (typeof r !== \"string\") fail(at, \"must be a string.\");\n219\t    if (/^\\s*\\(.*\\)\\s*$/.test(r)) fail(at, `${JSON.stringify(r)} is in parentheses: drop the parentheses - the card works out which solves are dropped.`);\n220\t    const s = parseSolve(r);\n221\t    if (!s) fail(at, `${JSON.stringify(r)} is not a solve: write \"27.84\", \"1:02.45\", \"29.50+\" (a +2 already in the number) or \"DNF\".`);\n222\t    return s;\n223\t  });\n224\t\n225\t  const drop: Array<\"best\" | \"worst\" | null> = parsed.map(() => null);\n226\t  if (n >= 5) {\n227\t    let worst = -1, best = -1;\n228\t    parsed.forEach((s, i) => { if (s.cs === null) worst = i; });\n229\t    if (worst < 0) parsed.forEach((s, i) => { if (worst < 0 || (s.cs as number) >= (parsed[worst].cs as number)) worst = i; });\n230\t    parsed.forEach((s, i) => { if (s.cs !== null && (best < 0 || s.cs < (parsed[best].cs as number))) best = i; });\n231\t    // Every solve a DNF: nothing is fastest; the first DNF stands in as the best so two different solves are dropped.\n232\t    if (best < 0) best = 0;\n233\t    drop[best] = \"best\";\n234\t    drop[worst] = \"worst\";\n235\t  }\n236\t  const solves: CubingSolve[] = parsed.map((s, i) => {\n237\t    const base = s.cs === null ? \"DNF\" : formatCubingTime(s.cs) + (s.plus ? \"+\" : \"\");\n238\t    const dropped = drop[i] !== null;\n239\t    return {\n240\t      index: i + 1, cs: s.cs, plus: s.plus, drop: drop[i],\n241\t      text: dropped ? `(${base})` : base,\n242\t      suffix: s.cs === null ? (dropped ? \")\" : \"\") : (s.plus ? \"+\" : \"\") + (dropped ? \")\" : \"\"),\n243\t    };\n244\t  });\n245\t  const counting = solves.filter((s) => s.drop === null);\n246\t  const avgCs = counting.some((s) => s.cs === null)\n247\t    ? null\n248\t    : Math.floor((2 * counting.reduce((sum, s) => sum + (s.cs as number), 0) + counting.length) / (2 * counting.length));\n249\t  return { n, kind: n === 3 ? \"Mo3\" : n === 5 ? \"Ao5\" : \"Ao12\", solves, avgCs, counting: counting.length };\n250\t}\n251\t\n252\t/**\n253\t * Printable ASCII plus the accented Latin letters (Latin-1 and Latin\n254\t * Extended-A, U+00C0-U+017F without the two maths signs): the bundled font has\n255\t * a glyph for every one of them in both weights. Anything else is refused by\n256\t * name instead of rendering as tofu.\n257\t */\n258\tconst DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\n259\tfunction text(value: unknown, field: string, max: number): string {\n260\t  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n261\t  if (!DRAWN.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII and accented Latin letters (U+00C0-U+017F).`);\n262\t  const s = value.trim();\n263\t  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n264\t  return s;\n265\t}\n266\t\n267\texport type CubingBarKind = \"length\" | \"spread\";\n268\texport type CubingCard = ReturnType<typeof normalizeCubingCard>;\n269\t\n270\t/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\n271\texport function normalizeCubingCard(props: CubingAverageCardProps) {\n272\t  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n273\t  const event = text(p.event, \"event\", 24);\n274\t  const cuber = text(p.cuber, \"cuber\", 32);\n275\t  const date = text(p.date, \"date\", 32);\n276\t  if (p.bar !== \"length\" && p.bar !== \"spread\") fail(\"bar\", `${JSON.stringify(p.bar)} must be \"length\" or \"spread\".`);\n277\t  if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n278\t  if (typeof p.accent !== \"string\" || !/^#[0-9a-fA-F]{6}$/.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n279\t  if (typeof p.avgLine !== \"boolean\") fail(\"avgLine\", \"must be a boolean.\");\n280\t  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n281\t  const r = cubingAverage(p.solves);\n282\t\n283\t  if (typeof p.previousPb !== \"string\") fail(\"previousPb\", \"must be a string.\");\n284\t  const pbRaw = p.previousPb.trim();\n285\t  const pbCs = pbRaw === \"\" || pbRaw.toUpperCase() === \"DNF\" ? null : parseCubingTime(pbRaw);\n286\t  if (pbRaw !== \"\" && pbRaw.toUpperCase() !== \"DNF\" && pbCs === null) fail(\"previousPb\", `${JSON.stringify(pbRaw)} is not a time: write \"28.35\" or \"1:05.00\" (a plain time, no +), or leave it empty for none.`);\n287\t\n288\t  const kind = r.kind;\n289\t  const avg = r.avgCs;\n290\t  const headline = avg === null ? \"DNF\" : formatCubingTime(avg);\n291\t  const compared = avg !== null && pbCs !== null;\n292\t  const newPb = compared && (avg as number) < (pbCs as number);\n293\t  // The delta line is two cells: the words, then the old PB's own number (bound to previousPb).\n294\t  const pbText = pbCs === null ? \"\" : formatCubingTime(pbCs);\n295\t  const deltaText = !compared ? \"\"\n296\t    : (avg as number) === pbCs ? `ties previous ${kind} PB`\n297\t    : `${formatCubingDelta((avg as number) - (pbCs as number))} vs previous ${kind} PB`;\n298\t\n299\t  // The scale. length: zero to the slowest non-DNF solve. spread: the largest\n300\t  // distance from the average fills its half; with a DNF average there is no\n301\t  // centre and the bars fall back to length. Fractions stay exact until a pixel.\n302\t  const times = r.solves.filter((s) => s.cs !== null).map((s) => s.cs as number);\n303\t  const maxCs = times.length ? Math.max(...times) : 0;\n304\t  const barKind: CubingBarKind = p.bar === \"spread\" && avg !== null ? \"spread\" : \"length\";\n305\t  const dist = (cs: number) => Math.abs(cs - (avg as number));\n306\t  const maxDist = barKind === \"spread\" && times.length ? Math.max(...times.map(dist)) : 0;\n307\t  const lines = r.solves.map((s) => {\n308\t    let share = 0, side: -1 | 0 | 1 = 0;\n309\t    if (s.cs !== null) {\n310\t      if (barKind === \"length\") share = maxCs > 0 ? s.cs / maxCs : 0;\n311\t      else { share = maxDist > 0 ? dist(s.cs) / maxDist : 0; side = s.cs < (avg as number) ? -1 : s.cs > (avg as number) ? 1 : 0; }\n312\t    }\n313\t    return { ...s, share, side };\n314\t  });\n315\t  const tick = barKind === \"length\" && p.avgLine === true && avg !== null && maxCs > 0 ? avg / maxCs : null;\n316\t\n317\t  const hasPlus = r.solves.some((s) => s.plus);\n318\t  const sentences = [\n319\t    r.n === 3 ? `Mean of all 3 solves${avg === null ? \".\" : \", rounded to hundredths.\"}` : `Best and worst dropped (in parentheses). Average of the middle ${r.counting}${avg === null ? \".\" : \", rounded to hundredths.\"}`,\n320\t    ...(avg === null ? [r.n === 3 ? \"A DNF in a Mo3 makes the mean DNF.\" : \"Two or more DNFs make the average DNF.\"] : []),\n321\t    ...(hasPlus ? [\"A trailing + is a +2, already included.\"] : []),\n322\t    ...(times.length === 0 ? []\n323\t      : barKind === \"spread\" ? [\"Bars: distance from the average, left = faster.\"]\n324\t      : p.bar === \"spread\" ? [\"No average, so bars are drawn from zero; the slowest fills the track.\"]\n325\t      : [\"Bars are drawn from zero; the slowest fills the track.\" + (tick !== null ? \" Tick = the average.\" : \"\")]),\n326\t  ];\n327\t\n328\t  return {\n329\t    event, cuber, date, kind, chip: kind.toUpperCase(), headline, avg, pbCs, pbText, newPb, deltaText, lines, tick, maxCs, barKind,\n330\t    footnote: sentences.join(\" \"),\n331\t    bar: p.bar as CubingBar, avgLine: p.avgLine, preset: p.preset as \"dark\" | \"light\",\n332\t    accent: p.accent.trim().toLowerCase() as MosaicColor, debugLayout: p.debugLayout, counting: r.counting,\n333\t  };\n334\t}\n335\t\n336\t/* ── colour ── */\n337\t\n338\t// Not exported: the pack index is `export *`, and other templates export a `mix`.\n339\tfunction mix(a: string, b: string, t: number): MosaicColor {\n340\t  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n341\t  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n342\t  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n343\t}\n344\tfunction luminance(hex: string): number {\n345\t  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n346\t  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n347\t}\n348\t/** The readable ink over a filled chip: dark or white, whichever contrasts more with the caller's accent. */\n349\tfunction onColor(fill: string): MosaicColor {\n350\t  const ratio = (other: string) => { const a = luminance(fill), b = luminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n351\t  return (ratio(\"#0b1220\") >= ratio(\"#ffffff\") ? \"#0b1220\" : \"#ffffff\") as MosaicColor;\n352\t}\n353\t\n354\t/* ── geometry ── */\n355\t\n356\texport type CubingRect = { x: number; y: number; w: number; h: number };\n357\ttype Bind = \"event\" | \"cuber\" | \"date\" | \"previousPb\" | null;\n358\ttype Cell = { label: string; rect: CubingRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\n359\ttype Tile = { label: string; rect: CubingRect; color: MosaicColor; radius: number; layer: number; accent?: boolean };\n360\t\n361\t/** The largest whole size up to `maxPx` at which one line fits the cell's budget (`cell * 0.94 - 2px`). */\n362\tfunction fitPx(line: string, cellW: number, maxPx: number, bold: boolean): number {\n363\t  const top = Math.max(1, Math.round(maxPx));\n364\t  const room = budget(cellW), w = widthOf(line, top, bold);\n365\t  let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n366\t  while (px > 1 && widthOf(line, px, bold) > room) px--;\n367\t  return px;\n368\t}\n369\t/** The narrowest cell that still fits `line` at `px` (the inverse of the budget). */\n370\tconst cellFor = (line: string, px: number, bold = false) => Math.ceil((widthOf(line, px, bold) + 2) / 0.94) + 1;\n371\t\n372\t/** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\n373\texport function layoutCubingCard(props: CubingAverageCardProps, W: number, H: number) {\n374\t  const p = normalizeCubingCard(props);\n375\t  const theme = THEMES[p.preset];\n376\t  const ink = theme.ink as MosaicColor, dim = theme.dim as MosaicColor;\n377\t  const S = Math.min(W, H);\n378\t  // 16:9 and wider: header and headline in a left column, the solves in a right one.\n379\t  // Square and portrait: the header band, then the solves, then the footnote.\n380\t  const wide = W * 10 >= H * 13;\n381\t  const k = wide ? 1 : Math.max(1, Math.min(1.25, H / W));\n382\t  const m = Math.round(S * 0.055), CW = W - 2 * m;\n383\t  const gap = Math.round(S * 0.022);\n384\t  const floor = Math.max(6, Math.round(S * 0.016)), small = Math.max(5, Math.round(S * 0.013));\n385\t  const cells: Cell[] = [];\n386\t  const tiles: Tile[] = [];\n387\t  const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n388\t  /** One fitted line in `rect`; refuses below the floor instead of clipping. */\n389\t  const line = (label: string, rect: CubingRect, value: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string; floor?: number } = {}) => {\n390\t    if (px < (o.floor ?? floor)) unfit(o.field ?? label);\n391\t    cells.push({ label, rect, text: value, px, width: widthOf(value, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? ink, bind: o.bind ?? null, over: o.over === true });\n392\t  };\n393\t\n394\t  // Column geometry: the left column (wide) or the full width (stacked).\n395\t  const leftW = wide ? Math.round(CW * 0.39) : CW;\n396\t  const colGap = Math.round(S * 0.05);\n397\t  const rightX = m + leftW + colGap, rightW = W - m - rightX;\n398\t\n399\t  // ── header: [AO5] chip and the event, then the cuber and the date ──\n400\t  const chipH = Math.round(S * (wide ? 0.07 : 0.06) * k);\n401\t  const chipPx = Math.round(chipH * 0.5);\n402\t  const chipPad = Math.round(chipH * 0.3);\n403\t  const chipW = cellFor(p.chip, chipPx, true) + 2 * chipPad;\n404\t  tiles.push({ label: \"kind-chip\", rect: { x: m, y: m, w: chipW, h: chipH }, color: p.accent, radius: 0.5, layer: 1, accent: true });\n405\t  line(\"kind\", tiles[0].rect, p.chip, chipPx, { bold: true, align: \"center\", color: onColor(p.accent), over: true, floor: small });\n406\t  if (p.event !== \"\") {\n407\t    const evX = m + chipW + gap, evW = m + leftW - evX;\n408\t    line(\"event\", { x: evX, y: m, w: evW, h: chipH }, p.event, fitPx(p.event, evW, chipH * 0.66, true), { bold: true, bind: \"event\", floor: small });\n409\t  }\n410\t  let y = m + chipH + Math.round(gap * 0.5);\n411\t  const lineH = Math.round(S * (wide ? 0.045 : 0.04) * k);\n412\t  const subTop = Math.round(lineH * 0.62);\n413\t  const both = p.cuber !== \"\" && p.date !== \"\";\n414\t  // Stacked: the cuber and the date share a line while both fit at the full size; otherwise a line each.\n415\t  const shared = !wide && both && cellFor(p.cuber, subTop) + cellFor(p.date, subTop) + 2 * gap <= leftW;\n416\t  const dateW = shared ? cellFor(p.date, subTop) : leftW, cuberW = shared ? leftW - dateW - gap : leftW;\n417\t  const subPx = Math.min(...[[p.cuber, cuberW], [p.date, dateW]].map(([t, w]) => (t === \"\" ? Infinity : fitPx(t as string, w as number, subTop, false))), subTop);\n418\t  if (p.cuber !== \"\") { line(\"cuber\", { x: m, y, w: cuberW, h: lineH }, p.cuber, subPx, { color: dim, bind: \"cuber\", floor: small }); if (!shared) y += lineH; }\n419\t  if (p.date !== \"\") { line(\"date\", { x: shared ? m + leftW - dateW : m, y, w: dateW, h: lineH }, p.date, subPx, { color: dim, align: shared ? \"right\" : \"left\", bind: \"date\", floor: small }); y += lineH; }\n420\t  y += Math.round(gap * 0.6);\n421\t\n422\t  // ── headline: the average is the largest text, the NEW PB chip right after it, the delta under it ──\n423\t  const headMax = Math.round(S * 0.19 * k);\n424\t  const hH = Math.max(1, Math.min(headMax, Math.floor(H * 0.5) - y - 2));\n425\t  const pbH = Math.round(hH * 0.3), pbPx = Math.round(pbH * 0.5);\n426\t  const pbW = p.newPb ? cellFor(\"NEW PB\", pbPx, true) + 2 * Math.round(pbH * 0.3) : 0;\n427\t  const headAvail = leftW - (p.newPb ? pbW + gap : 0);\n428\t  const headPx = fitPx(p.headline, headAvail, hH * 0.84, true);\n429\t  if (headPx < floor) unfit(\"the headline\");\n430\t  const headCellW = Math.min(headAvail, cellFor(p.headline, headPx, true));\n431\t  line(\"headline\", { x: m, y, w: headCellW, h: hH }, p.headline, headPx, { bold: true, color: p.avg === null ? ink : p.accent, field: \"the headline\" });\n432\t  if (p.newPb) {\n433\t    const rect: CubingRect = { x: m + headCellW + gap, y: y + Math.round(hH * 0.16), w: pbW, h: pbH };\n434\t    tiles.push({ label: \"pb-chip\", rect, color: p.accent, radius: 0.5, layer: 1 });\n435\t    line(\"pb\", rect, \"NEW PB\", pbPx, { bold: true, align: \"center\", color: onColor(p.accent), over: true, floor: small });\n436\t  }\n437\t  y += hH;\n438\t  if (p.deltaText !== \"\") {\n439\t    const dH = Math.round(S * 0.05 * k);\n440\t    // The words, then the old PB's number as its own cell (bound to previousPb); one size for both,\n441\t    // chosen so the pair fits the column with a space between.\n442\t    const spaceW = Math.ceil(widthOf(\" \", Math.round(dH * 0.64)) * 0.6);\n443\t    const pair = (px: number) => Math.ceil(widthOf(p.deltaText, px) * 1.03) + 2 + spaceW + cellFor(p.pbText, px);\n444\t    let dPx = Math.round(dH * 0.64);\n445\t    while (dPx > 1 && pair(dPx) > leftW) dPx--;\n446\t    const wordsW = Math.ceil(widthOf(p.deltaText, dPx) * 1.03) + 2;\n447\t    line(\"delta\", { x: m, y, w: wordsW, h: dH }, p.deltaText, dPx, { field: \"the delta line\" });\n448\t    line(\"pb-value\", { x: m + wordsW + spaceW, y, w: leftW - wordsW - spaceW, h: dH }, p.pbText, dPx, { bind: \"previousPb\", field: \"the delta line\" });\n449\t    y += dH;\n450\t  }\n451\t  const headerBottom = y;\n452\t\n453\t  // ── footnote: stacked, two lines across the foot; wide, at the foot of the left column ──\n454\t  const footTop = Math.round(S * (wide ? 0.024 : 0.022) * k);\n455\t  const maxFootH = wide ? Math.floor(H * 0.2) - m - 2 : Infinity;\n456\t  const maxLines = wide ? 6 : 2;\n457\t  const footH = (n: number, px: number) => n * Math.round(px * 1.4) + 2;\n458\t  let footPx = footTop, footLines = wrapMeasured(p.footnote, footPx, budget(leftW));\n459\t  while ((footLines.length > maxLines || footH(footLines.length, footPx) > maxFootH) && footPx > 1) { footPx--; footLines = wrapMeasured(p.footnote, footPx, budget(leftW)); }\n460\t  if (footPx < small) unfit(\"the footnote\");\n461\t  const footRect: CubingRect = { x: m, y: H - m - footH(footLines.length, footPx), w: leftW, h: footH(footLines.length, footPx) };\n462\t  cells.push({ label: \"footnote\", rect: footRect, text: footLines.join(\"\\n\"), px: footPx, width: Math.max(...footLines.map((l) => widthOf(l, footPx))), bold: false, align: \"left\", color: dim, bind: null, over: false });\n463\t\n464\t  // ── the solves: index, track, time; one row per solve, in the order they were made ──\n465\t  const n = p.lines.length;\n466\t  const bandTop = wide ? m : headerBottom + gap, bandBottom = wide ? H - m : footRect.y - gap;\n467\t  const areaX = wide ? rightX : m, areaW = wide ? rightW : CW;\n468\t  const cap = Math.round(S * (wide ? 0.17 : (n <= 3 ? 0.12 : 0.15) * k));\n469\t  const rowH = Math.max(1, Math.min(cap, Math.floor((bandBottom - bandTop) / n)));\n470\t  const g = Math.round(areaW * 0.02);\n471\t  const timeW = Math.round(areaW * (wide ? 0.25 : 0.27));\n472\t  // One size for every index and time: the smallest any row needs. The digits of every time end\n473\t  // on one edge R (so the decimal points stack); a \"+\" or \")\" hangs past it, in the space reserved.\n474\t  let rowPx = Math.min(Math.round(rowH * 0.56), Math.round(S * 0.044 * k));\n475\t  const hangW = (px: number) => Math.max(0, ...p.lines.map((l) => Math.ceil(widthOf(l.suffix, px))));\n476\t  const fits = (px: number) => p.lines.every((l) => widthOf(l.text, px) <= budget(timeW - hangW(px) + Math.ceil(widthOf(l.suffix, px))));\n477\t  while (rowPx > 1 && !fits(rowPx)) rowPx--;\n478\t  if (rowPx < floor) unfit(`solves (${n} rows)`);\n479\t  const hang = hangW(rowPx);\n480\t  // The time column is as wide as its widest time needs, so the track takes the rest and the digits sit near their bars.\n481\t  const needW = hang + Math.max(...p.lines.map((l) => cellFor(l.text, rowPx) - Math.ceil(widthOf(l.suffix, rowPx))));\n482\t  const timeCol = Math.min(timeW, needW);\n483\t  const idxW = cellFor(\"12\", rowPx), idxX = areaX;\n484\t  const trackX = idxX + idxW + g, timeX = areaX + areaW - timeCol;\n485\t  const trackW = timeX - g - trackX;\n486\t  const R = timeX + timeCol - hang;\n487\t\n488\t  const trackColor = mix(theme.bg, theme.ink, 0.14);\n489\t  const trackH = Math.max(3, Math.min(Math.round(rowH * 0.5), Math.round(rowPx * 0.95)));\n490\t  const edge = Math.max(2, Math.round(trackH * 0.16));\n491\t  const minBar = Math.max(2, Math.round(trackW * 0.01));\n492\t  const rows = p.lines.map((l, i) => {\n493\t    const top = bandTop + i * rowH;\n494\t    const trackY = top + Math.round((rowH - trackH) / 2);\n495\t    const track: CubingRect = { x: trackX, y: trackY, w: trackW, h: trackH };\n496\t    tiles.push({ label: `track-${i}`, rect: track, color: trackColor, radius: 0.5, layer: 1 });\n497\t    const dropped = l.drop !== null;\n498\t    // A bar only for a time: a DNF row keeps its empty track. A solve exactly at the average has no distance to draw.\n499\t    // The floor keeps a real but tiny distance visible; a dropped bar also needs room for its hole. It never invents a bar for no distance.\n500\t    const floorW = dropped ? Math.max(minBar, 2 * edge + 2) : minBar;\n501\t    let bar: CubingRect | null = null, hole: CubingRect | null = null, centre: CubingRect | null = null, tick: CubingRect | null = null;\n502\t    if (l.cs !== null && l.share > 0) {\n503\t      if (p.barKind === \"length\") bar = { x: track.x, y: track.y, w: Math.min(track.w, Math.max(floorW, Math.round(track.w * l.share))), h: track.h };\n504\t      else {\n505\t        const half = Math.round(track.w / 2), w = Math.min(half, Math.max(floorW, Math.round(half * l.share)));\n506\t        bar = { x: l.side < 0 ? track.x + half - w : track.x + half, y: track.y, w, h: track.h };\n507\t      }\n508\t      if (dropped) hole = { x: bar.x + edge, y: bar.y + edge, w: bar.w - 2 * edge, h: bar.h - 2 * edge };\n509\t    }\n510\t    const cw = Math.max(2, Math.round(trackH * 0.08)), ch = Math.round(trackH * 1.5);\n511\t    if (p.barKind === \"spread\") centre = { x: track.x + Math.round(track.w / 2) - Math.floor(cw / 2), y: track.y + Math.round((track.h - ch) / 2), w: cw, h: ch };\n512\t    if (p.tick !== null) tick = { x: track.x + Math.round(track.w * p.tick) - Math.floor(cw / 2), y: track.y + Math.round((track.h - ch) / 2), w: cw, h: ch };\n513\t    if (bar) tiles.push({ label: `bar-${i}`, rect: bar, color: p.accent, radius: 0.5, layer: 2 });\n514\t    if (hole) tiles.push({ label: `hole-${i}`, rect: hole, color: trackColor, radius: 0.5, layer: 3 });\n515\t    if (centre) tiles.push({ label: `centre-${i}`, rect: centre, color: ink, radius: 0, layer: 4 });\n516\t    if (tick) tiles.push({ label: `tick-${i}`, rect: tick, color: ink, radius: 0, layer: 4 });\n517\t    const hangHere = Math.ceil(widthOf(l.suffix, rowPx));\n518\t    line(`index-${i}`, { x: idxX, y: top, w: idxW, h: rowH }, String(l.index), rowPx, { color: dim, field: `solves[${i}]` });\n519\t    // The cell ends where this row's digits end plus its own hang, so every row's digits end on R.\n520\t    line(`time-${i}`, { x: timeX, y: top, w: R + hangHere - timeX, h: rowH }, l.text, rowPx, { align: \"right\", color: dropped ? dim : ink, bold: !dropped, field: `solves[${i}]` });\n521\t    return { top, track, bar, hole, centre, tick, line: l };\n522\t  });\n523\t\n524\t  return { p, theme, wide, cells, tiles, rows, m, floor, small, rowH, rowPx, cap, headerBottom, bandTop, bandBottom, footLines: footLines.length, R, hang, trackColor };\n525\t}\n526\t\n527\t/**\n528\t * Why this template exists - rendered by `renderTutorial` (the why-tutorial\n529\t * convention, src/_shared/why.ts): the run, the problem with the sources the\n530\t * agent opened, the solution, how to use it, then the template itself.\n531\t */\n532\tconst WHY: WhySpec = {\n533\t  \"day\": 15,\n534\t  \"date\": \"2026-10-04\",\n535\t  \"agent\": \"claude\",\n536\t  \"model\": \"claude-sonnet-5-5\",\n537\t  \"id\": \"@one-a-day/sports/cubing-average-card/v1\",\n538\t  \"title\": \"Cubing Average Card\",\n539\t  \"who\": \"Speedcubers on SpeedSolving.com forum competitions and race threads, who paste csTimer exports and follow the WCA averaging rules\",\n540\t  \"problem\": [\n541\t    \"Race threads report progress by pasting raw csTimer blocks: \\\"avg of 5: 27.59\\\", the solves with the dropped ones in parentheses, plus scramble strings and timestamps. PB and goal tables (single 14.93, ao5 20.63, ao12 24.88) are typed by hand.\",\n542\t    \"The forum's own timer says \\\"a PB notification pops up the moment you set a new record\\\", and blindfolded events show Mo3 because one DNF wipes out an Ao5. The moment exists; nothing turns it into a picture.\"\n543\t  ],\n544\t  \"sources\": [\n545\t    \"https://www.speedsolving.com/threads/oh-race-d-yescubing-and-cubelite.95050/\",\n546\t    \"https://www.speedsolving.com/threads/new-speedsolving-timer.97451/\"\n547\t  ],\n548\t  \"solution\": [\n549\t    \"Give 3, 5 or 12 solves and the card works out the rest: Mo3, Ao5 or Ao12 from the count, the best and worst dropped (in parentheses, hollow bar), the average in integer hundredths, and the delta against the old PB.\",\n550\t    \"The one decision: the dropped solves stay on the card, drawn hollow, and a slower average is printed with a plus sign, never drawn red. Each bar says what the footnote says: the distance from the average, left = faster. bar \\\"length\\\" and avgLine are one prop away.\"\n551\t  ],\n552\t  \"usage\": {\n553\t    \"command\": \"m0saic make @one-a-day/sports/cubing-average-card/v1 --template-repo . -w 1080 -h 1080 -o journal/2026-10-04/cubing-average-card.png\",\n554\t    \"try\": [\n555\t      \"solves: 3, 5 or 12 strings - \\\"27.84\\\", \\\"29.50+\\\" (a +2), \\\"DNF\\\", or csTimer's \\\"DNF(15.20)\\\"\",\n556\t      \"previousPb \\\"\\\" removes the delta and the chip; a slower average gets a plus sign and no chip\",\n557\t      \"bar \\\"length\\\" draws each time from zero instead; avgLine true adds a tick at the average\",\n558\t      \"accent \\\"#2ec4b6\\\", preset \\\"light\\\", -w 1920 -h 1080: another colour, a light page, two columns\"\n559\t    ]\n560\t  },\n561\t  \"timeline\": {\n562\t    \"source\": \"runner\",\n563\t    \"phases\": [\n564\t      {\n565\t        \"name\": \"scout\",\n566\t        \"startMs\": 0,\n567\t        \"durMs\": 162798,\n568\t        \"calls\": 25,\n569\t        \"tokens\": 1926031,\n570\t        \"costUsd\": 0.76,\n571\t        \"tools\": \"Bash 11, WebSearch 10, Write 2\"\n572\t      },\n573\t      {\n574\t        \"name\": \"plan\",\n575\t        \"startMs\": 162847,\n576\t        \"durMs\": 162741,\n577\t        \"calls\": 12,\n578\t        \"tokens\": 984534,\n579\t        \"costUsd\": 0.51,\n580\t        \"tools\": \"Read 5, Bash 4, Write 2\"\n581\t      }\n582\t    ],\n583\t    \"costBasis\": \"reported\"\n584\t  },\n585\t  \"caveats\": [\n586\t    \"It does not read a csTimer export: copy each time from the Time List into solves yourself (\\\"1. 27.39 <scramble> @...\\\" becomes \\\"27.39\\\").\",\n587\t    \"Only 3, 5 or 12 solves: no Ao50 or Ao100, no Bo3 or multi-blind. Times over ten minutes are not rounded to whole seconds.\",\n588\t    \"Spread bars show distance, not time (the number beside each is the time); a solve on the average has no bar. Half-up rounding is this template's choice, not checked against a regulation.\"\n589\t  ]\n590\t};\n591\t\n592\texport const CubingAverageCardV1 = defineMosaicTemplate<CubingAverageCardProps>({\n593\t  id: asTemplateId(ID),\n594\t  label: \"2026-10-04 · Cubing Average Card\",\n595\t  version: 1,\n596\t  description: \"A speedcubing average card: give 3, 5 or 12 solves and it works out the Mo3, Ao5 or Ao12, one bar per solve with the dropped best and worst in parentheses and hollow, the average as the headline, and the delta against the previous PB.\",\n597\t  capabilities: { tier: \"core\" },\n598\t  tags: [\"sports\",\"2026-10-04\",\"day-015\",\"cubing\",\"speedcubing\",\"average\",\"pb\",\"cstimer\"],\n599\t\n600\t  outputHints: {\n601\t    width: 1080,\n602\t    height: 1080,\n603\t    fps: 30,\n604\t    durationMs: 2000,\n605\t    format: { kind: \"image\", container: \"png\" },\n606\t    note: \"Still PNG. Square and portrait stack the header, the solves and the footnote; 16:9 and wider put the header and headline in a left column and the solves in a right one. Minimum tested canvas 480x270.\",\n607\t  },\n608\t\n609\t  propsSchema,\n610\t  defaultProps: DEFAULTS,\n611\t\n612\t  render,\n613\t  renderTutorial: whyTutorial(WHY, render),\n614\t});\n615\t\n616\texport default CubingAverageCardV1;\n617\t\n618\tasync function render(props: CubingAverageCardProps, ctx: MosaicEngineContext): Promise<MosaicDocument> {\n619\t  const { width: W, height: H } = ctx.target;\n620\t  const L = layoutCubingCard(props, W, H);\n621\t  const pieces: Parameters<typeof placeInsetPieces>[0][\"pieces\"] = [];\n622\t  const constraints: LayoutConstraint[] = [];\n623\t\n624\t  // Emitted layer by layer: placeInsetPieces puts a rect on the first overlay\n625\t  // layer it does not collide with, so tiles of one kind share a layer.\n626\t  for (const t of [...L.tiles].sort((a, b) => a.layer - b.layer)) {\n627\t    const tile = tag({ ...makeColorTile(t.color, t.radius > 0 ? { effects: { rounding: { cornerStyle: \"rounded\", borderRadius: t.radius } } } : {}) } as MosaicSource, t.label);\n628\t    // `accent` paints the kind chip, so that is the rect that shows it.\n629\t    pieces.push({ rect: { ...t.rect, importance: t.layer }, source: t.accent ? bindProp(tile, \"accent\") : tile });\n630\t    constraints.push({ label: t.label });\n631\t  }\n632\t  for (const c of L.cells) {\n633\t    const cell = tag(textCell({ text: c.text, fontSize: c.px, color: c.color, hAlign: c.align, bold: c.bold, label: c.label }), c.label);\n634\t    // A text rect is BOUND to the prop it shows; derived text (the times, the headline, the delta, the footnote) is not.\n635\t    pieces.push({ rect: { ...c.rect, importance: c.over ? 3 : 2 }, source: c.bind === null ? cell : bindProp(cell, c.bind) });\n636\t    constraints.push(textFitsMeasured(c.label, c.text, c.px, c.width));\n637\t  }\n638\t\n639\t  // What the geometry promises, against the labels: every text fits its box\n640\t  // (above); the headline lives in the top half and the footnote in the bottom\n641\t  // fifth; every solve has a track at least a fifth of the canvas wide, and the\n642\t  // tracks are one size; a solve with a time has its bar (above, as a presence\n643\t  // check on each bar tile).\n644\t  constraints.push({ label: \"headline\", within: { yFrac: [0, 0.5] } });\n645\t  constraints.push({ label: \"footnote\", within: { yFrac: [0.8, 1] } });\n646\t  L.rows.forEach((_, i) => constraints.push({ label: `track-${i}`, minWidthFrac: 0.2 }));\n647\t  const relations: RelationalConstraint[] = [{ label: L.rows.map((_, i) => `track-${i}`), equal: \"size\", tolerancePx: 2 }];\n648\t\n649\t  const placed = placeInsetPieces({ rootW: W, rootH: H, pieces });\n650\t  const doc: MosaicDocument = {\n651\t    kind: \"mosaic_document\",\n652\t    version: 1,\n653\t    m0: toM0String(placed.m0, ID),\n654\t    assets: {},\n655\t    backgroundColor: L.theme.bg as MosaicColor,\n656\t    sources: placed.sources,\n657\t  };\n658\t  return withLayoutIntent(doc, ctx, { templateId: ID, constraints, relations, debug: props.debugLayout === true });\n659\t}\n660\t"}]},"parent_tool_use_id":null,"session_id":"0aea4289-246b-446e-a917-0a68522a2d0a","uuid":"31304bd9-133c-4a3d-9b3d-bb6c0dbe6ed9","timestamp":"2026-10-05T06:48:13.108Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\src\\m0saic-production\\one-a-day\\src\\sports\\cubing-average-card\\v1\\cubing-average-card.ts","content":"import type { MosaicColor, MosaicDocument, MosaicEngineContext, MosaicSource } from \"@m0saic/types\";\nimport { asTemplateId } from \"@m0saic/types\";\nimport { toM0String } from \"@m0saic/dsl-stdlib\";\nimport { bindProp, defineMosaicTemplate, definePropsSchema, makeColorTile, placeInsetPieces, tag, wrapMeasured } from \"@m0saic/template-utils\";\nimport type { LayoutConstraint, RelationalConstraint } from \"@m0saic/template-utils\";\nimport { textFitsMeasured, withLayoutIntent } from \"../../../_shared/layout\";\nimport { budget, textCell, widthOf } from \"../../../_shared/text\";\nimport { whyTutorial } from \"../../../_shared/why\";\nimport type { WhySpec } from \"../../../_shared/why\";\n\n/**\n * `@one-a-day/sports/cubing-average-card/v1` - one speedcubing average as a\n * card: the solves as bars, the dropped best and worst in parentheses with a\n * hollow bar, the average as the headline, and the delta against the old PB.\n *\n * ONE CONCEPT: the headline is COMPUTED, and the dropped solves stay on the\n * card. The user gives the solves; the count decides the kind (3 is a Mo3, 5\n * an Ao5, 12 an Ao12), so a \"Mo3\" label over five solves cannot happen. The\n * best and the worst are dropped (Ao5, Ao12), printed in parentheses and\n * drawn hollow; the average is the mean of what is left. Each bar says what\n * the footnote says: its distance from the average (`bar: \"spread\"`, the\n * default: left = faster, who carried the average and who dragged it) or its\n * length from zero (`bar: \"length\"`, the slowest fills the track, where a\n * 24-32 second session draws five near-identical bars).\n *\n * The rule that bites: all arithmetic is integer hundredths of a second. The\n * average is rounded to the nearest hundredth with halves going UP, as\n * floor((2 * sum + n) / (2 * n)); a float sum prints 28.34 for a 28.345\n * average. (This is the rounding the template chose; it does not cite a\n * regulation.) A DNF is always the worst solve; the average is DNF when a\n * DNF is still among the counting solves (two DNFs in an Ao5 or Ao12, one in\n * a Mo3). A slower average is printed with a plus sign in the ordinary ink:\n * no warning colour, no chip.\n */\n\nexport type CubingBar = \"length\" | \"spread\";\nexport type CubingAverageCardProps = {\n  /** The event next to the kind chip: \"3x3\", \"OH\", \"3BLD\". \"\" removes it. */\n  event?: string;\n  /** The solves in the order they were made: 3 (Mo3), 5 (Ao5) or 12 (Ao12) strings. */\n  solves?: string[];\n  /** The previous PB for the same kind of average, as a time; \"\" or \"DNF\" means none. */\n  previousPb?: string;\n  /** The handle or name under the event. \"\" removes it. */\n  cuber?: string;\n  /** A free line next to the name. \"\" removes it. */\n  date?: string;\n  /** What a bar means: its length from zero, or its distance from the average. */\n  bar?: CubingBar;\n  /** A thin tick at the average in every track (`bar: \"length\"` only). */\n  avgLine?: boolean;\n  /** Counting bars, chips and the headline, as #rrggbb. */\n  accent?: string;\n  /** Page and ink. */\n  preset?: \"dark\" | \"light\";\n  /** Dev-only: check the layout contract and draw it over the card. */\n  debugLayout?: boolean;\n};\n\nconst ID = \"@one-a-day/sports/cubing-average-card/v1\";\nconst DEFAULT_ACCENT = \"#ff8a1f\";\nconst THEMES = {\n  dark: { bg: \"#10151c\", ink: \"#eef1f5\", dim: \"#8f9aa8\" },\n  light: { bg: \"#f6f4ef\", ink: \"#161b22\", dim: \"#5d6672\" },\n} as const;\n\n// An invented cuber after an invented Ao5: the best (24.19) and the worst\n// (31.62) are dropped, 29.50+ carries a +2, and the average beats the old PB.\nconst DEFAULTS = {\n  event: \"3x3\",\n  solves: [\"27.84\", \"24.19\", \"29.50+\", \"31.62\", \"26.07\"],\n  previousPb: \"28.35\",\n  cuber: \"mira_cubes\",\n  date: \"Oct 4, 2026\",\n  bar: \"spread\" as CubingBar,\n  avgLine: false,\n  accent: DEFAULT_ACCENT,\n  preset: \"dark\" as \"dark\" | \"light\",\n  debugLayout: false,\n};\n\nconst propsSchema = definePropsSchema<CubingAverageCardProps>({\n  solves: {\n    type: \"json\",\n    required: false,\n    description:\n      'The solves in the order they were made: 3 (a Mo3, the mean of all three), 5 (an Ao5) or 12 (an Ao12), as strings: \"27.84\", \"1:02.45\", \"29.50+\" (the +2 is already in the number, as csTimer prints it) or \"DNF\" (csTimer\\'s \"DNF(15.20)\" is read as DNF). The card works out which two are dropped; do not type the parentheses.',\n    meta: {\n      constraints: { jsonSchema: { type: \"array\", minItems: 3, maxItems: 12, items: { type: \"string\" } } },\n      ui: { label: \"Solves\", order: 1, primary: true },\n    },\n  },\n  previousPb: {\n    type: \"string\",\n    required: false,\n    description: 'The previous PB for the same kind of average (an Ao5 PB for an Ao5), as a time: \"28.35\" or \"1:05.00\". Sets the delta line and the NEW PB chip. Empty or \"DNF\" removes both.',\n    meta: { control: { placeholder: DEFAULTS.previousPb }, ui: { label: \"Previous PB\", order: 2 } },\n  },\n  event: {\n    type: \"string\",\n    required: false,\n    description: 'The event next to the kind chip: \"3x3\", \"OH\", \"3BLD\", \"Skewb\". Free text, up to 24 characters. Empty removes it.',\n    meta: { control: { placeholder: DEFAULTS.event }, ui: { label: \"Event\", order: 3 } },\n  },\n  cuber: {\n    type: \"string\",\n    required: false,\n    description: \"The handle or name under the event, up to 32 characters. Empty removes it. The sample is an invented handle.\",\n    meta: { control: { placeholder: DEFAULTS.cuber }, ui: { label: \"Cuber\", order: 4 } },\n  },\n  date: {\n    type: \"string\",\n    required: false,\n    description: \"A free line next to the name: the date, a session, a thread. Empty removes it.\",\n    meta: { control: { placeholder: DEFAULTS.date }, ui: { label: \"Date\", order: 5 } },\n  },\n  bar: {\n    type: \"string\",\n    required: false,\n    description: 'What a bar means: \"length\" (the solve time from zero; the slowest fills the track) or \"spread\" (the distance from the average, left = faster, right = slower; the largest distance fills its half). With a DNF average there is no centre, so \"spread\" falls back to \"length\" and the footnote says so.',\n    meta: { constraints: { oneOf: [\"length\", \"spread\"] }, ui: { label: \"Bar shows\", order: 6 } },\n  },\n  avgLine: {\n    type: \"boolean\",\n    required: false,\n    description: 'A thin tick at the average in every track, named in the footnote. Only with bar \"length\" and an average that is not DNF.',\n    meta: { ui: { label: \"Average tick\", order: 7 } },\n  },\n  accent: {\n    type: \"string\",\n    required: false,\n    description: \"The counting bars, the chips and the kind chip, as #rrggbb.\",\n    meta: { constraints: { isColor: true }, control: { colorPicker: true, defaultColor: DEFAULT_ACCENT }, ui: { label: \"Accent\", order: 8 } },\n  },\n  preset: {\n    type: \"string\",\n    required: false,\n    description: 'Page and ink: \"dark\" (default) or \"light\".',\n    meta: { constraints: { oneOf: [\"dark\", \"light\"] }, ui: { label: \"Preset\", order: 9 } },\n  },\n  debugLayout: {\n    type: \"boolean\",\n    required: false,\n    description: \"Dev-only: check the layout contract (every text fits its box, every solve has a track, the tracks are one size) and draw it over the card.\",\n    meta: { ui: { label: \"Debug layout\", order: 99 } },\n  },\n});\n\n/* ── the arithmetic: pure, exported, and what the test asserts ── */\n\nfunction fail(field: string, rule: string): never { throw new Error(`${ID}: ${field} ${rule}`); }\n\nconst TIME = /^(?:(\\d{1,2}):([0-5]\\d)|(\\d{1,2}))\\.(\\d{2})$/;\n/** \"27.84\", \"1:02.45\" -> integer hundredths; null when it is not a time (or is zero). */\nexport function parseCubingTime(text: string): number | null {\n  const m = TIME.exec(text);\n  if (!m) return null;\n  const cs = m[1] !== undefined ? (Number(m[1]) * 60 + Number(m[2])) * 100 + Number(m[4]) : Number(m[3]) * 100 + Number(m[4]);\n  return cs > 0 ? cs : null;\n}\n\n/** Hundredths back to the way a scoresheet prints them: SS.hh under a minute, M:SS.hh above. */\nexport function formatCubingTime(cs: number): string {\n  const two = (n: number) => String(n).padStart(2, \"0\");\n  const min = Math.floor(cs / 6000), sec = Math.floor((cs % 6000) / 100), hun = cs % 100;\n  return min > 0 ? `${min}:${two(sec)}.${two(hun)}` : `${sec}.${two(hun)}`;\n}\n\nexport type ParsedSolve = { cs: number | null; plus: boolean };\n/** One solve as csTimer prints it: \"27.84\", \"29.50+\", \"DNF\", \"DNF(15.20)\" (read as DNF). null when it is none of these. */\nexport function parseSolve(text: string): ParsedSolve | null {\n  const s = text.trim();\n  if (/^DNF(?:\\((?:\\d{1,2}:[0-5]\\d|\\d{1,3})\\.\\d{2}\\))?$/i.test(s)) return { cs: null, plus: false };\n  const plus = s.endsWith(\"+\");\n  const cs = parseCubingTime(plus ? s.slice(0, -1) : s);\n  return cs === null ? null : { cs, plus };\n}\n\n/** delta = average - previous PB, with its sign: \"-0.55\" faster, \"+0.31\" slower, \"0.00\" equal. ASCII hyphen-minus. */\nexport function formatCubingDelta(deltaCs: number): string {\n  return deltaCs < 0 ? `-${formatCubingTime(-deltaCs)}` : deltaCs > 0 ? `+${formatCubingTime(deltaCs)}` : \"0.00\";\n}\n\nexport type CubingKind = \"Mo3\" | \"Ao5\" | \"Ao12\";\nexport type CubingSolve = {\n  index: number;\n  cs: number | null;\n  plus: boolean;\n  drop: \"best\" | \"worst\" | null;\n  /** The time cell: \"27.84\", \"29.50+\", \"DNF\", and in parentheses when dropped. */\n  text: string;\n  /** What follows the last digit in `text` (\"+\", \")\", \"+)\"): the cell hangs it past the column's digit edge. */\n  suffix: string;\n};\nexport type CubingResult = { n: number; kind: CubingKind; solves: CubingSolve[]; avgCs: number | null; counting: number };\n\n/**\n * The drop rule and the average, from solve strings. Ao5 and Ao12 drop the\n * best (first of equal fastest) and the worst (last of equal slowest; a DNF\n * is always the worst, the last DNF if there are several), so the two are\n * always different solves. A Mo3 drops nothing. The average is the sum of\n * the counting solves over their count, to the nearest hundredth, halves up,\n * in integers; DNF when a DNF still counts.\n */\nexport function cubingAverage(raw: readonly string[]): CubingResult {\n  if (!Array.isArray(raw)) fail(\"solves\", \"must be a list of 3, 5 or 12 solve strings.\");\n  const n = raw.length;\n  if (n !== 3 && n !== 5 && n !== 12) {\n    const below = [3, 5, 12].filter((c) => c < n).pop(), above = [3, 5, 12].find((c) => c > n);\n    const need = [\n      below !== undefined ? `${below} (drop the last ${n - below})` : null,\n      above !== undefined ? `${above} (add ${above - n} more)` : null,\n    ].filter(Boolean).join(\" or \");\n    fail(\"solves\", `has ${n} ${n === 1 ? \"entry\" : \"entries\"}; one card is a Mo3 (3 solves), an Ao5 (5) or an Ao12 (12), so a count of ${n} would need ${need}.`);\n  }\n  const parsed = raw.map((r, i) => {\n    const at = `solves[${i}]`;\n    if (typeof r !== \"string\") fail(at, \"must be a string.\");\n    if (/^\\s*\\(.*\\)\\s*$/.test(r)) fail(at, `${JSON.stringify(r)} is in parentheses: drop the parentheses - the card works out which solves are dropped.`);\n    const s = parseSolve(r);\n    if (!s) fail(at, `${JSON.stringify(r)} is not a solve: write \"27.84\", \"1:02.45\", \"29.50+\" (a +2 already in the number) or \"DNF\".`);\n    return s;\n  });\n\n  const drop: Array<\"best\" | \"worst\" | null> = parsed.map(() => null);\n  if (n >= 5) {\n    let worst = -1, best = -1;\n    parsed.forEach((s, i) => { if (s.cs === null) worst = i; });\n    if (worst < 0) parsed.forEach((s, i) => { if (worst < 0 || (s.cs as number) >= (parsed[worst].cs as number)) worst = i; });\n    parsed.forEach((s, i) => { if (s.cs !== null && (best < 0 || s.cs < (parsed[best].cs as number))) best = i; });\n    // Every solve a DNF: nothing is fastest; the first DNF stands in as the best so two different solves are dropped.\n    if (best < 0) best = 0;\n    drop[best] = \"best\";\n    drop[worst] = \"worst\";\n  }\n  const solves: CubingSolve[] = parsed.map((s, i) => {\n    const base = s.cs === null ? \"DNF\" : formatCubingTime(s.cs) + (s.plus ? \"+\" : \"\");\n    const dropped = drop[i] !== null;\n    return {\n      index: i + 1, cs: s.cs, plus: s.plus, drop: drop[i],\n      text: dropped ? `(${base})` : base,\n      suffix: s.cs === null ? (dropped ? \")\" : \"\") : (s.plus ? \"+\" : \"\") + (dropped ? \")\" : \"\"),\n    };\n  });\n  const counting = solves.filter((s) => s.drop === null);\n  const avgCs = counting.some((s) => s.cs === null)\n    ? null\n    : Math.floor((2 * counting.reduce((sum, s) => sum + (s.cs as number), 0) + counting.length) / (2 * counting.length));\n  return { n, kind: n === 3 ? \"Mo3\" : n === 5 ? \"Ao5\" : \"Ao12\", solves, avgCs, counting: counting.length };\n}\n\n/**\n * Printable ASCII plus the accented Latin letters (Latin-1 and Latin\n * Extended-A, U+00C0-U+017F without the two maths signs): the bundled font has\n * a glyph for every one of them in both weights. Anything else is refused by\n * name instead of rendering as tofu.\n */\nconst DRAWN = /^[\\x20-\\x7eÀ-ÖØ-öø-ſ]*$/;\nfunction text(value: unknown, field: string, max: number): string {\n  if (typeof value !== \"string\") fail(field, \"must be a string.\");\n  if (!DRAWN.test(value)) fail(field, `${JSON.stringify(value)} has a character the bundled font is not known to draw: use one line of printable ASCII and accented Latin letters (U+00C0-U+017F).`);\n  const s = value.trim();\n  if (s.length > max) fail(field, `${JSON.stringify(s)} is ${s.length} characters; the card fits at most ${max}.`);\n  return s;\n}\n\nexport type CubingBarKind = \"length\" | \"spread\";\nexport type CubingCard = ReturnType<typeof normalizeCubingCard>;\n\n/** The schema is documentation; this is the gate. Only `undefined` takes a default. */\nexport function normalizeCubingCard(props: CubingAverageCardProps) {\n  const p = { ...DEFAULTS, ...Object.fromEntries(Object.entries(props ?? {}).filter(([, v]) => v !== undefined)) };\n  const event = text(p.event, \"event\", 24);\n  const cuber = text(p.cuber, \"cuber\", 32);\n  const date = text(p.date, \"date\", 32);\n  if (p.bar !== \"length\" && p.bar !== \"spread\") fail(\"bar\", `${JSON.stringify(p.bar)} must be \"length\" or \"spread\".`);\n  if (p.preset !== \"dark\" && p.preset !== \"light\") fail(\"preset\", `${JSON.stringify(p.preset)} must be \"dark\" or \"light\".`);\n  if (typeof p.accent !== \"string\" || !/^#[0-9a-fA-F]{6}$/.test(p.accent.trim())) fail(\"accent\", `${JSON.stringify(p.accent)} must be #rrggbb.`);\n  if (typeof p.avgLine !== \"boolean\") fail(\"avgLine\", \"must be a boolean.\");\n  if (typeof p.debugLayout !== \"boolean\") fail(\"debugLayout\", \"must be a boolean.\");\n  const r = cubingAverage(p.solves);\n\n  if (typeof p.previousPb !== \"string\") fail(\"previousPb\", \"must be a string.\");\n  const pbRaw = p.previousPb.trim();\n  const pbCs = pbRaw === \"\" || pbRaw.toUpperCase() === \"DNF\" ? null : parseCubingTime(pbRaw);\n  if (pbRaw !== \"\" && pbRaw.toUpperCase() !== \"DNF\" && pbCs === null) fail(\"previousPb\", `${JSON.stringify(pbRaw)} is not a time: write \"28.35\" or \"1:05.00\" (a plain time, no +), or leave it empty for none.`);\n\n  const kind = r.kind;\n  const avg = r.avgCs;\n  const headline = avg === null ? \"DNF\" : formatCubingTime(avg);\n  const compared = avg !== null && pbCs !== null;\n  const newPb = compared && (avg as number) < (pbCs as number);\n  // The delta line is two cells: the words, then the old PB's own number (bound to previousPb).\n  const pbText = pbCs === null ? \"\" : formatCubingTime(pbCs);\n  const deltaText = !compared ? \"\"\n    : (avg as number) === pbCs ? `ties previous ${kind} PB`\n    : `${formatCubingDelta((avg as number) - (pbCs as number))} vs previous ${kind} PB`;\n\n  // The scale. length: zero to the slowest non-DNF solve. spread: the largest\n  // distance from the average fills its half; with a DNF average there is no\n  // centre and the bars fall back to length. Fractions stay exact until a pixel.\n  const times = r.solves.filter((s) => s.cs !== null).map((s) => s.cs as number);\n  const maxCs = times.length ? Math.max(...times) : 0;\n  const barKind: CubingBarKind = p.bar === \"spread\" && avg !== null ? \"spread\" : \"length\";\n  const dist = (cs: number) => Math.abs(cs - (avg as number));\n  const maxDist = barKind === \"spread\" && times.length ? Math.max(...times.map(dist)) : 0;\n  const lines = r.solves.map((s) => {\n    let share = 0, side: -1 | 0 | 1 = 0;\n    if (s.cs !== null) {\n      if (barKind === \"length\") share = maxCs > 0 ? s.cs / maxCs : 0;\n      else { share = maxDist > 0 ? dist(s.cs) / maxDist : 0; side = s.cs < (avg as number) ? -1 : s.cs > (avg as number) ? 1 : 0; }\n    }\n    return { ...s, share, side };\n  });\n  const tick = barKind === \"length\" && p.avgLine === true && avg !== null && maxCs > 0 ? avg / maxCs : null;\n\n  const hasPlus = r.solves.some((s) => s.plus);\n  const sentences = [\n    r.n === 3 ? `Mean of all 3 solves${avg === null ? \".\" : \", rounded to hundredths.\"}` : `Best and worst dropped (in parentheses). Average of the middle ${r.counting}${avg === null ? \".\" : \", rounded to hundredths.\"}`,\n    ...(avg === null ? [r.n === 3 ? \"A DNF in a Mo3 makes the mean DNF.\" : \"Two or more DNFs make the average DNF.\"] : []),\n    ...(hasPlus ? [\"A trailing + is a +2, already included.\"] : []),\n    ...(times.length === 0 ? []\n      : barKind === \"spread\" ? [\"Bars: distance from the average, left = faster.\"]\n      : p.bar === \"spread\" ? [\"No average, so bars are drawn from zero; the slowest fills the track.\"]\n      : [\"Bars are drawn from zero; the slowest fills the track.\" + (tick !== null ? \" Tick = the average.\" : \"\")]),\n  ];\n\n  return {\n    event, cuber, date, kind, chip: kind.toUpperCase(), headline, avg, pbCs, pbText, newPb, deltaText, lines, tick, maxCs, barKind,\n    footnote: sentences.join(\" \"),\n    bar: p.bar as CubingBar, avgLine: p.avgLine, preset: p.preset as \"dark\" | \"light\",\n    accent: p.accent.trim().toLowerCase() as MosaicColor, debugLayout: p.debugLayout, counting: r.counting,\n  };\n}\n\n/* ── colour ── */\n\n// Not exported: the pack index is `export *`, and other templates export a `mix`.\nfunction mix(a: string, b: string, t: number): MosaicColor {\n  const ch = (s: string, i: number) => parseInt(s.slice(1 + 2 * i, 3 + 2 * i), 16);\n  const out = [0, 1, 2].map((i) => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * Math.max(0, Math.min(1, t))));\n  return `#${out.map((v) => v.toString(16).padStart(2, \"0\")).join(\"\")}` as MosaicColor;\n}\nfunction luminance(hex: string): number {\n  const c = (i: number) => { const v = parseInt(hex.slice(i, i + 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };\n  return 0.2126 * c(1) + 0.7152 * c(3) + 0.0722 * c(5);\n}\n/** The readable ink over a filled chip: dark or white, whichever contrasts more with the caller's accent. */\nfunction onColor(fill: string): MosaicColor {\n  const ratio = (other: string) => { const a = luminance(fill), b = luminance(other); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };\n  return (ratio(\"#0b1220\") >= ratio(\"#ffffff\") ? \"#0b1220\" : \"#ffffff\") as MosaicColor;\n}\n\n/* ── geometry ── */\n\nexport type CubingRect = { x: number; y: number; w: number; h: number };\ntype Bind = \"event\" | \"cuber\" | \"date\" | \"previousPb\" | null;\ntype Cell = { label: string; rect: CubingRect; text: string; px: number; width: number; bold: boolean; align: \"left\" | \"right\" | \"center\"; color: MosaicColor; bind: Bind; over: boolean };\ntype Tile = { label: string; rect: CubingRect; color: MosaicColor; radius: number; layer: number; accent?: boolean };\n\n/** The largest whole size up to `maxPx` at which one line fits the cell's budget (`cell * 0.94 - 2px`). */\nfunction fitPx(line: string, cellW: number, maxPx: number, bold: boolean): number {\n  const top = Math.max(1, Math.round(maxPx));\n  const room = budget(cellW), w = widthOf(line, top, bold);\n  let px = w <= room ? top : Math.max(1, Math.floor((top * room) / w));\n  while (px > 1 && widthOf(line, px, bold) > room) px--;\n  return px;\n}\n/** The narrowest cell that still fits `line` at `px` (the inverse of the budget). */\nconst cellFor = (line: string, px: number, bold = false) => Math.ceil((widthOf(line, px, bold) + 2) / 0.94) + 1;\n\n/** Every rect of the card for one canvas. Pure: same props and canvas, same rects. */\nexport function layoutCubingCard(props: CubingAverageCardProps, W: number, H: number) {\n  const p = normalizeCubingCard(props);\n  const theme = THEMES[p.preset];\n  const ink = theme.ink as MosaicColor, dim = theme.dim as MosaicColor;\n  const S = Math.min(W, H);\n  // 16:9 and wider: header and headline in a left column, the solves in a right one.\n  // Square and portrait: the header band, then the solves, then the footnote.\n  const wide = W * 10 >= H * 13;\n  const k = wide ? 1 : Math.max(1, Math.min(1.25, H / W));\n  const m = Math.round(S * 0.055), CW = W - 2 * m;\n  const gap = Math.round(S * 0.022);\n  const floor = Math.max(6, Math.round(S * 0.016)), small = Math.max(5, Math.round(S * 0.013));\n  const cells: Cell[] = [];\n  const tiles: Tile[] = [];\n  const unfit = (field: string): never => fail(field, `cannot be fitted on ${W}x${H} at the ${floor}px floor: shorten it or render a larger canvas.`);\n  /** One fitted line in `rect`; refuses below the floor instead of clipping. */\n  const line = (label: string, rect: CubingRect, value: string, px: number, o: { bold?: boolean; align?: Cell[\"align\"]; color?: MosaicColor; bind?: Bind; over?: boolean; field?: string; floor?: number } = {}) => {\n    if (px < (o.floor ?? floor)) unfit(o.field ?? label);\n    cells.push({ label, rect, text: value, px, width: widthOf(value, px, o.bold === true), bold: o.bold === true, align: o.align ?? \"left\", color: o.color ?? ink, bind: o.bind ?? null, over: o.over === true });\n  };\n\n  // Column geometry: the left column (wide) or the full width (stacked).\n  const leftW = wide ? Math.round(CW * 0.39) : CW;\n  const colGap = Math.round(S * 0.05);\n  const rightX = m + leftW + colGap, rightW = W - m - rightX;\n\n  // ── header: [AO5] chip and the event, then the cuber and the date ──\n  const chipH = Math.round(S * (wide ? 0.07 : 0.06) * k);\n  const chipPx = Math.round(chipH * 0.5);\n  const chipPad = Math.round(chipH * 0.3);\n  const chipW = cellFor(p.chip, chipPx, true) + 2 * chipPad;\n  tiles.push({ label: \"kind-chip\", rect: { x: m, y: m, w: chipW, h: chipH }, color: p.accent, radius: 0.5, layer: 1, accent: true });\n  line(\"kind\", tiles[0].rect, p.chip, chipPx, { bold: true, align: \"center\", color: onColor(p.accent), over: true, floor: small });\n  if (p.event !== \"\") {\n    const evX = m + chipW + gap, evW = m + leftW - evX;\n    line(\"event\", { x: evX, y: m, w: evW, h: chipH }, p.event, fitPx(p.event, evW, chipH * 0.66, true), { bold: true, bind: \"event\", floor: small });\n  }\n  let y = m + chipH + Math.round(gap * 0.5);\n  const lineH = Math.round(S * (wide ? 0.045 : 0.04) * k);\n  const subTop = Math.round(lineH * 0.62);\n  const both = p.cuber !== \"\" && p.date !== \"\";\n  // Stacked: the cuber and the date share a line while both fit at the full size; otherwise a line each.\n  const shared = !wide && both && cellFor(p.cuber, subTop) + cellFor(p.date, subTop) + 2 * gap <= leftW;\n  const dateW = shared ? cellFor(p.date, subTop) : leftW, cuberW = shared ? leftW - dateW - gap : leftW;\n  const subPx = Math.min(...[[p.cuber, cuberW], [p.date, dateW]].map(([t, w]) => (t === \"\" ? Infinity : fitPx(t as string, w as number, subTop, false))), subTop);\n  if (p.cuber !== \"\") { line(\"cuber\", { x: m, y, w: cuberW, h: lineH }, p.cuber, subPx, { color: dim, bind: \"cuber\", floor: small }); if (!shared) y += lineH; }\n  if (p.date !== \"\") { line(\"date\", { x: shared ? m + leftW - dateW : m, y, w: dateW, h: lineH }, p.date, subPx, { color: dim, align: shared ? \"right\" : \"left\", bind: \"date\", floor: small }); y += lineH; }\n  y += Math.round(gap * 0.6);\n\n  // ── headline: the average is the largest text, the NEW PB chip right after it, the delta under it ──\n  const headMax = Math.round(S * 0.19 * k);\n  const hH = Math.max(1, Math.min(headMax, Math.floor(H * 0.5) - y - 2));\n  const pbH = Math.round(hH * 0.3), pbPx = Math.round(pbH * 0.5);\n  const pbW = p.newPb ? cellFor(\"NEW PB\", pbPx, true) + 2 * Math.round(pbH * 0.3) : 0;\n  const headAvail = leftW - (p.newPb ? pbW + gap : 0);\n  const headPx = fitPx(p.headline, headAvail, hH * 0.84, true);\n  if (headPx < floor) unfit(\"the headline\");\n  const headCellW = Math.min(headAvail, cellFor(p.headline, headPx, true));\n  line(\"headline\", { x: m, y, w: headCellW, h: hH }, p.headline, headPx, { bold: true, color: p.avg === null ? ink : p.accent, field: \"the headline\" });\n  if (p.newPb) {\n    const rect: CubingRect = { x: m + headCellW + gap, y: y + Math.round(hH * 0.16), w: pbW, h: pbH };\n    tiles.push({ label: \"pb-chip\", rect, color: p.accent, radius: 0.5, layer: 1 });\n    line(\"pb\", rect, \"NEW PB\", pbPx, { bold: true, align: \"center\", color: onColor(p.accent), over: true, floor: small });\n  }\n  y += hH;\n  if (p.deltaText !== \"\") {\n    const dH = Math.round(S * 0.05 * k);\n    // The words, then the old PB's number as its own cell (bound to previousPb); one size for both,\n    // chosen so the pair fits the column with a space between.\n    const spaceW = Math.ceil(widthOf(\" \", Math.round(dH * 0.64)) * 0.6);\n    const pair = (px: number) => Math.ceil(widthOf(p.deltaText, px) * 1.03) + 2 + spaceW + cellFor(p.pbText, px);\n    let dPx = Math.round(dH * 0.64);\n    while (dPx > 1 && pair(dPx) > leftW) dPx--;\n    const wordsW = Math.ceil(widthOf(p.deltaText, dPx) * 1.03) + 2;\n    line(\"delta\", { x: m, y, w: wordsW, h: dH }, p.deltaText, dPx, { field: \"the delta line\" });\n    line(\"pb-value\", { x: m + wordsW + spaceW, y, w: leftW - wordsW - spaceW, h: dH }, p.pbText, dPx, { bind: \"previousPb\", field: \"the delta line\" });\n    y += dH;\n  }\n  const headerBottom = y;\n\n  // ── footnote: stacked, two lines across the foot; wide, at the foot of the left column ──\n  const footTop = Math.round(S * (wide ? 0.024 : 0.022) * k);\n  const maxFootH = wide ? Math.floor(H * 0.2) - m - 2 : Infinity;\n  const maxLines = wide ? 6 : 2;\n  const footH = (n: number, px: number) => n * Math.round(px * 1.4) + 2;\n  let footPx = footTop, footLines = wrapMeasured(p.footnote, footPx, budget(leftW));\n  while ((footLines.length > maxLines || footH(footLines.length, footPx) > maxFootH) && footPx > 1) { footPx--; footLines = wrapMeasured(p.footnote, footPx, budget(leftW)); }\n  if (footPx < small) unfit(\"the footnote\");\n  const footRect: CubingRect = { x: m, y: H - m - footH(footLines.length, footPx), w: leftW, h: footH(footLines.length, footPx) };\n  cells.push({ label: \"footnote\", rect: footRect, text: footLines.join(\"\\n\"), px: footPx, width: Math.max(...footLines.map((l) => widthOf(l, footPx))), bold: false, align: \"left\", color: dim, bind: null, over: false });\n\n  // ── the solves: index, track, time; one row per solve, in the order they were made ──\n  const n = p.lines.length;\n  const bandTop = wide ? m : headerBottom + gap, bandBottom = wide ? H - m : footRect.y - gap;\n  const areaX = wide ? rightX : m, areaW = wide ? rightW : CW;\n  const cap = Math.round(S * (wide ? 0.17 : (n <= 3 ? 0.12 : 0.15) * k));\n  const rowH = Math.max(1, Math.min(cap, Math.floor((bandBottom - bandTop) / n)));\n  const g = Math.round(areaW * 0.02);\n  const timeW = Math.round(areaW * (wide ? 0.25 : 0.27));\n  // One size for every index and time: the smallest any row needs. The digits of every time end\n  // on one edge R (so the decimal points stack); a \"+\" or \")\" hangs past it, in the space reserved.\n  let rowPx = Math.min(Math.round(rowH * 0.56), Math.round(S * 0.044 * k));\n  const hangW = (px: number) => Math.max(0, ...p.lines.map((l) => Math.ceil(widthOf(l.suffix, px))));\n  const fits = (px: number) => p.lines.every((l) => widthOf(l.text, px) <= budget(timeW - hangW(px) + Math.ceil(widthOf(l.suffix, px))));\n  while (rowPx > 1 && !fits(rowPx)) rowPx--;\n  if (rowPx < floor) unfit(`solves (${n} rows)`);\n  const hang = hangW(rowPx);\n  // The time column is as wide as its widest time needs, so the track takes the rest and the digits sit near their bars.\n  const needW = hang + Math.max(...p.lines.map((l) => cellFor(l.text, rowPx) - Math.ceil(widthOf(l.suffix, rowPx))));\n  const timeCol = Math.min(timeW, needW);\n  const idxW = cellFor(\"12\", rowPx), idxX = areaX;\n  const trackX = idxX + idxW + g, timeX = areaX + areaW - timeCol;\n  const trackW = timeX - g - trackX;\n  const R = timeX + timeCol - hang;\n\n  const trackColor = mix(theme.bg, theme.ink, 0.14);\n  const trackH = Math.max(3, Math.min(Math.round(rowH * 0.5), Math.round(rowPx * 0.95)));\n  const edge = Math.max(2, Math.round(trackH * 0.16));\n  const minBar = Math.max(2, Math.round(trackW * 0.01));\n  const rows = p.lines.map((l, i) => {\n    const top = bandTop + i * rowH;\n    const trackY = top + Math.round((rowH - trackH) / 2);\n    const track: CubingRect = { x: trackX, y: trackY, w: trackW, h: trackH };\n    tiles.push({ label: `track-${i}`, rect: track, color: trackColor, radius: 0.5, layer: 1 });\n    const dropped = l.drop !== null;\n    // A bar only for a time: a DNF row keeps its empty track. A solve exactly at the average has no distance to draw.\n    // The floor keeps a real but tiny distance visible; a dropped bar also needs room for its hole. It never invents a bar for no distance.\n    const floorW = dropped ? Math.max(minBar, 2 * edge + 2) : minBar;\n    let bar: CubingRect | null = null, hole: CubingRect | null = null, centre: CubingRect | null = null, tick: CubingRect | null = null;\n    if (l.cs !== null && l.share > 0) {\n      if (p.barKind === \"length\") bar = { x: track.x, y: track.y, w: Math.min(track.w, Math.max(floorW, Math.round(track.w * l.share))), h: track.h };\n      else {\n        const half = Math.round(track.w / 2), w = Math.min(half, Math.max(floorW, Math.round(half * l.share)));\n        bar = { x: l.side < 0 ? track.x + half - w : track.x + half, y: track.y, w, h: track.h };\n      }\n      if (dropped) hole = { x: bar.x + edge, y: bar.y + edge, w: bar.w - 2 * edge, h: bar.h - 2 * edge };\n    }\n    const cw = Math.max(2, Math.round(trackH * 0.08)), ch = Math.round(trackH * 1.5);\n    if (p.barKind ===