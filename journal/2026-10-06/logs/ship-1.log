  \"bytes\": 135059,\n      \"probe\": {\n        \"width\": 1080,\n        \"height\": 1080,\n        \"codec\": \"png\"\n      }\n    }\n  ],\n  \"stills\": [\n    {\n      \"canvas\": \"landscape\",\n      \"at\": null,\n      \"file\": \"stills\\\\landscape.png\"\n    },\n    {\n      \"canvas\": \"portrait\",\n      \"at\": null,\n      \"file\": \"stills\\\\portrait.png\"\n    },\n    {\n      \"canvas\": \"square\",\n      \"at\": null,\n      \"file\": \"stills\\\\square.png\"\n    },\n    {\n      \"canvas\": \"tutorial\",\n      \"at\": 3.5,\n      \"file\": \"stills\\\\tutorial-1.png\"\n    },\n    {\n      \"canvas\": \"tutorial\",\n      \"at\": 14,\n      \"file\": \"stills\\\\tutorial-2.png\"\n    },\n    {\n      \"canvas\": \"tutorial\",\n      \"at\": 27,\n      \"file\": \"stills\\\\tutorial-3.png\"\n    },\n    {\n      \"canvas\": \"tutorial\",\n      \"at\": 38,\n      \"file\": \"stills\\\\tutorial-4.png\"\n    },\n    {\n      \"canvas\": \"tutorial\",\n      \"at\": 46,\n      \"file\": \"stills\\\\tutorial-5.png\"\n    },\n    {\n      \"canvas\": \"tutorial\",\n      \"at\": 54,\n      \"file\": \"stills\\\\tutorial-6.png\"\n    }\n  ],\n  \"srcSnapshot\": \"src/\",\n  \"ok\": true,\n  \"degraded\": false,\n  \"validate\": {\n    \"code\": 0,\n    \"degraded\": false\n  },\n  \"tutorial\": {\n    \"canvas\": \"tutorial\",\n    \"width\": 1280,\n    \"height\": 720,\n    \"file\": \"renders\\\\tutorial.mp4\",\n    \"exitCode\": 0,\n    \"degraded\": false,\n    \"bytes\": 709383,\n    \"probe\": {\n      \"width\": 1280,\n      \"height\": 720,\n      \"codec\": \"h264\",\n      \"durationSec\": 59\n    }\n  }\n}\n M TEMPLATES.md\n M dist/community/index.d.ts\n M dist/community/index.js\n M dist/community/registry.js\n M src/community/index.ts\n M src/community/registry.ts\n M template-manifest.json\n?? dist/community/weekly-run-report/\n?? journal/2026-10-06/\n?? src/community/weekly-run-report/","stderr":"","interrupted":false,"isImage":f